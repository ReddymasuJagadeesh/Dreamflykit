@model Dreamflykit.Application.StudyHub.Models.EducationLoansPageDto
@{
    Layout = "_Layout";
    var eduPage = Model ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage();
    eduPage.EnsureDefaults();
    ViewData["Title"] = $"{eduPage.NavbarBrandName} Education Loans — {eduPage.OverviewTitle}";
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    var partners = eduPage.Partners != null && eduPage.Partners.Count > 0
        ? eduPage.Partners
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().Partners;

    var steps = eduPage.Steps != null && eduPage.Steps.Count > 0
        ? eduPage.Steps
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().Steps;

    var courses = eduPage.Courses != null && eduPage.Courses.Count > 0
        ? eduPage.Courses
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().Courses;

    var countries = eduPage.CountryOptions != null && eduPage.CountryOptions.Count > 0
        ? eduPage.CountryOptions
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().CountryOptions;

    var navItems = eduPage.MainNavItems != null && eduPage.MainNavItems.Count > 0
        ? eduPage.MainNavItems
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().MainNavItems;

    var overviewCards = eduPage.OverviewCards != null && eduPage.OverviewCards.Count > 0
        ? eduPage.OverviewCards
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().OverviewCards;

    var docGroups = eduPage.DocumentGroups != null && eduPage.DocumentGroups.Count > 0
        ? eduPage.DocumentGroups
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().DocumentGroups;

    var rateRows = eduPage.RateRows != null && eduPage.RateRows.Count > 0
        ? eduPage.RateRows
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().RateRows;
}

<div class="dk-edu-loans-root" id="eduLoansRoot">

    @if (canManage)
    {
        <!-- Admin Shortcut Bar -->
        <div class="dk-edu-admin-bar">
            <div class="dk-edu-admin-inner">
                <span class="dk-edu-admin-tag">⚡ Super Admin Controls</span>
                <span>Tata Capital Navbar, Sub-Nav Tabs, Overview, Documents, Rates &amp; Charges, EMI Calculator &amp; Themes are fully controllable in Admin Dashboard.</span>
                <a href="/Admin/StudyAbroadHub#tab-edu-loans" class="dk-edu-admin-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <span>Edit Education Loans Portal in Admin</span>
                </a>
            </div>
        </div>
    }

    <!-- ========================================================
         1. TATA CAPITAL NAVIGATION BAR (Image 1 Style)
    ========================================================= -->
    @if (eduPage.ShowTopNav)
    {
        <header class="dk-tata-nav-header" style="background-color: @(string.IsNullOrWhiteSpace(eduPage.NavbarBgColor) ? "#0A58A2" : eduPage.NavbarBgColor);">
            <div class="dk-tata-nav-shell">
                
                <!-- Left: Tata Capital Brand Logo -->
                <a href="/study-abroad-hub/education-loans" class="dk-tata-brand" title="@eduPage.NavbarBrandName">
                    @if (!string.IsNullOrWhiteSpace(eduPage.NavbarLogoUrl))
                    {
                        <img src="@eduPage.NavbarLogoUrl" alt="@eduPage.NavbarBrandName" class="dk-tata-brand-img" />
                    }
                    else
                    {
                        <div class="dk-tata-brand-lockup">
                            <span class="dk-tata-brand-name">@eduPage.NavbarBrandName</span>
                            <span class="dk-tata-brand-underline"></span>
                        </div>
                    }
                </a>

                <!-- Mobile Menu Hamburger -->
                <button type="button" class="dk-tata-mobile-btn" onclick="toggleTataMobileMenu()" aria-label="Toggle navigation">
                    <span></span><span></span><span></span>
                </button>

                <!-- Center: Navigation Links -->
                <nav class="dk-tata-nav-menu" id="tataNavMenu" aria-label="Tata Capital Loans Navigation">
                    
                    <!-- 1.1 Loans for You Dropdown (With Education Loans & Education right countries) -->
                    <div class="dk-tata-nav-item has-dropdown" id="loansForYouDropdown">
                        <a href="#overview" class="dk-tata-nav-link active">
                            <span>@eduPage.NavbarLoansMenuTitle</span>
                            <svg class="dk-tata-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                        </a>
                        
                        <div class="dk-tata-dropdown-pane dk-tata-mega-pane">
                            <div class="dk-tata-mega-grid">
                                
                                <!-- Primary Education Loan Link -->
                                <div class="dk-tata-mega-col dk-mega-featured">
                                    <div class="dk-tata-dropdown-badge">Featured</div>
                                    <a href="@eduPage.NavbarEducationLoanUrl" class="dk-mega-edu-card" onclick="smoothScrollTo('overview')">
                                        <div class="dk-mega-edu-icon">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0A58A2" stroke-width="2.2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                                        </div>
                                        <div>
                                            <strong class="dk-mega-edu-title">@eduPage.NavbarEducationLoanTitle</strong>
                                            <p class="dk-mega-edu-sub">100% Comprehensive Abroad &amp; Domestic Financing up to ₹1.5 Cr</p>
                                            <span class="dk-mega-edu-action">Explore Loan Details →</span>
                                        </div>
                                    </a>
                                </div>

                                <!-- Education Right Countries (Destinations List) -->
                                <div class="dk-tata-mega-col dk-mega-destinations">
                                    <div class="dk-tata-dropdown-header">
                                        <span>@eduPage.NavbarRightCountriesTitle</span>
                                        <span class="dk-header-note">Fast Pre-Visa Approvals</span>
                                    </div>
                                    <div class="dk-countries-chips-grid">
                                        @foreach (var c in countries)
                                        {
                                            <a href="@c.Url" class="dk-country-chip" onclick="openEduModal('Education Loan for @c.Name')">
                                                <span class="dk-chip-flag">@c.FlagEmoji</span>
                                                <div class="dk-chip-info">
                                                    <span class="dk-chip-name">@c.Name</span>
                                                    <span class="dk-chip-meta">@c.LoanAmountLimit • @c.InterestRate</span>
                                                </div>
                                                <span class="dk-chip-arrow">›</span>
                                            </a>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Additional Nav Items (Configurable from Admin) -->
                    @foreach (var nav in navItems)
                    {
                        <div class="dk-tata-nav-item @(nav.HasDropdown ? "has-dropdown" : "")">
                            <a href="@nav.Url" class="dk-tata-nav-link">
                                <span>@nav.Title</span>
                                @if (nav.HasDropdown)
                                {
                                    <svg class="dk-tata-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                                }
                            </a>
                            @if (nav.HasDropdown && nav.SubItems != null && nav.SubItems.Count > 0)
                            {
                                <div class="dk-tata-dropdown-pane dk-tata-simple-pane">
                                    @foreach (var sub in nav.SubItems)
                                    {
                                        <a href="#overview" onclick="openEduModal('@sub')" class="dk-tata-sub-link">@sub</a>
                                    }
                                </div>
                            }
                        </div>
                    }

                </nav>

                <!-- Right: Search, Notifications, Google Profile, Login Button -->
                <div class="dk-tata-nav-tools">
                    
                    <!-- Search Input Pill -->
                    <div class="dk-tata-search-pill">
                        <svg class="dk-tata-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <input type="text" id="tataSearchInput" class="dk-tata-search-input" placeholder="@eduPage.SearchPlaceholder" onkeydown="handleTataSearch(event)" />
                    </div>

                    <!-- Notification Bell with Unread Badge -->
                    <div class="dk-tata-notif-wrap">
                        <button type="button" class="dk-tata-notif-btn" id="btnTataNotif" onclick="toggleTataNotif()" title="Special Loan Offers">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                            @if (eduPage.NotificationCount > 0)
                            {
                                <span class="dk-tata-notif-dot">@eduPage.NotificationCount</span>
                            }
                        </button>
                        
                        <!-- Notification Popover Card -->
                        <div class="dk-tata-notif-pop" id="tataNotifPop" style="display: none;">
                            <div class="dk-notif-head">
                                <strong>Loan Notification</strong>
                                <span class="dk-notif-time">Just now</span>
                            </div>
                            <p class="dk-notif-body">@eduPage.NotificationText</p>
                            <button type="button" class="dk-notif-cta" onclick="openEduModal('Special Offer Notification')">Claim Offer →</button>
                        </div>
                    </div>

                    <!-- User / Google Avatar Icon -->
                    <div class="dk-tata-avatar-box" title="My Account">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>

                    <!-- Yellow Login Pill Button -->
                    <a href="@eduPage.LoginButtonUrl" class="dk-tata-login-btn">
                        @eduPage.LoginButtonText
                    </a>

                </div>

            </div>
        </header>

        <!-- Breadcrumb Bar Below Tata Navbar (Image 1 Style) -->
        <div class="dk-tata-breadcrumb-bar">
            <div class="dk-tata-breadcrumb-inner">
                <a href="/" class="dk-bread-link">Home</a>
                <span class="dk-bread-sep">-</span>
                <span class="dk-bread-current">@eduPage.BreadcrumbText</span>
            </div>
        </div>
    }

    <!-- ========================================================
         2. FULL HERO BANNER (Wide & Tall Panoramic Banner)
    ========================================================= -->
    <section class="dk-edu-hero-panoramic-section" id="hero-banner">
        <div class="dk-edu-hero-banner-frame">
            <img src="@eduPage.HeroImageUrl" 
                 alt="@eduPage.HeroTitle @eduPage.HeroTitleHighlight" 
                 class="dk-edu-hero-panoramic-img" 
                 onerror="this.src='/images/study-hub/upload-soon.svg';" />
        </div>
    </section>

    <!-- ========================================================
         3. 4 STICKY SUB-NAV TABS BELOW HERO BANNER (Image 3 Style)
         Overview | Document Required | Rates and Charges | EMI Calculator
    ========================================================= -->
    @if (eduPage.ShowSubNavTabs)
    {
        <div class="dk-tata-subnav-sticky" id="tataSubNavSticky">
            <div class="dk-tata-subnav-shell">
                
                <!-- 4 Navigation Tabs with Dynamic ScrollSpy Active Highlight -->
                <div class="dk-tata-tabs-track" id="tataTabsTrack">
                    <a href="#overview" class="dk-subnav-tab active" data-section="overview" onclick="handleTabClick(event, 'overview')">
                        <span>@eduPage.SubNavTab1Title</span>
                    </a>
                    <a href="#document-required" class="dk-subnav-tab" data-section="document-required" onclick="handleTabClick(event, 'document-required')">
                        <span>@eduPage.SubNavTab2Title</span>
                    </a>
                    <a href="#rates-and-charges" class="dk-subnav-tab" data-section="rates-and-charges" onclick="handleTabClick(event, 'rates-and-charges')">
                        <span>@eduPage.SubNavTab3Title</span>
                    </a>
                    <a href="#emi-calculator" class="dk-subnav-tab" data-section="emi-calculator" onclick="handleTabClick(event, 'emi-calculator')">
                        <span>@eduPage.SubNavTab4Title</span>
                    </a>
                </div>

                <!-- Right Action Button: Get Instant Education Loan -->
                <div class="dk-tata-subnav-action">
                    <button type="button" class="dk-tata-instant-btn" onclick="openEduModal('Instant Education Loan CTA')">
                        <span>@eduPage.SubNavCtaText</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                </div>

            </div>
        </div>
    }

    <!-- ========================================================
         4. SECTION 1: OVERVIEW (Tata Capital Reference)
    ========================================================= -->
    <section class="dk-tata-section dk-overview-section" id="overview">
        <div class="dk-section-container">
            
            <div class="dk-section-header">
                <span class="dk-section-eyebrow">Tata Capital Comprehensive Education Financing</span>
                <h2 class="dk-section-heading">@eduPage.OverviewTitle</h2>
                <p class="dk-section-subheading">@eduPage.OverviewSubtitle</p>
            </div>

            <!-- Overview Main Narrative Box -->
            <div class="dk-overview-story-box">
                <p class="dk-overview-desc">@eduPage.OverviewDescription</p>
                <div class="dk-overview-fast-facts">
                    <div class="dk-fact-pill">
                        <span class="dk-fact-icon">🎓</span>
                        <span><strong>100% Cost of Study</strong> Covered</span>
                    </div>
                    <div class="dk-fact-pill">
                        <span class="dk-fact-icon">⚡</span>
                        <span><strong>48-Hour</strong> In-Principle Sanction</span>
                    </div>
                    <div class="dk-fact-pill">
                        <span class="dk-fact-icon">🌐</span>
                        <span><strong>50+ Countries</strong> Recognized</span>
                    </div>
                    <div class="dk-fact-pill">
                        <span class="dk-fact-icon">🛡️</span>
                        <span><strong>Zero Margin Money</strong> Options</span>
                    </div>
                </div>
            </div>

            <!-- 6 Key Highlights Grid -->
            <div class="dk-overview-cards-grid">
                @for (int oIdx = 0; oIdx < overviewCards.Count; oIdx++)
                {
                    var oc = overviewCards[oIdx];
                    <div class="dk-overview-card">
                        <div class="dk-oc-icon-box">
                            @if (oc.Icon == "award" || oIdx == 0)
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0A58A2" stroke-width="2.2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                            }
                            else if (oc.Icon == "check-circle" || oIdx == 1)
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            }
                            else if (oc.Icon == "percent" || oIdx == 2)
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                            }
                            else if (oc.Icon == "clock" || oIdx == 3)
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            }
                            else if (oc.Icon == "shield" || oIdx == 4)
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            }
                            else
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            }
                        </div>
                        <h3 class="dk-oc-title">@oc.Title</h3>
                        <p class="dk-oc-desc">@oc.Description</p>
                    </div>
                }
            </div>

            <!-- Overview Section Quick CTA Banner -->
            <div class="dk-overview-cta-strip">
                <div class="dk-octa-text">
                    <strong>Ready to calculate your monthly education loan installments?</strong>
                    <span>Use our interactive EMI calculator below to plan your repayment structure.</span>
                </div>
                <button type="button" class="dk-octa-btn" onclick="smoothScrollTo('emi-calculator')">
                    Go to EMI Calculator ↓
                </button>
            </div>

        </div>
    </section>

    <!-- ========================================================
         5. SECTION 2: DOCUMENT REQUIRED (Tata Capital Reference)
    ========================================================= -->
    <section class="dk-tata-section dk-docs-section" id="document-required">
        <div class="dk-section-container">
            
            <div class="dk-section-header">
                <span class="dk-section-eyebrow">Hassle-Free Digital Verification</span>
                <h2 class="dk-section-heading">@eduPage.DocumentsTitle</h2>
                <p class="dk-section-subheading">@eduPage.DocumentsSubtitle</p>
            </div>

            <!-- Documents Categorized Cards Grid -->
            <div class="dk-docs-grid">
                @foreach (var grp in docGroups)
                {
                    <div class="dk-doc-group-card">
                        <div class="dk-doc-group-head">
                            <span class="dk-doc-badge">@grp.GroupBadge</span>
                            <h3 class="dk-doc-group-title">@grp.GroupTitle</h3>
                        </div>
                        <ul class="dk-doc-checklist">
                            @foreach (var item in grp.Items)
                            {
                                <li class="dk-doc-item">
                                    <span class="dk-doc-check-icon">✓</span>
                                    <span class="dk-doc-item-text">@item</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <!-- Pro-Tip Note Callout -->
            <div class="dk-docs-tip-callout">
                <div class="dk-tip-icon">💡</div>
                <div class="dk-tip-content">
                    <strong>Important Note on Documentation:</strong>
                    <p>Digital soft copies (clear PDF / high-resolution images) are accepted for pre-visa in-principle sanction. Keep original passports and academic certificates with the student; do not pack them in checked baggage or surrender original property deeds during initial assessment.</p>
                </div>
            </div>

        </div>
    </section>

    <!-- ========================================================
         6. SECTION 3: RATES AND CHARGES (Tata Capital Reference)
    ========================================================= -->
    <section class="dk-tata-section dk-rates-section" id="rates-and-charges">
        <div class="dk-section-container">
            
            <div class="dk-section-header">
                <span class="dk-section-eyebrow">Complete Financial Transparency</span>
                <h2 class="dk-section-heading">@eduPage.RatesTitle</h2>
                <p class="dk-section-subheading">@eduPage.RatesSubtitle</p>
            </div>

            <!-- Rates & Charges Table -->
            <div class="dk-rates-table-wrapper">
                <table class="dk-rates-table">
                    <thead>
                        <tr>
                            <th style="width: 28%;">Parameter</th>
                            <th style="width: 36%;">Details &amp; Applicable Charges</th>
                            <th style="width: 36%;">Terms &amp; Regulatory Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rateRows)
                        {
                            <tr>
                                <td class="dk-rate-param">
                                    <span class="dk-rate-param-text">@row.Parameter</span>
                                </td>
                                <td class="dk-rate-details">
                                    <span class="dk-rate-details-highlight">@row.Details</span>
                                </td>
                                <td class="dk-rate-notes">
                                    <span>@row.Note</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Disclaimer note -->
            <p class="dk-rates-disclaimer">
                * Note: Interest rates and processing charges are indicative and subject to change based on benchmark rates, university accreditation tier, target degree program, and credit evaluation of applicant/co-applicant. All charges are exclusive of applicable statutory government GST.
            </p>

        </div>
    </section>

    <!-- ========================================================
         7. SECTION 4: EMI CALCULATOR (Tata Capital Reference)
    ========================================================= -->
    <section class="dk-tata-section dk-emi-section" id="emi-calculator">
        <div class="dk-section-container">
            
            <div class="dk-section-header">
                <span class="dk-section-eyebrow">Smart Loan Repayment Planning</span>
                <h2 class="dk-section-heading">@eduPage.EmiCalcTitle</h2>
                <p class="dk-section-subheading">@eduPage.EmiCalcSubtitle</p>
            </div>

            <div class="dk-emi-calculator-card">
                <div class="dk-emi-grid">
                    
                    <!-- Left: Interactive Sliders & Presets -->
                    <div class="dk-emi-controls-col">
                        
                        <!-- 1. Loan Amount Slider -->
                        <div class="dk-emi-control-group">
                            <div class="dk-emi-label-row">
                                <label for="emiAmountRange" class="dk-emi-label">Loan Amount</label>
                                <div class="dk-emi-val-box">
                                    <span class="dk-currency-sym">₹</span>
                                    <input type="text" id="emiAmountDisplay" class="dk-emi-input-field" value="30,00,000" onchange="handleEmiAmountInput(this.value)" />
                                </div>
                            </div>
                            <input type="range" id="emiAmountRange" class="dk-emi-slider" 
                                   min="@eduPage.EmiMinAmount" max="@eduPage.EmiMaxAmount" step="50000" value="@eduPage.EmiDefaultAmount" 
                                   oninput="updateEmiFromSlider()" />
                            <div class="dk-slider-limits">
                                <span>₹ 1 Lakh</span>
                                <span>₹ 75 Lakhs</span>
                                <span>₹ 1.50 Crore</span>
                            </div>
                            <div class="dk-emi-presets">
                                <button type="button" class="dk-preset-btn" onclick="setEmiAmount(1500000)">₹15 L</button>
                                <button type="button" class="dk-preset-btn active" onclick="setEmiAmount(3000000)">₹30 L</button>
                                <button type="button" class="dk-preset-btn" onclick="setEmiAmount(5000000)">₹50 L</button>
                                <button type="button" class="dk-preset-btn" onclick="setEmiAmount(7500000)">₹75 L</button>
                                <button type="button" class="dk-preset-btn" onclick="setEmiAmount(10000000)">₹1 Cr</button>
                            </div>
                        </div>

                        <!-- 2. Interest Rate Slider -->
                        <div class="dk-emi-control-group">
                            <div class="dk-emi-label-row">
                                <label for="emiRateRange" class="dk-emi-label">Interest Rate (% p.a.)</label>
                                <div class="dk-emi-val-box">
                                    <input type="number" id="emiRateDisplay" class="dk-emi-input-field" step="0.1" value="@eduPage.EmiDefaultRate" onchange="handleEmiRateInput(this.value)" />
                                    <span class="dk-unit-sym">%</span>
                                </div>
                            </div>
                            <input type="range" id="emiRateRange" class="dk-emi-slider" 
                                   min="@eduPage.EmiMinRate" max="@eduPage.EmiMaxRate" step="0.1" value="@eduPage.EmiDefaultRate" 
                                   oninput="updateEmiFromSlider()" />
                            <div class="dk-slider-limits">
                                <span>@eduPage.EmiMinRate %</span>
                                <span>12.0 %</span>
                                <span>@eduPage.EmiMaxRate %</span>
                            </div>
                            <div class="dk-emi-presets">
                                <button type="button" class="dk-preset-btn" onclick="setEmiRate(8.5)">8.5%</button>
                                <button type="button" class="dk-preset-btn active" onclick="setEmiRate(9.5)">9.5%</button>
                                <button type="button" class="dk-preset-btn" onclick="setEmiRate(10.5)">10.5%</button>
                                <button type="button" class="dk-preset-btn" onclick="setEmiRate(11.5)">11.5%</button>
                            </div>
                        </div>

                        <!-- 3. Tenure Slider -->
                        <div class="dk-emi-control-group">
                            <div class="dk-emi-label-row">
                                <label for="emiTenureRange" class="dk-emi-label">Loan Tenure (Years)</label>
                                <div class="dk-emi-val-box">
                                    <input type="number" id="emiTenureDisplay" class="dk-emi-input-field" min="@eduPage.EmiMinTenureYears" max="@eduPage.EmiMaxTenureYears" value="@eduPage.EmiDefaultTenureYears" onchange="handleEmiTenureInput(this.value)" />
                                    <span class="dk-unit-sym">Yrs</span>
                                </div>
                            </div>
                            <input type="range" id="emiTenureRange" class="dk-emi-slider" 
                                   min="@eduPage.EmiMinTenureYears" max="@eduPage.EmiMaxTenureYears" step="1" value="@eduPage.EmiDefaultTenureYears" 
                                   oninput="updateEmiFromSlider()" />
                            <div class="dk-slider-limits">
                                <span>1 Year</span>
                                <span>7 Years</span>
                                <span>15 Years</span>
                            </div>
                            <div class="dk-emi-presets">
                                <button type="button" class="dk-preset-btn" onclick="setEmiTenure(5)">5 Yrs</button>
                                <button type="button" class="dk-preset-btn" onclick="setEmiTenure(7)">7 Yrs</button>
                                <button type="button" class="dk-preset-btn active" onclick="setEmiTenure(10)">10 Yrs</button>
                                <button type="button" class="dk-preset-btn" onclick="setEmiTenure(15)">15 Yrs</button>
                            </div>
                        </div>

                    </div>

                    <!-- Right: Summary Card & Dynamic Calculation Results -->
                    <div class="dk-emi-summary-col">
                        
                        <div class="dk-emi-summary-box">
                            <span class="dk-summary-tag">Calculated Monthly Installment</span>
                            
                            <div class="dk-emi-main-figure">
                                <span class="dk-emi-curr">₹</span>
                                <span class="dk-emi-amount" id="lblMonthlyEmi">38,822</span>
                                <span class="dk-emi-period">/ month</span>
                            </div>

                            <div class="dk-emi-breakdown-list">
                                <div class="dk-breakdown-row">
                                    <div class="dk-bd-indicator green"></div>
                                    <span class="dk-bd-label">Principal Loan Amount</span>
                                    <strong class="dk-bd-val" id="lblPrincipalAmount">₹ 30,00,000</strong>
                                </div>
                                <div class="dk-breakdown-row">
                                    <div class="dk-bd-indicator purple"></div>
                                    <span class="dk-bd-label">Total Interest Payable</span>
                                    <strong class="dk-bd-val" id="lblTotalInterest">₹ 16,58,640</strong>
                                </div>
                                <div class="dk-breakdown-row dk-row-total">
                                    <div class="dk-bd-indicator blue"></div>
                                    <span class="dk-bd-label">Total Repayment (Principal + Interest)</span>
                                    <strong class="dk-bd-val" id="lblTotalPayable">₹ 46,58,640</strong>
                                </div>
                            </div>

                            <!-- Visual Proportion Bar -->
                            <div class="dk-emi-ratio-container">
                                <div class="dk-ratio-bar">
                                    <div class="dk-ratio-principal" id="barPrincipal" style="width: 64.4%;" title="Principal Portion"></div>
                                    <div class="dk-ratio-interest" id="barInterest" style="width: 35.6%;" title="Interest Portion"></div>
                                </div>
                                <div class="dk-ratio-legend">
                                    <span><span class="legend-dot green"></span> Principal (<span id="pctPrincipal">64.4%</span>)</span>
                                    <span><span class="legend-dot purple"></span> Interest (<span id="pctInterest">35.6%</span>)</span>
                                </div>
                            </div>

                            <!-- Instant Apply Button -->
                            <button type="button" class="dk-emi-apply-btn" id="btnApplyCalculatedEmi" onclick="applyWithCalculatedLoan()">
                                <span>Apply for this Loan Now →</span>
                            </button>

                            <p class="dk-emi-security-note">
                                🔒 Fast digital application • No obligation • 20+ Lender offers
                            </p>

                        </div>

                    </div>

                </div>
            </div>

        </div>
    </section>

    <!-- ========================================================
