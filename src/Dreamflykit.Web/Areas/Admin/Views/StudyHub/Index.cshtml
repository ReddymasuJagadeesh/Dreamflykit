            ChecklistPage: {
                HeroPill: document.getElementById("chk_hero_pill")?.value || "STUDY ESSENTIALS",
                HeroTitle: document.getElementById("chk_hero_title")?.value || "Abroad Packing Checklist",
                HeroSubtitle: document.getElementById("chk_hero_tagline")?.value || "Don't just pack. Pack smart!",
                HeroDescription: document.getElementById("chk_hero_desc")?.value || "",
                HeroBadgeText: document.getElementById("chk_hero_badge")?.value || "Pack Smart, Travel Far ✈",
                HeroImageUrl: document.getElementById("chk_hero_img_url")?.value || "/images/study-hub/checklist-hero.jpg",
                SelectedDestination: document.getElementById("chk_dest")?.value || "USA",
                ShopMissingButtonText: document.getElementById("chk_shop_missing_btn")?.value || "Shop Missing Essentials →",
                ShopMissingButtonUrl: document.getElementById("chk_shop_missing_url")?.value || "/category/study-essentials",
                Categories: [],
                DestinationGuides: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chkPage.DestinationGuides, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null })),
                QuickTips: [],
                BottomBannerTitle: document.getElementById("chk_banner_title")?.value || "Ready for Your Next Chapter?",
                BottomBannerSubtitle: document.getElementById("chk_banner_sub")?.value || "Everything you need, all in one place.",
                BottomBannerButtonText: document.getElementById("chk_banner_btn_text")?.value || "Shop Study Essentials →",
                BottomBannerButtonUrl: document.getElementById("chk_banner_btn_url")?.value || "/category/study-essentials",
                BottomBannerImageUrl: document.getElementById("chk_banner_img_url")?.value || "/images/study-hub/checklist-bottom-banner.jpg"
            }
        };

        // Section 1 Cards
        for (let i = 0; i < 10; i++) {
            const t = document.getElementById("s1_card_title_" + i);
            if (!t) break;
            payload.Section1.Cards.push({
                Title: t.value,
                Description: document.getElementById("s1_card_desc_" + i)?.value || "",
                LinkUrl: document.getElementById("s1_card_link_" + i)?.value || "/category/study-essentials",
                ImageUrl: document.getElementById("s1_card_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg",
                IconType: "academic"
            });
        }

        // Section 2 Kits
        for (let i = 0; i < 6; i++) {
            const t = document.getElementById("s2_kit_title_" + i);
            if (!t) break;
            const featText = document.getElementById("s2_kit_features_" + i)?.value || "";
            const feats = featText.split("\n").map(f => f.trim()).filter(f => f.length > 0);
            payload.Section2.Kits.push({
                Title: t.value,
                BadgeText: document.getElementById("s2_kit_badge_" + i)?.value || "",
                PriceDisplay: document.getElementById("s2_kit_price_disp_" + i)?.value || "₹499",
                Price: parseFloat(document.getElementById("s2_kit_price_num_" + i)?.value || "499"),
                ImageUrl: document.getElementById("s2_kit_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg",
                Features: feats,
                ButtonText: "View Kit →",
                TargetUrl: "/category/study-essentials"
            });
        }

        // Section 3 Detail Cards (Abroad Essentials)
        for (let i = 0; i < 16; i++) {
            const t = document.getElementById("s3_card_title_" + i);
            if (!t) break;
            payload.Section3Detail.Cards.push({
                Id: document.getElementById("s3_card_id_" + i)?.value || ("abroad-card-" + (i + 1)),
                Title: t.value,
                Description: document.getElementById("s3_card_desc_" + i)?.value || "",
                LinkUrl: document.getElementById("s3_card_link_" + i)?.value || "/category/study-essentials",
                ButtonText: document.getElementById("s3_card_btn_" + i)?.value || "Explore Essentials →",
                IconType: document.getElementById("s3_card_icon_" + i)?.value || "study",
                ImageUrl: document.getElementById("s3_card_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg"
            });
        }

        // Section 5 Countries
        for (let i = 0; i < 10; i++) {
            const t = document.getElementById("s5_c_name_" + i);
            if (!t) break;
            payload.Section5.Countries.push({
                Name: t.value,
                Code: t.value.substring(0, 2).toUpperCase(),
                FlagUrl: document.getElementById("s5_c_flag_" + i)?.value || "",
                LinkUrl: "/category/study-essentials?country=" + encodeURIComponent(t.value.toLowerCase())
            });
        }

        // Section 6 Builder items
        for (let i = 0; i < 20; i++) {
            const t = document.getElementById("s6_item_name_" + i);
            if (!t) break;
            payload.Section6.Items.push({
                Name: t.value,
                Price: parseFloat(document.getElementById("s6_item_price_" + i)?.value || "0"),
                ImageUrl: document.getElementById("s6_item_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg"
            });
        }

        // Section 7 Best Sellers
        for (let i = 0; i < 10; i++) {
            const t = document.getElementById("s7_p_name_" + i);
            if (!t) break;
            payload.Section7.Products.push({
                Name: t.value,
                Price: parseFloat(document.getElementById("s7_p_price_" + i)?.value || "0"),
                OriginalPrice: parseFloat(document.getElementById("s7_p_orig_" + i)?.value || "0"),
                ImageUrl: document.getElementById("s7_p_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg",
                LinkUrl: "/category/study-essentials",
                ButtonText: "Add to Cart"
            });
        }

        // Section 10 FAQs
        for (let i = 0; i < 15; i++) {
            const q = document.getElementById("s10_q_" + i);
            if (!q) break;
            payload.Section10.Faqs.push({
                Question: q.value,
                Answer: document.getElementById("s10_a_" + i)?.value || ""
            });
        }

        // Categories Page 8 Categories
        for (let i = 0; i < 12; i++) {
            const n = document.getElementById("cat_item_name_" + i);
            if (!n) break;
            payload.CategoriesPage.Categories.push({
                Name: n.value,
                Slug: document.getElementById("cat_item_slug_" + i)?.value || "",
                Description: document.getElementById("cat_item_desc_" + i)?.value || "",
                ImageUrl: document.getElementById("cat_item_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg"
            });
        }

        // Checklist Page 10 Categories
        for (let i = 0; i < 20; i++) {
            const t = document.getElementById("chk_cat_title_" + i);
            if (!t) break;
            const itemsRaw = document.getElementById("chk_cat_items_" + i)?.value || "";
            const items = itemsRaw.split("\n").map(l => l.trim()).filter(l => l.length > 0).map((line, itemIdx) => {
                const isChecked = line.endsWith("*");
                const cleanName = isChecked ? line.substring(0, line.length - 1).trim() : line;
                return {
                    Id: "cat-" + (i + 1) + "-item-" + (itemIdx + 1),
                    Name: cleanName,
                    IsChecked: isChecked
                };
            });

            payload.ChecklistPage.Categories.push({
                Id: document.getElementById("chk_cat_id_" + i)?.value || ("checklist-cat-" + (i + 1)),
                Number: i + 1,
                Title: t.value,
                Subtitle: document.getElementById("chk_cat_badge_" + i)?.value || "",
                IconType: "study",
                ImageUrl: document.getElementById("chk_cat_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg",
                ShopButtonText: document.getElementById("chk_cat_btn_" + i)?.value || "Shop Now →",
                ShopButtonUrl: document.getElementById("chk_cat_link_" + i)?.value || "/category/study-essentials",
                TotalCountDisplay: document.getElementById("chk_cat_total_disp_" + i)?.value || ("View All (" + items.length + ") ↓"),
                Items: items
            });
        }

        const quickTipsRaw = document.getElementById("chk_quick_tips")?.value || "";
        payload.ChecklistPage.QuickTips = quickTipsRaw.split("\n").map(t => t.trim()).filter(t => t.length > 0);

        // Build Study Abroad Hub Profile (Dedicated Services Portal)
        payload.AbroadProfile = {
            HeroBadge: document.getElementById("abroad_hero_badge")?.value || "Study Abroad Hub",
            HeroTitle: document.getElementById("abroad_hero_title")?.value || "Your Dreams Abroad.",
            HeroTitleHighlight: document.getElementById("abroad_hero_highlight")?.value || "Our Support.",
            HeroSubtitle: document.getElementById("abroad_hero_sub")?.value || "Everything you need to plan your international education journey — all in one place.",
            HeroCtaText: document.getElementById("abroad_hero_cta_text")?.value || "Explore Study Abroad Hub →",
            HeroCtaUrl: document.getElementById("abroad_hero_cta_url")?.value || "#explore-services",
            HeroImageUrl: document.getElementById("abroad_hero_img_url")?.value || "",
            HeroHandwrittenNote: document.getElementById("abroad_hero_note")?.value || "Study Explore Grow ♡",
            HeroServices: [],
            ServicesSectionTitle: "Explore Our Services",
            ServicesSectionSubtitle: "Your complete guide to financial support, trusted consultancies and health coverage for a global education.",
            Services: [],
            TrustPillars: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(abroadProfile.TrustPillars, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null })),
            FooterSlogan: "@(abroadProfile.FooterSlogan ?? "Your Global Education Partner ♡")",
            TrustTagline: "@(abroadProfile.TrustTagline ?? abroadProfile.FooterSlogan ?? "Your Global Education Partner ♡")"
        };

        // Collect Hero Quick Service Pills from UI (Respecting Admin's enabled choices)
        document.querySelectorAll("#abroad_hero_pills_container .abroad-hero-pill-row").forEach((row, idx) => {
            const chk = row.querySelector(".abroad-hs-enabled-chk");
            const t = row.querySelector(".abroad-hs-title-input");
            const l = row.querySelector(".abroad-hs-link-input");
            const icon = row.querySelector(".abroad-hs-icon-select");
            if (t && t.value.trim().length > 0) {
                payload.AbroadProfile.HeroServices.push({
                    Id: row.dataset.pillId || ("hs-" + (idx + 1)),
                    Title: t.value.trim(),
                    TargetUrl: l ? l.value : "#",
                    IconType: icon ? icon.value : "loan",
                    IsEnabled: chk ? chk.checked : true
                });
            }
        });

        for (let i = 0; i < 10; i++) {
            const titleInput = document.getElementById("abroad_srv_title_" + i);
            if (!titleInput) break;

            const bulletsText = document.getElementById("abroad_srv_bullets_" + i)?.value || "";
            const bullets = bulletsText.split("\n").map(b => b.trim()).filter(b => b.length > 0);

            const subTitleInput = document.getElementById("abroad_sub_title_" + i);
            let subService = null;
            if (subTitleInput) {
                subService = {
                    Title: subTitleInput.value,
                    Description: document.getElementById("abroad_sub_desc_" + i)?.value || "",
                    ButtonUrl: document.getElementById("abroad_sub_link_" + i)?.value || "#",
                    IconType: i === 0 ? "bank" : "pin"
                };
            }

            payload.AbroadProfile.Services.push({
                Id: document.getElementById("abroad_srv_id_" + i)?.value || ("srv-" + (i + 1)),
                Title: titleInput.value,
                Description: document.getElementById("abroad_srv_desc_" + i)?.value || "",
                ButtonText: document.getElementById("abroad_srv_btn_" + i)?.value || "Get Started →",
                ButtonUrl: document.getElementById("abroad_srv_link_" + i)?.value || "#",
                IconType: document.getElementById("abroad_srv_icon_" + i)?.value || "service",
                ThemeColor: document.getElementById("abroad_srv_color_" + i)?.value || "blue",
                ImageUrl: document.getElementById("abroad_srv_img_" + i)?.value || "",
                SubService: subService,
                Bullets: bullets
            });
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const res = await fetch("/Admin/StudyHub/Save", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                    "RequestVerificationToken": token || ""
                },
                body: JSON.stringify(payload)
            });

            const result = await res.json();
            if (result.success) {
                showAdminToast("✓ All 10 sections & categories saved successfully!");
            } else {
                alert("Failed to save: " + (result.message || "Unknown error"));
            }
        } catch (err) {
            alert("Save failed: " + err.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = "💾 Save All Changes";
            }
        }
    }

    function showAdminToast(msg) {
        let toast = document.getElementById("dk-admin-save-toast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "dk-admin-save-toast";
            toast.style.cssText = "position: fixed; top: 30px; right: 30px; background: #059669; color: #ffffff; padding: 14px 24px; border-radius: 10px; font-weight: 700; font-size: 14px; z-index: 99999; box-shadow: 0 10px 30px rgba(0,0,0,0.2); transition: opacity 0.3s;";
            document.body.appendChild(toast);
        }
        toast.textContent = msg;
        toast.style.display = "block";
        toast.style.opacity = "1";
        setTimeout(() => {
            toast.style.opacity = "0";
            setTimeout(() => { toast.style.display = "none"; }, 300);
        }, 3000);
    }
</script>
