<!-- ========================================================
     JAVASCRIPT: SYNCHRONIZED MULTI-SECTION CAROUSEL INTERACTION
========================================================= -->
<script>
    (function () {
        var carouselEl = document.getElementById("abroadSyncCarousel");
        if (!carouselEl) return;

        var slideSets = carouselEl.querySelectorAll(".dk-abroad-sync-slide-set");
        var dots = carouselEl.querySelectorAll(".dk-sync-dot");
        var btnPause = document.getElementById("btnSyncPauseToggle");
        var btnPrev = document.getElementById("btnSyncPrev");
        var btnNext = document.getElementById("btnSyncNext");

        var iconPause = btnPause ? btnPause.querySelector(".icon-pause") : null;
        var iconPlay = btnPause ? btnPause.querySelector(".icon-play") : null;

        var totalSets = slideSets.length;
        if (totalSets <= 1) {
            if (btnPause) btnPause.style.display = "none";
            return;
        }

        var currentIndex = 0;
        var intervalMs = parseInt(carouselEl.getAttribute("data-interval"), 10) || 5000;
        var isAutoPlayEnabled = carouselEl.getAttribute("data-autoplay") !== "false";
        var isPausedByUser = false;
        var timer = null;

        function showSlideSet(index) {
            if (index < 0) index = totalSets - 1;
            if (index >= totalSets) index = 0;
            currentIndex = index;

            slideSets.forEach(function (el, idx) {
                if (idx === currentIndex) {
                    el.classList.add("active");
                    el.setAttribute("aria-hidden", "false");
                } else {
                    el.classList.remove("active");
                    el.setAttribute("aria-hidden", "true");
                }
            });

            dots.forEach(function (d, idx) {
                if (idx === currentIndex) {
                    d.classList.add("active");
                } else {
                    d.classList.remove("active");
                }
            });
        }

        function nextSlideSet() {
            showSlideSet(currentIndex + 1);
        }

        function prevSlideSet() {
            showSlideSet(currentIndex - 1);
        }

        function startTimer() {
            stopTimer();
            if (isAutoPlayEnabled && !isPausedByUser) {
                timer = setInterval(nextSlideSet, intervalMs);
                if (iconPause && iconPlay) {
                    iconPause.style.display = "block";
                    iconPlay.style.display = "none";
                }
                if (btnPause) btnPause.setAttribute("aria-label", "Pause Slides");
            }
        }

        function stopTimer() {
            if (timer) {
                clearInterval(timer);
                timer = null;
            }
        }

        function togglePause() {
            if (isPausedByUser) {
                isPausedByUser = false;
                startTimer();
            } else {
                isPausedByUser = true;
                stopTimer();
                if (iconPause && iconPlay) {
                    iconPause.style.display = "none";
                    iconPlay.style.display = "block";
                }
                if (btnPause) btnPause.setAttribute("aria-label", "Resume Slides");
            }
        }

        if (btnPause) {
            btnPause.addEventListener("click", togglePause);
        }

        if (btnNext) {
            btnNext.addEventListener("click", function () {
                nextSlideSet();
                if (!isPausedByUser) startTimer();
            });
        }

        if (btnPrev) {
            btnPrev.addEventListener("click", function () {
                prevSlideSet();
                if (!isPausedByUser) startTimer();
            });
        }

        dots.forEach(function (dot) {
            dot.addEventListener("click", function () {
                var targetIdx = parseInt(dot.getAttribute("data-goto"), 10);
                if (!isNaN(targetIdx)) {
                    showSlideSet(targetIdx);
                    if (!isPausedByUser) startTimer();
                }
            });
        });

        // Hover pause
        carouselEl.addEventListener("mouseenter", function () {
            if (!isPausedByUser) stopTimer();
        });
        carouselEl.addEventListener("mouseleave", function () {
            if (!isPausedByUser) startTimer();
        });

        // Initialize
        startTimer();
    })();
</script>
