    .dk-checkbox-list, .dk-radios-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }
    .dk-checkbox-label, .dk-radio-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #334155;
        cursor: pointer;
        user-select: none;
    }
    .dk-checkbox-label input, .dk-radio-item input {
        accent-color: #0284c7;
        width: 15px;
        height: 15px;
        cursor: pointer;
    }

    /* Sizes Chips */
    .dk-sizes-chips-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
    }
    .dk-size-chip-label {
        position: relative;
        cursor: pointer;
    }
    .dk-size-chip-label input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }
    .dk-size-chip-box {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        color: #334155;
        background: #ffffff;
        transition: all 0.15s;
    }
    .dk-size-chip-label input:checked + .dk-size-chip-box {
        border-color: #0284c7;
        background: #0284c7;
        color: #ffffff;
    }

    /* Colors Grid */
    .dk-colors-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 7px;
    }
    .dk-color-swatch-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        color: #334155;
        cursor: pointer;
    }
    .dk-color-swatch-item input {
        accent-color: #0284c7;
    }
    .dk-color-circle {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

    /* Custom Price Row */
    .dk-custom-price-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
    }
    .dk-price-input {
        width: 72px;
        padding: 5px 8px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }
    .dk-price-sep {
        color: #94a3b8;
    }
    .dk-btn-price-go {
        padding: 5px 12px;
        background: #0f172a;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s;
    }
    .dk-btn-price-go:hover {
        background: #0284c7;
    }

    /* In Stock Switch */
    .dk-switch-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        user-select: none;
    }
    .dk-switch-label input {
        display: none;
    }
    .dk-switch-slider {
        position: relative;
        width: 36px;
        height: 20px;
        background: #cbd5e1;
        border-radius: 999px;
        transition: background 0.2s;
    }
    .dk-switch-slider::before {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        width: 16px;
        height: 16px;
        background: #ffffff;
        border-radius: 50%;
        transition: transform 0.2s;
    }
    .dk-switch-label input:checked + .dk-switch-slider {
        background: #0284c7;
    }
    .dk-switch-label input:checked + .dk-switch-slider::before {
        transform: translateX(16px);
