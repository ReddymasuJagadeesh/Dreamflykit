@model Dreamflykit.Application.StudyHub.Models.ConsultancyDetailsPageDto
@{
    Layout = "_Layout";
    var cPage = Model ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage();
    ViewData["Title"] = $"{cPage.HeroHeadline} {cPage.HeroHeadlineHighlight} — {cPage.BrandName} Global Programs";
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    var pills = cPage.CategoryPills != null && cPage.CategoryPills.Count > 0
        ? cPage.CategoryPills
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().CategoryPills;

    var partners = cPage.Partners != null && cPage.Partners.Count > 0
        ? cPage.Partners
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().Partners;

    var trending = cPage.TrendingCourses != null && cPage.TrendingCourses.Count > 0
        ? cPage.TrendingCourses
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().TrendingCourses;

    var popular = cPage.PopularPrograms != null && cPage.PopularPrograms.Count > 0
        ? cPage.PopularPrograms
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().PopularPrograms;

    var countries = cPage.Countries != null && cPage.Countries.Count > 0
        ? cPage.Countries
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().Countries;

    var activeCountry = countries.FirstOrDefault(c => c.IsActive) ?? countries.FirstOrDefault() ?? new Dreamflykit.Application.StudyHub.Models.ConsultancyCountryDto();
}

<div class="dk-upg-root" id="consultancyRoot">

    @if (canManage)
    {
        <!-- Admin Shortcut Bar -->
        <div class="dk-upg-admin-bar">
            <div class="dk-upg-admin-inner">
                <span class="dk-upg-admin-tag">⚡ Super Admin Controls</span>
                <span>You can edit all logos, hero image/video, programs, partner brands and destination showcases anytime in Admin.</span>
                <a href="/Admin/StudyAbroadHub#tab-consultancy" class="dk-upg-admin-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <span>Edit Consultancy Portal in Admin</span>
                </a>
            </div>
        </div>
    }

    <!-- ========================================================
         1. TOP NAVIGATION BAR (upGrad Inspired with Dreamflykit Logo)
    ========================================================= -->
    <header class="dk-upg-header">
        <div class="dk-upg-nav-container">
            <!-- Brand Logo (Dreamflykit Logo in place of upGrad) -->
            <a href="/study-abroad-hub/consultancy" class="dk-upg-brand" title="@cPage.BrandName Study Abroad Consultancy">
                @if (!string.IsNullOrWhiteSpace(cPage.LogoUrl))
                {
                    <img src="@cPage.LogoUrl" alt="@cPage.BrandName" class="dk-upg-brand-img" onerror="this.onerror=null; this.src='/images/branding/dreamflykit-logo-clean.webp';" />
                }
                else
                {
                    <img src="/images/branding/dreamflykit-logo-clean.webp" alt="Dreamflykit" class="dk-upg-brand-img" onerror="this.style.display='none'; document.getElementById('dkFallbackBrandText').style.display='inline-block';" />
                    <span id="dkFallbackBrandText" style="display: none; font-size: 22px; font-weight: 900; color: #e52d27; letter-spacing: -0.5px;">@cPage.BrandName</span>
                }
            </a>

            <!-- Navigation Links -->
            <nav class="dk-upg-nav-menu" aria-label="Main Consultancy Navigation">
                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>Upskilling Courses</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="#trending-courses" onclick="filterCategory('ai')">🤖 Generative &amp; Agentic AI</a>
                        <a href="#trending-courses" onclick="filterCategory('data')">📈 Data Science &amp; Analytics</a>
                        <a href="#popular-programs" onclick="filterCategory('ml')">💻 Machine Learning &amp; Cloud</a>
                        <a href="#popular-programs" onclick="filterCategory('mba')">🎓 Executive MBA &amp; Leadership</a>
                    </div>
                </div>

                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>Study Abroad</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="#destination-showcase">🇫🇷 Study in France</a>
                        <a href="#destination-showcase">🇨🇦 Study in Canada</a>
                        <a href="#destination-showcase">🇬🇧 Study in United Kingdom</a>
                        <a href="#destination-showcase">🇫🇮 Study in Finland</a>
                        <a href="/study-abroad-hub/education-loans">💰 Abroad Education Loans</a>
                    </div>
                </div>

                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>Professional Certifications</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="#trending-courses">IIT / IIM Advanced Certifications</a>
                        <a href="#trending-courses">Cybersecurity &amp; AI Security</a>
                        <a href="#popular-programs">Semiconductor &amp; Hardware Tech</a>
                    </div>
                </div>

                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>Learn Offline</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="#popular-programs">In-Person Workshops (Bengaluru)</a>
                        <a href="#popular-programs">Global Immersion Trips (Paris / UK)</a>
                    </div>
                </div>

                <a href="#trending-courses" class="dk-upg-nav-link">School of Tech</a>

                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>More</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="/study-abroad-hub">🌐 Study Abroad Hub Profile</a>
                        <a href="/study-abroad-hub/education-loans">🎓 Education Loans Portal</a>
                        <a href="/abroad-packing-checklist">📋 Packing Checklist</a>
                    </div>
                </div>
            </nav>

            <!-- Sign Up CTA Button -->
            <div class="dk-upg-nav-action">
                <button type="button" class="dk-upg-signup-btn" onclick="openConsultancyModal('General Sign Up')">
                    @cPage.SignUpButtonText
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================================
         2. HERO SECTION (Secure Image or Video Banner)
    ========================================================= -->
    <section class="dk-upg-hero-section" id="heroBanner">
        <!-- Media Backdrop: Video or Image -->
        @if (cPage.HeroMediaType == "video" && !string.IsNullOrWhiteSpace(cPage.HeroVideoUrl))
        {
            <div class="dk-upg-hero-media-wrapper">
                <video class="dk-upg-hero-video" autoplay muted loop playsinline poster="@cPage.HeroImageUrl">
                    <source src="@cPage.HeroVideoUrl" type="video/mp4" />
                    <source src="@cPage.HeroVideoUrl" type="video/webm" />
                </video>
                <div class="dk-upg-hero-overlay"></div>
            </div>
        }
        else
        {
            <div class="dk-upg-hero-media-wrapper">
                <div class="dk-upg-hero-img-bg" style="background-image: url('@cPage.HeroImageUrl');"></div>
                <div class="dk-upg-hero-overlay"></div>
            </div>
        }

        <div class="dk-upg-hero-content">
            <!-- Headline matching Image 2 -->
            <h1 class="dk-upg-hero-title">
                <span class="dk-upg-title-serif">@cPage.HeroHeadline</span>
                <span class="dk-upg-title-sans">@cPage.HeroHeadlineHighlight</span>
            </h1>

            <!-- Interactive Search Box -->
            <div class="dk-upg-search-card">
                <div class="dk-upg-search-inner">
                    <span class="dk-upg-search-icon">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#e52d27" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    </span>
                    <input type="text" 
                           id="upgCourseSearchInput" 
                           class="dk-upg-search-input" 
                           placeholder="@cPage.SearchPlaceholder" 
                           oninput="handleSearchCourses(this.value)" 
                           autocomplete="off" />
                    <button type="button" class="dk-upg-search-action-btn" onclick="triggerSearchScroll()" aria-label="Search Programs">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <!-- Category Pills Bar (Image 2 style) -->
            <div class="dk-upg-pills-row" id="pillsBar">
                @foreach (var pill in pills)
                {
                    <button type="button" class="dk-upg-pill" data-tag="@pill.FilterTag" onclick="filterCategory('@pill.FilterTag', this)">
                        <span class="dk-upg-pill-icon">@pill.Icon</span>
                        <span class="dk-upg-pill-label">@pill.Title</span>
                    </button>
                }
            </div>
        </div>

        <!-- Sub-Banner beneath Hero (Image 2) -->
        <div class="dk-upg-subbanner">
            <div class="dk-upg-subbanner-text">
                <span class="dk-upg-highlight-red">@cPage.SubBannerPrefix</span> @cPage.SubBannerHighlight
            </div>
        </div>
    </section>

    <!-- ========================================================
         3. PARTNER BRANDS & ACCREDITATION STRIP (Image 3)
    ========================================================= -->
    <section class="dk-upg-partners-section" aria-label="Partner Universities and Top Firms">
        <div class="dk-upg-partners-inner">
            <h2 class="dk-upg-partners-title">@cPage.PartnerTitle</h2>
            <div class="dk-upg-partners-track">
                @foreach (var partner in partners)
                {
                    <div class="dk-upg-partner-item" title="@partner.Name">
                        @if (!string.IsNullOrWhiteSpace(partner.LogoUrl))
                        {
                            <img src="@partner.LogoUrl" alt="@partner.Name" class="dk-upg-partner-logo" loading="lazy" />
                        }
                        else
                        {
                            <span class="dk-upg-partner-fallback">@partner.Name</span>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         4. TRENDING COURSES — GET FUTURE-READY WITH AI (Image 3)
         Deep Cyber Tech Dark Navy Theme
    ========================================================= -->
    <section class="dk-upg-trending-section" id="trending-courses">
        <div class="dk-upg-container">
            <div class="dk-upg-section-head">
                <div class="dk-upg-sec-tag">@cPage.TrendingBadge</div>
                <h2 class="dk-upg-sec-title">
                    <span>Get Future-Ready with </span><span class="dk-upg-ai-glow">AI</span>
                </h2>
                <p class="dk-upg-sec-subtitle">@cPage.TrendingSubtitle</p>
            </div>

            <!-- Cards Carousel Controls -->
            <div class="dk-upg-cards-wrapper">
                <div class="dk-upg-cards-grid" id="trendingCardsGrid">
                    @foreach (var course in trending)
                    {
                        <div class="dk-upg-course-card" data-title="@course.Title" data-inst="@course.Institution">
                            <!-- Card Image -->
                            <div class="dk-upg-card-media">
                                <img src="@course.ImageUrl" alt="@course.Title" class="dk-upg-card-img" onerror="this.src='/images/study-hub/edu-campus-iiit.jpg';" loading="lazy" />
                                <div class="dk-upg-card-logo-badge">
                                    <div class="dk-upg-card-inst-circle">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                                    </div>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="dk-upg-card-body">
                                <div class="dk-upg-card-inst">@course.Institution</div>
                                <h3 class="dk-upg-card-title">@course.Title</h3>

                                <!-- Badges -->
                                <div class="dk-upg-card-badges">
                                    <div class="dk-upg-badge-line">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                                        <span>@course.BadgeType</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(course.BadgeTag))
                                    {
                                        <div class="dk-upg-badge-line dk-highlight-badge">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                            <span>@course.BadgeTag</span>
                                        </div>
                                    }
                                    <div class="dk-upg-badge-line">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        <span>@course.Duration</span>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="dk-upg-card-actions">
                                    <button type="button" class="dk-upg-btn-outline" onclick="openProgramDetails('@course.Institution', '@course.Title', 'overview')">
                                        @course.Button1Text
                                    </button>
                                    <button type="button" class="dk-upg-btn-red" onclick="openProgramDetails('@course.Institution', '@course.Title', 'syllabus')">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        <span>@course.Button2Text</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Carousel Navigation Arrow -->
                <button type="button" class="dk-upg-carousel-nav next" onclick="scrollCarousel('trendingCardsGrid', 360)" aria-label="Next Courses">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
    </section>

    <!-- ========================================================
         5. MOST POPULAR PROGRAMS (Image 4)
         Crisp Modern Light Background
    ========================================================= -->
    <section class="dk-upg-popular-section" id="popular-programs">
        <div class="dk-upg-container">
            <div class="dk-upg-popular-head">
                <h2 class="dk-upg-popular-title">
                    <span>Explore our </span><span class="dk-upg-red-text">most popular programs</span>
                </h2>
                <p class="dk-upg-popular-sub">@cPage.PopularSubtitle</p>
            </div>

            <div class="dk-upg-cards-wrapper">
                <div class="dk-upg-cards-grid" id="popularCardsGrid">
                    @foreach (var prog in popular)
                    {
                        <div class="dk-upg-course-card light-theme" data-title="@prog.Title" data-inst="@prog.Institution">
                            <div class="dk-upg-card-media">
                                <img src="@prog.ImageUrl" alt="@prog.Title" class="dk-upg-card-img" onerror="this.src='/images/study-hub/campus-paris-school.jpg';" loading="lazy" />
                                <div class="dk-upg-card-logo-badge">
                                    <div class="dk-upg-card-inst-circle">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e52d27" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10M6 10h10"/></svg>
                                    </div>
                                </div>
                            </div>

                            <div class="dk-upg-card-body">
                                <div class="dk-upg-card-inst">@prog.Institution</div>
                                <h3 class="dk-upg-card-title">@prog.Title</h3>

                                <div class="dk-upg-card-badges">
                                    @if (!string.IsNullOrWhiteSpace(prog.BadgeTag))
                                    {
                                        <div class="dk-upg-badge-pill-cyan">
                                            <span>@prog.BadgeTag</span>
                                        </div>
                                    }
                                    <div class="dk-upg-badge-line">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                                        <span>@prog.BadgeType</span>
                                    </div>
                                    <div class="dk-upg-badge-line">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        <span>@prog.Duration</span>
                                    </div>
                                </div>

                                <div class="dk-upg-card-actions">
                                    <button type="button" class="dk-upg-btn-outline" onclick="openProgramDetails('@prog.Institution', '@prog.Title', 'overview')">
                                        @prog.Button1Text
                                    </button>
                                    <button type="button" class="dk-upg-btn-red" onclick="openProgramDetails('@prog.Institution', '@prog.Title', 'apply')">
                                        <span>@prog.Button2Text</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button type="button" class="dk-upg-carousel-nav next" onclick="scrollCarousel('popularCardsGrid', 360)" aria-label="Next Programs">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
    </section>

    <!-- ========================================================
         6. STUDY IN FRANCE / DESTINATION COUNTRY SHOWCASE (Image 5)
    ========================================================= -->
    <section class="dk-upg-dest-section" id="destination-showcase">
        <div class="dk-upg-container">
            <div class="dk-upg-dest-head">
                <h2 class="dk-upg-dest-title">
                    <span>Study in </span><span class="dk-upg-red-text">@activeCountry.CountryName</span><span> for Indian Students</span>
                </h2>
                <a href="#consultancy-lead-modal" class="dk-upg-dest-explore-link" onclick="openConsultancyModal('@activeCountry.CountryName Study Programs')">
                    @cPage.DestinationExploreText
                </a>
            </div>

            <!-- Destination Layout: Left Country Rail, Center Panoramic Banner, Right Program Cards -->
            <div class="dk-upg-dest-layout">
                <!-- Left Vertical / Horizontal Tabs for Countries -->
                <div class="dk-upg-country-rail">
                    @foreach (var c in countries)
                    {
                        var isCurrent = (c.CountryCode == activeCountry.CountryCode);
                        <button type="button" 
                                class="dk-upg-country-tab @(isCurrent ? "active" : "")" 
                                onclick="switchDestinationCountry('@c.CountryCode', this)">
                            <span>@c.CountryName.ToUpperInvariant()</span>
                        </button>
                    }
                </div>

                <!-- Panoramic Hero Destination Canvas with Overlay Program Cards -->
                <div class="dk-upg-dest-stage" style="background-image: url('@activeCountry.HeroImageUrl');" id="destHeroStage">
                    <div class="dk-upg-dest-overlay"></div>

                    <!-- Slide Index & Prev/Next Arrows -->
                    <div class="dk-upg-dest-nav-bar">
                        <div class="dk-upg-dest-slide-counter" id="destSlideNum">@activeCountry.SlideNumber</div>
                        <div class="dk-upg-dest-arrow-group">
                            <button type="button" class="dk-upg-circle-nav prev" onclick="prevDestinationCountry()" aria-label="Previous Country">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                            </button>
                            <button type="button" class="dk-upg-circle-nav next" onclick="nextDestinationCountry()" aria-label="Next Country">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Right Overlay Cards (Image 5 style) -->
                    <div class="dk-upg-dest-cards-col" id="destProgramsContainer">
                        @foreach (var p in activeCountry.Programs)
                        {
                            <div class="dk-upg-dest-program-card">
                                <div class="dk-upg-dest-card-header">
                                    <div class="dk-upg-dest-flag-icon">🇫🇷</div>
                                    <div class="dk-upg-dest-inst">@p.Institution</div>
                                </div>
                                <h4 class="dk-upg-dest-card-title">@p.Title</h4>
                                @if (!string.IsNullOrWhiteSpace(p.BadgeTag))
                                {
                                    <div class="dk-upg-dest-accred-badge">@p.BadgeTag</div>
                                }
                                <div class="dk-upg-dest-meta-row">
                                    <span>🎓 @p.BadgeType</span>
                                    <span>⏱ @p.Duration</span>
                                </div>
                                <button type="button" class="dk-upg-dest-btn-red" onclick="openProgramDetails('@p.Institution', '@p.Title', 'destination')">
                                    @p.Button1Text
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 4 Key Stat Metric Counters (Image 5) -->
            <div class="dk-upg-stats-bar" id="destStatsBar">
                @foreach (var s in activeCountry.Stats)
                {
                    <div class="dk-upg-stat-item">
                        <div class="dk-upg-stat-val">@s.Value</div>
                        <div class="dk-upg-stat-label">@s.Label</div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         7. FLOATING ACTION WIDGETS (Bottom Left & Right)
    ========================================================= -->
    <!-- Scroll To Top (Image 4 & 5 Bottom-Left) -->
    <button type="button" class="dk-upg-scroll-top-btn" id="btnScrollTop" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Scroll to top" title="Scroll to top">
