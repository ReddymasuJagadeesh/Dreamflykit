                HeroBullets: [
                    document.getElementById("edu_bullet_1")?.value || "Interest Rate Starting at 8.33%*",
                    document.getElementById("edu_bullet_2")?.value || "Sanctions in 48 Hours*",
                    document.getElementById("edu_bullet_3")?.value || "Savings up to ₹15 lacs",
                    document.getElementById("edu_bullet_4")?.value || "Non Collateral Loans"
                ],
                HeroCtaText: document.getElementById("edu_hero_cta_text")?.value || "Check your Eligibility",
                HeroCtaUrl: document.getElementById("edu_hero_cta_url")?.value || "#apply-loan-modal",
                HeroImageUrl: document.getElementById("edu_hero_img_url")?.value || "/images/study-hub/edu-loan-student.jpg",
                ReviewRating: document.getElementById("edu_review_rating")?.value || "4.8 out of 5",
                ReviewCountText: document.getElementById("edu_review_text")?.value || "Google Reviews Rated 4.8 out of 5",
                Metric1Label: document.getElementById("edu_m1_label")?.value || "Loan Partners",
                Metric1Value: document.getElementById("edu_m1_val")?.value || "20+",
                Metric2Label: document.getElementById("edu_m2_label")?.value || "Amount Disbursed",
                Metric2Value: document.getElementById("edu_m2_val")?.value || "₹ 2,000 Cr+",
                Metric3Label: document.getElementById("edu_m3_label")?.value || "Countries Served",
                Metric3Value: document.getElementById("edu_m3_val")?.value || "50+",
                Metric4Label: document.getElementById("edu_m4_label")?.value || "Students Supported",
                Metric4Value: document.getElementById("edu_m4_val")?.value || "20,000+",
                PartnersTitle: document.getElementById("edu_partners_title")?.value || "Our Loan Partners",
                PartnersSubtitle: document.getElementById("edu_partners_sub")?.value || "Find Your Fit: Top Interest Rates from 20+ Lenders",
                PartnersViewMoreText: document.getElementById("edu_partners_viewmore")?.value || "View More ⌵",
                Partners: gatherEduPartners(),
                HowItWorksTitle: document.getElementById("edu_how_title")?.value || "How it Works?",
                HowItWorksSubtitle: document.getElementById("edu_how_sub")?.value || "Take advantage of our 100% digital process in just 5 easy steps",
                Steps: gatherEduSteps(),
                CoursesTag: document.getElementById("edu_courses_tag")?.value || "TRENDING COURSES & FINANCING",
                CoursesTitle: document.getElementById("edu_courses_title")?.value || "Get Future-Ready with AI",
                CoursesSubtitle: document.getElementById("edu_courses_sub")?.value || "Fund high-impact degrees & certifications...",
                CoursesBgImageUrl: document.getElementById("edu_courses_bg_url")?.value || "/images/study-hub/edu-courses-tech-bg.jpg",
                CoursesSlideIntervalSec: parseInt(document.getElementById("edu_courses_interval")?.value || "3", 10),
                Courses: gatherEduCourses(),
                FloatingPromptTitle: document.getElementById("edu_float_title")?.value || "Start your degree or diploma at 10k per month!",
                FloatingPromptDesc: document.getElementById("edu_float_desc")?.value || "Best-in-class courses in Data Science, Management and Technology",
                FloatingPromptPhone: document.getElementById("edu_float_phone")?.value || "1800-DREAMFLY",
                FloatingPromptWhatsApp: document.getElementById("edu_float_wa")?.value || "+919163012345"
            }
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const res = await fetch("/Admin/StudyAbroadHub/SaveConfig", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                    "RequestVerificationToken": token || ""
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                showHubToast("✓ Study Abroad Hub Profile saved successfully!", true);
            } else {
                alert("Save failed: " + (data.message || "Unknown error"));
            }
        } catch (err) {
            alert("Save failed: " + err.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = "💾 Save All Changes Now";
            }
        }
    }

    function showHubToast(message, isSuccess = true) {
        let toast = document.getElementById("hubToast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "hubToast";
            toast.style.cssText = "position: fixed; top: 24px; right: 24px; padding: 12px 24px; border-radius: 10px; font-weight: 800; font-size: 14px; z-index: 99999; box-shadow: 0 8px 24px rgba(0,0,0,0.2); transition: all 0.3s ease;";
            document.body.appendChild(toast);
        }
        toast.style.background = isSuccess ? "#059669" : "#d97706";
        toast.style.color = "#ffffff";
        toast.textContent = message;
        toast.style.display = "block";
        setTimeout(() => { toast.style.display = "none"; }, 3500);
    }

    function setUploadingSoon(inputId, previewId) {
        const inp = document.getElementById(inputId);
        if (inp) {
            inp.value = "/images/study-hub/upload-soon.svg";
            updateLivePreview(inputId, previewId);
            showHubToast("⏳ Image set to 'Uploading Soon' placeholder");
        }
    }

    // Dynamic Helper Functions for Education Loans Admin Panel
    function gatherEduPartners() {
        const list = [];
        document.querySelectorAll("#edu_partners_container .edu-partner-admin-card").forEach(c => {
            list.push({
                Id: c.dataset.partnerId || ("partner-" + Math.random().toString(36).substr(2, 6)),
                Name: c.querySelector(".edu-partner-name")?.value || "Bank Partner",
                InterestRateText: c.querySelector(".edu-partner-rate")?.value || "Interest rate 10.25% p.a* >",
                LogoUrl: c.querySelector(".edu-partner-logo")?.value || "",
                BadgeColor: "#16a34a",
                LinkUrl: "#apply-loan-modal"
            });
        });
        return list;
    }

    function addEduPartner() {
        const wrap = document.getElementById("edu_partners_container");
        if (!wrap) return;
        const count = wrap.querySelectorAll(".edu-partner-admin-card").length + 1;
