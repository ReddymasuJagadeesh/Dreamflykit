@model Dreamflykit.Application.StudyHub.Models.StudyHubDto
@{
    Layout = "_Layout";
    var profile = Model.AbroadProfile ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultAbroadProfile();
    ViewData["Title"] = (!string.IsNullOrWhiteSpace(profile.HeroTitle) ? profile.HeroTitle + " " + profile.HeroTitleHighlight : "Study Abroad Hub") + " — Dreamflykit";
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    var sLoans = profile.Services.FirstOrDefault(s => s.Id == "srv-loans") ?? profile.Services.ElementAtOrDefault(0);
    var sConsultancy = profile.Services.FirstOrDefault(s => s.Id == "srv-consultancy") ?? profile.Services.ElementAtOrDefault(1);
    var sInsurance = profile.Services.FirstOrDefault(s => s.Id == "srv-insurance") ?? profile.Services.ElementAtOrDefault(2);
    var sBooking = profile.Services.FirstOrDefault(s => s.Id == "srv-booking") ?? profile.Services.ElementAtOrDefault(3);
    var sTests = profile.Services.FirstOrDefault(s => s.Id == "srv-tests") ?? profile.Services.ElementAtOrDefault(4);
    var sScholarships = profile.Services.FirstOrDefault(s => s.Id == "srv-scholarships") ?? profile.Services.ElementAtOrDefault(5);
}

<div class="dk-abroad-hub-root">

    @if (canManage)
    {
        <div class="dk-abroad-admin-notice">
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <span class="dk-abroad-admin-pill">Admin Controls</span>
                <span>Super Admin can edit titles, descriptions, and upload all service images anytime in the Admin Dashboard.</span>
            </div>
            <a href="/Admin/StudyHub#tab-abroad-profile" class="dk-abroad-admin-link">
                ⚙️ Open Study Abroad Hub Profile Admin Controls
            </a>
        </div>
    }

    <!-- ========================================================
         HERO BANNER: BIG ATTRACTIVE FULL-WIDTH IMAGE BANNER
    ========================================================= -->
    <section class="dk-abroad-hero-section @(!string.IsNullOrWhiteSpace(profile.HeroImageUrl) ? "has-hero-bg" : "is-uploading-soon")"
             style="@(!string.IsNullOrWhiteSpace(profile.HeroImageUrl) ? $"background-image: url('{profile.HeroImageUrl}');" : "")"
             aria-label="Study Abroad Hub Hero">

        <!-- Translucent Backdrop Overlay to guarantee crisp text contrast -->
        <div class="dk-abroad-hero-overlay" aria-hidden="true"></div>

        @if (string.IsNullOrWhiteSpace(profile.HeroImageUrl))
        {
            <div class="dk-abroad-hero-deco-bg" aria-hidden="true">
                <span class="dk-deco-plane-sky">✈</span>
                <span class="dk-deco-cloud cloud-1">☁</span>
                <span class="dk-deco-cloud cloud-2">☁</span>
                <svg class="dk-skyline-silhouette" viewBox="0 0 1000 240" fill="none" opacity="0.18" preserveAspectRatio="xMaxYMid meet">
                    <path d="M40 240V140h20v-40h12v40h20v100H40z M72 70l-6 30h12z" fill="#0284c7"/>
                    <path d="M140 240V110h24v130h-24z M152 70l-8 40h16z" fill="#0284c7"/>
                    <path d="M260 240l30-180h12l30 180h-18l-10-60h-16l-10 60h-18z M294 130h18l-9-60z" fill="#0284c7"/>
                    <path d="M420 240c0-70 50-110 110-110v110h-110z M540 240c0-85 60-125 130-125v125h-130z" fill="#0284c7"/>
                    <path d="M720 240l40-150h15l40 150h-20l-12-50h-31l-12 50h-20z" fill="#0284c7"/>
                </svg>
            </div>

            <!-- Uploading Soon notice badge -->
            <div class="dk-abroad-hero-status-pill">
                <span class="dk-status-pulse-dot"></span>
                <span>📷 Full Hero Image: Uploading Soon • Admin can upload panoramic banner anytime</span>
                @if (canManage)
                {
                    <a href="/Admin/StudyHub#tab-abroad-profile" class="dk-status-admin-link">Upload Image in Admin →</a>
                }
            </div>
        }

        <div class="dk-abroad-hero-inner">
            
            <div class="dk-abroad-hero-content">
                <div class="dk-abroad-hero-badge">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
                    </svg>
                    <span>@profile.HeroBadge</span>
                </div>

                <h1 class="dk-abroad-hero-heading">
                    @profile.HeroTitle
                    <span class="dk-abroad-highlight">@profile.HeroTitleHighlight</span>
                </h1>

                <p class="dk-abroad-hero-sub">
                    @profile.HeroSubtitle
                </p>

                <!-- DIRECT HERO SERVICE PILLS (Admin can choose what to display) -->
                @{
                    var displayPills = (profile.HeroServices ?? new List<Dreamflykit.Application.StudyHub.Models.AbroadHeroServiceItemDto>())
                        .Where(hs => hs.IsEnabled)
                        .ToList();
                }
                @if (displayPills.Count > 0)
                {
                    <div class="dk-abroad-hero-quick-services" role="navigation" aria-label="Quick Hub Services">
                        @foreach (var hs in displayPills)
                        {
                            <a href="@hs.TargetUrl" class="dk-abroad-h-badge">
                                <span class="dk-abroad-h-icon" aria-hidden="true">
                                    @if (hs.IconType == "loan")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                                    }
                                    else if (hs.IconType == "gr_loan")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="21" x2="21" y2="21"></line><line x1="3" y1="10" x2="21" y2="10"></line><polyline points="5 6 12 3 19 6"></polyline><line x1="4" y1="10" x2="4" y2="21"></line><line x1="20" y1="10" x2="20" y2="21"></line></svg>
                                    }
                                    else if (hs.IconType == "consultancy")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    }
                                    else if (hs.IconType == "near_me")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    }
                                    else if (hs.IconType == "insurance")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    }
                                    else if (hs.IconType == "booking")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="12" cy="15" r="2"/></svg>
                                    }
                                    else if (hs.IconType == "test")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="12" y2="11"/></svg>
                                    }
                                    else if (hs.IconType == "scholarship")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                                    }
                                    else
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="m10 15 5-3-5-3v6z"/></svg>
                                    }
                                </span>
                                <span>@hs.Title</span>
                            </a>
                        }
                    </div>
                }

                <div class="dk-abroad-hero-cta-line">
                    <a href="@profile.HeroCtaUrl" class="dk-abroad-cta-btn">
                        <span>@profile.HeroCtaText</span>
                    </a>

                    <div class="dk-abroad-slider-dots" aria-hidden="true">
                        <span class="dk-dot active"></span>
                        <span class="dk-dot"></span>
                        <span class="dk-dot"></span>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- ========================================================
         EXPLORE OUR SERVICES: 6 SERVICES (ROWS 1 & 2)
    ========================================================= -->
    <section class="dk-abroad-services-section" id="explore-services" aria-labelledby="abroadServicesTitle">
        
        <div class="dk-abroad-section-header">
            <div class="dk-abroad-header-crest">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
            </div>
            <div>
                <h2 id="abroadServicesTitle" class="dk-abroad-section-title">@profile.ServicesSectionTitle</h2>
                <p class="dk-abroad-section-subtitle">@profile.ServicesSectionSubtitle</p>
            </div>
        </div>

        <!-- ROW 1: LOANS, CONSULTANCY, HEALTH INSURANCE -->
        <div class="dk-abroad-cards-grid dk-abroad-grid-row1">

            <!-- CARD 1: EDUCATIONAL LOANS (+ GR LOANS) -->
            @if (sLoans != null)
            {
                <div class="dk-abroad-service-card" id="service-loans">
                    <div class="dk-abroad-card-top">
                        <div class="dk-abroad-icon-bubble color-blue">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                        </div>
                        <div style="flex: 1;">
                            <h3 class="dk-abroad-card-title">@sLoans.Title</h3>
                            <p class="dk-abroad-card-desc">@sLoans.Description</p>
                        </div>
                    </div>

                    <div class="dk-abroad-card-action-row">
                        <a href="@sLoans.ButtonUrl" class="dk-abroad-btn-pill btn-blue">
                            @sLoans.ButtonText
                        </a>

                        <!-- IMAGE / UPLOADING SOON -->
                        <div class="dk-abroad-card-media-box">
                            @if (!string.IsNullOrWhiteSpace(sLoans.ImageUrl))
                            {
                                <img src="@sLoans.ImageUrl" alt="@sLoans.Title" class="dk-abroad-card-img" />
                            }
                            else
                            {
                                <div class="dk-card-uploading-tag">
                                    <span class="dk-card-u-icon">📷</span>
                                    <span>Uploading Soon</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (sLoans.SubService != null)
                    {
                        <div class="dk-abroad-sub-card sub-blue">
                            <div class="dk-sub-left">
                                <div class="dk-sub-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="21" x2="21" y2="21"></line><line x1="3" y1="10" x2="21" y2="10"></line><polyline points="5 6 12 3 19 6"></polyline><line x1="4" y1="10" x2="4" y2="21"></line><line x1="20" y1="10" x2="20" y2="21"></line></svg>
                                </div>
                                <div>
                                    <div class="dk-sub-title">@sLoans.SubService.Title</div>
                                    <div class="dk-sub-desc">@sLoans.SubService.Description</div>
                                </div>
                            </div>
                            <a href="@sLoans.SubService.ButtonUrl" class="dk-sub-circle-btn" aria-label="Go to @sLoans.SubService.Title">
                                →
                            </a>
                        </div>
                    }
                </div>
            }

            <!-- CARD 2: CONSULTANCY DETAILS (+ FIND NEAR ME) -->
            @if (sConsultancy != null)
            {
                <div class="dk-abroad-service-card" id="service-consultancies">
                    <div class="dk-abroad-card-top">
                        <div class="dk-abroad-icon-bubble color-purple">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <div style="flex: 1;">
                            <h3 class="dk-abroad-card-title">@sConsultancy.Title</h3>
                            <p class="dk-abroad-card-desc">@sConsultancy.Description</p>
                        </div>
                    </div>

                    <div class="dk-abroad-card-action-row">
                        <a href="@sConsultancy.ButtonUrl" class="dk-abroad-btn-pill btn-purple">
                            @sConsultancy.ButtonText
                        </a>

                        <!-- IMAGE / UPLOADING SOON -->
                        <div class="dk-abroad-card-media-box">
                            @if (!string.IsNullOrWhiteSpace(sConsultancy.ImageUrl))
                            {
                                <img src="@sConsultancy.ImageUrl" alt="@sConsultancy.Title" class="dk-abroad-card-img" />
                            }
                            else
                            {
                                <div class="dk-card-uploading-tag">
                                    <span class="dk-card-u-icon">📷</span>
                                    <span>Uploading Soon</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (sConsultancy.SubService != null)
                    {
                        <div class="dk-abroad-sub-card sub-purple">
                            <div class="dk-sub-left">
                                <div class="dk-sub-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                </div>
                                <div>
                                    <div class="dk-sub-title">@sConsultancy.SubService.Title</div>
                                    <div class="dk-sub-desc">@sConsultancy.SubService.Description</div>
                                </div>
                            </div>
                            <a href="@sConsultancy.SubService.ButtonUrl" class="dk-sub-circle-btn" aria-label="Go to @sConsultancy.SubService.Title">
                                →
                            </a>
                        </div>
                    }
                </div>
            }

            <!-- CARD 3: HEALTH INSURANCE -->
            @if (sInsurance != null)
            {
                <div class="dk-abroad-service-card" id="service-insurance">
                    <div class="dk-abroad-card-top">
                        <div class="dk-abroad-icon-bubble color-teal">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <div style="flex: 1;">
                            <h3 class="dk-abroad-card-title">@sInsurance.Title</h3>
                            <p class="dk-abroad-card-desc">@sInsurance.Description</p>
                        </div>
                    </div>

                    <div style="margin-bottom: 14px;">
                        <a href="@sInsurance.ButtonUrl" class="dk-abroad-btn-pill btn-teal">
                            @sInsurance.ButtonText
                        </a>
                    </div>

                    <div class="dk-abroad-insurance-bottom">
                        <div class="dk-abroad-bullets">
                            @foreach (var b in sInsurance.Bullets)
                            {
                                <div class="dk-abroad-bullet-item">
                                    <span class="dk-bullet-check">✓</span>
                                    <span>@b</span>
                                </div>
                            }
                        </div>

                        <!-- IMAGE / UPLOADING SOON -->
                        <div class="dk-abroad-card-media-box" style="width: 120px; height: 80px;">
                            @if (!string.IsNullOrWhiteSpace(sInsurance.ImageUrl))
                            {
                                <img src="@sInsurance.ImageUrl" alt="@sInsurance.Title" class="dk-abroad-card-img" />
                            }
                            else
                            {
                                <div class="dk-card-uploading-tag">
                                    <span class="dk-card-u-icon">📷</span>
                                    <span>Uploading Soon</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- ROW 2: BOOKING SLOTS, LANGUAGE TESTS, SCHOLARSHIPS & GRANTS (From Screenshot 2) -->
        <div class="dk-abroad-cards-grid dk-abroad-grid-row2" style="margin-top: 20px;">

            <!-- CARD 4: BOOKING SLOTS -->
            @if (sBooking != null)
            {
                <div class="dk-abroad-service-card dk-card-horizontal">
                    <div style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <div class="dk-abroad-icon-bubble color-blue" style="width: 42px; height: 42px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="12" cy="15" r="2"/></svg>
                            </div>
                            <h3 class="dk-abroad-card-title" style="margin: 0;">@sBooking.Title</h3>
                        </div>
                        <p class="dk-abroad-card-desc">@sBooking.Description</p>
                        <a href="@sBooking.ButtonUrl" class="dk-abroad-btn-pill btn-blue" style="margin-top: 12px; display: inline-flex;">
                            @sBooking.ButtonText
                        </a>
                    </div>

                    <div class="dk-abroad-card-media-box" style="width: 110px; height: 80px; flex-shrink: 0;">
                        @if (!string.IsNullOrWhiteSpace(sBooking.ImageUrl))
                        {
                            <img src="@sBooking.ImageUrl" alt="@sBooking.Title" class="dk-abroad-card-img" />
                        }
                        else
                        {
                            <div class="dk-card-uploading-tag">
                                <span class="dk-card-u-icon">📷</span>
                                <span>Uploading Soon</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- CARD 5: LANGUAGE TESTS -->
            @if (sTests != null)
            {
                <div class="dk-abroad-service-card dk-card-horizontal">
                    <div style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <div class="dk-abroad-icon-bubble color-teal" style="width: 42px; height: 42px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="12" y2="11"/></svg>
                            </div>
                            <h3 class="dk-abroad-card-title" style="margin: 0;">@sTests.Title</h3>
                        </div>
                        <p class="dk-abroad-card-desc">@sTests.Description</p>
                        <a href="@sTests.ButtonUrl" class="dk-abroad-btn-pill btn-teal" style="margin-top: 12px; display: inline-flex;">
                            @sTests.ButtonText
                        </a>
                    </div>

                    <div class="dk-abroad-card-media-box" style="width: 110px; height: 80px; flex-shrink: 0;">
                        @if (!string.IsNullOrWhiteSpace(sTests.ImageUrl))
                        {
                            <img src="@sTests.ImageUrl" alt="@sTests.Title" class="dk-abroad-card-img" />
                        }
                        else
                        {
                            <div class="dk-card-uploading-tag">
                                <span class="dk-card-u-icon">📷</span>
                                <span>Uploading Soon</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- CARD 6: SCHOLARSHIPS & GRANTS -->
            @if (sScholarships != null)
            {
                <div class="dk-abroad-service-card dk-card-horizontal">
                    <div style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <div class="dk-abroad-icon-bubble color-purple" style="width: 42px; height: 42px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                            </div>
                            <h3 class="dk-abroad-card-title" style="margin: 0;">@sScholarships.Title</h3>
                        </div>
                        <p class="dk-abroad-card-desc">@sScholarships.Description</p>
                        <a href="@sScholarships.ButtonUrl" class="dk-abroad-btn-pill btn-purple" style="margin-top: 12px; display: inline-flex;">
                            @sScholarships.ButtonText
                        </a>
                    </div>

                    <div class="dk-abroad-card-media-box" style="width: 110px; height: 80px; flex-shrink: 0;">
                        @if (!string.IsNullOrWhiteSpace(sScholarships.ImageUrl))
                        {
                            <img src="@sScholarships.ImageUrl" alt="@sScholarships.Title" class="dk-abroad-card-img" />
                        }
                        else
                        {
                            <div class="dk-card-uploading-tag">
                                <span class="dk-card-u-icon">📷</span>
                                <span>Uploading Soon</span>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>

    </section>

    <!-- ========================================================
         TRUST & IMPACT BAR
    ========================================================= -->
    <section class="dk-abroad-trust-section" aria-label="Trust &amp; Verification">
        <div class="dk-abroad-trust-inner">
            <div class="dk-abroad-trust-items">
                @foreach (var p in profile.TrustPillars)
                {
                    <div class="dk-abroad-trust-col">
                        <div class="dk-abroad-trust-icon">
                            @if (p.Icon == "shield")
                            {
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            }
                            else if (p.Icon == "plane")
