@{
    ViewData["Title"] = "International Airline Baggage Rules & Shipping Guidelines — Dreamflykit";
    Layout = "_Layout";
}

<div class="dk-page-container dk-info-page">
    <div class="dk-info-hero">
        <div class="dk-info-hero-badge">✈ AIRLINE REGULATIONS & PACKING</div>
        <h1 class="dk-info-hero-title">International Student Baggage & Customs Guide</h1>
        <p class="dk-info-hero-subtitle">
            Essential guidelines on baggage limits, check-in weight limits, TSA liquid regulations, and food packing rules for USA, UK, Canada, Australia, and Europe.
        </p>
    </div>

    <!-- Overview Grid -->
    <div class="dk-pillars-grid">
        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">🧳</div>
            <h3 class="dk-pillar-title">Standard Check-In Limit</h3>
            <p class="dk-pillar-desc">
                Most international student tickets allow <strong>2 pieces of 23kg (50 lbs) each</strong>, with maximum linear dimensions of 158cm (62 inches) per bag.
            </p>
        </div>

        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">🎒</div>
            <h3 class="dk-pillar-title">Cabin & Personal Bag</h3>
            <p class="dk-pillar-desc">
                <strong>1 Cabin Bag (7-8 kg)</strong> + <strong>1 Personal Item</strong> (laptop backpack). Keep all original passports, I-20/CAS/COE, medications, and cash in your cabin bag.
            </p>
        </div>

        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">🧪</div>
            <h3 class="dk-pillar-title">TSA 3-1-1 Liquid Rule</h3>
            <p class="dk-pillar-desc">
                Liquids in hand baggage must be in containers of <strong>100ml (3.4oz) or less</strong>, packed in a single transparent quart-sized resealable bag.
            </p>
        </div>
    </div>

    <!-- Major Airline Allowance Table -->
    <div class="dk-card" style="margin-top: 32px; overflow: hidden;">
        <h3 class="dk-card-title" style="margin-bottom: 6px;">Major Airline Baggage Allowances for Students</h3>
        <p style="color: #64748b; font-size: 13px; margin-bottom: 20px;">
            Always verify with your specific airline booking reference for student club benefits (e.g. Emirates Student Club, Qatar Student Club).
        </p>

        <div class="dk-admin-table-wrap">
            <table class="dk-admin-table">
                <thead>
                    <tr>
                        <th>Airline</th>
                        <th>Standard Allowance</th>
                        <th>Student Club Extra Perk</th>
                        <th>Max Weight / Piece</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Emirates</strong></td>
                        <td>2 Bags (23kg each)</td>
                        <td>+10kg extra baggage or +1 additional bag</td>
                        <td>23 kg</td>
                    </tr>
                    <tr>
                        <td><strong>Qatar Airways</strong></td>
                        <td>2 Bags (23kg each)</td>
                        <td>+10kg extra or additional piece via Student Club</td>
                        <td>23 kg</td>
                    </tr>
                    <tr>
                        <td><strong>Air India</strong></td>
                        <td>2 Bags (23kg each)</td>
                        <td>Maharaja Student Baggage Allowance (up to 2x 28kg on select sectors)</td>
                        <td>23 - 28 kg</td>
                    </tr>
                    <tr>
                        <td><strong>British Airways</strong></td>
                        <td>2 Bags (23kg each)</td>
                        <td>Standard 2 pieces on transatlantic student fares</td>
                        <td>23 kg</td>
                    </tr>
                    <tr>
                        <td><strong>Lufthansa / Swiss</strong></td>
                        <td>2 Bags (23kg each)</td>
                        <td>Included on student booking class</td>
                        <td>23 kg</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Prohibited & Restricted Items Section -->
    <div class="dk-about-split" style="margin-top: 32px;">
        <div class="dk-about-split-content">
            <h2 class="dk-section-heading">🚫 Prohibited in Checked Baggage</h2>
            <div class="dk-feature-box" style="background: #fff1f2; border-color: #fecdd3;">
                <p style="color: #991b1b; font-weight: 700; margin-bottom: 8px;">
                    Never pack the following in your check-in luggage (must be in cabin bag):
                </p>
                <ul class="dk-feature-list" style="color: #4b5563;">
                    <li>❌ <strong>Power banks, spare lithium batteries</strong> and vape devices (Strict aviation fire hazard).</li>
                    <li>❌ <strong>Passports, Form I-20, CAS, visa documents, Forex cards</strong>, and large cash reserves.</li>
                    <li>❌ <strong>Essential prescription medicines</strong> (keep with doctor's prescription letter).</li>
                    <li>❌ <strong>Laptops, iPads, expensive camera gear</strong>.</li>
                </ul>
            </div>
        </div>

        <div class="dk-about-split-content">
            <h2 class="dk-section-heading">🌶️ Indian Food & Spices Customs Rules</h2>
            <div class="dk-feature-box">
                <p style="font-weight: 700; margin-bottom: 8px;">
                    How to pack food items legally:
                </p>
                <ul class="dk-feature-list">
                    <li>✔ <strong>Commercially packaged & labeled:</strong> Spices and powders must be sealed with brand labels.</li>
                    <li>✔ <strong>Strictly no seeds, plants, or fresh dairy:</strong> Australian and US customs strictly confiscate fresh fruits, seeds, and raw dairy sweets.</li>
                    <li>✔ <strong>Always declare food items</strong> on arrival landing cards (e.g. US CBP Form 6059B or Australian Incoming Passenger Card) to prevent heavy fines.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Dreamflykit Vacuum Packing Advice -->
    <div class="dk-card" style="margin-top: 32px; background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);">
        <h3>💡 How Dreamflykit Optimizes Your Luggage Weight</h3>
        <p style="color: #475569; font-size: 14px; margin-top: 8px;">
            All beddings, quilts, and winter jackets in our kits are delivered with heavy-duty reusable compression bags. Using our simple hand-pump or standard vacuum cleaner, you can compress bulky duvets by up to <strong>75% volume</strong>, leaving plenty of room for family gifts and winter apparel.
        </p>
    </div>
</div>
