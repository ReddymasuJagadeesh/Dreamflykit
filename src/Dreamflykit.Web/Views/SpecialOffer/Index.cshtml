                    <a href="/category/study-essentials" class="dk-btn-order-kit">Explore Kit</a>
                </div>
            </div>

        </div>
    </section>

    <!-- ========================================================
         AIRLINE STUDENT PERKS COMPARISON TABLE
         ======================================================== -->
    <section class="dk-shell dk-airline-perks-section" id="airline-perks" aria-label="Student Airlines Perks Comparison">
        <div class="dk-section-heading-row">
            <div>
                <span class="dk-section-eyebrow">AIRLINE PARTNERSHIPS</span>
                <h2 class="dk-section-title">Student Airlines Baggage &amp; Perks Guide</h2>
            </div>
            <span class="dk-updated-pill">Updated for 2026 Intakes</span>
        </div>

        <div class="dk-airline-table-wrapper">
            <table class="dk-airline-table">
                <thead>
                    <tr>
                        <th>Airline Partner</th>
                        <th>Student Baggage Allowance</th>
                        <th>Student Airfare Discount</th>
                        <th>Date Change Policy</th>
                        <th>WiFi &amp; Perks</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="dk-airline-name-cell">
                                <span class="dk-airline-logo-badge">🇶🇦</span>
                                <div>
                                    <strong>Qatar Airways</strong>
                                    <small>Student Club Partner</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="dk-badge-green">2x 23kg + 10kg Extra</span></td>
                        <td>Up to 20% Off base fare</td>
                        <td>1 Free Change</td>
                        <td>Free High-Speed Super Wi-Fi</td>
                        <td><button type="button" class="dk-btn-table-deal" onclick="window.openFlightQuoteModal('Qatar Airways');">Get Fare Quote</button></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="dk-airline-name-cell">
                                <span class="dk-airline-logo-badge">🇦🇪</span>
                                <div>
                                    <strong>Emirates</strong>
                                    <small>Student Special Fares</small>
                                </div>
