.dk-chip-remove { cursor: pointer; font-weight: 900; }
.dk-toolbar-right {
    display: flex;
    align-items: center;
    gap: 14px;
}
.dk-sort-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
}
.dk-sort-label { font-size: 0.84rem; font-weight: 700; color: #475569; }
.dk-sort-select {
    padding: 6px 12px;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
