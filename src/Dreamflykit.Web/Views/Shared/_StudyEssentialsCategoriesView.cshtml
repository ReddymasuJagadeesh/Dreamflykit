@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.StudyHub ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefault();
    var catPage = hub.CategoriesPage ?? new();
    var currentSubSlug = Model.CurrentSubcategorySlug;
    var hasSubcategorySelected = !string.IsNullOrWhiteSpace(currentSubSlug) || Model.SubcategoryId.HasValue;
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    // The 8 Study Essentials categories specified by user
    var studyCategories = catPage.Categories != null && catPage.Categories.Count > 0
        ? catPage.Categories
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefault().CategoriesPage.Categories;
}

<div class="dk-study-cat-page-wrapper">

    @if (canManage)
    {
        <div class="dk-study-hub-admin-bar">
            <span class="dk-sh-admin-badge">Admin Controls</span>
            <span class="dk-sh-admin-hint">Viewing Study Essentials Categories page. Super Admin can manage all 8 categories &amp; replace test pics.</span>
            <a href="/Admin/StudyHub" class="dk-sh-admin-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Manage Categories &amp; Test Pics
            </a>
        </div>
    }

    <!-- ========================================================
         HERO HEADER (IMAGE 4)
    ========================================================= -->
    <header class="dk-cat-hero-card">
        <div class="dk-cat-hero-left">
            <h1 class="dk-cat-hero-title">@catPage.HeroTitle</h1>
            <p class="dk-cat-hero-sub">@catPage.HeroSubtitle</p>

            <div class="dk-cat-hero-badges">
                <div class="dk-cat-badge-item">
                    <span class="dk-cat-badge-icon">🎓</span>
                    <span>Student Trusted &bull; <strong>10K+ Happy Students</strong></span>
                </div>
                <div class="dk-cat-badge-item">
                    <span class="dk-cat-badge-icon">🌐</span>
                    <span>Curated for Abroad &bull; <strong>Universities Worldwide</strong></span>
                </div>
                <div class="dk-cat-badge-item">
                    <span class="dk-cat-badge-icon">💡</span>
                    <span>Smart &amp; Affordable &bull; <strong>Best Value Essentials</strong></span>
                </div>
            </div>
        </div>

        <div class="dk-cat-hero-right">
            <div class="dk-cat-hero-img-wrap">
                <img src="@catPage.HeroImageUrl" alt="Study Essentials Hero" loading="eager" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
            </div>
        </div>
    </header>

    <!-- ========================================================
         MAIN 2-COLUMN LAYOUT (SIDEBAR & CATEGORIES / PRODUCTS)
    ========================================================= -->
    <div class="dk-cat-main-layout">

        <!-- LEFT SIDEBAR -->
        <aside class="dk-cat-sidebar">
            <div class="dk-cat-sidebar-card">
                <h2 class="dk-cat-sidebar-title">Categories</h2>
                <nav class="dk-cat-nav-list" aria-label="Study Essentials Subcategories">
                    <a href="/category/study-essentials"
                       class="dk-cat-nav-item dk-cat-action-link @(string.IsNullOrWhiteSpace(currentSubSlug) ? "is-active" : "")"
                       data-subslug="">
                        <span class="dk-cat-nav-icon">🎓</span>
                        <span class="dk-cat-nav-text">All Study Essentials</span>
                    </a>

                    @foreach (var sc in studyCategories)
                    {
                        var isActive = string.Equals(currentSubSlug, sc.Slug, StringComparison.OrdinalIgnoreCase);
                        <a href="/category/study-essentials/@sc.Slug"
                           class="dk-cat-nav-item dk-cat-action-link @(isActive ? "is-active" : "")"
                           data-subslug="@sc.Slug">
                            <span class="dk-cat-nav-icon">
                                @if (sc.Icon == "laptop" || sc.Icon == "digital") { <text>💻</text> }
                                else if (sc.Icon == "file" || sc.Icon == "passport") { <text>📁</text> }
                                else if (sc.Icon == "lamp") { <text>🛋️</text> }
                                else if (sc.Icon == "bag") { <text>🎒</text> }
                                else if (sc.Icon == "monitor") { <text>🖥️</text> }
                                else if (sc.Icon == "book") { <text>📝</text> }
                                else if (sc.Icon == "bookmark") { <text>📚</text> }
                                else { <text>✏️</text> }
                            </span>
                            <span class="dk-cat-nav-text">@sc.Name</span>
                        </a>
                    }
                </nav>
            </div>

            <!-- Promo Box 1: Complete Study Kit -->
            <div class="dk-cat-promo-box dk-promo-kit">
                <div class="dk-cat-promo-badge">Bundle Offer</div>
                <h3 class="dk-cat-promo-title">@catPage.Promo1Title</h3>
                <p class="dk-cat-promo-sub">@catPage.Promo1Subtitle</p>
                <div class="dk-cat-promo-img">
                    <img src="@catPage.Promo1ImageUrl" alt="Study Kit" onerror="this.onerror=null;this.src='/images/study-hub/kit-premium.png';" />
                </div>
                <a href="@catPage.Promo1ButtonUrl" class="dk-cat-promo-btn">
                    @catPage.Promo1ButtonText
                </a>
            </div>

            <!-- Promo Box 2: Need Help Choosing -->
            <div class="dk-cat-promo-box dk-promo-support">
                <div class="dk-cat-support-icon">💬</div>
                <h3 class="dk-cat-promo-title">@catPage.Promo2Title</h3>
                <p class="dk-cat-promo-sub">@catPage.Promo2Subtitle</p>
                <a href="@catPage.Promo2ButtonUrl" target="_blank" rel="noopener noreferrer" class="dk-cat-btn-chat">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    @catPage.Promo2ButtonText
                </a>
            </div>
        </aside>

        <!-- RIGHT CONTENT AREA (DYNAMICALLY UPDATED VIA AJAX WITHOUT FULL PAGE RELOAD) -->
        <main class="dk-cat-content" id="dkCatContentArea" style="position: relative; min-height: 480px;">
            <div id="dkCatLoadingOverlay" class="dk-cat-loading-overlay" style="display: none;" aria-hidden="true">
                <div class="dk-cat-loading-spinner"></div>
                <span class="dk-cat-loading-text">Loading products...</span>
            </div>
            <partial name="_StudyEssentialsProductsListPartial" model="Model" />
        </main>
    </div>

    <!-- ========================================================
         FOOTER FEATURES BAR (IMAGE 4 BOTTOM)
    ========================================================= -->
    <div class="dk-cat-features-strip">
        <div class="dk-cat-feature-item">
            <span class="dk-cf-icon">🚚</span>
            <div>
                <strong>Fast &amp; Reliable Delivery</strong>
                <span>On-time delivery worldwide</span>
            </div>
        </div>
        <div class="dk-cat-feature-item">
            <span class="dk-cf-icon">🛡️</span>
            <div>
                <strong>100% Secure Payments</strong>
                <span>Multiple payment options</span>
            </div>
        </div>
        <div class="dk-cat-feature-item">
            <span class="dk-cf-icon">⭐</span>
            <div>
                <strong>Premium Quality Products</strong>
                <span>Genuine &amp; durable</span>
            </div>
        </div>
        <div class="dk-cat-feature-item">
            <span class="dk-cf-icon">🎧</span>
            <div>
                <strong>24/7 Customer Support</strong>
                <span>We're here to help</span>
            </div>
        </div>
        <div class="dk-cat-feature-item">
            <span class="dk-cf-icon">🔄</span>
            <div>
                <strong>Easy Returns</strong>
                <span>Hassle-free returns</span>
            </div>
        </div>
    </div>

    <!-- ========================================================
         BOTTOM BANNER (IMAGE 4)
    ========================================================= -->
    <section class="dk-cat-bottom-cta">
        <div class="dk-cat-bcta-content">
            <div class="dk-cat-bcta-icon">🎓</div>
            <div>
                <h2 class="dk-cat-bcta-title">Prepare Better. Study Smarter. Go Further.</h2>
                <p class="dk-cat-bcta-sub">Everything you need for a successful academic journey.</p>
            </div>
        </div>
        <a href="/study-abroad-hub#kits-section" class="dk-cat-bcta-btn">
            Explore Study Kits →
        </a>
    </section>

</div>

<!-- ========================================================
     INLINE STYLING FOR STUDY CATEGORIES VIEW
========================================================= -->
<style>
    .dk-study-cat-page-wrapper {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #1e293b;
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        padding: 10px 0 40px 0;
        box-sizing: border-box;
    }

    /* Hero Banner */
    .dk-cat-hero-card {
        background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 50%, #eff6ff 100%);
        border: 1px solid #bae6fd;
        border-radius: 20px;
        padding: 32px 36px;
        display: grid;
        grid-template-columns: 1.3fr 0.7fr;
        gap: 28px;
        align-items: center;
        margin-bottom: 28px;
        box-shadow: 0 6px 24px rgba(2, 132, 199, 0.08);
    }
    @@media (max-width: 850px) {
        .dk-cat-hero-card { 
            grid-template-columns: 1fr; 
            padding: 22px 18px;
            gap: 20px;
        }
    }
    .dk-cat-hero-title {
        font-size: 2.2rem;
        font-weight: 900;
        color: #0f172a;
        margin: 0 0 8px 0;
        letter-spacing: -0.025em;
    }
    @@media (max-width: 600px) {
        .dk-cat-hero-title { font-size: 1.7rem; }
    }
    .dk-cat-hero-sub {
        font-size: 1.05rem;
        color: #475569;
        margin: 0 0 20px 0;
        line-height: 1.45;
    }
    @@media (max-width: 600px) {
        .dk-cat-hero-sub { font-size: 0.92rem; margin-bottom: 14px; }
    }
    .dk-cat-hero-badges {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .dk-cat-badge-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        color: #334155;
    }
    .dk-cat-badge-icon {
        font-size: 1.15rem;
    }
    .dk-cat-hero-img-wrap {
        border-radius: 16px;
        overflow: hidden;
        aspect-ratio: 16/11;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        border: 1px solid #e2e8f0;
    }
    .dk-cat-hero-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* 2-Column Layout */
    .dk-cat-main-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 24px;
        margin-bottom: 40px;
    }
    @@media (min-width: 1400px) {
        .dk-cat-main-layout {
            grid-template-columns: 290px 1fr;
            gap: 28px;
        }
    }
    @@media (max-width: 900px) {
        .dk-cat-main-layout { grid-template-columns: 1fr; }
    }

    /* Sidebar */
    .dk-cat-sidebar {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .dk-cat-sidebar-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px 16px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    }
    .dk-cat-sidebar-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 14px 0;
        padding-bottom: 10px;
        border-bottom: 1px solid #f1f5f9;
    }
    .dk-cat-nav-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .dk-cat-nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        border-radius: 10px;
        color: #334155;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
    }
    .dk-cat-nav-item:hover {
        background: #f1f5f9;
        color: #063f91;
    }
    .dk-cat-nav-item.is-active {
        background: rgba(6, 63, 145, 0.08);
        color: #063f91;
        font-weight: 700;
        border-left: 3px solid #ff7900;
    }
    .dk-cat-nav-icon {
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    /* Promo Boxes in Sidebar */
    .dk-cat-promo-box {
        border-radius: 16px;
        padding: 20px;
        position: relative;
    }
    .dk-promo-kit {
        background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
        border: 1px solid #bbf7d0;
    }
    .dk-promo-support {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border: 1px solid #cbd5e1;
        text-align: center;
    }
    .dk-cat-promo-badge {
        display: inline-block;
        background: #16a34a;
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 4px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }
    .dk-cat-promo-title {
        font-size: 1rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 4px 0;
    }
    .dk-cat-promo-sub {
        font-size: 0.82rem;
        color: #64748b;
        margin: 0 0 14px 0;
    }
    .dk-cat-promo-img {
        width: 100%;
        height: 110px;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 12px;
        background: #ffffff;
    }
    .dk-cat-promo-img img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .dk-cat-promo-btn {
        display: block;
        text-align: center;
        background: linear-gradient(135deg, #063f91 0%, #075bc8 100%);
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 8px 14px;
        border-radius: 8px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(6, 63, 145, 0.25);
        transition: transform 0.15s, background 0.15s;
    }
    .dk-cat-promo-btn:hover {
        background: #ff7900;
        box-shadow: 0 4px 14px rgba(255, 121, 0, 0.35);
    }
    .dk-cat-support-icon {
        font-size: 2rem;
        margin-bottom: 6px;
    }
    .dk-cat-btn-chat {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #25d366;
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
    }

    /* Content Area & Top Bar */
    .dk-cat-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 20px;
    }
    .dk-cat-breadcrumb-trail {
        font-size: 0.88rem;
        color: #64748b;
    }
    .dk-cat-breadcrumb-trail a {
        color: #063f91;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.15s;
    }
    .dk-cat-breadcrumb-trail a:hover {
        color: #ff7900;
    }
    .dk-sep { margin: 0 6px; color: #94a3b8; }
    .dk-current { color: #0f172a; font-weight: 700; }
    .dk-cat-sort-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .dk-sort-lbl {
        font-size: 0.85rem;
        font-weight: 600;
        color: #64748b;
    }
    .dk-sort-select {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #0f172a;
        background: #ffffff;
        cursor: pointer;
    }

    /* 8 Category Cards Grid (Image 4) */
    .dk-cat-cards-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }
    @@media (max-width: 1100px) {
        .dk-cat-cards-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width: 768px) {
        .dk-cat-cards-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 480px) {
        .dk-cat-cards-grid { grid-template-columns: 1fr; }
    }
    .dk-cat-grid-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s;
    }
    .dk-cat-grid-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        border-color: #38bdf8;
    }
    .dk-cat-card-img-wrap {
        aspect-ratio: 4/3;
        background: #f8fafc;
        overflow: hidden;
    }
    .dk-cat-card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .dk-cat-grid-card:hover .dk-cat-card-img-wrap img {
        transform: scale(1.04);
    }
    .dk-cat-card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .dk-cat-card-name {
        font-size: 0.96rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 6px 0;
        line-height: 1.3;
    }
    .dk-cat-card-desc {
        font-size: 0.8rem;
        color: #64748b;
        line-height: 1.4;
        margin: 0 0 14px 0;
        flex: 1;
    }
    .dk-cat-card-btn {
        color: #063f91;
        font-weight: 700;
        font-size: 0.86rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: gap 0.15s ease, color 0.15s;
    }
    .dk-cat-card-btn:hover { gap: 8px; color: #ff7900; }

    /* Products Grid */
    .dk-cat-products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }
    @@media (min-width: 1400px) {
        .dk-cat-products-grid {
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }
    }
    @@media (max-width: 1100px) {
        .dk-cat-products-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width: 768px) {
        .dk-cat-products-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    }
    @@media (max-width: 480px) {
        .dk-cat-products-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    }
    @@media (max-width: 360px) {
        .dk-cat-products-grid { grid-template-columns: 1fr; }
    }
    .dk-cat-prod-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        transition: transform 0.15s ease, box-shadow 0.15s, border-color 0.15s;
    }
    .dk-cat-prod-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(6, 63, 145, 0.12);
        border-color: #063f91;
    }
    .dk-cat-prod-img-wrap {
        aspect-ratio: 1/1;
        background: #f8fafc;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 10px;
        position: relative;
        display: block;
    }
    .dk-cat-prod-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .dk-cat-prod-discount {
        position: absolute;
        top: 6px;
        left: 6px;
        background: #ff7900;
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 4px;
        box-shadow: 0 2px 6px rgba(255, 121, 0, 0.35);
    }
    .dk-cat-prod-body {
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .dk-cat-prod-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: #0f172a;
        text-decoration: none;
        margin-bottom: 6px;
        line-height: 1.3;
        transition: color 0.15s;
    }
    .dk-cat-prod-title:hover { color: #063f91; }
    .dk-cat-prod-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        margin-bottom: 8px;
    }
    .dk-cat-stars { color: #f59e0b; }
    .dk-cat-rating-val { font-weight: 700; color: #0f172a; }
    .dk-cat-prod-price-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 10px;
        margin-top: auto;
    }
    .dk-cat-price {
        font-size: 1.05rem;
        font-weight: 800;
        color: #063f91;
    }
    .dk-cat-mrp {
        font-size: 0.8rem;
        color: #94a3b8;
        text-decoration: line-through;
    }
    .dk-cat-btn-add {
        width: 100%;
        background: linear-gradient(135deg, #063f91 0%, #075bc8 100%);
        color: #ffffff;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 3px 10px rgba(6, 63, 145, 0.22);
        transition: all 0.15s ease;
    }
    .dk-cat-btn-add:hover {
        background: #ff7900;
        box-shadow: 0 4px 14px rgba(255, 121, 0, 0.35);
        transform: translateY(-1px);
    }

    /* Empty state */
    .dk-cat-empty-state {
        text-align: center;
        padding: 48px 24px;
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
    }
    .dk-cat-empty-icon { font-size: 3rem; margin-bottom: 12px; }

    /* Features Strip */
    .dk-cat-features-strip {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px 24px;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    @@media (max-width: 900px) {
        .dk-cat-features-strip { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 500px) {
        .dk-cat-features-strip { grid-template-columns: 1fr; }
    }
    .dk-cat-feature-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .dk-cf-icon { font-size: 1.5rem; flex-shrink: 0; }
    .dk-cat-feature-item strong {
        display: block;
        font-size: 0.86rem;
        color: #0f172a;
    }
    .dk-cat-feature-item span {
        font-size: 0.76rem;
        color: #64748b;
    }

    /* Bottom CTA */
    .dk-cat-bottom-cta {
        background: linear-gradient(135deg, #0f172a 0%, #0369a1 100%);
        border-radius: 16px;
        padding: 28px 36px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #ffffff;
        gap: 20px;
        flex-wrap: wrap;
    }
    .dk-cat-bcta-content {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .dk-cat-bcta-icon {
        font-size: 2.2rem;
    }
    .dk-cat-bcta-title {
        font-size: 1.45rem;
        font-weight: 800;
        margin: 0 0 4px 0;
        color: #ffffff;
    }
    .dk-cat-bcta-sub {
        font-size: 0.95rem;
        color: #cbd5e1;
        margin: 0;
    }
    .dk-cat-bcta-btn {
        background: #38bdf8;
        color: #0f172a;
        font-weight: 800;
        font-size: 0.92rem;
        padding: 10px 22px;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.15s, transform 0.15s;
    }
    .dk-cat-bcta-btn:hover {
        background: #7dd3fc;
        transform: translateY(-1px);
    }
    /* Dynamic Loading Overlay */
    .dk-cat-loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.78);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        z-index: 50;
        border-radius: 16px;
        transition: opacity 0.2s ease;
    }
    .dk-cat-loading-spinner {
        width: 38px;
        height: 38px;
        border: 3.5px solid #e2e8f0;
        border-top-color: #063f91;
        border-right-color: #ff7900;
        border-radius: 50%;
        animation: dk-cat-spin 0.75s linear infinite;
    }
    .dk-cat-loading-text {
        font-size: 0.92rem;
        font-weight: 700;
        color: #063f91;
        letter-spacing: -0.01em;
    }
    @@keyframes dk-cat-spin {
        to { transform: rotate(360deg); }
    }
</style>

<script>
    (function () {
        let dkCatAbortController = null;

        function showCatLoading() {
            const overlay = document.getElementById("dkCatLoadingOverlay");
            if (overlay) overlay.style.display = "flex";
        }

        function hideCatLoading() {
            const overlay = document.getElementById("dkCatLoadingOverlay");
            if (overlay) overlay.style.display = "none";
        }

        function updateSidebarActive(targetUrl) {
            try {
                const parsed = new URL(targetUrl, window.location.origin);
                const pathParts = parsed.pathname.replace(/\/+$/, '').split('/');
                // If path is /category/study-essentials, active subslug is ""
                // If path is /category/study-essentials/tech-for-study, active subslug is "tech-for-study"
                let targetSubslug = "";
                if (pathParts.length >= 4 && pathParts[1] === "category" && (pathParts[2] === "study-essentials" || pathParts[2] === "study_essentials")) {
                    targetSubslug = pathParts[3].toLowerCase();
                }

                document.querySelectorAll(".dk-cat-sidebar .dk-cat-nav-item").forEach(item => {
                    const itemSlug = (item.getAttribute("data-subslug") || "").toLowerCase();
                    if (itemSlug === targetSubslug) {
                        item.classList.add("is-active");
                    } else {
                        item.classList.remove("is-active");
                    }
                });
            } catch (e) {
                console.warn("[StudyEssentials] Could not parse url for sidebar active state:", e);
            }
        }

        async function loadStudyCategoryProducts(targetUrl, pushState = true) {
            // Cancel any in-flight request to prevent race conditions & stale results
            if (dkCatAbortController) {
                dkCatAbortController.abort();
            }
            dkCatAbortController = new AbortController();

            const contentArea = document.getElementById("dkCatContentArea");
            if (!contentArea) return;

            showCatLoading();
            updateSidebarActive(targetUrl);

            try {
                // Append partial=true to URL so server returns partial view
                const fetchUrl = new URL(targetUrl, window.location.origin);
                fetchUrl.searchParams.set("partial", "true");

                const response = await fetch(fetchUrl.toString(), {
                    method: "GET",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        "Accept": "text/html, application/xhtml+xml"
                    },
                    signal: dkCatAbortController.signal
                });

                if (!response.ok) {
                    throw new Error("HTTP error " + response.status);
                }

                const html = await response.text();

                // Re-inject the updated partial while keeping the loading overlay structure
                contentArea.innerHTML = `
                    <div id="dkCatLoadingOverlay" class="dk-cat-loading-overlay" style="display: none;" aria-hidden="true">
                        <div class="dk-cat-loading-spinner"></div>
                        <span class="dk-cat-loading-text">Loading products...</span>
                    </div>
                    ` + html;

                if (pushState) {
                    window.history.pushState({ studyEssentialsAjax: true, url: targetUrl }, "", targetUrl);
                }

                // If user is scrolled down, gently scroll back to top of products area
                const rect = contentArea.getBoundingClientRect();
                if (rect.top < 60) {
                    contentArea.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            } catch (err) {
                if (err.name === "AbortError") {
                    // Superseded by newer click; ignore
                    return;
                }
                console.error("[StudyEssentials] Failed to load products dynamically:", err);
                contentArea.innerHTML = `
                    <div class="dk-cat-empty-state" style="border-color: #ef4444; background: #fff5f5;">
                        <div class="dk-cat-empty-icon" style="color: #ef4444;">⚠️</div>
                        <h3 style="color: #b91c1c;">Unable to load products</h3>
                        <p style="color: #7f1d1d;">A network or connection issue occurred while fetching items for this category.</p>
                        <button type="button" class="dk-sh-btn-primary" onclick="window.retryLoadStudyCategory('${targetUrl.replace(/'/g, "\\'")}')">
                            Try Again
                        </button>
                    </div>`;
            } finally {
                hideCatLoading();
            }
        }

        window.retryLoadStudyCategory = function (url) {
            loadStudyCategoryProducts(url, false);
        };

        window.handleSortChange = function (sortVal) {
            const url = new URL(window.location.href);
            url.searchParams.set("sort", sortVal);
            loadStudyCategoryProducts(url.toString(), true);
        };

        // Event delegation for clicks on category links, card buttons, breadcrumbs, and pagination
        document.addEventListener("click", function (e) {
            const actionLink = e.target.closest(".dk-cat-action-link");
            if (!actionLink) return;

            // Don't intercept if ctrl/meta/shift key is pressed (let user open in new tab)
            if (e.ctrlKey || e.metaKey || e.shiftKey || actionLink.target === "_blank") {
                return;
            }

            const href = actionLink.getAttribute("href");
            if (!href || href.startsWith("#") || href.startsWith("javascript:")) {
                return;
            }

            e.preventDefault();
            loadStudyCategoryProducts(href, true);
        });

        // Browser Back / Forward button support
        window.addEventListener("popstate", function () {
            if (window.location.pathname.includes("/category/study-essentials") ||
                window.location.pathname.includes("/category/study_essentials")) {
                loadStudyCategoryProducts(window.location.href, false);
            }
        });
    })();
</script>
