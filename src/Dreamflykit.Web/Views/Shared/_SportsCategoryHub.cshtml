<!-- Slider & Add to Cart JavaScript -->
<script>
    (function () {
        var slider = document.getElementById('spHeroSlider');
        if (!slider) return;

        var slides = slider.querySelectorAll('.sp-hero-slide');
        var dots = slider.querySelectorAll('.sp-slider-dot');
        var autoplay = slider.getAttribute('data-autoplay') === 'true';
        var intervalMs = parseInt(slider.getAttribute('data-interval') || '5000', 10);
        var currentIndex = 0;
        var timer = null;

        function showSlide(index) {
            if (slides.length <= 1) return;
            if (index < 0) index = slides.length - 1;
            if (index >= slides.length) index = 0;
            currentIndex = index;

            slides.forEach(function (s, i) {
                if (i === currentIndex) {
                    s.classList.add('active');
                } else {
                    s.classList.remove('active');
                }
            });

            dots.forEach(function (d, i) {
                if (i === currentIndex) {
                    d.classList.add('active');
                } else {
                    d.classList.remove('active');
                }
            });
        }

        window.spPrevSlide = function () {
            showSlide(currentIndex - 1);
            resetAutoplay();
        };

        window.spNextSlide = function () {
            showSlide(currentIndex + 1);
            resetAutoplay();
        };

        window.spGoToSlide = function (i) {
            showSlide(i);
            resetAutoplay();
        };

        function startAutoplay() {
            if (!autoplay || slides.length <= 1) return;
            timer = setInterval(function () {
                showSlide(currentIndex + 1);
            }, intervalMs);
        }

        function resetAutoplay() {
            if (timer) clearInterval(timer);
            startAutoplay();
        }

        slider.addEventListener('mouseenter', function () {
            if (timer) clearInterval(timer);
        });

        slider.addEventListener('mouseleave', function () {
            startAutoplay();
        });

        startAutoplay();
    })();

    window.spAddToCart = function (productId, productName, price, btnEl) {
        if (!btnEl) return;
        var origText = btnEl.innerHTML;
        btnEl.disabled = true;
        btnEl.innerHTML = '<span>Adding...</span>';

        fetch('/cart/add-ajax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ productId: productId, quantity: 1 })
        }).catch(function () {}).finally(function () {
            btnEl.innerHTML = '<span>✓ Added!</span>';
            btnEl.style.background = '#10b981';

            // Increment header cart counter if present
            var badge = document.querySelector('.dk-header-cart-count, .cart-count, [data-cart-count]');
            if (badge) {
                var c = parseInt(badge.textContent || '0', 10);
                badge.textContent = c + 1;
            }

            setTimeout(function () {
                btnEl.disabled = false;
                btnEl.innerHTML = origText;
                btnEl.style.background = '';
            }, 1800);
        });
    };
</script>
