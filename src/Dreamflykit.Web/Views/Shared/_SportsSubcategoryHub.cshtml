@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.SportsHub ?? Dreamflykit.Application.SportsHub.Models.SportsHubDto.CreateDefault();
    var subPage = Model.SportsSubcategoryPage;
    var currentSlug = (Model.CurrentSubcategorySlug ?? "").Trim().ToLowerInvariant();

    if (subPage == null)
    {
        subPage = hub.SubcategoryPages?.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSlug, StringComparison.OrdinalIgnoreCase));
    }

    if (subPage == null)
    {
        var matchedItem = hub.ShopByCategory?.Items?.FirstOrDefault(i =>
            string.Equals(i.Slug, currentSlug, StringComparison.OrdinalIgnoreCase));

        var catName = matchedItem?.Name ?? (!string.IsNullOrWhiteSpace(Model.CurrentSubcategoryName)
            ? Model.CurrentSubcategoryName
            : (string.IsNullOrWhiteSpace(currentSlug) ? "Sports Gear" : currentSlug.Replace("-", " ")));

        subPage = new Dreamflykit.Application.SportsHub.Models.SportsSubcategoryPageDto
        {
            CategorySlug = currentSlug,
            CategoryName = catName,
            IconEmoji = matchedItem?.IconEmoji ?? "🏅",
            HeroBanner = new Dreamflykit.Application.SportsHub.Models.SportsSubcategoryHeroDto
            {
                Title = catName,
                TitleHighlight = "100% GENUINE • TOURNAMENT SPEC",
                Subtitle = $"Explore top-rated {catName} match kits, tournament-grade equipment & student athletic supplies with express campus delivery.",
                IsUploadingSoon = true
            },
            Products = Dreamflykit.Application.SportsHub.Models.SportsHubDto.CreateDefaultSubcategoryPages().FirstOrDefault()?.Products
                       ?? new List<Dreamflykit.Application.SportsHub.Models.SportsProductItemDto>()
        };
    }

    var hero = subPage.HeroBanner ?? new Dreamflykit.Application.SportsHub.Models.SportsSubcategoryHeroDto();
    var products = subPage.Products ?? new List<Dreamflykit.Application.SportsHub.Models.SportsProductItemDto>();
    var allCategories = hub.ShopByCategory?.Items?.Where(i => i.IsActive).OrderBy(i => i.DisplayOrder).ToList()
                        ?? Dreamflykit.Application.SportsHub.Models.SportsHubDto.CreateDefaultCategoryItems();

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="sp-subpage-container dk-shell">

    <!-- ========================================================
         SUBCATEGORY HERO BANNER (FULL WIDTH)
    ========================================================= -->
    <section class="sp-sub-hero-card" aria-label="@subPage.CategoryName Banner">
        <div class="sp-sub-hero-glow"></div>
        <div class="sp-sub-hero-body">
            <div class="sp-sub-hero-content">
                <nav class="sp-sub-hero-breadcrumb" aria-label="Sports breadcrumb">
                    <a href="/category/sports-hub">Sports Hub</a>
                    <span class="sp-sub-sep">/</span>
                    <span class="sp-sub-crumb-active">@subPage.CategoryName</span>
                </nav>

                @if (!string.IsNullOrWhiteSpace(hero.TitleHighlight))
                {
                    <div class="sp-sub-hero-badge">
                        <span class="sp-badge-dot">●</span>
                        <span>@hero.TitleHighlight</span>
                    </div>
                }

                <h1 class="sp-sub-hero-title">@subPage.CategoryName</h1>
                <p class="sp-sub-hero-desc">
                    @(string.IsNullOrWhiteSpace(hero.Subtitle)
                        ? $"Discover verified university match equipment, tournament sets, and high-performance training gear for {subPage.CategoryName}."
                        : hero.Subtitle)
                </p>

                <div class="sp-sub-hero-chips">
                    <span class="sp-hero-chip">✓ Tournament Quality</span>
                    <span class="sp-hero-chip">✓ Fast Campus Delivery</span>
                    <span class="sp-hero-chip">✓ Free Size Replacement</span>
                    @if (canManage)
                    {
                        <a href="/Admin/SportsHub" class="sp-sub-admin-link">⚙ Edit in Admin Dashboard</a>
                    }
                </div>
            </div>

            <div class="sp-sub-hero-media">
                @if (!string.IsNullOrWhiteSpace(hero.ImageUrl) && !hero.ImageUrl.Contains("placeholder") && !hero.IsUploadingSoon)
                {
                    <div class="sp-sub-banner-img-wrap">
                        <img src="@hero.ImageUrl" alt="@subPage.CategoryName" class="sp-sub-banner-img" />
                    </div>
                }
                else
                {
                    <div class="sp-sub-hero-uploading">
                        <div class="sp-sub-uploading-radar">
                            <span class="sp-sub-radar-ring"></span>
                            <span class="sp-sub-emoji">@subPage.IconEmoji</span>
                        </div>
                        <div class="sp-sub-uploading-pill">
                            <span class="sp-mini-dot">●</span> Uploading Soon
                        </div>
                        <p class="sp-sub-uploading-text">Admin will upload banner image</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         TOP QUICK FILTER PILLS & SORTING BAR
    ========================================================= -->
    <div class="sp-quick-filters-bar">
        <div class="sp-filter-pills-left">
            <!-- Brand Dropdown Pill -->
            <div class="sp-dropdown-pill" data-filter-group="brand">
                <button type="button" class="sp-pill-btn" onclick="spToggleDropdown(this)">
                    <span>Brand</span>
                    <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                </button>
                <div class="sp-pill-dropdown-menu">
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="all" checked onchange="spApplyPillFilter('brand', 'all', this)"> All Brands</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="Yonex" onchange="spApplyPillFilter('brand', 'Yonex', this)"> Yonex</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="Nike" onchange="spApplyPillFilter('brand', 'Nike', this)"> Nike</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="Adidas" onchange="spApplyPillFilter('brand', 'Adidas', this)"> Adidas</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="Nivia" onchange="spApplyPillFilter('brand', 'Nivia', this)"> Nivia</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="Cosco" onchange="spApplyPillFilter('brand', 'Cosco', this)"> Cosco</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="Puma" onchange="spApplyPillFilter('brand', 'Puma', this)"> Puma</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="Wilson" onchange="spApplyPillFilter('brand', 'Wilson', this)"> Wilson</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_brand" value="Decathlon" onchange="spApplyPillFilter('brand', 'Decathlon', this)"> Decathlon</label>
                </div>
            </div>

            <!-- Price Dropdown Pill -->
            <div class="sp-dropdown-pill" data-filter-group="price">
                <button type="button" class="sp-pill-btn" onclick="spToggleDropdown(this)">
                    <span>Price</span>
                    <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                </button>
                <div class="sp-pill-dropdown-menu">
                    <label class="sp-pill-option"><input type="radio" name="pill_price" value="all" checked onchange="spApplyPillFilter('price', 'all', this)"> Any Price</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_price" value="under-1000" onchange="spApplyPillFilter('price', 'under-1000', this)"> Under ₹1,000</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_price" value="1000-2500" onchange="spApplyPillFilter('price', '1000-2500', this)"> ₹1,000 - ₹2,500</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_price" value="2500-5000" onchange="spApplyPillFilter('price', '2500-5000', this)"> ₹2,500 - ₹5,000</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_price" value="above-5000" onchange="spApplyPillFilter('price', 'above-5000', this)"> ₹5,000 & Above</label>
                </div>
            </div>

            <!-- Rating Pill -->
            <div class="sp-dropdown-pill" data-filter-group="rating">
                <button type="button" class="sp-pill-btn" onclick="spToggleDropdown(this)">
                    <span>Rating</span>
                    <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                </button>
                <div class="sp-pill-dropdown-menu">
                    <label class="sp-pill-option"><input type="radio" name="pill_rating" value="all" checked onchange="spApplyPillFilter('rating', 'all', this)"> Any Rating</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_rating" value="4.5" onchange="spApplyPillFilter('rating', '4.5', this)"> 4.5★ & Above</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_rating" value="4.0" onchange="spApplyPillFilter('rating', '4.0', this)"> 4.0★ & Above</label>
                </div>
            </div>
        </div>

        <div class="sp-filter-pills-right">
            <!-- Sort By Dropdown -->
            <div class="sp-dropdown-pill sp-sort-pill">
                <button type="button" class="sp-pill-btn" onclick="spToggleDropdown(this)">
                    <span id="spSortLabel">Sort by : Popularity</span>
                    <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                </button>
                <div class="sp-pill-dropdown-menu sp-menu-right">
                    <label class="sp-pill-option"><input type="radio" name="pill_sort" value="popularity" checked onchange="spApplySort('popularity', 'Popularity')"> Popularity</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_sort" value="price-asc" onchange="spApplySort('price-asc', 'Price: Low to High')"> Price: Low to High</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_sort" value="price-desc" onchange="spApplySort('price-desc', 'Price: High to Low')"> Price: High to Low</label>
                    <label class="sp-pill-option"><input type="radio" name="pill_sort" value="rating" onchange="spApplySort('rating', 'Customer Rating')"> Customer Rating</label>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================
         2-COLUMN LAYOUT: FILTERS SIDEBAR + PRODUCTS CATALOG
    ========================================================= -->
    <div class="sp-sub-layout">

        <!-- LEFT SIDEBAR: ADVANCED FILTERS -->
        <aside class="sp-sub-sidebar" id="spSubSidebar">
            <div class="sp-sidebar-header">
                <h3 class="sp-sidebar-title">
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd"/></svg>
                    <span>Filters</span>
                </h3>
                <button type="button" class="sp-btn-clear-filters" onclick="spResetAllFilters()">Clear All</button>
            </div>

            <!-- Filter Group: Sports Categories Switcher -->
            <div class="sp-filter-box">
                <h4 class="sp-filter-title">Sports Categories</h4>
                <div class="sp-cat-switcher-list">
                    @foreach (var cat in allCategories)
                    {
                        var isActiveCat = string.Equals(cat.Slug, currentSlug, StringComparison.OrdinalIgnoreCase);
                        <a href="/category/sports-hub/@cat.Slug" class="sp-cat-switch-item @(isActiveCat ? "active" : "")">
                            <span class="sp-cat-switch-emoji">@cat.IconEmoji</span>
                            <span class="sp-cat-switch-name">@cat.Name</span>
                            @if (isActiveCat)
                            {
                                <span class="sp-cat-switch-dot">●</span>
                            }
                        </a>
                    }
                </div>
            </div>

            <!-- Filter Group: Brand -->
            <div class="sp-filter-box">
                <h4 class="sp-filter-title">Brand</h4>
                <div class="sp-filter-options-list">
                    @{
                        var commonBrands = new[] { "Yonex", "Nike", "Adidas", "Nivia", "Cosco", "Puma", "Wilson", "Decathlon" };
                    }
                    @foreach (var brand in commonBrands)
                    {
                        <label class="sp-checkbox-label">
                            <input type="checkbox" class="sp-filter-cb" data-filter="brand" value="@brand" onchange="spTriggerFilter()">
                            <span class="sp-cb-custom"></span>
                            <span class="sp-cb-text">@brand</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Filter Group: Price Range -->
            <div class="sp-filter-box">
                <h4 class="sp-filter-title">Price Range</h4>
                <div class="sp-filter-options-list">
                    <label class="sp-radio-label">
                        <input type="radio" name="side_price" value="all" checked onchange="spSetPriceRange(0, 999999)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">All Prices</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_price" value="under-1000" onchange="spSetPriceRange(0, 1000)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">Under ₹1,000</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_price" value="1000-2500" onchange="spSetPriceRange(1000, 2500)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">₹1,000 - ₹2,500</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_price" value="2500-5000" onchange="spSetPriceRange(2500, 5000)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">₹2,500 - ₹5,000</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_price" value="above-5000" onchange="spSetPriceRange(5000, 999999)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">₹5,000 & Above</span>
                    </label>
                </div>

                <div class="sp-custom-price-inputs">
                    <input type="number" id="spMinPriceInput" placeholder="Min ₹" min="0">
                    <span class="sp-price-dash">-</span>
                    <input type="number" id="spMaxPriceInput" placeholder="Max ₹" min="0">
                    <button type="button" class="sp-btn-price-go" onclick="spApplyCustomPrice()">Go</button>
                </div>
            </div>

            <!-- Filter Group: Minimum Discount -->
            <div class="sp-filter-box">
                <h4 class="sp-filter-title">Discount</h4>
                <div class="sp-filter-options-list">
                    <label class="sp-radio-label">
                        <input type="radio" name="side_discount" value="0" checked onchange="spSetMinDiscount(0)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">All Items</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_discount" value="20" onchange="spSetMinDiscount(20)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">20% or more</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_discount" value="40" onchange="spSetMinDiscount(40)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">40% or more</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_discount" value="50" onchange="spSetMinDiscount(50)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">50% or more</span>
                    </label>
                </div>
            </div>

            <!-- Filter Group: Customer Rating -->
            <div class="sp-filter-box">
                <h4 class="sp-filter-title">Customer Rating</h4>
                <div class="sp-filter-options-list">
                    <label class="sp-radio-label">
                        <input type="radio" name="side_rating" value="0" checked onchange="spSetMinRating(0)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">All Ratings</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_rating" value="4.5" onchange="spSetMinRating(4.5)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">4.5★ & Above</span>
                    </label>
                    <label class="sp-radio-label">
                        <input type="radio" name="side_rating" value="4.0" onchange="spSetMinRating(4.0)">
                        <span class="sp-radio-custom"></span>
                        <span class="sp-cb-text">4.0★ & Above</span>
                    </label>
                </div>
            </div>

            <!-- In-Stock Toggle -->
            <div class="sp-filter-box sp-toggle-box">
                <label class="sp-switch-label">
                    <span class="sp-switch-text">In Stock Only</span>
                    <input type="checkbox" id="spInStockToggle" onchange="spTriggerFilter()">
                    <span class="sp-switch-slider"></span>
                </label>
            </div>
        </aside>

        <!-- RIGHT SIDE: PRODUCTS CATALOG WITH BIG IMAGE FRAMES -->
        <main class="sp-sub-catalog" id="spSubCatalog">

            <div class="sp-catalog-toolbar">
                <div class="sp-toolbar-left">
                    <span class="sp-results-count" id="spResultsCount">Showing @products.Count products in @subPage.CategoryName</span>
                    <div class="sp-active-filter-tags" id="spActiveTags"></div>
                </div>

                <div class="sp-toolbar-search">
                    <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
                    <input type="text" id="spSearchInput" placeholder="Search in @subPage.CategoryName..." onkeyup="spOnSearchChange(this.value)">
                </div>
            </div>

            <!-- PRODUCTS GRID WITH BIG IMAGE FRAMES -->
            <div class="sp-catalog-grid" id="spCatalogGrid">
                @foreach (var prod in products)
                {
                    var prodHasImg = !string.IsNullOrWhiteSpace(prod.ImageUrl) && !prod.ImageUrl.Contains("placeholder") && !prod.IsUploadingSoon;
                    var origPrice = prod.OriginalPrice ?? (prod.Price * 1.5m);
                    var discountPct = origPrice > prod.Price
                        ? (int)Math.Round(((origPrice - prod.Price) / origPrice) * 100)
                        : 0;
                    var brandName = !string.IsNullOrWhiteSpace(prod.Brand) ? prod.Brand : "Campus Pro";

                    <div class="sp-card"
                         data-id="@prod.Id"
                         data-name="@prod.Name.ToLowerInvariant()"
                         data-brand="@brandName.ToLowerInvariant()"
                         data-price="@prod.Price"
                         data-discount="@discountPct"
                         data-rating="@prod.Rating"
                         data-instock="@(prod.InStock.ToString().ToLower())">

                        <!-- BIG IMAGE FRAME (min-height: 320px, aspect-ratio: 3/4) -->
                        <div class="sp-card-frame">
                            @if (!string.IsNullOrWhiteSpace(prod.Badge))
                            {
                                <span class="sp-card-badge">@prod.Badge</span>
                            }
                            @if (discountPct > 0)
                            {
                                <span class="sp-card-discount-pill">-@discountPct% OFF</span>
                            }

                            @if (prodHasImg)
                            {
                                <img src="@prod.ImageUrl" alt="@prod.Name" class="sp-card-img" loading="lazy" />
                            }
                            else
                            {
                                <div class="sp-uploading-frame-large">
                                    <div class="sp-radar-wrap">
                                        <div class="sp-radar-ping-ring"></div>
                                        <span class="sp-frame-emoji">@subPage.IconEmoji</span>
                                    </div>
                                    <div class="sp-frame-uploading-tag">
                                        <span class="sp-pulsing-dot">●</span> UPLOADING SOON
                                    </div>
                                    <p class="sp-frame-uploading-sub">Images will be uploaded by admin</p>
                                </div>
                            }

                            <div class="sp-frame-quick-actions">
                                <button type="button" class="sp-btn-quick-cart" onclick="spAddToCart('@prod.Id', '@prod.Name', @prod.Price, this)" title="Add to Cart">
                                    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.24-1.2A1 1 0 005.06 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg>
                                </button>
                            </div>
                        </div>

                        <!-- CARD BODY -->
                        <div class="sp-card-body">
                            <span class="sp-card-brand">@brandName</span>
                            <h3 class="sp-card-title">@prod.Name</h3>

                            <div class="sp-card-rating">
                                <div class="sp-stars">★★★★★</div>
                                <span class="sp-rating-score">@prod.Rating.ToString("0.0")</span>
                                <span class="sp-rating-reviews">(@prod.ReviewsCount)</span>
                            </div>

                            <div class="sp-card-price-row">
                                <span class="sp-card-price-current">₹@prod.Price.ToString("N0")</span>
                                @if (origPrice > prod.Price)
                                {
                                    <span class="sp-card-price-orig">₹@origPrice.ToString("N0")</span>
                                }
                            </div>

                            @if (prod.Sizes != null && prod.Sizes.Count > 0)
                            {
                                <div class="sp-card-sizes">
                                    @foreach (var size in prod.Sizes.Take(3))
                                    {
                                        <span class="sp-card-size-chip">@size</span>
                                    }
                                    @if (prod.Sizes.Count > 3)
                                    {
                                        <span class="sp-card-size-more">+@(prod.Sizes.Count - 3)</span>
                                    }
                                </div>
                            }

                            <div class="sp-card-cta-wrap">
                                <button type="button" class="sp-card-btn-add" onclick="spAddToCart('@prod.Id', '@prod.Name', @prod.Price, this)">
                                    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.24-1.2A1 1 0 005.06 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg>
                                    <span>Add to Cart</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- EMPTY RESULTS PLACEHOLDER -->
            <div class="sp-empty-results" id="spEmptyResults" style="display: none;">
                <div class="sp-empty-icon">⚽</div>
                <h3 class="sp-empty-title">No matching sports gear found</h3>
                <p class="sp-empty-desc">Try resetting your filters or adjusting your price and brand search.</p>
                <button type="button" class="sp-empty-btn-reset" onclick="spResetAllFilters()">Reset All Filters</button>
            </div>
        </main>
    </div>

</div>

<!-- ========================================================
