@{
    ViewData["Title"] = "Password Reset Complete — Dreamflykit";
    Layout = "_Layout";
}

<div class="dk-auth-page-wrapper">
    <div class="dk-auth-card-container">
        <!-- Brand Panel (Left) -->
        <div class="dk-auth-brand-panel">
            <div class="dk-auth-brand-badge">
                <img src="~/images/branding/dreamflykit-logo.webp"
                     alt="Dreamflykit"
                     class="dk-auth-logo-img" />
            </div>
            <h2 class="dk-auth-tagline">
                Password<br />Updated
            </h2>
            <p class="dk-auth-subtitle">
                Your journey continues with Dreamflykit.
            </p>
        </div>

        <!-- Form Panel (Right) -->
        <div class="dk-auth-form-panel">
            <div class="dk-auth-form-inner text-center">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4 text-green-600 text-3xl">
                    ✓
                </div>
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Password Reset Successfully</h1>
                <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                    Your password has been changed. You can now sign in using your new credentials.
                </p>
                <a asp-action="Login"
                   class="inline-block py-3 px-8 rounded-lg shadow-sm text-sm font-semibold text-white bg-orange-600 hover:bg-orange-700 transition-colors">
                    Sign In Now
                </a>
            </div>
        </div>
    </div>
</div>

