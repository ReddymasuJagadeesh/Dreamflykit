<!-- Hidden File Inputs for Image & 3D Model Upload -->
<input type="file" id="globalImageUploadInput" accept=".jpg,.jpeg,.png,.webp,.svg" style="display: none;" />
<input type="file" id="global3dUploadInput" accept=".glb,.gltf" style="display: none;" />

<script>
    let activeUploadTargetInput = null;

    function triggerFileUpload(btn, type) {
        if (type === '3d') {
            const card = btn.closest(".deal-item-card");
            activeUploadTargetInput = card.querySelector(".deal-model-3d-url");
            document.getElementById("global3dUploadInput").click();
        } else {
            const container = btn.parentElement;
            activeUploadTargetInput = container.querySelector("input[type='text']");
            document.getElementById("globalImageUploadInput").click();
        }
    }

    document.getElementById("globalImageUploadInput").addEventListener("change", async function() {
        if (!this.files || this.files.length === 0 || !activeUploadTargetInput) return;
        const file = this.files[0];
        const formData = new FormData();
        formData.append("file", file);
        formData.append("__RequestVerificationToken", document.querySelector("input[name='__RequestVerificationToken']").value);

        try {
            const res = await fetch("/Admin/MobilesHub/UploadImage", {
                method: "POST",
                body: formData
            });
            const data = await res.json();
            if (data.success && data.url) {
                activeUploadTargetInput.value = data.url;
                alert("Image uploaded successfully!");
            } else {
                alert("Upload failed: " + (data.message || "Unknown error"));
            }
        } catch (err) {
            alert("Upload failed: " + err.message);
        }
        this.value = "";
    });

    document.getElementById("global3dUploadInput").addEventListener("change", async function() {
        if (!this.files || this.files.length === 0 || !activeUploadTargetInput) return;
        const file = this.files[0];
        const formData = new FormData();
        formData.append("file", file);
        formData.append("__RequestVerificationToken", document.querySelector("input[name='__RequestVerificationToken']").value);

        try {
            const res = await fetch("/Admin/MobilesHub/Upload3DModel", {
                method: "POST",
                body: formData
            });
            const data = await res.json();
            if (data.success && data.url) {
                activeUploadTargetInput.value = data.url;
                alert("3D Model (.glb/.gltf) uploaded successfully!");
            } else {
                alert("3D Upload failed: " + (data.message || "Unknown error"));
            }
        } catch (err) {
            alert("Upload failed: " + err.message);
        }
        this.value = "";
    });

    function toggleDeal3dFields(selectEl) {
        const card = selectEl.closest(".deal-item-card");
        const extra = card.querySelector(".deal-3d-extra");
        if (extra) {
            extra.style.display = (selectEl.value === "3D") ? "block" : "none";
        }
        card.style.borderColor = (selectEl.value === "3D") ? "#2874f0" : "#cbd5e1";
    }

    function removeSlide(btn) {
        if (confirm("Delete this slide?")) {
            btn.closest(".slide-item-card").remove();
        }
    }

    function removeBrand(btn) {
        btn.closest(".brand-item-card").remove();
    }

    function removeDeal(btn) {
        if (confirm("Delete this phone deal?")) {
            btn.closest(".deal-item-card").remove();
        }
    }

    function removeEmiDeal(btn) {
        btn.closest(".emi-item-card").remove();
    }

    function addNewSlide() {
        const container = document.getElementById("slidesListContainer");
        const count = container.querySelectorAll(".slide-item-card").length + 1;
        const id = "mob-slide-" + Date.now();
        const html = `
        <div class="slide-item-card" style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-weight: 800; font-size: 13px; color: #2874f0;">Slide #${count} (New)</span>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <label style="font-size: 12px; font-weight: 600; color: #475569;"><input type="checkbox" class="slide-active" checked /> Active</label>
                    <label style="font-size: 12px; font-weight: 600; color: #c2410c;"><input type="checkbox" class="slide-uploading-soon" /> ⏳ Uploading Soon</label>
                    <button type="button" onclick="removeSlide(this)" style="background: #fee2e2; color: #dc2626; border: none; padding: 4px 8px; font-size: 11px; font-weight: 700; border-radius: 4px; cursor: pointer;">Delete</button>
                </div>
            </div>
            <input type="hidden" class="slide-id" value="${id}" />
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
                <div>
                    <label style="display: block; font-size: 11.5px; font-weight: 700; color: #475569; margin-bottom: 4px;">Badge Offer Text</label>
                    <input type="text" class="slide-badge" value="SPECIAL 5G FEST" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                </div>
                <div>
                    <label style="display: block; font-size: 11.5px; font-weight: 700; color: #475569; margin-bottom: 4px;">Slide Title</label>
                    <input type="text" class="slide-title" value="New Launch Smartphone" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                </div>
                <div>
                    <label style="display: block; font-size: 11.5px; font-weight: 700; color: #475569; margin-bottom: 4px;">Title Highlight</label>
                    <input type="text" class="slide-highlight" value="Extra ₹3,000 Off" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                </div>
