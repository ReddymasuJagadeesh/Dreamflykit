                                        </div>
                                        <div class="dk-elec-prod-soon-tag">
                                            <span class="dk-elec-mini-dot">●</span> UPLOADING SOON
                                        </div>
                                        <span class="dk-elec-prod-soon-sub">Images will be uploaded by admin</span>
