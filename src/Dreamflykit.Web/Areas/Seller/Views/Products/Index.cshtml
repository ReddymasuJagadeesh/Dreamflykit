@model Dreamflykit.Web.Areas.Seller.Models.SellerProductListViewModel
@{
    ViewData["Title"] = "All My Products";
    Layout = "_SellerLayout";
}

<!-- HEADER & PROMOTE ALL BANNER -->
<div style="background: linear-gradient(135deg, #1e293b, #0f172a); border: 1px solid #334155; border-radius: 14px; padding: 1.5rem 2rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: #f8fafc; margin: 0; display:flex; align-items:center; gap:0.6rem;">
            <span>📦</span> All Products in One Place
        </h1>
        <p style="color: #94a3b8; font-size: 0.9rem; margin: 0.35rem 0 0;">
            Manage all your product submissions, review pricing status from Super Admin, and promote all products at once.
        </p>
    </div>

    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <!-- PROMOTE ALL AT ONCE BUTTON -->
        <form asp-action="PromoteAll" method="post" onsubmit="return confirm('Promote ALL your products at once? They will display the featured promotional badge on Dreamflykit store.');">
            @Html.AntiForgeryToken()
            <button type="submit" style="padding: 0.7rem 1.4rem; background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff; border:none; border-radius: 8px; font-weight: 800; font-size: 0.9rem; cursor: pointer; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4); display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.1rem;">⚡</span>
                <span>Promote All Products (At Once)</span>
            </button>
        </form>

        <a asp-action="Create" style="padding: 0.7rem 1.25rem; background: linear-gradient(135deg, #10b981, #059669); color: #fff; border-radius: 8px; font-weight: 800; font-size: 0.9rem; text-decoration: none; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35); display: flex; align-items: center; gap: 0.4rem;">
            <span>+</span>
            <span>Add New Product</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #6ee7b7; padding: 0.85rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; display:flex; align-items:center; gap:0.75rem;">
        <span>✓</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; padding: 0.85rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; display:flex; align-items:center; gap:0.75rem;">
        <span>⚠️</span>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- FILTER TABS & SEARCH -->
<div style="background: #1e293b; border-radius: 12px; border: 1px solid #334155; margin-bottom: 1.5rem; overflow:hidden;">
    <div style="padding: 1rem 1.25rem; border-bottom: 1px solid #334155; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
        <div style="display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
            <a href="/Seller/Products" style="padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.85rem; font-weight: 700; text-decoration: none; @(string.IsNullOrEmpty(Model.StatusFilter) ? "background: #3b82f6; color: #fff;" : "background: #0f172a; color: #94a3b8; border: 1px solid #334155;")">
                All Products (@Model.TotalCount)
            </a>

            <a href="/Seller/Products?status=PendingApproval" style="padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.85rem; font-weight: 700; text-decoration: none; @(Model.StatusFilter == "PendingApproval" ? "background: #d97706; color: #fff;" : "background: #0f172a; color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4);")">
                ⏳ Pending Pricing (@Model.PendingCount)
            </a>

            <a href="/Seller/Products?status=Approved" style="padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.85rem; font-weight: 700; text-decoration: none; @(Model.StatusFilter == "Approved" ? "background: #059669; color: #fff;" : "background: #0f172a; color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4);")">
                ✓ Live &amp; Approved (@Model.ApprovedCount)
            </a>

            <a href="/Seller/Products?status=Promoted" style="padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.85rem; font-weight: 700; text-decoration: none; @(Model.StatusFilter == "Promoted" ? "background: #dc2626; color: #fff;" : "background: #0f172a; color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4);")">
                ⚡ Promoted (@Model.PromotedCount)
            </a>

            <a href="/Seller/Products?status=Rejected" style="padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.85rem; font-weight: 700; text-decoration: none; @(Model.StatusFilter == "Rejected" ? "background: #64748b; color: #fff;" : "background: #0f172a; color: #94a3b8; border: 1px solid #334155;")">
                ✕ Rejected (@Model.RejectedCount)
            </a>
        </div>

        <form method="get" style="display:flex; gap:0.5rem; align-items:center;">
            @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
            {
                <input type="hidden" name="status" value="@Model.StatusFilter" />
            }
            <input type="text"
                   name="search"
                   value="@Model.SearchTerm"
                   placeholder="Search your products..."
                   style="padding: 0.45rem 0.85rem; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #f8fafc; font-size: 0.85rem; width: 200px;" />
            <button type="submit" style="padding: 0.45rem 0.9rem; background: #334155; color: #fff; border:none; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor:pointer;">
                Search
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a href="/Seller/Products" style="padding: 0.45rem 0.75rem; background: #475569; color: #cbd5e1; border-radius: 6px; font-size: 0.85rem; text-decoration:none;">
                    Clear
                </a>
            }
        </form>
    </div>

    <!-- PRODUCTS TABLE -->
    @if (Model.Products.Count == 0)
    {
        <div style="padding: 3.5rem; text-align: center; color: #94a3b8;">
            <div style="font-size: 3rem; margin-bottom: 0.75rem;">📦</div>
            <h3 style="color: #f1f5f9; font-size: 1.15rem; margin-bottom: 0.35rem;">No products found</h3>
            <p style="font-size: 0.875rem; margin-bottom: 1.25rem;">Start selling by adding your products with specifications and photos. Prices will be assigned by Super Admin.</p>
            <a asp-action="Create" style="display:inline-block; padding: 0.65rem 1.35rem; background: #10b981; color: #fff; border-radius: 6px; font-weight: 700; text-decoration: none;">
                + Add Product Now
            </a>
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;">
                <thead>
                    <tr style="background: #0f172a; border-bottom: 1px solid #334155; color: #94a3b8; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">
                        <th style="padding: 0.9rem 1.25rem;">Image</th>
                        <th style="padding: 0.9rem 1rem;">Product Details</th>
                        <th style="padding: 0.9rem 1rem;">Category</th>
                        <th style="padding: 0.9rem 1rem;">Official Price</th>
                        <th style="padding: 0.9rem 1rem;">Approval Status</th>
                        <th style="padding: 0.9rem 1rem; text-align: center;">Promote</th>
                        <th style="padding: 0.9rem 1.25rem; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr style="border-bottom: 1px solid #334155; transition: background 0.15s ease;">
                            <td style="padding: 1rem 1.25rem; width: 64px;">
                                <img src="@p.ImageUrl" alt="@p.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px; border: 1px solid #334155; background: #0f172a;" onerror="this.src='/images/products/product-placeholder.webp';" />
                            </td>
                            <td style="padding: 1rem 1rem;">
                                <div style="font-weight: 700; color: #f8fafc; font-size: 0.95rem;">
                                    @p.Name
                                    @if (p.IsPromoted)
                                    {
                                        <span style="font-size: 10px; background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff; padding: 2px 7px; border-radius: 4px; font-weight: 800; margin-left: 6px;">⚡ PROMOTED</span>
                                    }
                                </div>
                                <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.2rem;">
                                    <code>/Products/@p.Slug</code>
                                    @if (p.IsActive && p.ApprovalStatus == Dreamflykit.Domain.Catalog.ProductApprovalStatus.Approved)
                                    {
                                        <a href="/Products/@p.Slug" target="_blank" rel="noopener" style="color: #38bdf8; text-decoration: none; margin-left: 6px;">view store ↗</a>
                                    }
                                </div>
                            </td>
                            <td style="padding: 1rem 1rem; color: #cbd5e1;">
                                <div style="font-weight: 600;">@p.CategoryName</div>
                                @if (!string.IsNullOrEmpty(p.SubcategoryName))
                                {
                                    <div style="font-size: 0.75rem; color: #94a3b8;">@p.SubcategoryName</div>
                                }
                            </td>
                            <td style="padding: 1rem 1rem;">
                                @if (p.SellingPrice > 0)
                                {
                                    <div style="font-weight: 800; color: #34d399; font-size: 1rem;">₹@p.SellingPrice.ToString("N0")</div>
                                    @if (p.Mrp > p.SellingPrice)
                                    {
                                        <div style="font-size: 0.75rem; color: #94a3b8; text-decoration: line-through;">MRP: ₹@p.Mrp.ToString("N0")</div>
                                    }
                                }
                                else
                                {
                                    <div style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; display:inline-block;">
                                        ⏳ Awaiting Super Admin Price
                                    </div>
                                }
                            </td>
                            <td style="padding: 1rem 1rem;">
                                @if (p.ApprovalStatus == Dreamflykit.Domain.Catalog.ProductApprovalStatus.PendingApproval)
                                {
                                    <span style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5); padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; display:inline-flex; align-items:center; gap:4px;">
                                        <span>⏳</span> In Review
                                    </span>
                                }
                                else if (p.ApprovalStatus == Dreamflykit.Domain.Catalog.ProductApprovalStatus.Approved)
                                {
                                    <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.5); padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; display:inline-flex; align-items:center; gap:4px;">
                                        <span>✓</span> Live &amp; Approved
                                    </span>
                                }
                                else
                                {
                                    <div>
                                        <span style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.5); padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; display:inline-block;">
                                            ✕ Rejected
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(p.RejectionReason))
                                        {
                                            <div style="font-size: 0.75rem; color: #fca5a5; margin-top: 0.35rem; max-width: 180px;">
                                                Feedback: @p.RejectionReason
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td style="padding: 1rem 1rem; text-align: center;">
                                <form asp-action="TogglePromote" asp-route-id="@p.ProductId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="padding: 0.35rem 0.75rem; border-radius: 6px; font-size: 0.8rem; font-weight: 700; cursor: pointer; border: 1px solid; @(p.IsPromoted ? "background: #f59e0b; color: #fff; border-color: #d97706;" : "background: #0f172a; color: #94a3b8; border-color: #334155;")" title="Click to promote or unpromote">
                                        @(p.IsPromoted ? "⚡ Promoted" : "+ Promote")
                                    </button>
                                </form>
                            </td>
                            <td style="padding: 1rem 1.25rem; text-align: right; white-space: nowrap;">
                                <div style="display:inline-flex; gap:0.4rem; align-items:center;">
                                    <a asp-action="Edit" asp-route-id="@p.ProductId" style="padding: 0.35rem 0.75rem; background: #334155; color: #38bdf8; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none;">
                                        Edit
                                    </a>
                                    <a asp-action="Media" asp-route-id="@p.ProductId" style="padding: 0.35rem 0.75rem; background: #334155; color: #cbd5e1; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none;" title="Manage gallery photos">
                                        Gallery
                                    </a>
                                    @if (p.ApprovalStatus != Dreamflykit.Domain.Catalog.ProductApprovalStatus.Approved)
                                    {
                                        <form asp-action="Delete" asp-route-id="@p.ProductId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this submission?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" style="padding: 0.35rem 0.65rem; background: #ef4444; color: #fff; border:none; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor:pointer;" title="Delete submission">
                                                ✕
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
