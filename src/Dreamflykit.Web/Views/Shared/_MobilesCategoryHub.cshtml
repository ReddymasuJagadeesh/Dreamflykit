@model Dreamflykit.Application.MobilesHub.Models.MobilesHubDto
@{
    var hub = Model ?? Dreamflykit.Application.MobilesHub.Models.MobilesHubDto.CreateDefault();
    var hero = hub.HeroBanner ?? new Dreamflykit.Application.MobilesHub.Models.MobilesHeroBannerDto();
    var slides = hero.Slides?.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToList() 
                 ?? new List<Dreamflykit.Application.MobilesHub.Models.MobilesHeroSlideDto>();
    if (slides.Count == 0)
    {
        slides = Dreamflykit.Application.MobilesHub.Models.MobilesHubDto.CreateDefault().HeroBanner.Slides;
    }

    var enableSlides = hero.EnableSlideshow && slides.Count > 1;
    var slideDuration = hero.SlideIntervalSeconds > 0 ? hero.SlideIntervalSeconds : 4;
    var themeColor = !string.IsNullOrWhiteSpace(hero.ThemeColor) ? hero.ThemeColor : "#2874f0";
    var accentColor = !string.IsNullOrWhiteSpace(hero.ThemeAccentColor) ? hero.ThemeAccentColor : "#fb641b";
    var minHeight = hero.BannerHeight > 0 ? hero.BannerHeight : 440;
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");

    var brands = hub.BrandsSection?.Brands?.OrderBy(b => b.DisplayOrder).ToList() ?? new List<Dreamflykit.Application.MobilesHub.Models.MobileBrandItemDto>();
    var highlight = hub.HighlightBanner ?? new Dreamflykit.Application.MobilesHub.Models.MobilesHighlightBannerDto();
    var topDeals = hub.TopDealsSection?.Deals?.OrderBy(d => d.DisplayOrder).ToList() ?? new List<Dreamflykit.Application.MobilesHub.Models.MobileDealItemDto>();
    var confused = hub.ConfusedSection ?? new Dreamflykit.Application.MobilesHub.Models.MobilesConfusedSectionDto();
    var promo = hub.PromoBanner ?? new Dreamflykit.Application.MobilesHub.Models.MobilesPromoBannerDto();
    var unmissable = hub.UnmissableDealsSection?.Deals?.OrderBy(u => u.DisplayOrder).ToList() ?? new List<Dreamflykit.Application.MobilesHub.Models.MobileEmiDealItemDto>();
}

<!-- Google Model Viewer & Three.js Libraries for Industry Standard 3D Visualization -->
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<div class="dk-mobiles-hub-root" id="mobiles-hub-root" style="--mob-primary: @themeColor; --mob-accent: @accentColor;">

    <!-- ========================================================
         ADMIN QUICK-BAR (Visible only to Admin / SuperAdmin)
    ========================================================= -->
    @if (isAdmin)
    {
        <div class="dk-mob-admin-bar">
            <div class="dk-mob-admin-left">
                <span class="dk-mob-admin-badge">⚡ Admin Mode Active</span>
                <span class="dk-mob-admin-hint">
                    Flipkart Mobiles Hub &bull; Slides Timing: <strong>@(slideDuration)s</strong> &bull; Total Slides: <strong>@slides.Count</strong> &bull; 3D Visualizer: <strong>Enabled</strong>
                </span>
            </div>
            <div class="dk-mob-admin-actions">
                <a href="/Admin/MobilesHub" class="dk-mob-admin-btn" id="btnManageMobilesHub">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    Manage Mobiles Hub, Upload Images &amp; 3D Models
                </a>
            </div>
        </div>
    }

    <!-- ========================================================
         1. HERO BANNER: ONE FULL-WIDTH BIG SIZE HERO BANNER WITH SLIDES
         Admin decides slide duration (sec), images upload, and text!
    ========================================================= -->
    @if (hero.IsEnabled)
    {
        <section class="dk-mob-hero-section" 
                 id="mobilesHeroCarousel" 
                 data-autoplay="@(hero.AutoPlay ? "true" : "false")"
                 data-interval="@(slideDuration * 1000)"
                 style="min-height: @(minHeight)px;"
                 aria-label="Mobiles Featured Showcase">

            <div class="dk-mob-slides-container" id="mobilesSlidesContainer">
                @for (int i = 0; i < slides.Count; i++)
                {
                    var slide = slides[i];
                    var isActive = i == 0;
                    <div class="dk-mob-slide @(isActive ? "active" : "")" 
                         data-slide-index="@i"
                         id="mobSlide-@i"
                         role="tabpanel"
                         aria-hidden="@(isActive ? "false" : "true")">

                        <!-- Full Width Panoramic Background Image -->
                        <div class="dk-mob-slide-bg">
                            <img src="@slide.ImageUrl" 
                                 alt="@slide.Title @slide.TitleHighlight" 
                                 class="dk-mob-slide-img" 
                                 onerror="this.src='/images/mobiles-hub/uploading-soon-placeholder.svg';" />
                            <div class="dk-mob-slide-overlay"></div>
                        </div>

                        <!-- Live Text Content Overlay -->
                        <div class="dk-mob-slide-content">
                            <div class="dk-mob-slide-left">
                                @if (!string.IsNullOrWhiteSpace(slide.DiscountBadge))
                                {
                                    <div class="dk-mob-slide-badge">
                                        <span class="dk-mob-badge-fire">🔥</span>
                                        <span>@slide.DiscountBadge</span>
                                    </div>
                                }

                                <h1 class="dk-mob-slide-title">
                                    @slide.Title <br />
                                    <span class="dk-mob-slide-highlight">@slide.TitleHighlight</span>
                                </h1>

                                <p class="dk-mob-slide-subtitle">
                                    @slide.Subtitle
                                </p>

                                <div class="dk-mob-slide-ctas">
                                    <a href="@(string.IsNullOrWhiteSpace(slide.TargetUrl) ? "/products?category=mobiles" : slide.TargetUrl)" 
                                       class="dk-mob-btn-primary">
                                        @(string.IsNullOrWhiteSpace(slide.ButtonText) ? "Shop Now" : slide.ButtonText)
                                    </a>
                                    <button type="button" 
                                            class="dk-mob-btn-secondary" 
                                            onclick="open3dModal('AI+ Nova 2 5G', '#4f46e5', '6.7 120Hz AMOLED | 50MP OIS', 'From ₹11,999*')">
                                        <span style="font-size: 16px;">🌐</span> View in 3D Model
                                    </button>
                                </div>
                            </div>

                            @if (slide.IsUploadingSoon)
                            {
                                <div class="dk-mob-slide-uploading-tag">
                                    <span>⏳ New Image Uploading Soon</span>
                                </div>
                            }
                        </div>

                    </div>
                }
            </div>

            <!-- Slide Navigation Controls -->
            @if (enableSlides)
            {
                <button type="button" class="dk-mob-carousel-arrow dk-mob-prev" id="mobHeroPrev" aria-label="Previous Slide">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <button type="button" class="dk-mob-carousel-arrow dk-mob-next" id="mobHeroNext" aria-label="Next Slide">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>

                <!-- Indicator Dots & Timer Bar -->
                <div class="dk-mob-carousel-indicators" id="mobHeroIndicators">
                    @for (int i = 0; i < slides.Count; i++)
                    {
                        <button type="button" 
                                class="dk-mob-dot @(i == 0 ? "active" : "")" 
                                data-slide-target="@i" 
                                aria-label="Go to slide @(i+1)">
                            <span class="dk-mob-dot-fill"></span>
                        </button>
                    }
                </div>
            }
        </section>
    }

    <!-- ========================================================
         2. TOP SMARTPHONE BRANDS STRIP (Flipkart Pedestal Circles)
    ========================================================= -->
    @if (hub.BrandsSection.IsEnabled && brands.Count > 0)
    {
        var row1Brands = brands.Take(9).ToList();
        var row2Brands = brands.Skip(9).Take(9).ToList();
        if (row2Brands.Count == 0 && brands.Count > 6)
        {
            var half = (int)Math.Ceiling(brands.Count / 2.0);
            row1Brands = brands.Take(half).ToList();
            row2Brands = brands.Skip(half).ToList();
        }

        <section class="dk-mob-brands-section" id="popularBrandsSection" aria-label="Top Mobile Brands Showcase">
            
            <!-- Creative Section Header & Pill Navigation -->
            <div class="dk-mob-section-header">
                <div class="dk-mob-section-title-wrap">
                    <span class="dk-mob-section-pill dk-pill-gradient">🔥 POPULAR FLAGSHIP BRANDS</span>
                    <div>
                        <h2 class="dk-mob-section-title">@hub.BrandsSection.Title</h2>
                        <span class="dk-mob-section-caption">Explore official flagship smartphones presented live on 3D pedestals</span>
                    </div>
                </div>

                <!-- Scroll Nav Buttons & View All -->
                <div class="dk-mob-brands-nav-right">
                    <div class="dk-mob-track-arrows">
                        <button type="button" class="dk-mob-arrow-btn" id="btnBrandsPrev" aria-label="Scroll Brands Left">&#8249;</button>
                        <button type="button" class="dk-mob-arrow-btn" id="btnBrandsNext" aria-label="Scroll Brands Right">&#8250;</button>
                    </div>
                    <a href="@hub.BrandsSection.ViewAllUrl" class="dk-mob-view-all-link">
                        View All Brands &rarr;
                    </a>
                </div>
            </div>

            <!-- Quick Filter Chips for Popular Categories -->
            <div class="dk-mob-brand-filter-bar">
                <button type="button" class="dk-brand-chip active" onclick="filterBrandStages('all', this)">
                    ✨ All Popular Brands (@brands.Count)
                </button>
                <button type="button" class="dk-brand-chip" onclick="filterBrandStages('flagship', this)">
                    💎 Flagship Elite (Apple, Samsung, Pixel)
                </button>
                <button type="button" class="dk-brand-chip" onclick="filterBrandStages('performance', this)">
                    ⚡ 5G Gaming &amp; Speed (POCO, Nothing, OnePlus)
                </button>
                <button type="button" class="dk-brand-chip" onclick="filterBrandStages('camera', this)">
                    📸 Studio Camera Kings (vivo, OPPO, realme)
                </button>
                <button type="button" class="dk-brand-chip" onclick="filterBrandStages('value', this)">
                    💰 Student Value 5G (Ai+, LAVA, REDMI, Tecno)
                </button>
            </div>

            <!-- Two-Tier Panoramic Stage Display (Flipkart Dual Row Style - Big Sized Stage Podiums) -->
            <div class="dk-mob-stage-scroller" id="mobBrandsScroller">
                
                <!-- Tier 1 Row -->
                <div class="dk-mob-stage-row" id="brandTierRow1">
                    @foreach (var brand in row1Brands)
                    {
                        var brandSlug = brand.Slug?.ToLowerInvariant() ?? "";
                        var filterCat = (brandSlug.Contains("apple") || brandSlug.Contains("google") || brandSlug.Contains("samsung")) ? "flagship" :
                                        (brandSlug.Contains("poco") || brandSlug.Contains("nothing") || brandSlug.Contains("oneplus")) ? "performance" :
                                        (brandSlug.Contains("realme") || brandSlug.Contains("motorola") || brandSlug.Contains("vivo") || brandSlug.Contains("oppo")) ? "camera" : "value";

                        <a href="@brand.ProductUrl" 
                           class="dk-mob-stage-card" 
                           data-brand-category="@filterCat"
                           title="Explore @brand.Name Smartphones">
                            
                            <!-- 3D Pedestal Stage Phone Showcase (Large High-Res Size) -->
                            <div class="dk-mob-stage-podium-wrap">
                                <img src="@brand.IconUrl" 
                                     alt="@brand.Name" 
                                     class="dk-mob-stage-phone-img" 
                                     loading="lazy"
                                     onerror="this.src='/images/mobiles-hub/uploading-soon-placeholder.svg';" />

                                <!-- Hover Quick 3D Pill -->
                                <div class="dk-mob-stage-hover-pill">
                                    <span>🌐 View 3D</span>
                                </div>
                            </div>

                            <!-- Metallic Brand Title Plate -->
                            <div class="dk-mob-brand-badge-plate">
                                <span class="dk-mob-stage-brand-title">@brand.Name</span>
                            </div>
                        </a>
                    }
                </div>

                <!-- Tier 2 Row -->
                @if (row2Brands.Count > 0)
                {
                    <div class="dk-mob-stage-row" id="brandTierRow2">
                        @foreach (var brand in row2Brands)
                        {
                            var brandSlug = brand.Slug?.ToLowerInvariant() ?? "";
                            var filterCat = (brandSlug.Contains("apple") || brandSlug.Contains("google") || brandSlug.Contains("samsung")) ? "flagship" :
                                            (brandSlug.Contains("poco") || brandSlug.Contains("nothing") || brandSlug.Contains("oneplus")) ? "performance" :
                                            (brandSlug.Contains("realme") || brandSlug.Contains("motorola") || brandSlug.Contains("vivo") || brandSlug.Contains("oppo")) ? "camera" : "value";

                            <a href="@brand.ProductUrl" 
                               class="dk-mob-stage-card" 
                               data-brand-category="@filterCat"
                               title="Explore @brand.Name Smartphones">
                                
                                <div class="dk-mob-stage-podium-wrap">
                                    <img src="@brand.IconUrl" 
                                         alt="@brand.Name" 
                                         class="dk-mob-stage-phone-img" 
                                         loading="lazy"
                                         onerror="this.src='/images/mobiles-hub/uploading-soon-placeholder.svg';" />

                                    <div class="dk-mob-stage-hover-pill">
                                        <span>🌐 View 3D</span>
                                    </div>
                                </div>

                                <div class="dk-mob-brand-badge-plate">
                                    <span class="dk-mob-stage-brand-title">@brand.Name</span>
                                </div>
                            </a>
                        }
                    </div>
                }

            </div>
        </section>
    }

    <!-- ========================================================
         3. FLAGSHIP SPECIALS: 3-SECTION 3D SLIDE SHOWCASE (Flipkart Style)
         Divided into 3 sections, each section slides with slides count decided by Admin!
    ========================================================= -->
    @if (highlight.IsEnabled)
    {
        var hasSections = highlight.Sections != null && highlight.Sections.Count > 0;
        if (hasSections)
        {
            <section class="dk-flagship-three-section" 
                     id="flagshipThreeSection" 
                     aria-label="Flagship Smartphone 3-Section Showcase"
                     data-autoplay="@(highlight.AutoPlay ? "true" : "false")"
                     data-sync="@(highlight.SyncAllSections ? "true" : "false")"
                     data-interval="@(highlight.SlideIntervalSeconds > 0 ? highlight.SlideIntervalSeconds * 1000 : 4000)">
                
                <div class="dk-flagship-grid">
                    @for (int c = 0; c < highlight.Sections.Count; c++)
                    {
                        var col = highlight.Sections[c];
                        var colSlides = col.Slides.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToList();
                        if (colSlides.Count == 0 && col.Slides.Count > 0) { colSlides = col.Slides; }

                        <div class="dk-flagship-col-carousel" id="flagshipCol_@c" data-col-index="@c">
                            <!-- Slides track -->
                            <div class="dk-flagship-slides-track">
                                @for (int s = 0; s < colSlides.Count; s++)
                                {
                                    var slide = colSlides[s];
                                    var isActive = (s == 0);
                                    <a href="@slide.TargetUrl" 
                                       class="dk-flagship-card @(isActive ? "active" : "")" 
                                       data-slide-index="@s"
                                       style="--glow-color: @slide.ThemeGlowColor;"
                                       title="View @slide.PhoneName">
                                        
                                        <!-- 3D Fiery Metallic Ribbon Border -->
                                        <div class="dk-flagship-ribbon-border"></div>

                                        <!-- Top Row: Badge + Star Rating Pill -->
                                        <div class="dk-flagship-card-header">
                                            <span class="dk-flagship-badge">@(string.IsNullOrWhiteSpace(slide.BadgeText) ? "FLAGSHIP SPECIAL" : slide.BadgeText)</span>
                                            @if (!string.IsNullOrWhiteSpace(slide.Rating))
                                            {
                                                <div class="dk-flagship-rating-badge">
                                                    <span class="dk-flagship-star">★</span>
                                                    <span class="dk-flagship-rating-text">@slide.Rating</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Card Content & 3D Visual -->
                                        <div class="dk-flagship-card-body">
                                            <!-- Left Info -->
                                            <div class="dk-flagship-text-wrap">
                                                <h3 class="dk-flagship-phone-title">@slide.PhoneName</h3>
                                                <p class="dk-flagship-phone-tagline">@slide.Tagline</p>

                                                <!-- Price & Strike -->
                                                <div class="dk-flagship-prices">
                                                    <span class="dk-flagship-selling-price">@slide.PriceText</span>
                                                    @if (!string.IsNullOrWhiteSpace(slide.OriginalPriceText))
                                                    {
                                                        <span class="dk-flagship-mrp-price">@slide.OriginalPriceText</span>
                                                    }
                                                </div>

                                                <!-- 0% EMI Gold Medallion Badge (Flipkart Style) -->
                                                @if (!string.IsNullOrWhiteSpace(slide.EmiBadgeText))
                                                {
                                                    <div class="dk-flagship-emi-medallion">
                                                        <div class="dk-flagship-emi-coin">
                                                            <span>0%</span>
                                                            <small>EMI</small>
                                                        </div>
                                                        <div class="dk-flagship-emi-amount">
                                                            @slide.EmiBadgeText.Replace("0% EMI", "").Trim()
                                                        </div>
                                                    </div>
                                                }

                                                <span class="dk-flagship-disclaimer-text">@slide.OfferDisclaimer</span>
                                            </div>

                                            <!-- Right 3D Phone Pop-out Visual -->
                                            <div class="dk-flagship-visual-wrap">
                                                <img src="@slide.ImageUrl" 
                                                     alt="@slide.PhoneName" 
                                                     class="dk-flagship-phone-img" 
                                                     loading="lazy"
                                                     onerror="this.src='/images/mobiles-hub/uploading-soon-placeholder.svg';" />
                                                <div class="dk-flagship-popout-glow"></div>
                                            </div>
                                        </div>

                                    </a>
                                }
                            </div>

                            <!-- Section Pagination Dots (Removed / Controlled by Admin) -->
                            @if (highlight.ShowDots && colSlides.Count > 1)
                            {
                                <div class="dk-flagship-dots-bar" id="flagshipDots_@c">
                                    @for (int d = 0; d < colSlides.Count; d++)
                                    {
                                        <button type="button" 
                                                class="dk-flagship-dot @(d == 0 ? "active" : "")" 
                                                data-target="@d" 
                                                onclick="switchFlagshipColSlide(@c, @d, event)"
                                                aria-label="Slide @(d+1)">
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="dk-mob-highlight-section" aria-label="Flagship Smartphone Banner">
                <a href="@highlight.TargetUrl" class="dk-mob-highlight-card">
                    <div class="dk-mob-highlight-content">
                        <div class="dk-mob-highlight-pill">FLAGSHIP SPECIAL</div>
                        <h3 class="dk-mob-highlight-title">@highlight.Title</h3>
                        <div class="dk-mob-highlight-price">@highlight.TitleHighlight</div>
                        <p class="dk-mob-highlight-sub">@highlight.Subtitle</p>
                        <span class="dk-mob-highlight-cta">@highlight.ButtonText</span>
                    </div>
                    <div class="dk-mob-highlight-visual">
                        <img src="@highlight.ImageUrl" 
                             alt="@highlight.Title" 
                             class="dk-mob-highlight-img" 
                             onerror="this.src='/images/mobiles-hub/uploading-soon-placeholder.svg';" />
                    </div>
                </a>
            </section>
        }
    }

    <!-- ========================================================
         4. TOP DEALS (Flipkart Blue Neon Festive Frame & 3D Interactive Grid)
         Admin decides 3D / 2D / 1D mode for every product!
    ========================================================= -->
    @if (hub.TopDealsSection.IsEnabled && topDeals.Count > 0)
    {
        <section class="dk-mob-topdeals-wrapper" id="mobilesTopDealsSection" aria-label="Top Mobile Deals">
            <!-- Blue Festive Glowing Frame -->
            <div class="dk-mob-deals-frame">
                
                <!-- Festive Header -->
                <div class="dk-mob-deals-banner-header">
                    <div class="dk-mob-deals-spark-left">✨</div>
                    <div class="dk-mob-deals-title-box">
                        <h2 class="dk-mob-deals-main-title">@hub.TopDealsSection.Title</h2>
                        <span class="dk-mob-deals-tagline">@hub.TopDealsSection.Tagline</span>
                    </div>
                    <div class="dk-mob-deals-spark-right">✨</div>
                </div>

                <!-- 3x3 Phone Grid -->
                <div class="dk-mob-deals-grid">
                    @foreach (var deal in topDeals)
                    {
                        var is3d = string.Equals(deal.ViewMode, "3D", StringComparison.OrdinalIgnoreCase);
                        <div class="dk-mob-deal-card" id="dealCard-@deal.Id">
                            
                            <!-- Phone Preview Area -->
                            <div class="dk-mob-card-photo-area">
                                <a href="@deal.ProductUrl" class="dk-mob-card-img-link">
                                    <img src="@deal.ImageUrl" 
                                         alt="@deal.Name" 
                                         class="dk-mob-card-img" 
                                         loading="lazy"
                                         onerror="this.src='/images/mobiles-hub/uploading-soon-placeholder.svg';" />
                                </a>

                                <!-- Offer Vertical Ribbon -->
                                @if (!string.IsNullOrWhiteSpace(deal.OfferTag))
                                {
                                    <div class="dk-mob-vertical-ribbon">
                                        <span>@deal.OfferTag</span>
                                    </div>
                                }

                                <!-- 3D / 2D / 1D Badge Indicator -->
                                <div class="dk-mob-mode-badge @(is3d ? "is-3d" : "is-2d")">
                                    @(is3d ? "3D INTERACTIVE" : (deal.ViewMode == "1D" ? "1D VIEW" : "2D GALLERY"))
                                </div>
                            </div>

                            <!-- Phone Info -->
                            <div class="dk-mob-card-info">
                                <h3 class="dk-mob-phone-name" title="@deal.Name">
                                    <a href="@deal.ProductUrl">@deal.Name</a>
                                </h3>

                                <div class="dk-mob-price-row">
                                    <span class="dk-mob-selling-price">@deal.PriceText</span>
                                    @if (!string.IsNullOrWhiteSpace(deal.OriginalPriceText))
                                    {
                                        <span class="dk-mob-strike-price">@deal.OriginalPriceText</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(deal.Specifications))
                                {
                                    <div class="dk-mob-specs-snippet" title="@deal.Specifications">
                                        @deal.Specifications
                                    </div>
                                }

                                <!-- Interactive Action Buttons -->
                                <div class="dk-mob-card-actions">
                                    @if (is3d)
                                    {
                                        <button type="button" 
                                                class="dk-mob-btn-view-3d"
                                                onclick="open3dModal('@deal.Name', '@deal.ColorHex', '@deal.Specifications', '@deal.PriceText', '@(deal.Model3dUrl ?? "")')">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                                            View 3D (360°)
                                        </button>
                                    }
                                    <a href="@deal.ProductUrl" class="dk-mob-btn-details">
                                        View Details
                                    </a>
                                </div>
                            </div>

                        </div>
                    }
                </div>

                <!-- Footer Bottom Strip -->
                <div class="dk-mob-deals-footer-strip">
                    <span>⚡ 100% Student Verified &bull; Global Fast Dispatch &bull; Official Brand Warranty</span>
                    <a href="@hub.TopDealsSection.ViewAllUrl" class="dk-mob-deals-all-btn">
                        View All Deals &rarr;
                    </a>
                </div>

            </div>
        </section>
    }

    <!-- ========================================================
         5. CONFUSED? PHONE PICKER WIDGET & 0% EMI STRIP
    ========================================================= -->
    @if (confused.IsEnabled)
    {
        <section class="dk-mob-confused-strip" aria-label="Phone Recommendation Helper">
            <div class="dk-mob-confused-card">
                <div class="dk-mob-confused-lantern">🏮</div>
                <div class="dk-mob-confused-content">
                    <span class="dk-mob-confused-badge">@confused.Title</span>
                    <h3 class="dk-mob-confused-title">@confused.Subtitle</h3>
                    <p class="dk-mob-confused-sub">Select your priority: Gaming, 200MP Camera, 4-Day Battery, or Travel eSIM</p>
                </div>
                <a href="@confused.TargetUrl" class="dk-mob-confused-btn">
                    @confused.ButtonText
                </a>
                <div class="dk-mob-confused-lantern">🏮</div>
            </div>
        </section>
    }

    <!-- ========================================================
         6. CONTEST & PROMO BANNER (Win Pixel Watch 5)
    ========================================================= -->
    @if (promo.IsEnabled)
    {
        <section class="dk-mob-promo-section" aria-label="Smartphone Contest Banner">
            <a href="@promo.TargetUrl" class="dk-mob-promo-card">
                <div class="dk-mob-promo-content">
                    <span class="dk-mob-promo-kicker">FESTIVE CONTEST</span>
                    <h3 class="dk-mob-promo-title">@promo.Title</h3>
                    <div class="dk-mob-promo-highlight">@promo.Highlight</div>
                    <span class="dk-mob-promo-btn">@promo.ButtonText</span>
                </div>
                <div class="dk-mob-promo-visual">
                    <img src="@promo.ImageUrl" 
                         alt="@promo.Title" 
                         class="dk-mob-promo-img" 
                         onerror="this.src='/images/mobiles-hub/uploading-soon-placeholder.svg';" />
                </div>
            </a>
        </section>
    }

    <!-- ========================================================
         7. UNMISSABLE DEALS (EMI CAROUSEL)
    ========================================================= -->
    @if (hub.UnmissableDealsSection.IsEnabled && unmissable.Count > 0)
    {
        <section class="dk-mob-unmissable-section" aria-label="Unmissable Phone Deals">
            <div class="dk-mob-section-header">
                <div class="dk-mob-section-title-wrap">
                    <span class="dk-mob-section-pill">FLEXIBLE EMI</span>
                    <h2 class="dk-mob-section-title">@hub.UnmissableDealsSection.Title</h2>
                </div>
                <div class="dk-mob-carousel-nav-btns">
                    <button type="button" class="dk-mob-circle-nav-btn" id="unmissablePrev" aria-label="Scroll left">&#8249;</button>
                    <button type="button" class="dk-mob-circle-nav-btn" id="unmissableNext" aria-label="Scroll right">&#8250;</button>
                </div>
            </div>

            <div class="dk-mob-unmissable-track" id="unmissableTrack">
                @foreach (var emiDeal in unmissable)
                {
                    <div class="dk-mob-emi-card">
                        <!-- Top EMI Tag -->
                        <div class="dk-mob-emi-header-tag">
                            @emiDeal.EmiText
                        </div>

                        <!-- Image -->
                        <div class="dk-mob-emi-img-wrap">
                            <img src="@emiDeal.ImageUrl" 
                                 alt="@emiDeal.Name" 
                                 class="dk-mob-emi-img" 
                                 loading="lazy"
                                 onerror="this.src='/images/mobiles-hub/uploading-soon-placeholder.svg';" />
                        </div>

                        <!-- Info -->
                        <div class="dk-mob-emi-info">
                            <h4 class="dk-mob-emi-name">@emiDeal.Name</h4>
                            <div class="dk-mob-emi-prices">
                                <span class="dk-mob-emi-selling">@emiDeal.PriceText</span>
                                @if (!string.IsNullOrWhiteSpace(emiDeal.OriginalPriceText))
                                {
                                    <span class="dk-mob-emi-strike">@emiDeal.OriginalPriceText</span>
                                }
                            </div>
                            <div class="dk-mob-emi-actions">
                                <button type="button" 
                                        class="dk-mob-emi-3d-btn"
                                        onclick="open3dModal('@emiDeal.Name', '@emiDeal.ColorHex', '@emiDeal.EmiText', '@emiDeal.PriceText')">
                                    3D View
                                </button>
                                <a href="@emiDeal.ProductUrl" class="dk-mob-emi-shop-btn">
                                    Buy Now
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

</div>

<!-- ========================================================
     8. INDUSTRY STANDARD 3D INTERACTIVE SMARTPHONE VIEWER MODAL
     (Google Model-Viewer & Three.js 360° Realtime Rendering)
========================================================= -->
<div class="dk-3d-modal-backdrop" id="dk3dModalBackdrop" style="display: none;">
    <div class="dk-3d-modal-container" role="dialog" aria-modal="true" aria-labelledby="modalPhoneTitle">
        
        <!-- Modal Top Bar -->
        <div class="dk-3d-modal-header">
            <div class="dk-3d-header-left">
                <span class="dk-3d-badge-live">● 3D LIVE ENGINE</span>
                <h3 class="dk-3d-modal-title" id="modalPhoneTitle">Interactive 3D Phone Inspection</h3>
                <span class="dk-3d-modal-sub" id="modalPhoneSub">Snapdragon 8 Gen 3 &bull; 200MP Camera &bull; 7200mAh</span>
            </div>
            <div class="dk-3d-header-right">
                <span class="dk-3d-price-tag" id="modalPhonePrice">From ₹11,999*</span>
                <button type="button" class="dk-3d-close-btn" onclick="close3dModal()" aria-label="Close 3D View">&times;</button>
            </div>
        </div>

        <!-- 3D Canvas Stage & Controls -->
        <div class="dk-3d-stage-wrapper">
            
            <!-- Three.js Canvas Container -->
            <div id="threeJsContainer" class="dk-3d-viewport"></div>

            <!-- Optional Google Model-Viewer for Custom .glb/.gltf models -->
            <model-viewer id="googleModelViewer" 
                          style="display: none; width: 100%; height: 100%;"
                          camera-controls 
                          auto-rotate 
                          ar 
                          shadow-intensity="1" 
                          exposure="1" 
                          alt="3D Smartphone Model">
            </model-viewer>

            <!-- Floating 3D Interaction Control Overlay -->
            <div class="dk-3d-floating-controls">
                <div class="dk-3d-control-group">
                    <button type="button" class="dk-3d-ctrl-btn" id="btn3dAutoRotate" onclick="toggle3dRotation()" title="Toggle Auto Rotation">
                        🔄 Auto Rotate
                    </button>
                    <button type="button" class="dk-3d-ctrl-btn" onclick="set3dView('front')" title="Front View">
                        📱 Front Face
                    </button>
                    <button type="button" class="dk-3d-ctrl-btn" onclick="set3dView('back')" title="Back View">
                        📸 Back Cameras
                    </button>
                    <button type="button" class="dk-3d-ctrl-btn" onclick="set3dView('side')" title="Side Profile">
                        📏 Side Profile
                    </button>
                    <button type="button" class="dk-3d-ctrl-btn" onclick="set3dView('iso')" title="Isometric 3D">
                        🌐 3D Angle
                    </button>
                </div>

                <!-- Zoom Controls -->
                <div class="dk-3d-zoom-group">
                    <button type="button" class="dk-3d-ctrl-btn" onclick="zoom3d(0.85)" title="Zoom In">➕</button>
                    <button type="button" class="dk-3d-ctrl-btn" onclick="zoom3d(1.15)" title="Zoom Out">➖</button>
                    <button type="button" class="dk-3d-ctrl-btn" onclick="reset3dCamera()" title="Reset Angle">↺ Reset</button>
                </div>
            </div>

            <!-- Color Variant Selector -->
            <div class="dk-3d-color-picker">
                <span class="dk-3d-color-label">Chassis Color:</span>
                <div class="dk-3d-color-swatches">
                    <button type="button" class="dk-3d-swatch active" style="background: #2563eb;" onclick="change3dColor('#2563eb', this)" title="Titanium Blue"></button>
                    <button type="button" class="dk-3d-swatch" style="background: #0f172a;" onclick="change3dColor('#0f172a', this)" title="Phantom Black"></button>
                    <button type="button" class="dk-3d-swatch" style="background: #059669;" onclick="change3dColor('#059669', this)" title="Emerald Green"></button>
                    <button type="button" class="dk-3d-swatch" style="background: #ea580c;" onclick="change3dColor('#ea580c', this)" title="Sunset Gold"></button>
                    <button type="button" class="dk-3d-swatch" style="background: #e2e8f0;" onclick="change3dColor('#e2e8f0', this)" title="Titanium Silver"></button>
                </div>
            </div>

            <!-- Drag to Rotate Instruction Hint -->
            <div class="dk-3d-hint-pill">
                <span>🖱️ Drag to rotate 360° &bull; Scroll to Zoom &bull; Touch friendly</span>
            </div>
        </div>

        <!-- Modal Bottom Actions -->
        <div class="dk-3d-modal-footer">
            <span class="dk-3d-footer-info">Inspecting high fidelity 3D mesh model with specular shine &amp; realistic camera bump reflections.</span>
            <div class="dk-3d-footer-btns">
                <button type="button" class="dk-mob-btn-secondary" onclick="close3dModal()">Close 3D View</button>
                <a href="/products?category=mobiles" class="dk-mob-btn-primary" id="modalBuyLink">Buy This Smartphone Now &rarr;</a>
            </div>
        </div>

    </div>
</div>

<!-- ========================================================
     CSS STYLING: HIGH-END FLIPKART MOBILES TEMPLATE
========================================================= -->
<style>
/* Root Hub Configuration */
.dk-mobiles-hub-root {
    width: 100%;
