<style>
/* ========================================================
   BOOKSFLIX NETFLIX THEME STYLES
   Dark palette: #141414, #181818, Red: #E50914, White: #FFF
   ======================================================== */
.sbf-netflix-container {
    background-color: #141414;
    color: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    min-height: 100vh;
    padding-bottom: 60px;
    position: relative;
    box-sizing: border-box;
}

.sbf-netflix-container *, .sbf-netflix-container *::before, .sbf-netflix-container *::after {
    box-sizing: inherit;
}

/* Netflix Sticky Sub-Navbar */
.sbf-subnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 40px;
    background: linear-gradient(180deg, rgba(20,20,20,0.98) 0%, rgba(20,20,20,0.9) 70%, rgba(20,20,20,0.7) 100%);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sbf-subnav-left {
    display: flex;
    align-items: center;
    gap: 32px;
}

.sbf-brand-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
}

.sbf-brand-n {
    color: #E50914;
    font-size: 26px;
    font-weight: 900;
    font-family: "Impact", "Arial Black", sans-serif;
    letter-spacing: -1px;
    text-shadow: 0 2px 8px rgba(229, 9, 20, 0.4);
}

.sbf-brand-title {
    color: #E50914;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.sbf-nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 20px;
}

.sbf-tab-btn {
    background: none;
    border: none;
    color: #E5E5E5;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    padding: 6px 4px;
    transition: color 0.2s ease, font-weight 0.2s ease;
    outline: none;
    position: relative;
}

.sbf-tab-btn:hover {
    color: #FFFFFF;
}

.sbf-tab-btn.active {
    color: #FFFFFF;
    font-weight: 700;
}

.sbf-tab-btn.active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: #E50914;
    border-radius: 2px;
}

/* Sub-Nav Right */
.sbf-subnav-right {
    display: flex;
    align-items: center;
    gap: 16px;
}

.sbf-search-box {
