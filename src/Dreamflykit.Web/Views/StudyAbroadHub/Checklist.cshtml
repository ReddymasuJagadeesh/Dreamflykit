<!-- ========================================================
     CLIENT-SIDE INTERACTIVE CHECKLIST LOGIC
========================================================= -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        restoreCheckedState();
        recalculateProgress();
        highlightDestinationCountry(document.getElementById("destinationSelect")?.value || "USA");
    });

    function onCheckItemToggle(chk) {
        const catId = chk.dataset.catId;
        saveCheckedState();
        recalculateProgress();
        updateCategoryCounter(catId);
    }

    function recalculateProgress() {
        const allBoxes = document.querySelectorAll(".dk-chk-box-input");
        const total = allBoxes.length;
        let checked = 0;
        allBoxes.forEach(b => { if (b.checked) checked++; });

        const pct = total > 0 ? Math.round((checked / total) * 100) : 0;

        const countCheckedEl = document.getElementById("chkCountChecked");
        const countTotalEl = document.getElementById("chkCountTotal");
        const progressBar = document.getElementById("chkProgressBar");
        const pctNumber = document.getElementById("chkPctNumber");

        if (countCheckedEl) countCheckedEl.textContent = checked;
        if (countTotalEl) countTotalEl.textContent = total;
        if (progressBar) progressBar.style.width = pct + "%";
        if (pctNumber) pctNumber.textContent = pct + "%";
    }

    function updateCategoryCounter(catId) {
        if (!catId) return;
        const catBoxes = document.querySelectorAll(`.dk-chk-box-input[data-cat-id="${catId}"]`);
        const total = catBoxes.length;
        let checked = 0;
        catBoxes.forEach(b => { if (b.checked) checked++; });

        const counterSpan = document.getElementById(`cat-counter-${catId}`);
        if (counterSpan) {
            counterSpan.textContent = `${checked} of ${total} items checked`;
        }
    }

    function toggleViewAllCat(catId, totalCount) {
        const hiddenDiv = document.getElementById(`hidden_items_${catId}`);
        const btn = document.getElementById(`btn_view_all_${catId}`);
        if (!hiddenDiv || !btn) return;

        if (hiddenDiv.style.display === "none" || hiddenDiv.style.display === "") {
            hiddenDiv.style.display = "flex";
            hiddenDiv.style.flexDirection = "column";
            hiddenDiv.style.gap = "8px";
            hiddenDiv.style.marginTop = "8px";
            btn.textContent = "Show Less ↑";
        } else {
            hiddenDiv.style.display = "none";
            btn.textContent = `View All (${totalCount}) ↓`;
        }
    }

    function onDestinationChange(country) {
        highlightDestinationCountry(country);
    }

    function highlightDestinationCountry(country) {
        const items = document.querySelectorAll(".dk-chk-guide-country-item");
        items.forEach(el => el.classList.remove("highlighted"));
        const target = document.getElementById(`guide_country_${country.toLowerCase()}`);
        if (target) {
            target.classList.add("highlighted");
        }
    }

    const STORAGE_KEY = "dk_abroad_checklist_state_v1";

    function saveCheckedState() {
        const checkedMap = {};
        document.querySelectorAll(".dk-chk-box-input").forEach(b => {
            if (b.checked && b.dataset.itemId) {
                checkedMap[b.dataset.itemId] = true;
            }
        });
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(checkedMap));
        } catch (e) {
            // ignore storage quota issues
        }
    }

    function restoreCheckedState() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return;
            const checkedMap = JSON.parse(raw);
            document.querySelectorAll(".dk-chk-box-input").forEach(b => {
                if (b.dataset.itemId && checkedMap[b.dataset.itemId] !== undefined) {
                    b.checked = !!checkedMap[b.dataset.itemId];
                }
            });
            // Update individual category counters
            document.querySelectorAll(".dk-chk-cat-card").forEach(c => {
                updateCategoryCounter(c.dataset.catId);
            });
        } catch (e) {
            // ignore JSON parse issues
        }
    }
</script>
