@* Client-Side Filtering & Interactivity Engine *@
<script>
function filterItemProducts() {
    var cards = document.querySelectorAll('.dk-sub-prod-card');
    var activeChipsContainer = document.getElementById('itemActiveChips');
    var resultsCountEl = document.getElementById('itemResultsCount');
    var emptyState = document.getElementById('itemEmptyState');

    // 1. Gather Selected Filters
    var selectedSizes = Array.from(document.querySelectorAll('.dk-size-checkbox:checked')).map(function(c) { return c.value.toLowerCase(); });
    var selectedAttrs = Array.from(document.querySelectorAll('.dk-attr-checkbox:checked')).map(function(c) { return c.value.toLowerCase(); });
    var selectedColors = Array.from(document.querySelectorAll('.dk-color-checkbox:checked')).map(function(c) { return c.value.toLowerCase(); });

    var priceRadio = document.querySelector('input[name="itemPriceRange"]:checked')?.value || 'all';
    var minPriceInput = parseFloat(document.getElementById('itemMinPrice')?.value) || 0;
    var maxPriceInput = parseFloat(document.getElementById('itemMaxPrice')?.value) || 999999;

    var minDiscount = parseFloat(document.querySelector('input[name="itemDiscount"]:checked')?.value) || 0;
    var minRating = parseFloat(document.querySelector('input[name="itemRating"]:checked')?.value) || 0;
    var inStockOnly = document.getElementById('itemInStockOnly')?.checked ?? false;

    // 2. Filter Cards
    var visibleCount = 0;
    cards.forEach(function(card) {
        var cardPrice = parseFloat(card.getAttribute('data-price')) || 0;
        var cardDiscount = parseFloat(card.getAttribute('data-discount')) || 0;
        var cardRating = parseFloat(card.getAttribute('data-rating')) || 0;
        var cardInStock = card.getAttribute('data-instock') === 'true';
        var cardSizes = (card.getAttribute('data-sizes') || '').toLowerCase();
        var cardColors = (card.getAttribute('data-colors') || '').toLowerCase();
        var cardName = (card.getAttribute('data-name') || '').toLowerCase();

        var matches = true;

        // Stock check
        if (inStockOnly && !cardInStock) matches = false;

        // Rating check
        if (cardRating < minRating) matches = false;

        // Discount check
        if (cardDiscount < minDiscount) matches = false;

        // Price range check
        if (priceRadio !== 'all') {
            var parts = priceRadio.split('-');
            var pMin = parseFloat(parts[0]) || 0;
            var pMax = parseFloat(parts[1]) || 999999;
            if (cardPrice < pMin || cardPrice > pMax) matches = false;
        } else if (minPriceInput > 0 || maxPriceInput < 999999) {
            if (cardPrice < minPriceInput || cardPrice > maxPriceInput) matches = false;
        }

        // Size check
        if (selectedSizes.length > 0) {
            var sizeMatch = selectedSizes.some(function(s) { return cardSizes.includes(s) || cardName.includes(s); });
            if (!sizeMatch) matches = false;
        }

        // Attributes check (e.g. frame shape, movement, heel type)
        if (selectedAttrs.length > 0) {
            var attrMatch = selectedAttrs.some(function(a) { 
                return cardName.includes(a) || cardSizes.includes(a) || cardColors.includes(a); 
            });
            if (!attrMatch) matches = false;
        }

        // Color check
        if (selectedColors.length > 0) {
            var colorMatch = selectedColors.some(function(c) { return cardColors.includes(c) || cardName.includes(c); });
            if (!colorMatch) matches = false;
        }

        if (matches) {
            card.style.display = '';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });

    // 3. Sort Cards
    var sortSelect = document.getElementById('itemSortSelect')?.value || 'relevance';
    var grid = document.getElementById('itemProductsGrid');
    if (grid) {
        var cardArr = Array.from(cards);
        cardArr.sort(function(a, b) {
            var priceA = parseFloat(a.getAttribute('data-price')) || 0;
            var priceB = parseFloat(b.getAttribute('data-price')) || 0;
            var ratingA = parseFloat(a.getAttribute('data-rating')) || 0;
            var ratingB = parseFloat(b.getAttribute('data-rating')) || 0;
            var discA = parseFloat(a.getAttribute('data-discount')) || 0;
            var discB = parseFloat(b.getAttribute('data-discount')) || 0;

            if (sortSelect === 'price-low') return priceA - priceB;
            if (sortSelect === 'price-high') return priceB - priceA;
            if (sortSelect === 'rating') return ratingB - ratingA;
            if (sortSelect === 'discount') return discB - discA;
            return 0; // relevance
        });
        cardArr.forEach(function(c) { grid.appendChild(c); });
    }

    // 4. Update Header & Empty State
    if (resultsCountEl) {
        resultsCountEl.innerHTML = 'Showing <strong>' + visibleCount + '</strong> products';
    }
    if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // 5. Update Active Chips
    if (activeChipsContainer) {
        activeChipsContainer.innerHTML = '';
        selectedSizes.forEach(function(s) {
            var chip = document.createElement('span');
            chip.className = 'dk-active-chip';
            chip.innerHTML = s.toUpperCase() + ' <span class="dk-chip-remove" onclick="removeFilter(\'size\', \'' + s + '\')">&times;</span>';
            activeChipsContainer.appendChild(chip);
        });
        selectedAttrs.forEach(function(a) {
            var chip = document.createElement('span');
            chip.className = 'dk-active-chip';
            chip.innerHTML = a + ' <span class="dk-chip-remove" onclick="removeFilter(\'attr\', \'' + a + '\')">&times;</span>';
            activeChipsContainer.appendChild(chip);
        });
        selectedColors.forEach(function(c) {
            var chip = document.createElement('span');
            chip.className = 'dk-active-chip';
            chip.innerHTML = c + ' <span class="dk-chip-remove" onclick="removeFilter(\'color\', \'' + c + '\')">&times;</span>';
            activeChipsContainer.appendChild(chip);
        });
    }
}

function removeFilter(type, value) {
    if (type === 'size') {
        document.querySelectorAll('.dk-size-checkbox').forEach(function(cb) {
            if (cb.value.toLowerCase() === value.toLowerCase()) cb.checked = false;
        });
    } else if (type === 'attr') {
        document.querySelectorAll('.dk-attr-checkbox').forEach(function(cb) {
            if (cb.value.toLowerCase() === value.toLowerCase()) cb.checked = false;
        });
    } else if (type === 'color') {
        document.querySelectorAll('.dk-color-checkbox').forEach(function(cb) {
            if (cb.value.toLowerCase() === value.toLowerCase()) cb.checked = false;
        });
    }
    filterItemProducts();
}

function resetItemFilters() {
    document.querySelectorAll('.dk-size-checkbox').forEach(function(cb) { cb.checked = false; });
    document.querySelectorAll('.dk-attr-checkbox').forEach(function(cb) { cb.checked = false; });
    document.querySelectorAll('.dk-color-checkbox').forEach(function(cb) { cb.checked = false; });

    var allPricesRadio = document.querySelector('input[name="itemPriceRange"][value="all"]');
    if (allPricesRadio) allPricesRadio.checked = true;

    var allDiscountsRadio = document.querySelector('input[name="itemDiscount"][value="0"]');
    if (allDiscountsRadio) allDiscountsRadio.checked = true;

    var allRatingsRadio = document.querySelector('input[name="itemRating"][value="0"]');
    if (allRatingsRadio) allRatingsRadio.checked = true;

    var minP = document.getElementById('itemMinPrice');
    if (minP) minP.value = '';
    var maxP = document.getElementById('itemMaxPrice');
    if (maxP) maxP.value = '';

    var stockCb = document.getElementById('itemInStockOnly');
    if (stockCb) stockCb.checked = true;

    filterItemProducts();
}

function setItemLayout(mode, btn) {
    var grid = document.getElementById('itemProductsGrid');
    if (!grid) return;
    document.querySelectorAll('.dk-view-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');

    if (mode === 'list') {
        grid.classList.add('list-view');
    } else {
        grid.classList.remove('list-view');
    }
}

function toggleSubWishlist(btn, ev) {
    ev.preventDefault();
    ev.stopPropagation();
    btn.classList.toggle('active');
    var isActive = btn.classList.contains('active');
    btn.style.color = isActive ? '#ef4444' : '#64748b';
}

function quickAddItemToCart(prodId, prodName, price, btn) {
    var origText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '✓ Added!';
    btn.style.background = '#16a34a';

    setTimeout(function() {
        btn.disabled = false;
        btn.innerHTML = origText;
        btn.style.background = '';
    }, 1500);
}
</script>

