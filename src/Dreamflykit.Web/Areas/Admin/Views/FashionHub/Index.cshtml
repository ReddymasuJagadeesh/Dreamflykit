<script>
document.addEventListener("DOMContentLoaded", function () {
    // 1. Tab Switching
    const tabBtns = document.querySelectorAll(".dk-tab-btn");
    const tabPanes = document.querySelectorAll(".dk-tab-pane");

    tabBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            tabBtns.forEach(b => b.classList.remove("active"));
            tabPanes.forEach(p => p.classList.remove("active"));
            btn.classList.add("active");
            const targetId = btn.getAttribute("data-tab");
            const targetPane = document.getElementById(targetId);
            if (targetPane) targetPane.classList.add("active");
            if (history.replaceState) {
                history.replaceState(null, null, "#" + targetId);
            }
        });
    });

    // Check URL hash for direct tab opening (e.g. #tab-men-clothing)
    if (window.location.hash) {
        const hash = window.location.hash.substring(1);
        const matchingBtn = document.querySelector(`.dk-tab-btn[data-tab="${hash}"]`);
        if (matchingBtn) {
            matchingBtn.click();
        }
    }

    // 2. Hero File Upload
    const heroFileInput = document.getElementById("heroFileInput");
    if (heroFileInput) {
        heroFileInput.addEventListener("change", async function () {
            if (!this.files || this.files.length === 0) return;
            const file = this.files[0];
            const formData = new FormData();
            formData.append("file", file);
            formData.append("targetField", "heroBanner");
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
            formData.append("__RequestVerificationToken", token);

            showAlert("Uploading hero banner image...", "info");

            try {
                const res = await fetch("/Admin/FashionHub/UploadImage", {
                    method: "POST",
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.url) {
                    document.getElementById("heroImageUrl").value = data.url;
                    document.getElementById("heroImagePreview").src = data.url;
                    showAlert("Hero banner image uploaded successfully! Don't forget to click Save All Changes.", "success");
                } else {
                    showAlert("Upload failed: " + (data.message || "Unknown error"), "error");
                }
            } catch (err) {
                showAlert("Network or upload error: " + err.message, "error");
            }
        });
    }

    // 3. Men Clothing Hero Photo Upload
    const menHeroFileInput = document.getElementById("menHeroFileInput");
    if (menHeroFileInput) {
        menHeroFileInput.addEventListener("change", async function () {
            if (!this.files || this.files.length === 0) return;
            const file = this.files[0];
            const formData = new FormData();
            formData.append("file", file);
            formData.append("targetField", "menHeroBanner");
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
            formData.append("__RequestVerificationToken", token);

            showAlert("Uploading Men Clothing hero banner photo...", "info");

            try {
                const res = await fetch("/Admin/FashionHub/UploadImage", {
                    method: "POST",
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.url) {
                    document.getElementById("menHeroImageUrl").value = data.url;
                    document.getElementById("menHeroImagePreview").src = data.url;
                    document.getElementById("menHeroIsUploadingSoon").checked = false;
                    showAlert("Men Clothing photo uploaded successfully! Don't forget to click Save All Changes.", "success");
                } else {
                    showAlert("Upload failed: " + (data.message || "Unknown error"), "error");
                }
            } catch (err) {
                showAlert("Network or upload error: " + err.message, "error");
            }
        });
    }

    // Live URL Preview on typing
    const heroImageUrlInput = document.getElementById("heroImageUrl");
    if (heroImageUrlInput) {
        heroImageUrlInput.addEventListener("input", function () {
            const val = this.value.trim();
            if (val) {
                document.getElementById("heroImagePreview").src = val;
            }
        });
    }

    const menHeroImageUrlInput = document.getElementById("menHeroImageUrl");
    if (menHeroImageUrlInput) {
        menHeroImageUrlInput.addEventListener("input", function () {
            const val = this.value.trim();
            if (val) {
                document.getElementById("menHeroImagePreview").src = val;
            }
        });
    }

    // Save buttons
    document.getElementById("btnSaveHubHeader")?.addEventListener("click", saveFashionHub);
    document.getElementById("btnSaveHubFooter")?.addEventListener("click", saveFashionHub);
});

function setHeroDefaultImage() {
    const defaultUrl = "/images/fashion-hub/fashion_hero_banner.jpg";
    document.getElementById("heroImageUrl").value = defaultUrl;
    document.getElementById("heroImagePreview").src = defaultUrl;
    document.getElementById("heroIsUploadingSoon").checked = false;
}

function setMenHeroDefaultImage() {
    const defaultUrl = "/images/fashion-hub/men_clothing_hero.jpg";
    document.getElementById("menHeroImageUrl").value = defaultUrl;
    document.getElementById("menHeroImagePreview").src = defaultUrl;
    document.getElementById("menHeroIsUploadingSoon").checked = false;
}

