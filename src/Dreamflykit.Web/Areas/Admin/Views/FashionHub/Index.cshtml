function showAlert(msg, type) {
    const box = document.getElementById("ajaxAlertBox");
    if (!box) return;
    box.style.display = "block";
    box.className = "dk-alert " + (type === "success" ? "dk-alert-success" : (type === "error" ? "dk-alert-error" : ""));
    box.innerHTML = msg;
    if (type === "success") {
        setTimeout(() => { box.style.display = "none"; }, 5000);
    }
}

async function saveFashionHub() {
    showAlert("Saving all Fashion Category Hub changes...", "info");

    // Gather Badges
    const badges = [];
    document.querySelectorAll("#heroBadgesContainer .dk-badge-edit-card").forEach(el => {
        badges.push({
            id: el.getAttribute("data-badge-id") || "",
            label: el.querySelector(".badge-label")?.value || "",
            icon: el.querySelector(".badge-icon")?.value || "shirt",
            isActive: el.querySelector(".badge-active")?.checked ?? true
        });
    });

    // Gather Right Features
    const features = [];
    document.querySelectorAll("#rightFeaturesContainer .dk-feat-edit-card").forEach(el => {
        features.push({
            id: el.getAttribute("data-feat-id") || "",
            title: el.querySelector(".feat-title")?.value || "",
            icon: el.querySelector(".feat-icon")?.value || "luggage",
            isActive: el.querySelector(".feat-active")?.checked ?? true
        });
    });

    // Gather Categories
    const categories = [];
    document.querySelectorAll("#categoryRowsContainer .dk-item-row").forEach(el => {
        categories.push({
            id: el.getAttribute("data-id") || "",
            name: el.querySelector(".cat-name")?.value || "",
            slug: el.querySelector(".cat-slug")?.value || "",
            imageUrl: el.querySelector(".cat-image-url")?.value || "",
            displayOrder: parseInt(el.querySelector(".cat-order")?.value || "0"),
            isUploadingSoon: el.querySelector(".cat-soon")?.checked ?? true,
            isActive: el.querySelector(".cat-active")?.checked ?? true
        });
    });

    // Gather Products
    const products = [];
    document.querySelectorAll("#productRowsContainer .dk-item-row").forEach(el => {
        products.push({
            id: el.getAttribute("data-id") || "",
            name: el.querySelector(".prod-name")?.value || "",
            categoryName: "Fashion",
            price: parseFloat(el.querySelector(".prod-price")?.value || "0"),
            originalPrice: el.querySelector(".prod-orig-price")?.value ? parseFloat(el.querySelector(".prod-orig-price").value) : null,
            rating: parseFloat(el.querySelector(".prod-rating")?.value || "4.8"),
            reviewsCount: parseInt(el.querySelector(".prod-reviews")?.value || "50"),
            imageUrl: el.querySelector(".prod-image-url")?.value || "",
            productUrl: el.querySelector(".prod-url")?.value || "/products?category=fashion",
            isUploadingSoon: el.querySelector(".prod-soon")?.checked ?? true,
            isActive: el.querySelector(".prod-active")?.checked ?? true
        });
    });

    // Gather Trust Badges
    const trustBadges = [];
    document.querySelectorAll("#trustBadgesContainer .dk-trust-edit-card").forEach(el => {
        trustBadges.push({
            id: el.getAttribute("data-id") || "",
            title: el.querySelector(".trust-title")?.value || "",
            subtitle: el.querySelector(".trust-sub")?.value || "",
            icon: el.querySelector(".trust-icon")?.value || "box",
            isActive: el.querySelector(".trust-active")?.checked ?? true
        });
    });

    // Build Payload
    const payload = {
        heroBanner: {
            isEnabled: document.getElementById("heroIsEnabled")?.checked ?? true,
            title: document.getElementById("heroTitle")?.value || "Fashion for",
            titleHighlight: document.getElementById("heroTitleHighlight")?.value || "Every Journey",
            titleColor: document.getElementById("heroTitleColor")?.value || "#063f91",
            titleHighlightColor: document.getElementById("heroTitleHighlightColor")?.value || "#ea580c",
            subtitle: document.getElementById("heroSubtitle")?.value || "",
            subtitleColor: document.getElementById("heroSubtitleColor")?.value || "#334155",
            badgeBgColor: document.getElementById("heroBadgeBgColor")?.value || "rgba(255, 255, 255, 0.94)",
            badgeTextColor: document.getElementById("heroBadgeTextColor")?.value || "#0f172a",
            bannerHeight: parseInt(document.getElementById("heroBannerHeight")?.value || "440"),
            imageUrl: document.getElementById("heroImageUrl")?.value || "",
            isUploadingSoon: document.getElementById("heroIsUploadingSoon")?.checked ?? false,
            badges: badges,
            rightCard: {
                title: document.getElementById("rightCardTitle")?.value || "Look Good.",
                titleHighlight: document.getElementById("rightCardTitleHighlight")?.value || "Travel Smart.",
                features: features
            }
        },
        categoriesSection: {
            isEnabled: document.getElementById("categoriesIsEnabled")?.checked ?? true,
            title: document.getElementById("categoriesTitle")?.value || "Shop by Category",
            viewAllUrl: document.getElementById("categoriesViewAllUrl")?.value || "/products?category=fashion",
            viewAllText: "View All Categories →",
            categories: categories
        },
        topPicksSection: {
            isEnabled: document.getElementById("picksIsEnabled")?.checked ?? true,
            title: document.getElementById("picksTitle")?.value || "Top Picks for Men & Women",
            viewAllUrl: document.getElementById("picksViewAllUrl")?.value || "/products?category=fashion",
            viewAllText: "View All Products →",
            products: products
        },
        trustBadgesSection: {
            isEnabled: document.getElementById("trustIsEnabled")?.checked ?? true,
            badges: trustBadges
        },
        bottomBanner: {
            isEnabled: document.getElementById("bottomIsEnabled")?.checked ?? true,
            quizTitle: document.getElementById("bottomQuizTitle")?.value || "",
            quizSubtitle: document.getElementById("bottomQuizSub")?.value || "",
            quizButtonText: document.getElementById("bottomQuizBtnText")?.value || "Find My Kit",
            quizButtonUrl: document.getElementById("bottomQuizBtnUrl")?.value || "/find-my-kit",
            destinationsTitle: document.getElementById("bottomDestTitle")?.value || "",
            destinationsSubtitle: document.getElementById("bottomDestSub")?.value || "",
            bulkTitle: document.getElementById("bottomBulkTitle")?.value || "",
            bulkSubtitle: document.getElementById("bottomBulkSub")?.value || "",
            bulkButtonText: document.getElementById("bottomBulkBtnText")?.value || "Contact Us",
            bulkButtonUrl: document.getElementById("bottomBulkBtnUrl")?.value || "/contact"
        }
    };

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

    try {
        const response = await fetch("/Admin/FashionHub/Save", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token,
                "X-Requested-With": "XMLHttpRequest"
            },
            body: JSON.stringify(payload)
        });

        const result = await response.json();
        if (result.success) {
            showAlert("✓ " + (result.message || "Fashion Category Hub settings saved successfully!"), "success");
        } else {
            showAlert("⚠ Save failed: " + (result.message || "Unknown error"), "error");
        }
    } catch (err) {
        showAlert("⚠ Network or server error: " + err.message, "error");
    }
}
</script>
