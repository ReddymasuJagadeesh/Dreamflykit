<!-- ============================================================
     CLIENT-SIDE INTERACTIVE FILTER ENGINE
============================================================ -->
<script>
    function toggleAppFilterGroup(el) {
        var card = el.closest(".dk-filter-group-card");
        if (card) card.classList.toggle("collapsed");
    }

    function applyAppBrandFilters() {
        var cbs = document.querySelectorAll(".app-brand-filter-cb:checked");
        var activeFilters = {};

        cbs.forEach(function (cb) {
            var grp = cb.getAttribute("data-group");
            var val = cb.getAttribute("data-val");
            if (!activeFilters[grp]) activeFilters[grp] = [];
            activeFilters[grp].push(val);
        });

        renderAppActiveFilterTags(activeFilters);

        var cards = document.querySelectorAll(".dk-brand-prod-card");
        var visibleCount = 0;

        cards.forEach(function (card) {
            var match = true;

            for (var grp in activeFilters) {
                var selectedVals = activeFilters[grp];
                if (!selectedVals || selectedVals.length === 0) continue;

                var grpMatched = false;

                if (grp === "price") {
                    var price = parseFloat(card.getAttribute("data-price")) || 0;
                    for (var i = 0; i < selectedVals.length; i++) {
                        var pVal = selectedVals[i];
                        if (pVal === "under-25k" && price < 25000) grpMatched = true;
                        else if (pVal === "25k-50k" && price >= 25000 && price <= 50000) grpMatched = true;
                        else if (pVal === "above-50k" && price > 50000) grpMatched = true;
                        else if (pVal === "under-20k" && price < 20000) grpMatched = true;
                        else if (pVal === "20k-35k" && price >= 20000 && price <= 35000) grpMatched = true;
                        else if (pVal === "35k-50k" && price >= 35000 && price <= 50000) grpMatched = true;
                        else if (pVal === "under-30k" && price < 30000) grpMatched = true;
                        else if (pVal === "30k-45k" && price >= 30000 && price <= 45000) grpMatched = true;
                        else if (pVal === "45k-60k" && price >= 45000 && price <= 60000) grpMatched = true;
                        else if (pVal === "above-60k" && price > 60000) grpMatched = true;
                        else if (pVal === "under-8k" && price < 8000) grpMatched = true;
                        else if (pVal === "8k-15k" && price >= 8000 && price <= 15000) grpMatched = true;
                        else if (pVal === "under-5k" && price < 5000) grpMatched = true;
                        else if (pVal === "5k-15k" && price >= 5000 && price <= 15000) grpMatched = true;
                        else if (pVal === "under-2k" && price < 2000) grpMatched = true;
                        else if (pVal === "2k-5k" && price >= 2000 && price <= 5000) grpMatched = true;
                        else if (pVal === "under-4k" && price < 4000) grpMatched = true;
                        else if (pVal === "4k-8k" && price >= 4000 && price <= 8000) grpMatched = true;
                        else if (pVal === "above-8k" && price > 8000) grpMatched = true;
                        else if (pVal === "under-35k" && price < 35000) grpMatched = true;
                        else if (pVal === "35k-50k" && price >= 35000 && price <= 50000) grpMatched = true;
                        if (grpMatched) break;
                    }
                } else {
                    var cardVal = (card.getAttribute("data-" + grp) || "").toLowerCase();
                    for (var i = 0; i < selectedVals.length; i++) {
                        var sv = selectedVals[i];
                        if (cardVal.indexOf(sv) !== -1 || sv.indexOf(cardVal) !== -1) {
                            grpMatched = true;
                            break;
                        }
                    }
                }

                if (!grpMatched) {
                    match = false;
                    break;
                }
            }

            if (match) {
                card.style.display = "flex";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });

        // Update counts & empty state
        var lblCount = document.getElementById("lblVisibleCount");
        if (lblCount) lblCount.textContent = visibleCount;

        var emptyBox = document.getElementById("emptyBrandState");
        var gridBox = document.getElementById("brandProductsGrid");
        if (emptyBox && gridBox) {
            if (visibleCount === 0) {
                emptyBox.style.display = "block";
            } else {
                emptyBox.style.display = "none";
            }
        }
    }

    function renderAppActiveFilterTags(activeFilters) {
        var container = document.getElementById("activeFilterTags");
        if (!container) return;
        container.innerHTML = "";

        for (var grp in activeFilters) {
            var vals = activeFilters[grp];
            for (var i = 0; i < vals.length; i++) {
                var val = vals[i];
                var pill = document.createElement("span");
                pill.className = "dk-active-pill";
                pill.innerHTML = '<span>' + val.toUpperCase() + '</span><button type="button" class="dk-active-remove" onclick="removeAppBrandFilter('' + grp + '', '' + val + '')">✕</button>';
                container.appendChild(pill);
            }
        }
    }

    function removeAppBrandFilter(grp, val) {
        var cb = document.querySelector('.app-brand-filter-cb[data-group="' + grp + '"][data-val="' + val + '"]');
        if (cb) {
            cb.checked = false;
            applyAppBrandFilters();
        }
    }

    function clearAllAppBrandFilters() {
        var cbs = document.querySelectorAll(".app-brand-filter-cb");
        cbs.forEach(function (cb) { cb.checked = false; });
        applyAppBrandFilters();
    }

    function sortAppBrandProducts(opt) {
        var grid = document.getElementById("brandProductsGrid");
        if (!grid) return;
        var cards = Array.from(grid.querySelectorAll(".dk-brand-prod-card"));

        cards.sort(function (a, b) {
            var priceA = parseFloat(a.getAttribute("data-price")) || 0;
            var priceB = parseFloat(b.getAttribute("data-price")) || 0;
            var ratingA = parseFloat(a.getAttribute("data-rating")) || 0;
            var ratingB = parseFloat(b.getAttribute("data-rating")) || 0;
            var discountA = parseFloat(a.getAttribute("data-discount")) || 0;
            var discountB = parseFloat(b.getAttribute("data-discount")) || 0;

            if (opt === "price-asc") return priceA - priceB;
            if (opt === "price-desc") return priceB - priceA;
            if (opt === "rating-desc") return ratingB - ratingA;
            if (opt === "discount-desc") return discountB - discountA;
            return 0; // relevance
        });

        cards.forEach(function (card) { grid.appendChild(card); });
    }

    function handleAppBrandAddToCart(prodId, prodName, price, btn) {
        var originalHtml = btn.innerHTML;
        btn.innerHTML = '<span>Adding...</span>';
        btn.disabled = true;

        setTimeout(function () {
            btn.innerHTML = '<span>✓ Added!</span>';
            btn.style.background = "#10b981";

            showAppBrandToast(prodName);

            // Update global cart badge if present
            var badge = document.querySelector(".dk-cart-badge, .dk-header-action-badge");
            if (badge) {
                var current = parseInt(badge.textContent, 10) || 0;
                badge.textContent = current + 1;
                badge.style.display = "inline-flex";
            }

            setTimeout(function () {
                btn.innerHTML = originalHtml;
                btn.style.background = "";
                btn.disabled = false;
            }, 1800);
        }, 400);
    }

    function showAppBrandToast(name) {
        var toast = document.getElementById("brandCartToast");
        var title = document.getElementById("toastTitle");
        if (title) title.textContent = name;
        if (toast) {
            toast.style.display = "flex";
            setTimeout(function () {
                toast.style.display = "none";
            }, 4000);
        }
    }
</script>
