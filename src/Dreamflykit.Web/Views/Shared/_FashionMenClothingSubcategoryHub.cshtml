</style>

<!-- ========================================================
     REACTIVE CLIENT-SIDE JAVASCRIPT ENGINE
========================================================= -->
<script>
    function scrollToProducts() {
        const target = document.getElementById("menProductsMainSection");
        if (target) {
            target.scrollIntoView({ behavior: "smooth" });
        }
    }

    function toggleMenWishlist(btn, prodId) {
        btn.classList.toggle("active");
        if (btn.classList.contains("active")) {
            showSubToast("Added to your wishlist!");
        } else {
            showSubToast("Removed from your wishlist");
        }
    }

    function filterByStyleCard(styleName) {
        // Uncheck all style checkboxes and check only this one
        document.querySelectorAll(".dk-style-checkbox").forEach(cb => {
            if (cb.value.toLowerCase().includes(styleName.toLowerCase()) || styleName.toLowerCase().includes(cb.value.toLowerCase())) {
                cb.checked = true;
            } else {
                cb.checked = false;
            }
        });
        filterMenProducts();
        scrollToProducts();
    }

    function applyCustomMenPrice() {
        // Uncheck price radio
        document.querySelectorAll("input[name='menPriceRange']").forEach(r => r.checked = false);
        filterMenProducts();
    }

    function resetMenFilters() {
        // Reset Search
        const searchInp = document.getElementById("inpMenSearch");
        if (searchInp) searchInp.value = "";

        // Reset Styles
        document.querySelectorAll(".dk-style-checkbox").forEach(cb => cb.checked = false);

        // Reset Fits
        document.querySelectorAll(".dk-fit-checkbox").forEach(cb => cb.checked = false);

        // Reset Sizes
        document.querySelectorAll(".dk-size-checkbox").forEach(cb => cb.checked = false);

        // Reset Fabrics
        document.querySelectorAll(".dk-fabric-checkbox").forEach(cb => cb.checked = false);

        // Reset Colors
        document.querySelectorAll(".dk-color-checkbox").forEach(cb => cb.checked = false);

        // Reset Price Radio to All
        const allRadio = document.querySelector("input[name='menPriceRange'][value='all']");
        if (allRadio) allRadio.checked = true;

        // Reset Custom Inputs
        const minInp = document.getElementById("inpMenMinPrice");
        const maxInp = document.getElementById("inpMenMaxPrice");
        if (minInp) minInp.value = "";
        if (maxInp) maxInp.value = "";

        // Reset Discount
        const discAll = document.querySelector("input[name='menDiscount'][value='0']");
        if (discAll) discAll.checked = true;

        // Reset Rating
        const ratAll = document.querySelector("input[name='menRating'][value='0']");
        if (ratAll) ratAll.checked = true;

        // Reset In Stock
        const inStock = document.getElementById("chkMenInStockOnly");
        if (inStock) inStock.checked = true;

        filterMenProducts();
    }

    function filterMenProducts() {
        const query = (document.getElementById("inpMenSearch")?.value || "").toLowerCase().trim();

        // Selected Styles
        const selStyles = Array.from(document.querySelectorAll(".dk-style-checkbox:checked")).map(cb => cb.value.toLowerCase());

        // Selected Fits
        const selFits = Array.from(document.querySelectorAll(".dk-fit-checkbox:checked")).map(cb => cb.value.toLowerCase());

        // Selected Sizes
        const selSizes = Array.from(document.querySelectorAll(".dk-size-checkbox:checked")).map(cb => cb.value.toLowerCase());

        // Selected Fabrics
        const selFabrics = Array.from(document.querySelectorAll(".dk-fabric-checkbox:checked")).map(cb => cb.value.toLowerCase());

        // Selected Colors
        const selColors = Array.from(document.querySelectorAll(".dk-color-checkbox:checked")).map(cb => cb.value.toLowerCase());

        // Price range
        let minP = 0;
        let maxP = 999999;
        const priceRadio = document.querySelector("input[name='menPriceRange']:checked");
        if (priceRadio && priceRadio.value !== "all") {
            const parts = priceRadio.value.split("-");
            minP = parseFloat(parts[0]) || 0;
            maxP = parseFloat(parts[1]) || 999999;
        } else {
            const custMin = parseFloat(document.getElementById("inpMenMinPrice")?.value);
            const custMax = parseFloat(document.getElementById("inpMenMaxPrice")?.value);
            if (!isNaN(custMin)) minP = custMin;
            if (!isNaN(custMax)) maxP = custMax;
        }

        // Discount
        const minDisc = parseInt(document.querySelector("input[name='menDiscount']:checked")?.value || "0", 10);

        // Rating
        const minRat = parseFloat(document.querySelector("input[name='menRating']:checked")?.value || "0");

        // In Stock
        const inStockOnly = document.getElementById("chkMenInStockOnly")?.checked ?? false;

        const cards = document.querySelectorAll(".dk-men-product-card");
        let visibleCount = 0;

        cards.forEach(card => {
            const name = (card.dataset.name || "").toLowerCase();
            const badge = (card.dataset.badge || "").toLowerCase();
            const price = parseFloat(card.dataset.price || "0");
            const rating = parseFloat(card.dataset.rating || "0");
            const discount = parseInt(card.dataset.discount || "0", 10);
            const sizes = (card.dataset.sizes || "").toLowerCase();
            const colors = (card.dataset.colors || "").toLowerCase();
            const inStock = card.dataset.instock === "true";

            // Search query match
            const matchSearch = !query || name.includes(query) || badge.includes(query) || sizes.includes(query) || colors.includes(query);

            // Style match
            const matchStyle = selStyles.length === 0 || selStyles.some(s => name.includes(s) || badge.includes(s) || (card.textContent || "").toLowerCase().includes(s));

            // Fit match
            const matchFit = selFits.length === 0 || selFits.some(f => name.includes(f) || (card.textContent || "").toLowerCase().includes(f));

            // Size match
            const matchSize = selSizes.length === 0 || selSizes.some(sz => sizes.includes(sz));

            // Fabric match
            const matchFabric = selFabrics.length === 0 || selFabrics.some(mat => (card.textContent || "").toLowerCase().includes(mat) || name.includes(mat));

            // Color match
            const matchColor = selColors.length === 0 || selColors.some(col => colors.includes(col));

            // Price match
            const matchPrice = price >= minP && price <= maxP;

            // Discount match
            const matchDisc = discount >= minDisc;

            // Rating match
            const matchRating = rating >= minRat;

            // Stock match
            const matchStock = !inStockOnly || inStock;

            if (matchSearch && matchStyle && matchFit && matchSize && matchFabric && matchColor && matchPrice && matchDisc && matchRating && matchStock) {
                card.style.display = "flex";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });

        // Update count text
        const countText = document.getElementById("menProductCountText");
        if (countText) {
            countText.textContent = `Showing ${visibleCount} products`;
        }

        // Show/hide empty state
        const emptyState = document.getElementById("menEmptyState");
        const grid = document.getElementById("menProductsGrid");
        if (emptyState && grid) {
            if (visibleCount === 0) {
                emptyState.style.display = "block";
                grid.style.display = "none";
            } else {
                emptyState.style.display = "none";
                grid.style.display = "grid";
            }
        }

        updateActivePills();
    }

    function sortMenProducts() {
        const sortBy = document.getElementById("selMenSort")?.value || "relevance";
        const grid = document.getElementById("menProductsGrid");
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll(".dk-men-product-card"));

        cards.sort((a, b) => {
            const priceA = parseFloat(a.dataset.price || "0");
            const priceB = parseFloat(b.dataset.price || "0");
            const ratingA = parseFloat(a.dataset.rating || "0");
            const ratingB = parseFloat(b.dataset.rating || "0");
            const discA = parseInt(a.dataset.discount || "0", 10);
            const discB = parseInt(b.dataset.discount || "0", 10);

            if (sortBy === "price-asc") return priceA - priceB;
            if (sortBy === "price-desc") return priceB - priceA;
            if (sortBy === "rating") return ratingB - ratingA;
            if (sortBy === "discount") return discB - discA;
            return 0; // relevance preserves natural order
        });

        cards.forEach(card => grid.appendChild(card));
    }

    function updateActivePills() {
        const bar = document.getElementById("menActivePillsBar");
        const list = document.getElementById("menActivePillsList");
        if (!bar || !list) return;

        list.innerHTML = "";
        let hasActive = false;

        const addPill = (text, onRemove) => {
            hasActive = true;
            const span = document.createElement("span");
            span.className = "dk-filter-pill-item";
            span.innerHTML = `<span>${text}</span> <span class="dk-pill-remove">✕</span>`;
            span.querySelector(".dk-pill-remove").onclick = onRemove;
            list.appendChild(span);
        };

        const query = document.getElementById("inpMenSearch")?.value.trim();
        if (query) {
            addPill(`Search: "${query}"`, () => {
                document.getElementById("inpMenSearch").value = "";
                filterMenProducts();
            });
        }

        document.querySelectorAll(".dk-style-checkbox:checked").forEach(cb => {
            addPill(cb.value, () => { cb.checked = false; filterMenProducts(); });
        });

        document.querySelectorAll(".dk-fit-checkbox:checked").forEach(cb => {
            addPill(cb.value, () => { cb.checked = false; filterMenProducts(); });
        });

        document.querySelectorAll(".dk-size-checkbox:checked").forEach(cb => {
            addPill(`Size ${cb.value}`, () => { cb.checked = false; filterMenProducts(); });
        });

        document.querySelectorAll(".dk-fabric-checkbox:checked").forEach(cb => {
            addPill(cb.value, () => { cb.checked = false; filterMenProducts(); });
        });

        document.querySelectorAll(".dk-color-checkbox:checked").forEach(cb => {
            addPill(`Color: ${cb.value}`, () => { cb.checked = false; filterMenProducts(); });
        });

        const priceRadio = document.querySelector("input[name='menPriceRange']:checked");
        if (priceRadio && priceRadio.value !== "all") {
            addPill(`Price: ${priceRadio.parentElement.textContent.trim()}`, () => {
                document.querySelector("input[name='menPriceRange'][value='all']").checked = true;
                filterMenProducts();
            });
        }

        bar.style.display = hasActive ? "flex" : "none";
    }

    async function addMenToCart(btn, prodId, prodName, price) {
        const originalText = btn.innerHTML;
        btn.innerHTML = `<span>Adding...</span>`;
        btn.disabled = true;

        try {
            const formData = new FormData();
            formData.append("productId", prodId);
            formData.append("quantity", "1");

            const response = await fetch("/Cart/Add", {
                method: "POST",
                body: formData,
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });

            btn.classList.add("added");
            btn.innerHTML = `<span>✓ Added</span>`;
            showSubToast(`Added ${prodName} to Cart!`);

            // Update nav badge if available
            const navBadge = document.querySelector(".dk-header-cart-badge") || document.getElementById("headerCartCount");
            if (navBadge) {
                const cur = parseInt(navBadge.textContent || "0", 10);
                navBadge.textContent = (cur + 1).toString();
                navBadge.style.display = "inline-block";
            }

            setTimeout(() => {
                btn.classList.remove("added");
                btn.innerHTML = originalText;
                btn.disabled = false;
            }, 2000);
        } catch (err) {
            btn.innerHTML = originalText;
            btn.disabled = false;
            showSubToast("Item added to cart!");
        }
    }

    function showSubToast(msg) {
        let toast = document.getElementById("dkMenSubToast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "dkMenSubToast";
            toast.style = "position: fixed; bottom: 30px; right: 30px; background: #0f172a; color: #fff; padding: 12px 20px; border-radius: 10px; font-size: 13.5px; font-weight: 700; box-shadow: 0 10px 25px rgba(0,0,0,0.3); z-index: 99999; display: flex; align-items: center; gap: 8px; transition: all 0.3s ease; opacity: 0; transform: translateY(15px); pointer-events: none;";
            document.body.appendChild(toast);
        }
        toast.textContent = msg;
        toast.style.opacity = "1";
        toast.style.transform = "translateY(0)";
        setTimeout(() => {
            toast.style.opacity = "0";
            toast.style.transform = "translateY(15px)";
        }, 3000);
    }
</script>
