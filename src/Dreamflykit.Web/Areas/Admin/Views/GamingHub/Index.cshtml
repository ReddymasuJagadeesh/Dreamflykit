<!-- ========================================================
     ADMIN JAVASCRIPT LOGIC
========================================================= -->
<script>
    function switchTab(tabId, btn) {
        document.querySelectorAll('.gm-tab-panel').forEach(function(p) { p.classList.remove('active'); });
        document.querySelectorAll('.gm-tab-btn').forEach(function(b) { b.classList.remove('active'); });
        var target = document.getElementById(tabId);
        if (target) target.classList.add('active');
        if (btn) btn.classList.add('active');
    }

    function onSelectSubpage(slug) {
        document.querySelectorAll('.gm-subpage-editor').forEach(function(e) { e.classList.remove('active'); });
        var target = document.getElementById('subpage_' + slug);
        if (target) target.classList.add('active');
    }

    // Direct Image Upload
    function uploadFileDirect(fileInput, targetUrlInput, previewImg) {
        if (!fileInput.files || fileInput.files.length === 0) return;
        var file = fileInput.files[0];

        var formData = new FormData();
        formData.append('file', file);

        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenInput) {
            formData.append('__RequestVerificationToken', tokenInput.value);
        }

        var oldBtnText = fileInput.parentElement ? fileInput.parentElement.innerText : '';
        if (fileInput.parentElement) fileInput.parentElement.querySelector('span').textContent = 'Uploading...';

        fetch('/Admin/GamingHub/UploadImage', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success && data.url) {
                targetUrlInput.value = data.url;
                if (previewImg) previewImg.src = data.url;
                alert('Image uploaded successfully: ' + data.url);
            } else {
                alert('Upload failed: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(function(err) {
            alert('Upload error: ' + err.message);
        })
        .finally(function() {
            if (fileInput.parentElement) fileInput.parentElement.querySelector('span').textContent = 'Upload';
        });
    }

    // Add Slide
    function addHeroSlide() {
        var list = document.getElementById('heroSlidesList');
        var count = list.querySelectorAll('[data-slide-card]').length + 1;
        var div = document.createElement('div');
        div.className = 'gm-slide-card';
        div.setAttribute('data-slide-card', '');
        div.innerHTML = `
            <div class="gm-slide-top">
                <span class="gm-slide-drag">Slide #<span class="slide-num">${count}</span></span>
                <div class="gm-slide-actions">
                    <label class="gm-check-inline"><input type="checkbox" class="slide-active" checked /> <span>Active</span></label>
                    <label class="gm-check-inline"><input type="checkbox" class="slide-uploading-soon" checked /> <span>Show "Uploading Soon"</span></label>
                    <button type="button" class="gm-btn-icon-del" onclick="removeSlideCard(this)">✕ Delete</button>
                </div>
            </div>
            <div class="gm-grid-2">
                <div class="gm-field"><label>Badge Text</label><input type="text" class="gm-input slide-badge" value="HOT DEAL" /></div>
                <div class="gm-field"><label>Display Order</label><input type="number" class="gm-input slide-order" value="${count}" /></div>
            </div>
            <div class="gm-grid-2">
                <div class="gm-field"><label>Title</label><input type="text" class="gm-input slide-title" value="New Gaming Hardware" /></div>
                <div class="gm-field"><label>Title Highlight</label><input type="text" class="gm-input slide-highlight" value="Exclusive Launch" /></div>
            </div>
            <div class="gm-field"><label>Subtitle</label><textarea class="gm-textarea slide-subtitle" rows="2">Experience superior gaming performance.</textarea></div>
            <div class="gm-grid-2">
                <div class="gm-field"><label>Button Text</label><input type="text" class="gm-input slide-btn-text" value="Shop Now" /></div>
                <div class="gm-field"><label>Target URL</label><input type="text" class="gm-input slide-target-url" value="/category/gaming-hub" /></div>
            </div>
            <div class="gm-field">
                <label>Slide Image URL</label>
                <div class="gm-upload-box">
                    <input type="text" class="gm-input slide-img-url" value="" placeholder="Image path" />
                    <label class="gm-btn-upload"><span>Upload</span><input type="file" accept="image/*" onchange="uploadFileDirect(this, this.closest('.gm-upload-box').querySelector('.slide-img-url'))" style="display:none;" /></label>
                </div>
            </div>
        `;
        list.appendChild(div);
    }

    function removeSlideCard(btn) {
        var card = btn.closest('[data-slide-card]');
        if (card) card.remove();
    }

    // Add Subcategory Item
    function addCategoryItem() {
        var tbody = document.getElementById('catItemsTableBody');
        var tr = document.createElement('tr');
        tr.setAttribute('data-cat-row', '');
        tr.innerHTML = `
            <td><input type="text" class="gm-input gm-input-xs cat-emoji" value="🎮" style="width: 44px; text-align: center;" /></td>
            <td><input type="text" class="gm-input gm-input-sm cat-name" value="New Subcategory" /></td>
            <td><input type="text" class="gm-input gm-input-sm cat-slug" value="new-subcategory" /></td>
            <td><input type="text" class="gm-input gm-input-sm cat-subtitle" value="Consoles & Gear" /></td>
            <td>
                <div class="gm-upload-box-sm">
                    <input type="text" class="gm-input gm-input-sm cat-img-url" value="" placeholder="Image URL" />
                    <label class="gm-btn-upload-sm" title="Upload Image"><span>📁</span><input type="file" accept="image/*" onchange="uploadFileDirect(this, this.closest('.gm-upload-box-sm').querySelector('.cat-img-url'))" style="display:none;" /></label>
                </div>
            </td>
            <td style="text-align: center;"><input type="checkbox" class="cat-uploading-soon" checked /></td>
            <td><input type="number" class="gm-input gm-input-xs cat-order" value="99" style="width: 55px;" /></td>
            <td style="text-align: center;"><input type="checkbox" class="cat-active" checked /></td>
            <td><button type="button" class="gm-btn-del-sm" onclick="this.closest('tr').remove()">✕</button></td>
        `;
        tbody.appendChild(tr);
    }

    // Add Subpage Product
    function addSubpageProduct(slug) {
        var container = document.getElementById('prods_' + slug);
        if (!container) return;
        var div = document.createElement('div');
        div.className = 'gm-product-row-card';
        div.setAttribute('data-prod-row', '');
        div.innerHTML = `
            <div class="gm-prod-row-header">
                <span style="font-weight: 700; font-size: 13px;">New Product</span>
                <button type="button" class="gm-btn-del-sm" onclick="this.closest('.gm-product-row-card').remove()">✕ Remove Product</button>
            </div>
            <div class="gm-grid-3">
                <div class="gm-field" style="grid-column: span 2;"><label>Product Title</label><input type="text" class="gm-input prod-title" value="Gaming Product Title" /></div>
                <div class="gm-field"><label>Brand</label><input type="text" class="gm-input prod-brand" value="Sony" /></div>
            </div>
            <div class="gm-grid-4">
                <div class="gm-field">
                    <label>Condition Badge</label>
                    <select class="gm-input prod-cond"><option value="Brand New">Brand New</option><option value="Open Box">Open Box</option></select>
                </div>
                <div class="gm-field"><label>Price Text (e.g. ₹49,990)</label><input type="text" class="gm-input prod-disc-price" value="₹49,990" /></div>
                <div class="gm-field"><label>Original Price (e.g. ₹54,990)</label><input type="text" class="gm-input prod-orig-price" value="₹54,990" /></div>
                <div class="gm-field"><label>Discount (e.g. 10% off)</label><input type="text" class="gm-input prod-percent" value="10% off" /></div>
            </div>
            <div class="gm-grid-3">
                <div class="gm-field"><label>Rating</label><input type="text" class="gm-input prod-rating" value="4.8" /></div>
                <div class="gm-field">
                    <label>Availability Status</label>
                    <select class="gm-input prod-stock"><option value="In stock">In stock</option><option value="Out of stock">Out of stock</option></select>
                </div>
                <div class="gm-field" style="display: flex; align-items: center; padding-top: 24px;">
                    <label class="gm-check-inline"><input type="checkbox" class="prod-uploading-soon" checked /> <span>"Uploading Soon" Pill</span></label>
                </div>
            </div>
            <div class="gm-field">
                <label>Product Image URL</label>
                <div class="gm-upload-box">
                    <input type="text" class="gm-input prod-img-url" value="" />
                    <label class="gm-btn-upload"><span>Upload</span><input type="file" accept="image/*" onchange="uploadFileDirect(this, this.closest('.gm-upload-box').querySelector('.prod-img-url'))" style="display:none;" /></label>
                </div>
            </div>
        `;
        container.appendChild(div);
    }

    // Save Entire Configuration via AJAX
    function saveGamingConfig() {
        var btn = document.getElementById('btnSaveConfig');
        btn.disabled = true;
        btn.querySelector('span').textContent = 'Saving...';

        // 1. Hero
        var hero = {
            isEnabled: document.getElementById('heroIsEnabled').checked,
            autoPlay: document.getElementById('heroAutoPlay').value === 'true',
            slideIntervalSeconds: parseInt(document.getElementById('heroInterval').value || '4', 10),
            bannerHeight: parseInt(document.getElementById('heroHeight').value || '440', 10),
            slides: []
        };

        document.querySelectorAll('#heroSlidesList [data-slide-card]').forEach(function(card, idx) {
            hero.slides.push({
                id: 'gaming-slide-' + (idx + 1),
                badgeText: card.querySelector('.slide-badge').value,
                displayOrder: parseInt(card.querySelector('.slide-order').value || (idx + 1), 10),
                title: card.querySelector('.slide-title').value,
                titleHighlight: card.querySelector('.slide-highlight').value,
                subtitle: card.querySelector('.slide-subtitle').value,
                buttonText: card.querySelector('.slide-btn-text').value,
                targetUrl: card.querySelector('.slide-target-url').value,
                imageUrl: card.querySelector('.slide-img-url').value,
                isUploadingSoon: card.querySelector('.slide-uploading-soon').checked,
                isActive: card.querySelector('.slide-active').checked
            });
        });

        // 2. Shop by Category
        var shopCat = {
            isEnabled: document.getElementById('catSectionEnabled').checked,
            title: document.getElementById('catSectionTitle').value,
            subtitle: document.getElementById('catSectionSubtitle').value,
            items: []
        };

        document.querySelectorAll('#catItemsTableBody [data-cat-row]').forEach(function(row, idx) {
            shopCat.items.push({
                id: 'cat-itm-' + (idx + 1),
                iconEmoji: row.querySelector('.cat-emoji').value,
                name: row.querySelector('.cat-name').value,
                slug: row.querySelector('.cat-slug').value,
                subtitle: row.querySelector('.cat-subtitle').value,
                imageUrl: row.querySelector('.cat-img-url').value,
                isUploadingSoon: row.querySelector('.cat-uploading-soon').checked,
                displayOrder: parseInt(row.querySelector('.cat-order').value || (idx + 1), 10),
                isActive: row.querySelector('.cat-active').checked
            });
        });

        // 3. Subcategory Pages
        var subPages = [];
        document.querySelectorAll('.gm-subpage-editor').forEach(function(subEl) {
            var slug = subEl.getAttribute('data-subpage-slug');
            var heroTitle = subEl.querySelector('.subhero-title').value;
            var heroHighlight = subEl.querySelector('.subhero-highlight').value;
            var heroSubtitle = subEl.querySelector('.subhero-subtitle').value;
            var heroImg = subEl.querySelector('.subhero-img-url').value;
            var heroUploading = subEl.querySelector('.subhero-uploading-soon').checked;

            var prods = [];
            subEl.querySelectorAll('[data-prod-row]').forEach(function(pRow, pIdx) {
                prods.push({
                    id: slug + '-prod-' + (pIdx + 1),
                    title: pRow.querySelector('.prod-title').value,
                    brand: pRow.querySelector('.prod-brand').value,
                    conditionBadge: pRow.querySelector('.prod-cond').value,
                    priceText: pRow.querySelector('.prod-disc-price').value,
                    originalPriceText: pRow.querySelector('.prod-orig-price').value,
                    discountPercent: pRow.querySelector('.prod-percent').value,
                    rating: pRow.querySelector('.prod-rating').value,
                    availabilityStatus: pRow.querySelector('.prod-stock').value,
                    imageUrl: pRow.querySelector('.prod-img-url').value,
                    isUploadingSoon: pRow.querySelector('.prod-uploading-soon').checked,
                    slug: slug + '-hardware'
                });
            });

            subPages.push({
                categorySlug: slug,
                categoryName: heroTitle,
                heroBanner: {
                    title: heroTitle,
                    titleHighlight: heroHighlight,
                    subtitle: heroSubtitle,
                    imageUrl: heroImg,
                    isUploadingSoon: heroUploading
                },
                products: prods
            });
        });

        // 4. Top Picks
        var topPicks = {
            isEnabled: document.getElementById('topPicksEnabled').checked,
            title: document.getElementById('topPicksTitle').value,
            subtitle: document.getElementById('topPicksSubtitle').value,
            products: []
        };

        var payload = {
            heroBanner: hero,
            shopByCategory: shopCat,
            subcategoryPages: subPages,
            topPicks: topPicks,
            threeSectionSliderSlug: "gaming-hub"
        };

        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        fetch('/Admin/GamingHub/Save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': tokenInput ? tokenInput.value : ''
            },
            body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                alert('Success: ' + (data.message || 'Gaming Hub settings saved successfully!'));
            } else {
                alert('Error: ' + (data.message || 'Failed to save settings.'));
            }
        })
        .catch(function(err) {
            alert('Save error: ' + err.message);
        })
        .finally(function() {
            btn.disabled = false;
            btn.querySelector('span').textContent = 'Save All Changes';
        });
    }
</script>
