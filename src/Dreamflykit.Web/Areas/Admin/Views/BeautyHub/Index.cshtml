        <div id="bigBrandsList" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
            @for (int i = 0; i < bigBrands.Brands.Count; i++)
            {
                var bb = bigBrands.Brands[i];
                <div class="big-brand-item" data-id="@bb.Id" style="background: #fefce8; border: 1px solid #fef08a; border-radius: 8px; padding: 10px;">
                    <span style="font-weight: 800; font-size: 13px; color: #854d0e;">@bb.BrandName</span>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 6px 0;">
                        <input type="text" class="bb-name" value="@bb.BrandName" style="padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px;" />
                        <input type="text" class="bb-tag" value="@bb.OfferTag" style="padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px;" />
                    </div>
                    <div style="display: flex; gap: 6px;">
                        <input type="text" class="bb-img" value="@bb.ImageUrl" placeholder="Brand / Product Img" style="flex: 1; padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px;" />
                        <button type="button" onclick="triggerUpload(this)" style="background: #ca8a04; color: #fff; border: none; padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer;">Upload</button>
                        <input type="file" style="display: none;" accept="image/*" onchange="uploadFile(this)" />
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- BOTTOM SAVE ACTION BAR -->
    <div style="text-align: right; padding: 18px 0; border-top: 1px solid #e2e8f0; margin-top: 10px;">
        <button type="button" class="dk-btn" id="btnSaveBeautyBottom" style="background: #e11d48; color: #ffffff; border: none; padding: 14px 38px; font-size: 16px; font-weight: 800; border-radius: 8px; cursor: pointer; box-shadow: 0 4px 16px rgba(225, 29, 72, 0.4);">
            💾 Save All Changes Now
        </button>
    </div>

</div>

<script>
function triggerUpload(btn) {
    const fileInput = btn.parentElement.querySelector('input[type="file"]');
    if (fileInput) fileInput.click();
}

async function uploadFile(input) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];
    const formData = new FormData();
    formData.append('file', file);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    formData.append('__RequestVerificationToken', token);

    const textInput = input.parentElement.querySelector('input[type="text"]');
    const origBtn = input.parentElement.querySelector('button');
    const origText = origBtn ? origBtn.textContent : 'Upload';
    if (origBtn) origBtn.textContent = 'Uploading...';

    try {
        const resp = await fetch('/Admin/BeautyHub/UploadImage', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        const result = await resp.json();
        if (result.success && result.url) {
            if (textInput) textInput.value = result.url;
            alert('Image uploaded successfully: ' + result.url);
        } else {
            alert('Upload failed: ' + (result.message || 'Unknown error'));
        }
    } catch (err) {
        console.error(err);
        alert('Network error while uploading image.');
    } finally {
        if (origBtn) origBtn.textContent = origText;
        input.value = '';
    }
}

function addHeroSlide() {
    const list = document.getElementById('heroSlidesList');
    const index = list.children.length + 1;
    const newId = 'bpc-slide-' + Date.now();
    const row = document.createElement('div');
