<script>
function toggleEthnicWishlist(btn, id) {
    btn.classList.toggle('active');
    var isFilled = btn.classList.contains('active');
    var path = btn.querySelector('svg path');
    if (path) {
        path.setAttribute('fill', isFilled ? '#ef4444' : 'none');
    }
}
function addEthnicToCart(btn, name) {
    btn.style.transform = 'scale(0.9)';
    setTimeout(function() {
        btn.style.transform = '';
        if (typeof showToast === 'function') {
            showToast(name + ' added to kit!');
        } else {
            alert(name + ' added to kit!');
        }
    }, 150);
}
document.addEventListener('DOMContentLoaded', function() {
    var track = document.getElementById('dkEthnicProductsTrackWrapper');
    var prev = document.getElementById('dkEthnicPicksPrev');
    var next = document.getElementById('dkEthnicPicksNext');
    if (track && prev && next) {
        prev.addEventListener('click', function() { track.scrollBy({ left: -260, behavior: 'smooth' }); });
        next.addEventListener('click', function() { track.scrollBy({ left: 260, behavior: 'smooth' }); });
    }
});
</script>
