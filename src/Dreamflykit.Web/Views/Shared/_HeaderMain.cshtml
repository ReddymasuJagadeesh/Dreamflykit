@inject Dreamflykit.Application.Categories.Interfaces.ICategoryService CategoryNavService
@inject Dreamflykit.Application.Media.Interfaces.IHeaderAdService HeaderAdService
@{
    var navCategories = await CategoryNavService.GetActiveCategoriesAsync(Context.RequestAborted);
    var headerAd = await HeaderAdService.GetActiveHeaderAdSpaceAsync(Context.RequestAborted);

    var routeCategory = ViewContext.RouteData.Values["category"]?.ToString();
    var queryCategory = Context.Request.Query["category"].ToString();
    var activeCatSlug = !string.IsNullOrWhiteSpace(routeCategory)
        ? routeCategory.Trim().ToLowerInvariant()
        : (!string.IsNullOrWhiteSpace(queryCategory) ? queryCategory.Trim().ToLowerInvariant() : null);

    var currentReqPath = Context.Request.Path.Value ?? "";
    var isAbroadHub = (currentReqPath.Equals("/study-abroad-hub", StringComparison.OrdinalIgnoreCase) ||
                      currentReqPath.Equals("/study-abroad-hub/", StringComparison.OrdinalIgnoreCase) ||
                      currentReqPath.Equals("/StudyAbroadHub", StringComparison.OrdinalIgnoreCase) ||
                      currentReqPath.Equals("/StudyAbroadHub/", StringComparison.OrdinalIgnoreCase) ||
                      currentReqPath.StartsWith("/SpecialOffer", StringComparison.OrdinalIgnoreCase) ||
                      currentReqPath.StartsWith("/AbroadHub", StringComparison.OrdinalIgnoreCase) ||
                      currentReqPath.StartsWith("/Offer", StringComparison.OrdinalIgnoreCase)) &&
                      !currentReqPath.Contains("checklist", StringComparison.OrdinalIgnoreCase);
    var isDreamflykit = !isAbroadHub;

    var isOffersZone = Context.Request.Query.ContainsKey("minDiscount") ||
                       string.Equals(Context.Request.Query["sort"], "DiscountHighToLow", StringComparison.OrdinalIgnoreCase);
    var isForYou = !isOffersZone && string.IsNullOrEmpty(activeCatSlug) &&
                   (currentReqPath == "/" || currentReqPath.StartsWith("/products", StringComparison.OrdinalIgnoreCase));

    Func<string, string> getCatEmoji = slug => slug?.ToLowerInvariant() switch
    {
        "study-essentials" or "study" => "🎓",
        "fashion" => "👗",
        "travel-gear" or "travel" => "✈",
        "mobiles" or "mobile" => "📱",
        "electronics" => "💻",
        "appliances" => "🔌",
        "beauty" => "💄",
        "health-care" or "health" => "💊",
        "food" => "🍫",
        "room-living" or "room" => "🛋️",
        "kitchen-appliances" or "kitchen" => "🍳",
        "story-books" or "books" => "📚",
        "premium-hub" or "premium" => "⭐",
        "gaming-hub" or "gaming" => "🎮",
        "sports-hub" or "sports" => "⚽",
        _ => "🏷️"
    };
}
<header class="dk-header">


    <!-- =====================================================
         MAIN HEADER
    ====================================================== -->
    <div class="dk-main-header @(isAbroadHub ? "dk-main-header-abroad" : "")">

        <div class="dk-shell dk-main-header-inner">

            <!-- =====================================================
                 ROW 1: FLIPKART-STYLE DUAL PROFILE SWITCHER (DREAMFLYKIT & STUDY ABROAD HUB)
            ====================================================== -->
            <div class="dk-header-top-row">

                <!-- DUAL PROFILE SWITCHER CONTAINER -->
                <div class="dk-profile-switcher-wrapper" role="tablist" aria-label="Brand Profile Switcher">

                    <!-- PROFILE 1: DREAMFLYKIT STORE -->
                    <a href="/"
                       class="dk-profile-pill dk-profile-pill-store @(isDreamflykit ? "is-active" : "is-inactive")"
                       role="tab"
                       aria-selected="@(isDreamflykit ? "true" : "false")"
                       aria-label="Dreamflykit Shopping Profile"
                       title="Dreamflykit — Travel & Study Abroad E-Commerce Store">
                        <span class="dk-profile-brand-logo-wrap">
                            <img src="~/images/branding/dreamflykit-logo-clean.webp"
                                 alt="Dreamflykit"
                                 class="dk-profile-brand-logo-img" />
                        </span>
                    </a>

                    <!-- PROFILE 2: STUDY ABROAD HUB -->
                    <a href="/study-abroad-hub"
                       class="dk-profile-pill dk-profile-pill-abroad @(isAbroadHub ? "is-active" : "is-inactive")"
                       role="tab"
                       aria-selected="@(isAbroadHub ? "true" : "false")"
                       aria-label="Study Abroad Hub Profile"
                       title="Study Abroad Hub">
                        <span class="dk-profile-pill-icon-wrap dk-pill-abroad-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="dk-profile-svg-abroad">
                                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
                                <path d="M3.6 9h16.8M3.6 15h16.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                                <path d="M12 3c2.4 2.5 3.8 5.5 3.8 9s-1.4 6.5-3.8 9c-2.4-2.5-3.8-5.5-3.8-9s1.4-6.5 3.8-9z" stroke="currentColor" stroke-width="1.3"/>
                                <path d="M14.5 5.5l4-1.5-1.2 4 3.5 1-4.8 2.2-.8 2.2-1.2-1.5-.8 1.5-.6-2.2 1.9-5.7z" fill="currentColor"/>
                            </svg>
                        </span>
                        <span class="dk-profile-abroad-title">Study Abroad Hub</span>
                    </a>

                </div>

                <!-- RIGHT UTILITY (DELIVERY LOCATION / AD SPACE) -->
                <div class="dk-header-top-utility-right">
                    @if (headerAd != null && headerAd.IsActive && !string.Equals(headerAd.Title, "Study abroad hub", StringComparison.OrdinalIgnoreCase) && !string.Equals(headerAd.Title, "Dreamflykit Special Offers", StringComparison.OrdinalIgnoreCase))
                    {
                        var target = headerAd.OpenInNewTab ? "_blank" : "_self";
                        <a href="@headerAd.RedirectUrl"
                           target="@target"
                           rel="noopener noreferrer"
                           class="dk-header-ad-space-banner mode-@(headerAd.DisplayMode?.ToLowerInvariant() ?? "hybrid")"
                           title="@headerAd.Title (Click to open page)"
                           aria-label="@headerAd.Title">

                            @if (headerAd.DisplayMode != "TextOnly" && !string.IsNullOrWhiteSpace(headerAd.ImageUrl))
                            {
                                <div class="dk-ad-space-media">
                                    <img src="@headerAd.ImageUrl" alt="@headerAd.Title" class="dk-ad-space-img" />
                                </div>
                            }
                            else if (headerAd.DisplayMode == "Hybrid")
                            {
                                <div class="dk-ad-space-media-fallback">
                                    <span class="dk-ad-icon-badge">✈️</span>
                                </div>
                            }

                            @if (headerAd.DisplayMode != "ImageOnly")
                            {
                                <div class="dk-ad-space-content">
                                    @if (!string.IsNullOrWhiteSpace(headerAd.BadgeText))
                                    {
                                        <span class="dk-ad-badge-tag">@headerAd.BadgeText</span>
                                    }
                                    <strong class="dk-ad-space-title">@headerAd.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(headerAd.Subtitle))
                                    {
                                        <small class="dk-ad-space-sub">@headerAd.Subtitle</small>
                                    }
                                </div>
                            }

                            <span class="dk-ad-space-arrow" aria-hidden="true">↗</span>
                        </a>
                    }

                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <a href="/Admin/HeaderAds"
                           class="dk-admin-ad-quick-btn"
                           title="Admin Console: Replace or configure header ad space and destination URL">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                            <span>Ad Console</span>
                        </a>
                    }
                </div>

            </div>

            @if (!isAbroadHub)
            {
                <!-- =====================================================
                     ROW 2: SEARCH BAR (LEFT) + ACTIONS (RIGHT)
                ====================================================== -->
                <div class="dk-header-bottom-row">

                <!-- SEARCH BAR - ON LEFT SIDE -->
                <div class="dk-search-box-wrapper">
                    <form action="/Products/Search"
                          method="get"
                          id="dk-search-form"
                          class="dk-search">

                        <span class="dk-search-icon">
                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <circle cx="11"
                                        cy="11"
                                        r="7"></circle>
                                <path d="m20 20-4-4"></path>
                            </svg>
                        </span>

                        <input type="search"
                               id="dk-search-input"
                               name="q"
                               placeholder="@(isAbroadHub ? "Search student flight perks, abroad kits, forex deals..." : "Search for products, brands and more")"
                               autocomplete="off" />

                        <button type="submit"
                                aria-label="Search">
                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <circle cx="11"
                                        cy="11"
                                        r="7"></circle>
                                <path d="m20 20-4-4"></path>
                            </svg>
                        </button>
                    </form>

                    <div id="dk-search-autocomplete" class="dk-autocomplete-dropdown" style="display: none;" role="listbox" aria-label="Search suggestions"></div>
                </div>

                <!-- ACTIONS (ACCOUNT, MENU, WISHLIST, CART, ADMIN) - ON RIGHT SIDE -->
                <div class="dk-header-actions-group">

                    <!-- ADMIN DIRECT SHORTCUT BUTTON -->
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <a href="/Admin" class="dk-admin-header-btn" title="Open Admin Control Center">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                            <span>@(User.IsInRole("SuperAdmin") ? "Super Admin" : "Admin Panel")</span>
                        </a>
                    }
                    @if (User.IsInRole("Seller"))
                    {
                        <a href="/Seller/Products" class="dk-admin-header-btn" style="background: linear-gradient(135deg, #4f46e5, #4338ca); color: #fff; border-color: rgba(99, 102, 241, 0.4);" title="Open Seller Central">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                            <span>Seller Central</span>
                        </a>
                    }

                    <!-- ACCOUNT -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dk-account-dropdown-wrapper">
                            <a href="/Orders" class="dk-account" aria-haspopup="true" aria-expanded="false" id="headerUserAccountTrigger">
                                <span class="dk-account-icon">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <circle cx="12" cy="8" r="3.5"></circle>
                                        <path d="M5 21c.8-4 3.2-6 7-6s6.2 2 7 6"></path>
                                    </svg>
                                </span>
                                <span class="dk-account-text">
                                    <small>Hello, @(User.Identity.Name?.Split('@')[0])</small>
                                    <span class="dk-account-title-wrap">
                                        <strong>My Account</strong>
                                        <svg class="dk-account-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </span>
                                </span>
                            </a>
                            <div class="dk-account-menu" aria-labelledby="headerUserAccountTrigger">
                                <div class="dk-account-popover-user">
                                    <div class="dk-user-avatar">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div class="dk-user-info">
                                        <span class="dk-user-name">@(User.Identity.Name?.Split('@')[0])</span>
                                        <span class="dk-user-email">@User.Identity.Name</span>
                                    </div>
                                </div>
                                <div class="dk-popover-divider"></div>
                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                                {
                                    <div class="dk-menu-section-label">Store Management</div>
                                    <a href="/Admin" class="dk-account-menu-item dk-menu-item-admin">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                                        </span>
                                        <span class="dk-menu-label">@(User.IsInRole("SuperAdmin") ? "Super Admin Dashboard" : "Admin Dashboard")</span>
                                    </a>
                                    <a href="/Admin/Products/Create" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                        </span>
                                        <span class="dk-menu-label">Add Product</span>
                                    </a>
                                    <a href="/Admin/Products?status=PendingApproval" class="dk-account-menu-item" style="color: #d97706; font-weight: 600;">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="9"></circle></svg>
                                        </span>
                                        <span class="dk-menu-label">Seller Submissions</span>
                                    </a>
                                    @if (User.IsInRole("SuperAdmin"))
                                    {
                                        <a href="/Admin/Sellers" class="dk-account-menu-item">
                                            <span class="dk-menu-icon-wrap">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                            </span>
                                            <span class="dk-menu-label">Seller Accounts</span>
                                        </a>
                                    }
                                    <a href="/Admin/HeaderAds" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><circle cx="12" cy="14" r="3"></circle><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                                        </span>
                                        <span class="dk-menu-label">Header Ad Space</span>
                                    </a>
                                    <a href="/Admin/Banners" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                                        </span>
                                        <span class="dk-menu-label">Hero & Promo Banners</span>
                                    </a>
                                    <a href="/Admin/Categories" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                        </span>
                                        <span class="dk-menu-label">Categories & Subcategories</span>
                                    </a>
                                    <a href="/Admin/Media" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                        </span>
                                        <span class="dk-menu-label">Media & Banners</span>
                                    </a>
                                    @if (User.IsInRole("SuperAdmin"))
                                    {
                                        <a href="/Admin/MediaPermissions" class="dk-account-menu-item dk-menu-item-permissions">
                                            <span class="dk-menu-icon-wrap">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                            </span>
                                            <span class="dk-menu-label">Admin Permissions</span>
                                        </a>
                                        <a href="/Admin/ThemeSettings" class="dk-account-menu-item" style="color: #075bc8; font-weight: 700;">
                                            <span class="dk-menu-icon-wrap">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                                            </span>
                                            <span class="dk-menu-label">Typography Theme</span>
                                        </a>
                                    }
                                    <div class="dk-popover-divider"></div>
                                }
                                @if (User.IsInRole("Seller"))
                                {
                                    <div class="dk-menu-section-label" style="color: #4f46e5;">Seller Central</div>
                                    <a href="/Seller/Products" class="dk-account-menu-item" style="color: #4f46e5; font-weight: 700;">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                                        </span>
                                        <span class="dk-menu-label">My Seller Products</span>
                                    </a>
                                    <a href="/Seller/Products/Create" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                        </span>
                                        <span class="dk-menu-label">Submit New Product</span>
                                    </a>
                                    <div class="dk-popover-divider"></div>
                                }
                                <div class="dk-account-menu-list">
                                    <a href="/Orders" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                                        </span>
                                        <span class="dk-menu-label">My Orders</span>
                                    </a>
                                    <a href="/Address" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                        </span>
                                        <span class="dk-menu-label">Saved Addresses</span>
                                    </a>
                                    <a href="/Wishlist" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                                        </span>
                                        <span class="dk-menu-label">Wishlist</span>
                                    </a>
                                </div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="dk-account-menu-form">
                                    <button type="submit" class="dk-account-menu-item dk-logout-btn">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                        </span>
                                        <span class="dk-menu-label">Log Out</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="dk-account-dropdown-wrapper">
                            <a href="/Account/Login" class="dk-account" aria-haspopup="true" aria-expanded="false" id="headerGuestAccountTrigger">
                                <span class="dk-account-icon">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <circle cx="12" cy="8" r="3.5"></circle>
                                        <path d="M5 21c.8-4 3.2-6 7-6s6.2 2 7 6"></path>
                                    </svg>
                                </span>
                                <span class="dk-account-text">
                                    <small>Login / Sign Up</small>
                                    <span class="dk-account-title-wrap">
                                        <strong>My Account</strong>
                                        <svg class="dk-account-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </span>
                                </span>
                            </a>

                            <!-- FLIPKART STYLE LOGIN POPUP -->
                            <div class="dk-account-menu dk-guest-account-menu" aria-labelledby="headerGuestAccountTrigger">
                                <div class="dk-popover-header">
                                    <div class="dk-popover-header-row">
                                        <span class="dk-popover-new-txt">New customer?</span>
                                        <a href="/Account/Register" class="dk-popover-signup-link">Sign Up</a>
                                    </div>
                                    <a href="/Account/Login" class="dk-popover-login-btn">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                            <polyline points="10 17 15 12 10 7"></polyline>
                                            <line x1="15" y1="12" x2="3" y2="12"></line>
                                        </svg>
                                        <span>Login</span>
                                    </a>
                                </div>
                                <div class="dk-popover-divider"></div>
                                <div class="dk-account-menu-list">
                                    <a href="/Account/Login?returnUrl=/Orders" class="dk-account-menu-item">
                                        <span class="dk-menu-icon-wrap">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>
                                        </span>
