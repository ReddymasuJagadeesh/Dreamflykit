<!-- ========================================================
     CLIENT-SIDE JAVASCRIPT FOR CONSULTANCY HUB
========================================================= -->
<script>
    const allCountriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(countries));
    let currentCountryIndex = 0;

    function scrollCarousel(gridId, distance) {
        const grid = document.getElementById(gridId);
        if (grid) {
            grid.scrollBy({ left: distance, behavior: 'smooth' });
        }
    }

    function handleSearchCourses(query) {
        const q = (query || "").toLowerCase().trim();
        const cards = document.querySelectorAll(".dk-upg-course-card");
        cards.forEach(card => {
            const title = (card.dataset.title || "").toLowerCase();
            const inst = (card.dataset.inst || "").toLowerCase();
            if (!q || title.includes(q) || inst.includes(q)) {
                card.style.display = "flex";
            } else {
                card.style.display = "none";
            }
        });
    }

    function triggerSearchScroll() {
        const q = document.getElementById("upgCourseSearchInput")?.value;
        handleSearchCourses(q);
        const trendingSec = document.getElementById("trending-courses");
        if (trendingSec) {
            trendingSec.scrollIntoView({ behavior: 'smooth' });
        }
    }

    function filterCategory(tag, pillBtn) {
        // Toggle active pill state
        if (pillBtn) {
            document.querySelectorAll(".dk-upg-pill").forEach(p => p.classList.remove("active"));
            pillBtn.classList.add("active");
        }

        const tagMap = {
            'ai': 'ai',
            'ml': 'machine learning',
            'data': 'data',
            'doctorate': 'phd',
            'iit': 'iit',
            'mba': 'mba',
            'marketing': 'marketing',
            'management': 'management'
        };

        const searchKeyword = tagMap[tag] || tag;
        const searchInput = document.getElementById("upgCourseSearchInput");
        if (searchInput) {
            searchInput.value = searchKeyword;
        }
        handleSearchCourses(searchKeyword);

        const targetSec = (tag === 'mba' || tag === 'management') 
            ? document.getElementById("popular-programs") 
            : document.getElementById("trending-courses");
        if (targetSec) {
            targetSec.scrollIntoView({ behavior: 'smooth' });
        }
    }

    function renderDestinationCountry(c) {
        if (!c) return;
        const stage = document.getElementById("destHeroStage");
        if (stage && c.HeroImageUrl) {
            stage.style.backgroundImage = `url('${c.HeroImageUrl}')`;
        }
        const slideNum = document.getElementById("destSlideNum");
        if (slideNum) {
            slideNum.textContent = c.SlideNumber || "01 / 9";
        }

        // Render Programs
        const progContainer = document.getElementById("destProgramsContainer");
        if (progContainer && c.Programs) {
            progContainer.innerHTML = c.Programs.map(p => `
                <div class="dk-upg-dest-program-card">
                    <div class="dk-upg-dest-card-header">
                        <div class="dk-upg-dest-flag-icon">🎓</div>
                        <div class="dk-upg-dest-inst">${p.Institution}</div>
                    </div>
                    <h4 class="dk-upg-dest-card-title">${p.Title}</h4>
                    ${p.BadgeTag ? `<div class="dk-upg-dest-accred-badge">${p.BadgeTag}</div>` : ''}
                    <div class="dk-upg-dest-meta-row">
                        <span>🎓 ${p.BadgeType}</span>
                        <span>⏱ ${p.Duration}</span>
                    </div>
                    <button type="button" class="dk-upg-dest-btn-red" onclick="openProgramDetails('${p.Institution}', '${p.Title}', 'destination')">
                        ${p.Button1Text || 'View Program'}
                    </button>
                </div>
            `).join('');
        }

        // Render Stats
        const statsBar = document.getElementById("destStatsBar");
        if (statsBar && c.Stats) {
            statsBar.innerHTML = c.Stats.map(s => `
                <div class="dk-upg-stat-item">
                    <div class="dk-upg-stat-val">${s.Value}</div>
                    <div class="dk-upg-stat-label">${s.Label}</div>
                </div>
            `).join('');
        }
    }

    function switchDestinationCountry(code, btn) {
        document.querySelectorAll(".dk-upg-country-tab").forEach(t => t.classList.remove("active"));
        if (btn) btn.classList.add("active");

        const foundIdx = allCountriesData.findIndex(x => x.CountryCode === code);
        if (foundIdx >= 0) {
            currentCountryIndex = foundIdx;
            renderDestinationCountry(allCountriesData[currentCountryIndex]);
        }
    }

    function prevDestinationCountry() {
        if (!allCountriesData.length) return;
        currentCountryIndex = (currentCountryIndex - 1 + allCountriesData.length) % allCountriesData.length;
        const c = allCountriesData[currentCountryIndex];
        const tabs = document.querySelectorAll(".dk-upg-country-tab");
        if (tabs[currentCountryIndex]) {
            document.querySelectorAll(".dk-upg-country-tab").forEach(t => t.classList.remove("active"));
            tabs[currentCountryIndex].classList.add("active");
        }
        renderDestinationCountry(c);
    }

    function nextDestinationCountry() {
        if (!allCountriesData.length) return;
        currentCountryIndex = (currentCountryIndex + 1) % allCountriesData.length;
        const c = allCountriesData[currentCountryIndex];
        const tabs = document.querySelectorAll(".dk-upg-country-tab");
        if (tabs[currentCountryIndex]) {
            document.querySelectorAll(".dk-upg-country-tab").forEach(t => t.classList.remove("active"));
            tabs[currentCountryIndex].classList.add("active");
        }
        renderDestinationCountry(c);
    }

    // Modal Controls
    function openConsultancyModal(sourceInfo) {
        const modal = document.getElementById("consultancyModal");
        const programField = document.getElementById("leadTargetProgram");
        if (programField && sourceInfo) {
            programField.value = sourceInfo;
        }
        if (modal) {
            modal.style.display = "flex";
            document.getElementById("leadFullName")?.focus();
        }
    }

    function openProgramDetails(institution, title, mode) {
        const modalTitle = document.getElementById("modalDynamicTitle");
        const modalSub = document.getElementById("modalDynamicSub");
        const programField = document.getElementById("leadTargetProgram");

        if (mode === 'syllabus') {
            if (modalTitle) modalTitle.textContent = "Download Complete Syllabus & Curriculum";
            if (modalSub) modalSub.textContent = `Get the official curriculum brochure for ${title} (${institution}).`;
        } else if (mode === 'apply') {
            if (modalTitle) modalTitle.textContent = "Apply for Admission & Scholarship";
            if (modalSub) modalSub.textContent = `Submit your interest for ${title} at ${institution}.`;
        } else {
            if (modalTitle) modalTitle.textContent = `1-on-1 Consultation: ${title}`;
            if (modalSub) modalSub.textContent = `Speak directly with a program advisor for ${institution}.`;
        }

        if (programField) {
            programField.value = `${institution} - ${title}`;
        }

        const modal = document.getElementById("consultancyModal");
        if (modal) modal.style.display = "flex";
    }

    function closeConsultancyModal() {
        const modal = document.getElementById("consultancyModal");
        if (modal) modal.style.display = "none";
        const form = document.getElementById("consultancyLeadForm");
        const feedback = document.getElementById("leadSuccessFeedback");
        if (form) form.style.display = "block";
        if (feedback) feedback.style.display = "none";
    }

    async function handleLeadSubmit(e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitLead");
        const oldText = btn ? btn.innerHTML : "Submit";
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = "Submitting Consultation Request...";
        }

        const payload = {
            FullName: document.getElementById("leadFullName")?.value || "",
            PhoneNumber: document.getElementById("leadPhone")?.value || "",
            Email: document.getElementById("leadEmail")?.value || "",
            TargetDegree: document.getElementById("leadTargetDegree")?.value || "",
            DestinationCountry: document.getElementById("leadDestination")?.value || "",
            InterestedProgram: document.getElementById("leadTargetProgram")?.value || "",
            Message: document.getElementById("leadNotes")?.value || ""
        };

        try {
            const resp = await fetch("/study-abroad-hub/consultancy-lead", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();

            const form = document.getElementById("consultancyLeadForm");
            const feedback = document.getElementById("leadSuccessFeedback");
            const msg = document.getElementById("leadSuccessMessage");

            if (form) form.style.display = "none";
            if (feedback) feedback.style.display = "block";
            if (msg) msg.textContent = data.message || "Your consultation has been successfully booked!";
        } catch (err) {
            alert("Submission error: " + err.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = oldText;
            }
        }
    }

    // --------------------------------------------------------
    // 3D Realistic Hero Tilt Interaction
    // --------------------------------------------------------
    (function initHero3d() {
        const hero = document.getElementById("heroBanner");
        const stage = document.getElementById("hero3dContent");
        const sheen = document.getElementById("heroSheen");
        if (!hero || !stage) return;

        let bounds = null;
        function updateBounds() {
            bounds = hero.getBoundingClientRect();
        }
        window.addEventListener("resize", updateBounds);
        updateBounds();

        hero.addEventListener("mousemove", function(e) {
            if (!bounds) updateBounds();
            const mouseX = e.clientX - bounds.left;
            const mouseY = e.clientY - bounds.top;
            const normX = (mouseX / bounds.width) - 0.5;
            const normY = (mouseY / bounds.height) - 0.5;

            const rotateY = normX * 10;
            const rotateX = -normY * 10;

            stage.style.transform = `perspective(1200px) rotateY(${rotateY.toFixed(2)}deg) rotateX(${rotateX.toFixed(2)}deg) translateZ(12px)`;

            if (sheen) {
                const px = ((normX + 0.5) * 100).toFixed(1);
                const py = ((normY + 0.5) * 100).toFixed(1);
                sheen.style.background = `radial-gradient(circle at ${px}% ${py}%, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 65%)`;
            }
        });

        hero.addEventListener("mouseleave", function() {
            stage.style.transform = "perspective(1200px) rotateY(0deg) rotateX(0deg) translateZ(0px)";
            if (sheen) {
                sheen.style.background = "none";
            }
        });
    })();

    // Video Controls
    function toggleHeroVideoPlay(btn) {
        const video = document.getElementById("heroVideoPlayer");
        if (!video) return;
        const pauseIcon = btn.querySelector(".icon-pause");
        const playIcon = btn.querySelector(".icon-play");

        if (video.paused) {
            video.play();
            if (pauseIcon) pauseIcon.style.display = "block";
            if (playIcon) playIcon.style.display = "none";
        } else {
            video.pause();
            if (pauseIcon) pauseIcon.style.display = "none";
            if (playIcon) playIcon.style.display = "block";
        }
    }

    function toggleHeroVideoAudio(btn) {
        const video = document.getElementById("heroVideoPlayer");
        if (!video) return;
        const mutedIcon = btn.querySelector(".icon-muted");
        const unmutedIcon = btn.querySelector(".icon-unmuted");

        video.muted = !video.muted;
        if (video.muted) {
            if (mutedIcon) mutedIcon.style.display = "block";
            if (unmutedIcon) unmutedIcon.style.display = "none";
        } else {
            if (mutedIcon) mutedIcon.style.display = "none";
            if (unmutedIcon) unmutedIcon.style.display = "block";
        }
    }

    // --------------------------------------------------------
    // RedBus-Style Search Bar Interactions (Hover & Click Dropdowns)
    // --------------------------------------------------------
    let selectedDestCode = "GB";
    let selectedDestName = "United Kingdom";
    let dropdownHoverTimer = null;

    function showDropdown(menuId) {
        clearTimeout(dropdownHoverTimer);
        const targetMenu = document.getElementById(menuId);
        if (!targetMenu) return;

        // Close other dropdowns
        document.querySelectorAll(".dk-redbus-dropdown-panel").forEach(m => {
            if (m !== targetMenu) {
                m.classList.remove("is-open");
                m.style.display = "none";
                m.closest(".dk-redbus-seg")?.classList.remove("is-active");
            }
        });

        targetMenu.classList.add("is-open");
        targetMenu.style.display = "block";
        const seg = targetMenu.closest(".dk-redbus-seg");
        if (seg) seg.classList.add("is-active");
    }

    function hideDropdown(menuId, delay = 240) {
        dropdownHoverTimer = setTimeout(() => {
            const targetMenu = document.getElementById(menuId);
            if (!targetMenu) return;

            targetMenu.classList.remove("is-open");
            targetMenu.style.display = "none";
            const seg = targetMenu.closest(".dk-redbus-seg");
            if (seg) seg.classList.remove("is-active");
        }, delay);
    }

    function cancelHideDropdown() {
        clearTimeout(dropdownHoverTimer);
    }

    function handleSegMouseEnter(menuId) {
        showDropdown(menuId);
    }

    function handleSegMouseLeave(menuId) {
        hideDropdown(menuId, 250);
    }

    function handleSegClick(menuId, event) {
        if (event) event.stopPropagation();
        const targetMenu = document.getElementById(menuId);
        if (!targetMenu) return;

        const isCurrentlyOpen = targetMenu.classList.contains("is-open") && targetMenu.style.display === "block";
        if (isCurrentlyOpen) {
            const filterInput = targetMenu.querySelector(".dk-dropdown-filter-input");
            if (filterInput && document.activeElement !== filterInput) {
                filterInput.focus();
            }
        } else {
            showDropdown(menuId);
            const filterInput = targetMenu.querySelector(".dk-dropdown-filter-input");
            if (filterInput) {
                setTimeout(() => filterInput.focus(), 60);
            }
        }
    }

    function toggleSearchDropdown(menuId, event) {
        handleSegClick(menuId, event);
    }

    function closeAllSearchDropdowns() {
        clearTimeout(dropdownHoverTimer);
        document.querySelectorAll(".dk-redbus-dropdown-panel").forEach(m => {
            m.classList.remove("is-open");
            m.style.display = "none";
        });
        document.querySelectorAll(".dk-redbus-seg").forEach(s => {
            s.classList.remove("is-active");
        });
    }

    // Close on outside click
    document.addEventListener("click", function(e) {
        if (!e.target.closest(".dk-redbus-dropdown-panel") && !e.target.closest(".dk-redbus-seg")) {
            closeAllSearchDropdowns();
        }
    });

    // Close on Escape key
    document.addEventListener("keydown", function(e) {
        if (e.key === "Escape") {
            closeAllSearchDropdowns();
        }
    });

    function filterDestList(query) {
        const q = (query || "").toLowerCase().trim();
        document.querySelectorAll("#destOptionsList .dk-drop-opt-item").forEach(item => {
            const country = (item.dataset.country || "").toLowerCase();
            const text = item.textContent.toLowerCase();
            if (!q || country.includes(q) || text.includes(q)) {
                item.style.display = "flex";
            } else {
                item.style.display = "none";
            }
        });
    }

    function filterCentreList(query) {
        const q = (query || "").toLowerCase().trim();
        document.querySelectorAll("#centreOptionsList .dk-drop-opt-item").forEach(item => {
            const centre = (item.dataset.centre || "").toLowerCase();
            const city = (item.dataset.city || "").toLowerCase();
            const text = item.textContent.toLowerCase();
            if (!q || centre.includes(q) || city.includes(q) || text.includes(q)) {
                item.style.display = "flex";
            } else {
                item.style.display = "none";
            }
        });
    }

    function selectDestination(code, name, flag, count, event) {
        if (event) event.stopPropagation();
        selectedDestCode = code;
        selectedDestName = name;

        // Update Search Bar UI
        const flagEl = document.getElementById("dispDestFlag");
        const nameEl = document.getElementById("dispDestName");
        const countEl = document.getElementById("dispDestCount");

        if (flagEl) flagEl.textContent = flag || "🌍";
        if (nameEl) nameEl.textContent = name;
        if (countEl) countEl.textContent = count;

        // Mark active item in list
        document.querySelectorAll("#destOptionsList .dk-drop-opt-item").forEach(item => {
            if (item.dataset.code === code) {
                item.classList.add("active");
            } else {
                item.classList.remove("active");
            }
        });

        // Close dropdown
        closeAllSearchDropdowns();

        // Cascading adaptation: Update active suggested centres & intakes if applicable
        const destItem = document.querySelector(`#destOptionsList .dk-drop-opt-item[data-code="${code}"]`);
        if (destItem) {
            const suggestedCentres = (destItem.dataset.centres || "").split(",").filter(Boolean);
            if (suggestedCentres.length > 0) {
                const currCentre = document.getElementById("dispCentreName")?.textContent || "";
                if (code === "GB" && !currCentre.includes("London")) {
                    selectCentre("London - Holborn Office", "London, UK");
                }
            }
            const availableIntakes = (destItem.dataset.intakes || "").split(",").filter(Boolean);
            if (availableIntakes.length > 0) {
                const intakeEl = document.getElementById("dispIntakeName");
                if (intakeEl && !availableIntakes.includes(intakeEl.textContent)) {
                    intakeEl.textContent = availableIntakes[0];
                }
            }
        }

        // Dynamically Filter Top Universities Section below!
        filterUniversitiesByCountry(code, name);
    }

    function selectCentre(centreName, city, event) {
        if (event) event.stopPropagation();
        const nameEl = document.getElementById("dispCentreName");
        const subEl = document.getElementById("dispCentreSub");
        if (nameEl) nameEl.textContent = centreName;
        if (subEl) subEl.textContent = city || "Verified Hub";

        // Mark active item in list
        document.querySelectorAll("#centreOptionsList .dk-drop-opt-item").forEach(item => {
            if (item.dataset.centre === centreName) {
                item.classList.add("active");
            } else {
                item.classList.remove("active");
            }
        });

        closeAllSearchDropdowns();
    }

    function selectIntake(intakeName, event) {
        if (event) event.stopPropagation();
        const intakeEl = document.getElementById("dispIntakeName");
        if (intakeEl) intakeEl.textContent = intakeName;

        // Mark active item in list
        document.querySelectorAll("#intakeOptionsList .dk-drop-opt-item").forEach(item => {
            if (item.dataset.intake === intakeName) {
                item.classList.add("active");
            } else {
                item.classList.remove("active");
            }
        });

        closeAllSearchDropdowns();
    }

    function handleAdvisoryToggle(checkbox) {
        const isChecked = checkbox.checked;
        if (isChecked) {
            showToastMessage("✓ 1-on-1 Dedicated Counsellor and Scholarship Profile Scoring enabled for your search!");
        }
    }

    function showToastMessage(msg) {
        let toast = document.getElementById("dkConsultancyToast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "dkConsultancyToast";
            toast.style = "position: fixed; bottom: 30px; right: 30px; background: #0f172a; color: #ffffff; padding: 12px 20px; border-radius: 10px; font-size: 13.5px; font-weight: 600; box-shadow: 0 10px 25px rgba(0,0,0,0.3); z-index: 999999; display: flex; align-items: center; gap: 8px; transition: opacity 0.3s, transform 0.3s; opacity: 0; transform: translateY(15px); pointer-events: none;";
            document.body.appendChild(toast);
        }
        toast.textContent = msg;
        toast.style.opacity = "1";
        toast.style.transform = "translateY(0)";
        setTimeout(() => {
            toast.style.opacity = "0";
            toast.style.transform = "translateY(15px)";
        }, 3500);
    }

    function executeHubSearch() {
        filterUniversitiesByCountry(selectedDestCode, selectedDestName);
        const uniSec = document.getElementById("topUniversitiesSection") || document.getElementById("whyChooseSection");
        if (uniSec) {
            uniSec.scrollIntoView({ behavior: "smooth", block: "start" });
        }
    }

    function switchUniTab(tabName, tabBtn) {
        document.querySelectorAll(".dk-uni-tab-btn").forEach(btn => btn.classList.remove("active"));
        if (tabBtn) tabBtn.classList.add("active");

        const tabToCode = {
            'ALL': 'ALL',
            'UNITED KINGDOM': 'GB',
            'GERMANY': 'DE',
            'ITALY': 'IT',
            'UAE (DUBAI)': 'AE',
            'IRELAND': 'IE',
            'CANADA': 'CA',
            'USA': 'US',
            'OTHERS': 'OTHERS'
        };

        const code = tabToCode[tabName.toUpperCase()] || tabName;
        filterUniversitiesByCountry(code, tabName, false);
    }

    function filterUniversitiesByCountry(countryCode, countryName, syncTab = true) {
        const cards = document.querySelectorAll("#uniCardsGrid .dk-uni-card");
        let visibleCount = 0;

        const normCode = (countryCode || "").toUpperCase();
        const normName = (countryName || "").toUpperCase();

        cards.forEach(card => {
            const cardCountry = (card.dataset.country || "").toUpperCase();
            const cardCode = (card.dataset.code || "").toUpperCase();

            let match = false;
            if (normCode === "ALL" || !normCode) {
                match = true;
            } else if (normCode === "OTHERS") {
                match = (cardCountry !== "UNITED KINGDOM" && cardCountry !== "GERMANY" && cardCountry !== "ITALY" && cardCountry !== "UAE (DUBAI)" && cardCountry !== "IRELAND" && cardCountry !== "CANADA" && cardCountry !== "USA");
            } else {
                match = (cardCode === normCode || cardCountry.includes(normName) || normName.includes(cardCountry));
            }

            if (match) {
                card.style.display = "flex";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });

        // Update count text
        const countEl = document.getElementById("uniCountText");
        const filterTextEl = document.getElementById("uniCurrentFilterText");
        const emptyState = document.getElementById("uniEmptyState");

        if (countEl) countEl.textContent = visibleCount;
        if (filterTextEl) {
            filterTextEl.textContent = normCode === "ALL" ? "across all destinations" : `for ${countryName}`;
        }

        if (emptyState) {
            emptyState.style.display = visibleCount === 0 ? "block" : "none";
        }

        // Sync tab if requested
        if (syncTab) {
            document.querySelectorAll(".dk-uni-tab-btn").forEach(btn => {
                const btnTab = (btn.dataset.tab || "").toUpperCase();
                if (normCode === "ALL" && btnTab === "ALL") {
                    btn.classList.add("active");
                } else if (btnTab.includes(normName) || normName.includes(btnTab)) {
                    btn.classList.add("active");
                } else {
                    btn.classList.remove("active");
                }
            });
        }
    }

    function resetUniFilters() {
        selectDestination('ALL', 'All Destinations', '🌍', '850+ Unis');
    }

    function scrollDestCards(distance) {
        const track = document.getElementById("destCardsTrack");
        if (track) {
            track.scrollBy({ left: distance, behavior: 'smooth' });
        }
    }

    function openUniDetailsModal(name, country, courses, ranking) {
        openProgramDetails(name, `${courses} • ${ranking} (${country})`, 'overview');
    }

    function checkUniEligibility(name, country) {
        openConsultancyModal(`${name} (${country}) - Eligibility Check`);
    }

    // Dynamic Sticky Navbar Sync with Site Header (.dk-header)
    function syncConsultancyStickyNav() {
        const mainHeader = document.querySelector(".dk-header");
        const upgHeader = document.querySelector(".dk-upg-header");
        if (!upgHeader) return;
        if (mainHeader) {
            const rect = mainHeader.getBoundingClientRect();
            const offset = Math.max(0, Math.round(rect.bottom));
            upgHeader.style.top = offset + "px";
            if (window.scrollY > 35) {
                upgHeader.classList.add("is-stuck");
            } else {
                upgHeader.classList.remove("is-stuck");
            }
        } else {
            upgHeader.style.top = "0px";
        }
    }
    window.addEventListener("scroll", syncConsultancyStickyNav, { passive: true });
    window.addEventListener("resize", syncConsultancyStickyNav);
    document.addEventListener("DOMContentLoaded", syncConsultancyStickyNav);
    setTimeout(syncConsultancyStickyNav, 100);

    // Scroll to Top visibility
    window.addEventListener("scroll", function() {
        const btn = document.getElementById("btnScrollTop");
        if (btn) {
            btn.style.display = window.scrollY > 400 ? "flex" : "none";
        }
    });
</script>
