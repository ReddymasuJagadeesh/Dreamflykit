    .dk-rate-notes {
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.4;
    }
    .dk-rates-disclaimer {
        font-size: 12px;
        color: #94a3b8;
        line-height: 1.5;
        margin: 8px 0 0 0;
        font-style: italic;
