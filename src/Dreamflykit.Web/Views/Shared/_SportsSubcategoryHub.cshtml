<!-- Client-Side Reactive Filter & Search Engine -->
<script>
    (function () {
        var currentFilters = {
            search: '',
            brands: [],
            minPrice: 0,
            maxPrice: 999999,
            minDiscount: 0,
            minRating: 0,
            inStockOnly: false,
            sort: 'popularity'
        };

        window.spToggleDropdown = function (btn) {
            var parent = btn.closest('.sp-dropdown-pill');
            if (!parent) return;
            var wasOpen = parent.classList.contains('open');
            document.querySelectorAll('.sp-dropdown-pill.open').forEach(function (p) {
                p.classList.remove('open');
            });
            if (!wasOpen) {
                parent.classList.add('open');
            }
        };

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.sp-dropdown-pill')) {
                document.querySelectorAll('.sp-dropdown-pill.open').forEach(function (p) {
                    p.classList.remove('open');
                });
            }
        });

        window.spApplyPillFilter = function (group, val, inputEl) {
            if (group === 'brand') {
                currentFilters.brands = val === 'all' ? [] : [val.toLowerCase()];
                // Sync sidebar checkboxes
                document.querySelectorAll('.sp-filter-cb[data-filter="brand"]').forEach(function (cb) {
                    cb.checked = val !== 'all' && cb.value.toLowerCase() === val.toLowerCase();
                });
            } else if (group === 'price') {
                if (val === 'all') {
                    currentFilters.minPrice = 0; currentFilters.maxPrice = 999999;
                } else if (val === 'under-1000') {
                    currentFilters.minPrice = 0; currentFilters.maxPrice = 1000;
                } else if (val === '1000-2500') {
                    currentFilters.minPrice = 1000; currentFilters.maxPrice = 2500;
                } else if (val === '2500-5000') {
                    currentFilters.minPrice = 2500; currentFilters.maxPrice = 5000;
                } else if (val === 'above-5000') {
                    currentFilters.minPrice = 5000; currentFilters.maxPrice = 999999;
                }
            } else if (group === 'rating') {
                currentFilters.minRating = val === 'all' ? 0 : parseFloat(val);
            }
            inputEl.closest('.sp-dropdown-pill').classList.remove('open');
            spExecuteFilter();
        };

        window.spApplySort = function (val, label) {
            currentFilters.sort = val;
            var sortLbl = document.getElementById('spSortLabel');
            if (sortLbl) sortLbl.textContent = 'Sort by : ' + label;
            document.querySelectorAll('.sp-dropdown-pill.open').forEach(function (p) { p.classList.remove('open'); });
            spExecuteFilter();
        };

        window.spOnSearchChange = function (val) {
            currentFilters.search = (val || '').trim().toLowerCase();
            spExecuteFilter();
        };

        window.spTriggerFilter = function () {
            // Read brand checkboxes
            var selectedBrands = [];
            document.querySelectorAll('.sp-filter-cb[data-filter="brand"]:checked').forEach(function (cb) {
                selectedBrands.push(cb.value.toLowerCase());
            });
            currentFilters.brands = selectedBrands;

            // In-stock toggle
            var inStockEl = document.getElementById('spInStockToggle');
            currentFilters.inStockOnly = inStockEl ? inStockEl.checked : false;

            spExecuteFilter();
        };

        window.spSetPriceRange = function (min, max) {
            currentFilters.minPrice = min;
            currentFilters.maxPrice = max;
            spExecuteFilter();
        };

        window.spApplyCustomPrice = function () {
            var minVal = parseFloat(document.getElementById('spMinPriceInput').value || '0');
            var maxVal = parseFloat(document.getElementById('spMaxPriceInput').value || '999999');
            if (maxVal <= 0) maxVal = 999999;
            currentFilters.minPrice = minVal;
            currentFilters.maxPrice = maxVal;
            spExecuteFilter();
        };

        window.spSetMinDiscount = function (pct) {
            currentFilters.minDiscount = pct;
            spExecuteFilter();
        };

        window.spSetMinRating = function (rating) {
            currentFilters.minRating = rating;
            spExecuteFilter();
        };

        window.spResetAllFilters = function () {
            currentFilters = {
                search: '',
                brands: [],
                minPrice: 0,
                maxPrice: 999999,
                minDiscount: 0,
                minRating: 0,
                inStockOnly: false,
                sort: 'popularity'
            };

            // Reset UI inputs
            var searchInput = document.getElementById('spSearchInput');
            if (searchInput) searchInput.value = '';

            document.querySelectorAll('.sp-filter-cb').forEach(function (cb) { cb.checked = false; });
            document.querySelectorAll('input[name="side_price"][value="all"]').forEach(function (r) { r.checked = true; });
            document.querySelectorAll('input[name="side_discount"][value="0"]').forEach(function (r) { r.checked = true; });
            document.querySelectorAll('input[name="side_rating"][value="0"]').forEach(function (r) { r.checked = true; });
            document.querySelectorAll('input[name="pill_brand"][value="all"]').forEach(function (r) { r.checked = true; });
            document.querySelectorAll('input[name="pill_price"][value="all"]').forEach(function (r) { r.checked = true; });
            document.querySelectorAll('input[name="pill_rating"][value="all"]').forEach(function (r) { r.checked = true; });

            var minInp = document.getElementById('spMinPriceInput');
            var maxInp = document.getElementById('spMaxPriceInput');
            if (minInp) minInp.value = '';
            if (maxInp) maxInp.value = '';

            var inStockEl = document.getElementById('spInStockToggle');
            if (inStockEl) inStockEl.checked = false;

            var sortLbl = document.getElementById('spSortLabel');
            if (sortLbl) sortLbl.textContent = 'Sort by : Popularity';

            spExecuteFilter();
        };

        function spExecuteFilter() {
            var cards = Array.from(document.querySelectorAll('#spCatalogGrid .sp-card'));
            var visibleCount = 0;

            cards.forEach(function (card) {
                var name = card.getAttribute('data-name') || '';
                var brand = card.getAttribute('data-brand') || '';
                var price = parseFloat(card.getAttribute('data-price') || '0');
                var discount = parseInt(card.getAttribute('data-discount') || '0', 10);
                var rating = parseFloat(card.getAttribute('data-rating') || '0');
                var inStock = card.getAttribute('data-instock') === 'true';

                var matches = true;

                // Search query
                if (currentFilters.search && !name.includes(currentFilters.search) && !brand.includes(currentFilters.search)) {
                    matches = false;
                }

                // Brands
                if (matches && currentFilters.brands.length > 0 && !currentFilters.brands.includes(brand)) {
                    matches = false;
                }

                // Price
                if (matches && (price < currentFilters.minPrice || price > currentFilters.maxPrice)) {
                    matches = false;
                }

                // Discount
                if (matches && currentFilters.minDiscount > 0 && discount < currentFilters.minDiscount) {
                    matches = false;
                }

                // Rating
                if (matches && currentFilters.minRating > 0 && rating < currentFilters.minRating) {
                    matches = false;
                }

                // In stock
                if (matches && currentFilters.inStockOnly && !inStock) {
                    matches = false;
                }

                if (matches) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Sorting
            if (visibleCount > 0) {
                var grid = document.getElementById('spCatalogGrid');
                var visibleCards = cards.filter(function (c) { return c.style.display !== 'none'; });
                visibleCards.sort(function (a, b) {
                    var pa = parseFloat(a.getAttribute('data-price') || '0');
                    var pb = parseFloat(b.getAttribute('data-price') || '0');
                    var ra = parseFloat(a.getAttribute('data-rating') || '0');
                    var rb = parseFloat(b.getAttribute('data-rating') || '0');

                    if (currentFilters.sort === 'price-asc') return pa - pb;
                    if (currentFilters.sort === 'price-desc') return pb - pa;
                    if (currentFilters.sort === 'rating') return rb - ra;
                    return 0; // default popularity
                });
                visibleCards.forEach(function (c) { grid.appendChild(c); });
            }

            // Results count label
            var countLabel = document.getElementById('spResultsCount');
            if (countLabel) {
                countLabel.textContent = 'Showing ' + visibleCount + ' products in @subPage.CategoryName';
            }

            // Empty state toggle
            var emptyEl = document.getElementById('spEmptyResults');
            if (emptyEl) {
                emptyEl.style.display = visibleCount === 0 ? 'block' : 'none';
            }
        }
    })();
</script>

