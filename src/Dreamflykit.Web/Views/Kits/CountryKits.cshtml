<script>
function onSortChange(sortVal) {
    const url = new URL(window.location.href);
    url.searchParams.set('sort', sortVal);
    window.location.href = url.toString();
}

function onPriceSliderChange(val) {
    document.getElementById('priceRangeDisplay').innerText = '₹' + parseInt(val, 10).toLocaleString('en-IN') + '+';
    filterKitCards();
}

function filterKitCards() {
    const maxP = parseInt(document.getElementById('priceRangeInput')?.value || '25000', 10);
    const starEl = document.querySelector('input[name="starRating"]:checked');
    const minStar = parseFloat(starEl ? starEl.value : '0');

    const cards = document.querySelectorAll('.dk-ck-kit-card');
    let visible = 0;

    cards.forEach(card => {
        const p = parseFloat(card.getAttribute('data-price') || '0');
        const r = parseFloat(card.getAttribute('data-rating') || '0');

        if (p <= maxP && r >= minStar) {
            card.style.display = '';
            visible++;
        } else {
            card.style.display = 'none';
        }
    });

    const resultsEl = document.querySelector('.dk-ck-results-text');
    if (resultsEl) {
        resultsEl.innerText = `Showing 1-${visible} of ${visible} results`;
    }
}

function addCountryKitToCart(name, price) {
    showToast(`✓ Added "${name}" (₹${price.toLocaleString('en-IN')}) to your Cart!`);
}

function showToast(msg) {
    const t = document.getElementById('dk-ck-toast');
    if (!t) return;
    t.innerText = msg;
    t.classList.add('show');
    setTimeout(() => {
        t.classList.remove('show');
    }, 3200);
}
</script>
