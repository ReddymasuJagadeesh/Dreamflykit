<script>
function filterWomenProducts() {
    const cards = Array.from(document.querySelectorAll("#womenProductsGrid .dk-women-card"));
    if (!cards.length) return;

    // 1. Sizes
    const selectedSizes = Array.from(document.querySelectorAll(".dk-size-checkbox:checked")).map(cb => cb.value.toUpperCase());

    // 2. Colors
    const selectedColors = Array.from(document.querySelectorAll(".dk-color-checkbox:checked")).map(cb => cb.value.toUpperCase());

    // 3. Price
    const priceRadio = document.querySelector('input[name="womenPriceRange"]:checked')?.value || "all";
    const customMin = parseFloat(document.getElementById("womenMinPrice")?.value || "0");
    const customMax = parseFloat(document.getElementById("womenMaxPrice")?.value || "999999");

    let minP = 0, maxP = 999999;
    if (priceRadio !== "all") {
        const parts = priceRadio.split("-").map(Number);
        minP = parts[0];
        maxP = parts[1];
    }
    if (!isNaN(customMin) && customMin > 0) minP = Math.max(minP, customMin);
    if (!isNaN(customMax) && customMax > 0 && customMax < maxP) maxP = customMax;

    // 4. Discount
    const minDiscount = parseFloat(document.querySelector('input[name="womenDiscount"]:checked')?.value || "0");

    // 5. Rating
    const minRating = parseFloat(document.querySelector('input[name="womenRating"]:checked')?.value || "0");

    // 6. In Stock
    const inStockOnly = document.getElementById("womenInStockOnly")?.checked ?? true;

    let visibleCount = 0;

    cards.forEach(card => {
        const price = parseFloat(card.dataset.price || "0");
        const sizes = (card.dataset.sizes || "").toUpperCase().split(",");
        const colors = (card.dataset.colors || "").toUpperCase().split(",");
        const rating = parseFloat(card.dataset.rating || "0");
        const discount = parseFloat(card.dataset.discount || "0");
        const inStock = (card.dataset.instock || "true") === "true";

        let matches = true;

        if (selectedSizes.length > 0) {
            const hasSize = selectedSizes.some(s => sizes.includes(s) || sizes.includes("FREE SIZE") || s === "FREE SIZE");
            if (!hasSize) matches = false;
        }

        if (matches && selectedColors.length > 0) {
            const hasColor = selectedColors.some(c => colors.some(item => item.includes(c)));
            if (!hasColor) matches = false;
        }

        if (matches && (price < minP || price > maxP)) {
            matches = false;
        }

        if (matches && discount < minDiscount) {
            matches = false;
        }

        if (matches && rating < minRating) {
            matches = false;
        }

        if (matches && inStockOnly && !inStock) {
            matches = false;
        }

        if (matches) {
            card.style.display = "flex";
            visibleCount++;
        } else {
            card.style.display = "none";
        }
    });

    const countEl = document.getElementById("womenProductCount");
    if (countEl) countEl.innerText = visibleCount;

    const emptyState = document.getElementById("womenEmptyState");
    if (emptyState) {
        emptyState.style.display = (visibleCount === 0) ? "block" : "none";
    }
}

function resetWomenFilters() {
    document.querySelectorAll(".dk-size-checkbox").forEach(cb => cb.checked = false);
    document.querySelectorAll(".dk-color-checkbox").forEach(cb => cb.checked = false);
    const allPriceRadio = document.querySelector('input[name="womenPriceRange"][value="all"]');
    if (allPriceRadio) allPriceRadio.checked = true;
    const minPriceInput = document.getElementById("womenMinPrice");
    if (minPriceInput) minPriceInput.value = "";
    const maxPriceInput = document.getElementById("womenMaxPrice");
    if (maxPriceInput) maxPriceInput.value = "";
    const allDiscountRadio = document.querySelector('input[name="womenDiscount"][value="0"]');
    if (allDiscountRadio) allDiscountRadio.checked = true;
    const allRatingRadio = document.querySelector('input[name="womenRating"][value="0"]');
    if (allRatingRadio) allRatingRadio.checked = true;
    const stockToggle = document.getElementById("womenInStockOnly");
    if (stockToggle) stockToggle.checked = true;

    filterWomenProducts();
}

function sortWomenProducts(sortOption) {
    const grid = document.getElementById("womenProductsGrid");
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll(".dk-women-card"));

    cards.sort((a, b) => {
        const priceA = parseFloat(a.dataset.price || "0");
        const priceB = parseFloat(b.dataset.price || "0");
        const ratingA = parseFloat(a.dataset.rating || "0");
        const ratingB = parseFloat(b.dataset.rating || "0");
        const discountA = parseFloat(a.dataset.discount || "0");
        const discountB = parseFloat(b.dataset.discount || "0");

        switch (sortOption) {
            case "price-asc": return priceA - priceB;
            case "price-desc": return priceB - priceA;
            case "rating": return ratingB - ratingA;
            case "discount": return discountB - discountA;
            default: return 0;
        }
    });

    cards.forEach(card => grid.appendChild(card));
}

function toggleWomenWishlist(btn, event) {
    event.preventDefault();
    event.stopPropagation();
    btn.classList.toggle("active");
    const isActive = btn.classList.contains("active");
    showWomenToast(isActive ? "Added to your wishlist ❤️" : "Removed from wishlist");
}

function addWomenProductToCart(id, name, price, btn) {
    btn.disabled = true;
    const origHtml = btn.innerHTML;
    btn.innerHTML = `<span>Adding...</span>`;

    setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        showWomenToast(`Added "${name}" to your cart! 🛍️`);

        // Update header cart badge if present
        const badge = document.querySelector(".dk-cart-badge, .dk-badge-cart");
        if (badge) {
            const cur = parseInt(badge.innerText.trim()) || 0;
            badge.innerText = cur + 1;
        }
    }, 350);
}

function showWomenToast(msg) {
    const toast = document.getElementById("womenToast");
    const msgEl = document.getElementById("womenToastMessage");
    if (!toast || !msgEl) return;
    msgEl.innerText = msg;
    toast.style.display = "block";
    clearTimeout(window._womenToastTimer);
    window._womenToastTimer = setTimeout(() => {
        toast.style.display = "none";
    }, 2800);
}
</script>

