@model Dreamflykit.Application.StoryBooksHub.Models.StoryBooksHubDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Story Books & BooksFlix Hub Management";
    var hub = Model ?? Dreamflykit.Application.StoryBooksHub.Models.StoryBooksHubDto.CreateDefault();
    var theme = hub.ThemeSettings ?? new();
    var billboard = hub.HeroBillboard ?? new();
    var sbBanner = hub.StoryBooksBanner ?? new();
    var npBanner = hub.NewPopularBanner ?? new();
    var langBanner = hub.LanguagesBanner ?? new();
    var sections = hub.Sections ?? new();
    var genres = hub.Genres ?? new();
    var languages = hub.Languages ?? new();
    var preferences = hub.Preferences ?? new();
}

@Html.AntiForgeryToken()

<div class="dk-admin-content-container" style="max-width: 1400px; margin: 0 auto; padding: 24px 20px;">

    <!-- TOP HEADER & CONTROLS -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <span style="background: #E50914; color: #ffffff; font-size: 11px; font-weight: 900; padding: 4px 10px; border-radius: 4px; letter-spacing: 1px;">📚 BOOKSFLIX ADMIN</span>
                <span style="background: #1e293b; color: #94a3b8; font-size: 11px; font-weight: 700; padding: 4px 8px; border-radius: 4px;">NETFLIX HUB THEME</span>
            </div>
            <h1 style="font-size: 26px; font-weight: 900; color: #0f172a; margin: 0;">Story Books &amp; Literary Journals Management</h1>
            <p style="font-size: 13.5px; color: #64748b; margin: 4px 0 0 0;">
                Full administrative control over all 4 Tab Hero Banners, Journal dropdown options, book shelves, regional languages, and image uploads.
            </p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a href="/category/story-books" target="_blank" class="dk-btn" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 10px 18px; font-size: 13.5px; font-weight: 700; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <span>👁️</span> Preview Live Store
            </a>
            <form asp-action="ResetDefaults" method="post" style="display: inline;" onsubmit="return confirm('Reset all Story Books Hub settings to default BooksFlix template?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="dk-btn" style="background: #fff; color: #dc2626; border: 1px solid #fca5a5; padding: 10px 16px; font-size: 13px; font-weight: 700; border-radius: 8px; cursor: pointer;">
                    ↺ Reset Defaults
                </button>
            </form>
            <button type="button" class="dk-btn" id="btnSaveStoryBooksTop" onclick="saveStoryBooksHubConfig()" style="background: #E50914; color: #ffffff; border: none; padding: 11px 26px; font-size: 14px; font-weight: 800; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; box-shadow: 0 4px 14px rgba(229, 9, 20, 0.35);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Save All Changes
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #ecfdf5; border-left: 4px solid #10b981; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; color: #065f46; font-weight: 600;">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    <!-- TAB BUTTONS -->
    <div style="display: flex; gap: 8px; border-bottom: 2px solid #e2e8f0; margin-bottom: 24px; overflow-x: auto; padding-bottom: 4px;">
        <button type="button" class="dk-hub-tab-btn active" onclick="switchSbfAdminTab('billboards', this)">
            🎬 1. Tab Hero Banners (All 4 Tabs)
        </button>
        <button type="button" class="dk-hub-tab-btn" onclick="switchSbfAdminTab('sections', this)">
            📚 2. Shelves &amp; Book Collections (@sections.Count Shelves)
        </button>
        <button type="button" class="dk-hub-tab-btn" onclick="switchSbfAdminTab('genres', this)">
            📖 3. Genres &amp; Journals Dropdown (@genres.Count)
        </button>
        <button type="button" class="dk-hub-tab-btn" onclick="switchSbfAdminTab('languages', this)">
            🌐 4. Browse by Languages &amp; Preferences (@languages.Count Langs)
        </button>
        <button type="button" class="dk-hub-tab-btn" onclick="switchSbfAdminTab('theme', this)">
            🎨 5. Netflix Theme Settings
        </button>
    </div>

    <!-- ========================================================
         TAB 1: TAB HERO BANNERS (ALL 4 TABS)
    ========================================================= -->
    <div class="sbf-admin-tab-pane active" id="pane-billboards">

        <!-- 1.1 HOME TAB HERO BILLBOARD -->
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">1. Home Tab: Hero Billboard</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Full-width cinematic hero spotlight shown on Home tab.</p>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" id="billboard_IsEnabled" @(billboard.IsEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #E50914;" />
                    Enabled
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Title</label>
                            <input type="text" id="billboard_Title" class="sbf-input" value="@billboard.Title" />
                        </div>
                        <div>
                            <label class="sbf-label">Author / Creator</label>
                            <input type="text" id="billboard_Author" class="sbf-input" value="@billboard.Author" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Top Badge Label</label>
                            <input type="text" id="billboard_TagBadge" class="sbf-input" value="@billboard.TagBadge" />
                        </div>
                        <div>
                            <label class="sbf-label">Genre &amp; Meta Tags</label>
                            <input type="text" id="billboard_GenreTags" class="sbf-input" value="@billboard.GenreTags" />
                        </div>
                    </div>

                    <div>
                        <label class="sbf-label">Synopsis / Description</label>
                        <textarea id="billboard_Synopsis" class="sbf-input" rows="2">@billboard.Synopsis</textarea>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;">
                        <div>
                            <label class="sbf-label">Price (₹)</label>
                            <input type="number" id="billboard_Price" class="sbf-input" value="@billboard.Price" />
                        </div>
                        <div>
                            <label class="sbf-label">Original Price (₹)</label>
                            <input type="number" id="billboard_OriginalPrice" class="sbf-input" value="@billboard.OriginalPrice" />
                        </div>
                        <div>
                            <label class="sbf-label">Discount %</label>
                            <input type="number" id="billboard_DiscountPercent" class="sbf-input" value="@billboard.DiscountPercent" />
                        </div>
                        <div>
                            <label class="sbf-label">Rating (1-5)</label>
                            <input type="number" step="0.1" id="billboard_Rating" class="sbf-input" value="@billboard.Rating" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Button Text</label>
                            <input type="text" id="billboard_PrimaryButtonText" class="sbf-input" value="@billboard.PrimaryButtonText" />
                        </div>
                        <div>
                            <label class="sbf-label">Secondary Button Text</label>
                            <input type="text" id="billboard_SecondaryButtonText" class="sbf-input" value="@billboard.SecondaryButtonText" />
                        </div>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                    <div style="width: 100%; aspect-ratio: 16/9; background: #0f172a; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                        <img id="billboard_ImgPreview" src="@billboard.ImageUrl" alt="Home Banner Preview" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                        <div id="billboard_UploadingSoonTag" style="position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,0.8); color: #fff; font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 4px; @(billboard.IsUploadingSoon ? "" : "display: none;")">
                            Uploading Soon
                        </div>
                    </div>

                    <div style="width: 100%; margin-bottom: 12px;">
                        <label class="sbf-label">Banner Image URL</label>
                        <input type="text" id="billboard_ImageUrl" class="sbf-input" value="@billboard.ImageUrl" onchange="document.getElementById('billboard_ImgPreview').src = this.value;" />
                    </div>

                    <div style="width: 100%; margin-bottom: 12px;">
                        <input type="file" id="billboard_File" accept="image/*" style="display: none;" onchange="uploadImageDirect(this, 'billboard_ImageUrl', 'billboard_ImgPreview')" />
                        <button type="button" class="dk-btn" onclick="document.getElementById('billboard_File').click();" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                            📁 Upload Home Banner Image
                        </button>
                    </div>

                    <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                        <input type="checkbox" id="billboard_IsUploadingSoon" @(billboard.IsUploadingSoon ? "checked" : "") onchange="document.getElementById('billboard_UploadingSoonTag').style.display = this.checked ? 'block' : 'none';" style="accent-color: #E50914;" />
                        Mark as "Uploading Soon" (Admin Replaceable)
                    </label>
                </div>
            </div>
        </div>

        <!-- 1.2 STORY BOOKS TAB HERO BANNER -->
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">2. Story Books Tab: Hero Banner</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Full-width hero banner shown on Story Books tab (and updates on journal selection).</p>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" id="sbBanner_IsEnabled" @(sbBanner.IsEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #E50914;" />
                    Enabled
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <label class="sbf-label">Title</label>
                        <input type="text" id="sbBanner_Title" class="sbf-input" value="@sbBanner.Title" />
                    </div>
                    <div>
                        <label class="sbf-label">Top Badge Label</label>
                        <input type="text" id="sbBanner_TagBadge" class="sbf-input" value="@sbBanner.TagBadge" />
                    </div>
                    <div>
                        <label class="sbf-label">Meta Tags Line</label>
                        <input type="text" id="sbBanner_MetaTags" class="sbf-input" value="@sbBanner.MetaTags" />
                    </div>
                    <div>
                        <label class="sbf-label">Subtitle / Synopsis</label>
                        <textarea id="sbBanner_Subtitle" class="sbf-input" rows="2">@sbBanner.Subtitle</textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Button Text</label>
                            <input type="text" id="sbBanner_PrimaryButtonText" class="sbf-input" value="@sbBanner.PrimaryButtonText" />
                        </div>
                        <div>
                            <label class="sbf-label">Secondary Button Text</label>
                            <input type="text" id="sbBanner_SecondaryButtonText" class="sbf-input" value="@sbBanner.SecondaryButtonText" />
                        </div>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                    <div style="width: 100%; aspect-ratio: 16/9; background: #0f172a; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                        <img id="sbBanner_ImgPreview" src="@sbBanner.ImageUrl" alt="Story Books Banner Preview" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <label class="sbf-label">Banner Image URL</label>
                        <input type="text" id="sbBanner_ImageUrl" class="sbf-input" value="@sbBanner.ImageUrl" onchange="document.getElementById('sbBanner_ImgPreview').src = this.value;" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <input type="file" id="sbBanner_File" accept="image/*" style="display: none;" onchange="uploadImageDirect(this, 'sbBanner_ImageUrl', 'sbBanner_ImgPreview')" />
                        <button type="button" class="dk-btn" onclick="document.getElementById('sbBanner_File').click();" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                            📁 Upload Story Books Banner Image
                        </button>
                    </div>
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                        <input type="checkbox" id="sbBanner_IsUploadingSoon" @(sbBanner.IsUploadingSoon ? "checked" : "") style="accent-color: #E50914;" />
                        Mark as "Uploading Soon" (Admin Replaceable)
                    </label>
                </div>
            </div>
        </div>

        <!-- 1.3 NEW & POPULAR TAB HERO BANNER -->
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">3. New &amp; Popular Tab: Hero Banner</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Full-width hero banner shown on New &amp; Popular tab.</p>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" id="npBanner_IsEnabled" @(npBanner.IsEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #E50914;" />
                    Enabled
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <label class="sbf-label">Title</label>
                        <input type="text" id="npBanner_Title" class="sbf-input" value="@npBanner.Title" />
                    </div>
                    <div>
                        <label class="sbf-label">Top Badge Label</label>
                        <input type="text" id="npBanner_TagBadge" class="sbf-input" value="@npBanner.TagBadge" />
                    </div>
                    <div>
                        <label class="sbf-label">Meta Tags Line</label>
                        <input type="text" id="npBanner_MetaTags" class="sbf-input" value="@npBanner.MetaTags" />
                    </div>
                    <div>
                        <label class="sbf-label">Subtitle / Synopsis</label>
                        <textarea id="npBanner_Subtitle" class="sbf-input" rows="2">@npBanner.Subtitle</textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Button Text</label>
                            <input type="text" id="npBanner_PrimaryButtonText" class="sbf-input" value="@npBanner.PrimaryButtonText" />
                        </div>
                        <div>
                            <label class="sbf-label">Secondary Button Text</label>
                            <input type="text" id="npBanner_SecondaryButtonText" class="sbf-input" value="@npBanner.SecondaryButtonText" />
                        </div>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                    <div style="width: 100%; aspect-ratio: 16/9; background: #0f172a; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                        <img id="npBanner_ImgPreview" src="@npBanner.ImageUrl" alt="New Popular Banner Preview" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <label class="sbf-label">Banner Image URL</label>
                        <input type="text" id="npBanner_ImageUrl" class="sbf-input" value="@npBanner.ImageUrl" onchange="document.getElementById('npBanner_ImgPreview').src = this.value;" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <input type="file" id="npBanner_File" accept="image/*" style="display: none;" onchange="uploadImageDirect(this, 'npBanner_ImageUrl', 'npBanner_ImgPreview')" />
                        <button type="button" class="dk-btn" onclick="document.getElementById('npBanner_File').click();" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                            📁 Upload New &amp; Popular Banner Image
                        </button>
                    </div>
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                        <input type="checkbox" id="npBanner_IsUploadingSoon" @(npBanner.IsUploadingSoon ? "checked" : "") style="accent-color: #E50914;" />
                        Mark as "Uploading Soon" (Admin Replaceable)
                    </label>
                </div>
            </div>
        </div>

        <!-- 1.4 BROWSE BY LANGUAGE TAB HERO BANNER -->
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">4. Browse by Language Tab: Hero Banner</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Full-width hero banner shown on Browse by Language tab.</p>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" id="langBanner_IsEnabled" @(langBanner.IsEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #E50914;" />
                    Enabled
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <label class="sbf-label">Title</label>
                        <input type="text" id="langBanner_Title" class="sbf-input" value="@langBanner.Title" />
                    </div>
                    <div>
                        <label class="sbf-label">Top Badge Label</label>
                        <input type="text" id="langBanner_TagBadge" class="sbf-input" value="@langBanner.TagBadge" />
                    </div>
                    <div>
                        <label class="sbf-label">Meta Tags Line</label>
                        <input type="text" id="langBanner_MetaTags" class="sbf-input" value="@langBanner.MetaTags" />
                    </div>
                    <div>
                        <label class="sbf-label">Subtitle / Synopsis</label>
                        <textarea id="langBanner_Subtitle" class="sbf-input" rows="2">@langBanner.Subtitle</textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Button Text</label>
                            <input type="text" id="langBanner_PrimaryButtonText" class="sbf-input" value="@langBanner.PrimaryButtonText" />
                        </div>
                        <div>
                            <label class="sbf-label">Secondary Button Text</label>
                            <input type="text" id="langBanner_SecondaryButtonText" class="sbf-input" value="@langBanner.SecondaryButtonText" />
                        </div>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                    <div style="width: 100%; aspect-ratio: 16/9; background: #0f172a; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                        <img id="langBanner_ImgPreview" src="@langBanner.ImageUrl" alt="Languages Banner Preview" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <label class="sbf-label">Banner Image URL</label>
                        <input type="text" id="langBanner_ImageUrl" class="sbf-input" value="@langBanner.ImageUrl" onchange="document.getElementById('langBanner_ImgPreview').src = this.value;" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <input type="file" id="langBanner_File" accept="image/*" style="display: none;" onchange="uploadImageDirect(this, 'langBanner_ImageUrl', 'langBanner_ImgPreview')" />
                        <button type="button" class="dk-btn" onclick="document.getElementById('langBanner_File').click();" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                            📁 Upload Languages Banner Image
                        </button>
                    </div>
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                        <input type="checkbox" id="langBanner_IsUploadingSoon" @(langBanner.IsUploadingSoon ? "checked" : "") style="accent-color: #E50914;" />
                        Mark as "Uploading Soon" (Admin Replaceable)
                    </label>
                </div>
            </div>
        </div>

    </div>

    <!-- ========================================================
         TAB 2: SHELVES & BOOK COLLECTIONS
    ========================================================= -->
    <div class="sbf-admin-tab-pane" id="pane-sections">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <p style="margin: 0; font-size: 14px; color: #64748b;">
                Manage horizontal carousel shelves, Top 10 rankings, book covers, and pricing.
            </p>
            <button type="button" class="dk-btn" onclick="addNewSectionPrompt()" style="background: #10b981; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                + Add New Shelf Section
            </button>
        </div>

        <div id="sbf-sections-container">
