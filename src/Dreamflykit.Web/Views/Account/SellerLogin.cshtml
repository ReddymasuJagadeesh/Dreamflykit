@model Dreamflykit.Web.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Seller Central Login — Dreamflykit Partner Portal";
    Layout = "_Layout";
}

<div class="dk-auth-page-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-12 col-lg-10 col-xl-9">
                <div class="card border-0 shadow-lg overflow-hidden rounded-4">
                    <div class="row g-0">
                        <!-- Left Panel: Seller Brand & Benefits -->
                        <div class="col-lg-5 p-4 p-md-5 text-white d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #312e81 100%);">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-4">
                                    <span class="badge bg-indigo-soft text-warning px-3 py-2 rounded-pill fw-semibold border border-warning border-opacity-25">
                                        <i class="bi bi-shop me-1"></i> PARTNER PORTAL
                                    </span>
                                </div>
                                <h2 class="display-6 fw-bold mb-3 text-white">Dreamflykit Seller Central</h2>
                                <p class="text-white-50 leading-relaxed mb-4">
                                    Manage your travel kit catalog, submit new student travel gear for approval, and promote products across the storefront.
                                </p>

                                <div class="seller-perks-list d-flex flex-column gap-3 mb-4">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="bg-success bg-opacity-25 text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
                                            <i class="bi bi-shield-check"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-white">Super Admin Price Guarantee</div>
                                            <small class="text-white-50">You focus on great travel gear; our pricing team sets competitive, verified MRP &amp; selling prices.</small>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-start gap-3">
                                        <div class="bg-info bg-opacity-25 text-info rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
                                            <i class="bi bi-megaphone"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-white">One-Click Promote All</div>
                                            <small class="text-white-50">Instantly spotlight all your approved products across student search and category listings.</small>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-start gap-3">
                                        <div class="bg-warning bg-opacity-25 text-warning rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
                                            <i class="bi bi-lightning-charge"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-white">Immediate Review Queue</div>
                                            <small class="text-white-50">Submissions immediately dispatch to the Super Admin desk for quick verification &amp; launch.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-3 border-top border-white border-opacity-10 text-white-50 small">
                                <i class="bi bi-lock me-1"></i> Encrypted 256-bit Secure Vendor Session
                            </div>
                        </div>

                        <!-- Right Panel: Sign In Form -->
                        <div class="col-lg-7 p-4 p-md-5 bg-white">
                            <div class="mb-4">
                                <h3 class="fw-bold text-dark mb-1">Sign In to Your Store</h3>
                                <p class="text-muted small">Enter your authorized seller credentials to access your dashboard.</p>
                            </div>

                            <!-- Admin Provisioning Notice -->
                            <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark rounded-3 p-3 mb-4 d-flex align-items-start gap-2">
                                <i class="bi bi-info-circle-fill text-warning fs-5 flex-shrink-0 mt-1"></i>
                                <div class="small">
                                    <strong>Super Admin Managed:</strong> Seller accounts are registered exclusively by the Super Admin. If you need vendor access or password reset, contact support.
                                </div>
                            </div>

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-3 small mb-4" role="alert"></div>
                            }

                            <form asp-controller="Account"
                                  asp-action="Login"
                                  asp-route-returnUrl="@Model.ReturnUrl"
                                  method="post"
                                  novalidate>

                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label fw-semibold small text-secondary">SELLER EMAIL</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="bi bi-envelope"></i>
                                        </span>
                                        <input asp-for="Email"
                                               type="email"
                                               class="form-control border-start-0 ps-0"
                                               placeholder="seller@yourstore.com"
                                               autocomplete="email"
                                               required
                                               autofocus />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label asp-for="Password" class="form-label fw-semibold small text-secondary mb-0">PASSWORD</label>
                                    </div>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="bi bi-key"></i>
                                        </span>
                                        <input asp-for="Password"
                                               type="password"
                                               class="form-control border-start-0 ps-0"
                                               placeholder="••••••••••••"
                                               autocomplete="current-password"
                                               required />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                                        <label class="form-check-label small text-muted" for="rememberMeCheck">
                                            Remember this seller device
                                        </label>
                                    </div>
                                </div>

                                <button type="submit"
                                        id="sellerLoginSubmitBtn"
                                        class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                                        style="background: #4f46e5; border-color: #4f46e5;">
                                    <span>Access Seller Portal</span>
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </form>

                            <div class="mt-4 pt-3 border-top text-center">
                                <p class="text-muted small mb-0">
                                    Looking for regular shopping? 
                                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold">Customer Sign In</a>
                                    <span class="mx-2 text-muted">|</span>
                                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Return to Storefront</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
