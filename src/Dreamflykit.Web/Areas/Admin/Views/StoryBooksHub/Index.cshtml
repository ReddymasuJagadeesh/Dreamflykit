            </div>
            <div>
                <label class="sbf-label-sm">Original Price (₹)</label>
                <input type="number" class="sbf-input book-orig-price" value="599" style="font-size: 12px;" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 6px;">
            <div>
                <label class="sbf-label-sm">Genre</label>
                <input type="text" class="sbf-input book-genre-slug" value="campus-fiction" style="font-size: 11px;" />
            </div>
            <div>
                <label class="sbf-label-sm">Language</label>
                <input type="text" class="sbf-input book-lang" value="English" style="font-size: 11px;" />
            </div>
        </div>

        <div style="margin-bottom: 6px;">
            <label class="sbf-label-sm">Cover Image URL</label>
            <input type="text" class="sbf-input book-cover-url" value="/images/fashion-hub/uploading-soon-placeholder.svg" style="font-size: 11px;" />
        </div>

        <div style="display: flex; gap: 6px; align-items: center; justify-content: space-between;">
            <input type="file" accept="image/*" style="display: none;" onchange="uploadBookCardImage(this)" />
            <button type="button" onclick="this.previousElementSibling.click();" style="background: #e2e8f0; border: none; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer;">
                Upload Cover
            </button>
            <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; cursor: pointer;">
                <input type="checkbox" class="book-uploading-soon" checked style="accent-color: #E50914;" />
                Uploading Soon
            </label>
        </div>
    </div>`;

    grid.insertAdjacentHTML('beforeend', html);
    if (countSpan) countSpan.innerText = grid.querySelectorAll('.sbf-book-editor-card').length;
}

function removeBookCard(btn) {
    const card = btn.closest('.sbf-book-editor-card');
    const sec = card.closest('.sbf-section-card');
    card.remove();
    if (sec) {
        const countSpan = sec.querySelector('.books-count');
        const grid = sec.querySelector('.sbf-books-editor-grid');
        if (countSpan && grid) countSpan.innerText = grid.querySelectorAll('.sbf-book-editor-card').length;
    }
}

