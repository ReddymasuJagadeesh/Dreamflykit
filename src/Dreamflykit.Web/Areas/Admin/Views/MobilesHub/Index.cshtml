                                <label style="display: block; font-size: 11px; font-weight: 700; color: #1e40af;">Custom 3D Model (.glb)</label>
                                <button type="button" onclick="triggerFileUpload(this, '3d')" style="width: 100%; background: #1e40af; color: #ffffff; border: none; padding: 8px 10px; font-size: 11.5px; font-weight: 700; border-radius: 6px; cursor: pointer;">Upload .GLB</button>
