@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.ElectronicsHub ?? Dreamflykit.Application.ElectronicsHub.Models.ElectronicsHubDto.CreateDefault();
    var currentSubSlug = (Model.CurrentSubcategorySlug ?? "").Trim().ToLowerInvariant();

    // Match active subcategory page or find matching alias
    var activePage = hub.SubcategoryPages?.FirstOrDefault(p =>
        string.Equals(p.CategorySlug, currentSubSlug, StringComparison.OrdinalIgnoreCase) ||
        (currentSubSlug.Contains("laptop") && p.CategorySlug.Contains("laptop")) ||
        ((currentSubSlug.Contains("earphone") || currentSubSlug.Contains("headphone") || currentSubSlug.Contains("audio")) && (p.CategorySlug.Contains("earphone") || p.CategorySlug.Contains("headphone"))) ||
        (currentSubSlug.Contains("groom") && p.CategorySlug.Contains("groom")) ||
        ((currentSubSlug.Contains("case") || currentSubSlug.Contains("cover")) && p.CategorySlug.Contains("case")) ||
        ((currentSubSlug.Contains("storage") || currentSubSlug.Contains("ssd")) && p.CategorySlug.Contains("storage")) ||
        ((currentSubSlug.Contains("charger") || currentSubSlug.Contains("cable") || currentSubSlug.Contains("adapter")) && (p.CategorySlug.Contains("charger") || p.CategorySlug.Contains("cable"))) ||
        (currentSubSlug.Contains("power") && p.CategorySlug.Contains("power")) ||
        (currentSubSlug.Contains("watch") && p.CategorySlug.Contains("watch")) ||
        ((currentSubSlug.Contains("accessory") || currentSubSlug.Contains("accessories") || currentSubSlug.Contains("mouse") || currentSubSlug.Contains("keyboard")) && p.CategorySlug.Contains("access")) ||
        (currentSubSlug.Contains("speaker") && p.CategorySlug.Contains("speaker")));

    if (activePage == null)
    {
        var defaultPages = Dreamflykit.Application.ElectronicsHub.Models.ElectronicsHubDto.CreateDefaultSubcategoryPages();
        activePage = defaultPages.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSubSlug, StringComparison.OrdinalIgnoreCase) ||
            (currentSubSlug.Contains("laptop") && p.CategorySlug.Contains("laptop")))
            ?? defaultPages.First();
    }

    var hero = activePage.HeroBanner ?? new();
    var shopByBrands = activePage.ShopByBrands ?? new();
    var brands = shopByBrands.Brands != null && shopByBrands.Brands.Count > 0
        ? shopByBrands.Brands.Where(b => b.IsActive).OrderBy(b => b.DisplayOrder).ToList()
        : new List<Dreamflykit.Application.ElectronicsHub.Models.ElectronicsBrandItemDto>();

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    // All 10 categories for the left sidebar switcher
    var allCategories = hub.CategoriesSection?.Categories?.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToList()
        ?? Dreamflykit.Application.ElectronicsHub.Models.ElectronicsHubDto.CreateDefault().CategoriesSection.Categories;

    // Subcategory curated products
    var curatedProducts = activePage.CuratedProducts != null && activePage.CuratedProducts.Count > 0
        ? activePage.CuratedProducts.Where(p => p.IsActive).ToList()
        : new List<Dreamflykit.Application.ElectronicsHub.Models.ElectronicsProductItemDto>();

    // DB products if available
    var dbProducts = Model.Products ?? new List<Dreamflykit.Application.Catalog.Models.ProductListItem>();
    var totalProductsCount = dbProducts.Count > 0 ? dbProducts.Count : curatedProducts.Count;

    var isHeroSoon = hero.IsUploadingSoon || string.IsNullOrWhiteSpace(hero.ImageUrl) || hero.ImageUrl.Contains("placeholder");
    var minBannerHeight = hero.BannerHeight > 0 ? hero.BannerHeight : 400;

    // Equipment spec types for this category
    var equipmentTypes = activePage.EquipmentTypes != null && activePage.EquipmentTypes.Count > 0
        ? activePage.EquipmentTypes
        : new List<string> { "Standard", "Pro Setup", "Student Certified", "Travel Essential" };
}

<div class="dk-elec-sub-hub-root" id="electronicsSubcategoryRoot">

    <!-- Admin Quick Bar -->
    @if (canManage)
    {
        <div class="dk-elec-sub-admin-bar">
            <div class="dk-elec-sub-admin-left">
                <span class="dk-elec-sub-admin-badge">⚡ Admin Mode</span>
                <span class="dk-elec-sub-admin-hint">
                    Managing Subcategory: <strong>@activePage.CategoryName</strong> &bull; Customize hero banner, shop by brands, &amp; upload images anytime.
                </span>
            </div>
            <a href="/Admin/ElectronicsHub#sub-@activePage.CategorySlug" class="dk-elec-sub-admin-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Edit @activePage.CategoryName in Admin
            </a>
        </div>
    }

    <!-- ============================================================
         1. SUBCATEGORY HERO BANNER (100% FULL WIDTH EDGE-TO-EDGE)
    ============================================================ -->
    @if (hero.IsEnabled)
    {
        var titleColor = !string.IsNullOrWhiteSpace(hero.TitleColor) ? hero.TitleColor : "#063f91";
        var highlightColor = !string.IsNullOrWhiteSpace(hero.TitleHighlightColor) ? hero.TitleHighlightColor : "#0284c7";
        var subtitleColor = !string.IsNullOrWhiteSpace(hero.SubtitleColor) ? hero.SubtitleColor : "#334155";

        <section class="dk-elec-sub-hero-section full-width-hero" style="min-height: @(minBannerHeight)px;" aria-label="@activePage.CategoryName Showcase">
            
            <!-- Full Width Background Layer -->
            @if (isHeroSoon)
            {
                <div class="dk-elec-sub-hero-soon">
                    <div class="dk-elec-hero-radar-box">
                        <span class="dk-elec-radar-ring ring-1"></span>
                        <span class="dk-elec-radar-ring ring-2"></span>
                        <span class="dk-elec-hero-radar-emoji">@activePage.Emoji</span>
                    </div>
                    <div class="dk-elec-sub-soon-pill">
                        <span class="dk-elec-pulse-dot">●</span> HERO BANNER UPLOADING SOON
                    </div>
                    <p class="dk-elec-sub-soon-sub">High-resolution banner will be uploaded by admin</p>
                </div>
            }
            else
            {
                <img src="@hero.ImageUrl"
                     alt="@hero.Title @hero.TitleHighlight"
                     class="dk-elec-sub-hero-bg"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                <div class="dk-elec-sub-hero-soon" style="display: none;">
                    <div class="dk-elec-hero-radar-box">
                        <span class="dk-elec-radar-ring ring-1"></span>
                        <span class="dk-elec-radar-ring ring-2"></span>
                        <span class="dk-elec-hero-radar-emoji">@activePage.Emoji</span>
                    </div>
                    <div class="dk-elec-sub-soon-pill">
                        <span class="dk-elec-pulse-dot">●</span> HERO BANNER UPLOADING SOON
                    </div>
                    <p class="dk-elec-sub-soon-sub">High-resolution banner will be uploaded by admin</p>
                </div>
            }

            <div class="dk-elec-sub-hero-overlay"></div>

            <!-- Content Overlayed -->
            <div class="dk-elec-sub-hero-content dk-shell">
                <nav class="dk-elec-sub-breadcrumb" aria-label="Breadcrumb">
                    <a href="/category/electronics">Electronics</a>
                    <span class="dk-elec-sub-sep">/</span>
                    <span class="dk-elec-sub-crumb-active">@activePage.CategoryName</span>
                </nav>

                <div class="dk-elec-sub-hero-badge">
                    <span class="dk-elec-sub-pulse"></span>
                    <span>@activePage.Emoji OFFICIAL CAMPUS TECH &bull; UP TO 50% OFF</span>
                </div>

                <h1 class="dk-elec-sub-hero-title" style="color: @titleColor;">
                    @hero.Title
                    <span class="dk-elec-sub-hero-highlight" style="color: @highlightColor;">@hero.TitleHighlight</span>
                </h1>

                <p class="dk-elec-sub-hero-desc" style="color: @subtitleColor;">
                    @hero.Subtitle
                </p>

                <!-- Badges Row -->
                <div class="dk-elec-sub-badges-row">
                    <span class="dk-elec-sub-badge-chip">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                        110V–240V Universal Power
                    </span>
                    <span class="dk-elec-sub-badge-chip">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        Global Campus Warranty
                    </span>
                    <span class="dk-elec-sub-badge-chip">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Express Pre-Flight Dispatch
                    </span>
                </div>
            </div>

        </section>
    }

    <!-- ============================================================
         2. SHOP BY BRANDS SECTION (BELOW HERO BANNER)
    ============================================================ -->
    @if (shopByBrands.IsEnabled && brands.Count > 0)
    {
        <section class="dk-elec-brands-section dk-shell" aria-label="Shop @activePage.CategoryName by Brands">
            
            <div class="dk-elec-brands-header">
                <div class="dk-elec-brands-header-left">
                    <div class="dk-elec-brands-pretitle">AUTHORIZED BRAND SHOWCASE</div>
                    <h2 class="dk-elec-brands-title">@shopByBrands.Title for @activePage.CategoryName</h2>
                    <p class="dk-elec-brands-sub">@shopByBrands.Subtitle</p>
                </div>
                <div class="dk-elec-brands-header-right">
                    <span class="dk-elec-brands-count">🏷️ <strong>@brands.Count</strong> Authorized Brands</span>
                </div>
            </div>

            <!-- Brands Grid -->
            <div class="dk-elec-brands-grid">
                @foreach (var brand in brands)
                {
                    var brandSlug = !string.IsNullOrWhiteSpace(brand.Slug)
                        ? brand.Slug
                        : brand.Name.Trim().ToLowerInvariant().Replace(" ", "-").Replace("&", "and");

                    var isBrandSoon = brand.IsUploadingSoon || string.IsNullOrWhiteSpace(brand.LogoUrl) || brand.LogoUrl.Contains("uploading-soon");

                    <div class="dk-elec-brand-card"
                         data-brand-slug="@brandSlug"
                         data-brand-name="@brand.Name"
                         onclick="elecSelectBrandFilter('@brand.Name')"
                         title="Filter by @brand.Name for @activePage.CategoryName">
                        
                        <div class="dk-elec-brand-logo-box">
                            @if (isBrandSoon)
                            {
                                <div class="dk-elec-brand-placeholder">
                                    <span class="dk-elec-brand-initial">@brand.Name.FirstOrDefault()</span>
                                    <span class="dk-elec-brand-soon-badge">Uploading Soon</span>
                                </div>
                            }
                            else
                            {
                                <img src="@brand.LogoUrl"
                                     alt="@brand.Name"
                                     loading="lazy"
                                     class="dk-elec-brand-logo-img"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="dk-elec-brand-placeholder" style="display: none;">
                                    <span class="dk-elec-brand-initial">@brand.Name.FirstOrDefault()</span>
                                    <span class="dk-elec-brand-soon-badge">Uploading Soon</span>
                                </div>
                            }
                        </div>

                        <span class="dk-elec-brand-name">@brand.Name</span>
                        <span class="dk-elec-brand-tap-hint">Tap to filter</span>
                    </div>
                }
            </div>

        </section>
    }

    <!-- ============================================================
         3. 2-COLUMN LAYOUT: LEFT SIDE FILTERS + RIGHT SIDE PRODUCTS
    ============================================================ -->
    <div class="dk-elec-layout dk-shell">

        <!-- LEFT SIDEBAR: REACTIVE FILTERS -->
        <aside class="dk-elec-sidebar" id="elecSidebar">
            <div class="dk-elec-sidebar-header">
                <h3 class="dk-elec-sidebar-title">
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd"/></svg>
                    <span>Filters</span>
                </h3>
                <button type="button" class="dk-elec-btn-clear-filters" onclick="elecResetAllFilters()">Clear All</button>
            </div>

            <!-- Filter Group 1: 10 Categories Switcher -->
            <div class="dk-elec-filter-box">
                <h4 class="dk-elec-filter-title">
                    <span>Electronics Categories</span>
                    <span class="dk-elec-badge-pill">10 Categories</span>
                </h4>
                <div class="dk-elec-cat-switcher-list">
                    @foreach (var cat in allCategories)
                    {
                        var isActiveCat = string.Equals(cat.Slug, activePage.CategorySlug, StringComparison.OrdinalIgnoreCase)
                            || (cat.Slug.Contains("laptop") && activePage.CategorySlug.Contains("laptop"))
                            || (cat.Slug.Contains("earphone") && activePage.CategorySlug.Contains("earphone"))
                            || (cat.Slug.Contains("groom") && activePage.CategorySlug.Contains("groom"))
                            || (cat.Slug.Contains("case") && activePage.CategorySlug.Contains("case"))
                            || (cat.Slug.Contains("storage") && activePage.CategorySlug.Contains("storage"))
                            || (cat.Slug.Contains("charger") && activePage.CategorySlug.Contains("charger"))
                            || (cat.Slug.Contains("power") && activePage.CategorySlug.Contains("power"))
                            || (cat.Slug.Contains("watch") && activePage.CategorySlug.Contains("watch"))
                            || (cat.Slug.Contains("access") && activePage.CategorySlug.Contains("access"))
                            || (cat.Slug.Contains("speaker") && activePage.CategorySlug.Contains("speaker"));

                        <a href="/category/electronics/@cat.Slug" class="dk-elec-cat-switch-item @(isActiveCat ? "active" : "")" title="Go to @cat.Name">
                            <span class="dk-elec-cat-switch-emoji">@cat.Emoji</span>
                            <span class="dk-elec-cat-switch-name">@cat.Name</span>
                            @if (isActiveCat)
                            {
                                <span class="dk-elec-cat-switch-dot">●</span>
                            }
                        </a>
                    }
                </div>
            </div>

            <!-- Filter Group 2: Brand Checkboxes -->
            @if (brands.Count > 0)
            {
                <div class="dk-elec-filter-box">
                    <h4 class="dk-elec-filter-title">
                        <span>Brand</span>
                    </h4>
                    <div class="dk-elec-filter-options-list">
                        @foreach (var brand in brands)
                        {
                            <label class="dk-elec-checkbox-label">
                                <input type="checkbox" class="dk-elec-filter-cb" data-filter="brand" value="@brand.Name" onchange="elecTriggerFilter()">
                                <span class="dk-elec-cb-custom"></span>
                                <span class="dk-elec-cb-text">@brand.Name</span>
                            </label>
                        }
                    </div>
                </div>
            }

            <!-- Filter Group 3: Category Equipment / Spec Types -->
            @if (equipmentTypes.Count > 0)
            {
                <div class="dk-elec-filter-box">
                    <h4 class="dk-elec-filter-title">
                        <span>Type &amp; Specs</span>
                    </h4>
                    <div class="dk-elec-filter-options-list">
                        @foreach (var eq in equipmentTypes)
                        {
                            <label class="dk-elec-checkbox-label">
                                <input type="checkbox" class="dk-elec-filter-cb" data-filter="type" value="@eq" onchange="elecTriggerFilter()">
                                <span class="dk-elec-cb-custom"></span>
                                <span class="dk-elec-cb-text">@eq</span>
                            </label>
                        }
                    </div>
                </div>
            }

            <!-- Filter Group 4: Price Range -->
            <div class="dk-elec-filter-box">
                <h4 class="dk-elec-filter-title">
                    <span>Price Range</span>
                </h4>
                <div class="dk-elec-filter-options-list">
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_price" value="all" checked onchange="elecSetPriceRange(0, 999999)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">All Prices</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_price" value="under-2000" onchange="elecSetPriceRange(0, 2000)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">Under ₹2,000</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_price" value="2000-10000" onchange="elecSetPriceRange(2000, 10000)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">₹2,000 – ₹10,000</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_price" value="10000-30000" onchange="elecSetPriceRange(10000, 30000)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">₹10,000 – ₹30,000</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_price" value="above-30000" onchange="elecSetPriceRange(30000, 999999)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">₹30,000 &amp; Above</span>
                    </label>
                </div>

                <!-- Custom Min/Max Inputs -->
                <div class="dk-elec-custom-price-row">
                    <div class="dk-elec-price-input-wrap">
                        <span class="dk-elec-currency">₹</span>
                        <input type="number" id="elecMinPriceInput" placeholder="Min" min="0" class="dk-elec-price-inp">
                    </div>
                    <span class="dk-elec-price-dash">–</span>
                    <div class="dk-elec-price-input-wrap">
                        <span class="dk-elec-currency">₹</span>
                        <input type="number" id="elecMaxPriceInput" placeholder="Max" min="0" class="dk-elec-price-inp">
                    </div>
                    <button type="button" class="dk-elec-btn-price-go" onclick="elecApplyCustomPrice()">Go</button>
                </div>
            </div>

            <!-- Filter Group 5: Discount -->
            <div class="dk-elec-filter-box">
                <h4 class="dk-elec-filter-title">
                    <span>Discount</span>
                </h4>
                <div class="dk-elec-filter-options-list">
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_discount" value="0" checked onchange="elecSetMinDiscount(0)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">Any Discount</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_discount" value="20" onchange="elecSetMinDiscount(20)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">20% or more</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_discount" value="30" onchange="elecSetMinDiscount(30)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">30% or more</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_discount" value="40" onchange="elecSetMinDiscount(40)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">40% or more</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_discount" value="50" onchange="elecSetMinDiscount(50)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">50% or more</span>
                    </label>
                </div>
            </div>

            <!-- Filter Group 6: Customer Rating -->
            <div class="dk-elec-filter-box">
                <h4 class="dk-elec-filter-title">
                    <span>Customer Rating</span>
                </h4>
                <div class="dk-elec-filter-options-list">
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_rating" value="0" checked onchange="elecSetMinRating(0)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">Any Rating</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_rating" value="4.5" onchange="elecSetMinRating(4.5)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">4.5★ &amp; Above</span>
                    </label>
                    <label class="dk-elec-radio-label">
                        <input type="radio" name="side_rating" value="4.0" onchange="elecSetMinRating(4.0)">
                        <span class="dk-elec-radio-custom"></span>
                        <span class="dk-elec-cb-text">4.0★ &amp; Above</span>
                    </label>
                </div>
            </div>

            <!-- Filter Group 7: Availability -->
            <div class="dk-elec-filter-box">
                <div class="dk-elec-switch-row">
                    <span class="dk-elec-filter-title" style="margin: 0;">In-Stock Only</span>
                    <label class="dk-elec-toggle-switch">
                        <input type="checkbox" id="elecInStockToggle" onchange="elecTriggerFilter()">
                        <span class="dk-elec-slider round"></span>
                    </label>
                </div>
            </div>

        </aside>

        <!-- RIGHT SIDE: PRODUCTS CATALOG & TOOLBAR -->
        <main class="dk-elec-catalog">

            <!-- Toolbar: Search, Count & Sort -->
            <div class="dk-elec-catalog-toolbar">
                <div class="dk-elec-toolbar-left">
                    <span class="dk-elec-results-count" id="elecResultsCount">
                        Showing <strong>@(totalProductsCount)</strong> verified products in @activePage.CategoryName
                    </span>
                </div>

                <div class="dk-elec-toolbar-right">
                    <!-- Search input inside subcategory -->
                    <div class="dk-elec-search-wrap">
                        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
                        <input type="text" id="elecSearchInput" placeholder="Search @activePage.CategoryName models &amp; specs..." oninput="elecOnSearchChange(this.value)">
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="dk-elec-sort-wrap">
                        <label for="elecSortSelect" class="dk-elec-sort-lbl">Sort by:</label>
                        <select id="elecSortSelect" class="dk-elec-sort-select" onchange="elecApplySort(this.value)">
                            <option value="popularity">Popularity</option>
                            <option value="price-asc">Price: Low to High</option>
                            <option value="price-desc">Price: High to Low</option>
                            <option value="rating">Customer Rating</option>
                            <option value="discount">Highest Discount</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Products Grid with BIG IMAGE FRAMES -->
            <div class="dk-elec-cards-grid" id="elecCatalogGrid">

                @if (dbProducts.Count > 0)
                {
                    @foreach (var prod in dbProducts)
                    {
                        var brandName = activePage.CategoryName;
                        var isUploadSoon = string.IsNullOrWhiteSpace(prod.PrimaryImageUrl) || prod.PrimaryImageUrl.Contains("placeholder");

                        <div class="dk-elec-card"
                             data-name="@prod.Name.ToLowerInvariant()"
                             data-brand="@brandName.ToLowerInvariant()"
                             data-type="@activePage.CategoryName.ToLowerInvariant()"
                             data-price="@prod.SellingPrice"
                             data-discount="@prod.DiscountPercentage"
                             data-rating="4.8"
                             data-instock="true">

                            @if (prod.DiscountPercentage >= 15)
                            {
                                <span class="dk-elec-badge-corner">@prod.DiscountPercentage% OFF</span>
                            }
                            else
                            {
                                <span class="dk-elec-badge-corner blue">VERIFIED</span>
                            }

