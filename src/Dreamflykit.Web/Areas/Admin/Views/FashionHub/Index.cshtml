            isHeroUploadingSoon: document.getElementById("sweatHeroIsUploadingSoon")?.checked ?? false,

            shopAllButtonText: document.getElementById("sweatShopAllText")?.value || "SHOP ALL SWEATSHIRTS",

            shopAllButtonUrl: document.getElementById("sweatShopAllUrl")?.value || "/category/fashion/sweatshirts",

            newArrivalsButtonText: document.getElementById("sweatNewArrivalsText")?.value || "NEW ARRIVALS",

            newArrivalsButtonUrl: document.getElementById("sweatNewArrivalsUrl")?.value || "/products?filter=new",

            heroBadges: sweatBadges,

            promoCards: sweatPromos,

            styleSection: {

                isEnabled: document.getElementById("sweatStyleIsEnabled")?.checked ?? true,

                title: document.getElementById("sweatStyleTitle")?.value || "SHOP BY STYLE",

                viewAllText: "VIEW ALL",

                viewAllUrl: "/category/fashion/sweatshirts",

                items: sweatStyles

            },

            trustBadges: sweatTrust

        },

        ethnicWear: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ethnic, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })),

        thermals: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(thermals, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))

    };



    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";



    try {

        const response = await fetch("/Admin/FashionHub/Save", {

            method: "POST",

            headers: {

                "Content-Type": "application/json",

                "RequestVerificationToken": token,

                "X-Requested-With": "XMLHttpRequest"

            },

            body: JSON.stringify(payload)

        });



        const result = await response.json();

        if (result.success) {

            showAlert("✓ " + (result.message || "Fashion Hub settings saved successfully!"), "success");

        } else {

            showAlert("⚠ Save failed: " + (result.message || "Unknown error"), "error");

        }

    } catch (err) {

        showAlert("⚠ Network or server error: " + err.message, "error");

    }

}



function getWomenSubcategoryPages() {

    const pages = [];

    document.querySelectorAll(".dk-subcat-admin-panel").forEach(panel => {

        const slug = panel.getAttribute("data-slug") || "";

        const title = panel.querySelector(".sub-hero-title")?.value || "";

        const highlight = panel.querySelector(".sub-hero-highlight")?.value || "";

        const subtitle = panel.querySelector(".sub-hero-subtitle")?.value || "";

        const image = panel.querySelector(".sub-hero-image")?.value || "";

        const soon = panel.querySelector(".sub-hero-soon")?.checked ?? true;



        const products = [];

        panel.querySelectorAll(".dk-sub-products-container .dk-item-row").forEach(el => {

            products.push({

                id: el.getAttribute("data-id") || "",

                name: el.querySelector(".prod-name")?.value || "",

                categoryName: title || slug,

                categorySlug: slug,

                price: parseFloat(el.querySelector(".prod-price")?.value || "0"),

                originalPrice: el.querySelector(".prod-orig-price")?.value ? parseFloat(el.querySelector(".prod-orig-price").value) : null,

                imageUrl: el.querySelector(".prod-image-url")?.value || "/images/fashion-hub/uploading-soon-placeholder.svg",

                badge: el.querySelector(".prod-badge")?.value || "",

                isUploadingSoon: el.querySelector(".prod-soon")?.checked ?? false,

                isActive: el.querySelector(".prod-active")?.checked ?? true,

                inStock: true

            });

        });



        pages.push({

            categorySlug: slug,

            categoryName: title || slug,

            heroBanner: {

                isEnabled: true,

                title: title,

                titleHighlight: highlight,

                subtitle: subtitle,

                imageUrl: image,

                isUploadingSoon: soon,

                themeColor: "#e11d48",

                badgeText: "STUDENT ESSENTIALS • 100% GENUINE"

            },

            products: products

        });

    });

    return pages;

}



