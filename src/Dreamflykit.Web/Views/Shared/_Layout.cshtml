@inject Dreamflykit.Application.Theme.IThemeSettingService ThemeSettingService
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Dreamflykit
    </title>

    <meta name="description"
          content="Dreamflykit - Your Journey. Our Kit." />

    <link rel="stylesheet"
          href="~/css/app.css"
          asp-append-version="true" />

    @Html.Raw(await ThemeSettingService.RenderDynamicThemeHtmlAsync())

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <partial name="_HeaderMain" />

    <main>
        @RenderBody()
    </main>

    @{
        var reqPath = Context.Request.Path.Value ?? "";
        var isAbroad = reqPath.StartsWith("/study-abroad-hub", StringComparison.OrdinalIgnoreCase) ||
                       reqPath.StartsWith("/StudyAbroadHub", StringComparison.OrdinalIgnoreCase) ||
                       reqPath.StartsWith("/SpecialOffer", StringComparison.OrdinalIgnoreCase) ||
                       reqPath.StartsWith("/AbroadHub", StringComparison.OrdinalIgnoreCase);
    }
    @if (!isAbroad)
    {
        <partial name="_Footer" />
    }

    @Html.AntiForgeryToken()

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>