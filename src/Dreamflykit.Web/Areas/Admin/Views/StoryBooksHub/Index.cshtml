<script>
function switchSbfAdminTab(tabKey, btn) {
    document.querySelectorAll('.sbf-admin-tab-pane').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.dk-hub-tab-btn').forEach(b => b.classList.remove('active'));

    const targetPane = document.getElementById('pane-' + tabKey);
    if (targetPane) targetPane.classList.add('active');
    btn.classList.add('active');
}

// ----------------------------------------------------
// Direct File Upload Helper
// ----------------------------------------------------
async function uploadImageDirect(input, targetUrlInputId, previewImgId) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];
    const formData = new FormData();
    formData.append('file', file);
    formData.append('targetField', targetUrlInputId);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    try {
        const resp = await fetch('/Admin/StoryBooksHub/UploadImage', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        });
        const result = await resp.json();
        if (result.success) {
            const urlInput = document.getElementById(targetUrlInputId);
            if (urlInput) urlInput.value = result.url;
            const preview = document.getElementById(previewImgId);
            if (preview) preview.src = result.url;
            alert('✓ Image uploaded successfully!');
        } else {
            alert('Upload failed: ' + (result.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Upload failed: ' + err.message);
    }
}

async function uploadBookCardImage(input) {
    if (!input.files || input.files.length === 0) return;
    const card = input.closest('.sbf-book-editor-card');
    const file = input.files[0];
    const formData = new FormData();
    formData.append('file', file);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    try {
        const resp = await fetch('/Admin/StoryBooksHub/UploadImage', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        });
        const result = await resp.json();
        if (result.success) {
            const urlInput = card.querySelector('.book-cover-url');
            if (urlInput) urlInput.value = result.url;
            const preview = card.querySelector('.book-cover-preview');
            if (preview) preview.src = result.url;
            alert('✓ Cover image uploaded!');
        } else {
            alert('Upload failed: ' + (result.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Upload error: ' + err.message);
    }
}

