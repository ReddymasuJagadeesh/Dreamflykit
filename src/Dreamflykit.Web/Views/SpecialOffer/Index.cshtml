                <div class="dk-kit-footer">
                    <div class="dk-kit-price-wrap">
                        <span class="dk-kit-price">₹3,499</span>
                        <del class="dk-kit-mrp">₹5,999</del>
                        <span class="dk-kit-discount-tag">42% OFF</span>
                    </div>
                    <a href="/category/study-essentials" class="dk-btn-order-kit">Explore Kit</a>
                </div>
            </div>

            <!-- KIT 2: UK -->
            <div class="dk-kit-card">
                <div class="dk-kit-badge">UK &amp; Ireland • 🇬🇧</div>
                <div class="dk-kit-header">
                    <div class="dk-kit-flag">🇬🇧</div>
                    <div>
                        <h3 class="dk-kit-title">UK Scholar Edition Kit</h3>
                        <p class="dk-kit-subtitle">Type-G 3-Pin Fused • Dorm Ready</p>
                    </div>
                </div>
                <ul class="dk-kit-features-list">
