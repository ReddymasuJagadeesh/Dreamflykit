function renumberSlides() {
    const cards = document.querySelectorAll("#heroSlidesContainer .dk-hero-slide-card");
    cards.forEach((card, idx) => {
        const num = card.querySelector(".slide-num");
        if (num) num.textContent = (idx + 1).toString();
        const order = card.querySelector(".slide-order");
        if (order) order.value = (idx + 1).toString();
    });
}

