@model Dreamflykit.Application.StudyHub.Models.EducationLoansPageDto
@{
    Layout = "_Layout";
    var eduPage = Model ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage();
    ViewData["Title"] = $"{eduPage.HeroTitle} {eduPage.HeroTitleHighlight} — {eduPage.TopNavBrandName}";
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    var partners = eduPage.Partners != null && eduPage.Partners.Count > 0
        ? eduPage.Partners
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().Partners;

    var steps = eduPage.Steps != null && eduPage.Steps.Count > 0
        ? eduPage.Steps
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().Steps;

    var courses = eduPage.Courses != null && eduPage.Courses.Count > 0
        ? eduPage.Courses
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultEducationLoansPage().Courses;
}

<div class="dk-edu-loans-root" id="eduLoansRoot">

    @if (canManage)
    {
        <!-- Admin Shortcut Bar -->
        <div class="dk-edu-admin-bar">
            <div class="dk-edu-admin-inner">
                <span class="dk-edu-admin-tag">⚡ Super Admin Controls</span>
                <span>You can edit all text, hero banner, loan partners, steps, and featured courses anytime in the Admin Dashboard.</span>
                <a href="/Admin/StudyAbroadHub#tab-edu-loans" class="dk-edu-admin-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <span>Edit Education Loans Page in Admin</span>
                </a>
            </div>
        </div>
    }

    <!-- ========================================================
         TOP NAVIGATION BAR (Image 2 Style - Student Accommodation REMOVED)
    ========================================================= -->
    @if (eduPage.ShowTopNav)
    {
        <header class="dk-edu-nav-header">
            <div class="dk-edu-nav-shell">
                <!-- Brand Logo -->
                <a href="/study-abroad-hub/education-loans" class="dk-edu-brand">
                    <div class="dk-edu-logo-cap">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                        </svg>
                    </div>
                    <div class="dk-edu-brand-texts">
                        <span class="dk-edu-brand-title">@eduPage.TopNavBrandName</span>
                    </div>
                </a>

                <!-- Nav Menu Items (Accommodation removed per user request) -->
                <nav class="dk-edu-nav-menu" aria-label="Education Loans Navigation">
                    <a href="#hero-banner" class="dk-edu-nav-link active">Abroad Education Loan</a>
                    
                    <div class="dk-edu-dropdown-wrap">
                        <a href="#loan-partners" class="dk-edu-nav-link has-arrow">
                            <span>Student Loan</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                        </a>
                        <div class="dk-edu-dropdown-pop">
                            <a href="#loan-partners">Bank Loan Partners</a>
                            <a href="#how-it-works">5-Step Process</a>
                            <a href="#trending-courses">Top Course Financing</a>
                        </div>
                    </div>

                    <a href="/study-abroad-hub" class="dk-edu-nav-link">Study Abroad</a>
                    <!-- Student Accommodation intentionally removed per user request -->
                    <a href="#how-it-works" class="dk-edu-nav-link">Contact Us</a>
                </nav>

                <!-- Top CTA Button -->
                <div class="dk-edu-nav-action">
                    <button type="button" class="dk-edu-btn-apply" onclick="openEduModal('General Loan Application')">
                        @eduPage.TopNavCtaText
                    </button>
                </div>
            </div>
        </header>
    }

    <!-- ========================================================
         FULL HERO BANNER (Full Width & Tall Height Panoramic Banner)
    ========================================================= -->
    <section class="dk-edu-hero-panoramic-section" id="hero-banner">
        <div class="dk-edu-hero-banner-frame">
            <img src="@eduPage.HeroImageUrl" 
                 alt="@eduPage.HeroTitle @eduPage.HeroTitleHighlight" 
                 class="dk-edu-hero-panoramic-img" 
                 onerror="this.src='/images/study-hub/upload-soon.svg';" />
        </div>
    </section>

    <!-- ========================================================
         OUR ACHIEVEMENTS STRIP (Image 3 Style)
    ========================================================= -->
    <section class="dk-edu-achieve-section" aria-label="Our Achievements">
        <div class="dk-edu-achieve-shell">
            <div class="dk-edu-achieve-grid">
                
                <!-- Left Title & Google Rating -->
                <div class="dk-edu-achieve-title-box">
                    <h2 class="dk-edu-achieve-heading">Our Achievements</h2>
                    <div class="dk-edu-google-reviews-pill">
                        <!-- Google G logo -->
                        <div class="dk-edu-google-g">
                            <svg width="22" height="22" viewBox="0 0 24 24">
                                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z"/>
                                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.17 0 9.97 0 12s.45 3.83 1.25 5.42l4.03-3.15z"/>
                                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                            </svg>
                        </div>
                        <div class="dk-edu-rating-text-box">
                            <span class="dk-edu-stars-row">Reviews ★★★★★</span>
                            <span class="dk-edu-rating-num">Rated <strong>4.8</strong> out of 5</span>
                        </div>
                    </div>
                </div>

                <!-- 4 Metrics Items -->
                <div class="dk-edu-metrics-row">
                    <div class="dk-edu-metric-item">
                        <span class="dk-metric-label">@eduPage.Metric1Label</span>
                        <span class="dk-metric-value">@eduPage.Metric1Value</span>
                    </div>

                    <div class="dk-edu-metric-item">
                        <span class="dk-metric-label">@eduPage.Metric2Label</span>
                        <span class="dk-metric-value">@eduPage.Metric2Value</span>
                    </div>

                    <div class="dk-edu-metric-item">
                        <span class="dk-metric-label">@eduPage.Metric3Label</span>
                        <span class="dk-metric-value">@eduPage.Metric3Value</span>
                    </div>

                    <div class="dk-edu-metric-item">
                        <span class="dk-metric-label">@eduPage.Metric4Label</span>
                        <span class="dk-metric-value">@eduPage.Metric4Value</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ========================================================
         OUR LOAN PARTNERS SECTION (Image 4 Style)
    ========================================================= -->
    <section class="dk-edu-partners-section" id="loan-partners">
        <div class="dk-edu-section-shell">
            
            <div class="dk-edu-section-head">
                <h2 class="dk-edu-section-title">@eduPage.PartnersTitle</h2>
                <p class="dk-edu-section-sub">@eduPage.PartnersSubtitle</p>
            </div>

            <!-- Partner Cards Grid -->
            <div class="dk-edu-partners-grid" id="partnersGrid">
                @for (int pIdx = 0; pIdx < partners.Count; pIdx++)
                {
                    var p = partners[pIdx];
                    <div class="dk-edu-partner-card @(pIdx >= 5 ? "partner-extra" : "")">
                        <div class="dk-partner-logo-box">
                            @if (!string.IsNullOrWhiteSpace(p.LogoUrl))
                            {
                                <img src="@p.LogoUrl" alt="@p.Name" class="dk-partner-img" />
                            }
                            else
                            {
                                <span class="dk-partner-text-logo">@p.Name</span>
                            }
                        </div>
                        <a href="#apply-loan-modal" onclick="openEduModal('Partner Loan: @p.Name')" class="dk-partner-rate-btn">
                            <span>@p.InterestRateText</span>
                        </a>
                    </div>
                }
            </div>

            <!-- View More / Collapse Toggle Button -->
            <div class="dk-edu-viewmore-row">
                <button type="button" class="dk-edu-viewmore-btn" id="btnTogglePartners">
                    <span>@eduPage.PartnersViewMoreText</span>
                </button>
            </div>

        </div>
    </section>

    <!-- ========================================================
         HOW IT WORKS SECTION (Image 4 Style: 5 Easy Steps)
    ========================================================= -->
    <section class="dk-edu-how-section" id="how-it-works">
        <div class="dk-edu-section-shell">
            
            <div class="dk-edu-section-head">
                <h2 class="dk-edu-section-title">@eduPage.HowItWorksTitle</h2>
                <p class="dk-edu-section-sub">@eduPage.HowItWorksSubtitle</p>
            </div>

            <!-- 5 Steps Flow -->
            <div class="dk-edu-steps-track">
                @for (int sIdx = 0; sIdx < steps.Count; sIdx++)
                {
                    var s = steps[sIdx];
                    <div class="dk-edu-step-card">
                        
                        <!-- Step Icon Emblem -->
                        <div class="dk-edu-step-emblem">
                            @if (s.Icon == "check-circle" || sIdx == 0)
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                            }
                            else if (s.Icon == "headset" || sIdx == 1)
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                            }
                            else if (s.Icon == "file-text" || sIdx == 2)
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            }
                            else if (s.Icon == "coins" || sIdx == 3)
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2.2"><circle cx="12" cy="12" r="9"/><path d="M12 6v12M15 9.5a3.5 3.5 0 0 0-7 0c0 4 7 2 7 6a3.5 3.5 0 0 1-7 0"/></svg>
                            }
                            else
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                            }
                        </div>

                        <!-- Step Content -->
                        <div class="dk-edu-step-body">
                            <h3 class="dk-edu-step-title">@s.Title</h3>
                            <p class="dk-edu-step-desc">@s.Subtitle</p>
                        </div>

                        <!-- Connector arrow (except last) -->
                        @if (sIdx < steps.Count - 1)
                        {
                            <div class="dk-edu-step-connector" aria-hidden="true">
                                <span class="dk-connector-dots"></span>
                                <span class="dk-connector-arrow">›</span>
                            </div>
                        }

                    </div>
                }
            </div>

        </div>
    </section>

    <!-- ========================================================
         FEATURED / TRENDING COURSES & LOAN SCHEMES (Image 5 Style)
         High-Tech Futuristic Background + Sliding Cards Conveyor
    ========================================================= -->
    <section class="dk-edu-tech-section" id="trending-courses" style="background-image: url('@eduPage.CoursesBgImageUrl');">
        <!-- Cyberspace dark overlay -->
        <div class="dk-tech-overlay"></div>

        <div class="dk-edu-section-shell dk-tech-shell">
            
            <!-- Section Header -->
            <div class="dk-tech-header">
                <span class="dk-tech-tag">@eduPage.CoursesTag</span>
                <h2 class="dk-tech-title">@eduPage.CoursesTitle</h2>
                <p class="dk-tech-sub">@eduPage.CoursesSubtitle</p>
            </div>

            <!-- Auto-Moving Conveyor Carousel (Moves from right to left based on timeframe without side arrow markers) -->
            <div class="dk-tech-carousel-container" id="coursesCarouselWrapper">
                <!-- Cards Slider Viewport & Track -->
                <div class="dk-tech-cards-viewport" id="coursesViewport" data-interval-sec="@(eduPage.CoursesSlideIntervalSec > 0 ? eduPage.CoursesSlideIntervalSec : 3)">
                    <div class="dk-tech-cards-track" id="coursesTrack">
                        @for (int cIdx = 0; cIdx < courses.Count; cIdx++)
                        {
                            var c = courses[cIdx];
                            <div class="dk-tech-course-card" data-course-index="@cIdx">
                                <!-- Campus Image with Institution Badge -->
                                <div class="dk-course-media-box">
                                    <img src="@c.ImageUrl" alt="@c.Title" class="dk-course-img" onerror="this.src='/images/study-hub/upload-soon.svg';" />
                                    
                                    <!-- Circular Logo Emblem Overlaid on Bottom-Right of Image (Image 5 style) -->
                                    <div class="dk-course-inst-emblem">
                                        @if (!string.IsNullOrWhiteSpace(c.LogoUrl))
                                        {
                                            <img src="@c.LogoUrl" alt="@c.Institution logo" class="dk-inst-logo-img" />
                                        }
                                        else
                                        {
                                            <span class="dk-inst-logo-letter">@(c.Institution.Length > 4 ? c.Institution[..4] : c.Institution)</span>
                                        }
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class="dk-course-info">
                                    <span class="dk-course-inst-name">@c.Institution</span>
                                    <h3 class="dk-course-title" title="@c.Title">@c.Title</h3>

                                    <!-- Badges List with Icons -->
                                    <div class="dk-course-badges">
                                        @if (!string.IsNullOrWhiteSpace(c.Badge1))
                                        {
                                            <div class="dk-course-badge-row">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                                <span>@c.Badge1</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.Badge2))
                                        {
                                            <div class="dk-course-badge-row">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                                <span>@c.Badge2</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Action Buttons: User specified "More Information" and "Apply Now" -->
                                    <div class="dk-course-actions">
                                        <button type="button" class="dk-course-btn-info" onclick="openEduModal('Info: @c.Title (@c.Institution)')">
                                            @c.InfoButtonText
                                        </button>
                                        <button type="button" class="dk-course-btn-apply" onclick="openEduModal('Apply: @c.Title (@c.Institution)')">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
                                            <span>@c.ApplyButtonText</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </section>



    <!-- ========================================================
         INTERACTIVE LOAN ELIGIBILITY / APPLICATION MODAL
    ========================================================= -->
    <div class="dk-edu-modal-backdrop" id="eduLoanModal" style="display: none;" onclick="closeEduModalOnBackdrop(event)">
        <div class="dk-edu-modal-box">
            
            <button type="button" class="dk-edu-modal-close" onclick="closeEduModal()">✕</button>

            <div class="dk-edu-modal-header">
                <div class="dk-modal-badge">100% Digital Fast-Track Sanction</div>
                <h3 class="dk-modal-title">Check Loan Eligibility &amp; Apply</h3>
                <p class="dk-modal-sub" id="eduModalSubText">
                    Fast sanction in 48 hours with lowest interest rates from 20+ top bank partners.
                </p>
            </div>

            <form id="frmEduLoanApplication" onsubmit="handleEduLoanSubmit(event)">
                
                <input type="hidden" id="leadSource" value="Education Loans Page" />

                <div class="dk-modal-fields-grid">
                    <div>
                        <label class="dk-modal-label">Student Full Name *</label>
                        <input type="text" id="leadFullName" class="dk-modal-input" placeholder="e.g. Rahul Sharma" required />
                    </div>

                    <div>
                        <label class="dk-modal-label">Mobile Number *</label>
                        <input type="tel" id="leadPhone" class="dk-modal-input" placeholder="e.g. +91 98765 43210" required />
                    </div>

                    <div>
                        <label class="dk-modal-label">Email Address *</label>
                        <input type="email" id="leadEmail" class="dk-modal-input" placeholder="e.g. rahul@example.com" required />
                    </div>

                    <div>
                        <label class="dk-modal-label">Target Study Country</label>
                        <select id="leadCountry" class="dk-modal-input">
                            <option value="USA">United States (USA)</option>
                            <option value="UK">United Kingdom (UK)</option>
                            <option value="Canada">Canada</option>
                            <option value="Australia">Australia</option>
                            <option value="Germany">Germany</option>
                            <option value="Ireland">Ireland</option>
                            <option value="Other">Other Global Destination</option>
                        </select>
                    </div>

                    <div>
                        <label class="dk-modal-label">Estimated Loan Amount</label>
                        <select id="leadLoanAmount" class="dk-modal-input">
                            <option value="₹10L - ₹25L">₹10 Lakhs - ₹25 Lakhs</option>
                            <option value="₹25L - ₹50L" selected>₹25 Lakhs - ₹50 Lakhs</option>
                            <option value="₹50L - ₹1 Crore">₹50 Lakhs - ₹1 Crore</option>
                            <option value="Above ₹1 Crore">Above ₹1 Crore</option>
                        </select>
                    </div>

                    <div>
                        <label class="dk-modal-label">Loan Type Preference</label>
                        <select id="leadCollateral" class="dk-modal-input">
                            <option value="Non-Collateral">Non-Collateral (Unsecured)</option>
                            <option value="Collateral-Backed">Collateral-Backed (Property / Fixed Deposit)</option>
                        </select>
                    </div>
                </div>

                <div style="margin-top: 14px;">
                    <label class="dk-modal-label">Target Degree / Program (Optional)</label>
                    <input type="text" id="leadProgram" class="dk-modal-input" placeholder="e.g. MS in Computer Science / AI / MBA" />
                </div>

                <!-- Submit Button -->
                <div style="margin-top: 20px;">
                    <button type="submit" class="dk-modal-submit-btn" id="btnSubmitLoan">
                        <span>Check Eligibility &amp; Apply Now →</span>
                    </button>
                    <p class="dk-modal-terms">
                        🔒 Your data is 100% secure. By submitting, you agree to receive guidance from verified education loan experts.
                    </p>
                </div>

            </form>

            <!-- Success Message Box -->
            <div id="eduModalSuccess" style="display: none; text-align: center; padding: 25px 15px;">
                <div class="dk-success-tick">✓</div>
                <h4 style="font-size: 20px; font-weight: 800; color: #065f46; margin: 12px 0 8px 0;">Application Submitted!</h4>
                <p id="eduSuccessMsg" style="color: #334155; font-size: 14px; line-height: 1.6; max-width: 440px; margin: 0 auto 20px auto;">
                    Our international education financing specialist will reach out to you within 24 hours.
                </p>
                <button type="button" class="dk-edu-hero-cta-btn" onclick="closeEduModal()">
                    Close Window
                </button>
            </div>

        </div>
    </div>

</div>

<!-- ========================================================
     CSS STYLING FOR DEDICATED EDUCATION LOANS PAGE
========================================================= -->
<style>
    /* Base wrapper & Typography */
    .dk-edu-loans-root {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #0f172a;
        background: #ffffff;
        overflow-x: hidden;
    }

    /* Admin Shortcut Bar */
    .dk-edu-admin-bar {
        background: #0f172a;
        color: #ffffff;
        padding: 8px 16px;
        font-size: 12px;
        position: sticky;
        top: 0;
        z-index: 1001;
    }
    .dk-edu-admin-inner {
        max-width: 1320px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }
    .dk-edu-admin-tag {
        background: #0284c7;
        color: #fff;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 800;
        font-size: 10.5px;
        text-transform: uppercase;
    }
    .dk-edu-admin-btn {
        background: #0284c7;
        color: #fff;
        padding: 4px 12px;
        border-radius: 6px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.2s;
    }
    .dk-edu-admin-btn:hover {
        background: #0369a1;
        color: #fff;
    }

    /* Top Nav Header (Image 2 style) */
    .dk-edu-nav-header {
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        position: sticky;
        top: 0;
        z-index: 999;
        box-shadow: 0 1px 4px rgba(0,0,0,0.03);
    }
    .dk-edu-nav-shell {
        max-width: 1320px;
        margin: 0 auto;
        padding: 14px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }
    .dk-edu-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #0f172a;
    }
    .dk-edu-logo-cap {
        color: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .dk-edu-brand-title {
        font-size: 24px;
        font-weight: 900;
        letter-spacing: -0.5px;
        color: #0d3b32;
    }
    .dk-edu-nav-menu {
        display: flex;
        align-items: center;
        gap: 24px;
    }
    .dk-edu-nav-link {
        font-size: 14px;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
        transition: color 0.15s;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .dk-edu-nav-link:hover, .dk-edu-nav-link.active {
        color: #047857;
