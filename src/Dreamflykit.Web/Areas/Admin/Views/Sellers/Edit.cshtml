@model Dreamflykit.Web.Areas.Admin.Models.AdminEditSellerViewModel
@{
    ViewData["Title"] = "Edit Seller & Allowed Categories";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as IEnumerable<Dreamflykit.Domain.Catalog.Category> ?? Enumerable.Empty<Dreamflykit.Domain.Catalog.Category>();
}

<div style="max-width: 840px; margin: 0 auto;">
    <div style="margin-bottom: 1.5rem;">
        <a asp-action="Index" style="color: #94a3b8; font-size: 0.875rem; text-decoration: none; display:inline-flex; align-items:center; gap:0.4rem; margin-bottom: 0.5rem;">
            ← Back to Sellers List
        </a>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: #f8fafc; margin: 0;">
            Edit Seller Store &amp; Category Permissions
        </h1>
        <p style="color: #94a3b8; font-size: 0.875rem; margin: 0.35rem 0 0;">
            Manage profile details and decide which product categories this seller can use in their portal.
        </p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem;">
            <div style="font-weight: 700; margin-bottom: 0.35rem;">Please correct the errors below:</div>
            <div asp-validation-summary="All" style="font-size: 0.875rem;"></div>
        </div>
    }

    <div style="background: #1e293b; border-radius: 12px; border: 1px solid #334155; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
        <form asp-action="Edit" asp-route-id="@Model.SellerId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SellerId" />
            <input type="hidden" asp-for="Email" />

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem;">
                <div>
                    <label asp-for="FirstName" style="display:block; font-size: 0.875rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.4rem;">
                        First Name <span style="color:#ef4444;">*</span>
                    </label>
                    <input asp-for="FirstName"
                           style="width: 100%; padding: 0.75rem 1rem; background: #0f172a; border: 1px solid #334155; border-radius: 8px; color: #f8fafc; font-size: 0.95rem;" />
                    <span asp-validation-for="FirstName" style="color:#f87171; font-size: 0.8rem;"></span>
                </div>

                <div>
                    <label asp-for="LastName" style="display:block; font-size: 0.875rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.4rem;">
                        Last Name / Business Surname <span style="color:#ef4444;">*</span>
                    </label>
                    <input asp-for="LastName"
                           style="width: 100%; padding: 0.75rem 1rem; background: #0f172a; border: 1px solid #334155; border-radius: 8px; color: #f8fafc; font-size: 0.95rem;" />
                    <span asp-validation-for="LastName" style="color:#f87171; font-size: 0.8rem;"></span>
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem;">
                <div>
                    <label style="display:block; font-size: 0.875rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.4rem;">
                        Seller Email (Username)
                    </label>
                    <input value="@Model.Email"
                           disabled
                           style="width: 100%; padding: 0.75rem 1rem; background: #0f172a; border: 1px solid #1e293b; border-radius: 8px; color: #64748b; font-size: 0.95rem;" />
                </div>

                <div>
                    <label asp-for="PhoneNumber" style="display:block; font-size: 0.875rem; font-weight: 600; color: #f1f5f9; margin-bottom: 0.4rem;">
                        Contact Phone Number <span style="color:#ef4444;">*</span>
                    </label>
                    <input asp-for="PhoneNumber"
                           type="tel"
                           style="width: 100%; padding: 0.75rem 1rem; background: #0f172a; border: 1px solid #334155; border-radius: 8px; color: #f8fafc; font-size: 0.95rem;" />
                    <span asp-validation-for="PhoneNumber" style="color:#f87171; font-size: 0.8rem;"></span>
                </div>
            </div>

            <!-- ALLOWED CATEGORIES SELECTION -->
            <div style="background: #0f172a; border: 1.5px solid #3b82f6; border-radius: 10px; padding: 1.25rem 1.5rem; margin-bottom: 1.75rem;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem; flex-wrap:wrap; gap:0.5rem;">
                    <div>
                        <label style="display:block; font-size: 0.95rem; font-weight: 800; color: #60a5fa; margin: 0;">
                            📂 Authorized Product Categories (Multiple Choice)
                        </label>
                        <small style="color: #94a3b8; font-size: 0.8rem;">
                            Super Admin decides which categories this seller can use. In the seller portal, only these selected categories will appear.
                        </small>
                    </div>
                    <div style="display:flex; gap:0.5rem;">
                        <button type="button" id="btnSelectAllCats" style="padding: 0.35rem 0.75rem; background: #334155; border: 1px solid #475569; color: #f8fafc; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer;">
                            Select All
                        </button>
                        <button type="button" id="btnDeselectAllCats" style="padding: 0.35rem 0.75rem; background: #1e293b; border: 1px solid #334155; color: #94a3b8; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer;">
                            Clear All
                        </button>
                    </div>
                </div>

                <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.75rem; margin-top: 0.75rem;">
                    @foreach (var cat in categories)
                    {
                        var isChecked = Model.SelectedCategoryIds?.Contains(cat.Id) == true;
                        <label class="category-select-pill" style="display:flex; align-items:center; gap:0.65rem; padding: 0.75rem 1rem; background: #1e293b; border: 1px solid #334155; border-radius: 8px; cursor: pointer; transition: all 0.2s ease;">
                            <input type="checkbox"
                                   name="SelectedCategoryIds"
                                   value="@cat.Id"
                                   @(isChecked ? "checked" : "")
                                   class="cat-checkbox"
                                   style="width: 18px; height: 18px; accent-color: #3b82f6; cursor:pointer;" />
                            <span style="font-size: 0.9rem; color: #e2e8f0; font-weight: 600;">@cat.Name</span>
                        </label>
                    }
                </div>
            </div>

            <div style="margin-bottom: 2rem;">
                <label style="display:flex; align-items:center; gap:0.6rem; cursor:pointer;">
                    <input asp-for="IsActive" type="checkbox" style="width: 18px; height: 18px; accent-color: #10b981;" />
                    <span style="font-size: 0.9rem; color: #f1f5f9; font-weight: 500;">
                        Account is Active and authorized to add products
                    </span>
                </label>
            </div>

            <div style="display:flex; justify-content:flex-end; gap: 1rem; align-items:center; border-top: 1px solid #334155; padding-top: 1.5rem;">
                <a asp-action="Index" style="padding: 0.75rem 1.5rem; background: #334155; color: #f1f5f9; border-radius: 8px; text-decoration: none; font-weight: 600;">
                    Cancel
                </a>
                <button type="submit" style="padding: 0.75rem 1.75rem; background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; border:none; border-radius: 8px; font-weight: 700; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.35);">
                    Save Changes &amp; Permissions
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('btnSelectAllCats')?.addEventListener('click', () => {
        document.querySelectorAll('.cat-checkbox').forEach(cb => cb.checked = true);
    });
    document.getElementById('btnDeselectAllCats')?.addEventListener('click', () => {
        document.querySelectorAll('.cat-checkbox').forEach(cb => cb.checked = false);
    });
</script>
