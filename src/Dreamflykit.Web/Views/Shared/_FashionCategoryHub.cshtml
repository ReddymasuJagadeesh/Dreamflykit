@model Dreamflykit.Application.FashionHub.Models.FashionHubDto
@{
    var hub = Model ?? Dreamflykit.Application.FashionHub.Models.FashionHubDto.CreateDefault();
    var hero = hub.HeroBanner ?? new();
    var catSection = hub.CategoriesSection ?? new();
    var picksSection = hub.TopPicksSection ?? new();
    var trustSection = hub.TrustBadgesSection ?? new();
    var bottomBanner = hub.BottomBanner ?? new();

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="dk-fashion-hub-container" id="fashion-hub-root">

    @if (canManage)
    {
        <div class="dk-fashion-admin-bar">
            <div class="dk-fashion-admin-bar-left">
                <span class="dk-fashion-admin-badge">⚡ Admin Mode</span>
                <span class="dk-fashion-admin-hint">Fashion Category Hub Active &bull; Customize banner, categories, products, text, &amp; upload images</span>
            </div>
            <a href="/Admin/FashionHub" class="dk-fashion-admin-btn" id="btnManageFashionHub">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Edit Fashion Hub &amp; Upload Images
            </a>
        </div>
    }

    <!-- ============================================================
         1. HERO BANNER (FULL WIDTH, BRIGHT, HIGH AESTHETICS)
    ============================================================ -->
    <!-- ============================================================
         1. HERO BANNER (FULL WIDTH, BRIGHT, TEXT OVERLAYED ON IMAGE)
    ============================================================ -->
    @if (hero.IsEnabled)
    {
        var minHeight = hero.BannerHeight > 0 ? hero.BannerHeight : 440;
        var titleColor = !string.IsNullOrWhiteSpace(hero.TitleColor) ? hero.TitleColor : "#063f91";
        var highlightColor = !string.IsNullOrWhiteSpace(hero.TitleHighlightColor) ? hero.TitleHighlightColor : "#ea580c";
        var subtitleColor = !string.IsNullOrWhiteSpace(hero.SubtitleColor) ? hero.SubtitleColor : "#334155";
        var badgeBg = !string.IsNullOrWhiteSpace(hero.BadgeBgColor) ? hero.BadgeBgColor : "rgba(255, 255, 255, 0.94)";
        var badgeText = !string.IsNullOrWhiteSpace(hero.BadgeTextColor) ? hero.BadgeTextColor : "#0f172a";
        var overlayGrad = !string.IsNullOrWhiteSpace(hero.OverlayGradient) 
            ? hero.OverlayGradient 
            : "linear-gradient(90deg, rgba(255, 255, 255, 0.75) 0%, rgba(255, 255, 255, 0.32) 36%, rgba(255, 255, 255, 0.0) 58%, rgba(255, 255, 255, 0.28) 85%, rgba(255, 255, 255, 0.65) 100%)";

        <section class="dk-fashion-hero-section full-width-hero" style="min-height: @(minHeight)px;" aria-label="Fashion Category Hero">
            <!-- Full Width Panoramic Banner Image -->
            @if (hero.IsUploadingSoon || string.IsNullOrWhiteSpace(hero.ImageUrl))
            {
                <div class="dk-fashion-hero-bg-soon">
                    <img src="/images/fashion-hub/uploading-soon-placeholder.svg" alt="Uploading Soon Placeholder" class="dk-fashion-soon-watermark-img" />
                    <div class="dk-fashion-soon-badge-banner">⏳ HERO BANNER UPLOADING SOON</div>
                </div>
            }
            else
            {
                <img src="@hero.ImageUrl" 
                     alt="Fashion for Every Journey" 
                     class="dk-fashion-hero-bg-img" 
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                <div class="dk-fashion-hero-bg-soon" style="display: none;">
                    <div class="dk-fashion-soon-badge-banner">⏳ HERO BANNER UPLOADING SOON</div>
                </div>
            }

            <!-- High-Brightness Gradient Overlay for Contrast & Text Readability -->
            <div class="dk-fashion-hero-overlay" style="background: @overlayGrad;"></div>

            <!-- Content Overlayed Directly on Top of the Full-Width Banner Image -->
            <div class="dk-fashion-hero-overlay-content">
                
                <!-- Left Content Area -->
                <div class="dk-fashion-hero-left">
                    <h1 class="dk-fashion-hero-headline" style="color: @titleColor;">
                        @hero.Title <span class="dk-fashion-highlight" style="color: @highlightColor; -webkit-text-fill-color: @highlightColor; background: none;">@hero.TitleHighlight</span>
                    </h1>
                    
                    <p class="dk-fashion-hero-subtext" style="color: @subtitleColor;">
                        @hero.Subtitle
                    </p>

                    <!-- Badges Row (4 Pill Badges on Top of Banner) -->
                    @if (hero.Badges != null && hero.Badges.Count > 0)
                    {
                        <div class="dk-fashion-badges-row">
                            @foreach (var badge in hero.Badges.Where(b => b.IsActive))
                            {
                                <div class="dk-fashion-badge-item" style="background: @badgeBg; color: @badgeText;">
                                    <span class="dk-fashion-badge-icon">
                                        @if (badge.Icon == "shirt")
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path></svg>
                                        }
                                        else if (badge.Icon == "shield")
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                                        }
                                        else if (badge.Icon == "tag")
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                                        }
                                        else
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                        }
                                    </span>
                                    <span class="dk-fashion-badge-text" style="color: @badgeText;">@badge.Label</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Right Feature Callout Box ("Look Good. Travel Smart.") Overlayed on Right Side -->
                @if (hero.RightCard != null)
                {
                    <div class="dk-fashion-hero-right">
                        <div class="dk-fashion-callout-card">
                            <h3 class="dk-fashion-callout-title">
                                @hero.RightCard.Title <span class="dk-fashion-highlight-orange">@hero.RightCard.TitleHighlight</span>
                            </h3>

                            <div class="dk-fashion-callout-features">
                                @foreach (var feat in hero.RightCard.Features.Where(f => f.IsActive))
                                {
                                    <div class="dk-fashion-callout-item">
                                        <div class="dk-fashion-callout-icon">
                                            @if (feat.Icon == "luggage")
                                            {
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="6" width="14" height="15" rx="3"></rect><path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path><circle cx="8" cy="21" r="1"></circle><circle cx="16" cy="21" r="1"></circle></svg>
                                            }
                                            else if (feat.Icon == "feather")
                                            {
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path><line x1="16" y1="8" x2="2" y2="22"></line><line x1="17.5" y1="15" x2="9" y2="15"></line></svg>
                                            }
                                            else
                                            {
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                                            }
                                        </div>
                                        <div class="dk-fashion-callout-text">
                                            <span class="dk-fashion-callout-label">@feat.Title</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>
        </section>
    }

    <!-- ============================================================
         2. SHOP BY CATEGORY SECTION
    ============================================================ -->
    @if (catSection.IsEnabled && catSection.Categories != null && catSection.Categories.Count > 0)
    {
        <section class="dk-fashion-section" aria-label="Shop Fashion by Category">
            <div class="dk-fashion-section-header">
                <h2 class="dk-fashion-section-heading">@catSection.Title</h2>
                <a href="@catSection.ViewAllUrl" class="dk-fashion-section-link">
                    @catSection.ViewAllText
                </a>
            </div>

            <div class="dk-fashion-categories-grid">
                @foreach (var cat in catSection.Categories.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder))
                {
                    var catUrl = !string.IsNullOrWhiteSpace(cat.Slug) ? $"/category/fashion/{cat.Slug}" : "/products?category=fashion";
                    <a href="@catUrl" class="dk-fashion-cat-card" title="@cat.Name">
                        <div class="dk-fashion-cat-img-box">
                            @if (cat.IsUploadingSoon || string.IsNullOrWhiteSpace(cat.ImageUrl) || cat.ImageUrl.Contains("uploading-soon"))
                            {
                                <div class="dk-fashion-cat-placeholder">
                                    <span class="dk-fashion-cat-emoji">
                                        @GetCategoryEmoji(cat.Slug)
                                    </span>
                                    <span class="dk-fashion-soon-badge">Uploading Soon</span>
                                </div>
                            }
                            else
                            {
                                <img src="@cat.ImageUrl" 
                                     alt="@cat.Name" 
                                     loading="lazy" 
                                     class="dk-fashion-cat-img" 
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="dk-fashion-cat-placeholder" style="display: none;">
                                    <span class="dk-fashion-cat-emoji">@GetCategoryEmoji(cat.Slug)</span>
                                    <span class="dk-fashion-soon-badge">Uploading Soon</span>
                                </div>
                            }
                        </div>
                        <span class="dk-fashion-cat-title">@cat.Name</span>
                    </a>
                }
            </div>
        </section>
    }

    <!-- ============================================================
         3. TOP PICKS FOR MEN & WOMEN SECTION
    ============================================================ -->
    @if (picksSection.IsEnabled && picksSection.Products != null && picksSection.Products.Count > 0)
    {
        <section class="dk-fashion-section" aria-label="Top Picks for Men and Women">
            <div class="dk-fashion-section-header">
                <h2 class="dk-fashion-section-heading">@picksSection.Title</h2>
                <div class="dk-fashion-slider-controls">
                    <button type="button" class="dk-fashion-arrow-btn" id="dkFashionPicksPrev" aria-label="Previous products">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    <button type="button" class="dk-fashion-arrow-btn" id="dkFashionPicksNext" aria-label="Next products">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                    <a href="@picksSection.ViewAllUrl" class="dk-fashion-section-link" style="margin-left: 12px;">
                        @picksSection.ViewAllText
                    </a>
                </div>
            </div>

            <div class="dk-fashion-products-track-wrapper" id="dkFashionProductsTrackWrapper">
                <div class="dk-fashion-products-track" id="dkFashionProductsTrack">
                    @foreach (var prod in picksSection.Products.Where(p => p.IsActive))
                    {
                        var prodLink = !string.IsNullOrWhiteSpace(prod.ProductUrl) ? prod.ProductUrl : "/products?category=fashion";
                        <div class="dk-fashion-product-card">
                            <!-- Wishlist button -->
                            <button type="button" class="dk-fashion-wish-btn" aria-label="Add @prod.Name to wishlist" onclick="event.preventDefault(); event.stopPropagation(); this.classList.toggle('active');">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            </button>

                            <a href="@prodLink" class="dk-fashion-prod-img-link">
                                <div class="dk-fashion-prod-img-box">
                                    @if (prod.IsUploadingSoon || string.IsNullOrWhiteSpace(prod.ImageUrl) || prod.ImageUrl.Contains("uploading-soon"))
                                    {
                                        <div class="dk-fashion-prod-placeholder">
                                            <div class="dk-fashion-prod-icon-wrap">
                                                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="1.8"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path></svg>
                                            </div>
                                            <span class="dk-fashion-soon-badge-sm">Uploading Soon</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@prod.ImageUrl" 
                                             alt="@prod.Name" 
                                             loading="lazy" 
                                             class="dk-fashion-prod-img" 
                                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                        <div class="dk-fashion-prod-placeholder" style="display: none;">
                                            <div class="dk-fashion-prod-icon-wrap">
                                                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="1.8"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path></svg>
                                            </div>
                                            <span class="dk-fashion-soon-badge-sm">Uploading Soon</span>
                                        </div>
                                    }
                                </div>
                            </a>

                            <div class="dk-fashion-prod-details">
                                <a href="@prodLink" class="dk-fashion-prod-name" title="@prod.Name">
                                    @prod.Name
                                </a>

                                <div class="dk-fashion-prod-price-row">
                                    <span class="dk-fashion-price">₹@prod.Price.ToString("N0")</span>
                                    @if (prod.OriginalPrice.HasValue && prod.OriginalPrice.Value > prod.Price)
                                    {
                                        <span class="dk-fashion-orig-price">₹@prod.OriginalPrice.Value.ToString("N0")</span>
                                    }
                                </div>

                                <div class="dk-fashion-prod-bottom-row">
                                    <div class="dk-fashion-stars" title="Rating: @prod.Rating out of 5">
                                        <span class="dk-fashion-star-icons">★★★★★</span>
                                        <span class="dk-fashion-reviews-count">(@prod.ReviewsCount)</span>
                                    </div>

                                    <a href="@prodLink" class="dk-fashion-cart-btn" title="Add to Bag">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ============================================================
         4. TRUST BADGES / VALUE PROPOSITIONS BAR
    ============================================================ -->
    @if (trustSection.IsEnabled && trustSection.Badges != null && trustSection.Badges.Count > 0)
    {
        <section class="dk-fashion-trust-section" aria-label="Customer Guarantees">
            <div class="dk-fashion-trust-grid">
                @foreach (var badge in trustSection.Badges.Where(b => b.IsActive))
                {
                    <div class="dk-fashion-trust-card">
                        <div class="dk-fashion-trust-icon">
                            @if (badge.Icon == "box")
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                            }
                            else if (badge.Icon == "shield")
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                            }
                            else if (badge.Icon == "tag")
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                            }
                            else if (badge.Icon == "truck")
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                            }
                            else if (badge.Icon == "return")
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                            }
                            else
                            {
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                            }
                        </div>
                        <div class="dk-fashion-trust-content">
                            <h4 class="dk-fashion-trust-title">@badge.Title</h4>
                            <p class="dk-fashion-trust-sub">@badge.Subtitle</p>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- ============================================================
         5. BOTTOM CALLOUT BANNER (DARK NAVY / KITS & DESTINATIONS)
    ============================================================ -->
    @if (bottomBanner.IsEnabled)
    {
        <section class="dk-fashion-bottom-bar" aria-label="Fashion Destination & Kits">
            <div class="dk-fashion-bottom-container">
                
                <!-- Col 1: Quiz -->
                <div class="dk-fashion-bottom-col">
                    <div class="dk-fashion-bottom-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><circle cx="11" cy="14" r="2"></circle><line x1="13" y1="16" x2="15" y2="18"></line></svg>
                    </div>
                    <div class="dk-fashion-bottom-text">
                        <strong class="dk-fashion-bottom-heading">@bottomBanner.QuizTitle</strong>
                        <span class="dk-fashion-bottom-sub">@bottomBanner.QuizSubtitle</span>
                    </div>
                    <a href="@bottomBanner.QuizButtonUrl" class="dk-fashion-bottom-btn">
                        @bottomBanner.QuizButtonText
                    </a>
                </div>

                <div class="dk-fashion-bottom-divider"></div>

                <!-- Col 2: Destinations -->
                <div class="dk-fashion-bottom-col">
                    <div class="dk-fashion-bottom-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="dk-fashion-bottom-text">
                        <strong class="dk-fashion-bottom-heading">@bottomBanner.DestinationsTitle</strong>
                        <span class="dk-fashion-bottom-sub">@bottomBanner.DestinationsSubtitle</span>
                    </div>
                    <div class="dk-fashion-flags-row">
                        <span class="dk-fashion-flag-emoji" title="United States">🇺🇸</span>
                        <span class="dk-fashion-flag-emoji" title="United Kingdom">🇬🇧</span>
                        <span class="dk-fashion-flag-emoji" title="Canada">🇨🇦</span>
                        <span class="dk-fashion-flag-emoji" title="Australia">🇦🇺</span>
                        <span class="dk-fashion-flag-more">+ More</span>
                    </div>
                </div>

                <div class="dk-fashion-bottom-divider"></div>

                <!-- Col 3: Bulk Orders -->
                <div class="dk-fashion-bottom-col">
                    <div class="dk-fashion-bottom-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    </div>
                    <div class="dk-fashion-bottom-text">
                        <strong class="dk-fashion-bottom-heading">@bottomBanner.BulkTitle</strong>
                        <span class="dk-fashion-bottom-sub">@bottomBanner.BulkSubtitle</span>
                    </div>
                    <a href="@bottomBanner.BulkButtonUrl" class="dk-fashion-bottom-btn">
                        @bottomBanner.BulkButtonText
                    </a>
                </div>

            </div>
        </section>
    }

</div>

@functions {
    public static string GetCategoryEmoji(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug)) return "👗";
        var s = slug.ToLowerInvariant();
        if (s.Contains("men-clothing") || s == "men") return "🧥";
        if (s.Contains("women-clothing") || s == "women") return "👚";
        if (s.Contains("men-footwear")) return "👟";
        if (s.Contains("women-footwear")) return "👠";
        if (s.Contains("watch")) return "⌚";
        if (s.Contains("sunglass")) return "🕶️";
        if (s.Contains("cap") || s.Contains("hat")) return "🧢";
        if (s.Contains("belt") || s.Contains("wallet")) return "👛";
        if (s.Contains("sock")) return "🧦";
        if (s.Contains("access") || s.Contains("bag")) return "🎒";
        return "👗";
    }
}

