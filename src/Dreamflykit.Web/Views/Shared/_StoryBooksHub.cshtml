@model Dreamflykit.Application.StoryBooksHub.Models.StoryBooksHubDto
@{
    var theme = Model.ThemeSettings ?? new Dreamflykit.Application.StoryBooksHub.Models.StoryBooksThemeSettingsDto();
    var billboard = Model.HeroBillboard ?? new Dreamflykit.Application.StoryBooksHub.Models.StoryBooksHeroBillboardDto();
    var sbBanner = Model.StoryBooksBanner ?? new Dreamflykit.Application.StoryBooksHub.Models.StoryBooksTabHeroBannerDto();
    var npBanner = Model.NewPopularBanner ?? new Dreamflykit.Application.StoryBooksHub.Models.StoryBooksTabHeroBannerDto();
    var langBanner = Model.LanguagesBanner ?? new Dreamflykit.Application.StoryBooksHub.Models.StoryBooksTabHeroBannerDto();
    var sections = Model.Sections ?? new List<Dreamflykit.Application.StoryBooksHub.Models.StoryBooksSectionDto>();
    var allBooks = Model.GetAllBooks();
    var continueReading = Model.GetContinueReadingBooks();
    var top10Books = Model.GetTop10Books();
    var genres = Model.Genres ?? new List<Dreamflykit.Application.StoryBooksHub.Models.StoryBookGenreDto>();
    var languages = Model.Languages ?? new List<Dreamflykit.Application.StoryBooksHub.Models.StoryBookLanguageDto>();
    var preferences = Model.Preferences ?? new List<Dreamflykit.Application.StoryBooksHub.Models.StoryBookPreferenceDto>();
}

<div class="sbf-netflix-container" id="booksflix-hub" data-brand="@theme.BrandName">
    <!-- Netflix-Style Sticky Sub-Navigation -->
    <nav class="sbf-subnav" id="sbf-subnav" aria-label="BooksFlix Navigation">
        <div class="sbf-subnav-left">
            <div class="sbf-brand-badge" title="BooksFlix - Dreamflykit Story Hub" onclick="switchNavTab('sbf-home')">
                <span class="sbf-brand-n">B</span>
                <span class="sbf-brand-title">@theme.BrandName</span>
            </div>

            <ul class="sbf-nav-links" id="sbf-main-tabs" role="tablist">
                <li class="sbf-nav-item">
                    <button type="button" class="sbf-tab-btn active" data-tab="sbf-home" role="tab" aria-selected="true" onclick="switchNavTab('sbf-home')">Home</button>
                </li>
                <li class="sbf-nav-item">
                    <button type="button" class="sbf-tab-btn" data-tab="sbf-storybooks" role="tab" aria-selected="false" onclick="switchNavTab('sbf-storybooks')">Story Books</button>
                </li>
                <li class="sbf-nav-item">
                    <button type="button" class="sbf-tab-btn" data-tab="sbf-newpopular" role="tab" aria-selected="false" onclick="switchNavTab('sbf-newpopular')">New &amp; Popular</button>
                </li>
                <li class="sbf-nav-item">
                    <button type="button" class="sbf-tab-btn" data-tab="sbf-languages" role="tab" aria-selected="false" onclick="switchNavTab('sbf-languages')">Browse by Language</button>
                </li>
            </ul>
        </div>

        <div class="sbf-subnav-right">
            <!-- Hub Quick Search -->
            <div class="sbf-search-box">
                <button type="button" class="sbf-search-toggle" id="sbf-search-toggle" aria-label="Search Books">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
                <input type="search" id="sbf-search-input" class="sbf-search-input" placeholder="Titles, authors, journals..." aria-label="Search story books" />
            </div>

            <!-- Notifications Bell -->
            <div class="sbf-notifications-dropdown" id="sbf-notifications">
                <button type="button" class="sbf-icon-btn" aria-label="Hub Notifications" title="Hub Notifications">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="sbf-badge-dot">3</span>
                </button>
                <div class="sbf-flyout-menu sbf-notif-flyout">
                    <div class="sbf-flyout-header">
                        <strong>Campus Library Updates</strong>
                    </div>
                    <ul class="sbf-flyout-list">
                        <li>
                            <span class="sbf-notif-tag">NEW</span>
                            <div>
                                <p class="sbf-notif-text">Harvard Business Review Spring 2025 Journal added</p>
                                <small>2 hours ago</small>
                            </div>
                        </li>
                        <li>
                            <span class="sbf-notif-tag">TOP 10</span>
                            <div>
                                <p class="sbf-notif-text">Bon Appétit, Your Majesty reached #1 in Campus Fiction</p>
                                <small>Yesterday</small>
                            </div>
                        </li>
                        <li>
                            <span class="sbf-notif-tag">OFFER</span>
                            <div>
                                <p class="sbf-notif-text">Special 40% discount for international university students</p>
                                <small>3 days ago</small>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Student Profile Avatar -->
            <div class="sbf-profile-dropdown">
                <div class="sbf-avatar-btn" title="Student Reader Profile">
                    <span class="sbf-avatar-icon">📚</span>
                    <span class="sbf-avatar-name">Student</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                        <path d="M7 10l5 5 5-5z"/>
                    </svg>
                </div>
            </div>

            <!-- Admin Manage Direct Link -->
            <a href="/Admin/StoryBooksHub" class="sbf-admin-pill" title="Edit Hub via Admin Dashboard">
                ⚙ Edit Hub
            </a>
        </div>
    </nav>

    <!-- USER REQUESTED: Below Navbar, on Left Side: JOURNAL DROPDOWN -->
    <div class="sbf-subbar" id="sbf-subbar">
        <div class="sbf-subbar-left">
            <span class="sbf-journal-tag-label">Journal:</span>
            <div class="sbf-select-custom">
                <select id="sbf-global-journal-select" class="sbf-journal-dropdown-bar" onchange="onGlobalJournalSelect(this.value)">
                    <option value="all">📚 All Journals &amp; Books (@allBooks.Count)</option>
                    @foreach (var genre in genres)
                    {
                        <option value="@genre.Slug">@genre.Emoji @genre.Name (@allBooks.Count(b => b.GenreSlug == genre.Slug))</option>
                    }
                </select>
            </div>
        </div>
        <div class="sbf-subbar-right">
            <span class="sbf-active-pill" id="sbf-active-pill">Viewing: Home Spotlight</span>
        </div>
    </div>

    <!-- ========================================================
         TAB 1: HOME (Hero Billboard + Top 10 + Continue Reading + Curated Shelves)
    ========================================================= -->
    <section class="sbf-tab-pane active" id="sbf-home" role="tabpanel">
        <!-- Full-Width Hero Billboard Banner -->
        @if (billboard.IsEnabled)
        {
            <div class="sbf-hero-banner sbf-billboard" style="background-image: linear-gradient(77deg, rgba(20,20,20,.95) 0%, rgba(20,20,20,.7) 45%, rgba(20,20,20,.15) 100%), url('@billboard.ImageUrl');">
                <div class="sbf-billboard-content">
                    @if (!string.IsNullOrWhiteSpace(billboard.TagBadge))
                    {
                        <div class="sbf-billboard-badge">
                            <span class="sbf-top10-tag">TOP 10</span>
                            <span class="sbf-badge-subtitle">@billboard.TagBadge</span>
                        </div>
                    }

                    <h1 class="sbf-billboard-title">@billboard.Title</h1>

                    <div class="sbf-billboard-meta">
                        <span class="sbf-meta-author">By @billboard.Author</span>
                        <span class="sbf-meta-divider">•</span>
                        <span class="sbf-meta-rating">★ @billboard.Rating.ToString("0.0")</span>
                        <span class="sbf-meta-reviews">(@billboard.ReviewCount.ToString("N0") reviews)</span>
                        <span class="sbf-meta-divider">•</span>
                        <span class="sbf-meta-pill">@billboard.ReadTime</span>
                        <span class="sbf-meta-pill">@billboard.Language</span>
                    </div>

                    <p class="sbf-billboard-genres">@billboard.GenreTags</p>
                    <p class="sbf-billboard-synopsis">@billboard.Synopsis</p>

                    <div class="sbf-billboard-price-row">
                        <span class="sbf-billboard-price">₹@billboard.Price.ToString("N0")</span>
                        @if (billboard.OriginalPrice > billboard.Price)
                        {
                            <span class="sbf-billboard-mrp">₹@billboard.OriginalPrice.ToString("N0")</span>
                            <span class="sbf-billboard-discount">(@billboard.DiscountPercent% OFF)</span>
                        }
                    </div>

                    <div class="sbf-billboard-actions">
                        <button type="button" class="sbf-btn sbf-btn-primary" onclick="openBookModal('@billboard.Title', '@billboard.Author', '@billboard.Synopsis', '@billboard.ImageUrl', '@billboard.Price', '@billboard.OriginalPrice', '@billboard.Rating', '@billboard.GenreTags', '@billboard.Language', '@billboard.ReadTime')">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                            <span>@billboard.PrimaryButtonText</span>
                        </button>

                        <button type="button" class="sbf-btn sbf-btn-secondary" onclick="openBookModal('@billboard.Title', '@billboard.Author', '@billboard.Synopsis', '@billboard.ImageUrl', '@billboard.Price', '@billboard.OriginalPrice', '@billboard.Rating', '@billboard.GenreTags', '@billboard.Language', '@billboard.ReadTime')">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <span>@billboard.SecondaryButtonText</span>
                        </button>

                        <button type="button" class="sbf-btn sbf-btn-cart" onclick="addHubBookToCart('@billboard.Title', @billboard.Price)">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span>Add to Cart</span>
                        </button>
                    </div>
                </div>

                @if (billboard.IsUploadingSoon)
                {
                    <div class="sbf-billboard-uploading-tag">
                        <span class="sbf-badge-pulse">●</span> Image Uploading Soon (Admin Replaceable)
                    </div>
                }
            </div>
        }

        <!-- Continue Reading for Student Row (if available) -->
        @if (continueReading.Any())
        {
            <div class="sbf-shelf-section">
                <div class="sbf-shelf-header">
                    <h2 class="sbf-shelf-title">Continue Reading for Student</h2>
                    <span class="sbf-shelf-subtitle">Pick up right where you left off</span>
                </div>

                <div class="sbf-carousel-wrapper">
                    <button type="button" class="sbf-arrow sbf-arrow-prev" onclick="scrollShelf(this, -1)" aria-label="Scroll Left">‹</button>
                    <div class="sbf-carousel-track">
                        @foreach (var book in continueReading)
                        {
                            <div class="sbf-book-card sbf-reading-card" data-book-id="@book.Id" data-title="@book.Title" data-author="@book.Author" data-genre="@book.GenreSlug" data-lang="@book.Language" data-pref="@book.EditionPreference">
                                <div class="sbf-card-poster">
                                    <img src="@book.CoverImageUrl" alt="@book.Title" loading="lazy" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                                    @if (book.IsUploadingSoon)
                                    {
                                        <div class="sbf-uploading-tag">Uploading Soon</div>
                                    }
                                    <div class="sbf-card-overlay">
                                        <button type="button" class="sbf-mini-btn sbf-mini-play" title="Resume Reading" onclick="openBookModal('@book.Title', '@book.Author', '@book.Synopsis', '@book.CoverImageUrl', '@book.Price', '@book.OriginalPrice', '@book.Rating', '@book.GenreName', '@book.Language', '@book.Pages pages')">▶</button>
                                        <button type="button" class="sbf-mini-btn" title="Add to Wishlist" onclick="toggleWishlist(this, '@book.Title')">♡</button>
                                        <button type="button" class="sbf-mini-btn" title="Add to Cart" onclick="addHubBookToCart('@book.Title', @book.Price)">🛒</button>
                                    </div>
                                    <div class="sbf-reading-bar-wrap">
                                        <div class="sbf-reading-bar-fill" style="width: @(book.ProgressPercent)%;"></div>
                                    </div>
                                </div>
                                <div class="sbf-card-info">
                                    <h3 class="sbf-card-title">@book.Title</h3>
                                    <p class="sbf-card-author">@book.Author</p>
                                    <div class="sbf-card-progress-text">@book.ReadingProgress (@book.ProgressPercent%)</div>
                                    <div class="sbf-card-price-row">
                                        <span class="sbf-card-price">₹@book.Price.ToString("N0")</span>
                                        @if (book.OriginalPrice > book.Price)
                                        {
                                            <span class="sbf-card-mrp">₹@book.OriginalPrice.ToString("N0")</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="sbf-arrow sbf-arrow-next" onclick="scrollShelf(this, 1)" aria-label="Scroll Right">›</button>
                </div>
            </div>
        }

        <!-- Top 10 Books Today Row (Netflix Giant Numbers Style) -->
        @if (top10Books.Any())
        {
            <div class="sbf-shelf-section sbf-top10-shelf">
                <div class="sbf-shelf-header">
                    <h2 class="sbf-shelf-title">
                        <span class="sbf-red-mark">Top 10 Books</span> Today in University Circles
                    </h2>
                    <span class="sbf-shelf-subtitle">Most read &amp; discussed by students this week</span>
                </div>

                <div class="sbf-carousel-wrapper">
                    <button type="button" class="sbf-arrow sbf-arrow-prev" onclick="scrollShelf(this, -1)" aria-label="Scroll Left">‹</button>
                    <div class="sbf-carousel-track sbf-top10-track">
                        @foreach (var book in top10Books)
                        {
                            <div class="sbf-top10-item" data-title="@book.Title" data-author="@book.Author" data-genre="@book.GenreSlug" data-lang="@book.Language" data-pref="@book.EditionPreference">
                                <div class="sbf-top10-number">@book.Top10Rank</div>
                                <div class="sbf-book-card sbf-top10-card">
                                    <div class="sbf-card-poster">
                                        <img src="@book.CoverImageUrl" alt="@book.Title" loading="lazy" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                                        @if (book.IsUploadingSoon)
                                        {
                                            <div class="sbf-uploading-tag">Uploading Soon</div>
                                        }
                                        <div class="sbf-card-overlay">
                                            <button type="button" class="sbf-mini-btn sbf-mini-play" title="Start Reading" onclick="openBookModal('@book.Title', '@book.Author', '@book.Synopsis', '@book.CoverImageUrl', '@book.Price', '@book.OriginalPrice', '@book.Rating', '@book.GenreName', '@book.Language', '@book.Pages pages')">▶</button>
                                            <button type="button" class="sbf-mini-btn" title="Add to Wishlist" onclick="toggleWishlist(this, '@book.Title')">♡</button>
                                            <button type="button" class="sbf-mini-btn" title="Add to Cart" onclick="addHubBookToCart('@book.Title', @book.Price)">🛒</button>
                                        </div>
                                    </div>
                                    <div class="sbf-card-info">
                                        <h3 class="sbf-card-title">@book.Title</h3>
                                        <p class="sbf-card-author">@book.Author</p>
                                        <div class="sbf-card-meta-line">
                                            <span class="sbf-star">★ @book.Rating.ToString("0.0")</span>
                                            <span class="sbf-tag-sm">@book.GenreName</span>
                                        </div>
                                        <div class="sbf-card-price-row">
                                            <span class="sbf-card-price">₹@book.Price.ToString("N0")</span>
                                            @if (book.OriginalPrice > book.Price)
                                            {
                                                <span class="sbf-card-mrp">₹@book.OriginalPrice.ToString("N0")</span>
                                                <span class="sbf-card-disc">@book.DiscountPercent% off</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="sbf-arrow sbf-arrow-next" onclick="scrollShelf(this, 1)" aria-label="Scroll Right">›</button>
                </div>
            </div>
        }

        <!-- Standard Curated Shelves (Trending, Academic Journals, Fiction, etc.) -->
        @foreach (var sec in sections.Where(s => s.IsActive && s.DisplayType != "top10" && s.DisplayType != "continue-reading").OrderBy(s => s.DisplayOrder))
        {
            <div class="sbf-shelf-section">
                <div class="sbf-shelf-header">
                    <h2 class="sbf-shelf-title">@sec.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(sec.Subtitle))
                    {
                        <span class="sbf-shelf-subtitle">@sec.Subtitle</span>
                    }
                </div>

                <div class="sbf-carousel-wrapper">
                    <button type="button" class="sbf-arrow sbf-arrow-prev" onclick="scrollShelf(this, -1)" aria-label="Scroll Left">‹</button>
                    <div class="sbf-carousel-track">
                        @foreach (var book in sec.Books)
                        {
                            <div class="sbf-book-card" data-book-id="@book.Id" data-title="@book.Title" data-author="@book.Author" data-genre="@book.GenreSlug" data-lang="@book.Language" data-pref="@book.EditionPreference">
                                <div class="sbf-card-poster">
                                    <img src="@book.CoverImageUrl" alt="@book.Title" loading="lazy" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                                    @if (book.IsUploadingSoon)
                                    {
                                        <div class="sbf-uploading-tag">Uploading Soon</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(book.BadgeText))
                                    {
                                        <div class="sbf-tag-badge">@book.BadgeText</div>
                                    }
                                    <div class="sbf-card-overlay">
                                        <button type="button" class="sbf-mini-btn sbf-mini-play" title="Read / Preview" onclick="openBookModal('@book.Title', '@book.Author', '@book.Synopsis', '@book.CoverImageUrl', '@book.Price', '@book.OriginalPrice', '@book.Rating', '@book.GenreName', '@book.Language', '@book.Pages pages')">▶</button>
                                        <button type="button" class="sbf-mini-btn" title="Add to Wishlist" onclick="toggleWishlist(this, '@book.Title')">♡</button>
                                        <button type="button" class="sbf-mini-btn" title="Add to Cart" onclick="addHubBookToCart('@book.Title', @book.Price)">🛒</button>
                                    </div>
                                </div>
                                <div class="sbf-card-info">
                                    <h3 class="sbf-card-title">@book.Title</h3>
                                    <p class="sbf-card-author">@book.Author</p>
                                    <div class="sbf-card-meta-line">
                                        <span class="sbf-star">★ @book.Rating.ToString("0.0")</span>
                                        <span class="sbf-tag-sm">@book.GenreName</span>
                                        <span class="sbf-tag-lang">@book.Language</span>
                                    </div>
                                    <div class="sbf-card-price-row">
                                        <span class="sbf-card-price">₹@book.Price.ToString("N0")</span>
                                        @if (book.OriginalPrice > book.Price)
                                        {
                                            <span class="sbf-card-mrp">₹@book.OriginalPrice.ToString("N0")</span>
                                            <span class="sbf-card-disc">@book.DiscountPercent% off</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="sbf-arrow sbf-arrow-next" onclick="scrollShelf(this, 1)" aria-label="Scroll Right">›</button>
                </div>
            </div>
        }
    </section>

    <!-- ========================================================
         TAB 2: STORY BOOKS (Full-Width Hero Banner + Journal Filtered Books)
    ========================================================= -->
    <section class="sbf-tab-pane" id="sbf-storybooks" role="tabpanel">
        <!-- USER REQUESTED: Full-Width Hero Banner for Story Books -->
        @if (sbBanner.IsEnabled)
        {
            <div class="sbf-hero-banner" style="background-image: linear-gradient(77deg, rgba(20,20,20,.95) 0%, rgba(20,20,20,.7) 45%, rgba(20,20,20,.15) 100%), url('@sbBanner.ImageUrl');">
                <div class="sbf-billboard-content">
                    <div class="sbf-billboard-badge">
                        <span class="sbf-top10-tag" id="sbf-sb-badge-tag">JOURNALS &amp; NOVELS</span>
                        <span class="sbf-badge-subtitle" id="sbf-sb-badge-sub">@sbBanner.TagBadge</span>
                    </div>

                    <h1 class="sbf-billboard-title" id="sbf-sb-title">@sbBanner.Title</h1>
                    <p class="sbf-billboard-genres" id="sbf-sb-meta">@sbBanner.MetaTags</p>
                    <p class="sbf-billboard-synopsis" id="sbf-sb-synopsis">@sbBanner.Subtitle</p>

                    <div class="sbf-billboard-actions">
                        <button type="button" class="sbf-btn sbf-btn-primary" onclick="scrollShelfIntoView('sbf-genre-grid')">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                            <span>@sbBanner.PrimaryButtonText</span>
                        </button>
                        <button type="button" class="sbf-btn sbf-btn-secondary" onclick="alert('Viewing comprehensive index of scholarly journals & university novels.')">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <span>@sbBanner.SecondaryButtonText</span>
                        </button>
                    </div>
                </div>

                @if (sbBanner.IsUploadingSoon)
                {
                    <div class="sbf-billboard-uploading-tag">
                        <span class="sbf-badge-pulse">●</span> Image Uploading Soon (Admin Replaceable)
                    </div>
                }
            </div>
        }

        <div class="sbf-pane-header">
            <div class="sbf-pane-title-group">
                <h2 class="sbf-pane-title" id="sbf-pane-genre-heading">Story Books &amp; Academic Journals</h2>
                <p class="sbf-pane-subtitle" id="sbf-pane-genre-sub">Showing books filtered by the journal dropdown above</p>
            </div>
            <div class="sbf-genre-status-badge" id="sbf-genre-status-badge">
                Showing all @allBooks.Count books
            </div>
        </div>

        <!-- Dynamic Filtered Book Grid -->
        <div class="sbf-books-grid" id="sbf-genre-grid">
            @foreach (var book in allBooks)
            {
                <div class="sbf-grid-item" data-genre="@book.GenreSlug" data-lang="@book.Language" data-pref="@book.EditionPreference" data-title="@book.Title" data-author="@book.Author">
                    <div class="sbf-book-card">
                        <div class="sbf-card-poster">
                            <img src="@book.CoverImageUrl" alt="@book.Title" loading="lazy" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                            @if (book.IsUploadingSoon)
                            {
                                <div class="sbf-uploading-tag">Uploading Soon</div>
                            }
                            @if (book.IsTop10)
                            {
                                <div class="sbf-tag-badge sbf-badge-red">TOP 10 #@book.Top10Rank</div>
                            }
                            <div class="sbf-card-overlay">
                                <button type="button" class="sbf-mini-btn sbf-mini-play" title="Read / Preview" onclick="openBookModal('@book.Title', '@book.Author', '@book.Synopsis', '@book.CoverImageUrl', '@book.Price', '@book.OriginalPrice', '@book.Rating', '@book.GenreName', '@book.Language', '@book.Pages pages')">▶</button>
