@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.StudyHub ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefault();
    var catPage = hub.CategoriesPage ?? new();
    var currentSubSlug = Model.CurrentSubcategorySlug;
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    // Exactly the 6 Study Essentials categories
    var studyCategories = catPage.Categories != null && catPage.Categories.Count > 0
        ? catPage.Categories
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefault().CategoriesPage.Categories;

    var activeCategory = studyCategories.FirstOrDefault(c => string.Equals(c.Slug, currentSubSlug, StringComparison.OrdinalIgnoreCase))
                         ?? studyCategories.FirstOrDefault(c => string.Equals(c.Slug, "stationery-study-supplies", StringComparison.OrdinalIgnoreCase))
                         ?? studyCategories.FirstOrDefault();

    var activeCategoryName = activeCategory?.Name ?? Model.CategoryName ?? "Study Essentials";
    var activeCategorySubcategories = activeCategory?.Subcategories ?? new List<string>();
    var activeSubItem = Model.CurrentSubcatItem ?? "";

    var isFestive = catPage.FestivalThemeEnabled;
    var frameDesign = catPage.FrameDesign ?? "arch-gold";
}

<div class="dk-study-cat-page-wrapper">

    @if (canManage)
    {
        <div class="dk-study-hub-admin-bar">
            <span class="dk-sh-admin-badge">Admin Controls</span>
            <span class="dk-sh-admin-hint">Managing Study Essentials Category: <strong>@activeCategoryName</strong>. Super Admin can replace hero image, festival theme &amp; subcategories.</span>
            <a href="/Admin/StudyHub" class="dk-sh-admin-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Manage Categories &amp; Common Hero
            </a>
        </div>
    }

    <!-- ========================================================
         COMMON HERO BANNER (TOP FULL WIDTH)
         Admin Replaceable Image + Festival Theme + Frame Design
    ========================================================= -->
    <header class="dk-study-common-hero @(isFestive ? "is-festive-hero frame-" + frameDesign : "frame-" + frameDesign)">
        @if (isFestive)
        {
            <div class="dk-festive-decor-top">
                <span class="dk-diya">🪔</span>
                <span class="dk-festive-badge">✨ DIWALI SPECIAL • FESTIVAL OF LEARNING ✨</span>
                <span class="dk-diya">🪔</span>
            </div>
        }

        <div class="dk-hero-inner-grid">
            <div class="dk-hero-text-col">
                <div class="dk-hero-pill-badge">
                    <span class="dk-hero-dot"></span>
                    @(string.IsNullOrWhiteSpace(catPage.HeroPillText) ? "STUDY ESSENTIALS" : catPage.HeroPillText)
                </div>

                <h1 class="dk-hero-main-title">@catPage.HeroTitle</h1>
                <p class="dk-hero-main-sub">@catPage.HeroSubtitle</p>

                <div class="dk-hero-trust-badges">
                    <div class="dk-hero-trust-item">
                        <span class="dk-hero-trust-icon">🎓</span>
                        <span>Student Trusted &bull; <strong>10K+ Students</strong></span>
                    </div>
                    <div class="dk-hero-trust-item">
                        <span class="dk-hero-trust-icon">🌐</span>
                        <span>Curated for Abroad &bull; <strong>Universities Worldwide</strong></span>
                    </div>
                    <div class="dk-hero-trust-item">
                        <span class="dk-hero-trust-icon">💡</span>
                        <span>Smart &amp; Affordable &bull; <strong>Best Value Essentials</strong></span>
                    </div>
                </div>
            </div>

            <div class="dk-hero-img-col">
                @{
                    var heroImg = !string.IsNullOrWhiteSpace(catPage.HeroImageUrl) ? catPage.HeroImageUrl : "/images/study-hub/test-pic-placeholder.svg";
                    var isTestPic = string.IsNullOrWhiteSpace(heroImg) || heroImg.Contains("test-pic-placeholder");
                }

                @if (isTestPic)
                {
                    <div class="dk-hero-test-pic-box">
                        <div class="dk-hero-cam-icon">📷</div>
                        <div class="dk-hero-test-btn">TEST PIC</div>
                        <div class="dk-hero-test-title">Super Admin Replaceable</div>
                        <div class="dk-hero-test-sub">Admin panel can upload/replace image anytime</div>
                    </div>
                }
                else
                {
                    <div class="dk-hero-custom-img-wrap">
                        <img src="@heroImg" alt="Study Essentials Hero" loading="eager" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                    </div>
                }
            </div>
        </div>

        <!-- 4 Bottom Trust Highlights Bar inside Hero -->
        <div class="dk-hero-trust-bar">
            <div class="dk-htb-item">
                <span class="dk-htb-icon">⭐</span>
                <div>
                    <strong>Quality Products</strong>
                    <span>Handpicked for Students</span>
                </div>
            </div>
            <div class="dk-htb-item">
                <span class="dk-htb-icon">📦</span>
                <div>
                    <strong>Affordable Bundles</strong>
                    <span>Save More, Study More</span>
                </div>
            </div>
            <div class="dk-htb-item">
                <span class="dk-htb-icon">🔒</span>
                <div>
                    <strong>Secure Checkout</strong>
                    <span>Multiple Payment Options</span>
                </div>
            </div>
            <div class="dk-htb-item">
                <span class="dk-htb-icon">🚚</span>
                <div>
                    <strong>Fast &amp; Reliable Delivery</strong>
                    <span>To Your Doorstep</span>
                </div>
            </div>
        </div>
    </header>

    <!-- ========================================================
         6 STUDY CATEGORIES QUICK NAV PILLS STRIP
    ========================================================= -->
    <div class="dk-study-cat-nav-strip">
        <div class="dk-study-cat-nav-title">
            <span>Explore 6 Categories:</span>
        </div>
        <div class="dk-study-cat-nav-items">
            @foreach (var c in studyCategories)
            {
                var isSelected = string.Equals(c.Slug, activeCategory?.Slug, StringComparison.OrdinalIgnoreCase);
                <a href="/category/study-essentials/@c.Slug"
                   class="dk-cat-nav-pill @(isSelected ? "is-selected" : "")">
                    <span class="dk-cat-pill-icon">
                        @if (c.Icon == "laptop" || c.Slug.Contains("tech")) { <text>💻</text> }
                        else if (c.Icon == "file" || c.Slug.Contains("document")) { <text>📁</text> }
                        else if (c.Icon == "lamp" || c.Slug.Contains("desk")) { <text>🛋️</text> }
                        else if (c.Icon == "bag" || c.Slug.Contains("campus")) { <text>🎒</text> }
                        else if (c.Icon == "monitor" || c.Slug.Contains("online")) { <text>🖥️</text> }
                        else { <text>✏️</text> }
                    </span>
                    <span class="dk-cat-pill-name">@c.Name</span>
                </a>
            }
        </div>
    </div>

    <!-- ========================================================
         MAIN 2-COLUMN LAYOUT:
         LEFT: SUBCATEGORIES FILTER LIST FOR THIS CATEGORY
         RIGHT: MATCHING PRODUCTS LIST
    ========================================================= -->
    <div class="dk-cat-main-layout">

        <!-- LEFT SIDEBAR: SUBCATEGORIES FILTER -->
        <aside class="dk-cat-sidebar" id="dkStudySidebar">
            <div class="dk-cat-sidebar-card">
                <div class="dk-cat-sidebar-header">
                    <h2 class="dk-cat-sidebar-title">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Subcategories
                    </h2>
                    @if (!string.IsNullOrWhiteSpace(activeSubItem))
                    {
                        <button type="button" class="dk-cat-clear-btn" onclick="filterBySubItem('')" title="Clear subcategory filter">
                            Clear
                        </button>
                    }
                </div>

                <div class="dk-cat-sidebar-subhead">
                    <span>@activeCategoryName</span>
                </div>

                <nav class="dk-cat-sub-list" aria-label="@activeCategoryName Subcategories">
                    <!-- Option to view all products of this category -->
                    <a href="/category/study-essentials/@activeCategory?.Slug"
                       class="dk-cat-sub-link @(string.IsNullOrWhiteSpace(activeSubItem) ? "is-active" : "")"
                       data-subitem=""
                       onclick="event.preventDefault(); filterBySubItem('');">
                        <span class="dk-sub-radio"></span>
                        <span class="dk-sub-text">All @activeCategoryName</span>
                        <span class="dk-sub-badge">All</span>
                    </a>

                    <!-- Subcategories list provided by user -->
                    @foreach (var sub in activeCategorySubcategories)
                    {
                        var isCurrentSub = string.Equals(activeSubItem, sub, StringComparison.OrdinalIgnoreCase);
                        <a href="/category/study-essentials/@activeCategory?.Slug?subcatItem=@Uri.EscapeDataString(sub)"
                           class="dk-cat-sub-link @(isCurrentSub ? "is-active" : "")"
                           data-subitem="@sub"
                           onclick="event.preventDefault(); filterBySubItem(this.dataset.subitem);">
                            <span class="dk-sub-radio"></span>
                            <span class="dk-sub-text">@sub</span>
                        </a>
                    }
                </nav>
            </div>

            <!-- IMPORTANT NOTE CARD (FOR CATEGORY 3 DOCUMENTS & ORGANIZATION) -->
            @if (!string.IsNullOrWhiteSpace(activeCategory?.ImportantNote))
            {
                <div class="dk-cat-note-card">
                    <div class="dk-cat-note-head">
                        <span class="dk-cat-note-icon">💡</span>
                        <strong>Important Student Note:</strong>
                    </div>
                    <p class="dk-cat-note-text">
                        @activeCategory.ImportantNote
                    </p>
                </div>
            }

            <!-- Price Filters Strip in Sidebar -->
            <div class="dk-cat-sidebar-card" style="margin-top: 14px;">
                <h3 class="dk-cat-sidebar-title" style="font-size: 13.5px; margin-bottom: 10px;">Price Range</h3>
                <div class="dk-cat-price-facets">
                    <a href="?minPrice=&maxPrice=500" class="dk-price-facet-chip">Under ₹500</a>
                    <a href="?minPrice=500&maxPrice=1000" class="dk-price-facet-chip">₹500 - ₹1,000</a>
                    <a href="?minPrice=1000&maxPrice=2000" class="dk-price-facet-chip">₹1,000 - ₹2,000</a>
                    <a href="?minPrice=2000&maxPrice=" class="dk-price-facet-chip">₹2,000 &amp; Above</a>
                </div>
            </div>

            <!-- Need Complete Kit Promo -->
            <div class="dk-cat-sidebar-promo">
                <div class="dk-sp-tag">Starter Bundle</div>
                <h4 class="dk-sp-title">Complete Study Abroad Kits</h4>
                <p class="dk-sp-sub">Curated packs with essential university stationery &amp; tech gear.</p>
                <a href="/category/study-essentials" class="dk-sp-btn">Explore Study Hub →</a>
            </div>
        </aside>

        <!-- RIGHT CONTENT AREA: PRODUCTS LIST -->
        <main class="dk-cat-content" id="dkCatContentArea">
            <partial name="_StudyEssentialsProductsListPartial" model="Model" />
        </main>
    </div>

</div>

<!-- ========================================================
     INLINE STYLING FOR COMMON HERO & 6 CATEGORIES VIEW
========================================================= -->
<style>
    .dk-study-cat-page-wrapper {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        padding: 4px 0 32px 0;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Admin bar */
    .dk-study-hub-admin-bar {
        background: #0f172a;
        color: #f8fafc;
        padding: 10px 18px;
        border-radius: 10px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }
    .dk-sh-admin-badge {
        background: #0284c7;
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .dk-sh-admin-hint {
        font-size: 12.5px;
        color: #cbd5e1;
        flex: 1;
    }
    .dk-sh-admin-btn {
        background: #ffffff;
        color: #0f172a;
        font-size: 12.5px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }
    .dk-sh-admin-btn:hover {
        background: #f1f5f9;
        transform: translateY(-1px);
    }

    /* ========================================================
       COMMON HERO BANNER (FULL WIDTH .dk-shell)
    ========================================================= */
    .dk-study-common-hero {
        width: 100%;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 18px;
        box-sizing: border-box;
        position: relative;
        background: linear-gradient(135deg, #063f91 0%, #0849a3 45%, #0284c7 100%);
        color: #ffffff;
        box-shadow: 0 6px 20px rgba(6, 63, 145, 0.16);
        border: 1px solid #0369a1;
        transition: all 0.3s ease;
    }

    /* Festive theme variations */
    .dk-study-common-hero.is-festive-hero {
        background: linear-gradient(135deg, #7c1315 0%, #991b1b 35%, #c2410c 70%, #d97706 100%);
        border: 2px solid #fbbf24;
        box-shadow: 0 8px 30px rgba(185, 28, 28, 0.28), 0 0 15px rgba(251, 191, 36, 0.2);
    }
    .dk-study-common-hero.frame-arch-gold {
        border: 2px solid #f59e0b;
        box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
    }
    .dk-study-common-hero.frame-festive-glow {
        border: 2px solid #fbbf24;
        box-shadow: 0 0 30px rgba(251, 191, 36, 0.35);
    }

    .dk-festive-decor-top {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: rgba(0, 0, 0, 0.25);
        padding: 6px 16px;
        font-size: 13px;
        font-weight: 800;
        color: #fef08a;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(251, 191, 36, 0.4);
    }
    .dk-festive-decor-top .dk-diya {
        font-size: 16px;
        animation: diyaPulse 2s infinite ease-in-out;
    }
    @@keyframes diyaPulse {
        0%, 100% { transform: scale(1); filter: drop-shadow(0 0 3px #fbbf24); }
        50% { transform: scale(1.15); filter: drop-shadow(0 0 8px #f59e0b); }
    }

    .dk-hero-inner-grid {
        display: grid;
        grid-template-columns: 1.35fr 0.85fr;
        gap: 24px;
        padding: 28px 32px;
        align-items: center;
    }
    @@media (max-width: 900px) {
        .dk-hero-inner-grid {
            grid-template-columns: 1fr;
            padding: 20px 18px;
            gap: 18px;
        }
    }

    .dk-hero-pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(8px);
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 800;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #ffffff;
        margin-bottom: 12px;
        border: 1px solid rgba(255, 255, 255, 0.25);
    }
    .dk-hero-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #ff7900;
        box-shadow: 0 0 6px #ff7900;
    }

    .dk-hero-main-title {
        font-size: 1.95rem;
        font-weight: 900;
        line-height: 1.25;
        margin: 0 0 8px 0;
        color: #ffffff;
        letter-spacing: -0.02em;
    }
    @@media (max-width: 600px) {
        .dk-hero-main-title { font-size: 1.55rem; }
    }

    .dk-hero-main-sub {
        font-size: 0.98rem;
        line-height: 1.5;
        color: #e0f2fe;
        margin: 0 0 16px 0;
        max-width: 620px;
    }
    .is-festive-hero .dk-hero-main-sub {
        color: #fed7aa;
    }

    .dk-hero-trust-badges {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }
    .dk-hero-trust-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        color: #f0fdf4;
    }
    .dk-hero-trust-icon {
        font-size: 15px;
    }

    /* Test pic card on hero right */
    .dk-hero-test-pic-box {
        background: radial-gradient(circle at center, #0f274a 0%, #06162d 100%);
        border: 2px dashed #0284c7;
        border-radius: 14px;
        padding: 24px 20px;
        text-align: center;
        box-shadow: inset 0 0 24px rgba(2, 132, 199, 0.15);
        color: #ffffff;
        min-height: 160px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .is-festive-hero .dk-hero-test-pic-box {
        border-color: #fbbf24;
        background: radial-gradient(circle at center, #3b0709 0%, #1a0405 100%);
    }
    .dk-hero-cam-icon {
        font-size: 26px;
        margin-bottom: 6px;
        opacity: 0.9;
    }
    .dk-hero-test-btn {
        background: #0284c7;
        color: #ffffff;
        font-weight: 800;
        font-size: 11.5px;
        padding: 4px 14px;
        border-radius: 999px;
        letter-spacing: 0.6px;
        display: inline-block;
        margin-bottom: 8px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .is-festive-hero .dk-hero-test-btn {
        background: #d97706;
    }
    .dk-hero-test-title {
        font-weight: 800;
        font-size: 14px;
        margin-bottom: 4px;
    }
    .dk-hero-test-sub {
        font-size: 11px;
        color: #94a3b8;
    }

    .dk-hero-custom-img-wrap {
        border-radius: 12px;
        overflow: hidden;
        max-height: 220px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    }
    .dk-hero-custom-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Bottom Trust Bar inside Hero */
    .dk-hero-trust-bar {
        background: rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        padding: 12px 24px;
        gap: 16px;
    }
    @@media (max-width: 820px) {
        .dk-hero-trust-bar {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            padding: 12px 16px;
        }
    }
    @@media (max-width: 480px) {
        .dk-hero-trust-bar {
            grid-template-columns: 1fr;
        }
    }
    .dk-htb-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .dk-htb-icon {
        font-size: 18px;
    }
    .dk-htb-item strong {
        display: block;
        font-size: 12px;
        font-weight: 800;
        color: #ffffff;
    }
    .dk-htb-item span {
        font-size: 11px;
        color: #bae6fd;
    }
    .is-festive-hero .dk-htb-item span {
        color: #fed7aa;
    }

    /* ========================================================
       6 CATEGORIES QUICK NAV PILLS STRIP
    ========================================================= */
    .dk-study-cat-nav-strip {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 16px;
        margin-bottom: 18px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }
    .dk-study-cat-nav-title {
        font-size: 12.5px;
        font-weight: 800;
        color: #063f91;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }
    .dk-study-cat-nav-items {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        flex: 1;
    }
    .dk-cat-nav-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 700;
        text-decoration: none;
        background: #f8fafc;
        color: #334155;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
    }
    .dk-cat-nav-pill:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #063f91;
    }
    .dk-cat-nav-pill.is-selected {
        background: linear-gradient(135deg, #063f91 0%, #075bc8 100%);
        color: #ffffff;
        border-color: #063f91;
        box-shadow: 0 2px 8px rgba(6, 63, 145, 0.25);
    }
    .dk-cat-pill-icon {
        font-size: 13.5px;
    }

    /* ========================================================
       2-COLUMN LAYOUT
    ========================================================= */
    .dk-cat-main-layout {
        display: grid;
        grid-template-columns: 290px 1fr;
        gap: 20px;
        align-items: flex-start;
    }
    @@media (max-width: 960px) {
        .dk-cat-main-layout {
            grid-template-columns: 1fr;
        }
    }

    /* LEFT SIDEBAR */
    .dk-cat-sidebar {
        position: sticky;
        top: 80px;
    }
    .dk-cat-sidebar-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
    }
    .dk-cat-sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
        padding-bottom: 10px;
        border-bottom: 1px solid #f1f5f9;
    }
    .dk-cat-sidebar-title {
        font-size: 14.5px;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .dk-cat-clear-btn {
        background: none;
        border: none;
        color: #0284c7;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        padding: 0;
    }
    .dk-cat-clear-btn:hover {
        text-decoration: underline;
    }
    .dk-cat-sidebar-subhead {
        font-size: 11.5px;
        font-weight: 800;
        color: #0284c7;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin: 10px 0 8px 4px;
    }

    .dk-cat-sub-list {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
    .dk-cat-sub-link {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 13px;
