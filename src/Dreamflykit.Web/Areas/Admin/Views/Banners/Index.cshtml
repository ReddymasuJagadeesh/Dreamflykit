@model Dreamflykit.Web.Areas.Admin.Models.BannerListViewModel
@{
    ViewData["Title"] = "Manage Banners & Promotions";
}

<div class="dk-admin-content-card">
    <div class="dk-admin-card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
        <div>
            <h1 class="dk-admin-card-title" style="font-size: 1.5rem; margin: 0;">Banners & Promotions</h1>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0.25rem 0 0;">
                Configure dynamic hero sliders, promotional strips, and time-based campaign graphics.
            </p>
        </div>
        <div>
            <a href="/Admin/Banners/Create" class="dk-btn dk-btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Add Banner</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="dk-alert dk-alert-success" style="margin-bottom: 1.5rem; padding: 0.75rem 1rem; background: #ecfdf5; border-left: 4px solid #10b981; color: #065f46; border-radius: 4px;">
            @msg
        </div>
    }

    @if (!Model.Banners.Any())
    {
        <div style="text-align: center; padding: 4rem 1rem;">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-muted); margin-bottom: 1rem;">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
            <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">No banners created yet</h3>
            <p style="color: var(--text-muted); max-width: 400px; margin: 0 auto 1.5rem;">
                Create promotional banners to highlight sales, featured kits, or announcements.
            </p>
            <a href="/Admin/Banners/Create" class="dk-btn dk-btn-primary">Create First Banner</a>
        </div>
    }
    else
    {
        <div class="dk-table-responsive" style="overflow-x: auto;">
            <table class="dk-admin-table" style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                <thead>
                    <tr style="border-bottom: 2px solid #e5e7eb; text-align: left; background: var(--bg-alt, #f9fafb);">
                        <th style="padding: 0.75rem 1rem; width: 100px;">Banner</th>
                        <th style="padding: 0.75rem 1rem;">Title & Subtitle</th>
                        <th style="padding: 0.75rem 1rem;">CTA Link</th>
                        <th style="padding: 0.75rem 1rem; width: 80px; text-align: center;">Order</th>
                        <th style="padding: 0.75rem 1rem; width: 120px;">Schedule</th>
                        <th style="padding: 0.75rem 1rem; width: 100px;">Status</th>
                        <th style="padding: 0.75rem 1rem; width: 120px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Banners)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 0.75rem 1rem;">
                                @if (!string.IsNullOrWhiteSpace(b.ImageUrl))
                                {
                                    <img src="@b.ImageUrl" alt="@b.Title" style="width: 80px; height: 45px; object-fit: cover; border-radius: 4px; border: 1px solid #e5e7eb;" />
                                }
                                else
                                {
                                    <div style="width: 80px; height: 45px; background: #e5e7eb; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; color: #6b7280;">No Image</div>
                                }
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                <div style="font-weight: 600;">@b.Title</div>
                                @if (!string.IsNullOrWhiteSpace(b.Subtitle))
                                {
                                    <div style="font-size: 0.8rem; color: var(--text-muted);">@b.Subtitle</div>
                                }
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                @if (!string.IsNullOrWhiteSpace(b.CtaUrl))
                                {
                                    <span style="font-size: 0.85rem;">@b.CtaText: <code>@b.CtaUrl</code></span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted); font-size: 0.85rem;">—</span>
                                }
                            </td>
                            <td style="padding: 0.75rem 1rem; text-align: center; font-weight: 600;">
                                @b.DisplayOrder
                            </td>
                            <td style="padding: 0.75rem 1rem; font-size: 0.8rem; color: var(--text-muted);">
                                @if (b.StartDateUtc.HasValue || b.EndDateUtc.HasValue)
                                {
                                    <div>From: @(b.StartDateUtc?.ToString("MMM dd") ?? "Always")</div>
                                    <div>To: @(b.EndDateUtc?.ToString("MMM dd") ?? "Ongoing")</div>
                                }
                                else
                                {
                                    <span>Always Active</span>
                                }
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                @if (b.IsPublished && b.IsActive)
                                {
                                    <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; background: #ecfdf5; color: #065f46; font-weight: 600;">Live</span>
                                }
                                else if (!b.IsActive)
                                {
                                    <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; background: #fef2f2; color: #991b1b; font-weight: 600;">Inactive</span>
                                }
                                else
                                {
                                    <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; background: #f3f4f6; color: #374151; font-weight: 600;">Draft</span>
                                }
                            </td>
                            <td style="padding: 0.75rem 1rem; text-align: right;">
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <a href="/Admin/Banners/Edit/@b.Id" class="dk-btn dk-btn-secondary dk-btn-sm">Edit</a>
                                    <form method="post" action="/Admin/Banners/Delete/@b.Id" style="display: inline;" onsubmit="return confirm('Remove this banner?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dk-btn dk-btn-danger dk-btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
