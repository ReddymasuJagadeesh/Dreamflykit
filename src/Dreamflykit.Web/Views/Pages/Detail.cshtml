@model Dreamflykit.Domain.Media.LandingPage
@{
    var heroImageUrl = ViewData["HeroImageUrl"] as string;
}

<div class="dk-landing-page" style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem;">
    @if (!string.IsNullOrEmpty(heroImageUrl))
    {
        <div style="border-radius: 16px; overflow: hidden; margin-bottom: 2.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.1); max-height: 450px; background: #000;">
            <img src="@heroImageUrl" alt="@Model.Title" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
    }

    <header style="margin-bottom: 2rem; text-align: center;">
        <h1 style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
            @Model.Title
        </h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p style="font-size: 1.125rem; color: var(--text-muted); max-width: 700px; margin: 0 auto;">
                @Model.Description
            </p>
        }
    </header>

    <div style="text-align: center; margin-top: 3rem;">
        <a href="/Products" class="dk-btn dk-btn-primary" style="padding: 0.875rem 2rem; font-size: 1.1rem; border-radius: 9999px;">
            Explore All Products
        </a>
    </div>
</div>
