@{
    ViewData["Title"] = "Check Your Email — Dreamflykit";
    Layout = "_Layout";
}

<div class="dk-auth-page-wrapper">
    <div class="dk-auth-card-container">
        <!-- Brand Panel (Left) -->
        <div class="dk-auth-brand-panel">
            <div class="dk-auth-brand-badge">
                <img src="~/images/branding/dreamflykit-logo.webp"
                     alt="Dreamflykit"
                     class="dk-auth-logo-img" />
            </div>
            <h2 class="dk-auth-tagline">
                Check Your<br />Inbox
            </h2>
            <p class="dk-auth-subtitle">
                Your journey matters to us. Security check in progress.
            </p>
        </div>

        <!-- Form Panel (Right) -->
        <div class="dk-auth-form-panel">
            <div class="dk-auth-form-inner text-center">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4 text-green-600 text-3xl">
                    ✓
                </div>
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Password Reset Sent</h1>
                <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                    If an account exists with that email address, we have dispatched an email with instructions to reset your password.
                </p>
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-left mb-6 text-xs text-gray-500 space-y-1">
                    <p>• Check your spam or promotions folder if it doesn't arrive within 2 minutes.</p>
                    <p>• The reset link is valid for 24 hours.</p>
                </div>
                <a asp-action="Login"
                   class="inline-block py-2.5 px-6 border border-gray-300 rounded-lg text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>

