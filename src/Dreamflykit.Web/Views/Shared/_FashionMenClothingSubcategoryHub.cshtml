@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.FashionHub ?? Dreamflykit.Application.FashionHub.Models.FashionHubDto.CreateDefault();
    var men = hub.MenClothing ?? Dreamflykit.Application.FashionHub.Models.FashionMenClothingDto.CreateDefault();
    var subPage = Model.MenClothingSubcategoryPage;
    var currentSlug = (Model.CurrentSubcategorySlug ?? "").Trim().ToLowerInvariant();

    if (subPage == null && men.SubcategoryPages != null && men.SubcategoryPages.Count > 0)
    {
        subPage = men.SubcategoryPages.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSlug, StringComparison.OrdinalIgnoreCase));
    }

    if (subPage == null)
    {
        var matchedCat = men.CategoriesSection?.Categories?.FirstOrDefault(c =>
            string.Equals(c.Slug, currentSlug, StringComparison.OrdinalIgnoreCase));

        var catName = matchedCat?.Name ?? (!string.IsNullOrWhiteSpace(Model.CurrentSubcategoryName)
            ? Model.CurrentSubcategoryName
            : (string.IsNullOrWhiteSpace(currentSlug) ? "Men Clothing" : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(currentSlug.Replace("-", " "))));

        var defaultPages = Dreamflykit.Application.FashionHub.Models.FashionMenClothingDto.CreateDefaultSubcategoryPages();
        subPage = defaultPages.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSlug, StringComparison.OrdinalIgnoreCase))
            ?? new Dreamflykit.Application.FashionHub.Models.FashionMenClothingSubcategoryPageDto
            {
                CategorySlug = currentSlug,
                CategoryName = catName,
                HeroBanner = new Dreamflykit.Application.FashionHub.Models.FashionMenClothingSubcategoryHeroDto
                {
                    Title = catName,
                    TitleHighlight = "STUDENT ESSENTIALS • 100% GENUINE",
                    Subtitle = $"Discover our premium curated collection of {catName} tailored with breathable, lightweight fabrics for international student life.",
                    IsUploadingSoon = true
                },
                Products = defaultPages.FirstOrDefault()?.Products ?? new List<Dreamflykit.Application.FashionHub.Models.FashionProductItemDto>()
            };
    }

    var hero = subPage.HeroBanner ?? new Dreamflykit.Application.FashionHub.Models.FashionMenClothingSubcategoryHeroDto();
    var shopByStyle = subPage.ShopByStyleSection ?? new Dreamflykit.Application.FashionHub.Models.FashionShopByStyleSectionDto();
    var styles = (shopByStyle.Styles != null && shopByStyle.Styles.Count > 0)
        ? shopByStyle.Styles.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToList()
        : new List<Dreamflykit.Application.FashionHub.Models.FashionStyleItemDto>();

    var products = (subPage.Products != null && subPage.Products.Count > 0)
        ? subPage.Products.Where(p => p.IsActive).ToList()
        : new List<Dreamflykit.Application.FashionHub.Models.FashionProductItemDto>();

    var allCategories = men.CategoriesSection?.Categories?.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToList()
        ?? new List<Dreamflykit.Application.FashionHub.Models.FashionCategoryItemDto>();

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    string GetSubcategoryIcon(string slug) => (slug ?? "").ToLowerInvariant() switch
    {
        "ethnic-wear" or "ethnic" => "🥻",
        "thermals" or "thermal" => "❄️",
        "t-shirts" or "tshirt" or "polos" => "👕",
        "shirts" or "shirt" => "👔",
        "jackets-coats" or "jackets" or "jacket" or "coats" => "🧥",
        "hoodies" or "hoodie" => "🧥",
        "sweatshirts" or "sweatshirt" => "🧶",
        "jeans" or "jean" => "👖",
        "trousers" or "trouser" => "👖",
        "pants" or "pant" => "👖",
        "innerwear" => "🩲",
        "sleepwear" => "🛋️",
        "shorts" or "short" => "🩳",
        "socks" or "sock" => "🧦",
        "caps" or "cap" => "🧢",
        "towels" or "towel" => "🧖",
        "belts" or "belt" => "🥋",
        _ => "👕"
    };
}

<div class="dk-men-subpage-container" id="menClothingSubpageRoot">

    <!-- Festival Announcement Ribbon (if enabled by admin) -->
    @if (men.FestivalTheme != null && men.FestivalTheme.IsEnabled && !string.IsNullOrWhiteSpace(men.FestivalTheme.AnnouncementText))
    {
        <div class="dk-sub-fest-ribbon" style="background: @(!string.IsNullOrWhiteSpace(men.FestivalTheme.BgGradient) ? men.FestivalTheme.BgGradient : "linear-gradient(135deg, #0284c7 0%, #0369a1 100%)");">
            <span class="dk-sub-fest-badge">@(!string.IsNullOrWhiteSpace(men.FestivalTheme.BadgeText) ? men.FestivalTheme.BadgeText : "CAMPUS SPECIAL")</span>
            <span class="dk-sub-fest-text">@men.FestivalTheme.AnnouncementText</span>
            @if (!string.IsNullOrWhiteSpace(men.FestivalTheme.BannerHighlight))
            {
                <span class="dk-sub-fest-highlight">@men.FestivalTheme.BannerHighlight</span>
            }
        </div>
    }

    <!-- ========================================================
         1. HERO BANNER (100% FULL WIDTH AS REQUESTED)
    ========================================================= -->
    <section class="dk-men-sub-hero-card" aria-label="@subPage.CategoryName Hero Banner">
        <div class="dk-men-sub-hero-glow"></div>
        <div class="dk-men-sub-hero-body dk-shell">
            <div class="dk-men-sub-hero-content">
                <nav class="dk-men-sub-breadcrumb" aria-label="Men clothing breadcrumb">
                    <a href="/category/fashion">Fashion</a>
                    <span class="dk-men-sub-sep">/</span>
                    <a href="/category/fashion/men-clothing">Men Clothing</a>
                    <span class="dk-men-sub-sep">/</span>
                    <span class="dk-men-sub-crumb-active">@subPage.CategoryName</span>
                </nav>

                <div class="dk-men-sub-hero-badge">
                    <span class="dk-badge-dot">●</span>
                    <span>@(!string.IsNullOrWhiteSpace(hero.TitleHighlight) ? hero.TitleHighlight : "STUDENT ESSENTIALS • 100% GENUINE")</span>
                </div>

                <h1 class="dk-men-sub-hero-title">@(!string.IsNullOrWhiteSpace(hero.Title) ? hero.Title : subPage.CategoryName)</h1>
                
                <p class="dk-men-sub-hero-desc">
                    @(string.IsNullOrWhiteSpace(hero.Subtitle)
                        ? $"Discover our premium curated collection of {subPage.CategoryName} designed with all-day breathability and durable fabrics for global university campus life."
                        : hero.Subtitle)
                </p>

                <!-- Student Reassurance Badges -->
                <div class="dk-men-sub-hero-features">
                    @if (hero.Badges != null && hero.Badges.Count > 0)
                    {
                        foreach (var b in hero.Badges)
                        {
                            <span class="dk-men-sub-feat-pill">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>@b</span>
                            </span>
                        }
                    }
                    else
                    {
                        <span class="dk-men-sub-feat-pill">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>100% Combed Cotton</span>
                        </span>
                        <span class="dk-men-sub-feat-pill">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Wrinkle-Resistant</span>
                        </span>
                        <span class="dk-men-sub-feat-pill">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Campus Budget Friendly</span>
                        </span>
                        <span class="dk-men-sub-feat-pill">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Loved by 10K+ Students</span>
                        </span>
                    }
                </div>

                <div class="dk-men-sub-hero-actions">
                    <button type="button" class="dk-men-sub-btn-primary" onclick="scrollToProducts()">
                        <span>Explore @subPage.CategoryName</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>
                    @if (canManage)
                    {
                        <a href="/Admin/FashionHub#tab-men-clothing" class="dk-sub-admin-link">⚙ Edit in Admin Dashboard</a>
                    }
                </div>
            </div>

            <div class="dk-men-sub-hero-media">
                @if (!string.IsNullOrWhiteSpace(hero.ImageUrl) && !hero.ImageUrl.Contains("placeholder") && !hero.IsUploadingSoon)
                {
                    <div class="dk-men-sub-banner-img-wrap">
                        <img src="@hero.ImageUrl" alt="@subPage.CategoryName" class="dk-men-sub-banner-img" />
                    </div>
                }
                else
                {
                    <div class="dk-men-sub-hero-uploading">
                        <div class="dk-men-sub-uploading-radar">
                            <span class="dk-men-sub-radar-ring"></span>
                            <span class="dk-men-sub-emoji">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                        </div>
                        <div class="dk-men-sub-uploading-pill">
                            <span class="dk-mini-dot">●</span> Uploading Soon
                        </div>
                        <p class="dk-men-sub-uploading-text">Admin will upload banner image</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         2. SHOP BY CATEGORY / STYLE (CASUAL, FORMAL, PARTY WEAR)
         REQUESTED: "and after hero banner shop by category like casual formal party wear"
    ========================================================= -->
    @if (styles != null && styles.Count > 0)
    {
        <section class="dk-men-style-section dk-shell" aria-label="Shop @subPage.CategoryName by Style and Category">
            <div class="dk-style-sec-header">
                <div>
                    <h2 class="dk-style-sec-title">
                        <span>Shop @subPage.CategoryName by </span><span class="dk-style-title-gradient">Category & Style</span>
                    </h2>
                    <p class="dk-style-sec-sub">Curated collections for everyday campus, formal meetings, party nights, and travel outings.</p>
                </div>
                <div class="dk-style-sec-badge">
                    <span>⚡ SELECT OCCASION</span>
                </div>
            </div>

            <div class="dk-style-cards-grid">
                @foreach (var st in styles)
                {
                    <div class="dk-style-card" onclick="filterByStyleCard('@st.Name')" title="Shop @st.Name">
                        <div class="dk-style-card-media">
                            @if (!string.IsNullOrWhiteSpace(st.ImageUrl) && !st.IsUploadingSoon && !st.ImageUrl.Contains("uploading-soon"))
                            {
                                <img src="@st.ImageUrl" alt="@st.Name" class="dk-style-card-img" loading="lazy" />
                            }
                            else
                            {
                                <div class="dk-style-uploading-box">
                                    <span class="dk-style-radar-pulse"></span>
                                    <span class="dk-style-emoji">@(!string.IsNullOrWhiteSpace(st.Emoji) ? st.Emoji : "👔")</span>
                                    <span class="dk-style-soon-tag">UPLOADING SOON</span>
                                </div>
                            }
                            <div class="dk-style-overlay-gradient"></div>
                        </div>
                        <div class="dk-style-card-content">
                            <h3 class="dk-style-card-name">@st.Name</h3>
                            <span class="dk-style-card-cta">
                                <span>Explore Style</span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </span>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- ========================================================
         3. MAIN TWO-COLUMN LAYOUT (LEFT FILTERS, RIGHT PRODUCTS)
    ========================================================= -->
    <div class="dk-men-sub-layout dk-shell">
        
        <!-- LEFT FILTER SIDEBAR -->
        <aside class="dk-men-sub-sidebar" id="dkMenSubSidebar" aria-label="Filters">
            <div class="dk-filter-card">
                <div class="dk-filter-header">
                    <h3 class="dk-filter-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filters
                    </h3>
                    <button type="button" class="dk-btn-clear-filters" id="btnMenClearAllFilters" onclick="resetMenFilters()">
                        Reset All
                    </button>
                </div>

                <!-- 1. Categories Quick Switcher (All 17 Men Clothing Subcategories) -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Men Clothing Categories (17)</h4>
                    <div class="dk-cat-quick-list">
                        @foreach (var cat in allCategories)
                        {
                            var isCurrent = string.Equals(cat.Slug, subPage.CategorySlug, StringComparison.OrdinalIgnoreCase);
                            <a href="/category/fashion/men-clothing/@cat.Slug" 
                               class="dk-cat-quick-item @(isCurrent ? "active" : "")" 
                               title="@cat.Name">
                                <span class="dk-cat-quick-emoji">@GetSubcategoryIcon(cat.Slug)</span>
                                <span class="dk-cat-quick-name">@cat.Name</span>
                                @if (isCurrent)
                                {
                                    <span class="dk-cat-current-dot">●</span>
                                }
                            </a>
                        }
                    </div>
                </div>

                <!-- 2. Style / Occasion Filter (Casual, Formal, Party Wear, etc.) -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Style / Occasion</h4>
                    <div class="dk-checkbox-list">
                        @foreach (var styleName in new[] { "Casual Wear", "Formal Wear", "Party Wear", "Streetwear", "Gym & Active", "Lounge & Sleep", "Travel & Winter", "Ethnic & Festive" })
                        {
                            <label class="dk-checkbox-label">
                                <input type="checkbox" class="dk-style-checkbox" value="@styleName" onchange="filterMenProducts()" />
                                <span class="dk-checkbox-text">@styleName</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 3. Fit Type Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Fit Type</h4>
                    <div class="dk-checkbox-list">
                        @foreach (var fit in new[] { "Slim Fit", "Regular Fit", "Relaxed Fit", "Oversized", "Tailored Fit" })
                        {
                            <label class="dk-checkbox-label">
                                <input type="checkbox" class="dk-fit-checkbox" value="@fit" onchange="filterMenProducts()" />
                                <span class="dk-checkbox-text">@fit</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 4. Size Filter (S, M, L, XL, XXL) -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Size</h4>
                    <div class="dk-sizes-chips-grid">
                        @foreach (var size in new[] { "S", "M", "L", "XL", "XXL", "3XL", "One Size", "Free Size" })
                        {
                            <label class="dk-size-chip-label">
                                <input type="checkbox" class="dk-size-checkbox" value="@size" onchange="filterMenProducts()" />
                                <span class="dk-size-chip-box">@size</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 5. Fabric & Material -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Fabric & Material</h4>
                    <div class="dk-checkbox-list">
                        @foreach (var mat in new[] { "100% Cotton", "Cotton Blend", "Linen", "Denim", "Fleece", "Merino Wool", "Microfiber", "Silk Blend" })
                        {
                            <label class="dk-checkbox-label">
                                <input type="checkbox" class="dk-fabric-checkbox" value="@mat" onchange="filterMenProducts()" />
                                <span class="dk-checkbox-text">@mat</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 6. Color Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Color</h4>
                    <div class="dk-colors-grid">
                        @foreach (var (cName, cHex) in new[] { 
                            ("Black", "#0f172a"), ("Navy", "#1e3a8a"), ("White", "#ffffff"), 
                            ("Grey", "#64748b"), ("Olive", "#4d7c0f"), ("Blue", "#2563eb"),
                            ("Charcoal", "#334155"), ("Maroon", "#881337"), ("Khaki", "#d97706"), ("Beige", "#f5d0a9") })
                        {
                            <label class="dk-color-swatch-item" title="@cName">
                                <input type="checkbox" class="dk-color-checkbox" value="@cName" onchange="filterMenProducts()" />
                                <span class="dk-color-circle" style="background-color: @cHex; @(cName == "White" ? "border: 1.5px solid #cbd5e1;" : "")"></span>
                                <span class="dk-color-name">@cName</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 7. Price Range Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Price Range</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="menPriceRange" value="all" checked onchange="filterMenProducts()" />
                            <span>All Prices</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menPriceRange" value="0-499" onchange="filterMenProducts()" />
                            <span>Under ₹499</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menPriceRange" value="500-999" onchange="filterMenProducts()" />
                            <span>₹500 - ₹999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menPriceRange" value="1000-1999" onchange="filterMenProducts()" />
                            <span>₹1,000 - ₹1,999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menPriceRange" value="2000-4999" onchange="filterMenProducts()" />
                            <span>₹2,000 - ₹4,999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menPriceRange" value="5000-99999" onchange="filterMenProducts()" />
                            <span>₹5,000 and Above</span>
                        </label>
                    </div>

                    <!-- Custom Price Input -->
                    <div class="dk-custom-price-row">
                        <input type="number" id="inpMenMinPrice" placeholder="Min ₹" class="dk-price-input" min="0" />
                        <span class="dk-price-sep">-</span>
                        <input type="number" id="inpMenMaxPrice" placeholder="Max ₹" class="dk-price-input" min="0" />
                        <button type="button" class="dk-btn-price-go" onclick="applyCustomMenPrice()">Go</button>
                    </div>
                </div>

                <!-- 8. Discount Percentage -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Discount</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="menDiscount" value="0" checked onchange="filterMenProducts()" />
                            <span>All Discounts</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menDiscount" value="10" onchange="filterMenProducts()" />
                            <span>10% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menDiscount" value="30" onchange="filterMenProducts()" />
                            <span>30% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menDiscount" value="50" onchange="filterMenProducts()" />
                            <span>50% and above</span>
                        </label>
                    </div>
                </div>

                <!-- 9. Customer Rating -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Customer Rating</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="menRating" value="0" checked onchange="filterMenProducts()" />
                            <span>All Ratings</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menRating" value="4" onchange="filterMenProducts()" />
                            <span>★ 4.0 & above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="menRating" value="3" onchange="filterMenProducts()" />
                            <span>★ 3.0 & above</span>
                        </label>
                    </div>
                </div>

                <!-- 10. Availability Toggle -->
                <div class="dk-filter-section dk-filter-section-last">
                    <label class="dk-switch-label">
                        <input type="checkbox" id="chkMenInStockOnly" checked onchange="filterMenProducts()" />
                        <span class="dk-switch-slider"></span>
                        <span class="dk-switch-text">In Stock Only</span>
                    </label>
                </div>
            </div>
        </aside>

        <!-- RIGHT PRODUCTS CATALOG -->
        <main class="dk-men-sub-main" id="menProductsMainSection">
            
            <!-- TOOLBAR -->
            <div class="dk-catalog-toolbar">
                <div class="dk-toolbar-left">
                    <h2 class="dk-toolbar-heading">@subPage.CategoryName Products</h2>
                    <span class="dk-toolbar-count" id="menProductCountText">Showing @products.Count products</span>
                </div>

                <div class="dk-toolbar-right">
                    <!-- Instant Live Search -->
                    <div class="dk-search-box">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="inpMenSearch" placeholder="Search in @subPage.CategoryName..." oninput="filterMenProducts()" />
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="dk-sort-box">
                        <label for="selMenSort">Sort by:</label>
                        <select id="selMenSort" onchange="sortMenProducts()">
                            <option value="relevance">Relevance</option>
                            <option value="price-asc">Price: Low to High</option>
                            <option value="price-desc">Price: High to Low</option>
                            <option value="rating">Customer Rating</option>
                            <option value="discount">Biggest Discount</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ACTIVE FILTER TAGS STRIP -->
            <div class="dk-active-pills-bar" id="menActivePillsBar" style="display: none;">
                <div class="dk-pills-label">Active Filters:</div>
                <div class="dk-pills-list" id="menActivePillsList"></div>
                <button type="button" class="dk-clear-pills-btn" onclick="resetMenFilters()">Clear All</button>
            </div>

            <!-- PRODUCTS GRID WITH BIG IMAGE FRAMES -->
            <div class="dk-men-products-grid" id="menProductsGrid">
                @foreach (var prod in products)
                {
                    var origPrice = prod.OriginalPrice ?? 0m;
                    var discountPct = (origPrice > prod.Price && origPrice > 0m)
                        ? (int)Math.Round(((origPrice - prod.Price) / origPrice) * 100)
                        : 0;

                    var hasRealImg = !string.IsNullOrWhiteSpace(prod.ImageUrl) && !prod.IsUploadingSoon && !prod.ImageUrl.Contains("uploading-soon");

                    <div class="dk-men-product-card" 
                         data-id="@prod.Id"
                         data-name="@prod.Name"
                         data-price="@prod.Price"
                         data-rating="@prod.Rating"
                         data-discount="@discountPct"
                         data-badge="@prod.Badge"
                         data-sizes="@string.Join(",", prod.Sizes ?? new List<string>())"
                         data-colors="@string.Join(",", prod.Colors ?? new List<string>())"
                         data-instock="@(prod.InStock ? "true" : "false")">
                        
                        <!-- BIG IMAGE FRAME (min-height 320px, 3/4 aspect) -->
                        <div class="dk-men-card-media">
                            @if (!string.IsNullOrWhiteSpace(prod.Badge))
                            {
                                <span class="dk-men-card-badge">@prod.Badge</span>
                            }

                            @if (discountPct > 0)
                            {
                                <span class="dk-men-card-discount">@discountPct% OFF</span>
                            }

                            <button type="button" class="dk-men-wishlist-btn" onclick="toggleMenWishlist(this, '@prod.Id')" title="Add to Wishlist" aria-label="Wishlist">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            </button>

                            @if (hasRealImg)
                            {
                                <img src="@prod.ImageUrl" alt="@prod.Name" class="dk-men-card-img" loading="lazy" />
                            }
                            else
                            {
                                <div class="dk-men-card-uploading-frame">
                                    <div class="dk-radar-pulse-ring"></div>
                                    <span class="dk-frame-emoji">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                                    <div class="dk-frame-badge">
                                        <span class="dk-pulse-dot">●</span>
                                        <span>UPLOADING SOON</span>
                                    </div>
                                    <span class="dk-frame-subtext">Admin will upload photo</span>
                                </div>
                            }
                        </div>

                        <!-- CARD BODY -->
                        <div class="dk-men-card-body">
                            <div class="dk-men-card-cat-tag">@subPage.CategoryName</div>
                            <h3 class="dk-men-card-title" title="@prod.Name">
                                <a href="@(!string.IsNullOrWhiteSpace(prod.ProductUrl) ? prod.ProductUrl : $"/category/fashion/men-clothing/{subPage.CategorySlug}")">
                                    @prod.Name
                                </a>
                            </h3>

                            <!-- Rating & Reviews -->
                            <div class="dk-men-card-rating">
                                <div class="dk-star-badge">
                                    <span>★ @prod.Rating.ToString("0.0")</span>
                                </div>
                                <span class="dk-reviews-text">(@prod.ReviewsCount reviews)</span>
                            </div>

                            <!-- Sizes pills -->
                            @if (prod.Sizes != null && prod.Sizes.Count > 0)
                            {
                                <div class="dk-card-sizes-row">
                                    <span class="dk-sizes-lbl">Sizes:</span>
                                    @foreach (var s in prod.Sizes.Take(4))
                                    {
                                        <span class="dk-mini-size-chip">@s</span>
                                    }
                                    @if (prod.Sizes.Count > 4)
                                    {
                                        <span class="dk-mini-size-chip more">+@(prod.Sizes.Count - 4)</span>
                                    }
                                </div>
                            }

                            <!-- Price and Cart Row -->
                            <div class="dk-men-card-footer">
                                <div class="dk-price-stack">
                                    <span class="dk-price-curr">₹@prod.Price.ToString("N0")</span>
                                    @if (prod.OriginalPrice > prod.Price && prod.OriginalPrice.HasValue)
                                    {
                                        <span class="dk-price-orig">₹@prod.OriginalPrice.Value.ToString("N0")</span>
                                    }
                                </div>

                                <button type="button" class="dk-men-btn-cart" onclick="addMenToCart(this, '@prod.Id', '@prod.Name', @prod.Price)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                                    <span>Add to Cart</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- EMPTY STATE -->
            <div class="dk-men-empty-state" id="menEmptyState" style="display: none;">
                <div class="dk-empty-icon">🔍</div>
                <h3 class="dk-empty-title">No matching products found</h3>
                <p class="dk-empty-desc">Try clearing selected filters, adjusting price range, or clearing search keywords.</p>
                <button type="button" class="dk-btn-reset-empty" onclick="resetMenFilters()">
                    Reset All Filters
                </button>
            </div>
        </main>
    </div>
</div>

