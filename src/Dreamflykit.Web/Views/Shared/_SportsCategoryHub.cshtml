@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.SportsHub ?? Dreamflykit.Application.SportsHub.Models.SportsHubDto.CreateDefault();
    var hero = hub.HeroBanner ?? new Dreamflykit.Application.SportsHub.Models.SportsHeroBannerDto();
    var shopCategory = hub.ShopByCategory ?? new Dreamflykit.Application.SportsHub.Models.SportsShopByCategorySectionDto();
    var topPicks = hub.TopPicks ?? new Dreamflykit.Application.SportsHub.Models.SportsTopPicksSectionDto();
    var trustBadges = hub.TrustBadges ?? new Dreamflykit.Application.SportsHub.Models.SportsTrustBadgesSectionDto();
    var bottomBanner = hub.BottomBanner ?? new Dreamflykit.Application.SportsHub.Models.SportsBottomBannerDto();
    var festivalTheme = hub.FestivalTheme ?? new Dreamflykit.Application.SportsHub.Models.SportsFestivalThemeDto();

    var slides = hero.Slides?.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToList() ?? new();
    if (slides.Count == 0)
    {
        slides = Dreamflykit.Application.SportsHub.Models.SportsHubDto.CreateDefault().HeroBanner.Slides;
    }

    var categoryItems = shopCategory.Items?.Where(i => i.IsActive).OrderBy(i => i.DisplayOrder).ToList() ?? new();
    if (categoryItems.Count == 0)
    {
        categoryItems = Dreamflykit.Application.SportsHub.Models.SportsHubDto.CreateDefaultCategoryItems();
    }

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="sp-hub-container">

    <!-- ========================================================
         FESTIVAL / CAMPAIGN BANNER RIBBON
    ========================================================= -->
    @if (festivalTheme.IsEnabled && !string.IsNullOrWhiteSpace(festivalTheme.AnnouncementText))
    {
        <div class="sp-campaign-ribbon" style="background: @(!string.IsNullOrWhiteSpace(festivalTheme.BgGradient) ? festivalTheme.BgGradient : "linear-gradient(135deg, #059669 0%, #0d9488 50%, #0284c7 100%)");">
            <div class="sp-ribbon-shell">
                <span class="sp-ribbon-badge">@festivalTheme.BadgeText</span>
                <span class="sp-ribbon-text">@festivalTheme.AnnouncementText</span>
                @if (!string.IsNullOrWhiteSpace(festivalTheme.BannerHighlight))
                {
                    <span class="sp-ribbon-highlight">@festivalTheme.BannerHighlight</span>
                }
                @if (canManage)
                {
                    <a href="/Admin/SportsHub" class="sp-ribbon-admin-btn" title="Edit in Admin">⚙ Admin Settings</a>
                }
            </div>
        </div>
    }

    <!-- ========================================================
         HERO BANNER: FULL WIDTH SLIDER
    ========================================================= -->
    @if (hero.IsEnabled && slides.Count > 0)
    {
        <section class="sp-hero-section" aria-label="Sports Hub Hero Banner">
            <div class="sp-hero-slider-wrap" id="spHeroSlider" data-autoplay="@(hero.AutoPlay.ToString().ToLower())" data-interval="@(hero.SlideIntervalSeconds * 1000)">
                <div class="sp-hero-slides">
                    @for (int i = 0; i < slides.Count; i++)
                    {
                        var slide = slides[i];
                        var hasImage = !string.IsNullOrWhiteSpace(slide.ImageUrl) && !slide.ImageUrl.Contains("placeholder") && !slide.IsUploadingSoon;
                        <div class="sp-hero-slide @(i == 0 ? "active" : "")" data-slide-index="@i">
                            <div class="sp-hero-content-shell">
                                <div class="sp-hero-text-col">
                                    @if (!string.IsNullOrWhiteSpace(slide.BadgeText))
                                    {
                                        <div class="sp-hero-badge">
                                            <span class="sp-badge-sparkle">🏆</span>
                                            <span>@slide.BadgeText</span>
                                        </div>
                                    }
                                    <h1 class="sp-hero-title">
                                        @slide.Title
                                        @if (!string.IsNullOrWhiteSpace(slide.TitleHighlight))
                                        {
                                            <span class="sp-title-gradient">@slide.TitleHighlight</span>
                                        }
                                    </h1>
                                    @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
                                    {
                                        <p class="sp-hero-desc">@slide.Subtitle</p>
                                    }

                                    <div class="sp-hero-actions">
                                        <a href="@(string.IsNullOrWhiteSpace(slide.TargetUrl) ? "/category/sports-hub/cricket" : slide.TargetUrl)" class="sp-hero-btn-primary">
                                            <span>@(!string.IsNullOrWhiteSpace(slide.ButtonText) ? slide.ButtonText : "Explore Gear")</span>
                                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                                        </a>
                                        <a href="/category/sports-hub/cricket" class="sp-hero-btn-secondary">
                                            <span>Shop All 12 Categories</span>
                                        </a>
                                    </div>

                                    <div class="sp-hero-guarantees">
                                        <div class="sp-guarantee-item">
                                            <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                            <span>100% Tournament Spec</span>
                                        </div>
                                        <div class="sp-guarantee-item">
                                            <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
                                            <span>Campus Fast Delivery</span>
                                        </div>
                                        <div class="sp-guarantee-item">
                                            <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                            <span>Free Size Exchange</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="sp-hero-media-col">
                                    @if (hasImage)
                                    {
                                        <div class="sp-hero-image-box">
                                            <img src="@slide.ImageUrl" alt="@slide.Title" class="sp-hero-img" loading="lazy" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="sp-hero-uploading-card">
                                            <div class="sp-radar-container">
                                                <div class="sp-radar-ping"></div>
                                                <div class="sp-radar-ring sp-ring-1"></div>
                                                <div class="sp-radar-ring sp-ring-2"></div>
                                                <div class="sp-radar-ring sp-ring-3"></div>
                                                <span class="sp-hero-icon-large">⚽</span>
                                            </div>
                                            <div class="sp-uploading-tag">
                                                <span class="sp-pulsing-dot">●</span>
                                                <span>UPLOADING SOON</span>
                                            </div>
                                            <p class="sp-uploading-sub">Images will be uploaded by admin</p>
                                            <span class="sp-hero-preview-badge">SPORTS HUB TOURNAMENT SPEC</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Slider Controls -->
                @if (slides.Count > 1)
                {
                    <button type="button" class="sp-slider-arrow sp-arrow-prev" aria-label="Previous slide" onclick="spPrevSlide()">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    <button type="button" class="sp-slider-arrow sp-arrow-next" aria-label="Next slide" onclick="spNextSlide()">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>

                    <div class="sp-slider-dots">
                        @for (int d = 0; d < slides.Count; d++)
                        {
                            <button type="button" class="sp-slider-dot @(d == 0 ? "active" : "")" data-dot-index="@d" onclick="spGoToSlide(@d)" aria-label="Go to slide @(d + 1)"></button>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <!-- ========================================================
         SHOP BY CATEGORY: 12 ATHLETIC CATEGORIES
    ========================================================= -->
    @if (shopCategory.IsEnabled && categoryItems.Count > 0)
    {
        <section class="sp-categories-section dk-shell" id="sp-shop-by-category">
            <div class="sp-section-header">
                <div class="sp-header-left">
                    <span class="sp-section-badge">VERIFIED TOURNAMENT & FITNESS KITS</span>
                    <h2 class="sp-section-title">@shopCategory.Title</h2>
                    <p class="sp-section-desc">@shopCategory.Subtitle</p>
                </div>
                <div class="sp-header-right">
                    <a href="/category/sports-hub/cricket" class="sp-category-count" style="text-decoration:none;" title="Explore All Categories & Subcategories">
                        @categoryItems.Count Categories Available →
                    </a>
                    @if (canManage)
                    {
                        <a href="/Admin/SportsHub" class="sp-admin-chip" title="Edit in Admin Dashboard">
                            ⚙ Manage Categories
                        </a>
                    }
                </div>
            </div>

            <div class="sp-categories-grid">
                @foreach (var item in categoryItems)
                {
                    var itemHasImage = !string.IsNullOrWhiteSpace(item.ImageUrl) && !item.ImageUrl.Contains("placeholder") && !item.IsUploadingSoon;
                    var itemUrl = $"/category/sports-hub/{item.Slug}";
                    <a href="@itemUrl" class="sp-cat-card" title="Browse @item.Name">
                        <div class="sp-cat-media">
                            @if (itemHasImage)
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" class="sp-cat-img" loading="lazy" />
                            }
                            else
                            {
                                <div class="sp-cat-uploading-box">
                                    <span class="sp-cat-emoji">@item.IconEmoji</span>
                                    <div class="sp-cat-uploading-tag">
                                        <span class="sp-mini-dot">●</span> Uploading Soon
                                    </div>
                                </div>
                            }
                            <span class="sp-cat-arrow-pill">
                                <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            </span>
                        </div>
                        <div class="sp-cat-info">
                            <h3 class="sp-cat-title">@item.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                            {
                                <p class="sp-cat-sub">@item.Subtitle</p>
                            }
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- ========================================================
         3-SECTION SYNCHRONIZED SLIDES (DIRECTLY BELOW CATEGORIES)
    ========================================================= -->
    <section class="sp-three-section-slider-wrap" aria-label="Sports Gear Multi-Section Carousel">
        <div class="sp-section-header dk-shell" style="margin-bottom: 12px;">
            <div class="sp-header-left">
                <span class="sp-section-badge">SYNCHRONIZED SHOWCASE</span>
                <h2 class="sp-section-title">Spotlight Match Gear & Training Rigs</h2>
                <p class="sp-section-desc">Curated tournament bats, match balls, rackets, and fitness essentials rotating simultaneously</p>
            </div>
            @if (canManage)
            {
                <a href="/Admin/CategorySliders?category=sports-hub" class="sp-admin-chip" title="Manage Slider in Admin">
                    ⚙ Manage 3-Section Slider
                </a>
            }
        </div>
        <partial name="_CategoryThreeSectionSlider" model='"sports-hub"' />
    </section>

    <!-- ========================================================
         TOP PICKS & TOURNAMENT DEALS
    ========================================================= -->
    @if (topPicks.IsEnabled && topPicks.Products?.Count > 0)
    {
        <section class="sp-top-picks-section dk-shell">
            <div class="sp-section-header">
                <div class="sp-header-left">
                    <span class="sp-section-badge">BESTSELLERS OF THE SEASON</span>
                    <h2 class="sp-section-title">@topPicks.Title</h2>
                    <p class="sp-section-desc">@topPicks.Subtitle</p>
                </div>
                <div class="sp-header-right">
                    <span class="sp-top-count">@topPicks.Products.Count Top Rated Gear</span>
                </div>
            </div>

            <div class="sp-products-grid">
                @foreach (var prod in topPicks.Products)
                {
                    var prodHasImg = !string.IsNullOrWhiteSpace(prod.ImageUrl) && !prod.ImageUrl.Contains("placeholder") && !prod.IsUploadingSoon;
                    var origPrice = prod.OriginalPrice ?? prod.Price;
                    var discountPct = origPrice > prod.Price
                        ? (int)Math.Round(((origPrice - prod.Price) / origPrice) * 100)
                        : 0;

                    <div class="sp-prod-card" data-product-id="@prod.Id">
                        <div class="sp-prod-media">
                            @if (!string.IsNullOrWhiteSpace(prod.Badge))
                            {
                                <span class="sp-prod-badge">@prod.Badge</span>
                            }
                            @if (prodHasImg)
                            {
                                <img src="@prod.ImageUrl" alt="@prod.Name" class="sp-prod-img" loading="lazy" />
                            }
                            else
                            {
                                <div class="sp-prod-uploading-frame">
                                    <div class="sp-radar-mini">
                                        <div class="sp-radar-ping"></div>
                                        <span class="sp-prod-emoji">🏅</span>
                                    </div>
                                    <span class="sp-prod-uploading-text">Uploading Soon</span>
                                    <span class="sp-prod-uploading-sub">Admin will upload image</span>
                                </div>
                            }
                            @if (discountPct > 0)
                            {
                                <span class="sp-discount-pill">-@discountPct%</span>
                            }
                        </div>

                        <div class="sp-prod-details">
                            <span class="sp-prod-cat-tag">@prod.CategoryName</span>
                            <h3 class="sp-prod-name">@prod.Name</h3>

                            <div class="sp-prod-rating">
                                <div class="sp-stars">★★★★★</div>
                                <span class="sp-rating-num">@prod.Rating.ToString("0.0")</span>
                                <span class="sp-rating-count">(@prod.ReviewsCount)</span>
                            </div>

                            <div class="sp-prod-pricing">
                                <span class="sp-price-current">₹@prod.Price.ToString("N0")</span>
                                @if (origPrice > prod.Price)
                                {
                                    <span class="sp-price-orig">₹@origPrice.ToString("N0")</span>
                                }
                            </div>

                            @if (prod.Sizes != null && prod.Sizes.Count > 0)
                            {
                                <div class="sp-size-pills">
                                    @foreach (var size in prod.Sizes.Take(3))
                                    {
                                        <span class="sp-size-chip">@size</span>
                                    }
                                    @if (prod.Sizes.Count > 3)
                                    {
                                        <span class="sp-size-more">+@(prod.Sizes.Count - 3)</span>
                                    }
                                </div>
                            }

                            <div class="sp-prod-actions">
                                <button type="button" class="sp-btn-add-cart" onclick="spAddToCart('@prod.Id', '@prod.Name', @prod.Price, this)">
                                    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.24-1.2A1 1 0 005.06 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg>
                                    <span>Add to Cart</span>
                                </button>
                                <a href="/category/sports-hub/@prod.CategorySlug" class="sp-btn-view-cat" title="View in @prod.CategoryName">
                                    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- ========================================================
         TRUST BADGES
    ========================================================= -->
    @if (trustBadges.IsEnabled && trustBadges.Badges?.Count > 0)
    {
        <section class="sp-trust-section dk-shell">
            <div class="sp-trust-grid">
                @foreach (var badge in trustBadges.Badges)
                {
                    <div class="sp-trust-card">
                        <span class="sp-trust-emoji">@badge.IconEmoji</span>
                        <div class="sp-trust-info">
                            <h4 class="sp-trust-title">@badge.Title</h4>
                            <p class="sp-trust-desc">@badge.Description</p>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- ========================================================
         BOTTOM BANNER
    ========================================================= -->
    @if (bottomBanner.IsEnabled && !string.IsNullOrWhiteSpace(bottomBanner.Title))
    {
        <section class="sp-bottom-banner dk-shell">
            <div class="sp-bottom-shell">
                <div class="sp-bottom-text">
                    <span class="sp-bottom-tag">CAMPUS SPORTS PASS</span>
                    <h2 class="sp-bottom-title">@bottomBanner.Title</h2>
                    <p class="sp-bottom-desc">@bottomBanner.Subtitle</p>
                </div>
                <div class="sp-bottom-cta">
                    <a href="@(string.IsNullOrWhiteSpace(bottomBanner.TargetUrl) ? "/category/sports-hub/cricket" : bottomBanner.TargetUrl)" class="sp-bottom-btn">
                        <span>@(!string.IsNullOrWhiteSpace(bottomBanner.ButtonText) ? bottomBanner.ButtonText : "Claim Student Kit Offer")</span>
                        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                    </a>
                </div>
            </div>
        </section>
    }

</div>

<!-- ========================================================
     CSS STYLING FOR SPORTS HUB CATEGORY VIEW
========================================================= -->
<style>
    .sp-hub-container {
        width: 100%;
        background: #f8fafc;
        padding-bottom: 50px;
        color: #0f172a;
        font-family: inherit;
    }

    /* Campaign Ribbon */
    .sp-campaign-ribbon {
        width: 100%;
        padding: 10px 16px;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    .sp-ribbon-shell {
        max-width: 1320px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        font-size: 13.5px;
    }
    .sp-ribbon-badge {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(4px);
        padding: 2px 10px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .sp-ribbon-text {
        font-weight: 500;
    }
    .sp-ribbon-highlight {
        background: #fef08a;
        color: #854d0e;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 12px;
    }
    .sp-ribbon-admin-btn {
        background: rgba(0, 0, 0, 0.2);
        color: #fff;
        padding: 2px 10px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        margin-left: 8px;
    }
    .sp-ribbon-admin-btn:hover {
        background: rgba(0, 0, 0, 0.4);
    }

    /* Hero Slider */
    .sp-hero-section {
        width: 100%;
        position: relative;
        overflow: hidden;
        background: #0f172a;
    }
    .sp-hero-slider-wrap {
        position: relative;
        width: 100%;
        min-height: 440px;
    }
    .sp-hero-slides {
        position: relative;
        width: 100%;
        min-height: 440px;
    }
    .sp-hero-slide {
        display: none;
        width: 100%;
        min-height: 440px;
        background: linear-gradient(135deg, #064e3b 0%, #065f46 40%, #047857 70%, #0f172a 100%);
        color: #ffffff;
        opacity: 0;
        transition: opacity 0.6s ease-in-out;
    }
    .sp-hero-slide.active {
        display: block;
        opacity: 1;
    }
    .sp-hero-content-shell {
        max-width: 1320px;
        margin: 0 auto;
        padding: 48px 24px;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 36px;
        align-items: center;
        min-height: 440px;
    }

    .sp-hero-text-col {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .sp-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(16, 185, 129, 0.2);
        border: 1px solid rgba(52, 211, 153, 0.4);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.8px;
        color: #6ee7b7;
        width: fit-content;
    }
    .sp-hero-title {
        font-size: 38px;
        line-height: 1.2;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
    }
    .sp-title-gradient {
        background: linear-gradient(135deg, #34d399 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: block;
    }
    .sp-hero-desc {
        font-size: 15px;
        line-height: 1.6;
        color: #cbd5e1;
        margin: 0;
        max-width: 580px;
    }

    .sp-hero-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 8px;
        flex-wrap: wrap;
    }
    .sp-hero-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #10b981;
        color: #ffffff;
        font-weight: 700;
        font-size: 14px;
        padding: 12px 24px;
        border-radius: 10px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);
        transition: all 0.2s ease;
    }
    .sp-hero-btn-primary:hover {
        background: #059669;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }
    .sp-hero-btn-secondary {
