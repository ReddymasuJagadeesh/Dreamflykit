@model Dreamflykit.Web.Models.Kits.FindMyKitResultsViewModel

@{
    ViewData["Title"] = "Your Kit Recommendations";
}

<div class="mx-auto max-w-7xl px-4 py-12">

    <div class="mb-10">
        <p class="text-sm font-semibold uppercase tracking-wide">
            Dreamflykit
        </p>

        <h1 class="mt-2 text-3xl font-bold">
            Your Kit Recommendations
        </h1>

        <p class="mt-3">
            Hi @Model.Name, these kits match your destination
            and arrival season.
        </p>

        <div class="mt-4 text-sm">
            <span>
                Destination:
                <strong>@Model.CountryName</strong>
            </span>

            <span class="mx-2">•</span>

            <span>
                Season:
                <strong>@Model.SeasonName</strong>
            </span>
        </div>
    </div>

    @if (Model.Kits.Count == 0)
    {
        <div class="rounded-xl border p-8">
            <h2 class="text-xl font-semibold">
                No kits are currently available
            </h2>

            <p class="mt-2">
                We could not find active kits for this destination
                and season.
            </p>

            <a asp-action="FindMyKit"
               class="mt-6 inline-block rounded-lg px-5 py-3 font-semibold">
                Try Again
            </a>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-3">

            @foreach (var kit in Model.Kits)
            {
                <article class="rounded-2xl border p-6">

                    @if (kit.IsFeatured)
                    {
                        <div class="mb-3 text-sm font-semibold">
                            Featured
                        </div>
                    }

                    <h2 class="text-xl font-bold">
                        @kit.Name
                    </h2>

                    <p class="mt-2 text-sm font-medium">
                        @kit.SizeName Kit
                    </p>

                    <p class="mt-4 text-sm">
                        @kit.Description
                    </p>

                    <div class="mt-6">
                        <span class="text-sm line-through">
                            ₹@kit.Mrp.ToString("N2")
                        </span>

                        <span class="ml-2 text-xl font-bold">
                            ₹@kit.SellingPrice.ToString("N2")
                        </span>
                    </div>

                    @if (kit.DiscountPercentage > 0)
                    {
                        <p class="mt-2 text-sm font-semibold">
                            @kit.DiscountPercentage% off
                        </p>
                    }

                    <a href="/kits/@kit.Slug"
                       class="mt-6 block rounded-lg border px-5 py-3 text-center font-semibold">
                        View Kit
                    </a>

                </article>
            }

        </div>
    }
</div>