@model Dreamflykit.Web.Areas.Admin.Models.AdminProductEditViewModel

@{
    ViewData["Title"] = $"Edit Product: {Model.Name}";
    var categories = ViewBag.Categories as List<Dreamflykit.Domain.Catalog.Category> ?? new();
    var subcategories = ViewBag.Subcategories as List<Dreamflykit.Domain.Catalog.Subcategory> ?? new();
}

<div class="dk-admin-card" style="max-width: 900px; margin: 0 auto 40px;">
    <div class="dk-admin-card-header" style="border-bottom: 1px solid #f1f5f9; padding-bottom: 16px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <h3 class="dk-admin-card-title" style="margin: 0; font-size: 20px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                <span>✏️ Edit Product: @Model.Name</span>
            </h3>
            <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">
                Update product information, SKU, pricing, category taxonomy, and primary image.
            </p>
        </div>

        <div style="display: flex; gap: 8px;">
            <a href="/Admin/Products/Media/@Model.Id" class="dk-btn dk-btn-secondary" style="font-size: 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                Manage Gallery Images (S3) →
            </a>
            <a href="/Admin/Products" class="dk-btn dk-btn-outline" style="font-size: 12px; text-decoration: none;">
                ← Products
            </a>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editProductForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="VariantId" />

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div style="margin-bottom: 24px; padding: 14px 18px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #b91c1c; font-size: 13px;">
                <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
            </div>
        }

        <!-- 1. General Information -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 24px;">
            <h4 style="margin: 0 0 16px; font-size: 15px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 6px;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #075bc8;"></span>
                1. Product Information
            </h4>

            <div style="margin-bottom: 16px;">
                <label asp-for="Name" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">Product Title *</label>
                <input asp-for="Name" id="productName" class="dk-input" style="width: 100%;" required />
                <span asp-validation-for="Name" style="color: #dc2626; font-size: 12px;"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="Slug" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">SEO Slug (URL path) *</label>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="color: #64748b; font-size: 13px; background: #f1f5f9; padding: 8px 12px; border-radius: 6px; border: 1px solid #e2e8f0;">/Products/</span>
                    <input asp-for="Slug" id="productSlug" class="dk-input" style="flex: 1;" required />
                </div>
                <span asp-validation-for="Slug" style="color: #dc2626; font-size: 12px;"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="ShortDescription" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">Short Highlight Summary *</label>
                <input asp-for="ShortDescription" class="dk-input" style="width: 100%;" required />
                <span asp-validation-for="ShortDescription" style="color: #dc2626; font-size: 12px;"></span>
            </div>

            <div>
                <label asp-for="Description" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">Full Product Description *</label>
                <textarea asp-for="Description" class="dk-input" rows="5" style="width: 100%; resize: vertical;" required></textarea>
                <span asp-validation-for="Description" style="color: #dc2626; font-size: 12px;"></span>
            </div>
        </div>

        <!-- 2. Categorization & Hierarchy -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 24px;">
            <h4 style="margin: 0 0 16px; font-size: 15px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 6px;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #059669;"></span>
                2. Category & Taxonomy
            </h4>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label asp-for="CategoryId" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">Primary Category *</label>
                    <select asp-for="CategoryId" id="categorySelect" class="dk-input" style="width: 100%;" required>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" style="color: #dc2626; font-size: 12px;"></span>
                </div>

                <div>
                    <label asp-for="SubcategoryId" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">Subcategory (Optional)</label>
                    <select asp-for="SubcategoryId" id="subcategorySelect" class="dk-input" style="width: 100%;">
                        <option value="">-- None --</option>
                        @foreach (var sub in subcategories)
                        {
                            <option value="@sub.Id" selected="@(sub.Id == Model.SubcategoryId)">@sub.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- 3. Pricing & SKU -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 24px;">
            <h4 style="margin: 0 0 16px; font-size: 15px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 6px;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #d97706;"></span>
                3. Pricing & Inventory (Flipkart-Style)
            </h4>

            <div style="display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 16px; align-items: flex-start;">
                <div>
                    <label asp-for="Sku" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">SKU Code *</label>
                    <input asp-for="Sku" id="productSku" class="dk-input" style="width: 100%; font-family: monospace; font-weight: 600;" required />
                    <span asp-validation-for="Sku" style="color: #dc2626; font-size: 12px;"></span>
                </div>

                <div>
                    <label asp-for="Mrp" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">MRP (₹) *</label>
                    <input asp-for="Mrp" id="mrpInput" type="number" step="1" min="1" class="dk-input" style="width: 100%; font-weight: 700;" required />
                    <span asp-validation-for="Mrp" style="color: #dc2626; font-size: 12px;"></span>
                </div>

                <div>
                    <label asp-for="SellingPrice" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">Selling Price (₹) *</label>
                    <input asp-for="SellingPrice" id="sellingPriceInput" type="number" step="1" min="1" class="dk-input" style="width: 100%; font-weight: 700; color: #059669;" required />
                    <span asp-validation-for="SellingPrice" style="color: #dc2626; font-size: 12px;"></span>
                </div>

                <div>
                    <label style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">Customer Discount</label>
                    <div id="discountBadge" style="display: inline-block; padding: 8px 12px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; color: #065f46; font-weight: 800; font-size: 13px; text-align: center; width: 100%;">
                        0% OFF
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Media & Primary Product Image -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 24px;">
            <h4 style="margin: 0 0 16px; font-size: 15px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 6px;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #db2777;"></span>
                4. Primary Product Image (S3 + CloudFront CDN)
            </h4>

            <input type="hidden" asp-for="PrimaryMediaAssetId" id="mediaAssetId" />

            <div style="display: flex; align-items: center; gap: 20px; background: #f8fafc; padding: 16px; border-radius: 10px; border: 1px dashed #cbd5e1;">
                <div id="imagePreviewContainer" style="width: 90px; height: 90px; border-radius: 8px; border: 1px solid #cbd5e1; background: #ffffff; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
                    <img id="imagePreview" src="@(Model.PrimaryImagePreviewUrl ?? "")" alt="Selected Preview" style="@(string.IsNullOrWhiteSpace(Model.PrimaryImagePreviewUrl) ? "display: none;" : "display: block;") width: 100%; height: 100%; object-fit: cover;" />
                    <span id="noImagePrompt" style="@(string.IsNullOrWhiteSpace(Model.PrimaryImagePreviewUrl) ? "display: block;" : "display: none;") color: #94a3b8; font-size: 11px; text-align: center; padding: 4px;">No image selected</span>
                </div>

                <div>
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <button type="button" class="dk-btn dk-btn-secondary" onclick="openMediaPicker()" style="padding: 7px 16px; font-size: 12px; font-weight: 700;">
                            📁 Change Primary Image
                        </button>
                        <button type="button" class="dk-btn dk-btn-outline" onclick="clearSelectedMedia()" style="padding: 7px 14px; font-size: 12px;">
                            Clear Image
                        </button>
                        <a href="/Admin/Products/Media/@Model.Id" class="dk-btn dk-btn-primary" style="padding: 7px 16px; font-size: 12px; font-weight: 700; text-decoration: none; margin-left: 8px;">
                            📸 Manage Full S3 Gallery (@Model.Name) →
                        </a>
                    </div>
                    <small style="display: block; margin-top: 8px; color: #64748b; font-size: 12px;">
                        Manage multiple gallery images, angles, and zoom views in the dedicated Gallery manager.
                    </small>
                </div>
            </div>
        </div>

        <!-- 5. Status & Visibility -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 24px;">
            <h4 style="margin: 0 0 16px; font-size: 15px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 6px;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #8b5cf6;"></span>
                5. Visibility & Badges
            </h4>

            <div style="display: flex; gap: 32px; align-items: center; flex-wrap: wrap;">
                <div>
                    <label asp-for="DisplayOrder" style="display: block; font-weight: 700; font-size: 13px; color: #334155; margin-bottom: 6px;">Catalog Display Order</label>
                    <input asp-for="DisplayOrder" type="number" class="dk-input" style="width: 140px;" min="0" />
                </div>

                <div style="margin-top: 20px;">
                    <label style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: #334155; cursor: pointer;">
                        <input asp-for="IsActive" type="checkbox" style="width: 18px; height: 18px;" />
                        <span>Active (Available for purchase)</span>
                    </label>
                </div>

                <div style="margin-top: 20px;">
                    <label style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: #b45309; cursor: pointer;">
                        <input asp-for="IsFeatured" type="checkbox" style="width: 18px; height: 18px;" />
                        <span>★ Feature on Homepage & Top Kits</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Submit buttons -->
        <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e2e8f0; padding-top: 20px;">
            <a href="/Admin/Products" class="dk-btn dk-btn-outline" style="text-decoration: none; padding: 10px 20px;">Cancel</a>
            <button type="submit" class="dk-btn dk-btn-primary" style="padding: 10px 28px; font-size: 14px; font-weight: 700;">
                Save Changes
            </button>
        </div>
    </form>
</div>

<!-- Modal Picker Dialog -->
<div id="mediaPickerModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.65); z-index: 9999; align-items: center; justify-content: center;">
    <div style="width: 90%; max-width: 1050px; height: 85%; background: #ffffff; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="padding: 1rem 1.5rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; background: #f8fafc;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #0f172a;">Select Primary Product Image (S3)</h3>
            <button type="button" class="dk-btn dk-btn-secondary" style="padding: 4px 10px; font-size: 12px;" onclick="closeMediaPicker()">✕ Close</button>
        </div>
        <iframe id="pickerIframe" src="" style="flex: 1; border: none; width: 100%; height: 100%;"></iframe>
    </div>
</div>

<script>
    // Discount calculator
    function updateDiscount() {
        const mrp = parseFloat(document.getElementById('mrpInput').value) || 0;
        const sp = parseFloat(document.getElementById('sellingPriceInput').value) || 0;
        const badge = document.getElementById('discountBadge');

        if (mrp > 0 && sp > 0 && mrp >= sp) {
            const savings = mrp - sp;
            const pct = Math.round((savings / mrp) * 100);
            badge.textContent = `${pct}% OFF (Save ₹${savings})`;
            badge.style.color = '#065f46';
            badge.style.background = '#ecfdf5';
            badge.style.borderColor = '#a7f3d0';
        } else if (sp > mrp && mrp > 0) {
            badge.textContent = 'Selling price > MRP!';
            badge.style.color = '#b91c1c';
            badge.style.background = '#fef2f2';
            badge.style.borderColor = '#fecaca';
        } else {
            badge.textContent = '0% OFF';
        }
    }

    document.getElementById('mrpInput').addEventListener('input', updateDiscount);
    document.getElementById('sellingPriceInput').addEventListener('input', updateDiscount);
    updateDiscount();

    // Dynamic Cascading Subcategory Dropdown via AJAX
    document.getElementById('categorySelect').addEventListener('change', function () {
        const categoryId = this.value;
        const subSelect = document.getElementById('subcategorySelect');
        subSelect.innerHTML = '<option value="">-- Loading subcategories... --</option>';

        if (!categoryId) {
            subSelect.innerHTML = '<option value="">-- Select Subcategory --</option>';
            return;
        }

        fetch(`/Admin/Categories/GetSubcategories?categoryId=${categoryId}`)
            .then(res => res.json())
            .then(data => {
                subSelect.innerHTML = '<option value="">-- Select Subcategory (Optional) --</option>';
                data.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.id;
                    opt.textContent = item.name;
                    subSelect.appendChild(opt);
                });
            })
            .catch(err => {
                subSelect.innerHTML = '<option value="">-- Select Subcategory --</option>';
            });
    });

    // Media Picker Integration
    function openMediaPicker() {
        document.getElementById('pickerIframe').src = '/Admin/Media?picker=true';
        document.getElementById('mediaPickerModal').style.display = 'flex';
    }

    function closeMediaPicker() {
        document.getElementById('mediaPickerModal').style.display = 'none';
    }

    function clearSelectedMedia() {
        document.getElementById('mediaAssetId').value = '';
        const preview = document.getElementById('imagePreview');
        preview.src = '';
        preview.style.display = 'none';
        document.getElementById('noImagePrompt').style.display = 'block';
    }

    window.addEventListener('message', function (e) {
        if (e.data && e.data.type === 'MEDIA_SELECTED') {
            document.getElementById('mediaAssetId').value = e.data.id;
            const preview = document.getElementById('imagePreview');
            preview.src = e.data.thumb || e.data.full;
            preview.style.display = 'block';
            document.getElementById('noImagePrompt').style.display = 'none';
            closeMediaPicker();
        }
    });
</script>
