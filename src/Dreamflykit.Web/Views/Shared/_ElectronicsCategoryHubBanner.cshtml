@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var bannerImg = "/images/hero/hero-electronics.webp";
    var totalProducts = Model.TotalCount;
}

<div class="dk-electronics-hub-root" id="dk-electronics-hub">

    <!-- ========================================================
         1. HERO BANNER: DYNAMIC FULL-WIDTH TECH SLIDER
    ========================================================= -->
    <section class="dk-elec-hero-section" id="dkElecHeroSlider" aria-label="Featured Electronics Showcase">
        
        <!-- Panoramic Background Layer (Full Brightness) -->
        <div class="dk-elec-hero-bg-container">
            <img src="@bannerImg" alt="Electronics for Global Students" class="dk-elec-hero-bg-img" />
            <div class="dk-elec-hero-gradient-overlay" aria-hidden="true"></div>
            <div class="dk-elec-hero-circuit-glow" aria-hidden="true"></div>
        </div>

        <!-- Slider Slides Track -->
        <div class="dk-elec-slides-track" id="elecSlidesTrack">

            <!-- SLIDE 1: LAPTOPS & COMPUTING -->
            <div class="dk-elec-slide active" data-slide-index="0" role="tabpanel" aria-label="Student Laptops">
                <div class="dk-elec-slide-content">
                    <div class="dk-elec-slide-badge">
                        <span class="dk-elec-badge-pulse"></span>
                        <span class="dk-elec-badge-icon">⚡</span>
                        <span>TOP STUDENT ELECTRONICS &bull; UP TO 40% OFF</span>
                    </div>

                    <h1 class="dk-elec-slide-title">
                        Next-Gen Laptops &amp; Computing Power
                        <span class="dk-elec-slide-highlight">Engineered for Global Campuses &amp; Coding</span>
                    </h1>

                    <p class="dk-elec-slide-desc">
                        Certified Apple MacBooks, Dell XPS, ThinkPads, and student setups configured with universal 110V-240V power and international manufacturer warranty.
                    </p>

                    <div class="dk-elec-perks-row">
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Worldwide 110V–240V Support
                        </span>
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Instant Student Verification
                        </span>
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Express Dispatch
                        </span>
                    </div>

                    <div class="dk-elec-actions-row">
                        <a href="/category/electronics?q=laptop" class="dk-elec-btn-primary">
                            <span>Shop Laptops</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                        <a href="#dk-electronics-items-anchor" class="dk-elec-btn-secondary">
                            <span>View All @totalProducts Products</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- SLIDE 2: NOISE-CANCELLING AUDIO -->
            <div class="dk-elec-slide" data-slide-index="1" role="tabpanel" aria-label="Noise Cancelling Audio" aria-hidden="true">
                <div class="dk-elec-slide-content">
                    <div class="dk-elec-slide-badge color-cyan">
                        <span class="dk-elec-badge-pulse"></span>
                        <span class="dk-elec-badge-icon">🎧</span>
                        <span>ACTIVE NOISE CANCELLATION &bull; DEEP STUDY FOCUS</span>
                    </div>

                    <h2 class="dk-elec-slide-title">
                        Distraction-Free Audio Anywhere
                        <span class="dk-elec-slide-highlight">Library Silence &amp; Long-Haul Flight Comfort</span>
                    </h2>

                    <p class="dk-elec-slide-desc">
                        Immerse yourself in undisturbed study sessions or quiet long-haul flights with industry-leading ANC headphones from Sony, Bose, Boat, and Apple.
                    </p>

                    <div class="dk-elec-perks-row">
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            30h+ Extended Battery
                        </span>
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Multi-Device Bluetooth Sync
                        </span>
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Hi-Res Audio Certified
                        </span>
                    </div>

                    <div class="dk-elec-actions-row">
                        <a href="/category/electronics?q=headphone" class="dk-elec-btn-primary">
                            <span>Shop Headphones</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                        <a href="#dk-electronics-items-anchor" class="dk-elec-btn-secondary">
                            <span>Explore Audio Gear</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- SLIDE 3: UNIVERSAL ADAPTERS & FAST CHARGERS -->
            <div class="dk-elec-slide" data-slide-index="2" role="tabpanel" aria-label="Universal Adapters" aria-hidden="true">
                <div class="dk-elec-slide-content">
                    <div class="dk-elec-slide-badge color-amber">
                        <span class="dk-elec-badge-pulse"></span>
                        <span class="dk-elec-badge-icon">🔌</span>
                        <span>GLOBAL POWER SAFETY &bull; 150+ COUNTRIES</span>
                    </div>

                    <h2 class="dk-elec-slide-title">
                        Universal Travel Adapters &amp; GaN Power
                        <span class="dk-elec-slide-highlight">Plug In Safely Across US, UK, EU &amp; Australia</span>
                    </h2>

                    <p class="dk-elec-slide-desc">
                        Compact, surge-protected international travel plugs and 65W/100W GaN fast chargers capable of powering laptops, phones, and tablets simultaneously.
                    </p>

                    <div class="dk-elec-perks-row">
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Universal All-in-One Pins
                        </span>
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Multiport USB-C PD Fast Charge
                        </span>
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Surge &amp; Auto-Reset Fuse
                        </span>
                    </div>

                    <div class="dk-elec-actions-row">
                        <a href="/category/electronics?q=adapter" class="dk-elec-btn-primary">
                            <span>Shop Adapters</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                        <a href="/category/electronics?q=charger" class="dk-elec-btn-secondary">
                            <span>Fast Chargers</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- SLIDE 4: INTERNATIONAL STUDENT SIMS & ESIM -->
            <div class="dk-elec-slide" data-slide-index="3" role="tabpanel" aria-label="International Student SIMs" aria-hidden="true">
                <div class="dk-elec-slide-content">
                    <div class="dk-elec-slide-badge color-emerald">
                        <span class="dk-elec-badge-pulse"></span>
                        <span class="dk-elec-badge-icon">📶</span>
                        <span>ZERO ROAMING EXPENSES &bull; INSTANT CONNECTIVITY</span>
                    </div>

                    <h2 class="dk-elec-slide-title">
                        International Student SIMs &amp; eSIMs
                        <span class="dk-elec-slide-highlight">Connected the Moment You Touch Down</span>
                    </h2>

                    <p class="dk-elec-slide-desc">
                        Pre-activated physical SIM cards and instant eSIM packages for USA, UK, Canada, and Europe with high-speed 5G data and free local calling.
                    </p>

                    <div class="dk-elec-perks-row">
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Pre-Activated Before Departure
                        </span>
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Unlimited Talk &amp; 5G Data
                        </span>
                        <span class="dk-elec-perk">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            24/7 Global Support
                        </span>
                    </div>

                    <div class="dk-elec-actions-row">
                        <a href="/category/electronics?q=sim" class="dk-elec-btn-primary">
                            <span>Explore SIM Cards</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                        <a href="#dk-electronics-items-anchor" class="dk-elec-btn-secondary">
                            <span>View All Electronics</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Slider Controls: Previous / Next Arrows -->
        <button type="button" class="dk-elec-nav-btn prev" id="btnElecPrev" aria-label="Previous Slide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="dk-elec-nav-btn next" id="btnElecNext" aria-label="Next Slide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        <!-- Slide Indicators (Dots) -->
        <div class="dk-elec-dots-wrap" id="elecDotsWrap" role="tablist" aria-label="Slide Selection">
            <button type="button" class="dk-elec-dot active" data-goto="0" role="tab" aria-selected="true" aria-label="Slide 1"></button>
            <button type="button" class="dk-elec-dot" data-goto="1" role="tab" aria-selected="false" aria-label="Slide 2"></button>
            <button type="button" class="dk-elec-dot" data-goto="2" role="tab" aria-selected="false" aria-label="Slide 3"></button>
            <button type="button" class="dk-elec-dot" data-goto="3" role="tab" aria-selected="false" aria-label="Slide 4"></button>
        </div>

    </section>

    <!-- ========================================================
         2. SHOP BY CATEGORY: ELECTRONICS SUBCATEGORIES
    ========================================================= -->
    <section class="dk-elec-shop-by-cat" aria-labelledby="shopElectronicsByCatTitle">
        
        <div class="dk-elec-cat-header">
            <div class="dk-elec-cat-header-left">
                <div class="dk-elec-header-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    <span>STUDENT TECH ESSENTIALS</span>
                </div>
                <h2 id="shopElectronicsByCatTitle" class="dk-elec-cat-title">Shop Electronics by Category</h2>
                <p class="dk-elec-cat-sub">Certified laptops, noise-cancelling audio, adapters, and international travel tech curated for university life.</p>
            </div>
            <div class="dk-elec-cat-header-right">
                <span class="dk-elec-live-count">⚡ <strong>@totalProducts</strong> Verified Items Available</span>
            </div>
        </div>

        <!-- Category Cards Grid -->
        <div class="dk-elec-cards-grid">

            <!-- 1. Laptops & Computers -->
            <a href="/category/electronics?q=laptop" class="dk-elec-cat-card" id="cat-card-laptops">
                <div class="dk-elec-card-top">
                    <div class="dk-elec-icon-box bg-blue">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="20" x2="22" y2="20"></line></svg>
                    </div>
                    <span class="dk-elec-card-arrow">→</span>
                </div>
                <div class="dk-elec-card-body">
                    <h3 class="dk-elec-card-name">Laptops &amp; MacBooks</h3>
                    <p class="dk-elec-card-desc">Apple MacBook, Dell XPS, HP &amp; ThinkPad for study &amp; exams.</p>
                </div>
                <div class="dk-elec-card-footer">
                    <span class="dk-elec-card-tag">MacBook &bull; Windows</span>
                    <span class="dk-elec-card-link-text">Shop Now</span>
                </div>
            </a>

            <!-- 2. Noise-Cancelling Headphones -->
            <a href="/category/electronics?q=headphone" class="dk-elec-cat-card" id="cat-card-headphones">
                <div class="dk-elec-card-top">
                    <div class="dk-elec-icon-box bg-purple">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                    </div>
                    <span class="dk-elec-card-arrow">→</span>
                </div>
                <div class="dk-elec-card-body">
                    <h3 class="dk-elec-card-name">Noise-Cancelling Headphones</h3>
                    <p class="dk-elec-card-desc">Sony, Bose, Apple &amp; Boat ANC gear for quiet library study.</p>
                </div>
                <div class="dk-elec-card-footer">
                    <span class="dk-elec-card-tag">ANC &bull; Wireless</span>
                    <span class="dk-elec-card-link-text">Shop Now</span>
                </div>
            </a>

            <!-- 3. Universal Travel Adapters -->
            <a href="/category/electronics?q=adapter" class="dk-elec-cat-card" id="cat-card-adapters">
                <div class="dk-elec-card-top">
                    <div class="dk-elec-icon-box bg-amber">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path><rect x="4" y="4" width="16" height="16" rx="2"></rect></svg>
                    </div>
                    <span class="dk-elec-card-arrow">→</span>
                </div>
                <div class="dk-elec-card-body">
                    <h3 class="dk-elec-card-name">Universal Travel Adapters</h3>
                    <p class="dk-elec-card-desc">All-in-one plugs for USA, UK, EU &amp; Australia with surge protection.</p>
                </div>
                <div class="dk-elec-card-footer">
                    <span class="dk-elec-card-tag">150+ Countries</span>
                    <span class="dk-elec-card-link-text">Shop Now</span>
                </div>
            </a>

            <!-- 4. Power Banks & Fast Chargers -->
            <a href="/category/electronics?q=charger" class="dk-elec-cat-card" id="cat-card-chargers">
                <div class="dk-elec-card-top">
                    <div class="dk-elec-icon-box bg-emerald">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <span class="dk-elec-card-arrow">→</span>
                </div>
                <div class="dk-elec-card-body">
                    <h3 class="dk-elec-card-name">Power Banks &amp; GaN Chargers</h3>
                    <p class="dk-elec-card-desc">65W/100W USB-C GaN fast chargers and high-capacity portable power.</p>
                </div>
                <div class="dk-elec-card-footer">
                    <span class="dk-elec-card-tag">65W PD &bull; GaN</span>
                    <span class="dk-elec-card-link-text">Shop Now</span>
                </div>
            </a>

            <!-- 5. International SIMs & eSIM -->
            <a href="/category/electronics?q=sim" class="dk-elec-cat-card" id="cat-card-sims">
                <div class="dk-elec-card-top">
                    <div class="dk-elec-icon-box bg-indigo">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5M12 12h.01M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5M19.1 4.9c3.9 3.9 3.9 10.3 0 14.2"></svg>
                    </div>
                    <span class="dk-elec-card-arrow">→</span>
                </div>
                <div class="dk-elec-card-body">
                    <h3 class="dk-elec-card-name">International Student SIMs</h3>
                    <p class="dk-elec-card-desc">Pre-activated US, UK &amp; EU cards with high-speed data &amp; calling.</p>
                </div>
                <div class="dk-elec-card-footer">
                    <span class="dk-elec-card-tag">USA &bull; UK &bull; EU</span>
                    <span class="dk-elec-card-link-text">Shop Now</span>
                </div>
            </a>

            <!-- 6. Storage & SSDs -->
            <a href="/category/electronics?q=ssd" class="dk-elec-cat-card" id="cat-card-storage">
                <div class="dk-elec-card-top">
                    <div class="dk-elec-icon-box bg-cyan">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                    </div>
                    <span class="dk-elec-card-arrow">→</span>
                </div>
                <div class="dk-elec-card-body">
                    <h3 class="dk-elec-card-name">Storage &amp; Portable SSDs</h3>
                    <p class="dk-elec-card-desc">Ultra-fast 1TB/2TB NVMe portable drives for backups and assignments.</p>
                </div>
                <div class="dk-elec-card-footer">
                    <span class="dk-elec-card-tag">NVMe &bull; Up to 2TB</span>
                    <span class="dk-elec-card-link-text">Shop Now</span>
                </div>
            </a>

            <!-- 7. Smart Tech & Wearables -->
            <a href="/category/electronics?q=watch" class="dk-elec-cat-card" id="cat-card-wearables">
                <div class="dk-elec-card-top">
                    <div class="dk-elec-icon-box bg-rose">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="7"></circle><polyline points="12 9 12 12 13.5 13.5"></polyline><path d="M16.51 17.35l-.35 3.83a2 2 0 0 1-2 1.82H9.83a2 2 0 0 1-2-1.82l-.35-3.83m.01-10.7l.35-3.83A2 2 0 0 1 9.83 1h4.35a2 2 0 0 1 2 1.82l.35 3.83"></path></svg>
                    </div>
                    <span class="dk-elec-card-arrow">→</span>
                </div>
                <div class="dk-elec-card-body">
                    <h3 class="dk-elec-card-name">Smartwatches &amp; Wearables</h3>
                    <p class="dk-elec-card-desc">Campus alarms, schedule alerts, heart rate and fitness tracking.</p>
                </div>
                <div class="dk-elec-card-footer">
                    <span class="dk-elec-card-tag">Apple &bull; Galaxy</span>
                    <span class="dk-elec-card-link-text">Shop Now</span>
                </div>
            </a>

            <!-- 8. Cables, Hubs & Organizers -->
            <a href="/category/electronics?q=cables" class="dk-elec-cat-card" id="cat-card-cables">
                <div class="dk-elec-card-top">
                    <div class="dk-elec-icon-box bg-teal">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    </div>
                    <span class="dk-elec-card-arrow">→</span>
                </div>
                <div class="dk-elec-card-body">
                    <h3 class="dk-elec-card-name">Cables, Hubs &amp; Organizers</h3>
                    <p class="dk-elec-card-desc">Braided USB-C cords, HDMI dongles, multi-port hubs &amp; tech cases.</p>
                </div>
                <div class="dk-elec-card-footer">
                    <span class="dk-elec-card-tag">USB-C &bull; Multi-Port</span>
                    <span class="dk-elec-card-link-text">Shop Now</span>
                </div>
            </a>

        </div>

    </section>

    <!-- Anchor for Smooth Scrolling to Products Section -->
    <div id="dk-electronics-items-anchor" class="dk-elec-items-anchor-bar">
        <div class="dk-elec-anchor-content">
            <span class="dk-elec-anchor-icon">📦</span>
            <span class="dk-elec-anchor-title">Electronics Product Catalog &bull; Showing All Curated Items Below</span>
        </div>
        <div class="dk-elec-anchor-chips">
            <a href="/category/electronics" class="dk-elec-chip active">All Electronics</a>
            <a href="/category/electronics?q=headphone" class="dk-elec-chip">Audio &amp; ANC</a>
            <a href="/category/electronics?q=laptop" class="dk-elec-chip">Laptops</a>
            <a href="/category/electronics?q=sim" class="dk-elec-chip">SIM Cards</a>
            <a href="/category/electronics?q=adapter" class="dk-elec-chip">Adapters</a>
        </div>
    </div>

</div>

<!-- ========================================================
     CSS STYLES FOR ELECTRONICS CATEGORY HUB & SHOP BY CATEGORY
========================================================= -->
<style>
    .dk-electronics-hub-root {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #0f172a;
        margin-bottom: 28px;
    }

    /* 1. HERO BANNER SECTION */
    .dk-elec-hero-section {
        position: relative;
        min-height: 440px;
        border-radius: 20px;
        overflow: hidden;
        background: #0f172a;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
        margin-bottom: 34px;
        display: flex;
        align-items: center;
    }

    .dk-elec-hero-bg-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
        overflow: hidden;
    }

    .dk-elec-hero-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center right;
        filter: brightness(1.04) contrast(1.02);
        transform: scale(1.01);
        transition: transform 6s ease;
    }
    .dk-elec-hero-section:hover .dk-elec-hero-bg-img {
        transform: scale(1.04);
