<script>
    function switchTab(tabId, btn) {
        document.querySelectorAll('.sp-tab-panel').forEach(function (p) { p.classList.remove('active'); });
        document.querySelectorAll('.sp-tab-btn').forEach(function (b) { b.classList.remove('active'); });
        var target = document.getElementById(tabId);
        if (target) target.classList.add('active');
        btn.classList.add('active');
    }

    function onSelectSubpage(slug) {
        document.querySelectorAll('.sp-subpage-editor').forEach(function (el) { el.classList.remove('active'); });
        var target = document.getElementById('subpage_' + slug);
        if (target) target.classList.add('active');
    }

    function triggerFileInput(btn) {
        var row = btn.closest('.sp-upload-row');
        if (row) {
            var fileInp = row.querySelector('.sp-file-input');
            if (fileInp) fileInp.click();
        }
    }

    function uploadFileGeneric(fileInput, onSuccess) {
        var file = fileInput.files[0];
        if (!file) return;

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var fd = new FormData();
        fd.append('file', file);
        fd.append('__RequestVerificationToken', token);

        fetch('/Admin/SportsHub/UploadImage', {
            method: 'POST',
            body: fd
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (data.success && data.url) {
                onSuccess(data.url);
                alert('Image uploaded successfully!');
            } else {
                alert('Upload error: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(function (err) {
            alert('Upload failed: ' + err.message);
        });
    }

    function uploadSlideImage(input) {
        uploadFileGeneric(input, function (url) {
            var card = input.closest('[data-slide-card]');
            var urlInput = card.querySelector('.slide-img-url');
            if (urlInput) urlInput.value = url;
            var uploadingCb = card.querySelector('.slide-uploading');
            if (uploadingCb) uploadingCb.checked = false;
        });
    }

    function uploadCatImage(input) {
        uploadFileGeneric(input, function (url) {
            var card = input.closest('[data-cat-card]');
            var urlInput = card.querySelector('.cat-img');
            if (urlInput) urlInput.value = url;
            var uploadingCb = card.querySelector('.cat-uploading');
            if (uploadingCb) uploadingCb.checked = false;
        });
    }

    function uploadPageHeroImage(input) {
        uploadFileGeneric(input, function (url) {
            var box = input.closest('.sp-subpage-hero-box');
            var urlInput = box.querySelector('.page-hero-img');
            if (urlInput) urlInput.value = url;
            var uploadingCb = box.querySelector('.page-hero-uploading');
            if (uploadingCb) uploadingCb.checked = false;
        });
    }

    function uploadProdImage(input) {
        uploadFileGeneric(input, function (url) {
            var card = input.closest('[data-prod-card]');
            var urlInput = card.querySelector('.prod-img');
            if (urlInput) urlInput.value = url;
            var uploadingCb = card.querySelector('.prod-uploading');
            if (uploadingCb) uploadingCb.checked = false;
        });
    }

