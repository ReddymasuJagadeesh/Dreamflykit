@model Dreamflykit.Web.Areas.Admin.Models.MfaRecoveryCodesViewModel
@{
    ViewData["Title"] = "Emergency Recovery Codes";
}

<div class="max-w-2xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="bg-white shadow rounded-xl p-8 border border-gray-100">
        <div class="flex items-center space-x-3 mb-6">
            <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-900">2FA Enabled Successfully</h1>
                <p class="text-sm text-gray-500">Save Your Emergency Recovery Codes</p>
            </div>
        </div>

        <div class="bg-amber-50 border-l-4 border-amber-400 p-4 mb-6 rounded-r">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-amber-800">
                        <strong>Important:</strong> Put these codes in a password manager or safe storage. If you lose your phone or authenticator access, recovery codes are the only way to regain administrator access.
                    </p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-3 p-4 bg-gray-50 rounded-lg border border-gray-200 font-mono text-sm font-bold text-gray-800 mb-6 select-all">
            @foreach (var code in Model.RecoveryCodes)
            {
                <div class="p-2 bg-white rounded border border-gray-200 text-center">@code</div>
            }
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-100">
            <a href="/Admin/Dashboard" 
               class="inline-flex justify-center py-2.5 px-6 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                Continue to Admin Dashboard &rarr;
            </a>
        </div>
    </div>
</div>

