@model Dreamflykit.Web.Models.Home.HomeViewModel

@{
    ViewData["Title"] = "Home";
}


<div class="dk-home-page">


    <!-- =====================================================
         HERO SLIDER (MULTI-IMAGE, SIDE ARROWS, AUTO-TIME SLIDE)
    ====================================================== -->
    @{
        var heroSlides = Model.HeroSlides?.Any() == true 
            ? Model.HeroSlides.ToList() 
            : new List<Dreamflykit.Web.Models.Home.HomeHeroSlideDto>
            {
                new() { ImageUrl = Url.Content("~/images/hero/hero.webp"), Title = "Your Journey. Our Kit.", CtaUrl = "/Kits/FindMyKit", AltText = "Dreamflykit - Your Journey. Our Kit." },
                new() { ImageUrl = Url.Content("~/images/hero/hero-electronics.webp"), Title = "International Tech & Power Adapters", CtaUrl = "/category/electronics", AltText = "Dreamflykit Electronics & Power Adapters" },
                new() { ImageUrl = Url.Content("~/images/hero/hero-travel-gear.webp"), Title = "Curated Study Abroad Luggage & Kits", CtaUrl = "/category/travel-gear", AltText = "Dreamflykit Travel Gear" }
            };
    }

    <section class="dk-hero dk-hero-carousel-container" id="dkHeroSlider" aria-roledescription="carousel" aria-label="Dreamflykit Featured Slides">

        <div class="dk-hero-track-viewport">
            <div class="dk-hero-slider-track" id="heroTrack">
                @for (int i = 0; i < heroSlides.Count; i++)
                {
                    var slide = heroSlides[i];
                    var link = string.IsNullOrWhiteSpace(slide.CtaUrl) ? "/Kits/FindMyKit" : slide.CtaUrl;
                    <div class="dk-hero-slide @(i == 0 ? "is-active" : "")" 
                         data-index="@i"
                         role="group" 
                         aria-roledescription="slide" 
                         aria-label="@(i + 1) of @heroSlides.Count">
                        <a href="@link" class="dk-hero-slide-link" tabindex="@(i == 0 ? "0" : "-1")">
                            <img src="@slide.ImageUrl" 
                                 alt="@(slide.AltText ?? slide.Title ?? "Dreamflykit Hero Slide")" 
                                 class="dk-hero-slide-img" 
                                 loading="@(i == 0 ? "eager" : "lazy")" />
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- SIDE ARROWS: PREVIOUS AND NEXT -->
        <button type="button" 
                class="dk-hero-arrow dk-hero-arrow-prev" 
                id="heroPrevBtn" 
                aria-label="Previous Slide" 
                title="Previous Slide">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>

        <button type="button" 
                class="dk-hero-arrow dk-hero-arrow-next" 
                id="heroNextBtn" 
                aria-label="Next Slide" 
                title="Next Slide">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>

        <!-- DOTS PAGINATION INDICATOR -->
        <div class="dk-hero-dots-nav" id="heroDotsNav" role="tablist" aria-label="Slide Selection">
            @for (int i = 0; i < heroSlides.Count; i++)
            {
                <button type="button" 
                        class="dk-hero-dot @(i == 0 ? "active" : "")" 
                        data-slide-index="@i" 
                        role="tab" 
                        aria-label="Slide @(i + 1)" 
                        aria-selected="@(i == 0 ? "true" : "false")">
                    <span class="dk-dot-pill"></span>
                </button>
            }
        </div>

        <!-- AUTO-PLAY TIMEFRAME PROGRESS BAR -->
        <div class="dk-hero-time-indicator" aria-hidden="true">
            <div class="dk-hero-time-fill" id="heroTimeBar"></div>
        </div>

        <!-- ADMIN DIRECT ACCESS BADGE -->
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
        {
            <a href="/Admin/Banners" 
               class="dk-hero-admin-manage-btn" 
               title="Super Admin: Add, replace, or configure slides & auto-timeframe in Admin">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <span>Manage Slides (Admin)</span>
            </a>
        }

    </section>

    <!-- =====================================================
         BENEFITS
    ====================================================== -->

    <section class="dk-benefits">

        <div class="dk-benefits-grid">


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M3 7h18v13H3z"></path>
                        <path d="M3 7l3-4h12l3 4"></path>
                        <path d="M8 11h8"></path>
                    </svg>

                </div>

                <div>

                    <strong>
                        Curated for Students
                    </strong>

                    <span>
                        Handpicked essentials for every abroad journey
                    </span>

                </div>

            </div>


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M12 3l8 4v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V7z"></path>
                        <path d="m8 12 2.5 2.5L16 9"></path>
                    </svg>

                </div>

                <div>

                    <strong>
                        Best Quality Products
                    </strong>

                    <span>
                        100% genuine & premium brands
                    </span>

                </div>

            </div>


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M12 2v20"></path>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14.5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>

                </div>

                <div>

                    <strong>
                        Affordable Prices
                    </strong>

                    <span>
                        Best value for students
                    </span>

                </div>

            </div>


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M3 7h11v10H3z"></path>
                        <path d="M14 10h4l3 3v4h-7z"></path>
                        <circle cx="7" cy="19" r="2"></circle>
                        <circle cx="18" cy="19" r="2"></circle>
                    </svg>

                </div>

                <div>

                    <strong>
                        Fast & Reliable Delivery
                    </strong>

                    <span>
                        On-time delivery worldwide
                    </span>

                </div>

            </div>


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M4 5h16v12H4z"></path>
                        <path d="M8 21h8"></path>
                        <path d="M12 17v4"></path>
                    </svg>

                </div>

                <div>

                    <strong>
                        24/7 Customer Support
                    </strong>

                    <span>
                        We're always here to help you
                    </span>

                </div>

            </div>


        </div>

    </section>


    <!-- =====================================================
         TOP COUNTRY KITS
    ====================================================== -->

    <section class="dk-section">


        <div class="dk-section-header">

            <div class="dk-section-header-row">

                <div>

                    <h2 class="dk-section-title">
                        Top Country Kits
