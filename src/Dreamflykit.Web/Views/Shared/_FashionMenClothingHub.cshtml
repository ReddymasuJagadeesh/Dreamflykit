    btn.style.transform = 'scale(0.85)';
    setTimeout(() => {
        btn.style.transform = 'scale(1.1)';
        btn.style.backgroundColor = '#16a34a';
        setTimeout(() => {
            btn.style.transform = '';
            btn.style.backgroundColor = '';
        }, 1000);
    }, 150);
}

