@model Dreamflykit.Application.AppliancesHub.Models.AppliancesHubDto
@{
    var hub = Model ?? Dreamflykit.Application.AppliancesHub.Models.AppliancesHubDto.CreateDefault();
    var theme = hub.ThemeSettings ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesThemeSettingsDto();
    var hero = hub.HeroBanner ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesHeroBannerDto();
    var slides = hero.Slides?.Where(s => s != null).ToList() 
                 ?? new List<Dreamflykit.Application.AppliancesHub.Models.AppliancesHeroSlideDto>();
    if (slides.Count == 0)
    {
        slides = Dreamflykit.Application.AppliancesHub.Models.AppliancesHubDto.CreateDefault().HeroBanner.Slides;
    }

    var bankOffer = hub.BankOffer ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesBankOfferDto();
    var subCats = hub.SubCategories?.Items ?? new List<Dreamflykit.Application.AppliancesHub.Models.AppliancesSubCategoryItemDto>();
    var spotlight = hub.BrandSpotlight ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesBrandSpotlightDto();
    var creditPromos = hub.CreditPromos ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesCreditPromoDto();
    var limitedDeals = hub.LimitedTimeDeals ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesLimitedDealsDto();
    var goldenHighlights = hub.GoldenHighlights ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesGoldenHighlightsDto();
    var homeDeals = hub.HomeAppliancesDeals ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesTabbedDealsDto();
    var kitchenDeals = hub.KitchenAppliancesDeals ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesTabbedDealsDto();
    var emiSection = hub.NoCostEmiSection ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesEmiSectionDto();
    var everydayLiving = hub.EverydayLivingSection ?? new Dreamflykit.Application.AppliancesHub.Models.AppliancesEverydayLivingDto();

    var isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var slideDuration = hero.IntervalSeconds > 0 ? hero.IntervalSeconds : 4;
}

<div class="dk-appliances-hub-root" id="appliances-hub-root" 
     style="--app-gold: @theme.AccentGold; --app-bg: @theme.PrimaryBgGradient;">

    <!-- ========================================================
         ADMIN BAR (Visible to Admin & SuperAdmin)
    ========================================================= -->
    @if (isAdmin)
    {
        <div class="dk-app-admin-bar">
            <div class="dk-app-admin-info">
                <span class="dk-app-admin-badge">⚡ Admin Mode Active</span>
                <span>Flipkart Appliances Store &bull; Festival Mode: <strong>@(theme.IsFestiveEnabled ? theme.ThemeName : "Off")</strong> &bull; Slides: <strong>@slides.Count</strong> &bull; Interval: <strong>@(slideDuration)s</strong></span>
            </div>
            <a href="/Admin/AppliancesHub" class="dk-app-admin-btn" id="btnManageAppliancesHub">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                Manage Appliances Hub &amp; Upload Images
            </a>
        </div>
    }

    <!-- ========================================================
         1. FULL WIDTH HERO BANNER CAROUSEL
         Edge-to-edge, Admin customizable slides, timeframes, upload soon
    ========================================================= -->
    @if (hero.IsEnabled && slides.Count > 0)
    {
        <section class="dk-app-hero-wrapper" 
                 id="appHeroCarousel" 
                 data-autoplay="@(hero.AutoPlay ? "true" : "false")" 
                 data-interval="@(slideDuration * 1000)">
            <div class="dk-app-hero-slider" id="appHeroSlider">
                @for (int i = 0; i < slides.Count; i++)
                {
                    var slide = slides[i];
                    var isActive = i == 0;
                    <div class="dk-app-hero-slide @(isActive ? "active" : "")" 
                         data-index="@i">
                        <a href="@slide.TargetUrl" class="dk-app-hero-slide-link" title="@slide.Title">
                            @if (slide.IsUploadingSoon || string.IsNullOrWhiteSpace(slide.ImageUrl))
                            {
                                <div class="dk-app-placeholder-banner">
                                    <div class="dk-app-placeholder-content">
                                        <div class="dk-app-badge-pill">⏳ Uploading Soon</div>
                                        <h2>@slide.Title</h2>
                                        @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
                                        {
                                            <p>@slide.Subtitle</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(slide.PriceHighlight))
                                        {
                                            <div class="dk-app-banner-price">@slide.PriceHighlight</div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <img src="@slide.ImageUrl" 
                                     alt="@slide.Title" 
                                     class="dk-app-hero-img" 
                                     loading="@(i == 0 ? "eager" : "lazy")" />
                            }
                        </a>
                    </div>
                }
            </div>

            <!-- Slide Navigation Indicators (Dots) -->
            <div class="dk-app-hero-indicators" id="appHeroDots">
                @for (int i = 0; i < slides.Count; i++)
                {
                    <button class="dk-app-hero-dot @(i == 0 ? "active" : "")" 
                            data-target="@i" 
                            aria-label="Slide @(i + 1)"></button>
                }
            </div>

            <!-- Prev / Next Controls -->
            <button class="dk-app-hero-nav dk-app-hero-prev" id="appHeroPrev" aria-label="Previous Slide">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="dk-app-hero-nav dk-app-hero-next" id="appHeroNext" aria-label="Next Slide">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </section>
    }

    <div class="dk-app-content-container">

        <!-- ========================================================
             2. BANK / PAYMENT DISCOUNT STRIP (SBI Card 10% Instant Discount)
        ========================================================= -->
        @if (bankOffer.IsEnabled)
        {
            <section class="dk-app-bank-strip" aria-label="Bank Discount Offer">
                <div class="dk-app-bank-content">
                    <div class="dk-app-bank-logo">
                        @if (!string.IsNullOrWhiteSpace(bankOffer.BankLogoUrl))
                        {
                            <img src="@bankOffer.BankLogoUrl" alt="SBI Card" class="dk-app-sbi-logo" onerror="this.style.display='none'; document.getElementById('sbiFallback').style.display='inline-flex';" />
                        }
                        <span id="sbiFallback" class="dk-app-sbi-fallback" style="@(string.IsNullOrWhiteSpace(bankOffer.BankLogoUrl) ? "display: inline-flex;" : "display: none;")">
                            <span class="dk-app-sbi-circle"></span>
                            <strong>SBI Card</strong>
                        </span>
                    </div>
                    <div class="dk-app-bank-divider"></div>
                    <div class="dk-app-bank-text">
                        <span class="dk-app-bank-highlight">@bankOffer.OfferText</span>
                        <span class="dk-app-bank-sub">@bankOffer.OfferSubtext</span>
                    </div>
                </div>
            </section>
        }

        <!-- ========================================================
             3. SUB-CATEGORY ICON GRID (16 Items: TV, Laundry, ACs, Fans, etc.)
        ========================================================= -->
        @if (subCats.Count > 0)
        {
            <section class="dk-app-subcats-section" aria-label="Appliances Categories">
                <div class="dk-app-section-header" style="margin-bottom: 16px; padding: 0 4px;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px;">
                        <div>
                            <h3 class="dk-app-section-title" style="font-size: 20px; font-weight: 800; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                                <span>Shop by Category</span>
                            </h3>
                            <p style="font-size: 13px; color: #64748b; margin: 4px 0 0 0;">Explore genuine student &amp; home appliances from verified brands</p>
                        </div>
                        <span style="font-size: 12px; font-weight: 700; color: #ea580c; background: #fff7ed; padding: 4px 12px; border-radius: 9999px; border: 1px solid #ffedd5;">16 Categories</span>
                    </div>
                </div>
                <div class="dk-app-subcats-grid">
                    @foreach (var sub in subCats)
                    {
                        var catTargetUrl = !string.IsNullOrWhiteSpace(sub.TargetUrl) && !sub.TargetUrl.Contains("?sub=")
                            ? sub.TargetUrl
                            : $"/category/appliances/{sub.Slug}";
                        <a href="@catTargetUrl" class="dk-app-subcat-card" title="@sub.Title">
                            <div class="dk-app-subcat-icon-box">
                                @if (sub.IsUploadingSoon || string.IsNullOrWhiteSpace(sub.ImageUrl))
                                {
                                    <div class="dk-app-subcat-fallback-icon">
                                        <span>@sub.Icon</span>
                                        <small class="dk-app-tiny-soon">Soon</small>
                                    </div>
                                }
                                else
                                {
                                    <img src="@sub.ImageUrl" alt="@sub.Title" class="dk-app-subcat-img" loading="lazy" />
                                }
                                @if (!string.IsNullOrWhiteSpace(sub.Badge))
                                {
                                    <span class="dk-app-subcat-badge">@sub.Badge</span>
                                }
                            </div>
                            <span class="dk-app-subcat-title">@sub.Title</span>
                        </a>
                    }
                </div>
            </section>
        }

        <!-- ========================================================
             4. BRAND IN SPOTLIGHT (TCL 85" QLED TV Banner)
        ========================================================= -->
        @if (spotlight.IsEnabled)
        {
            <section class="dk-app-spotlight-section" aria-label="Brand in Spotlight">
                <div class="dk-app-section-header">
                    <h3 class="dk-app-section-title">Brand in spotlight</h3>
                </div>
                <div class="dk-app-spotlight-banner-wrap">
                    <a href="@spotlight.TargetUrl" class="dk-app-spotlight-banner" title="@spotlight.BrandName">
                        @if (spotlight.IsUploadingSoon || string.IsNullOrWhiteSpace(spotlight.ImageUrl))
                        {
                            <div class="dk-app-spotlight-placeholder">
                                <span class="dk-app-badge-ad">AD</span>
                                <div class="dk-app-spotlight-inner">
                                    <div class="dk-app-spotlight-txt">
                                        <h4>@spotlight.ProductTitle</h4>
                                        <div class="dk-app-spotlight-price">@spotlight.PriceHighlight</div>
                                    </div>
                                    <div class="dk-app-spotlight-brand">
                                        <div class="dk-app-spotlight-brand-name">@spotlight.BrandName</div>
                                        <small>@spotlight.BrandTagline</small>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="dk-app-spotlight-img-box">
                                <span class="dk-app-badge-ad">AD</span>
                                <img src="@spotlight.ImageUrl" alt="@spotlight.ProductTitle" class="dk-app-spotlight-img" loading="lazy" />
                            </div>
                        }
                    </a>
                </div>
            </section>
        }

        <!-- ========================================================
             5. DUAL CREDIT / EMI PROMO CARDS (Axis Bank & Flipkart EMI)
        ========================================================= -->
        @if (creditPromos.IsEnabled)
        {
            <section class="dk-app-credit-section" aria-label="Finance and Credit Offers">
                <div class="dk-app-credit-grid">
                    <a href="@creditPromos.Card1Link" class="dk-app-credit-card" title="@creditPromos.Card1Title">
                        <div class="dk-app-credit-left">
                            <div class="dk-app-credit-icon-fallback">
                                <span>💳</span>
                            </div>
                        </div>
                        <div class="dk-app-credit-info">
                            <div class="dk-app-credit-title">
                                <span class="dk-app-credit-head">@creditPromos.Card1Badge</span>
                            </div>
                            <div class="dk-app-credit-sub">
                                <span>@creditPromos.Card1Sub</span>
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </div>
                        </div>
                    </a>

                    <a href="@creditPromos.Card2Link" class="dk-app-credit-card" title="@creditPromos.Card2Title">
                        <div class="dk-app-credit-left">
                            <div class="dk-app-credit-icon-fallback" style="background: #fef08a; color: #854d0e;">
                                <span>🏷️</span>
                            </div>
                        </div>
                        <div class="dk-app-credit-info">
                            <div class="dk-app-credit-title">
                                <span class="dk-app-credit-head">@creditPromos.Card2Badge</span>
                            </div>
                            <div class="dk-app-credit-sub">
                                <span>@creditPromos.Card2Sub</span>
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </div>
                        </div>
                    </a>
                </div>
            </section>
        }

        <!-- ========================================================
             6. LIMITED TIME DEAL (Flash Sale Timed Slots with Lock Icons)
        ========================================================= -->
        @if (limitedDeals.IsEnabled && limitedDeals.Slots.Count > 0)
        {
            <section class="dk-app-limited-section" aria-label="Limited Time Deals">
                <div class="dk-app-limited-canopy">
                    <div class="dk-app-limited-header">
                        <div class="dk-app-limited-lights">
                            <span class="dk-app-bulb"></span>
                            <span class="dk-app-bulb"></span>
                            <span class="dk-app-bulb"></span>
                            <span class="dk-app-bulb"></span>
                            <span class="dk-app-bulb"></span>
                        </div>
                        <h3 class="dk-app-limited-title">@limitedDeals.Title</h3>
                    </div>

                    <div class="dk-app-limited-carousel" id="limitedDealsCarousel">
                        <div class="dk-app-limited-track">
                            @foreach (var item in limitedDeals.Slots)
                            {
                                <div class="dk-app-limited-slot @(item.IsLocked ? "is-locked" : "is-unlocked")">
                                    <div class="dk-app-limited-arch">
                                        <div class="dk-app-slot-img-wrap">
                                            @if (item.IsUploadingSoon || string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <div class="dk-app-slot-placeholder">
                                                    <span class="dk-app-slot-emoji">📺</span>
                                                    <span class="dk-app-slot-soon">Uploading Soon</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <img src="@item.ImageUrl" alt="@item.ItemTitle" class="dk-app-slot-img" loading="lazy" />
                                            }

                                            @if (item.IsLocked)
                                            {
                                                <div class="dk-app-lock-overlay">
                                                    <div class="dk-app-lock-badge">
                                                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                                            <path d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5zm-3 5a3 3 0 0 1 6 0v3H9V7zm3 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/>
                                                        </svg>
                                                    </div>
                                                    <div class="dk-app-lock-time">@item.TimeSlot</div>
                                                </div>
                                            }
                                        </div>

                                        <div class="dk-app-slot-bottom">
                                            <div class="dk-app-slot-price">@item.PriceText</div>
                                            <div class="dk-app-slot-name">@item.ItemTitle</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }

        <!-- ========================================================
             7. GOLDEN FRAME BLOCKBUSTER DEALS (Solid Red Festive Grid with 6 items)
        ========================================================= -->
        @if (goldenHighlights.IsEnabled && goldenHighlights.Items.Count > 0)
        {
            <section class="dk-app-golden-section" aria-label="Festival Blockbuster Deals">
                <div class="dk-app-golden-banner-wrap">
                    <div class="dk-app-golden-grid">
                        @foreach (var card in goldenHighlights.Items)
                        {
                            <a href="@card.TargetUrl" class="dk-app-golden-card" title="@card.Title">
                                <div class="dk-app-golden-inner">
                                    <div class="dk-app-golden-img-box">
                                        @if (card.IsUploadingSoon || string.IsNullOrWhiteSpace(card.ImageUrl))
                                        {
                                            <div class="dk-app-golden-placeholder">
                                                <span>⚡</span>
                                                <small>Uploading Soon</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <img src="@card.ImageUrl" alt="@card.Title" class="dk-app-golden-img" loading="lazy" />
                                        }
                                    </div>
                                    <div class="dk-app-golden-banner-pill">
                                        <span class="dk-app-golden-price">@card.PriceText</span>
                                        <span class="dk-app-golden-name">@card.Title</span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- ========================================================
             8. DEALS ON HOME APPLIANCES (Tabbed Carousel)
        ========================================================= -->
        @if (homeDeals.IsEnabled && homeDeals.Items.Count > 0)
        {
            <section class="dk-app-deals-card-section" id="homeAppliancesSection" aria-label="Deals on Home Appliances">
                <div class="dk-app-deals-box" style="background: linear-gradient(180deg, #ff6a00 0%, #ee5a00 100%);">
                    <div class="dk-app-deals-header">
                        <div class="dk-app-deals-title-row">
                            <h3 class="dk-app-deals-heading">@homeDeals.SectionHeader</h3>
                        </div>
                        <div class="dk-app-deals-tabs">
                            @foreach (var tab in homeDeals.Tabs)
                            {
                                <button class="dk-app-deals-tab-btn @(tab == "Best picks" ? "active" : "")" 
                                        onclick="filterApplianceDeals('homeAppliancesSection', '@tab')">
                                    @tab
                                </button>
                            }
                        </div>
                    </div>

                    <div class="dk-app-deals-track-wrap">
                        <div class="dk-app-deals-track">
                            @foreach (var item in homeDeals.Items)
                            {
                                <a href="@item.TargetUrl" 
                                   class="dk-app-deal-item-card" 
                                   data-tab="@item.TabCategory"
                                   title="@item.Title">
                                    <div class="dk-app-deal-item-top">
                                        @if (item.IsUploadingSoon || string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <div class="dk-app-deal-placeholder">
                                                <span>🏠</span>
                                                <small>Uploading Soon</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Title" class="dk-app-deal-item-img" loading="lazy" />
                                        }
                                    </div>
                                    <div class="dk-app-deal-item-bottom">
                                        <div class="dk-app-deal-item-price">@item.PriceText</div>
                                        <div class="dk-app-deal-item-title">@item.Title</div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }

        <!-- ========================================================
             9. DEALS ON KITCHEN APPLIANCES (Tabbed Carousel)
        ========================================================= -->
        @if (kitchenDeals.IsEnabled && kitchenDeals.Items.Count > 0)
        {
            <section class="dk-app-deals-card-section" id="kitchenAppliancesSection" aria-label="Deals on Kitchen Appliances">
                <div class="dk-app-deals-box" style="background: linear-gradient(180deg, #d84315 0%, #bf360c 100%);">
                    <div class="dk-app-deals-header">
                        <div class="dk-app-deals-title-row">
                            <h3 class="dk-app-deals-heading">@kitchenDeals.SectionHeader</h3>
                        </div>
                        <div class="dk-app-deals-tabs">
                            @foreach (var tab in kitchenDeals.Tabs)
                            {
                                <button class="dk-app-deals-tab-btn @(tab == "Best picks" ? "active" : "")" 
                                        onclick="filterApplianceDeals('kitchenAppliancesSection', '@tab')">
                                    @tab
                                </button>
                            }
                        </div>
                    </div>

                    <div class="dk-app-deals-track-wrap">
                        <div class="dk-app-deals-track">
                            @foreach (var item in kitchenDeals.Items)
                            {
                                <a href="@item.TargetUrl" 
                                   class="dk-app-deal-item-card" 
                                   data-tab="@item.TabCategory"
                                   title="@item.Title">
                                    <div class="dk-app-deal-item-top">
                                        @if (item.IsUploadingSoon || string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <div class="dk-app-deal-placeholder">
                                                <span>🍳</span>
                                                <small>Uploading Soon</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Title" class="dk-app-deal-item-img" loading="lazy" />
                                        }
                                    </div>
                                    <div class="dk-app-deal-item-bottom">
                                        <div class="dk-app-deal-item-price">@item.PriceText</div>
                                        <div class="dk-app-deal-item-title">@item.Title</div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }

        <!-- ========================================================
             10. NO COST EMI SECTION (Arched Cards with Monthly EMI)
        ========================================================= -->
        @if (emiSection.IsEnabled && emiSection.Items.Count > 0)
        {
            <section class="dk-app-emi-section" aria-label="No Cost EMI Offers">
                <div class="dk-app-emi-canopy">
                    <div class="dk-app-emi-header">
                        <h3 class="dk-app-emi-title">@emiSection.Title</h3>
                    </div>
                    <div class="dk-app-emi-track-wrap">
                        <div class="dk-app-emi-track">
                            @foreach (var item in emiSection.Items)
                            {
                                <a href="@item.TargetUrl" class="dk-app-emi-card" title="@item.Title">
                                    <div class="dk-app-emi-arch">
                                        <div class="dk-app-emi-img-wrap">
                                            @if (item.IsUploadingSoon || string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <div class="dk-app-emi-placeholder">
                                                    <span>💳</span>
                                                    <small>Soon</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Title" class="dk-app-emi-img" loading="lazy" />
                                            }
                                        </div>
                                        <div class="dk-app-emi-bottom">
                                            <div class="dk-app-emi-rate">@item.EmiText</div>
                                            <div class="dk-app-emi-name">@item.Title</div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }

        <!-- ========================================================
             11. FOR EVERYDAY LIVING! (Pastel Rounded Essentials)
        ========================================================= -->
        @if (everydayLiving.IsEnabled && everydayLiving.Items.Count > 0)
        {
            <section class="dk-app-living-section" aria-label="Everyday Living Appliances">
                <div class="dk-app-section-header">
                    <h3 class="dk-app-section-title">@everydayLiving.Title</h3>
                </div>
                <div class="dk-app-living-grid">
                    @foreach (var item in everydayLiving.Items)
                    {
                        <a href="@item.TargetUrl" class="dk-app-living-card" title="@item.Title">
                            <div class="dk-app-living-img-box">
                                @if (item.IsUploadingSoon || string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <div class="dk-app-living-placeholder">
                                        <span>✨</span>
                                        <small>Uploading Soon</small>
                                    </div>
                                }
                                else
                                {
                                    <img src="@item.ImageUrl" alt="@item.Title" class="dk-app-living-img" loading="lazy" />
                                }
                            </div>
                            <span class="dk-app-living-name">@item.Title</span>
                        </a>
                    }
                </div>
