@model Dreamflykit.Web.Areas.Admin.Models.AdminCategoryListViewModel

@{
    ViewData["Title"] = "Categories & Subcategories Management";
}

<div class="dk-admin-card" style="margin-bottom: 24px;">
    <div class="dk-admin-card-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h3 class="dk-admin-card-title" style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">
                Store Taxonomy (@Model.Categories.Count Categories)
            </h3>
            <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">
                Organize product hierarchy, assign category thumbnail banners, and manage subcategories.
            </p>
        </div>

        <div style="display: flex; gap: 10px;">
            <a href="/Admin/Categories/Create" class="dk-btn dk-btn-primary" style="padding: 8px 16px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                + Add Category
            </a>
            <a href="/Admin/Categories/CreateSubcategory" class="dk-btn dk-btn-secondary" style="padding: 8px 16px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                + Add Subcategory
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="margin: 16px 20px 0; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 13px; font-weight: 600;">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    <div class="dk-admin-table-wrap" style="margin-top: 16px;">
        <table class="dk-admin-table">
            <thead>
                <tr>
                    <th style="width: 60px;">Image</th>
                    <th>Category Name</th>
                    <th>Slug</th>
                    <th>Order</th>
                    <th>Subcategories</th>
                    <th>Products</th>
                    <th>Status</th>
                    <th style="text-align: right; width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categories.Count == 0)
                {
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 40px; color: #64748b;">
                            No categories created yet. Click "+ Add Category" to start organizing your catalog.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrWhiteSpace(c.ImageUrl) ? "/images/categories/category-placeholder.webp" : c.ImageUrl)"
                                     alt="@c.Name"
                                     style="width: 44px; height: 44px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc;" />
                            </td>
                            <td>
                                <strong style="font-size: 14px; color: #0f172a;">@c.Name</strong>
                            </td>
                            <td>
                                <code style="font-size: 12px; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; color: #475569;">@c.Slug</code>
                            </td>
                            <td>@c.DisplayOrder</td>
                            <td>
                                @if (c.Subcategories.Count == 0)
                                {
                                    <span style="color: #94a3b8; font-size: 12px;">None</span>
                                }
                                else
                                {
                                    <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                        @foreach (var sub in c.Subcategories)
                                        {
                                            <a href="/Admin/Categories/EditSubcategory/@sub.Id" style="display: inline-flex; align-items: center; gap: 4px; font-size: 11px; background: #eff6ff; color: #1d4ed8; padding: 2px 8px; border-radius: 9999px; text-decoration: none; border: 1px solid #bfdbfe;">
                                                <span>@sub.Name</span>
                                                <small style="color: #64748b;">(@sub.ProductCount)</small>
                                            </a>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span style="font-weight: 700; color: #0f172a;">@c.ProductCount</span>
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="dk-status-badge dk-status-delivered">Active</span>
                                }
                                else
                                {
                                    <span class="dk-status-badge dk-status-cancelled">Inactive</span>
                                }
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <a href="/Admin/Categories/CreateSubcategory?categoryId=@c.Id" class="dk-btn dk-btn-secondary" style="padding: 4px 8px; font-size: 11px; margin-right: 4px; text-decoration: none;" title="Add Subcategory under @c.Name">
                                    + Sub
                                </a>
                                <a href="/Admin/Categories/Edit/@c.Id" class="dk-btn dk-btn-secondary" style="padding: 4px 8px; font-size: 11px; margin-right: 4px; text-decoration: none;">
                                    Edit
                                </a>
                                <form method="post" action="/Admin/Categories/Toggle/@c.Id" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dk-btn @(c.IsActive ? "dk-btn-outline" : "dk-btn-primary")" style="padding: 4px 8px; font-size: 11px;">
                                        @(c.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
