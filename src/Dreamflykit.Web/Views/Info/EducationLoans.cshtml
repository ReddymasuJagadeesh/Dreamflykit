@{
    ViewData["Title"] = "Study Abroad Education Loans & Financial Guide — Dreamflykit";
    Layout = "_Layout";
}

<div class="dk-page-container dk-info-page">
    <div class="dk-info-hero">
        <div class="dk-info-hero-badge">💰 STUDENT FINANCIAL EMPOWERMENT</div>
        <h1 class="dk-info-hero-title">Overseas Education Loans & Forex Guide</h1>
        <p class="dk-info-hero-subtitle">
            Demystifying collateral requirements, interest rates, Section 80E tax deductions, Blocked Accounts, and zero-markup Forex cards for international students.
        </p>
    </div>

    <!-- Loan Comparison Cards -->
    <div class="dk-pillars-grid">
        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">🏛️</div>
            <h3 class="dk-pillar-title">Public Sector Banks (SBI / BoB)</h3>
            <p class="dk-pillar-desc">
                Lowest interest rates (8.15% – 9.50%). Requires collateral (property/FD) for amounts above ₹7.5 Lakhs. 100% tax rebate on interest paid under Section 80E with no upper cap.
            </p>
        </div>

        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">🏦</div>
            <h3 class="dk-pillar-title">NBFCs (HDFC Credila / Avanse)</h3>
            <p class="dk-pillar-desc">
                High approval speed (3-5 days), flexible co-signer criteria, and unsecured loans up to ₹60-75 Lakhs for premier STEM university admits without requiring physical property collateral.
            </p>
        </div>

        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">🌐</div>
            <h3 class="dk-pillar-title">USD International Lenders (Prodigy)</h3>
            <p class="dk-pillar-desc">
                Non-cosigner, non-collateral loans funded in USD/GBP. Repayment starts after graduation, shielding students from rupee depreciation during their study period.
            </p>
        </div>
    </div>

    <!-- Section 80E & Savings Callout -->
    <div class="dk-card" style="margin-top: 32px; background: #f0fdf4; border-color: #bbf7d0;">
        <h3 style="color: #166534; margin-bottom: 8px;">💡 Pro-Tip: Save Up to 30% via Section 80E Tax Deduction</h3>
        <p style="color: #15803d; font-size: 14px; margin: 0;">
            Under Section 80E of the Indian Income Tax Act, the entire interest paid on an education loan for higher education is 100% tax-deductible for up to 8 continuous assessment years without any monetary cap. This significantly lowers the effective interest cost of your study abroad journey.
        </p>
    </div>

    <!-- Key Step-by-Step Financial Checklist -->
    <div class="dk-card" style="margin-top: 32px;">
        <h3 class="dk-card-title">Pre-Departure Overseas Financial Checklist</h3>

        <div style="display: flex; flex-direction: column; gap: 16px; margin-top: 16px;">
            <div style="display: flex; gap: 14px; align-items: start;">
                <span class="dk-badge dk-badge-accent" style="padding: 6px 12px; font-size: 14px; font-weight: 800;">1</span>
                <div>
                    <h4 style="margin: 0; font-size: 15px;">Loan Sanction Letter & I-20/CAS Proof of Funds</h4>
                    <p style="margin: 4px 0 0 0; color: #64748b; font-size: 13px;">
                        Ensure the bank issues a non-conditional, liquid fund disbursement sanction letter required for your F-1 visa interview or UK CAS issuance.
                    </p>
                </div>
            </div>

            <div style="display: flex; gap: 14px; align-items: start;">
                <span class="dk-badge dk-badge-accent" style="padding: 6px 12px; font-size: 14px; font-weight: 800;">2</span>
                <div>
                    <h4 style="margin: 0; font-size: 15px;">Forex Multi-Currency Card vs Cash Carry</h4>
                    <p style="margin: 4px 0 0 0; color: #64748b; font-size: 13px;">
                        Load at least $2,000 – $3,000 on a zero-markup student Forex card for initial rent and deposits, and carry $500 – $800 in physical cash bills for immediate transit expenses.
                    </p>
                </div>
            </div>

            <div style="display: flex; gap: 14px; align-items: start;">
                <span class="dk-badge dk-badge-accent" style="padding: 6px 12px; font-size: 14px; font-weight: 800;">3</span>
                <div>
                    <h4 style="margin: 0; font-size: 15px;">Blocked Account (Germany) / GIC (Canada)</h4>
                    <p style="margin: 4px 0 0 0; color: #64748b; font-size: 13px;">
                        Complete your German Blocked Account (Expatrio/Fintiba) or Canadian Scotiabank/CIBC Student GIC transfer at least 3 weeks prior to biometric submission.
                    </p>
                </div>
            </div>

            <div style="display: flex; gap: 14px; align-items: start;">
                <span class="dk-badge dk-badge-accent" style="padding: 6px 12px; font-size: 14px; font-weight: 800;">4</span>
                <div>
                    <h4 style="margin: 0; font-size: 15px;">Pre-Departure Kit Budgeting</h4>
                    <p style="margin: 4px 0 0 0; color: #64748b; font-size: 13px;">
                        Buying student essentials in local foreign currencies (USD, GBP, CAD) costs 3x to 4x higher. Purchasing a certified Dreamflykit in INR before departure saves upwards of ₹45,000 on immediate living setup costs.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Card -->
    <div class="dk-card" style="margin-top: 32px; text-align: center; padding: 36px 20px;">
        <h3>Ready to Plan Your Kit & Budget?</h3>
        <p style="color: #64748b; max-width: 500px; margin: 8px auto 20px auto;">
            Explore our curated student kits designed specifically for your university destination.
        </p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/Kits/FindMyKit" class="dk-btn dk-btn-primary">Find My Destination Kit</a>
            <a href="/Consultancy" class="dk-btn dk-btn-outline">Book Free 1-on-1 Consultation</a>
        </div>
    </div>
</div>
