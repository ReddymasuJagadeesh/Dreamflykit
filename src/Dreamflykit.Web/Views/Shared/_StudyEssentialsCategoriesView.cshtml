<!-- ========================================================
     CLIENT-SIDE INTERACTIVE FILTERING SCRIPT
========================================================= -->
<script>
    function filterBySubItem(subItem) {
        const cleanSub = (subItem || "").trim().toLowerCase();
        
        // 1. Update Left Sidebar active state
        document.querySelectorAll(".dk-cat-sub-link").forEach(link => {
            const itemVal = (link.dataset.subitem || "").trim().toLowerCase();
            if (cleanSub === "") {
                link.classList.toggle("is-active", itemVal === "");
            } else {
                link.classList.toggle("is-active", itemVal === cleanSub);
            }
        });

        // 2. Filter product cards on the right side
        const cards = document.querySelectorAll(".dk-cat-prod-card");
        let visibleCount = 0;

        cards.forEach(card => {
            if (cleanSub === "") {
                card.style.display = "";
                visibleCount++;
            } else {
                const tags = (card.dataset.subcatTags || "").toLowerCase();
                const title = (card.dataset.title || "").toLowerCase();
                const desc = (card.dataset.desc || "").toLowerCase();

                // Check match with subItem words
                const subWords = cleanSub.split(/[\s,]+/);
                let matches = false;
                if (tags.includes(cleanSub) || title.includes(cleanSub) || desc.includes(cleanSub)) {
                    matches = true;
                } else {
                    // Check if multiple key words match
                    const matchCount = subWords.filter(w => w.length > 2 && (tags.includes(w) || title.includes(w) || desc.includes(w))).length;
                    if (matchCount >= 1) matches = true;
                }

                if (matches) {
                    card.style.display = "";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            }
        });

        // 3. Update count and active chip
        const countEl = document.getElementById("dkCatProdCount");
        if (countEl) {
            countEl.textContent = visibleCount + " Products";
        }

        const chipWrap = document.getElementById("dkCatActiveChipWrap");
        const chipText = document.getElementById("dkCatActiveChipText");
        if (chipWrap && chipText) {
            if (cleanSub !== "") {
                chipText.textContent = subItem;
                chipWrap.style.display = "inline-flex";
            } else {
                chipWrap.style.display = "none";
            }
        }

        // 4. Update empty state visibility
        const emptyState = document.getElementById("dkCatSubEmptyState");
        const prodGrid = document.querySelector(".dk-cat-products-grid");
        if (emptyState && prodGrid) {
            if (visibleCount === 0) {
                prodGrid.style.display = "none";
                emptyState.style.display = "block";
            } else {
                prodGrid.style.display = "grid";
                emptyState.style.display = "none";
            }
        }

        // 5. Update browser URL without reload
        const url = new URL(window.location.href);
        if (cleanSub !== "") {
            url.searchParams.set("subcatItem", subItem);
        } else {
            url.searchParams.delete("subcatItem");
        }
        window.history.pushState(null, '', url.toString());
    }

    // Initialize filter if subcatItem is in URL on page load
    document.addEventListener("DOMContentLoaded", function () {
        const urlParams = new URLSearchParams(window.location.search);
        const subItem = urlParams.get("subcatItem");
        if (subItem) {
            filterBySubItem(subItem);
        }
    });
</script>