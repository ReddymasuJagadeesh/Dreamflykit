async function uploadRowImage(input, type) {

    if (!input.files || input.files.length === 0) return;

    const file = input.files[0];

    const formData = new FormData();

    formData.append("file", file);

    formData.append("targetField", type);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

    formData.append("__RequestVerificationToken", token);



    showAlert(`Uploading image for ${type}...`, "info");



    try {

        const res = await fetch("/Admin/FashionHub/UploadImage", {

            method: "POST",

            body: formData

        });

        const data = await res.json();

        if (data.success && data.url) {

            const row = input.closest(".dk-item-row");

            if (type === "category") {

                const img = row.querySelector(".cat-thumb-preview");

                if (img) img.src = data.url;

                const url = row.querySelector(".cat-image-url");

                if (url) url.value = data.url;

                const soon = row.querySelector(".cat-soon");

                if (soon) soon.checked = false;

            } else if (type === "fit") {

                const img = row.querySelector(".fit-thumb-preview");

                if (img) img.src = data.url;

                const url = row.querySelector(".fit-img-url");

                if (url) url.value = data.url;

                const soon = row.querySelector(".fit-soon");

                if (soon) soon.checked = false;

            } else if (type === "style") {

                const img = row.querySelector(".style-thumb-preview");

                if (img) img.src = data.url;

                const url = row.querySelector(".style-img-url");

                if (url) url.value = data.url;

                const soon = row.querySelector(".style-soon");

                if (soon) soon.checked = false;

            } else {

                const img = row.querySelector(".prod-thumb-preview");

                if (img) img.src = data.url;

                const url = row.querySelector(".prod-image-url");

                if (url) url.value = data.url;

                const soon = row.querySelector(".prod-soon");

                if (soon) soon.checked = false;

            }

            showAlert("Image uploaded! Remember to Save Changes.", "success");

        } else {

            showAlert("Upload failed: " + (data.message || "Unknown error"), "error");

        }

    } catch (err) {

        showAlert("Upload error: " + err.message, "error");

    }

}



async function uploadTargetField(input, targetField, targetInputId, targetPreviewId, targetSoonId) {

    if (!input.files || input.files.length === 0) return;

    const file = input.files[0];

    const formData = new FormData();

    formData.append("file", file);

    formData.append("targetField", targetField);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

    formData.append("__RequestVerificationToken", token);



    showAlert(`Uploading image for ${targetField}...`, "info");

    try {

        const res = await fetch("/Admin/FashionHub/UploadImage", {

            method: "POST",

            body: formData

        });

        const data = await res.json();

        if (data.success && data.url) {

            if (targetInputId) {

                const el = document.getElementById(targetInputId);

                if (el) el.value = data.url;

            }

            if (targetPreviewId) {

                const el = document.getElementById(targetPreviewId);

                if (el) el.src = data.url;

            }

            if (targetSoonId) {

                const el = document.getElementById(targetSoonId);

                if (el) el.checked = false;

            }

            showAlert("Image uploaded! Remember to click Save All Changes.", "success");

        } else {

            showAlert("Upload failed: " + (data.message || "Unknown error"), "error");

        }

    } catch (err) {

        showAlert("Upload error: " + err.message, "error");

    }

}



