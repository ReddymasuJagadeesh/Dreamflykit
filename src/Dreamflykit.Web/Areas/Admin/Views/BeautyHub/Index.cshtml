        });
    });

    // Collect Her Cards
    document.querySelectorAll('#herCardsList .her-card-item').forEach(card => {
        payload.specialGiftsForHer.cards.push({
            id: card.getAttribute('data-id'),
            offerTag: card.querySelector('.her-tag')?.value || '',
            title: card.querySelector('.her-title')?.value || '',
            imageUrl: card.querySelector('.her-img')?.value || '',
