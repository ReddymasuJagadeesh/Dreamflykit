<!-- Client-side Interactive Filter Script -->
<script>
    function gmToggleDropdown(btn) {
        var pill = btn.closest('.gm-dropdown-pill');
        var wasOpen = pill.classList.contains('open');
        document.querySelectorAll('.gm-dropdown-pill').forEach(function(p) { p.classList.remove('open'); });
        if (!wasOpen) {
            pill.classList.add('open');
        }
    }

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.gm-dropdown-pill')) {
            document.querySelectorAll('.gm-dropdown-pill').forEach(function(p) { p.classList.remove('open'); });
        }
    });

    var activePillFilters = {
        condition: 'all',
        compat: 'all',
        brand: 'all',
        storage: 'all',
        sort: 'popularity'
    };

    function gmApplyPillFilter(group, value, elem) {
        activePillFilters[group] = value;
        var pill = elem.closest('.gm-dropdown-pill');
        if (pill) {
            var btn = pill.querySelector('.gm-pill-btn span');
            if (btn && value !== 'all') {
                btn.textContent = value;
                pill.querySelector('.gm-pill-btn').classList.add('active');
            } else if (btn) {
                // Restore group label
                var grpName = group.charAt(0).toUpperCase() + group.slice(1);
                if (group === 'compat') grpName = 'Compatibility';
                btn.textContent = grpName;
                pill.querySelector('.gm-pill-btn').classList.remove('active');
            }
            pill.classList.remove('open');
        }
        gmRunFilters();
    }

    function gmApplySort(sortVal, label) {
        activePillFilters.sort = sortVal;
        var sortLabel = document.getElementById('gmSortLabel');
        if (sortLabel) sortLabel.textContent = 'Sort by : ' + label;
        var pill = document.querySelector('.gm-sort-pill');
        if (pill) pill.classList.remove('open');
        gmRunSort();
    }

    function gmRunFilters() {
        var cards = document.querySelectorAll('.gm-prod-card');
        var visibleCount = 0;

        // Facet checkboxes
        var condCheckboxes = Array.from(document.querySelectorAll('.gm-filter-checkbox[data-facet="condition"]:checked')).map(function(c) { return c.value; });
        var stockCheckboxes = Array.from(document.querySelectorAll('.gm-filter-checkbox[data-facet="stock"]:checked')).map(function(c) { return c.value; });

        // Rating radio
        var ratingRadio = document.querySelector('input[name="rating_filter"]:checked');
        var minRating = ratingRadio ? parseFloat(ratingRadio.value) : 0;

        // Price range
        var minPriceInput = document.getElementById('gmMinPriceInput');
        var maxPriceInput = document.getElementById('gmMaxPriceInput');
        var minP = minPriceInput ? parseFloat(minPriceInput.value || '0') : 0;
        var maxP = maxPriceInput ? parseFloat(maxPriceInput.value || '9999999') : 9999999;

        cards.forEach(function (card) {
            var brand = (card.getAttribute('data-brand') || '').trim();
            var cond = (card.getAttribute('data-condition') || '').trim();
            var price = parseFloat(card.getAttribute('data-price') || '0');
            var rating = parseFloat(card.getAttribute('data-rating') || '0');
            var stock = (card.getAttribute('data-stock') || '').trim();
            var title = (card.getAttribute('data-title') || '').toLowerCase();

            var matches = true;

            // Pill filters
            if (activePillFilters.condition !== 'all' && !cond.toLowerCase().includes(activePillFilters.condition.toLowerCase())) {
                matches = false;
            }
            if (activePillFilters.brand !== 'all' && !brand.toLowerCase().includes(activePillFilters.brand.toLowerCase())) {
                matches = false;
            }
            if (activePillFilters.compat !== 'all' && !title.includes(activePillFilters.compat.toLowerCase())) {
                matches = false;
            }
            if (activePillFilters.storage !== 'all' && !title.includes(activePillFilters.storage.toLowerCase())) {
                matches = false;
            }

            // Facet condition
            if (condCheckboxes.length > 0 && !condCheckboxes.includes(cond)) {
                matches = false;
            }

            // Facet stock
            if (stockCheckboxes.length > 0 && !stockCheckboxes.includes(stock)) {
                matches = false;
            }

            // Price
            if (price < minP || price > maxP) {
                matches = false;
            }

            // Rating
            if (rating < minRating) {
                matches = false;
            }

            if (matches) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        var countElem = document.getElementById('gmResultsCount');
        if (countElem) {
            countElem.textContent = 'Showing ' + visibleCount + ' results for @subPage.CategoryName';
        }
    }

    function gmRunSort() {
        var grid = document.getElementById('gmProductsGrid');
        if (!grid) return;
        var cards = Array.from(grid.querySelectorAll('.gm-prod-card'));

        cards.sort(function (a, b) {
            var pA = parseFloat(a.getAttribute('data-price') || '0');
            var pB = parseFloat(b.getAttribute('data-price') || '0');
            var rA = parseFloat(a.getAttribute('data-rating') || '0');
            var rB = parseFloat(b.getAttribute('data-rating') || '0');

            if (activePillFilters.sort === 'price-asc') return pA - pB;
            if (activePillFilters.sort === 'price-desc') return pB - pA;
            if (activePillFilters.sort === 'rating') return rB - rA;
            return 0; // default order
        });

        cards.forEach(function (c) { grid.appendChild(c); });
    }

    function gmResetAllFilters() {
        document.querySelectorAll('.gm-filter-checkbox').forEach(function(c) { c.checked = true; });
        var minP = document.getElementById('gmMinPriceInput');
        var maxP = document.getElementById('gmMaxPriceInput');
        if (minP) minP.value = 0;
        if (maxP) maxP.value = 100000;
        var rAll = document.querySelector('input[name="rating_filter"][value="0"]');
        if (rAll) rAll.checked = true;

        activePillFilters = {
            condition: 'all',
            compat: 'all',
            brand: 'all',
            storage: 'all',
            sort: 'popularity'
        };

        document.querySelectorAll('.gm-pill-btn').forEach(function(b) { b.classList.remove('active'); });
        var sortLabel = document.getElementById('gmSortLabel');
        if (sortLabel) sortLabel.textContent = 'Sort by : Popularity';

        gmRunFilters();
    }
</script>
