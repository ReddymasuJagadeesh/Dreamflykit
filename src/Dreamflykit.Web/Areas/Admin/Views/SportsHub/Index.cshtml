                TitleHighlight: pageEl.querySelector('.page-hero-badge').value,
                Subtitle: pageEl.querySelector('.page-hero-sub').value,
                ImageUrl: pageEl.querySelector('.page-hero-img').value,
                IsUploadingSoon: pageEl.querySelector('.page-hero-uploading').checked,
                BannerHeight: 280
            };

            var pageSubcatsRaw = pageEl.querySelector('.page-subcategories')?.value || '';
            var pageSubcatsList = pageSubcatsRaw.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
            var pageNote = pageEl.querySelector('.page-note')?.value || '';

            var pageProducts = [];
            pageEl.querySelectorAll('[data-prod-card]').forEach(function (pCard) {
                var sizesRaw = pCard.querySelector('.prod-sizes').value || '';
                var sizesList = sizesRaw.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });

                pageProducts.push({
                    Id: pCard.querySelector('.prod-id').value,
