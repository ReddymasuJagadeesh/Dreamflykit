@model Dreamflykit.Application.StoryBooksHub.Models.StoryBooksHubDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Story Books & BooksFlix Hub Management";
    var hub = Model ?? Dreamflykit.Application.StoryBooksHub.Models.StoryBooksHubDto.CreateDefault();
    var theme = hub.ThemeSettings ?? new();
    var billboard = hub.HeroBillboard ?? new();
    var sbBanner = hub.StoryBooksBanner ?? new();
    var npBanner = hub.NewPopularBanner ?? new();
    var langBanner = hub.LanguagesBanner ?? new();
    var sections = hub.Sections ?? new();
    var genres = hub.Genres ?? new();
    var languages = hub.Languages ?? new();
    var preferences = hub.Preferences ?? new();
}

@Html.AntiForgeryToken()

<div class="dk-admin-content-container" style="max-width: 1400px; margin: 0 auto; padding: 24px 20px;">

    <!-- TOP HEADER & CONTROLS -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <span style="background: #ea580c; color: #ffffff; font-size: 11px; font-weight: 900; padding: 4px 10px; border-radius: 4px; letter-spacing: 1px;">📚 BOOKSFLIX ADMIN</span>
                <span style="background: #eff6ff; color: #034694; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; border: 1px solid #bfdbfe;">DREAMFLYKIT THEME</span>
            </div>
            <h1 style="font-size: 26px; font-weight: 900; color: #0f172a; margin: 0;">Story Books &amp; Literary Journals Management</h1>
            <p style="font-size: 13.5px; color: #64748b; margin: 4px 0 0 0;">
                Full administrative control over all 4 Tab Hero Banners, Journal dropdown options, book shelves, regional languages, and image uploads.
            </p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a href="/category/story-books" target="_blank" class="dk-btn" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 10px 18px; font-size: 13.5px; font-weight: 700; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <span>👁️</span> Preview Live Store
            </a>
            <form asp-action="ResetDefaults" method="post" style="display: inline;" onsubmit="return confirm('Reset all Story Books Hub settings to default BooksFlix template?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="dk-btn" style="background: #fff; color: #dc2626; border: 1px solid #fca5a5; padding: 10px 16px; font-size: 13px; font-weight: 700; border-radius: 8px; cursor: pointer;">
                    ↺ Reset Defaults
                </button>
            </form>
            <button type="button" class="dk-btn" id="btnSaveStoryBooksTop" onclick="saveStoryBooksHubConfig()" style="background: #ea580c; color: #ffffff; border: none; padding: 11px 26px; font-size: 14px; font-weight: 800; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Save All Changes
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #ecfdf5; border-left: 4px solid #10b981; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; color: #065f46; font-weight: 600;">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    <!-- TAB BUTTONS -->
    <div style="display: flex; gap: 8px; border-bottom: 2px solid #e2e8f0; margin-bottom: 24px; overflow-x: auto; padding-bottom: 4px;">
        <button type="button" class="dk-hub-tab-btn active" onclick="switchSbfAdminTab('billboards', this)">
            🎬 1. Tab Hero Banners (All 4 Tabs)
        </button>
        <button type="button" class="dk-hub-tab-btn" onclick="switchSbfAdminTab('sections', this)">
            📚 2. Shelves &amp; Book Collections (@sections.Count Shelves)
        </button>
        <button type="button" class="dk-hub-tab-btn" onclick="switchSbfAdminTab('genres', this)">
            📖 3. Genres &amp; Journals Dropdown (@genres.Count)
        </button>
        <button type="button" class="dk-hub-tab-btn" onclick="switchSbfAdminTab('languages', this)">
            🌐 4. Browse by Languages &amp; Preferences (@languages.Count Langs)
        </button>
        <button type="button" class="dk-hub-tab-btn" onclick="switchSbfAdminTab('theme', this)">
            🎨 5. Netflix Theme Settings
        </button>
    </div>

    <!-- ========================================================
         TAB 1: TAB HERO BANNERS (ALL 4 TABS)
    ========================================================= -->
    <div class="sbf-admin-tab-pane active" id="pane-billboards">

        <!-- 1.1 HOME TAB HERO BILLBOARD -->
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">1. Home Tab: Hero Billboard</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Full-width cinematic hero spotlight shown on Home tab.</p>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" id="billboard_IsEnabled" @(billboard.IsEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #ea580c;" />
                    Enabled
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Title</label>
                            <input type="text" id="billboard_Title" class="sbf-input" value="@billboard.Title" />
                        </div>
                        <div>
                            <label class="sbf-label">Author / Creator</label>
                            <input type="text" id="billboard_Author" class="sbf-input" value="@billboard.Author" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Top Badge Label</label>
                            <input type="text" id="billboard_TagBadge" class="sbf-input" value="@billboard.TagBadge" />
                        </div>
                        <div>
                            <label class="sbf-label">Genre &amp; Meta Tags</label>
                            <input type="text" id="billboard_GenreTags" class="sbf-input" value="@billboard.GenreTags" />
                        </div>
                    </div>

                    <div>
                        <label class="sbf-label">Synopsis / Description</label>
                        <textarea id="billboard_Synopsis" class="sbf-input" rows="2">@billboard.Synopsis</textarea>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;">
                        <div>
                            <label class="sbf-label">Price (₹)</label>
                            <input type="number" id="billboard_Price" class="sbf-input" value="@billboard.Price" />
                        </div>
                        <div>
                            <label class="sbf-label">Original Price (₹)</label>
                            <input type="number" id="billboard_OriginalPrice" class="sbf-input" value="@billboard.OriginalPrice" />
                        </div>
                        <div>
                            <label class="sbf-label">Discount %</label>
                            <input type="number" id="billboard_DiscountPercent" class="sbf-input" value="@billboard.DiscountPercent" />
                        </div>
                        <div>
                            <label class="sbf-label">Rating (1-5)</label>
                            <input type="number" step="0.1" id="billboard_Rating" class="sbf-input" value="@billboard.Rating" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Button Text</label>
                            <input type="text" id="billboard_PrimaryButtonText" class="sbf-input" value="@billboard.PrimaryButtonText" />
                        </div>
                        <div>
                            <label class="sbf-label">Secondary Button Text</label>
                            <input type="text" id="billboard_SecondaryButtonText" class="sbf-input" value="@billboard.SecondaryButtonText" />
                        </div>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                    <div style="width: 100%; aspect-ratio: 16/9; background: #0f172a; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                        <img id="billboard_ImgPreview" src="@billboard.ImageUrl" alt="Home Banner Preview" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                        <div id="billboard_UploadingSoonTag" style="position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,0.8); color: #fff; font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 4px; @(billboard.IsUploadingSoon ? "" : "display: none;")">
                            Uploading Soon
                        </div>
                    </div>

                    <div style="width: 100%; margin-bottom: 12px;">
                        <label class="sbf-label">Banner Image URL</label>
                        <input type="text" id="billboard_ImageUrl" class="sbf-input" value="@billboard.ImageUrl" onchange="document.getElementById('billboard_ImgPreview').src = this.value;" />
                    </div>

                    <div style="width: 100%; margin-bottom: 12px;">
                        <input type="file" id="billboard_File" accept="image/*" style="display: none;" onchange="uploadImageDirect(this, 'billboard_ImageUrl', 'billboard_ImgPreview')" />
                        <button type="button" class="dk-btn" onclick="document.getElementById('billboard_File').click();" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                            📁 Upload Home Banner Image
                        </button>
                    </div>

                    <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                        <input type="checkbox" id="billboard_IsUploadingSoon" @(billboard.IsUploadingSoon ? "checked" : "") onchange="document.getElementById('billboard_UploadingSoonTag').style.display = this.checked ? 'block' : 'none';" style="accent-color: #ea580c;" />
                        Mark as "Uploading Soon" (Admin Replaceable)
                    </label>
                </div>
            </div>
        </div>

        <!-- 1.2 STORY BOOKS TAB HERO BANNER -->
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">2. Story Books Tab: Hero Banner</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Full-width hero banner shown on Story Books tab (and updates on journal selection).</p>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" id="sbBanner_IsEnabled" @(sbBanner.IsEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #ea580c;" />
                    Enabled
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <label class="sbf-label">Title</label>
                        <input type="text" id="sbBanner_Title" class="sbf-input" value="@sbBanner.Title" />
                    </div>
                    <div>
                        <label class="sbf-label">Top Badge Label</label>
                        <input type="text" id="sbBanner_TagBadge" class="sbf-input" value="@sbBanner.TagBadge" />
                    </div>
                    <div>
                        <label class="sbf-label">Meta Tags Line</label>
                        <input type="text" id="sbBanner_MetaTags" class="sbf-input" value="@sbBanner.MetaTags" />
                    </div>
                    <div>
                        <label class="sbf-label">Subtitle / Synopsis</label>
                        <textarea id="sbBanner_Subtitle" class="sbf-input" rows="2">@sbBanner.Subtitle</textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Button Text</label>
                            <input type="text" id="sbBanner_PrimaryButtonText" class="sbf-input" value="@sbBanner.PrimaryButtonText" />
                        </div>
                        <div>
                            <label class="sbf-label">Secondary Button Text</label>
                            <input type="text" id="sbBanner_SecondaryButtonText" class="sbf-input" value="@sbBanner.SecondaryButtonText" />
                        </div>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                    <div style="width: 100%; aspect-ratio: 16/9; background: #0f172a; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                        <img id="sbBanner_ImgPreview" src="@sbBanner.ImageUrl" alt="Story Books Banner Preview" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <label class="sbf-label">Banner Image URL</label>
                        <input type="text" id="sbBanner_ImageUrl" class="sbf-input" value="@sbBanner.ImageUrl" onchange="document.getElementById('sbBanner_ImgPreview').src = this.value;" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <input type="file" id="sbBanner_File" accept="image/*" style="display: none;" onchange="uploadImageDirect(this, 'sbBanner_ImageUrl', 'sbBanner_ImgPreview')" />
                        <button type="button" class="dk-btn" onclick="document.getElementById('sbBanner_File').click();" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                            📁 Upload Story Books Banner Image
                        </button>
                    </div>
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                        <input type="checkbox" id="sbBanner_IsUploadingSoon" @(sbBanner.IsUploadingSoon ? "checked" : "") style="accent-color: #ea580c;" />
                        Mark as "Uploading Soon" (Admin Replaceable)
                    </label>
                </div>
            </div>
        </div>

        <!-- 1.3 NEW & POPULAR TAB HERO BANNER -->
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">3. New &amp; Popular Tab: Hero Banner</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Full-width hero banner shown on New &amp; Popular tab.</p>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" id="npBanner_IsEnabled" @(npBanner.IsEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #ea580c;" />
                    Enabled
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <label class="sbf-label">Title</label>
                        <input type="text" id="npBanner_Title" class="sbf-input" value="@npBanner.Title" />
                    </div>
                    <div>
                        <label class="sbf-label">Top Badge Label</label>
                        <input type="text" id="npBanner_TagBadge" class="sbf-input" value="@npBanner.TagBadge" />
                    </div>
                    <div>
                        <label class="sbf-label">Meta Tags Line</label>
                        <input type="text" id="npBanner_MetaTags" class="sbf-input" value="@npBanner.MetaTags" />
                    </div>
                    <div>
                        <label class="sbf-label">Subtitle / Synopsis</label>
                        <textarea id="npBanner_Subtitle" class="sbf-input" rows="2">@npBanner.Subtitle</textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Button Text</label>
                            <input type="text" id="npBanner_PrimaryButtonText" class="sbf-input" value="@npBanner.PrimaryButtonText" />
                        </div>
                        <div>
                            <label class="sbf-label">Secondary Button Text</label>
                            <input type="text" id="npBanner_SecondaryButtonText" class="sbf-input" value="@npBanner.SecondaryButtonText" />
                        </div>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                    <div style="width: 100%; aspect-ratio: 16/9; background: #0f172a; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                        <img id="npBanner_ImgPreview" src="@npBanner.ImageUrl" alt="New Popular Banner Preview" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <label class="sbf-label">Banner Image URL</label>
                        <input type="text" id="npBanner_ImageUrl" class="sbf-input" value="@npBanner.ImageUrl" onchange="document.getElementById('npBanner_ImgPreview').src = this.value;" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <input type="file" id="npBanner_File" accept="image/*" style="display: none;" onchange="uploadImageDirect(this, 'npBanner_ImageUrl', 'npBanner_ImgPreview')" />
                        <button type="button" class="dk-btn" onclick="document.getElementById('npBanner_File').click();" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                            📁 Upload New &amp; Popular Banner Image
                        </button>
                    </div>
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                        <input type="checkbox" id="npBanner_IsUploadingSoon" @(npBanner.IsUploadingSoon ? "checked" : "") style="accent-color: #ea580c;" />
                        Mark as "Uploading Soon" (Admin Replaceable)
                    </label>
                </div>
            </div>
        </div>

        <!-- 1.4 BROWSE BY LANGUAGE TAB HERO BANNER -->
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">4. Browse by Language Tab: Hero Banner</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Full-width hero banner shown on Browse by Language tab.</p>
                </div>
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" id="langBanner_IsEnabled" @(langBanner.IsEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #ea580c;" />
                    Enabled
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <label class="sbf-label">Title</label>
                        <input type="text" id="langBanner_Title" class="sbf-input" value="@langBanner.Title" />
                    </div>
                    <div>
                        <label class="sbf-label">Top Badge Label</label>
                        <input type="text" id="langBanner_TagBadge" class="sbf-input" value="@langBanner.TagBadge" />
                    </div>
                    <div>
                        <label class="sbf-label">Meta Tags Line</label>
                        <input type="text" id="langBanner_MetaTags" class="sbf-input" value="@langBanner.MetaTags" />
                    </div>
                    <div>
                        <label class="sbf-label">Subtitle / Synopsis</label>
                        <textarea id="langBanner_Subtitle" class="sbf-input" rows="2">@langBanner.Subtitle</textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Button Text</label>
                            <input type="text" id="langBanner_PrimaryButtonText" class="sbf-input" value="@langBanner.PrimaryButtonText" />
                        </div>
                        <div>
                            <label class="sbf-label">Secondary Button Text</label>
                            <input type="text" id="langBanner_SecondaryButtonText" class="sbf-input" value="@langBanner.SecondaryButtonText" />
                        </div>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                    <div style="width: 100%; aspect-ratio: 16/9; background: #0f172a; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                        <img id="langBanner_ImgPreview" src="@langBanner.ImageUrl" alt="Languages Banner Preview" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <label class="sbf-label">Banner Image URL</label>
                        <input type="text" id="langBanner_ImageUrl" class="sbf-input" value="@langBanner.ImageUrl" onchange="document.getElementById('langBanner_ImgPreview').src = this.value;" />
                    </div>
                    <div style="width: 100%; margin-bottom: 12px;">
                        <input type="file" id="langBanner_File" accept="image/*" style="display: none;" onchange="uploadImageDirect(this, 'langBanner_ImageUrl', 'langBanner_ImgPreview')" />
                        <button type="button" class="dk-btn" onclick="document.getElementById('langBanner_File').click();" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                            📁 Upload Languages Banner Image
                        </button>
                    </div>
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                        <input type="checkbox" id="langBanner_IsUploadingSoon" @(langBanner.IsUploadingSoon ? "checked" : "") style="accent-color: #ea580c;" />
                        Mark as "Uploading Soon" (Admin Replaceable)
                    </label>
                </div>
            </div>
        </div>

    </div>

    <!-- ========================================================
         TAB 2: SHELVES & BOOK COLLECTIONS
    ========================================================= -->
    <div class="sbf-admin-tab-pane" id="pane-sections">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <p style="margin: 0; font-size: 14px; color: #64748b;">
                Manage horizontal carousel shelves, Top 10 rankings, book covers, and pricing.
            </p>
            <button type="button" class="dk-btn" onclick="addNewSectionPrompt()" style="background: #10b981; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                + Add New Shelf Section
            </button>
        </div>

        <div id="sbf-sections-container">
            @for (int sIdx = 0; sIdx < sections.Count; sIdx++)
            {
                var sec = sections[sIdx];
                <div class="sbf-section-card" data-sec-idx="@sIdx" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="background: #f1f5f9; color: #334155; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 4px;">SHELF #@(sIdx + 1)</span>
                            <input type="text" class="sbf-input sec-title" value="@sec.Title" style="font-size: 16px; font-weight: 800; width: 320px;" placeholder="Shelf Title" />
                            <input type="text" class="sbf-input sec-sub" value="@sec.Subtitle" style="font-size: 13px; width: 280px;" placeholder="Shelf Subtitle (Optional)" />
                        </div>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <select class="sbf-input sec-type" style="width: 160px; font-weight: 600;">
                                <option value="standard" selected="@(sec.DisplayType == "standard")">Standard Shelf</option>
                                <option value="top10" selected="@(sec.DisplayType == "top10")">Top 10 Shelf (Giant #s)</option>
                                <option value="continue-reading" selected="@(sec.DisplayType == "continue-reading")">Continue Reading</option>
                            </select>
                            <label style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; cursor: pointer;">
                                <input type="checkbox" class="sec-active" @(sec.IsActive ? "checked" : "") style="accent-color: #ea580c;" /> Active
                            </label>
                            <button type="button" onclick="removeSection(this)" style="background: none; border: none; color: #dc2626; font-size: 16px; cursor: pointer;" title="Delete Shelf">✕</button>
                        </div>
                    </div>

                    <!-- Books inside this shelf -->
                    <div style="border-top: 1px solid #f1f5f9; padding-top: 14px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <span style="font-size: 13px; font-weight: 700; color: #475569;">Books in this Shelf (<span class="books-count">@sec.Books.Count</span>)</span>
                            <button type="button" class="dk-btn" onclick="addBookToSection(this)" style="background: #f1f5f9; color: #0284c7; border: 1px solid #cbd5e1; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 700; cursor: pointer;">
                                + Add Book to Shelf
                            </button>
                        </div>

                        <div class="sbf-books-editor-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px;">
                            @foreach (var book in sec.Books)
                            {
                                <div class="sbf-book-editor-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; position: relative;">
                                    <button type="button" onclick="removeBookCard(this)" style="position: absolute; top: 8px; right: 8px; background: none; border: none; color: #dc2626; font-size: 14px; cursor: pointer;" title="Remove Book">✕</button>

                                    <div style="display: flex; gap: 10px; margin-bottom: 8px;">
                                        <div style="width: 60px; aspect-ratio: 2/3; background: #0f172a; border-radius: 4px; overflow: hidden; position: relative; flex-shrink: 0;">
                                            <img class="book-cover-preview" src="@book.CoverImageUrl" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg'" />
                                        </div>
                                        <div style="flex-grow: 1; min-width: 0;">
                                            <input type="text" class="sbf-input book-title" value="@book.Title" placeholder="Book Title" style="font-weight: 700; font-size: 13px; margin-bottom: 4px;" />
                                            <input type="text" class="sbf-input book-author" value="@book.Author" placeholder="Author" style="font-size: 12px; margin-bottom: 4px;" />
                                            <input type="hidden" class="book-id" value="@book.Id" />
                                        </div>
                                    </div>

                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 6px;">
                                        <div>
                                            <label class="sbf-label-sm">Price (₹)</label>
                                            <input type="number" class="sbf-input book-price" value="@book.Price" style="font-size: 12px;" />
                                        </div>
                                        <div>
                                            <label class="sbf-label-sm">Original Price (₹)</label>
                                            <input type="number" class="sbf-input book-orig-price" value="@book.OriginalPrice" style="font-size: 12px;" />
                                        </div>
                                    </div>

                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 6px;">
                                        <div>
                                            <label class="sbf-label-sm">Genre</label>
                                            <input type="text" class="sbf-input book-genre-slug" value="@book.GenreSlug" style="font-size: 11px;" placeholder="genre-slug" />
                                        </div>
                                        <div>
                                            <label class="sbf-label-sm">Language</label>
                                            <input type="text" class="sbf-input book-lang" value="@book.Language" style="font-size: 11px;" placeholder="Language" />
                                        </div>
                                    </div>

                                    <div style="margin-bottom: 6px;">
                                        <label class="sbf-label-sm">Cover Image URL</label>
                                        <input type="text" class="sbf-input book-cover-url" value="@book.CoverImageUrl" style="font-size: 11px;" onchange="this.closest('.sbf-book-editor-card').querySelector('.book-cover-preview').src = this.value;" />
                                    </div>

                                    <div style="display: flex; gap: 6px; align-items: center; justify-content: space-between;">
                                        <input type="file" accept="image/*" style="display: none;" onchange="uploadBookCardImage(this)" />
                                        <button type="button" onclick="this.previousElementSibling.click();" style="background: #e2e8f0; border: none; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer;">
                                            Upload Cover
                                        </button>
                                        <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; cursor: pointer;">
                                            <input type="checkbox" class="book-uploading-soon" @(book.IsUploadingSoon ? "checked" : "") style="accent-color: #ea580c;" />
                                            Uploading Soon
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ========================================================
         TAB 3: GENRES & JOURNALS DROPDOWN
    ========================================================= -->
    <div class="sbf-admin-tab-pane" id="pane-genres">
        <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">Genres &amp; Journals Dropdown Options</h3>
                    <p style="margin: 4px 0 0 0; font-size: 13px; color: #64748b;">
                        These items populate the "Journal / Category" selector below the store navigation bar.
                    </p>
                </div>
                <button type="button" class="dk-btn" onclick="addNewGenreRow()" style="background: #0284c7; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 700; cursor: pointer;">
                    + Add Genre / Journal
                </button>
            </div>

            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13.5px;" id="sbf-genres-table">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 10px 12px;">Emoji</th>
                            <th style="padding: 10px 12px;">Display Name</th>
                            <th style="padding: 10px 12px;">URL Slug (Unique)</th>
                            <th style="padding: 10px 12px; width: 60px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var genre in genres)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;" class="genre-row">
                                <td style="padding: 8px 12px;">
                                    <input type="text" class="sbf-input genre-emoji" value="@genre.Emoji" style="width: 60px; text-align: center;" />
                                </td>
                                <td style="padding: 8px 12px;">
                                    <input type="text" class="sbf-input genre-name" value="@genre.Name" style="width: 100%;" />
                                </td>
                                <td style="padding: 8px 12px;">
                                    <input type="text" class="sbf-input genre-slug" value="@genre.Slug" style="width: 100%;" />
                                </td>
                                <td style="padding: 8px 12px; text-align: center;">
                                    <button type="button" onclick="this.closest('tr').remove()" style="background: none; border: none; color: #dc2626; font-size: 16px; cursor: pointer;">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========================================================
         TAB 4: LANGUAGES & PREFERENCES
    ========================================================= -->
    <div class="sbf-admin-tab-pane" id="pane-languages">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <!-- Supported Languages Table -->
            <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0; font-size: 17px; font-weight: 800; color: #0f172a;">Supported Languages</h3>
                    <button type="button" class="dk-btn" onclick="addNewLangRow()" style="background: #0284c7; color: #fff; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">
                        + Add Language
                    </button>
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 13px;" id="sbf-langs-table">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 8px;">Code</th>
                            <th style="padding: 8px;">Name (English)</th>
                            <th style="padding: 8px;">Native Label</th>
                            <th style="padding: 8px; width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lang in languages)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;" class="lang-row">
                                <td style="padding: 6px 8px;">
                                    <input type="text" class="sbf-input lang-code" value="@lang.Code" style="width: 60px;" />
                                </td>
                                <td style="padding: 6px 8px;">
                                    <input type="text" class="sbf-input lang-name" value="@lang.Name" style="width: 100%;" />
                                </td>
                                <td style="padding: 6px 8px;">
                                    <input type="text" class="sbf-input lang-native" value="@lang.NativeLabel" style="width: 100%;" />
                                </td>
                                <td style="padding: 6px 8px; text-align: center;">
                                    <button type="button" onclick="this.closest('tr').remove()" style="background: none; border: none; color: #dc2626; cursor: pointer;">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Edition Preferences Table -->
            <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0; font-size: 17px; font-weight: 800; color: #0f172a;">Edition Preferences</h3>
                    <button type="button" class="dk-btn" onclick="addNewPrefRow()" style="background: #0284c7; color: #fff; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">
                        + Add Preference
                    </button>
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 13px;" id="sbf-prefs-table">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 8px;">Key</th>
                            <th style="padding: 8px;">Display Label</th>
                            <th style="padding: 8px; width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pref in preferences)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;" class="pref-row">
                                <td style="padding: 6px 8px;">
                                    <input type="text" class="sbf-input pref-key" value="@pref.Key" style="width: 100%;" />
                                </td>
                                <td style="padding: 6px 8px;">
                                    <input type="text" class="sbf-input pref-label" value="@pref.Label" style="width: 100%;" />
                                </td>
                                <td style="padding: 6px 8px; text-align: center;">
                                    <button type="button" onclick="this.closest('tr').remove()" style="background: none; border: none; color: #dc2626; cursor: pointer;">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========================================================
         TAB 5: MODERN BRAND & VISUAL THEME STUDIO
    ========================================================= -->
    <div class="sbf-admin-tab-pane" id="pane-theme">
        <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 24px; align-items: start;">
            <!-- Left Column: Controls & Presets -->
            <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                    <div>
                        <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">Brand &amp; Visual Theme Settings</h3>
                        <p style="margin: 4px 0 0 0; font-size: 13px; color: #64748b;">Configure brand colors, page background, card styles, and contrast safety.</p>
                    </div>
                    <span style="background: #eff6ff; color: #034694; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 6px; border: 1px solid #bfdbfe;">
                        WCAG 2.1 Compliant
                    </span>
                </div>

                <div style="display: flex; flex-direction: column; gap: 18px;">
                    <!-- 1-Click Brand Theme Presets -->
                    <div>
                        <label class="sbf-label" style="margin-bottom: 8px;">1-Click Theme Presets</label>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px;">
                            <button type="button" class="sbf-preset-btn active" onclick="applyThemePreset('dreamflykit')" id="preset-dreamflykit" title="Vibrant Orange + Royal Navy on clean light slate">
                                <span class="sbf-preset-swatch" style="background: linear-gradient(135deg, #ea580c 50%, #034694 50%);"></span>
                                <span class="sbf-preset-name">Dreamflykit</span>
                                <span class="sbf-preset-sub">Official (Light)</span>
                            </button>
                            <button type="button" class="sbf-preset-btn" onclick="applyThemePreset('ocean')" id="preset-ocean" title="Sky Blue + Amber on crisp white">
                                <span class="sbf-preset-swatch" style="background: linear-gradient(135deg, #0284c7 50%, #ea580c 50%);"></span>
                                <span class="sbf-preset-name">Ocean Amber</span>
                                <span class="sbf-preset-sub">Clean (Light)</span>
                            </button>
                            <button type="button" class="sbf-preset-btn" onclick="applyThemePreset('scholar')" id="preset-scholar" title="University Navy + Academic Gold">
                                <span class="sbf-preset-swatch" style="background: linear-gradient(135deg, #1e40af 50%, #d97706 50%);"></span>
                                <span class="sbf-preset-name">Scholar</span>
                                <span class="sbf-preset-sub">Navy &amp; Gold</span>
                            </button>
                            <button type="button" class="sbf-preset-btn" onclick="applyThemePreset('emerald')" id="preset-emerald" title="Emerald Literature + Warm Amber">
                                <span class="sbf-preset-swatch" style="background: linear-gradient(135deg, #059669 50%, #d97706 50%);"></span>
                                <span class="sbf-preset-name">Emerald</span>
                                <span class="sbf-preset-sub">Campus Nature</span>
                            </button>
                            <button type="button" class="sbf-preset-btn" onclick="applyThemePreset('midnight')" id="preset-midnight" title="Midnight Navy Slate with vibrant orange & sky blue">
                                <span class="sbf-preset-swatch" style="background: linear-gradient(135deg, #0f172a 50%, #f97316 50%);"></span>
                                <span class="sbf-preset-name">Midnight</span>
                                <span class="sbf-preset-sub">Dark Campus</span>
                            </button>
                        </div>
                    </div>

                    <!-- Brand Identity Text Fields -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Brand Name (Navbar)</label>
                            <input type="text" id="theme_BrandName" class="sbf-input" value="@theme.BrandName" oninput="updateLivePreview()" />
                        </div>
                        <div>
                            <label class="sbf-label">Tagline / Subtitle</label>
                            <input type="text" id="theme_Tagline" class="sbf-input" value="@theme.Tagline" oninput="updateLivePreview()" />
                        </div>
                    </div>

                    <!-- Color Pickers with Dual Hex Input -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label class="sbf-label">Primary Brand Color</label>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <input type="color" id="theme_PrimaryColorPicker" value="@theme.PrimaryColor" oninput="syncColorInput('theme_PrimaryColorPicker', 'theme_PrimaryColor')" style="width: 44px; height: 38px; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; padding: 2px;" />
                                <input type="text" id="theme_PrimaryColor" class="sbf-input" value="@theme.PrimaryColor" oninput="syncColorPicker('theme_PrimaryColor', 'theme_PrimaryColorPicker')" style="font-family: monospace; font-weight: 700; text-transform: uppercase;" />
                            </div>
                            <small style="color: #64748b; font-size: 11px;">Buttons, badges, active tabs, highlights</small>
                        </div>

                        <div>
                            <label class="sbf-label">Secondary Brand Color</label>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <input type="color" id="theme_SecondaryColorPicker" value="@theme.SecondaryColor" oninput="syncColorInput('theme_SecondaryColorPicker', 'theme_SecondaryColor')" style="width: 44px; height: 38px; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; padding: 2px;" />
                                <input type="text" id="theme_SecondaryColor" class="sbf-input" value="@theme.SecondaryColor" oninput="syncColorPicker('theme_SecondaryColor', 'theme_SecondaryColorPicker')" style="font-family: monospace; font-weight: 700; text-transform: uppercase;" />
                            </div>
                            <small style="color: #64748b; font-size: 11px;">Navbar emblem, Top 10 strokes, accents</small>
                        </div>

                        <div>
                            <label class="sbf-label">Page Background Color</label>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <input type="color" id="theme_BackgroundColorPicker" value="@theme.BackgroundColor" oninput="syncColorInput('theme_BackgroundColorPicker', 'theme_BackgroundColor')" style="width: 44px; height: 38px; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; padding: 2px;" />
                                <input type="text" id="theme_BackgroundColor" class="sbf-input" value="@theme.BackgroundColor" oninput="syncColorPicker('theme_BackgroundColor', 'theme_BackgroundColorPicker')" style="font-family: monospace; font-weight: 700; text-transform: uppercase;" />
                            </div>
                            <small style="color: #64748b; font-size: 11px;">Default: #f8fafc (Clean light slate)</small>
                        </div>

                        <div>
                            <label class="sbf-label">Card Background Color</label>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <input type="color" id="theme_CardBackgroundColorPicker" value="@theme.CardBackgroundColor" oninput="syncColorInput('theme_CardBackgroundColorPicker', 'theme_CardBackgroundColor')" style="width: 44px; height: 38px; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; padding: 2px;" />
                                <input type="text" id="theme_CardBackgroundColor" class="sbf-input" value="@theme.CardBackgroundColor" oninput="syncColorPicker('theme_CardBackgroundColor', 'theme_CardBackgroundColorPicker')" style="font-family: monospace; font-weight: 700; text-transform: uppercase;" />
                            </div>
                            <small style="color: #64748b; font-size: 11px;">Default: #ffffff (Crisp clean white)</small>
                        </div>
                    </div>

                    <!-- Hidden legacy inputs for 100% backward compatibility -->
                    <input type="hidden" id="theme_PrimaryRed" value="@theme.PrimaryColor" />
                    <input type="hidden" id="theme_DarkBackground" value="@theme.BackgroundColor" />
                    <input type="hidden" id="theme_CardBackground" value="@theme.CardBackgroundColor" />
                    <input type="hidden" id="theme_ThemePreset" value="@theme.ThemePreset" />

                    <!-- Dark Mode Switch -->
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px 16px;">
                        <label style="display: flex; align-items: center; gap: 10px; font-weight: 700; cursor: pointer; margin: 0; color: #0f172a;">
                            <input type="checkbox" id="theme_IsDarkThemeEnabled" @(theme.IsDarkThemeEnabled ? "checked" : "") onchange="onDarkModeToggle(this.checked)" style="width: 18px; height: 18px; accent-color: #ea580c;" />
                            <span>Enable Immersive Dark Mode Theme on Store</span>
                        </label>
                        <p style="margin: 6px 0 0 28px; font-size: 12px; color: #64748b;">When enabled, flips background to dark slate (#0f172a) and cards to deep navy (#1e293b) while retaining automatic text visibility.</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Live WCAG Contrast & Interactive Preview -->
            <div class="dk-card" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                    <div>
                        <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">Live Contrast &amp; Preview</h3>
                        <p style="margin: 4px 0 0 0; font-size: 13px; color: #64748b;">Real-time text visibility check against your chosen colors.</p>
                    </div>
                    <div id="contrastBadge" style="background: #dcfce7; color: #166534; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 6px; border: 1px solid #bbf7d0;">
                        ✓ AAA Compliant
                    </div>
                </div>

                <!-- Contrast Telemetry Card -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px;">
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px;">
                        <span style="font-size: 11px; color: #64748b; font-weight: 600; display: block;">Page Text Contrast</span>
                        <div style="display: flex; align-items: baseline; gap: 6px; margin-top: 2px;">
                            <strong id="contrastRatioValue" style="font-size: 16px; color: #0f172a;">14.2 : 1</strong>
                            <small id="contrastStatus" style="font-size: 11px; color: #16a34a; font-weight: 700;">Excellent</small>
                        </div>
                        <span id="contrastTextColorLabel" data-hex="#0f172a" style="font-size: 11px; color: #475569; margin-top: 2px; display: block;">Text: #0f172a (Dark Slate)</span>
                    </div>

                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px;">
                        <span style="font-size: 11px; color: #64748b; font-weight: 600; display: block;">Primary Button Contrast</span>
                        <div style="display: flex; align-items: baseline; gap: 6px; margin-top: 2px;">
                            <strong id="btnContrastRatioValue" style="font-size: 16px; color: #0f172a;">4.8 : 1</strong>
