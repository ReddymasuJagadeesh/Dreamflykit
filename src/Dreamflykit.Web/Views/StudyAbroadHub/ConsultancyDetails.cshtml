@model Dreamflykit.Application.StudyHub.Models.ConsultancyDetailsPageDto
@{
    Layout = "_Layout";
    var cPage = Model ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage();
    cPage.EnsureDefaults();
    ViewData["Title"] = $"{cPage.HeroHeadline} {cPage.HeroHeadlineHighlight} — {cPage.BrandName} Global Programs";
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    var pills = cPage.CategoryPills != null && cPage.CategoryPills.Count > 0
        ? cPage.CategoryPills
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().CategoryPills;

    var partners = cPage.Partners != null && cPage.Partners.Count > 0
        ? cPage.Partners
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().Partners;

    var trending = cPage.TrendingCourses != null && cPage.TrendingCourses.Count > 0
        ? cPage.TrendingCourses
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().TrendingCourses;

    var popular = cPage.PopularPrograms != null && cPage.PopularPrograms.Count > 0
        ? cPage.PopularPrograms
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().PopularPrograms;

    var countries = cPage.Countries != null && cPage.Countries.Count > 0
        ? cPage.Countries
        : Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultConsultancyDetailsPage().Countries;

    var activeCountry = countries.FirstOrDefault(c => c.IsActive) ?? countries.FirstOrDefault() ?? new Dreamflykit.Application.StudyHub.Models.ConsultancyCountryDto();

    var searchBar = cPage.SearchBar ?? new Dreamflykit.Application.StudyHub.Models.ConsultancySearchBarDto();
    var whyChoose = cPage.WhyChooseUs ?? new Dreamflykit.Application.StudyHub.Models.ConsultancyWhyChooseSectionDto();
    var topDestinations = cPage.TopDestinations ?? new Dreamflykit.Application.StudyHub.Models.ConsultancyTopDestinationsSectionDto();
    var topUniversities = cPage.TopUniversities ?? new Dreamflykit.Application.StudyHub.Models.ConsultancyTopUniversitiesSectionDto();
}

<div class="dk-upg-root" id="consultancyRoot">

    @if (canManage)
    {
        <!-- Admin Shortcut Bar -->
        <div class="dk-upg-admin-bar">
            <div class="dk-upg-admin-inner">
                <span class="dk-upg-admin-tag">⚡ Super Admin Controls</span>
                <span>You can edit all logos, hero image/video, programs, partner brands and destination showcases anytime in Admin.</span>
                <a href="/Admin/StudyAbroadHub#tab-consultancy" class="dk-upg-admin-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <span>Edit Consultancy Portal in Admin</span>
                </a>
            </div>
        </div>
    }

    <!-- ========================================================
         1. TOP NAVIGATION BAR (upGrad Inspired with Dreamflykit Logo)
    ========================================================= -->
    <header class="dk-upg-header">
        <div class="dk-upg-nav-container">
            <!-- Brand Logo (Dreamflykit Logo in place of upGrad) -->
            <a href="/study-abroad-hub/consultancy" class="dk-upg-brand" title="@cPage.BrandName Study Abroad Consultancy">
                @if (!string.IsNullOrWhiteSpace(cPage.LogoUrl))
                {
                    <img src="@cPage.LogoUrl" alt="@cPage.BrandName" class="dk-upg-brand-img" onerror="this.onerror=null; this.src='/images/branding/dreamflykit-logo-clean.webp';" />
                }
                else
                {
                    <img src="/images/branding/dreamflykit-logo-clean.webp" alt="Dreamflykit" class="dk-upg-brand-img" onerror="this.style.display='none'; document.getElementById('dkFallbackBrandText').style.display='inline-block';" />
                    <span id="dkFallbackBrandText" style="display: none; font-size: 22px; font-weight: 900; color: #e52d27; letter-spacing: -0.5px;">@cPage.BrandName</span>
                }
            </a>

            <!-- Navigation Links -->
            <nav class="dk-upg-nav-menu" aria-label="Main Consultancy Navigation">
                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>Upskilling Courses</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="#trending-courses" onclick="filterCategory('ai')">🤖 Generative &amp; Agentic AI</a>
                        <a href="#trending-courses" onclick="filterCategory('data')">📈 Data Science &amp; Analytics</a>
                        <a href="#popular-programs" onclick="filterCategory('ml')">💻 Machine Learning &amp; Cloud</a>
                        <a href="#popular-programs" onclick="filterCategory('mba')">🎓 Executive MBA &amp; Leadership</a>
                    </div>
                </div>

                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>Study Abroad</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="#destination-showcase">🇫🇷 Study in France</a>
                        <a href="#destination-showcase">🇨🇦 Study in Canada</a>
                        <a href="#destination-showcase">🇬🇧 Study in United Kingdom</a>
                        <a href="#destination-showcase">🇫🇮 Study in Finland</a>
                        <a href="/study-abroad-hub/education-loans">💰 Abroad Education Loans</a>
                    </div>
                </div>

                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>Professional Certifications</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="#trending-courses">IIT / IIM Advanced Certifications</a>
                        <a href="#trending-courses">Cybersecurity &amp; AI Security</a>
                        <a href="#popular-programs">Semiconductor &amp; Hardware Tech</a>
                    </div>
                </div>

                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>Learn Offline</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="#popular-programs">In-Person Workshops (Bengaluru)</a>
                        <a href="#popular-programs">Global Immersion Trips (Paris / UK)</a>
                    </div>
                </div>

                <a href="#trending-courses" class="dk-upg-nav-link">School of Tech</a>

                <div class="dk-upg-dropdown">
                    <button type="button" class="dk-upg-nav-btn has-arrow">
                        <span>More</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dk-upg-dropdown-menu">
                        <a href="/study-abroad-hub">🌐 Study Abroad Hub Profile</a>
                        <a href="/study-abroad-hub/education-loans">🎓 Education Loans Portal</a>
                        <a href="/abroad-packing-checklist">📋 Packing Checklist</a>
                    </div>
                </div>
            </nav>

            <!-- Sign Up CTA Button -->
            <div class="dk-upg-nav-action">
                <button type="button" class="dk-upg-signup-btn" onclick="openConsultancyModal('General Sign Up')">
                    @cPage.SignUpButtonText
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================================
         2. HERO SECTION (Secure Image or Video Banner with Realistic 3D Tilt)
    ========================================================= -->
    <section class="dk-upg-hero-section @(cPage.EnableHero3dAnimation ? "has-3d-tilt" : "")" id="heroBanner" style="height: @(cPage.HeroBannerHeight > 0 ? cPage.HeroBannerHeight : 620)px; min-height: @(cPage.HeroBannerHeight > 0 ? cPage.HeroBannerHeight : 620)px;">
        <div class="dk-hero-3d-sheen" id="heroSheen"></div>

        <!-- 3D Floating Badges / Visual Parallax Accents -->
        <div class="dk-hero-3d-floating-layer" aria-hidden="true">
            <div class="dk-float-chip chip-1">
                <span class="chip-dot"></span>
                <span>🏛️ 850+ University Partners</span>
            </div>
            <div class="dk-float-chip chip-2">
                <span class="chip-dot green"></span>
                <span>🎓 98.4% Visa Acceptance</span>
            </div>
            <div class="dk-float-chip chip-3">
                <span class="chip-dot gold"></span>
                <span>💰 ₹50Cr+ Scholarships</span>
            </div>
        </div>

        <!-- Media Backdrop: Video or Image -->
        @if (cPage.HeroMediaType == "video" && !string.IsNullOrWhiteSpace(cPage.HeroVideoUrl))
        {
            <div class="dk-upg-hero-media-wrapper">
                <video id="heroVideoPlayer" class="dk-upg-hero-video" autoplay muted loop playsinline poster="@cPage.HeroImageUrl">
                    <source src="@cPage.HeroVideoUrl" type="video/mp4" />
                    <source src="@cPage.HeroVideoUrl" type="video/webm" />
                </video>
                <div class="dk-upg-hero-overlay"></div>
                <!-- Video Controls Badge -->
                <div class="dk-hero-video-controls">
                    <span class="dk-video-live-dot"></span>
                    <span class="dk-video-label">Campus Video Feed</span>
                    <button type="button" class="dk-video-ctrl-btn" onclick="toggleHeroVideoPlay(this)" title="Play / Pause Video">
                        <svg class="icon-pause" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                        <svg class="icon-play" style="display:none;" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    </button>
                    <button type="button" class="dk-video-ctrl-btn" onclick="toggleHeroVideoAudio(this)" title="Mute / Unmute Audio">
                        <svg class="icon-muted" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                        <svg class="icon-unmuted" style="display:none;" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="dk-upg-hero-media-wrapper">
                <div class="dk-upg-hero-img-bg" style="background-image: url('@cPage.HeroImageUrl');"></div>
                <div class="dk-upg-hero-overlay"></div>
            </div>
        }

    </section>

    <!-- ========================================================
         2.5 REDBUS-STYLE HORIZONTAL SEARCH BAR WIDGET
         All 4 sections (Destination, Nearest Centre, Preferred Intake, Booking for Counselling)
         contained INSIDE the single bar + Hanging Red Search Button
    ========================================================= -->
    <section class="dk-redbus-search-section" id="consultancySearchBarSection">
        <div class="dk-redbus-search-container">
            <div class="dk-redbus-outer-card">
                <!-- Unified Single 4-Segment Input Bar -->
                <div class="dk-redbus-segmented-box">
                    <!-- Segment 1: Destination -->
                    <div class="dk-redbus-seg dk-seg-dest" id="segDestination" 
                         onmouseenter="handleSegMouseEnter('menuDestination')" 
                         onmouseleave="handleSegMouseLeave('menuDestination')" 
                         onclick="handleSegClick('menuDestination', event)">
                        <div class="dk-redbus-seg-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                        </div>
                        <div class="dk-redbus-seg-text-group">
                            <span class="dk-redbus-seg-label">@searchBar.DestinationLabel</span>
                            <div class="dk-redbus-seg-value">
                                <span class="dk-seg-flag" id="dispDestFlag">🇬🇧</span>
                                <span class="dk-seg-title" id="dispDestName">United Kingdom</span>
                                <span class="dk-seg-badge" id="dispDestCount">250+ Unis</span>
                            </div>
                        </div>
                        <div class="dk-redbus-seg-arrow">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                        </div>

                        <!-- Dropdown 1: Destination Popover -->
                        <div class="dk-redbus-dropdown-panel" id="menuDestination" 
                             onmouseenter="cancelHideDropdown()" 
                             onmouseleave="handleSegMouseLeave('menuDestination')" 
                             onclick="event.stopPropagation()">
                            <div class="dk-dropdown-filter-wrap">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                                <input type="text" class="dk-dropdown-filter-input" placeholder="Search destination country..." oninput="filterDestList(this.value)" autocomplete="off" />
                            </div>
                            <div class="dk-dropdown-options-list" id="destOptionsList">
                                <div class="dk-drop-opt-item" onclick="selectDestination('ALL', 'All Destinations', '🌍', '850+ Unis', event)">
                                    <span class="opt-flag">🌍</span>
                                    <div class="opt-info">
                                        <div class="opt-name">All Study Destinations</div>
                                        <div class="opt-sub">850+ Partner Universities Worldwide</div>
                                    </div>
                                </div>
                                @foreach (var d in searchBar.Destinations)
                                {
                                    <div class="dk-drop-opt-item @(d.CountryCode == "GB" ? "active" : "")" 
                                         data-code="@d.CountryCode" 
                                         data-country="@d.CountryName" 
                                         data-centres="@string.Join(",", d.SuggestedCentres)" 
                                         data-intakes="@string.Join(",", d.AvailableIntakes)" 
                                         onclick="selectDestination('@d.CountryCode', '@d.CountryName', '@d.FlagEmoji', '@d.UniversityCountText', event)">
                                        <span class="opt-flag">@d.FlagEmoji</span>
                                        <div class="opt-info">
                                            <div class="opt-name">@d.CountryName</div>
                                            <div class="opt-sub">@d.UniversityCountText • High Visa Success</div>
                                        </div>
                                        <span class="opt-check">✓</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Divider 1 -->
                    <div class="dk-redbus-divider"></div>

                    <!-- Segment 2: Nearest Centre -->
                    <div class="dk-redbus-seg dk-seg-centre" id="segCentre" 
                         onmouseenter="handleSegMouseEnter('menuCentre')" 
                         onmouseleave="handleSegMouseLeave('menuCentre')" 
                         onclick="handleSegClick('menuCentre', event)">
                        <div class="dk-redbus-seg-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                            </svg>
                        </div>
                        <div class="dk-redbus-seg-text-group">
                            <span class="dk-redbus-seg-label">@searchBar.CentreLabel</span>
                            <div class="dk-redbus-seg-value">
                                <span class="dk-seg-title" id="dispCentreName">Hyderabad - Madhapur</span>
                                <span class="dk-seg-badge" id="dispCentreSub">In-Person &amp; Hybrid</span>
                            </div>
                        </div>
                        <div class="dk-redbus-seg-arrow">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                        </div>

                        <!-- Dropdown 2: Nearest Centre Popover -->
                        <div class="dk-redbus-dropdown-panel" id="menuCentre" 
                             onmouseenter="cancelHideDropdown()" 
                             onmouseleave="handleSegMouseLeave('menuCentre')" 
                             onclick="event.stopPropagation()">
                            <div class="dk-dropdown-filter-wrap">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                                <input type="text" class="dk-dropdown-filter-input" placeholder="Search branch or city..." oninput="filterCentreList(this.value)" autocomplete="off" />
                            </div>
                            <div class="dk-dropdown-options-list" id="centreOptionsList">
                                @foreach (var c in searchBar.Centres)
                                {
                                    <div class="dk-drop-opt-item centre-opt-item" data-centre="@c.CentreName" data-city="@c.City" onclick="selectCentre('@c.CentreName', '@c.City', event)">
                                        <span class="opt-flag">@(c.IsOnline ? "💻" : "📍")</span>
                                        <div class="opt-info">
                                            <div class="opt-name">@c.CentreName</div>
                                            <div class="opt-sub">@c.Address</div>
                                        </div>
                                        @if (c.IsOnline)
                                        {
                                            <span class="opt-badge-online">24x7 Digital</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Divider 2 -->
                    <div class="dk-redbus-divider"></div>

                    <!-- Segment 3: Preferred Intake -->
                    <div class="dk-redbus-seg dk-seg-intake" id="segIntake" 
                         onmouseenter="handleSegMouseEnter('menuIntake')" 
                         onmouseleave="handleSegMouseLeave('menuIntake')" 
                         onclick="handleSegClick('menuIntake', event)">
                        <div class="dk-redbus-seg-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </div>
                        <div class="dk-redbus-seg-text-group">
                            <span class="dk-redbus-seg-label">@searchBar.IntakeLabel</span>
                            <div class="dk-redbus-seg-value">
                                <span class="dk-seg-title" id="dispIntakeName">Fall / Sept 2026</span>
                                <span class="dk-seg-subnote" id="dispIntakeSub">(Upcoming)</span>
                            </div>
                        </div>
                        <div class="dk-redbus-seg-arrow">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                        </div>

                        <!-- Dropdown 3: Preferred Intake Popover (Right Aligned) -->
                        <div class="dk-redbus-dropdown-panel dk-panel-right" id="menuIntake" 
                             onmouseenter="cancelHideDropdown()" 
                             onmouseleave="handleSegMouseLeave('menuIntake')" 
                             onclick="event.stopPropagation()">
                            <div class="dk-dropdown-header">Select Academic Intake Window</div>
                            <div class="dk-dropdown-options-list" id="intakeOptionsList">
                                @foreach (var intake in searchBar.Intakes)
                                {
                                    <div class="dk-drop-opt-item intake-opt-item @(intake.IntakeName.Contains("Fall / Sept 2026") ? "active" : "")" data-intake="@intake.IntakeName" onclick="selectIntake('@intake.IntakeName', event)">
                                        <span class="opt-flag">📅</span>
                                        <div class="opt-info">
                                            <div class="opt-name">@intake.IntakeName</div>
                                            <div class="opt-sub">@intake.Season Term @intake.Year</div>
                                        </div>
                                        <span class="opt-intake-badge">Open</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Divider 3 -->
                    <div class="dk-redbus-divider"></div>

                    <!-- Segment 4: Booking for Counselling (Inside the single bar!) -->
                    <div class="dk-redbus-seg-counselling">
                        <div class="dk-counsellor-avatar-wrap">
                            <svg width="38" height="38" viewBox="0 0 40 40" fill="none">
                                <circle cx="20" cy="20" r="19" fill="#fdf2f8" stroke="#fbcfe8" stroke-width="1.5"/>
                                <path d="M20 10c-3.1 0-5.6 2.5-5.6 5.6 0 2.2 1.2 4.1 3 5v1.4c0 .6.4 1 1 1h3.2c.6 0 1-.4 1-1v-1.4c1.8-.9 3-2.8 3-5 0-3.1-2.5-5.6-5.6-5.6z" fill="#ec4899"/>
                                <path d="M12 32c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="#db2777" stroke-width="2.2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="dk-counsellor-content">
                            <div class="dk-counsellor-title">Booking for Counselling</div>
                            <a href="#consultancy-lead-modal" class="dk-counsellor-link" onclick="openConsultancyModal('Search Bar Advisory'); return false;">Know more</a>
                        </div>
                        <label class="dk-redbus-toggle" title="Toggle free profile evaluation & scholarship counselling">
                            <input type="checkbox" id="advisoryToggle" checked onchange="handleAdvisoryToggle(this)" />
                            <span class="dk-toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <!-- Centered Hanging Search Button -->
                <div class="dk-redbus-btn-center-wrap">
                    <button type="button" class="dk-redbus-hanging-btn" onclick="executeHubSearch()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                        </svg>
                        <span>Search Programs</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================
         2.6 SECTION A: WHY CHOOSE LEVERAGE EDU & DREAMFLYKIT GLOBAL? (Image 3)
    ========================================================= -->
    <section class="dk-whychoose-section" id="whyChooseSection">
        <div class="dk-upg-container">
            <div class="dk-section-center-head">
                <span class="dk-sec-pill-tag">GLOBAL EXCELLENCE</span>
                <h2 class="dk-sec-heading-dark">@whyChoose.Title</h2>
                <p class="dk-sec-subheading">@whyChoose.Subtitle</p>
            </div>

            <div class="dk-whychoose-grid">
                @foreach (var card in whyChoose.Cards)
                {
                    <div class="dk-whychoose-card">
                        <div class="dk-whychoose-icon-wrap">
                            @if (card.IconType == "partners")
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            }
                            else if (card.IconType == "support")
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            }
                            else if (card.IconType == "stories")
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                            }
                            else if (card.IconType == "acceptance")
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                            }
                            else if (card.IconType == "scholarship")
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                            }
                            else
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/></svg>
                            }
                        </div>
                        <div class="dk-whychoose-body">
                            <h3 class="dk-whychoose-title">@card.Title</h3>
                            <p class="dk-whychoose-desc">@card.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         2.7 SECTION B: TOP STUDY DESTINATIONS (Image 3)
         Cards with Photos or "⏳ UPLOADING SOON" Badge
    ========================================================= -->
    <section class="dk-top-destinations-section" id="topDestinationsSection">
        <div class="dk-upg-container">
            <div class="dk-section-split-head">
                <div>
                    <span class="dk-sec-pill-tag">GLOBAL HUBS</span>
                    <h2 class="dk-sec-heading-dark">@(!string.IsNullOrWhiteSpace(topDestinations.Title) ? topDestinations.Title.TrimEnd(' ', ':') : "Top Country Destinations")</h2>
                    <p class="dk-sec-subheading">@topDestinations.Subtitle</p>
                </div>
                <div class="dk-dest-scroll-btns">
                    <button type="button" class="dk-scroll-arrow-btn" onclick="scrollDestCards(-320)" aria-label="Previous Destinations">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                    </button>
                    <button type="button" class="dk-scroll-arrow-btn" onclick="scrollDestCards(320)" aria-label="Next Destinations">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <div class="dk-dest-cards-track" id="destCardsTrack">
                @foreach (var dest in topDestinations.Destinations)
                {
                    <div class="dk-dest-card" data-country="@dest.CountryName" data-code="@dest.CountryCode" onclick="selectDestination('@dest.CountryCode', '@dest.CountryName', '@dest.FlagEmoji', '@dest.UniversityCount')">
                        <div class="dk-dest-card-media">
                            <img src="@(string.IsNullOrWhiteSpace(dest.ImageUrl) ? $"/images/study-hub/dest-{dest.Slug}.svg" : dest.ImageUrl)" alt="@dest.CountryName" class="dk-dest-card-img" onerror="this.src='/images/study-hub/upload-soon.svg';" loading="lazy" />
                            @if (dest.IsUploadingSoon)
                            {
                                <div class="dk-upload-soon-overlay-badge">
                                    <span>⏳ UPLOADING SOON</span>
                                </div>
                            }
                            <div class="dk-dest-flag-badge">
                                <span class="dest-emoji">@dest.FlagEmoji</span>
                            </div>
                        </div>

                        <div class="dk-dest-card-body">
                            <h3 class="dk-dest-card-name">@dest.CountryName</h3>
                            <div class="dk-dest-card-count">@dest.UniversityCount</div>
                            <div class="dk-dest-streams-pill">
                                <span>@dest.PopularStreams</span>
                            </div>
                            <div class="dk-dest-explore-link">
                                <span>Explore Universities</span>
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         2.8 SECTION C: TOP UNIVERSITIES WITH COUNTRY TABS (Image 3)
         Dynamic Filtering, Campus Photos, "⏳ UPLOADING SOON" Badge & Actions
    ========================================================= -->
    <section class="dk-top-universities-section" id="topUniversitiesSection">
        <div class="dk-upg-container">
            <div class="dk-section-center-head">
                <span class="dk-sec-pill-tag">GLOBAL CAMPUSES</span>
                <h2 class="dk-sec-heading-dark">@topUniversities.Title</h2>
                <p class="dk-sec-subheading">@topUniversities.Subtitle</p>
            </div>

            <!-- Country Filter Tabs Bar matching Image 3 -->
            <div class="dk-uni-tabs-bar" id="uniTabsBar">
                @foreach (var tab in topUniversities.Tabs)
                {
                    <button type="button" class="dk-uni-tab-btn @(tab == "ALL" ? "active" : "")" data-tab="@tab" onclick="switchUniTab('@tab', this)">
                        <span>@tab</span>
                    </button>
                }
            </div>

            <!-- Active Filter Status & Reset Strip -->
            <div class="dk-uni-filter-status-bar">
                <div class="dk-filter-status-text">
                    Showing <strong id="uniCountText">@topUniversities.Universities.Count</strong> universities <span id="uniCurrentFilterText">across all destinations</span>
                </div>
                <button type="button" class="dk-filter-reset-link" onclick="resetUniFilters()">
                    <span>↺ Show All Universities</span>
                </button>
            </div>

            <!-- University Cards Grid -->
            <div class="dk-uni-cards-grid" id="uniCardsGrid">
                @foreach (var uni in topUniversities.Universities)
                {
                    <div class="dk-uni-card" data-name="@uni.Name" data-country="@uni.Country.ToUpperInvariant()" data-code="@uni.CountryCode">
                        <div class="dk-uni-card-media">
                            <img src="@(string.IsNullOrWhiteSpace(uni.ImageUrl) ? $"/images/study-hub/upload-soon.svg" : uni.ImageUrl)" alt="@uni.Name" class="dk-uni-card-img" onerror="this.src='/images/study-hub/upload-soon.svg';" loading="lazy" />
                            @if (uni.IsUploadingSoon)
                            {
                                <div class="dk-upload-soon-overlay-badge">
                                    <span>⏳ UPLOADING SOON</span>
                                </div>
                            }
                            <div class="dk-uni-country-badge">
                                <span>@uni.FlagEmoji @uni.Country</span>
                            </div>
                            <div class="dk-uni-ranking-badge">
                                <span>@uni.RankingTag</span>
                            </div>
                        </div>

                        <div class="dk-uni-card-body">
                            <h3 class="dk-uni-card-title" title="@uni.Name">@uni.Name</h3>
                            <div class="dk-uni-courses-badge">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/></svg>
                                <span>@uni.CoursesCount</span>
                            </div>

                            <div class="dk-uni-card-actions">
                                <button type="button" class="dk-uni-btn-details" onclick="openUniDetailsModal('@uni.Name', '@uni.Country', '@uni.CoursesCount', '@uni.RankingTag')">
                                    <span>View Details</span>
                                </button>
                                <button type="button" class="dk-uni-btn-eligibility" onclick="checkUniEligibility('@uni.Name', '@uni.Country')">
                                    <span>Check Eligibility</span>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Empty State if no cards match filter -->
            <div class="dk-uni-empty-state" id="uniEmptyState" style="display: none;">
                <div class="dk-empty-icon">🔍</div>
                <h3>No universities found for this filter</h3>
                <p>We work with 850+ universities worldwide. Speak directly with our international counselling advisors to apply for unlisted institutions.</p>
                <button type="button" class="dk-redbus-action-btn" onclick="resetUniFilters()" style="margin: 12px auto 0 auto; display: inline-flex;">
                    <span>View All Universities</span>
                </button>
            </div>
        </div>
    </section>

    <!-- ========================================================
         2.9 SECTION D: EXPLORE OUR MOST POPULAR PROGRAMS (Image 4)
         Crisp Modern Light Background
    ========================================================= -->
    <section class="dk-upg-popular-section" id="popular-programs">
        <div class="dk-upg-container">
