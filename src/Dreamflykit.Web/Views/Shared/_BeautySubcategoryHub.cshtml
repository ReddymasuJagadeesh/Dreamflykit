@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.BeautyHub ?? Dreamflykit.Application.BeautyHub.Models.BeautyHubDto.CreateDefault();
    var allCategories = hub.SubCategories?.Items?.Where(i => i.IsActive).OrderBy(i => i.DisplayOrder).ToList() ?? new();
    if (allCategories.Count == 0)
    {
        allCategories = Dreamflykit.Application.BeautyHub.Models.BeautyHubDto.CreateDefaultCategories();
    }

    var catSlug = (Model.BeautyCategoryPage?.CategorySlug ?? Model.CurrentSubcategorySlug ?? "makeup").Trim().ToLowerInvariant();
    var activeCategoryItem = allCategories.FirstOrDefault(c => string.Equals(c.Slug, catSlug, StringComparison.OrdinalIgnoreCase))
                             ?? allCategories.FirstOrDefault(c => string.Equals(c.Slug, "makeup", StringComparison.OrdinalIgnoreCase))
                             ?? allCategories.FirstOrDefault();

    var activeCatSlug = activeCategoryItem?.Slug ?? "makeup";
    var activeCatName = activeCategoryItem?.Title ?? "Makeup";

    var subPage = Model.BeautySubcategoryPage
                  ?? hub.SubcategoryPages?.FirstOrDefault(p => string.Equals(p.CategorySlug, activeCatSlug, StringComparison.OrdinalIgnoreCase))
                  ?? Dreamflykit.Application.BeautyHub.Models.BeautyHubDto.CreateDefaultSubcategoryPages().FirstOrDefault(p => string.Equals(p.CategorySlug, activeCatSlug, StringComparison.OrdinalIgnoreCase))
                  ?? Dreamflykit.Application.BeautyHub.Models.BeautyHubDto.CreateDefaultSubcategoryPages().FirstOrDefault();

    var activeSubcatSlug = subPage?.SubcategorySlug ?? "lips";
    var activeSubcatName = subPage?.SubcategoryName ?? "Lips";
    var activeSubcatEmoji = subPage?.IconEmoji ?? "💄";

    var hero = subPage?.HeroBanner ?? new Dreamflykit.Application.BeautyHub.Models.BeautyCategoryHeroDto();
    var subItems = subPage?.SubcategoryItems ?? new List<string>();
    var products = subPage?.Products ?? new List<Dreamflykit.Application.BeautyHub.Models.BeautyProductItemDto>();
    var activeSubItem = Model.CurrentSubcatItem ?? "";

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    // Brands for this subcategory
    var brands = new List<Dreamflykit.Application.BeautyHub.Models.BeautyBrandItemDto>();
    if (subPage?.ShopByBrands?.Brands != null && subPage.ShopByBrands.Brands.Count > 0)
    {
        brands = subPage.ShopByBrands.Brands.Where(b => b.IsActive).OrderBy(b => b.DisplayOrder).ToList();
    }
    else
    {
        var productBrands = products.Where(p => !string.IsNullOrWhiteSpace(p.Brand)).Select(p => p.Brand.Trim()).Distinct().ToList();
        var defaultTopBrands = new List<string>
        {
            "L'Oréal Paris", "Maybelline", "Lakme", "Minimalist",
            "Cetaphil", "The Derma Co", "Plum", "Mamaearth",
            "MAC", "Nykaa", "Versace", "Dove"
        };
        var combined = productBrands.Concat(defaultTopBrands).Distinct(StringComparer.OrdinalIgnoreCase).Take(8).ToList();
        var order = 1;
        foreach (var b in combined)
        {
            brands.Add(new Dreamflykit.Application.BeautyHub.Models.BeautyBrandItemDto
            {
                Id = "bnd-" + order,
                Name = b,
                Slug = b.ToLowerInvariant().Replace(" ", "-").Replace("'", "").Replace("&", "and"),
                IsUploadingSoon = true,
                DisplayOrder = order++,
                IsActive = true
            });
        }
    }

    var totalProductsCount = products.Count;
    var heroImg = !string.IsNullOrWhiteSpace(hero.ImageUrl) ? hero.ImageUrl : "";
    var isHeroSoon = string.IsNullOrWhiteSpace(heroImg) || heroImg.Contains("placeholder") || hero.IsUploadingSoon;
    var themeColor = !string.IsNullOrWhiteSpace(hero.ThemeColor) ? hero.ThemeColor : "#be123c";

    // Equipment spec types / formulations for this subcategory
    var formulationsList = products.Where(p => !string.IsNullOrWhiteSpace(p.Formulation)).Select(p => p.Formulation.Trim()).Distinct().ToList();
    var subFilterItems = subItems.Where(s => !s.StartsWith("All ", StringComparison.OrdinalIgnoreCase)).ToList();
}

<div class="dk-beauty-sub-hub-root" id="beautySubcategoryRoot">

    <!-- Admin Quick Bar -->
    @if (canManage)
    {
        <div class="dk-beauty-sub-admin-bar">
            <div class="dk-beauty-sub-admin-left">
                <span class="dk-beauty-sub-admin-badge">⚡ Admin Mode</span>
                <span class="dk-beauty-sub-admin-hint">
                    Managing Beauty Subcategory: <strong>@activeCatName &gt; @activeSubcatName</strong> &bull; Customize hero banner, shop by brands, &amp; upload images anytime.
                </span>
            </div>
            <a href="/Admin/BeautyHub" class="dk-beauty-sub-admin-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Edit @activeSubcatName in Admin
            </a>
        </div>
    }

    <!-- ============================================================
         1. SUBCATEGORY FULL HERO BANNER (TEXT REMOVED AS REQUESTED)
         Clean Visual Canvas Edge-to-Edge
    ============================================================ -->
    @if (hero.IsEnabled)
    {
        <section class="dk-beauty-sub-hero-section full-width-hero" style="--beauty-theme: @themeColor;" aria-label="@activeSubcatName Visual Showcase">
            
            @if (isHeroSoon)
            {
                <div class="dk-beauty-sub-hero-soon">
                    <div class="dk-beauty-hero-radar-box">
                        <span class="dk-beauty-radar-ring ring-1"></span>
                        <span class="dk-beauty-radar-ring ring-2"></span>
                        <span class="dk-beauty-hero-radar-emoji">@activeSubcatEmoji</span>
                    </div>
                    <div class="dk-beauty-sub-soon-pill">
                        <span class="dk-beauty-pulse-dot">●</span> UPLOADING SOON
                    </div>
                </div>
            }
            else
            {
                <img src="@heroImg"
                     alt="@activeSubcatName Showcase"
                     class="dk-beauty-sub-hero-bg"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                <div class="dk-beauty-sub-hero-soon" style="display: none;">
                    <div class="dk-beauty-hero-radar-box">
                        <span class="dk-beauty-radar-ring ring-1"></span>
                        <span class="dk-beauty-radar-ring ring-2"></span>
                        <span class="dk-beauty-hero-radar-emoji">@activeSubcatEmoji</span>
                    </div>
                    <div class="dk-beauty-sub-soon-pill">
                        <span class="dk-beauty-pulse-dot">●</span> UPLOADING SOON
                    </div>
                </div>
            }

        </section>
    }

    <!-- ============================================================
         2. SHOP BY BRANDS SECTION (MATCHING ELECTRONICS IMAGE 2)
    ============================================================ -->
    @if (brands.Count > 0)
    {
        <section class="dk-beauty-brands-section dk-shell" aria-label="Shop @activeSubcatName by Brands">
            
            <div class="dk-beauty-brands-header">
                <div class="dk-beauty-brands-header-left">
                    <div class="dk-beauty-brands-pretitle">AUTHORIZED BRAND SHOWCASE</div>
                    <h2 class="dk-beauty-brands-title">Shop by Brands for @activeSubcatName</h2>
                    <p class="dk-beauty-brands-sub">Dermatologically tested formulas, certified clean ingredients &amp; campus-ready glow.</p>
                </div>
                <div class="dk-beauty-brands-header-right">
                    <span class="dk-beauty-brands-count">🏷️ <strong>@brands.Count</strong> Authorized Brands</span>
                </div>
            </div>

            <!-- Brands Grid -->
            <div class="dk-beauty-brands-grid">
                @foreach (var brand in brands)
                {
                    var brandSlug = !string.IsNullOrWhiteSpace(brand.Slug)
                        ? brand.Slug
                        : brand.Name.Trim().ToLowerInvariant().Replace(" ", "-").Replace("&", "and");

                    var isBrandSoon = brand.IsUploadingSoon || string.IsNullOrWhiteSpace(brand.LogoUrl) || brand.LogoUrl.Contains("uploading-soon") || brand.LogoUrl.Contains("placeholder");

                    <div class="dk-beauty-brand-card"
                         data-brand-slug="@brandSlug"
                         data-brand-name="@brand.Name"
                         onclick="beautySelectBrandFilter('@brand.Name')"
                         title="Filter by @brand.Name for @activeSubcatName">
                        
                        <div class="dk-beauty-brand-logo-box">
                            @if (isBrandSoon)
                            {
                                <div class="dk-beauty-brand-placeholder">
                                    <span class="dk-beauty-brand-initial">@brand.Name.FirstOrDefault()</span>
                                    <span class="dk-beauty-brand-soon-badge">Uploading Soon</span>
                                </div>
                            }
                            else
                            {
                                <img src="@brand.LogoUrl"
                                     alt="@brand.Name"
                                     loading="lazy"
                                     class="dk-beauty-brand-logo-img"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="dk-beauty-brand-placeholder" style="display: none;">
                                    <span class="dk-beauty-brand-initial">@brand.Name.FirstOrDefault()</span>
                                    <span class="dk-beauty-brand-soon-badge">Uploading Soon</span>
                                </div>
                            }
                        </div>

                        <span class="dk-beauty-brand-name">@brand.Name</span>
                        <span class="dk-beauty-brand-tap-hint">Tap to filter</span>
                    </div>
                }
            </div>

        </section>
    }

    <!-- ============================================================
         3. 2-COLUMN LAYOUT: LEFT SIDE FILTERS + RIGHT SIDE PRODUCTS
    ============================================================ -->
    <div class="dk-beauty-layout dk-shell">

        <!-- LEFT SIDEBAR: REACTIVE FILTERS -->
        <aside class="dk-beauty-sidebar" id="beautySidebar">
            <div class="dk-beauty-sidebar-header">
                <h3 class="dk-beauty-sidebar-title">
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd"/></svg>
                    <span>Filters</span>
                </h3>
                <button type="button" class="dk-beauty-btn-clear-filters" onclick="beautyResetAllFilters()">Clear All</button>
            </div>

            <!-- Filter Group 1: Beauty Categories Switcher -->
            <div class="dk-beauty-filter-box">
                <h4 class="dk-beauty-filter-title">
                    <span>Beauty Categories</span>
                    <span class="dk-beauty-badge-pill">@allCategories.Count Categories</span>
                </h4>
                <div class="dk-beauty-cat-switcher-list">
                    @foreach (var cat in allCategories)
                    {
                        var isActiveCat = string.Equals(cat.Slug, activeCatSlug, StringComparison.OrdinalIgnoreCase);

                        <a href="/category/beauty/@cat.Slug" class="dk-beauty-cat-switch-item @(isActiveCat ? "active" : "")" title="Go to @cat.Title">
                            <span class="dk-beauty-cat-switch-emoji">@cat.Icon</span>
                            <span class="dk-beauty-cat-switch-name">@cat.Title</span>
                            @if (isActiveCat)
                            {
                                <span class="dk-beauty-cat-switch-dot">●</span>
                            }
                        </a>
                    }
                </div>
            </div>

            <!-- Filter Group 2: Brand Checkboxes -->
            @if (brands.Count > 0)
            {
                <div class="dk-beauty-filter-box">
                    <h4 class="dk-beauty-filter-title">
                        <span>Brand</span>
                    </h4>
                    <div class="dk-beauty-filter-options-list">
                        @foreach (var brand in brands)
                        {
                            <label class="dk-beauty-checkbox-label">
                                <input type="checkbox" class="dk-beauty-filter-cb" data-filter="brand" value="@brand.Name" onchange="beautyTriggerFilter()">
                                <span class="dk-beauty-cb-custom"></span>
                                <span class="dk-beauty-cb-text">@brand.Name</span>
                            </label>
                        }
                    </div>
                </div>
            }

            <!-- Filter Group 3: Subcategory / Formulation Types -->
            @if (subFilterItems.Count > 0 || formulationsList.Count > 0)
            {
                <div class="dk-beauty-filter-box">
                    <h4 class="dk-beauty-filter-title">
                        <span>Types &amp; Formulations</span>
                    </h4>
                    <div class="dk-beauty-filter-options-list">
                        @foreach (var item in subFilterItems)
                        {
                            <label class="dk-beauty-checkbox-label">
                                <input type="checkbox" class="dk-beauty-filter-cb" data-filter="type" value="@item" onchange="beautyTriggerFilter()">
                                <span class="dk-beauty-cb-custom"></span>
                                <span class="dk-beauty-cb-text">@item</span>
                            </label>
                        }
                        @foreach (var form in formulationsList.Where(f => !subFilterItems.Any(s => string.Equals(s, f, StringComparison.OrdinalIgnoreCase))))
                        {
                            <label class="dk-beauty-checkbox-label">
                                <input type="checkbox" class="dk-beauty-filter-cb" data-filter="type" value="@form" onchange="beautyTriggerFilter()">
                                <span class="dk-beauty-cb-custom"></span>
                                <span class="dk-beauty-cb-text">@form</span>
                            </label>
                        }
                    </div>
                </div>
            }

            <!-- Filter Group 4: Price Range -->
            <div class="dk-beauty-filter-box">
                <h4 class="dk-beauty-filter-title">
                    <span>Price Range</span>
                </h4>
                <div class="dk-beauty-filter-options-list">
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_price" value="all" checked onchange="beautySetPriceRange(0, 999999)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">All Prices</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_price" value="under-299" onchange="beautySetPriceRange(0, 299)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">Under ₹299</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_price" value="299-599" onchange="beautySetPriceRange(299, 599)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">₹299 – ₹599</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_price" value="599-999" onchange="beautySetPriceRange(599, 999)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">₹599 – ₹999</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_price" value="above-1000" onchange="beautySetPriceRange(1000, 999999)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">₹1,000 &amp; Above</span>
                    </label>
                </div>

                <!-- Custom Min/Max Inputs -->
                <div class="dk-beauty-custom-price-row">
                    <div class="dk-beauty-price-input-wrap">
                        <span class="dk-beauty-currency">₹</span>
                        <input type="number" id="beautyMinPriceInput" placeholder="Min" min="0" class="dk-beauty-price-inp">
                    </div>
                    <span class="dk-beauty-price-dash">–</span>
                    <div class="dk-beauty-price-input-wrap">
                        <span class="dk-beauty-currency">₹</span>
                        <input type="number" id="beautyMaxPriceInput" placeholder="Max" min="0" class="dk-beauty-price-inp">
                    </div>
                    <button type="button" class="dk-beauty-btn-price-go" onclick="beautyApplyCustomPrice()">Go</button>
                </div>
            </div>

            <!-- Filter Group 5: Discount -->
            <div class="dk-beauty-filter-box">
                <h4 class="dk-beauty-filter-title">
                    <span>Discount</span>
                </h4>
                <div class="dk-beauty-filter-options-list">
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_discount" value="0" checked onchange="beautySetMinDiscount(0)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">Any Discount</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_discount" value="20" onchange="beautySetMinDiscount(20)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">20% or more</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_discount" value="30" onchange="beautySetMinDiscount(30)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">30% or more</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_discount" value="40" onchange="beautySetMinDiscount(40)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">40% or more</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_discount" value="50" onchange="beautySetMinDiscount(50)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">50% or more</span>
                    </label>
                </div>
            </div>

            <!-- Filter Group 6: Customer Rating -->
            <div class="dk-beauty-filter-box">
                <h4 class="dk-beauty-filter-title">
                    <span>Customer Rating</span>
                </h4>
                <div class="dk-beauty-filter-options-list">
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_rating" value="0" checked onchange="beautySetMinRating(0)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">Any Rating</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_rating" value="4.5" onchange="beautySetMinRating(4.5)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">4.5★ &amp; Above</span>
                    </label>
                    <label class="dk-beauty-radio-label">
                        <input type="radio" name="beauty_side_rating" value="4.0" onchange="beautySetMinRating(4.0)">
                        <span class="dk-beauty-radio-custom"></span>
                        <span class="dk-beauty-cb-text">4.0★ &amp; Above</span>
                    </label>
                </div>
            </div>

            <!-- Filter Group 7: Availability -->
            <div class="dk-beauty-filter-box">
                <div class="dk-beauty-switch-row">
                    <span class="dk-beauty-filter-title" style="margin: 0;">In-Stock Only</span>
                    <label class="dk-beauty-toggle-switch">
                        <input type="checkbox" id="beautyInStockToggle" onchange="beautyTriggerFilter()">
                        <span class="dk-beauty-slider round"></span>
                    </label>
                </div>
            </div>

        </aside>

        <!-- RIGHT SIDE: PRODUCTS CATALOG & TOOLBAR -->
        <main class="dk-beauty-catalog">

            <!-- Toolbar: Search, Count & Sort -->
            <div class="dk-beauty-catalog-toolbar">
                <div class="dk-beauty-toolbar-left">
                    <span class="dk-beauty-results-count" id="beautyResultsCount">
                        Showing <strong>@(totalProductsCount)</strong> verified products in @activeSubcatName
                    </span>
                </div>

                <div class="dk-beauty-toolbar-right">
                    <!-- Search input inside subcategory -->
                    <div class="dk-beauty-search-wrap">
                        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
                        <input type="text" id="beautySearchInput" placeholder="Search @activeSubcatName models &amp; specs..." oninput="beautyOnSearchChange(this.value)">
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="dk-beauty-sort-wrap">
                        <label for="beautySortSelect" class="dk-beauty-sort-lbl">Sort by:</label>
                        <select id="beautySortSelect" class="dk-beauty-sort-select" onchange="beautyApplySort(this.value)">
                            <option value="popularity">Popularity</option>
                            <option value="price-asc">Price: Low to High</option>
                            <option value="price-desc">Price: High to Low</option>
                            <option value="rating">Customer Rating</option>
                            <option value="discount">Highest Discount</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Products Grid with BIG IMAGE FRAMES -->
            <div class="dk-beauty-cards-grid" id="beautyCatalogGrid">

                @foreach (var prod in products)
                {
                    var brandName = !string.IsNullOrWhiteSpace(prod.Brand) ? prod.Brand : activeSubcatName;
                    var isUploadSoon = prod.IsUploadingSoon || string.IsNullOrWhiteSpace(prod.ImageUrl) || prod.ImageUrl.Contains("placeholder");

                    <div class="dk-beauty-card"
                         data-name="@prod.Name.ToLowerInvariant()"
                         data-brand="@brandName.ToLowerInvariant()"
                         data-type="@(prod.SubcategoryTag.ToLowerInvariant() + " " + prod.Formulation.ToLowerInvariant())"
                         data-price="@prod.Price"
                         data-discount="@prod.DiscountPercent"
                         data-rating="@prod.Rating"
                         data-instock="@(prod.InStock ? "true" : "false")">

                        @if (prod.DiscountPercent >= 15)
                        {
                            <span class="dk-beauty-badge-corner">@prod.DiscountPercent% OFF</span>
                        }
                        else
                        {
                            <span class="dk-beauty-badge-corner rose">VERIFIED</span>
                        }

                        <!-- BIG IMAGE FRAME (min-height: 320px) -->
                        <div class="dk-beauty-img-frame" title="@prod.Name">
                            @if (isUploadSoon)
                            {
                                <div class="dk-beauty-radar-placeholder">
                                    <div class="dk-beauty-radar-animation">
                                        <span class="dk-beauty-pulse-ring r1"></span>
                                        <span class="dk-beauty-pulse-ring r2"></span>
                                        <span class="dk-beauty-prod-emoji">@activeSubcatEmoji</span>
                                    </div>
                                    <div class="dk-beauty-prod-soon-tag">
                                        <span class="dk-beauty-mini-dot">●</span> UPLOADING SOON
                                    </div>
                                    <span class="dk-beauty-prod-soon-sub">Images will be uploaded by admin</span>
                                </div>
                            }
                            else
                            {
                                <img src="@prod.ImageUrl"
                                     alt="@prod.Name"
                                     loading="lazy"
                                     class="dk-beauty-prod-img"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="dk-beauty-radar-placeholder" style="display: none;">
                                    <div class="dk-beauty-radar-animation">
                                        <span class="dk-beauty-pulse-ring r1"></span>
                                        <span class="dk-beauty-pulse-ring r2"></span>
                                        <span class="dk-beauty-prod-emoji">@activeSubcatEmoji</span>
                                    </div>
                                    <div class="dk-beauty-prod-soon-tag">
                                        <span class="dk-beauty-mini-dot">●</span> UPLOADING SOON
                                    </div>
                                    <span class="dk-beauty-prod-soon-sub">Images will be uploaded by admin</span>
                                </div>
                            }
                        </div>

                        <!-- Product Details Body -->
                        <div class="dk-beauty-card-body">
                            <div class="dk-beauty-card-meta">
                                <span class="dk-beauty-chip-brand">@brandName</span>
                                <span class="dk-beauty-chip-cat">@activeSubcatName</span>
                            </div>

                            <span class="dk-beauty-card-title" title="@prod.Name">
                                @prod.Name
                            </span>

                            @if (!string.IsNullOrWhiteSpace(prod.Formulation) || !string.IsNullOrWhiteSpace(prod.Finish))
                            {
                                <div class="dk-beauty-specs-chip">
                                    ⚡ @(string.IsNullOrWhiteSpace(prod.Formulation) ? prod.Finish : prod.Formulation + (string.IsNullOrWhiteSpace(prod.Finish) ? "" : " • " + prod.Finish))
                                </div>
                            }

                            <div class="dk-beauty-rating-row">
                                <div class="dk-beauty-stars">★★★★★</div>
                                <span class="dk-beauty-rating-val">@prod.Rating.ToString("0.0")</span>
                                <span class="dk-beauty-rating-count">(@prod.ReviewsCount reviews)</span>
                            </div>

                            <div class="dk-beauty-pricing-row">
                                <span class="dk-beauty-price-current">₹@prod.Price.ToString("N0")</span>
                                @if (prod.OriginalPrice > prod.Price)
                                {
                                    <span class="dk-beauty-price-mrp">₹@prod.OriginalPrice.ToString("N0")</span>
                                    <span class="dk-beauty-price-disc">@prod.DiscountPercent% off</span>
                                }
                            </div>

                            <div class="dk-beauty-stock-line">
                                <span class="dk-beauty-stock-dot"></span>
                                <span>In Stock &bull; Dermatologically Tested</span>
                            </div>

                            <!-- Action Buttons -->
                            <div class="dk-beauty-actions-row">
                                <button type="button"
                                        class="dk-beauty-btn-add-cart"
                                        onclick="beautyAddToCart('@prod.Id', '@prod.Name.Replace("'", "\\'")', @prod.Price, this)">
                                    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.24-1.2A1 1 0 005.06 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg>
                                    <span>Add to Cart</span>
                                </button>
                                <a href="/category/beauty/@activeCatSlug" class="dk-beauty-btn-details" title="View in @activeCatName">
                                    View
                                </a>
                            </div>
                        </div>

                    </div>
                }

            </div>

            <!-- Empty Results State -->
            <div id="beautyEmptyResults" class="dk-beauty-empty-box" style="display: none;">
                <div class="dk-beauty-empty-icon">🔍</div>
                <h3 class="dk-beauty-empty-title">No products match your filters</h3>
                <p class="dk-beauty-empty-desc">Try clearing your filters or adjusting your price/brand selection to see all available beauty essentials in @activeSubcatName.</p>
                <button type="button" class="dk-beauty-btn-reset-empty" onclick="beautyResetAllFilters()">
                    ↺ Reset All Filters
                </button>
            </div>

        </main>

    </div>

