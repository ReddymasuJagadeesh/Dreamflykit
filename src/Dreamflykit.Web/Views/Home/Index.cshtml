                    <p class="dk-section-description">
                        Essential kits specially curated for students
                        traveling to top study destinations.
                    </p>

                </div>

                <a href="/Kits/FindMyKit"
                   class="dk-view-all">

                    Find My Kit →

                </a>

            </div>

        </div>


        <div class="dk-country-grid">


            <a href="/kits/USA"
               class="dk-country-card">

                <img src="~/images/countries/usa.webp"
                     alt="USA Kit"
                     class="dk-country-image" />

                <div class="dk-country-content">

                    <h3>USA</h3>

                    <p class="dk-country-description">
                        Study in the Land of Opportunities
                    </p>

                    <div class="dk-country-price">
                        From ₹4,999
                    </div>

                </div>

            </a>


            <a href="/kits/UK"
               class="dk-country-card">

                <img src="~/images/countries/uk.webp"
                     alt="UK Kit"
                     class="dk-country-image" />

                <div class="dk-country-content">

                    <h3>UK</h3>

                    <p class="dk-country-description">
                        Experience World-Class Education
                    </p>

                    <div class="dk-country-price">
                        From ₹4,499
                    </div>

                </div>

            </a>


            <a href="/kits/Canada"
               class="dk-country-card">

                <img src="~/images/countries/canada.webp"
                     alt="Canada Kit"
                     class="dk-country-image" />

                <div class="dk-country-content">

                    <h3>Canada</h3>

                    <p class="dk-country-description">
                        Your Future, Our Essentials
                    </p>

                    <div class="dk-country-price">
                        From ₹4,499
                    </div>

                </div>

            </a>


            <a href="/kits/Australia"
               class="dk-country-card">

                <img src="~/images/countries/australia.webp"
                     alt="Australia Kit"
                     class="dk-country-image" />

                <div class="dk-country-content">

                    <h3>Australia</h3>

                    <p class="dk-country-description">
                        Discover. Learn. Grow Abroad.
                    </p>

                    <div class="dk-country-price">
                        From ₹4,999
                    </div>

                </div>

            </a>


            <a href="/kits/Germany"
               class="dk-country-card">

                <img src="~/images/countries/germany.webp"
                     alt="Germany Kit"
                     class="dk-country-image" />

                <div class="dk-country-content">

                    <h3>Germany</h3>

                    <p class="dk-country-description">
                        Excellence in Education Awaits
                    </p>

                    <div class="dk-country-price">
                        From ₹4,999
                    </div>

                </div>

            </a>


            <a href="/kits/Ireland"
               class="dk-country-card">

                <img src="~/images/countries/ireland.webp"
                     alt="Ireland Kit"
                     class="dk-country-image" />

                <div class="dk-country-content">

                    <h3>Ireland</h3>

                    <p class="dk-country-description">
                        Your Gateway to Global Success
                    </p>

                    <div class="dk-country-price">
                        From ₹4,499
                    </div>

                </div>

            </a>


        </div>

    </section>


    <!-- =====================================================
         SHOP BY CATEGORY
    ====================================================== -->

    <section class="dk-section">


        <div class="dk-section-header">

            <div class="dk-section-header-row">

                <div>

                    <h2 class="dk-section-title">
                        Shop By Category
                    </h2>

                    <p class="dk-section-description">
                        Find everything you need in one place.
                    </p>

                </div>

                <a href="/Categories"
                   class="dk-view-all">

                    View All Categories →

                </a>

            </div>

        </div>


        <div class="dk-category-grid-home">
            @if (Model.Categories != null && Model.Categories.Any())
            {
                @foreach (var category in Model.Categories)
                {
                    <a href="/category/@category.Slug" class="dk-category-card-home">
                        <div class="dk-category-placeholder" style="overflow: hidden; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                            {
                                <img src="@category.ImageUrl" alt="@category.Name" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                            }
                            else
                            {
                                <span>🛍️</span>
                            }
                        </div>
                        <h3>@category.Name</h3>
                    </a>
                }
            }
            else
            {
                <a href="/categories" class="dk-category-card-home">
                    <div class="dk-category-placeholder">🛍️</div>
                    <h3>Explore<br />All Categories</h3>
                </a>
            }
        </div>

    </section>


    <!-- =====================================================
         FLIPKART STYLE PRODUCT SHOWCASE 1: TRENDING DEALS
    ====================================================== -->

    @if (Model.TrendingDeals != null && Model.TrendingDeals.Any())
    {
        <section class="dk-fk-showcase-section">

            <div class="dk-fk-showcase-header">
                <div class="dk-fk-header-left">
                    <div class="dk-fk-badge">⚡ TOP DEALS</div>
                    <div>
                        <h2 class="dk-fk-title">@Model.TrendingDealsTitle</h2>
                        <p class="dk-fk-subtitle">@Model.TrendingDealsSubtitle</p>
                    </div>
                </div>

                <div class="dk-fk-header-right">
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Products" class="dk-fk-admin-edit-btn" title="Manage which products appear here">
                            ⚙ Manage Products
                        </a>
                    }
                    <a href="/products?sort=DiscountHighToLow" class="dk-fk-view-all-btn">
                        VIEW ALL DEALS →
                    </a>
                </div>
            </div>

            <!-- Flipkart Products Shelf / Grid -->
            <div class="dk-fk-products-grid">
                @foreach (var product in Model.TrendingDeals)
                {
                    var discount = (int)product.DiscountPercentage;
                    var img = string.IsNullOrWhiteSpace(product.PrimaryImageUrl)
                        ? (string.IsNullOrWhiteSpace(product.ImageUrl) ? "/images/products/product-placeholder.webp" : product.ImageUrl)
                        : product.PrimaryImageUrl;

                    <article class="dk-fk-card" data-variant-id="@product.DefaultVariantId">
                        
                        <!-- Badges & Wishlist -->
                        <div class="dk-fk-card-top">
                            @if (discount >= 30)
                            {
                                <span class="dk-fk-tag dk-fk-tag-hot">@discount% OFF</span>
                            }
                            else if (product.IsFeatured)
                            {
                                <span class="dk-fk-tag dk-fk-tag-feat">FEATURED</span>
                            }
                            else
                            {
                                <span class="dk-fk-tag dk-fk-tag-deal">SPECIAL</span>
                            }

                            <button type="button" 
                                    class="dk-wishlist-toggle-btn dk-fk-wishlist-btn" 
                                    data-variant-id="@product.DefaultVariantId"
                                    title="Save to Wishlist" 
                                    aria-label="Wishlist">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                                </svg>
                            </button>
                        </div>

                        <!-- Card Content Link -->
                        <a href="/Products/@product.Slug" class="dk-fk-card-link">
                            <div class="dk-fk-img-box">
                                <img src="@img"
                                     alt="@product.Name"
                                     loading="lazy"
                                     decoding="async"
                                     class="dk-fk-img"
                                     onerror="this.onerror=null;this.src='/images/products/product-placeholder.webp';" />
                            </div>

                            <div class="dk-fk-details">
                                <h3 class="dk-fk-name" title="@product.Name">@product.Name</h3>

                                <!-- Rating Row -->
                                <div class="dk-fk-rating-row">
                                    <span class="dk-fk-star-pill">4.4 ★</span>
                                    <span class="dk-fk-rating-count">(94)</span>
                                    <span class="dk-fk-assured-tag">✓ Student Pick</span>
                                </div>

                                <!-- Pricing Row -->
                                <div class="dk-fk-price-row">
                                    <span class="dk-fk-selling-price">₹@product.SellingPrice.ToString("N0")</span>
                                    @if (product.Mrp > product.SellingPrice)
                                    {
                                        <span class="dk-fk-mrp">₹@product.Mrp.ToString("N0")</span>
                                        <span class="dk-fk-discount-txt">@discount% off</span>
                                    }
                                </div>
                            </div>
                        </a>

                        <!-- Quick Add To Cart Form -->
                        <div class="dk-fk-card-footer">
                            <form asp-controller="Cart" asp-action="Add" method="post" class="dk-fk-add-cart-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductVariantId" value="@product.DefaultVariantId" />
                                <input type="hidden" name="Quantity" value="1" />
                                <button type="submit" class="dk-fk-cart-btn">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <circle cx="8" cy="21" r="1"></circle>
                                        <circle cx="19" cy="21" r="1"></circle>
                                        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                                    </svg>
                                    <span>Add to Cart</span>
                                </button>
                            </form>
                        </div>

                    </article>
                }
            </div>

        </section>
    }


    <!-- =====================================================
         FLIPKART STYLE PRODUCT SHOWCASE 2: BEST OF ESSENTIALS
    ====================================================== -->

    @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
    {
        <section class="dk-fk-showcase-section">

            <div class="dk-fk-showcase-header">
                <div class="dk-fk-header-left">
                    <div class="dk-fk-badge dk-fk-badge-blue">★ BEST SELLERS</div>
                    <div>
                        <h2 class="dk-fk-title">@Model.FeaturedProductsTitle</h2>
                        <p class="dk-fk-subtitle">@Model.FeaturedProductsSubtitle</p>
                    </div>
                </div>

                <div class="dk-fk-header-right">
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Products" class="dk-fk-admin-edit-btn" title="Toggle featured status for products">
                            ⚙ Choose Featured Items
                        </a>
                    }
                    <a href="/products" class="dk-fk-view-all-btn">
                        VIEW ALL PRODUCTS →
                    </a>
                </div>
            </div>

            <!-- Flipkart Products Shelf / Grid -->
            <div class="dk-fk-products-grid">
                @foreach (var product in Model.FeaturedProducts)
                {
                    var discount = (int)product.DiscountPercentage;
                    var img = string.IsNullOrWhiteSpace(product.PrimaryImageUrl)
                        ? (string.IsNullOrWhiteSpace(product.ImageUrl) ? "/images/products/product-placeholder.webp" : product.ImageUrl)
                        : product.PrimaryImageUrl;

                    <article class="dk-fk-card" data-variant-id="@product.DefaultVariantId">
                        
                        <!-- Badges & Wishlist -->
                        <div class="dk-fk-card-top">
                            @if (product.IsFeatured)
                            {
                                <span class="dk-fk-tag dk-fk-tag-feat">TOP RATED</span>
                            }
                            else if (discount > 0)
                            {
                                <span class="dk-fk-tag dk-fk-tag-deal">@discount% OFF</span>
                            }
                            else
                            {
                                <span class="dk-fk-tag dk-fk-tag-deal">POPULAR</span>
                            }

                            <button type="button" 
                                    class="dk-wishlist-toggle-btn dk-fk-wishlist-btn" 
                                    data-variant-id="@product.DefaultVariantId"
                                    title="Save to Wishlist" 
                                    aria-label="Wishlist">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                                </svg>
                            </button>
                        </div>

                        <!-- Card Content Link -->
                        <a href="/Products/@product.Slug" class="dk-fk-card-link">
                            <div class="dk-fk-img-box">
                                <img src="@img"
                                     alt="@product.Name"
                                     loading="lazy"
                                     decoding="async"
                                     class="dk-fk-img"
                                     onerror="this.onerror=null;this.src='/images/products/product-placeholder.webp';" />
                            </div>

                            <div class="dk-fk-details">
                                <h3 class="dk-fk-name" title="@product.Name">@product.Name</h3>

                                <!-- Rating Row -->
                                <div class="dk-fk-rating-row">
                                    <span class="dk-fk-star-pill">4.5 ★</span>
                                    <span class="dk-fk-rating-count">(112)</span>
                                    <span class="dk-fk-assured-tag">✓ Genuine</span>
                                </div>

                                <!-- Pricing Row -->
                                <div class="dk-fk-price-row">
                                    <span class="dk-fk-selling-price">₹@product.SellingPrice.ToString("N0")</span>
                                    @if (product.Mrp > product.SellingPrice)
                                    {
                                        <span class="dk-fk-mrp">₹@product.Mrp.ToString("N0")</span>
                                        <span class="dk-fk-discount-txt">@discount% off</span>
                                    }
                                </div>
                            </div>
                        </a>

                        <!-- Quick Add To Cart Form -->
                        <div class="dk-fk-card-footer">
                            <form asp-controller="Cart" asp-action="Add" method="post" class="dk-fk-add-cart-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductVariantId" value="@product.DefaultVariantId" />
                                <input type="hidden" name="Quantity" value="1" />
                                <button type="submit" class="dk-fk-cart-btn">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <circle cx="8" cy="21" r="1"></circle>
                                        <circle cx="19" cy="21" r="1"></circle>
                                        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                                    </svg>
                                    <span>Add to Cart</span>
                                </button>
                            </form>
                        </div>

                    </article>
                }
            </div>

        </section>
    }


    <!-- =====================================================
         BOTTOM BENEFITS
    ====================================================== -->

    <section class="dk-bottom-benefits">


        <div class="dk-bottom-benefit">

            <span class="dk-bottom-benefit-icon">
                🚚
            </span>

            <div>

                <strong>
                    Worldwide Shipping
                </strong>

                <span>
                    Delivering across destinations
                </span>

            </div>

        </div>


        <div class="dk-bottom-benefit">

            <span class="dk-bottom-benefit-icon">
                🛡
            </span>

            <div>

                <strong>
                    100% Secure Payments
                </strong>

                <span>
                    Safe checkout
                </span>

            </div>

        </div>


        <div class="dk-bottom-benefit">

            <span class="dk-bottom-benefit-icon">
                ★
            </span>

            <div>

                <strong>
                    Premium Quality
                </strong>

                <span>
                    Genuine products
                </span>

            </div>

        </div>


        <div class="dk-bottom-benefit">

            <span class="dk-bottom-benefit-icon">
                ♧
            </span>

            <div>

                <strong>
                    24/7 Customer Support
                </strong>

                <span>
                    We're here to help
                </span>

            </div>

        </div>


        <div class="dk-bottom-benefit">

            <span class="dk-bottom-benefit-icon">
                📦
            </span>

            <div>

                <strong>
                    Easy Returns & Refunds
                </strong>

                <span>
                    Simple return process
                </span>

            </div>

        </div>


    </section>


</div>

@section Scripts {
<script>
(function() {
    const slider = document.getElementById('dkHeroSlider');
    if (!slider) return;

    const track = document.getElementById('heroTrack');
    const slides = Array.from(slider.querySelectorAll('.dk-hero-slide'));
    const prevBtn = document.getElementById('heroPrevBtn');
    const nextBtn = document.getElementById('heroNextBtn');
    const dots = Array.from(slider.querySelectorAll('.dk-hero-dot'));
    const timeBar = document.getElementById('heroTimeBar');

    const totalSlides = slides.length;
    if (totalSlides <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        const dotsNav = document.getElementById('heroDotsNav');
        if (dotsNav) dotsNav.style.display = 'none';
        const timeInd = slider.querySelector('.dk-hero-time-indicator');
        if (timeInd) timeInd.style.display = 'none';
        return;
    }

    let currentIndex = 0;
    const SLIDE_DURATION = @(Model.SlideDurationSeconds * 1000); // Admin configured slide timeframe
    const AUTO_PLAY = @(Model.AutoPlay ? "true" : "false");
    let timerStartTime = Date.now();
    let isPaused = !AUTO_PLAY;
    let animFrameId = null;

    if (!AUTO_PLAY) {
        const timeInd = slider.querySelector('.dk-hero-time-indicator');
        if (timeInd) timeInd.style.display = 'none';
    }

    function goToSlide(index) {
        if (index < 0) {
            currentIndex = totalSlides - 1;
        } else if (index >= totalSlides) {
            currentIndex = 0;
        } else {
            currentIndex = index;
        }

        // Slide track smoothly with cubic-bezier transition
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        // Update active slide classes and attributes
        slides.forEach((s, idx) => {
            const isActive = idx === currentIndex;
            s.classList.toggle('is-active', isActive);
            const link = s.querySelector('.dk-hero-slide-link');
            if (link) link.setAttribute('tabindex', isActive ? '0' : '-1');
        });

        // Update dots state
        dots.forEach((dot, idx) => {
            const isActive = idx === currentIndex;
            dot.classList.toggle('active', isActive);
            dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        resetTimer();
    }

    function resetTimer() {
        timerStartTime = Date.now();
        if (timeBar) {
            timeBar.style.width = '0%';
        }
    }

    function tick() {
        if (!isPaused) {
            const elapsed = Date.now() - timerStartTime;
            const progress = Math.min(100, (elapsed / SLIDE_DURATION) * 100);

            if (timeBar) {
                timeBar.style.width = progress + '%';
            }

            if (elapsed >= SLIDE_DURATION) {
                goToSlide(currentIndex + 1);
            }
        }
        animFrameId = requestAnimationFrame(tick);
    }

    // Side Arrow Controls
    if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(currentIndex - 1);
        });
    }

    if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(currentIndex + 1);
        });
    }

    // Dots Navigation
    dots.forEach((dot, idx) => {
        dot.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(idx);
        });
    });

    // Pause on Hover
    slider.addEventListener('mouseenter', function() {
        isPaused = true;
    });

    slider.addEventListener('mouseleave', function() {
        isPaused = false;
        const currentPct = parseFloat(timeBar ? timeBar.style.width : 0) || 0;
        timerStartTime = Date.now() - (currentPct / 100 * SLIDE_DURATION);
    });

    // Keyboard navigation (Left / Right Arrow)
    slider.setAttribute('tabindex', '0');
    slider.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft') {
            e.preventDefault();
            goToSlide(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            goToSlide(currentIndex + 1);
        }
    });

    // Mobile Swipe Gesture Support
    let touchStartX = 0;
    let touchEndX = 0;
    slider.addEventListener('touchstart', function(e) {
        if (e.changedTouches && e.changedTouches.length > 0) {
            touchStartX = e.changedTouches[0].screenX;
            isPaused = true;
        }
    }, { passive: true });

    slider.addEventListener('touchend', function(e) {
        if (e.changedTouches && e.changedTouches.length > 0) {
            touchEndX = e.changedTouches[0].screenX;
            isPaused = false;
            const diff = touchEndX - touchStartX;
            if (Math.abs(diff) > 45) {
                if (diff < 0) {
                    goToSlide(currentIndex + 1);
                } else {
                    goToSlide(currentIndex - 1);
                }
            }
        }
    }, { passive: true });

    // Page Visibility handling
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            isPaused = true;
        } else {
            isPaused = false;
            resetTimer();
        }
    });

    // Start auto-slide loop
    resetTimer();
    animFrameId = requestAnimationFrame(tick);
})();
</script>
}