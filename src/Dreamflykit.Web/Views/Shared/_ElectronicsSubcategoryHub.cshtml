                                    {
                                        <span class="dk-elec-price-mrp">₹@prod.OriginalPrice.ToString("N0")</span>
                                        <span class="dk-elec-price-disc">@prod.DiscountPercent% off</span>
                                    }
                                </div>

                                <div class="dk-elec-stock-line">
                                    <span class="dk-elec-stock-dot"></span>
                                    <span>In Stock &bull; Campus Voltage Certified</span>
                                </div>

                                <!-- Action Buttons -->
                                <div class="dk-elec-actions-row">
