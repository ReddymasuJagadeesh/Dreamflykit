    <!-- =====================================================
         CATEGORY NAVIGATION (WHITE LINE BELOW ORANGE BAR)
         Shown only for Dreamflykit Store profile.
         For Study Abroad Hub profile: Categories removed and empty space shown as requested.
    ====================================================== -->
    @if (!isAbroadHub)
    {
        <nav class="dk-category-nav">

            <div class="dk-shell dk-category-nav-inner">

                <a href="/"
                   class="dk-category-link @(currentReqPath == "/" ? "dk-category-active" : "")">
                    <span>🏠</span>
                    Home
                </a>

                @if (navCategories != null && navCategories.Count > 0)
                {
                    @foreach (var cat in navCategories.OrderBy(c => c.DisplayOrder))
                    {
                        var isCatActive = !string.IsNullOrEmpty(activeCatSlug) &&
                                          string.Equals(activeCatSlug, cat.Slug, StringComparison.OrdinalIgnoreCase);
                        <a href="/category/@cat.Slug"
                           class="dk-category-link @(isCatActive ? "dk-category-active" : "")"
                           title="@cat.Name">
                            <span>@getCatEmoji(cat.Slug)</span>
                            @cat.Name
                        </a>
                    }
                }
                else
                {
                    <a href="/category/study-essentials" class="dk-category-link @(activeCatSlug == "study-essentials" ? "dk-category-active" : "")">
                        <span>🎓</span> Study Essentials
                    </a>
                    <a href="/category/fashion" class="dk-category-link @(activeCatSlug == "fashion" ? "dk-category-active" : "")">
                        <span>👗</span> Fashion
                    </a>
                    <a href="/category/travel-gear" class="dk-category-link @(activeCatSlug == "travel-gear" ? "dk-category-active" : "")">
                        <span>✈</span> Travel Gear
                    </a>
                    <a href="/category/mobiles" class="dk-category-link @(activeCatSlug == "mobiles" ? "dk-category-active" : "")">
                        <span>📱</span> Mobiles
                    </a>
                    <a href="/category/electronics" class="dk-category-link @(activeCatSlug == "electronics" ? "dk-category-active" : "")">
                        <span>💻</span> Electronics
                    </a>
                    <a href="/category/appliances" class="dk-category-link @(activeCatSlug == "appliances" ? "dk-category-active" : "")">
                        <span>🔌</span> Appliances
                    </a>
                    <a href="/category/beauty" class="dk-category-link @(activeCatSlug == "beauty" ? "dk-category-active" : "")">
                        <span>💄</span> Beauty
                    </a>
                    <a href="/category/health-care" class="dk-category-link @(activeCatSlug == "health-care" ? "dk-category-active" : "")">
                        <span>💊</span> Health Care
                    </a>
                    <a href="/category/food" class="dk-category-link @(activeCatSlug == "food" ? "dk-category-active" : "")">
                        <span>🍫</span> Food
                    </a>
                    <a href="/category/room-living" class="dk-category-link @(activeCatSlug == "room-living" ? "dk-category-active" : "")">
                        <span>🛋️</span> Room & Living
                    </a>
                    <a href="/category/kitchen-appliances" class="dk-category-link @(activeCatSlug == "kitchen-appliances" ? "dk-category-active" : "")">
                        <span>🍳</span> Kitchen Appliances
                    </a>
                    <a href="/category/story-books" class="dk-category-link @(activeCatSlug == "story-books" ? "dk-category-active" : "")">
                        <span>📚</span> Story Books
                    </a>
                    <a href="/category/premium-hub" class="dk-category-link @(activeCatSlug == "premium-hub" ? "dk-category-active" : "")">
                        <span>⭐</span> Premium Hub
                    </a>
                    <a href="/category/gaming-hub" class="dk-category-link @(activeCatSlug == "gaming-hub" ? "dk-category-active" : "")">
                        <span>🎮</span> Gaming Hub
                    </a>
                    <a href="/category/sports-hub" class="dk-category-link @(activeCatSlug == "sports-hub" ? "dk-category-active" : "")">
                        <span>⚽</span> Sports Hub
                    </a>
                }

                <a href="/products?minDiscount=20"
                   class="dk-category-link @(isOffersZone ? "dk-category-active" : "")">
                    <span>★</span>
                    Offers Zone
                </a>

                <a href="/Kits/FindMyKit"
                   class="dk-find-kit">
                    <span>🎒</span>
                    Find My Kit
                </a>

            </div>

        </nav>
    }
    else
    {
        <!-- Study Abroad Hub Profile: Category bar removed, showing clean empty space for now -->
        <div class="dk-category-nav-empty" aria-hidden="true" style="min-height: 12px; background: #ffffff;"></div>
    }


    <!-- MOBILE MENU -->

    <div id="mobileNavigation"
         class="dk-mobile-navigation">

        <a href="/">Home</a>
        <a href="/products">All Products</a>
        <a href="/categories">All Categories</a>

        @if (navCategories != null && navCategories.Count > 0)
        {
            @foreach (var cat in navCategories.OrderBy(c => c.DisplayOrder))
            {
                <a href="/category/@cat.Slug">@getCatEmoji(cat.Slug) @cat.Name</a>
            }
        }

        <a href="/About">About Us</a>

        <a href="/Contact">Contact Us</a>

        <a href="/Consultancy">Consultancy</a>

        <a href="/EducationLoans">Education Loans</a>

        <a href="/Kits/FindMyKit"
           class="dk-mobile-find-kit">
            Find My Kit
        </a>

    </div>

</header>