    }
    .dk-rates-table tbody tr:hover {
        background: #f0f7ff;
    }
    .dk-rates-table td {
        padding: 14px 20px;
        vertical-align: middle;
    }
    .dk-rate-param {
        font-weight: 700;
        color: #0f172a;
    }
    .dk-rate-details-highlight {
        color: #0A58A2;
