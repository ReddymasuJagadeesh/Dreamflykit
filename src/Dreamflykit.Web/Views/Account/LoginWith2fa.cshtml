@model Dreamflykit.Web.Models.Account.LoginWith2faViewModel
@{
    ViewData["Title"] = "Two-Factor Verification — Dreamflykit";
    Layout = "_Layout";
}

<div class="dk-auth-page-wrapper">
    <div class="dk-auth-card-container">
        <!-- Brand Panel (Left) -->
        <div class="dk-auth-brand-panel">
            <div class="dk-auth-brand-badge">
                <img src="~/images/branding/dreamflykit-logo.webp"
                     alt="Dreamflykit"
                     class="dk-auth-logo-img" />
            </div>
            <h2 class="dk-auth-tagline">
                Two-Factor<br />Authentication
            </h2>
            <p class="dk-auth-subtitle">
                Your account is protected with an additional layer of security.
            </p>
        </div>

        <!-- Form Panel (Right) -->
        <div class="dk-auth-form-panel">
            <div class="dk-auth-form-inner">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Security Verification</h1>
                <p class="text-sm text-gray-500 mb-6">
                    Enter the 6-digit code from your authenticator application.
                </p>

                <form asp-action="LoginWith2fa" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RememberMe" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="All" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div>
                        <label asp-for="TwoFactorCode" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="TwoFactorCode" 
                               autocomplete="one-time-code"
                               maxlength="7"
                               placeholder="123456"
                               autofocus
                               class="w-full text-center tracking-widest text-2xl font-mono px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500" />
                        <span asp-validation-for="TwoFactorCode" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div class="flex items-center">
                        <input asp-for="RememberMachine" class="h-4 w-4 text-orange-600 focus:ring-orange-500 border-gray-300 rounded" />
                        <label asp-for="RememberMachine" class="ml-2 block text-sm text-gray-700">Remember this device</label>
                    </div>

                    <button type="submit" 
                            class="w-full py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-orange-600 hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 transition-colors">
                        Verify and Sign In
                    </button>

                    <div class="text-center pt-2">
                        <a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-xs text-orange-600 hover:underline">
                            Don't have access to your authenticator? Use a recovery code
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

