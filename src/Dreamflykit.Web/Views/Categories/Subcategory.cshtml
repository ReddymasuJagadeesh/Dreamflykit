@model Dreamflykit.Web.Models.Categories.SubcategoryDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Dreamflykit";
}

<main class="min-h-screen bg-slate-50">

    <!-- Breadcrumb -->
    <section class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
            <nav class="text-sm text-slate-500">
                <a asp-controller="Home" asp-action="Index" class="transition hover:text-blue-700">Home</a>
                <span class="mx-2">/</span>
                <a asp-controller="Categories" asp-action="Index" class="transition hover:text-blue-700">Categories</a>
                <span class="mx-2">/</span>
                <a asp-controller="Categories" asp-action="Details" asp-route-slug="@Model.CategorySlug" class="transition hover:text-blue-700">@Model.CategoryName</a>
                <span class="mx-2">/</span>
                <span class="font-semibold text-slate-800">@Model.Name</span>
            </nav>
        </div>
    </section>

    <!-- Subcategory Header -->
    <section class="bg-white border-b border-slate-100">
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="max-w-2xl">
                <p class="text-sm font-bold uppercase tracking-wider text-orange-500">
                    Dreamflykit Subcategory
                </p>
                <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-blue-950 sm:text-4xl">
                    @Model.Name
                </h1>
                <p class="mt-2 text-base text-slate-600">
                    Browsing @Model.ProductCount curated @(Model.ProductCount == 1 ? "product" : "products") in this subcategory.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="w-28 h-28 md:w-36 md:h-36 rounded-2xl overflow-hidden border border-slate-200 shadow-sm shrink-0 bg-slate-50 flex items-center justify-center">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/categories/category-placeholder.webp';" />
                </div>
            }
        </div>
    </section>

    <!-- Products Grid -->
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        @if (Model.Products == null || !Model.Products.Any())
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center">
                <div style="font-size: 3rem; margin-bottom: 1rem;">📦</div>
                <h3 class="text-lg font-bold text-slate-900">
                    No products found in @Model.Name
                </h3>
                <p class="mt-2 text-sm text-slate-500">
                    We are actively adding new items to this subcategory. Check back soon!
                </p>
                <div class="mt-6">
                    <a asp-controller="Categories" asp-action="Details" asp-route-slug="@Model.CategorySlug" class="inline-flex items-center gap-2 rounded-xl bg-blue-700 px-6 py-3 text-sm font-bold text-white shadow-md hover:bg-blue-800 transition">
                        ← Back to @Model.CategoryName
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4">
                @foreach (var product in Model.Products)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        }
    </section>

</main>
