    <script>
    (function () {
        const section = document.getElementById('countryKitsSection');
        const viewport = document.getElementById('countrySliderViewport');
        const track = document.getElementById('countrySliderTrack');
        if (!section || !viewport || !track) return;

        const direction = section.dataset.direction || 'right-to-left'; // 'right-to-left' or 'left-to-right'
        const autoScrollEnabled = section.dataset.autoscroll === 'true';
        const intervalSeconds = parseInt(section.dataset.interval) || 4;
        const hoverScrollEnabled = section.dataset.hoverscroll !== 'false';
        const speedSetting = section.dataset.speed || 'normal';

        let hoverSpeed = 3.5;
        if (speedSetting === 'slow') hoverSpeed = 2;
        if (speedSetting === 'fast') hoverSpeed = 6;

        let animFrameId = null;
        let autoIntervalId = null;
        let isUserHovering = false;

        function getStepDistance() {
            const firstCard = track.querySelector('.dk-country-card-item');
            return firstCard ? (firstCard.offsetWidth + 14) : 229;
        }

        function stepScroll(dirMultiplier) {
            const step = getStepDistance();
            const maxScroll = viewport.scrollWidth - viewport.clientWidth;
            const target = viewport.scrollLeft + (dirMultiplier * step);

            if (dirMultiplier > 0 && viewport.scrollLeft >= maxScroll - 5) {
                viewport.scrollTo({ left: 0, behavior: 'smooth' });
            } else if (dirMultiplier < 0 && viewport.scrollLeft <= 5) {
                viewport.scrollTo({ left: maxScroll, behavior: 'smooth' });
            } else {
                viewport.scrollBy({ left: dirMultiplier * step, behavior: 'smooth' });
            }
        }

        // Continuous gliding when cursor hovers on arrow mark
        function startHoverGlide(dirMultiplier) {
            if (!hoverScrollEnabled) return;
            stopHoverGlide();

            function loop() {
                const maxScroll = viewport.scrollWidth - viewport.clientWidth;
                viewport.scrollLeft += dirMultiplier * hoverSpeed;

                // Seamless wrap around when reaching either end
                if (dirMultiplier > 0 && viewport.scrollLeft >= maxScroll - 1) {
                    viewport.scrollLeft = 0;
                } else if (dirMultiplier < 0 && viewport.scrollLeft <= 1) {
                    viewport.scrollLeft = maxScroll;
                }

                animFrameId = requestAnimationFrame(loop);
            }
            animFrameId = requestAnimationFrame(loop);
        }

        function stopHoverGlide() {
            if (animFrameId) {
                cancelAnimationFrame(animFrameId);
                animFrameId = null;
            }
        }

        // Right arrows (Moves right-to-left: track shifts left, scrollLeft increases)
        const nextButtons = [document.getElementById('btnCountryNavNext'), document.getElementById('btnCountryEdgeRight')].filter(Boolean);
        nextButtons.forEach(btn => {
            btn.addEventListener('mouseenter', () => startHoverGlide(1));
            btn.addEventListener('mouseleave', stopHoverGlide);
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                stepScroll(1);
            });
        });

        // Left arrows (Moves left-to-right: track shifts right, scrollLeft decreases)
        const prevButtons = [document.getElementById('btnCountryNavPrev'), document.getElementById('btnCountryEdgeLeft')].filter(Boolean);
        prevButtons.forEach(btn => {
            btn.addEventListener('mouseenter', () => startHoverGlide(-1));
            btn.addEventListener('mouseleave', stopHoverGlide);
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                stepScroll(-1);
            });
        });

        // Autoplay according to admin-configured direction
        function autoScrollStep() {
            if (isUserHovering || animFrameId) return;
            const maxScroll = viewport.scrollWidth - viewport.clientWidth;
            if (maxScroll <= 5) return;

            if (direction === 'left-to-right') {
                if (viewport.scrollLeft <= 5) {
                    viewport.scrollTo({ left: maxScroll, behavior: 'smooth' });
                } else {
                    viewport.scrollBy({ left: -getStepDistance(), behavior: 'smooth' });
                }
            } else {
                // right-to-left
                if (viewport.scrollLeft >= maxScroll - 5) {
                    viewport.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    viewport.scrollBy({ left: getStepDistance(), behavior: 'smooth' });
                }
            }
        }

        if (autoScrollEnabled) {
            autoIntervalId = setInterval(autoScrollStep, intervalSeconds * 1000);
        }

        // Pause auto-scroll when user hovers over the track/cards
        viewport.addEventListener('mouseenter', () => { isUserHovering = true; });
        viewport.addEventListener('mouseleave', () => { isUserHovering = false; });
    })();
    </script>


