@model Dreamflykit.Web.Models.Kits.FindMyKitViewModel

@{
    ViewData["Title"] = "Find My Kit";
}

<div class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-8">
        <p class="text-sm font-semibold uppercase tracking-wide">
            Dreamflykit
        </p>

        <h1 class="mt-2 text-3xl font-bold">
            Find My Kit
        </h1>

        <p class="mt-3">
            Tell us where you are going and when you are arriving.
            We will show suitable kit options for your destination
            and season.
        </p>
    </div>

    <form asp-action="FindMyKit"
          asp-controller="Kits"
          method="post"
          class="space-y-6">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-sm">
        </div>

        <div>
            <label asp-for="Name"
                   class="block text-sm font-medium">
            </label>

            <input asp-for="Name"
                   class="mt-2 block w-full rounded-lg border px-4 py-3" />

            <span asp-validation-for="Name"
                  class="text-sm">
            </span>
        </div>

        <div>
            <label asp-for="DestinationCountryId"
                   class="block text-sm font-medium">
            </label>

            <select asp-for="DestinationCountryId"
                    asp-items="Model.Countries"
                    class="mt-2 block w-full rounded-lg border px-4 py-3">
                <option value="">
                    Select destination country
                </option>
            </select>

            <span asp-validation-for="DestinationCountryId"
                  class="text-sm">
            </span>
        </div>

        <div>
            <label asp-for="ArrivalDate"
                   class="block text-sm font-medium">
            </label>

            <input asp-for="ArrivalDate"
                   type="date"
                   class="mt-2 block w-full rounded-lg border px-4 py-3" />

            <span asp-validation-for="ArrivalDate"
                  class="text-sm">
            </span>
        </div>

        <div>
            <label asp-for="Phone"
                   class="block text-sm font-medium">
            </label>

            <input asp-for="Phone"
                   type="tel"
                   autocomplete="tel"
                   class="mt-2 block w-full rounded-lg border px-4 py-3" />

            <span asp-validation-for="Phone"
                  class="text-sm">
            </span>
        </div>

        <button type="submit"
                class="w-full rounded-lg px-6 py-3 font-semibold">
            Find My Kit
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}