                <input type="text" id="b_img_url" class="dk-admin-form-input" value="@bBanner.ImageUrl" oninput="updateImgPreview('b_img_url', 'preview_b_img')" style="margin-bottom: 8px;" />
                <div style="display: flex; gap: 8px;">
                    <button type="button" class="dk-btn dk-btn-primary" onclick="triggerUploadFor('b_img_url', 'preview_b_img')">Upload Banner Image</button>
                    <button type="button" class="dk-btn" style="background: #f1f5f9;" onclick="setTestPic('b_img_url', 'preview_b_img')">Set as Test Pic</button>
                </div>
            </div>
        </div>
    </div>
</div>

