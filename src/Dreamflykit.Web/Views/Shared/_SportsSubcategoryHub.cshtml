<!-- ========================================================
     CLIENT-SIDE INTERACTIVE FILTERING SCRIPT
     (Instant Subcategory Filtering without page reload)
========================================================= -->
<script>
    function filterBySubItem(subItem) {
        const cleanSub = (subItem || "").trim().toLowerCase();

        // 1. Update Left Sidebar active state
        document.querySelectorAll(".dk-cat-sub-link").forEach(link => {
            const itemVal = (link.dataset.subitem || "").trim().toLowerCase();
            if (cleanSub === "") {
                link.classList.toggle("is-active", itemVal === "");
            } else {
                link.classList.toggle("is-active", itemVal === cleanSub);
            }
        });

        // 2. Filter product cards on the right side
        const cards = document.querySelectorAll(".dk-cat-prod-card");
        let visibleCount = 0;

        cards.forEach(card => {
            if (cleanSub === "") {
                card.style.display = "";
                visibleCount++;
            } else {
                const tags = (card.dataset.subcatTags || "").toLowerCase();
                const title = (card.dataset.title || "").toLowerCase();
                const desc = (card.dataset.desc || "").toLowerCase();

                // Check match with subItem words
                const subWords = cleanSub.split(/[\s,]+/);
                let matches = false;
                if (tags.includes(cleanSub) || title.includes(cleanSub) || desc.includes(cleanSub)) {
                    matches = true;
                } else {
                    // Check if multiple key words match
                    const matchCount = subWords.filter(w => w.length > 2 && (tags.includes(w) || title.includes(w) || desc.includes(w))).length;
                    if (matchCount >= 1) matches = true;
                }

                if (matches) {
                    card.style.display = "";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            }
        });

        // 3. Update count and active chip
        const countEl = document.getElementById("dkCatProdCount");
        if (countEl) {
            countEl.textContent = visibleCount + " Products";
        }

        const chipWrap = document.getElementById("dkCatActiveChipWrap");
        const chipText = document.getElementById("dkCatActiveChipText");
        if (chipWrap && chipText) {
            if (cleanSub !== "") {
                chipText.textContent = subItem;
                chipWrap.style.display = "inline-flex";
            } else {
                chipWrap.style.display = "none";
            }
        }

        // 4. Update empty state visibility
        const emptyState = document.getElementById("dkCatSubEmptyState");
        const prodGrid = document.querySelector(".dk-cat-products-grid");
        if (emptyState && prodGrid) {
            if (visibleCount === 0) {
                prodGrid.style.display = "none";
                emptyState.style.display = "block";
            } else {
                prodGrid.style.display = "grid";
                emptyState.style.display = "none";
            }
        }

        // 5. Update browser URL without reload
        const url = new URL(window.location.href);
        if (cleanSub !== "") {
            url.searchParams.set("subcatItem", subItem);
        } else {
            url.searchParams.delete("subcatItem");
        }
        window.history.pushState(null, '', url.toString());
    }

    function filterByPriceRange(minPrice, maxPrice) {
        const cards = document.querySelectorAll(".dk-cat-prod-card");
        let visibleCount = 0;

        cards.forEach(card => {
            const price = parseFloat(card.dataset.price) || 0;
            if (price >= minPrice && price <= maxPrice) {
                card.style.display = "";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });

        const countEl = document.getElementById("dkCatProdCount");
        if (countEl) {
            countEl.textContent = visibleCount + " Products";
        }
    }

    function handleSportsSortChange(sortVal) {
        const grid = document.querySelector(".dk-cat-products-grid");
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll(".dk-cat-prod-card"));

        cards.sort((a, b) => {
            const priceA = parseFloat(a.dataset.price) || 0;
            const priceB = parseFloat(b.dataset.price) || 0;
            const ratingA = parseFloat(a.dataset.rating) || 0;
            const ratingB = parseFloat(b.dataset.rating) || 0;
            const discA = parseFloat(a.dataset.discount) || 0;
            const discB = parseFloat(b.dataset.discount) || 0;

            switch (sortVal) {
                case "price-asc": return priceA - priceB;
                case "price-desc": return priceB - priceA;
                case "rating": return ratingB - ratingA;
                case "discount": return discB - discA;
                default: return 0;
            }
        });

        cards.forEach(c => grid.appendChild(c));
    }

    function handleSportsAddToCart(productId, productName) {
        // Dispatch to cart API or show toast
        if (window.DreamflykitCart && typeof window.DreamflykitCart.addItem === 'function') {
            window.DreamflykitCart.addItem(productId, 1);
        } else {
            // Visual confirmation
            const toast = document.createElement("div");
            toast.style.position = "fixed";
            toast.style.bottom = "24px";
            toast.style.right = "24px";
            toast.style.background = "#0f172a";
            toast.style.color = "#ffffff";
            toast.style.padding = "12px 20px";
            toast.style.borderRadius = "8px";
            toast.style.boxShadow = "0 10px 25px rgba(0,0,0,0.2)";
            toast.style.fontSize = "13px";
            toast.style.fontWeight = "700";
            toast.style.zIndex = "99999";
            toast.style.display = "flex";
            toast.style.alignItems = "center";
            toast.style.gap = "8px";
            toast.innerHTML = '<span>🛒</span><span>' + (productName || "Product") + ' added to Cart!</span>';
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.transition = "opacity 0.3s ease";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    }

    // Initialize filter if subcatItem is in URL on page load
    document.addEventListener("DOMContentLoaded", function () {
        const urlParams = new URLSearchParams(window.location.search);
        const subItem = urlParams.get("subcatItem");
        if (subItem) {
            filterBySubItem(subItem);
        }
    });
</script>
