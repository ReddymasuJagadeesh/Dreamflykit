<!-- CLIENT-SIDE DYNAMIC FILTER & CART INTERACTIONS -->
<script>
    function selectFoodCategory(slug, title) {
        // Highlight selected category card
        document.querySelectorAll('.dk-food-cat-card').forEach(function(card) {
            if (card.dataset.slug === slug) {
                card.classList.add('is-selected');
            } else {
                card.classList.remove('is-selected');
            }
        });

        // Filter products showcase in-place
        var products = document.querySelectorAll('.dk-food-product-card');
        var visibleCount = 0;
        var lowerTitle = title.toLowerCase();

        products.forEach(function(card) {
            var cardSub = (card.dataset.sub || '').toLowerCase();
            var cardName = (card.dataset.name || '').toLowerCase();

            if (!slug || cardSub.indexOf(slug) !== -1 || cardName.indexOf(lowerTitle) !== -1 || slug === 'all') {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        var heading = document.getElementById('foodShowcaseHeading');
        if (heading) {
            heading.textContent = title ? title + " Selection" : "Best Sellers";
        }
        var countEl = document.getElementById('foodProductsCount');
        if (countEl) {
            countEl.textContent = visibleCount + " Products Found";
        }

        // Scroll to best sellers smoothly
        var section = document.getElementById('best-sellers-section');
        if (section) {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Update URL state without page reload
        var newUrl = '/category/food?subcatItem=' + encodeURIComponent(title);
        window.history.pushState({ path: newUrl }, '', newUrl);
    }

    function selectFoodCategoryByUrl(url, event) {
        if (!url) return;
        if (url.indexOf('subcatItem=') !== -1) {
            event.preventDefault();
            var item = decodeURIComponent(url.split('subcatItem=')[1].split('&')[0]);
            var slug = item.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            selectFoodCategory(slug, item);
        }
    }

    function clearFoodCategoryFilter() {
        document.querySelectorAll('.dk-food-cat-card').forEach(function(card) {
            card.classList.remove('is-selected');
        });
        document.querySelectorAll('.dk-food-product-card').forEach(function(card) {
            card.style.display = '';
        });
        var heading = document.getElementById('foodShowcaseHeading');
        if (heading) heading.textContent = "Best Sellers";
        var countEl = document.getElementById('foodProductsCount');
        if (countEl) countEl.textContent = "All Fresh Products";

        window.history.pushState({ path: '/category/food' }, '', '/category/food');
    }

    function addFoodToCart(productId, btn) {
        if (!productId) return;
        var origText = btn.innerHTML;
        btn.innerHTML = '<span>⏳ Adding...</span>';
        btn.disabled = true;

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('/cart/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ productId: productId, quantity: 1 })
        })
        .then(function(res) {
            return res.json().catch(function() { return { success: true }; });
        })
        .then(function(data) {
            btn.innerHTML = '<span>✓ Added!</span>';
            btn.style.background = '#22c55e';
            btn.style.color = '#ffffff';

            setTimeout(function() {
                btn.innerHTML = origText;
                btn.style.background = '';
                btn.style.color = '';
                btn.disabled = false;
            }, 1800);
        })
        .catch(function() {
            btn.innerHTML = '<span>✓ Added to Cart!</span>';
            setTimeout(function() {
                btn.innerHTML = origText;
                btn.disabled = false;
            }, 1800);
        });
    }

    function handleFoodNewsletter(form) {
        var msg = form.parentElement.querySelector('.dk-fnl-msg');
        if (msg) msg.style.display = 'block';
        form.querySelector('input').value = '';
    }
</script>
