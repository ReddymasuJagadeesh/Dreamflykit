    gap: 6px;
}
.dk-results-count { font-size: 0.92rem; color: #334155; }
.dk-active-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.dk-active-chip {
    display: inline-flex;
    align-items: center;
