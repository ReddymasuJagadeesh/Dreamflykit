    }
    .dk-hub-tab-btn.active {
        color: #1f3d24;
        border-bottom-color: #1f3d24;
    }
</style>

<!-- JAVASCRIPT FOR TABS, ASYNC IMAGE UPLOADS & SERIALIZATION -->
<script>
    function switchFoodTab(tabName, btn) {
        document.querySelectorAll('.dk-hub-tab-btn').forEach(function(b) { b.classList.remove('active'); });
        document.querySelectorAll('.dk-hub-tab-pane').forEach(function(p) { p.style.display = 'none'; });

        btn.classList.add('active');
        var pane = document.getElementById('tab_' + tabName);
        if (pane) pane.style.display = 'block';
    }

    function previewImg(url, targetImgId) {
        var el = document.getElementById(targetImgId);
        if (el && url) el.src = url;
    }

    function uploadImageAsync(input, targetInputId, targetPreviewId) {
        if (!input.files || input.files.length === 0) return;
        var file = input.files[0];

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var formData = new FormData();
        formData.append('file', file);
        formData.append('targetField', targetInputId);

        var btn = input.parentElement;
        var origText = btn.innerHTML;
        btn.innerHTML = 'Uploading...';

        fetch('/Admin/FoodHub/UploadImage', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            btn.innerHTML = origText;
            if (data.success && data.url) {
                var inputEl = document.getElementById(targetInputId);
                if (inputEl) inputEl.value = data.url;
                var prevEl = document.getElementById(targetPreviewId);
                if (prevEl) prevEl.src = data.url;
                alert('✓ ' + data.message);
            } else {
                alert('Upload failed: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(function(err) {
            btn.innerHTML = origText;
            alert('Upload error: ' + err.message);
        });
    }

    function saveFoodHubConfig() {
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        var trustBadges = [];
        for (var b = 0; b < 4; b++) {
            var badgeEl = document.getElementById('hero_badge_' + b);
            if (badgeEl && badgeEl.value.trim().length > 0) {
                trustBadges.push(badgeEl.value.trim());
            }
        }

        var cards = [];
        for (var c = 0; c < 7; c++) {
            var tEl = document.getElementById('cat_title_' + c);
            if (!tEl) break;
            var itemsText = document.getElementById('cat_items_' + c)?.value || '';
            var itemsList = itemsText.split('\n').map(function(s) { return s.trim(); }).filter(function(s) { return s.length > 0; });

            cards.push({
                Id: 'cat-' + (document.getElementById('cat_slug_' + c)?.value || c),
                Title: tEl.value,
                Slug: document.getElementById('cat_slug_' + c)?.value || '',
                TargetUrl: document.getElementById('cat_url_' + c)?.value || '',
                ImageUrl: document.getElementById('cat_img_' + c)?.value || '',
                Items: itemsList
            });
        }

        var promoCards = [];
        for (var p = 0; p < 3; p++) {
            var hEl = document.getElementById('promo_heading_' + p);
            if (!hEl) break;
            promoCards.push({
                Id: 'promo-' + (p + 1),
                Heading: hEl.value,
                Subtitle: document.getElementById('promo_sub_' + p)?.value || '',
                ButtonText: document.getElementById('promo_btn_text_' + p)?.value || '',
                ButtonUrl: document.getElementById('promo_btn_url_' + p)?.value || '',
                ImageUrl: document.getElementById('promo_img_' + p)?.value || '',
                BgColor: document.getElementById('promo_bg_' + p)?.value || '#f7f0e6'
            });
        }

                var slides = [];
        document.querySelectorAll('.dk-slide-edit-card').forEach(function(card, idx) {
            slides.push({
                Id: card.querySelector('.slide-id')?.value || ('slide-' + (idx + 1)),
                Title: card.querySelector('.slide-title')?.value || '',
                Subtitle: card.querySelector('.slide-subtitle')?.value || '',
                Badge: card.querySelector('.slide-badge')?.value || '',
                ButtonText: card.querySelector('.slide-btn-text')?.value || 'Shop Now →',
                ButtonUrl: card.querySelector('.slide-btn-url')?.value || '/category/food',
                ImageUrl: card.querySelector('.slide-img-url')?.value || '',
                IsUploadingSoon: card.querySelector('.slide-uploading-soon')?.checked || false,
                BgGradient: card.querySelector('.slide-bg-gradient')?.value || 'linear-gradient(135deg, #1e3d24 0%, #2b5732 50%, #166534 100%)',
                TextColor: card.querySelector('.slide-text-color')?.value || '#ffffff',
                DisplayOrder: idx + 1,
                IsActive: card.querySelector('.slide-is-active')?.checked || false
            });
        });

        var firstSlide = slides.length > 0 ? slides[0] : null;

        var payload = {
            ThemeSettings: {
                StoreTitle: document.getElementById('theme_title')?.value || 'FreshBasket • Food & Grocery',
                AccentColor: '#1f3d24',
                PrimaryGreen: '#234d20',
                SoftBackground: '#fbf9f5'
            },
            TopNoticeBar: {
                IsEnabled: document.getElementById('notice_enabled')?.checked || false,
                Item1Text: document.getElementById('notice_item_1')?.value || '',
                Item2Text: document.getElementById('notice_item_2')?.value || '',
                Item3Text: document.getElementById('notice_item_3')?.value || '',
                Item4Text: document.getElementById('notice_item_4')?.value || ''
            },
            HeroBanner: {
                IsEnabled: document.getElementById('hero_enabled')?.checked || true,
                IsFullWidth: true,
                AutoSlideIntervalSeconds: parseInt(document.getElementById('hero_auto_interval')?.value || '5'),
                Heading: firstSlide ? firstSlide.Title : 'Good Food. Good Mood.',
                Subtitle: firstSlide ? firstSlide.Subtitle : 'Your one-stop shop for groceries, snacks & more.',
                ButtonText: firstSlide ? firstSlide.ButtonText : 'Shop Now →',
                ButtonUrl: firstSlide ? firstSlide.ButtonUrl : '#best-sellers-section',
                ImageUrl: firstSlide ? firstSlide.ImageUrl : '/images/food-hub/hero-food-basket.webp',
                IsUploadingSoon: firstSlide ? firstSlide.IsUploadingSoon : false,
                TrustBadges: trustBadges,
                Slides: slides
            },
            ShopByCategories: {
                Heading: document.getElementById('cats_heading')?.value || 'Shop By Categories',
                Cards: cards
            },
            PromoCards: {
                IsEnabled: true,
                Cards: promoCards
            },
            BottomTrustBar: {
                Item1Title: document.getElementById('bt_title_1')?.value || '',
                Item1Subtitle: document.getElementById('bt_sub_1')?.value || '',
                Item2Title: document.getElementById('bt_title_2')?.value || '',
                Item2Subtitle: document.getElementById('bt_sub_2')?.value || '',
                Item3Title: document.getElementById('bt_title_3')?.value || '',
                Item3Subtitle: document.getElementById('bt_sub_3')?.value || '',
                Item4Title: document.getElementById('bt_title_4')?.value || '',
                Item4Subtitle: document.getElementById('bt_sub_4')?.value || ''
            },
            StayUpdated: {
                Heading: document.getElementById('nl_heading')?.value || 'Stay Updated!',
                Subtitle: document.getElementById('nl_sub')?.value || '',
                ButtonText: document.getElementById('nl_btn')?.value || 'Subscribe',
                ImageUrl: document.getElementById('nl_img_url')?.value || ''
            }
        };

        fetch('/Admin/FoodHub/Save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                alert('✓ ' + data.message);
                window.location.reload();
            } else {
                alert('Save failed: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(function(err) {
            alert('Save error: ' + err.message);
        });
    }
</script>

