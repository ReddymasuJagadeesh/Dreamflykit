@model Dreamflykit.Web.Models.Home.HomeViewModel
@inject Dreamflykit.Application.CountryKits.Interfaces.ICountryKitsHubService? CountryKitsHubService

@{
    ViewData["Title"] = "Home";
}


<div class="dk-home-page">


    <!-- =====================================================
         HERO SLIDER (MULTI-IMAGE, SIDE ARROWS, AUTO-TIME SLIDE)
    ====================================================== -->
    @{
        var heroSlides = Model.HeroSlides?.Any() == true 
            ? Model.HeroSlides.ToList() 
            : new List<Dreamflykit.Web.Models.Home.HomeHeroSlideDto>
            {
                new() { ImageUrl = Url.Content("~/images/hero/hero.webp"), Title = "Your Journey. Our Kit.", CtaUrl = "/Kits/FindMyKit", AltText = "Dreamflykit - Your Journey. Our Kit." },
                new() { ImageUrl = Url.Content("~/images/hero/hero-electronics.webp"), Title = "International Tech & Power Adapters", CtaUrl = "/category/electronics", AltText = "Dreamflykit Electronics & Power Adapters" },
                new() { ImageUrl = Url.Content("~/images/hero/hero-travel-gear.webp"), Title = "Curated Study Abroad Luggage & Kits", CtaUrl = "/category/travel-gear", AltText = "Dreamflykit Travel Gear" }
            };
    }

    <section class="dk-hero dk-hero-carousel-container" id="dkHeroSlider" aria-roledescription="carousel" aria-label="Dreamflykit Featured Slides">

        <div class="dk-hero-track-viewport">
            <div class="dk-hero-slider-track" id="heroTrack">
                @for (int i = 0; i < heroSlides.Count; i++)
                {
                    var slide = heroSlides[i];
                    var link = string.IsNullOrWhiteSpace(slide.CtaUrl) ? "/Kits/FindMyKit" : slide.CtaUrl;
                    <div class="dk-hero-slide @(i == 0 ? "is-active" : "")" 
                         data-index="@i"
                         role="group" 
                         aria-roledescription="slide" 
                         aria-label="@(i + 1) of @heroSlides.Count">
                        <a href="@link" class="dk-hero-slide-link" tabindex="@(i == 0 ? "0" : "-1")">
                            <img src="@slide.ImageUrl" 
                                 alt="@(slide.AltText ?? slide.Title ?? "Dreamflykit Hero Slide")" 
                                 class="dk-hero-slide-img" 
                                 loading="@(i == 0 ? "eager" : "lazy")" />
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- SIDE ARROWS: PREVIOUS AND NEXT -->
        <button type="button" 
                class="dk-hero-arrow dk-hero-arrow-prev" 
                id="heroPrevBtn" 
                aria-label="Previous Slide" 
                title="Previous Slide">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>

        <button type="button" 
                class="dk-hero-arrow dk-hero-arrow-next" 
                id="heroNextBtn" 
                aria-label="Next Slide" 
                title="Next Slide">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>

        <!-- DOTS PAGINATION INDICATOR -->
        <div class="dk-hero-dots-nav" id="heroDotsNav" role="tablist" aria-label="Slide Selection">
            @for (int i = 0; i < heroSlides.Count; i++)
            {
                <button type="button" 
                        class="dk-hero-dot @(i == 0 ? "active" : "")" 
                        data-slide-index="@i" 
                        role="tab" 
                        aria-label="Slide @(i + 1)" 
                        aria-selected="@(i == 0 ? "true" : "false")">
                    <span class="dk-dot-pill"></span>
                </button>
            }
        </div>

        <!-- AUTO-PLAY TIMEFRAME PROGRESS BAR -->
        <div class="dk-hero-time-indicator" aria-hidden="true">
            <div class="dk-hero-time-fill" id="heroTimeBar"></div>
        </div>

        <!-- ADMIN DIRECT ACCESS BADGE -->
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
        {
            <a href="/Admin/Banners" 
               class="dk-hero-admin-manage-btn" 
               title="Super Admin: Add, replace, or configure slides & auto-timeframe in Admin">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <span>Manage Slides (Admin)</span>
            </a>
        }

    </section>

    <!-- =====================================================
         BENEFITS
    ====================================================== -->

    <section class="dk-benefits">

        <div class="dk-benefits-grid">


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M3 7h18v13H3z"></path>
                        <path d="M3 7l3-4h12l3 4"></path>
                        <path d="M8 11h8"></path>
                    </svg>

                </div>

                <div>

                    <strong>
                        Curated for Students
                    </strong>

                    <span>
                        Handpicked essentials for every abroad journey
                    </span>

                </div>

            </div>


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M12 3l8 4v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V7z"></path>
                        <path d="m8 12 2.5 2.5L16 9"></path>
                    </svg>

                </div>

                <div>

                    <strong>
                        Best Quality Products
                    </strong>

                    <span>
                        100% genuine & premium brands
                    </span>

                </div>

            </div>


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M12 2v20"></path>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14.5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>

                </div>

                <div>

                    <strong>
                        Affordable Prices
                    </strong>

                    <span>
                        Best value for students
                    </span>

                </div>

            </div>


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M3 7h11v10H3z"></path>
                        <path d="M14 10h4l3 3v4h-7z"></path>
                        <circle cx="7" cy="19" r="2"></circle>
                        <circle cx="18" cy="19" r="2"></circle>
                    </svg>

                </div>

                <div>

                    <strong>
                        Fast & Reliable Delivery
                    </strong>

                    <span>
                        On-time delivery worldwide
                    </span>

                </div>

            </div>


            <div class="dk-benefit">

                <div class="dk-benefit-icon">

                    <svg viewBox="0 0 24 24">
                        <path d="M4 5h16v12H4z"></path>
                        <path d="M8 21h8"></path>
                        <path d="M12 17v4"></path>
                    </svg>

                </div>

                <div>

                    <strong>
                        24/7 Customer Support
                    </strong>

                    <span>
                        We're always here to help you
                    </span>

                </div>

            </div>


        </div>

    </section>


    <!-- =====================================================
         TOP COUNTRY KITS (SINGLE-LINE CAROUSEL WITH DYNAMIC MOVEMENT & ARROW HOVER CONTROLS)
    ====================================================== -->
    @{
        Dreamflykit.Application.CountryKits.Models.CountryKitsHubDto? countryHub = null;
        if (CountryKitsHubService != null)
        {
            try { countryHub = await CountryKitsHubService.GetAllProfilesAsync(); } catch { }
        }
        var countrySlider = countryHub?.SliderSettings ?? new Dreamflykit.Application.CountryKits.Models.CountryKitsSliderSettingsDto();
        var dynamicCountries = countryHub?.Countries?.Values?.Where(c => c.IsActive)?.OrderBy(c => c.DisplayOrder)?.ToList()
            ?? new List<Dreamflykit.Application.CountryKits.Models.CountryKitProfileDto>();

        if (!dynamicCountries.Any())
        {
            dynamicCountries = new List<Dreamflykit.Application.CountryKits.Models.CountryKitProfileDto>
            {
                new() { CountrySlug = "usa", CountryName = "USA", FlagEmoji = "🇺🇸", Tagline = "Study in the Land of Opportunities", StartingPrice = 4999, LandmarkImageUrl = "/images/countries/usa.webp" },
                new() { CountrySlug = "uk", CountryName = "UK", FlagEmoji = "🇬🇧", Tagline = "Experience World-Class Education", StartingPrice = 4499, LandmarkImageUrl = "/images/countries/uk.webp" },
                new() { CountrySlug = "canada", CountryName = "Canada", FlagEmoji = "🇨🇦", Tagline = "Your Future, Our Essentials", StartingPrice = 4499, LandmarkImageUrl = "/images/countries/canada.webp" },
                new() { CountrySlug = "australia", CountryName = "Australia", FlagEmoji = "🇦🇺", Tagline = "Discover. Learn. Grow Abroad.", StartingPrice = 4999, LandmarkImageUrl = "/images/countries/australia.webp" },
                new() { CountrySlug = "germany", CountryName = "Germany", FlagEmoji = "🇩🇪", Tagline = "Excellence in Education Awaits", StartingPrice = 4999, LandmarkImageUrl = "/images/countries/germany.webp" },
                new() { CountrySlug = "ireland", CountryName = "Ireland", FlagEmoji = "🇮🇪", Tagline = "Your Gateway to Global Success", StartingPrice = 4499, LandmarkImageUrl = "/images/countries/ireland.webp" },
                new() { CountrySlug = "new-zealand", CountryName = "New Zealand", FlagEmoji = "🇳🇿", Tagline = "Kiwi Adventure Meets World-Class Study", StartingPrice = 4999, LandmarkImageUrl = "/images/countries/new-zealand.webp" },
                new() { CountrySlug = "france", CountryName = "France", FlagEmoji = "🇫🇷", Tagline = "Culture, Innovation and Academic Prestige", StartingPrice = 4799, LandmarkImageUrl = "/images/countries/france.webp" }
            };
        }
    }

    <section class="dk-section dk-country-carousel-section"
             id="countryKitsSection"
             data-direction="@(countrySlider.MovementDirection ?? "right-to-left")"
             data-autoscroll="@(countrySlider.AutoScroll ? "true" : "false")"
             data-interval="@(countrySlider.AutoScrollIntervalSeconds > 0 ? countrySlider.AutoScrollIntervalSeconds : 4)"
             data-hoverscroll="@(countrySlider.HoverScrollEnabled ? "true" : "false")"
             data-speed="@(countrySlider.ScrollSpeed ?? "normal")">

        <div class="dk-section-header">
            <div class="dk-section-header-row" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div>
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;">
                        <h2 class="dk-section-title" style="margin: 0;">
                            @(string.IsNullOrWhiteSpace(countrySlider.SectionTitle) ? "Top Country Kits" : countrySlider.SectionTitle)
                        </h2>
                        <span class="dk-country-live-badge">
                            <span class="dk-country-live-dot"></span>
                            ✨ @dynamicCountries.Count DESTINATIONS AVAILABLE
                        </span>
                        @if (string.Equals(countrySlider.MovementDirection, "left-to-right", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="dk-country-motion-tag">⟶ Auto-Gliding Left to Right</span>
                        }
                        else
                        {
                            <span class="dk-country-motion-tag">⟵ Auto-Gliding Right to Left</span>
                        }
                    </div>

                    <p class="dk-section-description" style="margin: 0;">
                        @(string.IsNullOrWhiteSpace(countrySlider.SectionSubtitle) ? "Essential kits specially curated for students traveling to top study destinations." : countrySlider.SectionSubtitle)
                    </p>
                </div>

                <div style="display: flex; align-items: center; gap: 14px; margin-left: auto;">
                    <!-- Circular Navigation Arrows in Header -->
                    <div class="dk-country-nav-cluster">
                        <button type="button"
                                class="dk-country-nav-btn dk-country-nav-prev"
                                id="btnCountryNavPrev"
                                aria-label="Previous Destinations"
                                title="Hover to glide left or click to step">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </button>
                        <button type="button"
                                class="dk-country-nav-btn dk-country-nav-next"
                                id="btnCountryNavNext"
                                aria-label="Next Destinations"
                                title="Hover to glide right or click to step">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                    </div>

                    <!-- View Countries link (Replaces Find My Kit) -->
                    <a href="@(string.IsNullOrWhiteSpace(countrySlider.ViewAllUrl) ? "/Kits/FindMyKit" : countrySlider.ViewAllUrl)"
                       class="dk-view-all dk-country-view-all">
                        @(string.IsNullOrWhiteSpace(countrySlider.ViewAllText) ? "View Countries →" : countrySlider.ViewAllText)
                    </a>
                </div>
            </div>
        </div>

        <!-- SINGLE LINE CAROUSEL CONTAINER (STRICTLY ONE LINE - NO WRAPPING) -->
        <div class="dk-country-slider-container">
            <!-- Overlaid Edge Arrows (Hover over arrow continuously moves track; click steps) -->
            <button type="button"
                    class="dk-country-edge-arrow dk-country-edge-arrow-left"
                    id="btnCountryEdgeLeft"
                    aria-label="Glide Left"
                    title="Hover cursor to move left to right">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>

            <button type="button"
                    class="dk-country-edge-arrow dk-country-edge-arrow-right"
                    id="btnCountryEdgeRight"
                    aria-label="Glide Right"
                    title="Hover cursor to move right to left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>

            <!-- SINGLE LINE VIEWPORT -->
            <div class="dk-country-slider-viewport" id="countrySliderViewport">
                <div class="dk-country-slider-track" id="countrySliderTrack">
                    @foreach (var c in dynamicCountries)
                    {
                        var cImg = !string.IsNullOrWhiteSpace(c.LandmarkImageUrl) ? c.LandmarkImageUrl : Url.Content($"~/images/countries/{c.CountrySlug}.webp");
                        var isUploading = c.IsLandmarkUploadingSoon || cImg.Contains("uploading-soon-placeholder");

                        <a href="/kits/@c.CountrySlug" class="dk-country-card-item" data-slug="@c.CountrySlug" title="Explore @c.CountryName Kits">
                            <div class="dk-country-image-wrap">
                                @if (isUploading)
                                {
                                    <div class="dk-country-uploading-card">
                                        <div class="dk-country-radar-circle">
                                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93"></path></svg>
                                        </div>
                                        <span class="dk-country-uploading-pill">UPLOADING SOON</span>
                                        <span class="dk-country-uploading-sub">Curated Student Fashion</span>
                                        <span class="dk-country-uploading-note">Admin can upload image anytime</span>
                                    </div>
                                }
                                else
                                {
                                    <img src="@cImg"
                                         alt="@c.CountryName Kit"
                                         class="dk-country-photo"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.src='/images/placeholder.svg';" />
                                }

                                <!-- Circular Flag Badge on landmark image (matches user screenshot) -->
                                <div class="dk-country-flag-disc" title="@c.CountryName Flag">
                                    <span class="dk-country-flag-text">@c.FlagEmoji</span>
                                </div>
                            </div>

                            <div class="dk-country-card-body">
                                <h3 class="dk-country-card-title">@c.CountryName</h3>
                                <p class="dk-country-card-tagline">
                                    @(string.IsNullOrWhiteSpace(c.Tagline) ? $"Curated study kits for {c.CountryName}" : c.Tagline)
                                </p>
                                <div class="dk-country-card-price-row">
                                    <div class="dk-country-card-price">
                                        @(c.StartingPrice > 0 ? $"From ₹{c.StartingPrice:N0}" : "From ₹4,499")
                                    </div>
                                    <span class="dk-country-card-arrow">→</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- STYLES & SCRIPTS FOR TOP COUNTRY KITS SINGLE-LINE CAROUSEL -->
    <style>
        .dk-country-carousel-section {
            position: relative;
        }

        .dk-country-live-badge {
            background: #ecfdf5;
            color: #047857;
            font-size: 11px;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 999px;
            border: 1px solid #a7f3d0;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            letter-spacing: 0.3px;
        }

        .dk-country-live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
            animation: dkCountryPulse 1.8s infinite;
        }

        @@keyframes dkCountryPulse {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
            70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        .dk-country-motion-tag {
            background: #eff6ff;
            color: #1d4ed8;
            font-size: 10px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 4px;
            border: 1px solid #dbeafe;
        }

        .dk-country-nav-cluster {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .dk-country-nav-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #334155;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
        }

        .dk-country-nav-btn:hover {
            background: #0284c7;
            color: #ffffff;
            border-color: #0284c7;
            transform: scale(1.08);
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
        }

        .dk-country-slider-container {
            position: relative;
            width: 100%;
            margin-top: 14px;
        }

        /* OVERLAID EDGE ARROWS */
        .dk-country-edge-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #ffffff;
            color: #0f172a;
            border: 1px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.16);
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            opacity: 0.95;
        }

        .dk-country-edge-arrow:hover {
            background: #0284c7;
            color: #ffffff;
            border-color: #0284c7;
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
            transform: translateY(-50%) scale(1.12);
            opacity: 1;
        }

        .dk-country-edge-arrow-left {
            left: -14px;
        }

        .dk-country-edge-arrow-right {
            right: -14px;
        }

        /* VIEWPORT: STRICTLY ONE LINE, NO 2ND ROW WRAP */
        .dk-country-slider-viewport {
            width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            -ms-overflow-style: none;
            padding: 8px 4px 16px 4px;
        }

        .dk-country-slider-viewport::-webkit-scrollbar {
            display: none;
        }

        /* TRACK: FLEX ROW NOWRAP FORCES SINGLE LINE */
        .dk-country-slider-track {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap !important;
            gap: 14px;
            align-items: stretch;
            width: max-content;
        }

        /* CARD: ONE LINE ITEM WITH MIN/MAX WIDTH */
        .dk-country-card-item {
            flex: 0 0 215px;
            width: 215px;
            max-width: 215px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(20, 50, 90, 0.05);
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            cursor: pointer;
            box-sizing: border-box;
        }

        .dk-country-card-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(20, 50, 90, 0.12);
            border-color: #cbd5e1;
        }

        .dk-country-image-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1.34 / 1;
            overflow: hidden;
            background: #f8fafc;
        }

        .dk-country-photo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.35s ease;
        }

        .dk-country-card-item:hover .dk-country-photo {
            transform: scale(1.05);
        }

        /* UPLOADING SOON PLACEHOLDER (MATCHES SCREENSHOT) */
        .dk-country-uploading-card {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 10px 8px;
            text-align: center;
            border-bottom: 1px dashed #bae6fd;
            box-sizing: border-box;
        }

        .dk-country-radar-circle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(2, 132, 199, 0.15);
            margin-bottom: 4px;
        }

        .dk-country-uploading-pill {
            background: #0284c7;
            color: #ffffff;
            font-size: 9.5px;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 10px;
            letter-spacing: 0.3px;
        }

        .dk-country-uploading-sub {
            font-size: 10px;
            font-weight: 700;
            color: #0369a1;
            margin-top: 3px;
        }

        .dk-country-uploading-note {
            font-size: 8.5px;
            color: #64748b;
            margin-top: 1px;
        }

        /* CIRCULAR FLAG DISC OVERLAY AT BOTTOM-LEFT (EXACTLY LIKE SCREENSHOT) */
        .dk-country-flag-disc {
            position: absolute;
            bottom: 8px;
            left: 8px;
            width: 34px;
            height: 34px;
            background: #ffffff;
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
            border: 2px solid #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            line-height: 1;
            z-index: 2;
            transition: transform 0.2s ease;
        }

        .dk-country-card-item:hover .dk-country-flag-disc {
            transform: scale(1.1);
        }

        .dk-country-card-body {
            padding: 12px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            justify-content: space-between;
        }

        .dk-country-card-title {
            font-size: 15px;
            font-weight: 800;
            color: #1e293b;
            margin: 0 0 6px 0;
        }

        .dk-country-card-tagline {
            min-height: 32px;
