    function saveSportsConfig() {
        var btn = document.getElementById('btnSaveConfig');
        btn.disabled = true;
        btn.innerHTML = '<span>Saving...</span>';

        // 1. Festival Theme
        var festival = {
            IsEnabled: document.getElementById('festIsEnabled').checked,
            FestivalName: document.getElementById('festName').value,
            AnnouncementText: document.getElementById('festAnnouncement').value,
            BadgeText: document.getElementById('festBadge').value,
            BannerHighlight: document.getElementById('festHighlight').value,
            BgGradient: document.getElementById('festGradient').value
        };

        // 2. Hero Banner
        var slides = [];
        document.querySelectorAll('#heroSlidesList [data-slide-card]').forEach(function (card, idx) {
            slides.push({
                Id: card.querySelector('.slide-id').value || ('slide_' + idx),
                BadgeText: card.querySelector('.slide-badge').value,
                Title: card.querySelector('.slide-title').value,
                TitleHighlight: card.querySelector('.slide-highlight').value,
                Subtitle: card.querySelector('.slide-subtitle').value,
                ImageUrl: card.querySelector('.slide-img-url').value,
                IsUploadingSoon: card.querySelector('.slide-uploading').checked,
                TargetUrl: card.querySelector('.slide-url').value,
                ButtonText: card.querySelector('.slide-btn-text').value,
                DisplayOrder: parseInt(card.querySelector('.slide-order').value || (idx + 1), 10),
                IsActive: card.querySelector('.slide-isactive').checked
            });
        });

        var hero = {
            IsEnabled: document.getElementById('heroIsEnabled').checked,
            AutoPlay: document.getElementById('heroAutoPlay').value === 'true',
            SlideIntervalSeconds: parseInt(document.getElementById('heroInterval').value || '5', 10),
            BannerHeight: parseInt(document.getElementById('heroHeight').value || '440', 10),
            Slides: slides
        };

        // 3. Shop by Category
        var catItems = [];
        document.querySelectorAll('.sp-categories-admin-grid [data-cat-card]').forEach(function (card, idx) {
            var subcatsRaw = card.querySelector('.cat-subcategories')?.value || '';
            var subcatsList = subcatsRaw.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });

            catItems.push({
                Slug: card.querySelector('.cat-slug').value,
                Name: card.querySelector('.cat-name').value,
                IconEmoji: card.querySelector('.cat-emoji').value,
                Subtitle: card.querySelector('.cat-sub').value,
                ImageUrl: card.querySelector('.cat-img').value,
                IsUploadingSoon: card.querySelector('.cat-uploading').checked,
