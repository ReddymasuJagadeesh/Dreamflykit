    margin-bottom: 30px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
}
.dk-sub-hero-glow {
    position: absolute;
    top: -50px;
    right: 15%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(234, 88, 12, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
}
.dk-sub-hero-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    position: relative;
    z-index: 1;
}
.dk-sub-hero-content { flex: 1; max-width: 680px; }
.dk-sub-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: #64748b;
    margin-bottom: 12px;
    font-weight: 600;
}
.dk-sub-breadcrumb a { color: #ea580c; text-decoration: none; }
.dk-sub-breadcrumb a:hover { text-decoration: underline; }
.dk-sub-sep { color: #94a3b8; }
.dk-sub-crumb-active { color: #0f172a; font-weight: 800; }
.dk-sub-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff7ed;
    color: #ea580c;
    border: 1px solid #fed7aa;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
}
.dk-badge-dot { font-size: 0.65rem; color: #ea580c; }
.dk-sub-hero-title {
    font-size: 2.2rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1.15;
    margin: 0 0 10px 0;
    letter-spacing: -0.5px;
}
.dk-sub-hero-desc {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.55;
    margin: 0 0 18px 0;
}
.dk-sub-hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}
.dk-hero-chip {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #1e293b;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
}
.dk-sub-admin-link {
    font-size: 0.78rem;
    font-weight: 800;
    color: #0284c7;
    text-decoration: none;
    margin-left: 6px;
}
.dk-sub-admin-link:hover { text-decoration: underline; }

/* Sub Hero Media & Uploading Soon */
.dk-sub-hero-media {
    flex: 0 0 280px;
    display: flex;
    justify-content: center;
}
.dk-sub-hero-uploading {
    width: 240px;
    background: linear-gradient(145deg, #f8fafc 0%, #e2e8f0 100%);
    border: 2px dashed #cbd5e1;
    border-radius: 18px;
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}
.dk-sub-uploading-radar {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
}
.dk-sub-radar-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid #ea580c;
    opacity: 0.6;
    animation: subRadarWave 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
}
@@keyframes subRadarWave {
    0% { transform: scale(0.9); opacity: 0.8; }
    80%, 100% { transform: scale(1.4); opacity: 0; }
}
.dk-sub-emoji { font-size: 2.2rem; }
.dk-sub-uploading-pill {
    background: #ea580c;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.6px;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 6px;
    text-transform: uppercase;
}
.dk-mini-dot { font-size: 0.6rem; margin-right: 4px; }
.dk-sub-uploading-text { font-size: 0.74rem; color: #64748b; margin: 0; }

/* 2-Column Layout */
.dk-sub-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 28px;
    align-items: start;
}

/* Sidebar */
.dk-sub-sidebar { position: sticky; top: 80px; }
.dk-filter-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
}
.dk-filter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1.5px solid #f1f5f9;
    margin-bottom: 16px;
}
.dk-filter-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
}
.dk-btn-clear-filters {
    background: none;
    border: none;
    color: #ea580c;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
}
.dk-btn-clear-filters:hover { background: #fff7ed; }

.dk-filter-section {
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom: 1px solid #f1f5f9;
}
.dk-filter-heading {
    font-size: 0.88rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 10px 0;
}

/* Quick Category Switcher */
.dk-cat-quick-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.dk-cat-quick-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: #334155;
    font-size: 0.86rem;
    font-weight: 600;
    transition: all 0.16s;
}
.dk-cat-quick-item:hover {
    background: #f8fafc;
    color: #0f172a;
}
.dk-cat-quick-item.active {
    background: #fff7ed;
    color: #ea580c;
    font-weight: 800;
    border: 1px solid #fed7aa;
}
.dk-cat-quick-emoji { font-size: 1.15rem; }
.dk-cat-quick-name { flex: 1; }
.dk-cat-current-dot { font-size: 0.7rem; color: #ea580c; }

/* Size Chips Grid */
.dk-sizes-chips-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
}
.dk-size-chip-label { cursor: pointer; }
.dk-size-checkbox { display: none; }
.dk-size-chip-box {
    display: block;
    text-align: center;
    padding: 6px 4px;
    border-radius: 8px;
    border: 1.5px solid #e2e8f0;
    background: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    color: #334155;
    transition: all 0.16s;
}
.dk-size-checkbox:checked + .dk-size-chip-box {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
}

/* Radios List */
.dk-radios-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.dk-radio-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: #334155;
    cursor: pointer;
    font-weight: 600;
}
.dk-radio-item input[type="radio"],
.dk-radio-item input[type="checkbox"] {
    accent-color: #ea580c;
    cursor: pointer;
}

/* Price Inputs */
.dk-price-custom-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
}
.dk-price-input {
    width: 70px;
    padding: 6px 8px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.8rem;
}
.dk-price-sep { color: #94a3b8; font-weight: 700; }
.dk-btn-price-go {
    background: #0f172a;
    color: #ffffff;
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
}

/* Colors Grid */
.dk-colors-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
}
.dk-color-swatch-item {
    display: flex;
    align-items: center;
