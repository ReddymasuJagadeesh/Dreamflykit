@model Dreamflykit.Web.Models.Cart.CartViewModel

@{
    ViewData["Title"] = "My Cart";
}

<main class="dk-cart-page">

    <div class="dk-shell dk-cart-shell">

        <div class="dk-cart-header">

            <h1 class="dk-cart-title">
                My Cart
                @if (!Model.IsEmpty)
                {
                    <span class="dk-cart-count-badge">
                        @Model.TotalItems item@(Model.TotalItems == 1 ? "" : "s")
                    </span>
                }
            </h1>

        </div>


        @if (!string.IsNullOrEmpty(TempData["CartSuccess"]?.ToString()))
        {
            <div class="dk-alert dk-alert--success" role="alert">
                @TempData["CartSuccess"]
            </div>
        }

        @if (!string.IsNullOrEmpty(TempData["CartError"]?.ToString()))
        {
            <div class="dk-alert dk-alert--error" role="alert">
                @TempData["CartError"]
            </div>
        }


        @if (Model.IsEmpty)
        {

            <!-- ===================================================
                 EMPTY CART STATE
            ==================================================== -->

            <div class="dk-cart-empty">

                <div class="dk-cart-empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 4h2l2 12h11l2-8H6" />
                        <circle cx="9" cy="20" r="1.5" />
                        <circle cx="18" cy="20" r="1.5" />
                    </svg>
                </div>

                <h2 class="dk-cart-empty-title">Your cart is empty</h2>

                <p class="dk-cart-empty-text">
                    Add items from the catalog or discover a curated kit.
                </p>

                <div class="dk-cart-empty-actions">

                    <a href="/products"
                       class="dk-btn dk-btn--primary">
                        Browse Products
                    </a>

                    <a href="/Kits/FindMyKit"
                       class="dk-btn dk-btn--secondary">
                        Find My Kit
                    </a>

                </div>

            </div>

        }
        else
        {

            <!-- ===================================================
                 CART LAYOUT — ITEMS + SUMMARY
            ==================================================== -->

            <div class="dk-cart-layout">


                <!-- CART ITEMS LIST -->

                <section class="dk-cart-items" aria-label="Cart items">

                    @foreach (var item in Model.Items)
                    {
                        <div class="dk-cart-item">

                            <!-- Image -->
                            <div class="dk-cart-item-image">

                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         alt="@item.ProductName"
                                         loading="lazy"
                                         decoding="async" />
                                }
                                else
                                {
                                    <div class="dk-cart-item-image-placeholder"
                                         aria-label="No image">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                            <path d="m3 9 4-4 4 4 4-4 4 4" />
                                            <circle cx="8.5" cy="13.5" r="1.5" />
                                        </svg>
                                    </div>
                                }

                            </div>


                            <!-- Details -->
                            <div class="dk-cart-item-details">

                                <p class="dk-cart-item-name">@item.ProductName</p>

                                <p class="dk-cart-item-variant">
                                    @item.VariantName
                                    <span class="dk-cart-item-sku">SKU: @item.Sku</span>
                                </p>

                                <div class="dk-cart-item-pricing">

                                    <span class="dk-cart-item-price">
                                        ₹@item.UnitPrice.ToString("N0")
                                    </span>

                                    @if (item.Mrp > item.UnitPrice)
                                    {
                                        <span class="dk-cart-item-mrp">
                                            ₹@item.Mrp.ToString("N0")
                                        </span>

                                        <span class="dk-cart-item-discount">
                                            @item.DiscountPercentage% off
                                        </span>
                                    }

                                </div>


                                <!-- Quantity Control -->
                                <div class="dk-cart-item-actions">

                                    <form asp-controller="Cart"
                                          asp-action="UpdateQuantity"
                                          method="post"
                                          class="dk-qty-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="ProductVariantId"
                                               value="@item.ProductVariantId" />

                                        <div class="dk-qty-control"
                                             role="group"
                                             aria-label="Quantity for @item.ProductName">

                                            <button type="submit"
                                                    name="Quantity"
                                                    value="@(item.Quantity - 1)"
                                                    class="dk-qty-btn dk-qty-minus"
                                                    aria-label="Decrease quantity">
                                                −
                                            </button>

                                            <span class="dk-qty-value"
                                                  aria-label="Quantity: @item.Quantity">
                                                @item.Quantity
                                            </span>

                                            <button type="submit"
                                                    name="Quantity"
                                                    value="@(item.Quantity + 1)"
                                                    class="dk-qty-btn dk-qty-plus"
                                                    aria-label="Increase quantity">
                                                +
                                            </button>

                                        </div>

                                    </form>


                                    <!-- Remove -->
                                    <form asp-controller="Cart"
                                          asp-action="RemoveItem"
                                          method="post"
                                          class="dk-remove-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="ProductVariantId"
                                               value="@item.ProductVariantId" />

                                        <button type="submit"
                                                class="dk-cart-remove"
                                                aria-label="Remove @item.ProductName from cart">
                                            Remove
                                        </button>

                                    </form>

                                </div>

                                <p class="dk-cart-item-line-total">
                                    Line Total:
                                    <strong>₹@item.LineTotal.ToString("N0")</strong>

                                    @if (item.LineDiscount > 0)
                                    {
                                        <span class="dk-cart-item-line-savings">
                                            (saving ₹@item.LineDiscount.ToString("N0"))
                                        </span>
                                    }
                                </p>

                            </div>

                        </div>
                    }


                    <!-- Clear Cart -->
                    <div class="dk-cart-clear">

                        <form asp-controller="Cart"
                              asp-action="ClearCart"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="dk-btn dk-btn--ghost"
                                    onclick="return confirm('Remove all items from cart?')">
                                Clear Cart
                            </button>

                        </form>

                    </div>

                </section>


                <!-- ORDER SUMMARY PANEL -->

                <aside class="dk-cart-summary" aria-label="Order summary">

                    <h2 class="dk-cart-summary-title">Price Details</h2>

                    <div class="dk-cart-summary-rows">

                        <div class="dk-cart-summary-row">
                            <span>
                                Price (@Model.TotalItems item@(Model.TotalItems == 1 ? "" : "s"))
                            </span>
                            <span>₹@Model.TotalMrp.ToString("N0")</span>
                        </div>

                        @if (Model.TotalDiscount > 0)
                        {
                            <div class="dk-cart-summary-row dk-cart-summary-row--discount">
                                <span>Discount</span>
                                <span>− ₹@Model.TotalDiscount.ToString("N0")</span>
                            </div>
                        }

                        <div class="dk-cart-summary-row">
                            <span>Delivery Charges</span>
                            <span class="dk-free-delivery">FREE</span>
                        </div>

                    </div>

                    <div class="dk-cart-summary-total">
                        <span>Total Amount</span>
                        <strong>₹@Model.Subtotal.ToString("N0")</strong>
                    </div>

                    @if (Model.TotalDiscount > 0)
                    {
                        <p class="dk-cart-savings-msg">
                            You save <strong>₹@Model.TotalDiscount.ToString("N0")</strong> on this order 🎉
                        </p>
                    }

                    <a href="/checkout"
                       class="dk-btn dk-btn--primary dk-btn--full dk-checkout-btn">
                        Proceed to Checkout
                    </a>

                    <a href="/products"
                       class="dk-continue-shopping">
                        ← Continue Shopping
                    </a>

                </aside>

            </div>

        }

    </div>

</main>
