@model Dreamflykit.Application.StudyHub.Models.StudyHubDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Study Essentials Hub Management";

    var hero = Model.HeroBanner ?? new();
    var s1 = Model.Section1 ?? new();
    var s2 = Model.Section2 ?? new();
    var s3Detail = Model.Section3Detail ?? new();
    var s4 = Model.Section4 ?? new();
    var s5 = Model.Section5 ?? new();
    var s6 = Model.Section6 ?? new();
    var s7 = Model.Section7 ?? new();
    var s8 = Model.Section8 ?? new();
    var s9 = Model.Section9 ?? new();
    var s10 = Model.Section10 ?? new();
    var bBanner = Model.BottomBanner ?? new();
    var catPage = Model.CategoriesPage ?? new();
    var chkPage = Model.ChecklistPage ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultChecklistPage();
    var abroadProfile = Model.AbroadProfile ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultAbroadProfile();

    var heroSlides = hero.Slides != null && hero.Slides.Count > 0
        ? hero.Slides
        : new List<Dreamflykit.Application.StudyHub.Models.StudyHubHeroSlideDto>
        {
            new() { Id = "hero-slide-1", ImageUrl = hero.ImageUrl, SecondaryBadge = hero.SecondaryBadge, LinkUrl = hero.ButtonUrl, Title = hero.Title }
        };
}

<div class="dk-admin-card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 class="dk-admin-card-title" style="font-size: 1.5rem; margin: 0 0 6px 0; display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.6rem;">🎓</span>
                Study Essentials &amp; Abroad Hub Management (All 10 Sections + Categories)
            </h1>
            <p style="margin: 0; color: #64748b; font-size: 0.9rem;">
                Super Admin control panel for all 10 Hub sections and the Study Essentials 8 Categories page. Super Admin can edit text, prices, and upload/replace images anytime.
            </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a href="/study-abroad-hub" target="_blank" class="dk-btn" style="background: #e0f2fe; color: #0369a1; border: 1px solid #7dd3fc; font-size: 13px; font-weight: 700; text-decoration: none; padding: 8px 16px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                ✈️ View Study Abroad Hub Profile
            </a>
            <a href="/category/study-essentials" target="_blank" class="dk-btn" style="background: #ffffff; color: #0284c7; border: 1px solid #bae6fd; font-size: 13px; font-weight: 600; text-decoration: none; padding: 8px 16px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px;">
                View Live Categories Page
            </a>
            <a href="/abroad-packing-checklist" target="_blank" class="dk-btn" style="background: #ffffff; color: #16a34a; border: 1px solid #bbf7d0; font-size: 13px; font-weight: 600; text-decoration: none; padding: 8px 16px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                View Live Checklist Page
            </a>
            <form asp-action="ResetDefaults" method="post" style="display: inline;" onsubmit="return confirm('Restore all 10 sections and categories to default content and test pics?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="dk-btn" style="background: #f8fafc; color: #b91c1c; border: 1px solid #fca5a5; font-size: 13px; font-weight: 600; padding: 8px 14px; border-radius: 8px; cursor: pointer;">
                    Reset to Defaults
                </button>
            </form>
            <button type="button" class="dk-btn dk-btn-primary" id="btnSaveTop" onclick="saveAllChanges()" style="padding: 8px 20px; font-size: 13px; font-weight: 700; border-radius: 8px; cursor: pointer;">
                💾 Save All Changes
            </button>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 12px 18px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
        <span>✓</span> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 18px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
        <span>✕</span> @TempData["ErrorMessage"]
    </div>
}

<!-- Hidden Global File Input for Instant Uploads -->
<input type="file" id="globalImageUploader" style="display: none;" accept="image/png,image/jpeg,image/webp,image/svg+xml" />

<!-- TABS NAVIGATION -->
<div class="dk-sh-admin-tabs">
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-abroad-profile')" style="background: #e0f2fe; border-color: #38bdf8; color: #0369a1; font-weight: 800;">✈️ Study Abroad Hub Profile</button>
    <button type="button" class="dk-sh-tab-btn active" onclick="switchAdminTab('tab-hero')">Hero &amp; Trust</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s1')">1. Shop by Category</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s2')">2. Study Kits</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s3')">3. Abroad Essentials</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s4')">4. Hub Checklist Card</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-checklist')" style="background: #f0fdf4; border-color: #86efac; color: #166534; font-weight: 800;">📋 Checklist Page (10 Categories)</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s5')">5. Destinations</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s6')">6. Build Kit</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s7')">7. Best Sellers</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s8')">8. Study Setup</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s9')">9. Why Dreamflykit</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-s10')">10. FAQs</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-cat')">📚 Categories Page (8 Categories)</button>
    <button type="button" class="dk-sh-tab-btn" onclick="switchAdminTab('tab-bottom')">Bottom Banner</button>
</div>

<!-- ========================================================
     TAB HERO: HERO BANNER & TRUST BAR
========================================================= -->
<div class="dk-sh-tab-pane active" id="tab-hero">
    <div class="dk-admin-card" style="margin-bottom: 20px;">
        <h3 class="dk-sh-tab-title">Hero Banner Controls</h3>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label class="dk-sh-form-label">Hero Title</label>
                <input type="text" id="hero_title" class="dk-admin-form-input" value="@hero.Title" />
            </div>
            <div>
                <label class="dk-sh-form-label">Hero Pill Badge</label>
                <input type="text" id="hero_pill" class="dk-admin-form-input" value="@hero.PillText" />
            </div>
        </div>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label class="dk-sh-form-label">Hero Subtitle</label>
                <input type="text" id="hero_sub" class="dk-admin-form-input" value="@hero.Subtitle" />
            </div>
            <div>
                <label class="dk-sh-form-label">Secondary Badge Text</label>
                <input type="text" id="hero_sec_badge" class="dk-admin-form-input" value="@hero.SecondaryBadge" />
            </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label class="dk-sh-form-label">Primary Button Text</label>
                <input type="text" id="hero_btn_text" class="dk-admin-form-input" value="@hero.ButtonText" />
            </div>
            <div>
                <label class="dk-sh-form-label">Primary Button Link</label>
                <input type="text" id="hero_btn_url" class="dk-admin-form-input" value="@hero.ButtonUrl" />
            </div>
        </div>

        <!-- Hero Slides & Automatic Move Timing Controls -->
        <div style="background: #f8fafc; border: 1.5px solid #bae6fd; border-radius: 14px; padding: 18px 20px; margin-top: 10px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; padding-bottom: 14px; border-bottom: 1px solid #e2e8f0; margin-bottom: 16px;">
                <div>
                    <div style="font-weight: 800; color: #0369a1; font-size: 1.05rem; display: flex; align-items: center; gap: 8px;">
                        <span>⏱️</span> Hero Slides Automatic Move Timeframe
                    </div>
                    <div style="font-size: 0.85rem; color: #64748b; margin-top: 2px;">
                        Admin decides how many seconds each slide stays before automatic rotation to the next slide.
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <label class="dk-sh-form-label" style="margin: 0; white-space: nowrap; font-weight: 700;">Interval (Seconds):</label>
                    <input type="number" id="hero_slide_interval" min="2" max="60" class="dk-admin-form-input" style="width: 100px; font-weight: 800; text-align: center; font-size: 1.05rem;" value="@(hero.AutoSlideIntervalSeconds > 0 ? hero.AutoSlideIntervalSeconds : 4)" />
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                <div>
                    <h4 style="margin: 0; font-size: 1rem; font-weight: 800; color: #0f172a;">
                        Hero Carousel Slides (<span id="hero_slides_count">@heroSlides.Count</span> Slides)
                    </h4>
                    <span style="font-size: 0.83rem; color: #64748b;">
                        Admin can add slide images, customize badges, and set destination links.
                    </span>
                </div>
                <button type="button" class="dk-btn dk-btn-primary" onclick="addNewHeroSlide()">
                    + Add New Slide
                </button>
            </div>

            <div id="hero_slides_container" style="display: flex; flex-direction: column; gap: 16px;">
                @for (int sIdx = 0; sIdx < heroSlides.Count; sIdx++)
                {
                    var slide = heroSlides[sIdx];
                    <div class="dk-sh-edit-card dk-sh-hero-slide-row" data-slide-id="@slide.Id" id="hero_slide_row_@sIdx" style="position: relative; border-left: 4px solid #0284c7; background: #ffffff;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <span class="hero-slide-label" style="font-weight: 800; color: #0284c7; font-size: 0.95rem;">Slide #@(sIdx + 1)</span>
                            <button type="button" class="dk-btn" style="background: #fee2e2; color: #b91c1c; font-size: 12px; padding: 4px 10px;" onclick="removeHeroSlide(this)">
                                🗑️ Remove Slide
                            </button>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                            <div>
                                <label class="dk-sh-form-label">Slide Badge Text (Floating badge on image)</label>
                                <input type="text" class="dk-admin-form-input hero-slide-badge-input" value="@slide.SecondaryBadge" placeholder="e.g. New Country New Opportunities Same You! ✈️" />
                            </div>
                            <div>
                                <label class="dk-sh-form-label">Slide Target Link URL</label>
                                <input type="text" class="dk-admin-form-input hero-slide-link-input" value="@slide.LinkUrl" placeholder="/category/study-essentials" />
                            </div>
                        </div>
                        <div style="margin-bottom: 12px;">
                            <label class="dk-sh-form-label">Slide Title / Alt Caption</label>
                            <input type="text" class="dk-admin-form-input hero-slide-title-input" value="@slide.Title" placeholder="Slide caption or description" />
                        </div>
                        <label class="dk-sh-form-label">Slide Image (Super Admin Replaceable)</label>
                        <div class="dk-sh-img-ctrl-row">
                            <div class="dk-sh-img-preview-box" style="width: 140px; height: 90px;">
                                <img id="preview_hero_slide_@sIdx" src="@slide.ImageUrl" onerror="this.src='/images/study-hub/test-pic-placeholder.svg';" />
                            </div>
                            <div style="flex: 1;">
                                <input type="text" id="hero_slide_img_@sIdx" class="dk-admin-form-input hero-slide-img-input" value="@slide.ImageUrl" oninput="updateImgPreview('hero_slide_img_@sIdx', 'preview_hero_slide_@sIdx')" style="margin-bottom: 8px;" />
                                <div style="display: flex; gap: 8px;">
                                    <button type="button" class="dk-btn dk-btn-primary" style="font-size: 12px; padding: 5px 12px;" onclick="triggerUploadFor('hero_slide_img_@sIdx', 'preview_hero_slide_@sIdx')">
                                        📷 Upload Slide Image
                                    </button>
                                    <button type="button" class="dk-btn" style="background: #f1f5f9; font-size: 12px; padding: 5px 12px;" onclick="setTestPic('hero_slide_img_@sIdx', 'preview_hero_slide_@sIdx')">
                                        Set as Test Pic
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     TAB S1: 1. SHOP BY CATEGORY
========================================================= -->
<div class="dk-sh-tab-pane" id="tab-s1">
    <div class="dk-admin-card" style="margin-bottom: 20px;">
        <h3 class="dk-sh-tab-title">Section 1: Header Controls</h3>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label class="dk-sh-form-label">Section Title</label>
                <input type="text" id="s1_title" class="dk-admin-form-input" value="@s1.Title" />
            </div>
            <div>
                <label class="dk-sh-form-label">View All Link Text</label>
                <input type="text" id="s1_view_all_text" class="dk-admin-form-input" value="@s1.ViewAllLinkText" />
            </div>
        </div>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
            <div>
                <label class="dk-sh-form-label">Section Subtitle</label>
                <input type="text" id="s1_subtitle" class="dk-admin-form-input" value="@s1.Subtitle" />
            </div>
            <div>
                <label class="dk-sh-form-label">View All Target URL</label>
                <input type="text" id="s1_view_all_url" class="dk-admin-form-input" value="@s1.ViewAllLinkUrl" />
            </div>
        </div>
    </div>

    <div class="dk-admin-card">
        <h3 class="dk-sh-tab-title">Section 1 Category Cards</h3>
        <div class="dk-sh-cards-edit-grid">
            @for (int i = 0; i < s1.Cards.Count; i++)
            {
                var card = s1.Cards[i];
                <div class="dk-sh-edit-card" id="s1_card_wrap_@i">
                    <div style="font-weight: 700; color: #0284c7; margin-bottom: 8px;">Card @(i + 1)</div>
                    <label class="dk-sh-form-label">Title</label>
                    <input type="text" id="s1_card_title_@i" class="dk-admin-form-input" value="@card.Title" style="margin-bottom: 8px;" />
                    <label class="dk-sh-form-label">Description</label>
                    <textarea id="s1_card_desc_@i" class="dk-admin-form-input" rows="2" style="margin-bottom: 8px;">@card.Description</textarea>
                    <label class="dk-sh-form-label">Target Link URL</label>
                    <input type="text" id="s1_card_link_@i" class="dk-admin-form-input" value="@card.LinkUrl" style="margin-bottom: 8px;" />

                    <label class="dk-sh-form-label">Card Image</label>
                    <div class="dk-sh-img-ctrl-row">
                        <div class="dk-sh-img-preview-box">
                            <img id="preview_s1_card_@i" src="@card.ImageUrl" onerror="this.src='/images/study-hub/test-pic-placeholder.svg';" />
                        </div>
                        <div style="flex: 1;">
                            <input type="text" id="s1_card_img_@i" class="dk-admin-form-input" value="@card.ImageUrl" oninput="updateImgPreview('s1_card_img_@i', 'preview_s1_card_@i')" style="margin-bottom: 6px;" />
                            <div style="display: flex; gap: 6px;">
                                <button type="button" class="dk-btn dk-btn-primary" style="font-size: 11px; padding: 4px 10px;" onclick="triggerUploadFor('s1_card_img_@i', 'preview_s1_card_@i')">Upload</button>
                                <button type="button" class="dk-btn" style="font-size: 11px; padding: 4px 8px; background: #f1f5f9;" onclick="setTestPic('s1_card_img_@i', 'preview_s1_card_@i')">Test Pic</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ========================================================
     TAB S2: 2. STUDY ESSENTIALS KITS
========================================================= -->
<div class="dk-sh-tab-pane" id="tab-s2">
    <div class="dk-admin-card" style="margin-bottom: 20px;">
        <h3 class="dk-sh-tab-title">Section 2: Curated Kits Header</h3>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
            <div>
                <label class="dk-sh-form-label">Title</label>
                <input type="text" id="s2_title" class="dk-admin-form-input" value="@s2.Title" />
            </div>
            <div>
                <label class="dk-sh-form-label">Subtitle</label>
                <input type="text" id="s2_subtitle" class="dk-admin-form-input" value="@s2.Subtitle" />
            </div>
        </div>
    </div>

    <div class="dk-admin-card">
        <h3 class="dk-sh-tab-title">3 Study Kit Bundles</h3>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;">
            @for (int i = 0; i < s2.Kits.Count; i++)
            {
                var kit = s2.Kits[i];
                <div class="dk-sh-edit-card">
                    <div style="font-weight: 700; color: #0284c7; margin-bottom: 8px;">Bundle Kit @(i + 1)</div>
                    <label class="dk-sh-form-label">Kit Title</label>
                    <input type="text" id="s2_kit_title_@i" class="dk-admin-form-input" value="@kit.Title" style="margin-bottom: 8px;" />
                    <label class="dk-sh-form-label">Badge Text</label>
                    <input type="text" id="s2_kit_badge_@i" class="dk-admin-form-input" value="@kit.BadgeText" style="margin-bottom: 8px;" />
                    <label class="dk-sh-form-label">Price Display (e.g. ₹1,499 - ₹2,999)</label>
                    <input type="text" id="s2_kit_price_disp_@i" class="dk-admin-form-input" value="@kit.PriceDisplay" style="margin-bottom: 8px;" />
                    <label class="dk-sh-form-label">Numeric Price (₹)</label>
                    <input type="number" id="s2_kit_price_num_@i" class="dk-admin-form-input" value="@kit.Price" style="margin-bottom: 8px;" />
                    <label class="dk-sh-form-label">Features (1 item per line)</label>
                    <textarea id="s2_kit_features_@i" class="dk-admin-form-input" rows="4" style="margin-bottom: 8px;">@string.Join("\n", kit.Features ?? new())</textarea>

                    <label class="dk-sh-form-label">Kit Image</label>
                    <div class="dk-sh-img-ctrl-row">
                        <div class="dk-sh-img-preview-box">
                            <img id="preview_s2_kit_@i" src="@kit.ImageUrl" onerror="this.src='/images/study-hub/test-pic-placeholder.svg';" />
                        </div>
                        <div style="flex: 1;">
                            <input type="text" id="s2_kit_img_@i" class="dk-admin-form-input" value="@kit.ImageUrl" oninput="updateImgPreview('s2_kit_img_@i', 'preview_s2_kit_@i')" style="margin-bottom: 6px;" />
                            <div style="display: flex; gap: 6px;">
                                <button type="button" class="dk-btn dk-btn-primary" style="font-size: 11px; padding: 4px 10px;" onclick="triggerUploadFor('s2_kit_img_@i', 'preview_s2_kit_@i')">Upload</button>
                                <button type="button" class="dk-btn" style="font-size: 11px; padding: 4px 8px; background: #f1f5f9;" onclick="setTestPic('s2_kit_img_@i', 'preview_s2_kit_@i')">Test Pic</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ========================================================
     TAB S3: 3. ABROAD ESSENTIALS (WHAT EVERY STUDENT NEEDS)
========================================================= -->
<div class="dk-sh-tab-pane" id="tab-s3">
    <div class="dk-admin-card" style="margin-bottom: 20px;">
        <h3 class="dk-sh-tab-title">Section 3: What Every Student Needs Before Going Abroad</h3>
        <p style="color: #64748b; font-size: 0.88rem; margin: -6px 0 16px 0;">
            Manage the abroad essentials header, adventure flight badge, and cards. Super Admin can upload/replace images, edit titles &amp; descriptions, choose icons, and set target links.
        </p>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label class="dk-sh-form-label">Section Title</label>
                <input type="text" id="s3_title" class="dk-admin-form-input" value="@s3Detail.Title" />
            </div>
            <div>
                <label class="dk-sh-form-label">Adventure Flight Badge Text (Top-right)</label>
                <input type="text" id="s3_badge" class="dk-admin-form-input" value="@s3Detail.BadgeText" placeholder="e.g. Be Ready for New Adventures ✈" />
            </div>
        </div>
        <div>
            <label class="dk-sh-form-label">Section Subtitle</label>
            <input type="text" id="s3_subtitle" class="dk-admin-form-input" value="@s3Detail.Subtitle" />
        </div>
    </div>

    <div class="dk-admin-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 class="dk-sh-tab-title" style="margin: 0;">Abroad Essentials Cards (@s3Detail.Cards.Count Cards)</h3>
            <span style="font-size: 0.82rem; color: #0284c7; background: #e0f2fe; padding: 4px 10px; border-radius: 6px; font-weight: 600;">
                Super Admin Image Upload Enabled
            </span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px;">
            @for (int i = 0; i < s3Detail.Cards.Count; i++)
            {
                var card = s3Detail.Cards[i];
                var modelPic = i switch
                {
                    0 => "/images/study-hub/card-study-ready.png",
                    1 => "/images/study-hub/card-connected.png",
                    2 => "/images/study-hub/card-documents.png",
                    3 => "/images/study-hub/card-student-life.png",
                    _ => "/images/study-hub/test-pic-placeholder.svg"
                };
