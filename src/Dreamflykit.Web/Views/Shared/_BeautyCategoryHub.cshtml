    min-height: 160px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.dk-bpc-promo-card:nth-child(2) .dk-bpc-promo-placeholder {
    background: linear-gradient(135deg, #b91c1c 0%, #991b1b 50%, #7f1d1d 100%);
