<!-- ========================================================
     CLIENT-SIDE JAVASCRIPT FOR CONSULTANCY HUB
========================================================= -->
<script>
    const allCountriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(countries));
    let currentCountryIndex = 0;

    function scrollCarousel(gridId, distance) {
        const grid = document.getElementById(gridId);
        if (grid) {
            grid.scrollBy({ left: distance, behavior: 'smooth' });
        }
    }

    function handleSearchCourses(query) {
        const q = (query || "").toLowerCase().trim();
        const cards = document.querySelectorAll(".dk-upg-course-card");
        cards.forEach(card => {
            const title = (card.dataset.title || "").toLowerCase();
            const inst = (card.dataset.inst || "").toLowerCase();
            if (!q || title.includes(q) || inst.includes(q)) {
                card.style.display = "flex";
            } else {
                card.style.display = "none";
            }
        });
    }

    function triggerSearchScroll() {
        const q = document.getElementById("upgCourseSearchInput")?.value;
        handleSearchCourses(q);
        const trendingSec = document.getElementById("trending-courses");
        if (trendingSec) {
            trendingSec.scrollIntoView({ behavior: 'smooth' });
        }
    }

    function filterCategory(tag, pillBtn) {
        // Toggle active pill state
        if (pillBtn) {
            document.querySelectorAll(".dk-upg-pill").forEach(p => p.classList.remove("active"));
            pillBtn.classList.add("active");
        }

        const tagMap = {
            'ai': 'ai',
            'ml': 'machine learning',
            'data': 'data',
            'doctorate': 'phd',
            'iit': 'iit',
            'mba': 'mba',
            'marketing': 'marketing',
            'management': 'management'
        };

        const searchKeyword = tagMap[tag] || tag;
        const searchInput = document.getElementById("upgCourseSearchInput");
        if (searchInput) {
            searchInput.value = searchKeyword;
        }
        handleSearchCourses(searchKeyword);

        const targetSec = (tag === 'mba' || tag === 'management') 
            ? document.getElementById("popular-programs") 
            : document.getElementById("trending-courses");
        if (targetSec) {
            targetSec.scrollIntoView({ behavior: 'smooth' });
        }
    }

    function renderDestinationCountry(c) {
        if (!c) return;
        const stage = document.getElementById("destHeroStage");
        if (stage && c.HeroImageUrl) {
            stage.style.backgroundImage = `url('\${c.HeroImageUrl}')`;
        }
        const slideNum = document.getElementById("destSlideNum");
        if (slideNum) {
            slideNum.textContent = c.SlideNumber || "01 / 9";
        }

        // Render Programs
        const progContainer = document.getElementById("destProgramsContainer");
        if (progContainer && c.Programs) {
            progContainer.innerHTML = c.Programs.map(p => `
                <div class="dk-upg-dest-program-card">
                    <div class="dk-upg-dest-card-header">
                        <div class="dk-upg-dest-flag-icon">🎓</div>
                        <div class="dk-upg-dest-inst">\${p.Institution}</div>
                    </div>
                    <h4 class="dk-upg-dest-card-title">\${p.Title}</h4>
                    \${p.BadgeTag ? `<div class="dk-upg-dest-accred-badge">\${p.BadgeTag}</div>` : ''}
                    <div class="dk-upg-dest-meta-row">
                        <span>🎓 \${p.BadgeType}</span>
                        <span>⏱ \${p.Duration}</span>
                    </div>
                    <button type="button" class="dk-upg-dest-btn-red" onclick="openProgramDetails('\${p.Institution}', '\${p.Title}', 'destination')">
                        \${p.Button1Text || 'View Program'}
                    </button>
                </div>
            `).join('');
        }

        // Render Stats
        const statsBar = document.getElementById("destStatsBar");
        if (statsBar && c.Stats) {
            statsBar.innerHTML = c.Stats.map(s => `
                <div class="dk-upg-stat-item">
                    <div class="dk-upg-stat-val">\${s.Value}</div>
                    <div class="dk-upg-stat-label">\${s.Label}</div>
                </div>
            `).join('');
        }
    }

    function switchDestinationCountry(code, btn) {
        document.querySelectorAll(".dk-upg-country-tab").forEach(t => t.classList.remove("active"));
        if (btn) btn.classList.add("active");

        const foundIdx = allCountriesData.findIndex(x => x.CountryCode === code);
        if (foundIdx >= 0) {
            currentCountryIndex = foundIdx;
            renderDestinationCountry(allCountriesData[currentCountryIndex]);
        }
    }

    function prevDestinationCountry() {
        if (!allCountriesData.length) return;
        currentCountryIndex = (currentCountryIndex - 1 + allCountriesData.length) % allCountriesData.length;
        const c = allCountriesData[currentCountryIndex];
        const tabs = document.querySelectorAll(".dk-upg-country-tab");
        if (tabs[currentCountryIndex]) {
            document.querySelectorAll(".dk-upg-country-tab").forEach(t => t.classList.remove("active"));
            tabs[currentCountryIndex].classList.add("active");
        }
        renderDestinationCountry(c);
    }

    function nextDestinationCountry() {
        if (!allCountriesData.length) return;
        currentCountryIndex = (currentCountryIndex + 1) % allCountriesData.length;
        const c = allCountriesData[currentCountryIndex];
        const tabs = document.querySelectorAll(".dk-upg-country-tab");
        if (tabs[currentCountryIndex]) {
            document.querySelectorAll(".dk-upg-country-tab").forEach(t => t.classList.remove("active"));
            tabs[currentCountryIndex].classList.add("active");
        }
        renderDestinationCountry(c);
    }

    // Modal Controls
    function openConsultancyModal(sourceInfo) {
        const modal = document.getElementById("consultancyModal");
        const programField = document.getElementById("leadTargetProgram");
        if (programField && sourceInfo) {
            programField.value = sourceInfo;
        }
        if (modal) {
            modal.style.display = "flex";
            document.getElementById("leadFullName")?.focus();
        }
    }

    function openProgramDetails(institution, title, mode) {
        const modalTitle = document.getElementById("modalDynamicTitle");
        const modalSub = document.getElementById("modalDynamicSub");
        const programField = document.getElementById("leadTargetProgram");

        if (mode === 'syllabus') {
            if (modalTitle) modalTitle.textContent = "Download Complete Syllabus & Curriculum";
            if (modalSub) modalSub.textContent = `Get the official curriculum brochure for \${title} (\${institution}).`;
        } else if (mode === 'apply') {
            if (modalTitle) modalTitle.textContent = "Apply for Admission & Scholarship";
            if (modalSub) modalSub.textContent = `Submit your interest for \${title} at \${institution}.`;
        } else {
            if (modalTitle) modalTitle.textContent = `1-on-1 Consultation: \${title}`;
            if (modalSub) modalSub.textContent = `Speak directly with a program advisor for \${institution}.`;
        }

        if (programField) {
            programField.value = `\${institution} - \${title}`;
        }

        const modal = document.getElementById("consultancyModal");
        if (modal) modal.style.display = "flex";
    }

    function closeConsultancyModal() {
        const modal = document.getElementById("consultancyModal");
        if (modal) modal.style.display = "none";
        const form = document.getElementById("consultancyLeadForm");
        const feedback = document.getElementById("leadSuccessFeedback");
        if (form) form.style.display = "block";
        if (feedback) feedback.style.display = "none";
    }

    async function handleLeadSubmit(e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitLead");
        const oldText = btn ? btn.innerHTML : "Submit";
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = "Submitting Consultation Request...";
        }

        const payload = {
            FullName: document.getElementById("leadFullName")?.value || "",
            PhoneNumber: document.getElementById("leadPhone")?.value || "",
            Email: document.getElementById("leadEmail")?.value || "",
            TargetDegree: document.getElementById("leadTargetDegree")?.value || "",
            DestinationCountry: document.getElementById("leadDestination")?.value || "",
            InterestedProgram: document.getElementById("leadTargetProgram")?.value || "",
            Message: document.getElementById("leadNotes")?.value || ""
        };

        try {
            const resp = await fetch("/study-abroad-hub/consultancy-lead", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();

            const form = document.getElementById("consultancyLeadForm");
            const feedback = document.getElementById("leadSuccessFeedback");
            const msg = document.getElementById("leadSuccessMessage");

            if (form) form.style.display = "none";
            if (feedback) feedback.style.display = "block";
            if (msg) msg.textContent = data.message || "Your consultation has been successfully booked!";
        } catch (err) {
            alert("Submission error: " + err.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = oldText;
            }
        }
    }

    // Scroll to Top visibility
    window.addEventListener("scroll", function() {
        const btn = document.getElementById("btnScrollTop");
        if (btn) {
            btn.style.display = window.scrollY > 400 ? "flex" : "none";
        }
    });
</script>
