<header class="dk-header">

    <!-- =====================================================
         TOP UTILITY BAR
    ====================================================== -->

    <div class="dk-utility">

        <div class="dk-shell dk-utility-inner">

            <div class="dk-utility-item">
                <span class="dk-icon">✈</span>
                Delivering Across USA, UK, Canada, Australia & More
            </div>

            <div class="dk-utility-divider"></div>

            <div class="dk-utility-item">
                <span class="dk-icon">✓</span>
                100% Genuine Products
            </div>

            <div class="dk-utility-divider"></div>

            <div class="dk-utility-item">
                <span class="dk-icon">★</span>
                Student Trusted
            </div>

            <div class="dk-utility-spacer"></div>

            <div class="dk-utility-item">
                Need Help?
            </div>

            <a href="tel:+919123456789"
               class="dk-utility-link">
                +91 91234 56789
            </a>

            <div class="dk-utility-divider"></div>

            <a href="/Orders/Track"
               class="dk-utility-link">
                Track Order
            </a>

        </div>

    </div>


    <!-- =====================================================
         MAIN HEADER
    ====================================================== -->

    <div class="dk-main-header">

        <div class="dk-shell dk-main-header-inner">


            <!-- LOGO -->

            <a href="/"
               class="dk-brand"
               aria-label="Dreamflykit Home">

                <img src="~/images/branding/dreamflykit-logo.webp"
                     alt="Dreamflykit"
                     class="dk-brand-image" />

            </a>


            <!-- SEARCH -->

            <form action="/Products/Search"
                  method="get"
                  class="dk-search">

                <span class="dk-search-icon">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="11"
                                cy="11"
                                r="7"></circle>

                        <path d="m20 20-4-4"></path>

                    </svg>

                </span>


                <input type="search"
                       name="q"
                       placeholder="Search for products, brands and more"
                       autocomplete="off" />


                <button type="submit"
                        aria-label="Search">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="11"
                                cy="11"
                                r="7"></circle>

                        <path d="m20 20-4-4"></path>

                    </svg>

                </button>

            </form>


            <!-- ACCOUNT -->

            <a href="/Account/Login"
               class="dk-account">

                <span class="dk-account-icon">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="12"
                                cy="8"
                                r="3.5"></circle>

                        <path d="M5 21c.8-4 3.2-6 7-6s6.2 2 7 6"></path>

                    </svg>

                </span>

                <span class="dk-account-text">

                    <small>
                        Login / Sign Up
                    </small>

                    <strong>
                        My Account
                    </strong>

                </span>

            </a>


            <!-- MENU -->

            <button type="button"
                    class="dk-menu-button"
                    id="mobileMenuButton"
                    aria-label="Open menu"
                    aria-expanded="false">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M4 6h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 18h16"></path>

                </svg>

                <span>
                    More<br />Menu
                </span>

            </button>


            <!-- CART -->

            <a href="/Cart"
               class="dk-cart">

                <span class="dk-cart-icon">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M3 4h2l2 12h11l2-8H6"></path>

                        <circle cx="9"
                                cy="20"
                                r="1.5"></circle>

                        <circle cx="18"
                                cy="20"
                                r="1.5"></circle>

                    </svg>

                    <span class="dk-cart-count">
                        0
                    </span>

                </span>

                <strong>
                    Cart
                </strong>

            </a>

        </div>

    </div>


