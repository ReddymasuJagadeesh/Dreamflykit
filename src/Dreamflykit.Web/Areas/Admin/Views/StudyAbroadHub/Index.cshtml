    async function saveAbroadProfile() {
        const btn = document.getElementById("btnBottomSave");
        if (btn) {
            btn.disabled = true;
            btn.textContent = "Saving...";
        }

        const slideSets = [];
        document.querySelectorAll("#abroad_sync_slide_sets_wrap .abroad-sync-slide-set-card").forEach((setCard, idx) => {
            const slideLabel = setCard.querySelector(".abroad-slide-label-input")?.value || ("Slide Set #" + (idx + 1));
            const slideId = setCard.dataset.slideId || ("sync-slide-" + (idx + 1));

            // Section 1: Spotlight
            const spotTitle = setCard.querySelector(".spot-title-input")?.value || "";
            const spotSub = setCard.querySelector(".spot-sub-input")?.value || "";
            const spotTag = setCard.querySelector(".spot-tag-input")?.value || "";
            const spotBtn = setCard.querySelector(".spot-btn-input")?.value || "Know More";
            const spotLink = setCard.querySelector(".spot-link-input")?.value || "/study-abroad-hub/ambassador-showcase";
            const spotImg = setCard.querySelector(".spot-img-input")?.value || "";

            // Section 2: Card 1
            const c1Title = setCard.querySelector(".c1-title-input")?.value || "";
            const c1Sub = setCard.querySelector(".c1-sub-input")?.value || "";
            const c1Icon = setCard.querySelector(".c1-icon-select")?.value || "loan";
            const c1Btn = setCard.querySelector(".c1-btn-input")?.value || "Know More";
            const c1Link = setCard.querySelector(".c1-link-input")?.value || "/study-abroad-hub/educational-loans";
            const c1Img = setCard.querySelector(".c1-img-input")?.value || "";

            // Section 3: Card 2
            const c2Title = setCard.querySelector(".c2-title-input")?.value || "";
            const c2Sub = setCard.querySelector(".c2-sub-input")?.value || "";
            const c2Icon = setCard.querySelector(".c2-icon-select")?.value || "consultancy";
            const c2Btn = setCard.querySelector(".c2-btn-input")?.value || "Know More";
            const c2Link = setCard.querySelector(".c2-link-input")?.value || "/study-abroad-hub/consultancy-details";
            const c2Img = setCard.querySelector(".c2-img-input")?.value || "";

            // Section 4: Card 3
            const c3Title = setCard.querySelector(".c3-title-input")?.value || "";
            const c3Sub = setCard.querySelector(".c3-sub-input")?.value || "";
            const c3Icon = setCard.querySelector(".c3-icon-select")?.value || "insurance";
            const c3Btn = setCard.querySelector(".c3-btn-input")?.value || "Know More";
            const c3Link = setCard.querySelector(".c3-link-input")?.value || "/study-abroad-hub/health-insurance";
            const c3Img = setCard.querySelector(".c3-img-input")?.value || "";

            // Section 5: Card 4
            const c4Title = setCard.querySelector(".c4-title-input")?.value || "";
            const c4Sub = setCard.querySelector(".c4-sub-input")?.value || "";
            const c4Icon = setCard.querySelector(".c4-icon-select")?.value || "scholarship";
            const c4Btn = setCard.querySelector(".c4-btn-input")?.value || "Know More";
            const c4Link = setCard.querySelector(".c4-link-input")?.value || "/study-abroad-hub/find-consultancies-near-me";
            const c4Img = setCard.querySelector(".c4-img-input")?.value || "";

            slideSets.push({
                Id: slideId,
                SlideLabel: slideLabel,
                Spotlight: {
                    Title: spotTitle,
                    Subtitle: spotSub,
                    TagText: spotTag,
                    ButtonText: spotBtn,
                    ButtonUrl: spotLink,
                    ImageUrl: spotImg
                },
                Card1: {
                    Title: c1Title,
                    Subtitle: c1Sub,
                    IconType: c1Icon,
                    ButtonText: c1Btn,
                    ButtonUrl: c1Link,
                    ImageUrl: c1Img
                },
                Card2: {
                    Title: c2Title,
                    Subtitle: c2Sub,
                    IconType: c2Icon,
                    ButtonText: c2Btn,
                    ButtonUrl: c2Link,
                    ImageUrl: c2Img
                },
                Card3: {
                    Title: c3Title,
                    Subtitle: c3Sub,
                    IconType: c3Icon,
                    ButtonText: c3Btn,
                    ButtonUrl: c3Link,
                    ImageUrl: c3Img
                },
                Card4: {
                    Title: c4Title,
                    Subtitle: c4Sub,
                    IconType: c4Icon,
                    ButtonText: c4Btn,
                    ButtonUrl: c4Link,
                    ImageUrl: c4Img
                }
            });
        });

        const payload = {
            HeroBadge: document.getElementById("abroad_hero_badge")?.value || "Study Abroad Hub",
            HeroTitle: document.getElementById("abroad_hero_title")?.value || "Your Dreams Abroad.",
            HeroTitleHighlight: document.getElementById("abroad_hero_highlight")?.value || "Our Support.",
            HeroSubtitle: document.getElementById("abroad_hero_sub")?.value || "Everything you need to plan your international education journey — all in one place.",
            HeroShowText: document.getElementById("abroad_hero_show_text") ? document.getElementById("abroad_hero_show_text").checked : false,
            HeroCtaText: document.getElementById("abroad_hero_cta_text")?.value || "Explore Study Abroad Hub →",
            HeroCtaUrl: document.getElementById("abroad_hero_cta_url")?.value || "#abroad-carousel",
            HeroImageUrl: document.getElementById("abroad_hero_img_url")?.value || "",
            HeroVideoUrl: document.getElementById("abroad_hero_video_url")?.value || "",
            HeroEnableVideo: document.getElementById("abroad_hero_enable_video") ? document.getElementById("abroad_hero_enable_video").checked : false,
            HeroHandwrittenNote: document.getElementById("abroad_hero_note")?.value || "Study Explore Grow ♡",
            FooterSlogan: document.getElementById("abroad_footer_slogan")?.value || "Your Global Education Partner ♡",
            FiveSectionCarousel: {
                IsEnabled: document.getElementById("abroad_sync_enabled") ? document.getElementById("abroad_sync_enabled").checked : true,
                AutoPlay: document.getElementById("abroad_sync_autoplay") ? document.getElementById("abroad_sync_autoplay").checked : true,
                SlideIntervalSeconds: parseInt(document.getElementById("abroad_sync_interval")?.value || "5", 10),
                TransitionDirection: document.getElementById("abroad_sync_direction")?.value || "rtl",
                SectionTitle: document.getElementById("abroad_sync_title")?.value || "Featured Opportunities & Global Services",
                SectionSubtitle: document.getElementById("abroad_sync_sub")?.value || "Synchronized study abroad offerings curated for international students.",
                Slides: slideSets
            },
            TrustPillars: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrustPillars, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }))
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const res = await fetch("/Admin/StudyAbroadHub/SaveConfig", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                    "RequestVerificationToken": token || ""
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                showHubToast("✓ Study Abroad Hub Profile saved successfully!", true);
            } else {
                alert("Save failed: " + (data.message || "Unknown error"));
            }
        } catch (err) {
            alert("Save failed: " + err.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = "💾 Save All Changes Now";
            }
        }
    }

    function showHubToast(message, isSuccess = true) {
        let toast = document.getElementById("hubToast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "hubToast";
            toast.style.cssText = "position: fixed; top: 24px; right: 24px; padding: 12px 24px; border-radius: 10px; font-weight: 800; font-size: 14px; z-index: 99999; box-shadow: 0 8px 24px rgba(0,0,0,0.2); transition: all 0.3s ease;";
            document.body.appendChild(toast);
        }
        toast.style.background = isSuccess ? "#059669" : "#d97706";
        toast.style.color = "#ffffff";
        toast.textContent = message;
        toast.style.display = "block";
        setTimeout(() => { toast.style.display = "none"; }, 3500);
    }
</script>
