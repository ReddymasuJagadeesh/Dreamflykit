    background: #f1f5f9;
    border-radius: 4px;
}
.dk-mob-stage-scroller::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
}
.dk-mob-stage-scroller::-webkit-scrollbar-thumb:hover {
