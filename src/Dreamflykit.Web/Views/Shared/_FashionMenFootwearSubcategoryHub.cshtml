    var selectedSizes = Array.from(sizeInputs).map(function(i) { return i.value.trim().toLowerCase(); });

    // 2. Colors checked
    var colorInputs = document.querySelectorAll('.dk-color-checkbox:checked');
    var selectedColors = Array.from(colorInputs).map(function(i) { return i.value.trim().toLowerCase(); });

    // 3. Price range
    var priceRadio = document.querySelector('input[name="footwearPriceRange"]:checked');
    var priceVal = priceRadio ? priceRadio.value : 'all';
    var minCustom = parseFloat(document.getElementById('footwearMinPrice').value) || 0;
    var maxCustom = parseFloat(document.getElementById('footwearMaxPrice').value) || 999999;

    var minPrice = 0, maxPrice = 999999;
    if (minCustom > 0 || maxCustom < 999999) {
        minPrice = minCustom;
        maxPrice = maxCustom;
    } else if (priceVal !== 'all') {
        var parts = priceVal.split('-');
        minPrice = parseFloat(parts[0]) || 0;
        maxPrice = parseFloat(parts[1]) || 999999;
    }

    // 4. Discount
    var discountRadio = document.querySelector('input[name="footwearDiscount"]:checked');
    var minDiscount = discountRadio ? parseInt(discountRadio.value, 10) : 0;

    // 5. Rating
    var ratingRadio = document.querySelector('input[name="footwearRating"]:checked');
    var minRating = ratingRadio ? parseFloat(ratingRadio.value) : 0;

    // 6. In stock
    var inStockOnly = document.getElementById('footwearInStockOnly').checked;

    var visibleCount = 0;

    cards.forEach(function(card) {
        var price = parseFloat(card.getAttribute('data-price')) || 0;
        var discount = parseInt(card.getAttribute('data-discount'), 10) || 0;
        var rating = parseFloat(card.getAttribute('data-rating')) || 0;
        var inStock = card.getAttribute('data-instock') === 'true';
        var cardSizes = (card.getAttribute('data-sizes') || '').toLowerCase().split(',');
        var cardColors = (card.getAttribute('data-colors') || '').toLowerCase().split(',');

        var match = true;

        if (price < minPrice || price > maxPrice) match = false;
        if (discount < minDiscount) match = false;
        if (rating < minRating) match = false;
        if (inStockOnly && !inStock) match = false;

        if (match && selectedSizes.length > 0) {
            var hasSize = selectedSizes.some(function(s) {
                return cardSizes.some(function(cs) { return cs.trim() === s; });
            });
            if (!hasSize) match = false;
        }

        if (match && selectedColors.length > 0) {
            var hasColor = selectedColors.some(function(c) {
                return cardColors.some(function(cc) { return cc.trim() === c; });
            });
            if (!hasColor) match = false;
        }

        if (match) {
            card.style.display = '';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });

    if (countBadge) countBadge.textContent = visibleCount;
    if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
}

function sortFootwearProducts(sortVal) {
    var grid = document.getElementById('footwearProductsGrid');
    if (!grid) return;
    var cards = Array.from(grid.querySelectorAll('.dk-footwear-card'));

    cards.sort(function(a, b) {
        var priceA = parseFloat(a.getAttribute('data-price')) || 0;
        var priceB = parseFloat(b.getAttribute('data-price')) || 0;
        var ratingA = parseFloat(a.getAttribute('data-rating')) || 0;
        var ratingB = parseFloat(b.getAttribute('data-rating')) || 0;
        var discA = parseInt(a.getAttribute('data-discount'), 10) || 0;
        var discB = parseInt(b.getAttribute('data-discount'), 10) || 0;

        switch (sortVal) {
            case 'price-asc': return priceA - priceB;
            case 'price-desc': return priceB - priceA;
            case 'rating': return ratingB - ratingA;
            case 'discount': return discB - discA;
            default: return 0;
        }
    });

    cards.forEach(function(card) { grid.appendChild(card); });
}

function resetFootwearFilters() {
    document.querySelectorAll('.dk-size-checkbox').forEach(function(cb) { cb.checked = false; });
    document.querySelectorAll('.dk-color-checkbox').forEach(function(cb) { cb.checked = false; });
    var allPrice = document.querySelector('input[name="footwearPriceRange"][value="all"]');
    if (allPrice) allPrice.checked = true;
    var minPriceIn = document.getElementById('footwearMinPrice');
    if (minPriceIn) minPriceIn.value = '';
    var maxPriceIn = document.getElementById('footwearMaxPrice');
    if (maxPriceIn) maxPriceIn.value = '';
    var allDisc = document.querySelector('input[name="footwearDiscount"][value="0"]');
    if (allDisc) allDisc.checked = true;
    var allRate = document.querySelector('input[name="footwearRating"][value="0"]');
    if (allRate) allRate.checked = true;
    var inStock = document.getElementById('footwearInStockOnly');
    if (inStock) inStock.checked = true;

    filterFootwearProducts();
}

function toggleSubFootwearWishlist(btn, ev) {
    ev.stopPropagation();
    btn.classList.toggle('active');
    var svg = btn.querySelector('svg');
    if (btn.classList.contains('active')) {
        svg.setAttribute('fill', '#e11d48');
        svg.setAttribute('stroke', '#e11d48');
        showSubFootwearToast('Saved to your Wishlist! ❤️');
    } else {
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', 'currentColor');
        showSubFootwearToast('Removed from Wishlist');
    }
}

function addSubFootwearCart(id, name, price, ev) {
    ev.stopPropagation();
    var btn = ev.currentTarget;
    var originalText = btn.innerHTML;
    btn.innerHTML = '✓ Added to Cart';
    btn.style.background = '#16a34a';
    btn.disabled = true;

    var cartBadge = document.querySelector('.dk-header-cart-count, .dk-cart-count, [data-cart-count]');
    if (cartBadge) {
        var count = parseInt(cartBadge.textContent || '0', 10);
        cartBadge.textContent = count + 1;
    }

    showSubFootwearToast('Added "' + name + '" to your cart!');

    setTimeout(function() {
        btn.innerHTML = originalText;
        btn.style.background = '';
        btn.disabled = false;
    }, 1800);
}

function showSubFootwearToast(msg) {
    var toast = document.createElement('div');
    toast.className = 'dk-footwear-toast';
    toast.textContent = msg;
    toast.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#0f172a;color:#fff;padding:12px 20px;border-radius:10px;font-size:14px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.25);z-index:99999;opacity:0;transform:translateY(10px);transition:all 0.3s ease;display:flex;align-items:center;gap:8px;';
    document.body.appendChild(toast);
    setTimeout(function() {
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
    }, 50);
    setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        setTimeout(function() { toast.remove(); }, 300);
    }, 3000);
}
</script>
