<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Dreamflykit Seller Central</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body.dk-seller-body {
            margin: 0;
            padding: 0;
            background: #0b1329;
            color: #f1f5f9;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }
        .dk-seller-layout {
            display: flex;
            min-height: 100vh;
        }
        .dk-seller-sidebar {
            width: 260px;
            background: #0f172a;
            border-right: 1px solid #1e293b;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 50;
        }
        .dk-seller-brand {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid #1e293b;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .dk-seller-logo {
            font-size: 1.25rem;
            font-weight: 800;
            color: #f8fafc;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .dk-seller-tag {
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            background: linear-gradient(135deg, #10b981, #06b6d4);
            color: #fff;
            padding: 2px 8px;
            border-radius: 9999px;
            letter-spacing: 0.05em;
        }
        .dk-seller-nav {
            padding: 1rem 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            flex: 1;
        }
        .dk-seller-nav-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.7rem 1rem;
            border-radius: 8px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.15s ease;
        }
        .dk-seller-nav-item:hover {
            color: #f8fafc;
            background: #1e293b;
        }
        .dk-seller-nav-item.active {
            color: #fff;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.25), rgba(6, 182, 212, 0.25));
            border: 1px solid rgba(16, 185, 129, 0.4);
        }
        .dk-seller-main {
            margin-left: 260px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }
        .dk-seller-topbar {
            height: 64px;
            background: #0f172a;
            border-bottom: 1px solid #1e293b;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 40;
        }
        .dk-seller-content {
            padding: 2rem;
            flex: 1;
        }
    </style>
</head>
<body class="dk-seller-body">
    <div class="dk-seller-layout">
        <!-- SIDEBAR -->
        <aside class="dk-seller-sidebar">
            <div class="dk-seller-brand">
                <a href="/Seller" class="dk-seller-logo">
                    <span style="color:#10b981;">✈</span>
                    <span>Dreamflykit</span>
                </a>
                <span class="dk-seller-tag">SELLER</span>
            </div>

            <nav class="dk-seller-nav">
                <div style="font-size: 0.7rem; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.5rem 0.75rem 0.25rem;">
                    Partner Portal
                </div>

                <a href="/Seller" class="dk-seller-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span>Dashboard</span>
                </a>

                <a href="/Seller/Products" class="dk-seller-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" && ViewContext.RouteData.Values["action"]?.ToString() != "Create" ? "active" : "")">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                    <span>All Products</span>
                </a>

                <a href="/Seller/Products/Create" class="dk-seller-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" style="color:#38bdf8;">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="16"></line>
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                    <span>+ Add Product</span>
                </a>

                <div style="font-size: 0.7rem; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: 0.05em; padding: 1.5rem 0.75rem 0.25rem;">
                    Storefront
                </div>

                <a href="/products" target="_blank" class="dk-seller-nav-item">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    <span>View Live Store ↗</span>
                </a>
            </nav>

            <div style="padding: 1rem; border-top: 1px solid #1e293b;">
                <form action="/Seller/Logout" method="post" id="sellerSignOutForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="width:100%; display:flex; align-items:center; justify-content:center; gap:0.6rem; padding:0.65rem 0.9rem; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.3); color:#fca5a5; border-radius:8px; font-size:0.85rem; font-weight:700; cursor:pointer; transition: all 0.2s ease;">
                        <span>🚪</span>
                        <span>Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN AREA -->
        <div class="dk-seller-main">
            <!-- TOPBAR -->
            <header class="dk-seller-topbar">
                <div style="display:flex; align-items:center; gap:0.75rem;">
                    <span style="font-weight:700; color:#cbd5e1; font-size:0.9rem;">
                        🏪 Seller Central
                    </span>
                    <span style="color:#475569;">•</span>
                    <span style="font-size:0.8rem; color:#10b981; background:rgba(16,185,129,0.15); padding:2px 8px; border-radius:9999px; font-weight:700;">
                        Authorized Partner
                    </span>
                </div>

                <div style="display:flex; align-items:center; gap:1.25rem;">
                    <div style="text-align:right;">
                        <div style="font-size:0.85rem; font-weight:700; color:#f8fafc;">
                            @User.Identity?.Name
                        </div>
                        <div style="font-size:0.75rem; color:#94a3b8;">
                            Verified Seller
                        </div>
                    </div>

                    <a href="/Seller/Products/Create" style="display:inline-flex; align-items:center; gap:0.4rem; padding:0.45rem 0.9rem; background:linear-gradient(135deg, #10b981, #059669); color:#fff; border-radius:6px; font-size:0.85rem; font-weight:700; text-decoration:none; box-shadow:0 2px 8px rgba(16,185,129,0.3);">
                        <span>+ Add Product</span>
                    </a>
                </div>
            </header>

            <!-- PAGE CONTENT -->
            <main class="dk-seller-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
