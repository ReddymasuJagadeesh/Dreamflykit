                                        </div>
                                        <span class="dk-elec-prod-soon-sub">Images will be uploaded by admin</span>
                                    </div>
                                }
                                else
                                {
                                    <img src="@prod.ImageUrl"
                                         alt="@prod.Name"
                                         loading="lazy"
                                         class="dk-elec-prod-img"
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                    <div class="dk-elec-radar-placeholder" style="display: none;">
                                        <div class="dk-elec-radar-animation">
                                            <span class="dk-elec-pulse-ring r1"></span>
                                            <span class="dk-elec-pulse-ring r2"></span>
                                            <span class="dk-elec-prod-emoji">@activePage.Emoji</span>
                                        </div>
                                        <div class="dk-elec-prod-soon-tag">
                                            <span class="dk-elec-mini-dot">●</span> UPLOADING SOON
                                        </div>
                                        <span class="dk-elec-prod-soon-sub">Images will be uploaded by admin</span>
                                    </div>
                                }
                            </a>

                            <!-- Product Details Body -->
                            <div class="dk-elec-card-body">
                                <div class="dk-elec-card-meta">
                                    <span class="dk-elec-chip-brand">@brandName</span>
                                    @if (!string.IsNullOrWhiteSpace(prod.ProductType))
                                    {
                                        <span class="dk-elec-chip-cat">@prod.ProductType</span>
                                    }
                                </div>

                                <span class="dk-elec-card-title" title="@prod.Name">
                                    @prod.Name
                                </span>

                                @if (!string.IsNullOrWhiteSpace(prod.Specs))
                                {
                                    <div class="dk-elec-specs-chip">
                                        ⚡ @prod.Specs
                                    </div>
                                }

                                <div class="dk-elec-rating-row">
                                    <div class="dk-elec-stars">★★★★★</div>
                                    <span class="dk-elec-rating-val">@prod.Rating.ToString("0.0")</span>
                                    <span class="dk-elec-rating-count">(@prod.ReviewCount reviews)</span>
                                </div>

                                <div class="dk-elec-pricing-row">
                                    <span class="dk-elec-price-current">₹@prod.Price.ToString("N0")</span>
