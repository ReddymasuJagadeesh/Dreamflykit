                </ul>
                <div class="dk-kit-footer">
                    <div class="dk-kit-price-wrap">
                        <span class="dk-kit-price">₹3,799</span>
                        <del class="dk-kit-mrp">₹6,499</del>
                        <span class="dk-kit-discount-tag">41% OFF</span>
                    </div>
                    <a href="/category/study-essentials" class="dk-btn-order-kit">Explore Kit</a>
                </div>
            </div>

            <!-- KIT 3: CANADA -->
            <div class="dk-kit-card">
                <div class="dk-kit-badge">Sub-Zero • Canada 🇨🇦</div>
                <div class="dk-kit-header">
                    <div class="dk-kit-flag">🇨🇦</div>
                    <div>
                        <h3 class="dk-kit-title">Canada Winter Survival Kit</h3>
                        <p class="dk-kit-subtitle">Cold Climate &amp; Travel Essentials</p>
                    </div>
                </div>
                <ul class="dk-kit-features-list">
                    <li>✓ Thermal Insulated Food Flask &amp; Hot Water Vacuum Thermos</li>
                    <li>✓ Touchscreen Thermal Winter Gloves &amp; Fleece Beanie</li>
                    <li>✓ Heavy Duty Type-A/B Power Strip with Surge Suppressor</li>
                    <li>✓ Waterproof Heavy Duty Luggage Protective Rain Covers</li>
                    <li>✓ Dual-Dial TSA Padlocks + Stainless Steel Cable Tags</li>
                </ul>
                <div class="dk-kit-footer">
                    <div class="dk-kit-price-wrap">
                        <span class="dk-kit-price">₹4,199</span>
                        <del class="dk-kit-mrp">₹6,999</del>
                        <span class="dk-kit-discount-tag">40% OFF</span>
                    </div>
                    <a href="/category/study-essentials" class="dk-btn-order-kit">Explore Kit</a>
                </div>
            </div>

            <!-- KIT 4: AUSTRALIA -->
            <div class="dk-kit-card">
                <div class="dk-kit-badge">Down Under • Australia 🇦🇺</div>
                <div class="dk-kit-header">
                    <div class="dk-kit-flag">🇦🇺</div>
                    <div>
                        <h3 class="dk-kit-title">Australia Prep Scholar Kit</h3>
                        <p class="dk-kit-subtitle">Type-I V-Prong • Student Essentials</p>
                    </div>
                </div>
                <ul class="dk-kit-features-list">
                    <li>✓ 2x Australia &amp; New Zealand Type-I Certified Power Adapters</li>
                    <li>✓ Biosecurity Quarantine Compliant Sealed Storage Pouches</li>
                    <li>✓ High Precision Luggage Weight Hook Scale</li>
                    <li>✓ Noise Cancelling Memory Foam Travel Neck Pillow &amp; Mask</li>
                    <li>✓ Lightweight Packing Cubes Set (Water Resistant)</li>
                </ul>
                <div class="dk-kit-footer">
                    <div class="dk-kit-price-wrap">
                        <span class="dk-kit-price">₹3,699</span>
                        <del class="dk-kit-mrp">₹5,999</del>
                        <span class="dk-kit-discount-tag">38% OFF</span>
