@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.FashionHub ?? Dreamflykit.Application.FashionHub.Models.FashionHubDto.CreateDefault();
    var women = hub.WomenClothing ?? Dreamflykit.Application.FashionHub.Models.FashionWomenClothingDto.CreateDefault();
    var subPage = Model.WomenSubcategoryPage;
    var currentSlug = (Model.CurrentSubcategorySlug ?? "").Trim().ToLowerInvariant();

    if (subPage == null && women.SubcategoryPages != null && women.SubcategoryPages.Count > 0)
    {
        subPage = women.SubcategoryPages.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSlug, StringComparison.OrdinalIgnoreCase));
    }

    if (subPage == null)
    {
        var matchedCat = women.CategoriesSection?.Categories?.FirstOrDefault(c =>
            string.Equals(c.Slug, currentSlug, StringComparison.OrdinalIgnoreCase));

        var catName = matchedCat?.Name ?? (!string.IsNullOrWhiteSpace(Model.CurrentSubcategoryName)
            ? Model.CurrentSubcategoryName
            : (string.IsNullOrWhiteSpace(currentSlug) ? "Women Clothing" : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(currentSlug.Replace("-", " "))));

        var defaultPages = Dreamflykit.Application.FashionHub.Models.FashionWomenClothingDto.CreateDefaultSubcategoryPages();
        subPage = defaultPages.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSlug, StringComparison.OrdinalIgnoreCase))
            ?? new Dreamflykit.Application.FashionHub.Models.FashionWomenSubcategoryPageDto
            {
                CategorySlug = currentSlug,
                CategoryName = catName,
                HeroBanner = new Dreamflykit.Application.FashionHub.Models.FashionWomenSubcategoryHeroDto
                {
                    Title = catName,
                    TitleHighlight = "STUDENT ESSENTIALS • 100% GENUINE",
                    Subtitle = $"Discover our premium curated collection of {catName} tailored with breathable, lightweight fabrics for international student life.",
                    IsUploadingSoon = true
                },
                Products = defaultPages.FirstOrDefault()?.Products ?? new List<Dreamflykit.Application.FashionHub.Models.FashionProductItemDto>()
            };
    }

    var hero = subPage.HeroBanner ?? new Dreamflykit.Application.FashionHub.Models.FashionWomenSubcategoryHeroDto();
    var products = (subPage.Products != null && subPage.Products.Count > 0)
        ? subPage.Products.Where(p => p.IsActive).ToList()
        : new List<Dreamflykit.Application.FashionHub.Models.FashionProductItemDto>();

    var allCategories = women.CategoriesSection?.Categories?.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToList()
        ?? new List<Dreamflykit.Application.FashionHub.Models.FashionCategoryItemDto>();

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="dk-women-subpage-container dk-shell" id="womenSubpageRoot">

    <!-- Festival Announcement Ribbon (if enabled by admin) -->
    @if (women.FestivalTheme != null && women.FestivalTheme.IsEnabled && !string.IsNullOrWhiteSpace(women.FestivalTheme.AnnouncementText))
    {
        <div class="dk-sub-fest-ribbon" style="background: @(!string.IsNullOrWhiteSpace(women.FestivalTheme.BgGradient) ? women.FestivalTheme.BgGradient : "linear-gradient(135deg, #e11d48 0%, #ea580c 100%)");">
            <span class="dk-sub-fest-badge">@(!string.IsNullOrWhiteSpace(women.FestivalTheme.BadgeText) ? women.FestivalTheme.BadgeText : "FESTIVAL SPECIAL")</span>
            <span class="dk-sub-fest-text">@women.FestivalTheme.AnnouncementText</span>
            @if (!string.IsNullOrWhiteSpace(women.FestivalTheme.BannerHighlight))
            {
                <span class="dk-sub-fest-highlight">@women.FestivalTheme.BannerHighlight</span>
            }
        </div>
    }

    <!-- ========================================================
         1. HERO BANNER (MATCHING INDUSTRY STANDARD FASHION LANDING)
    ========================================================= -->
    <section class="dk-women-sub-hero-card" aria-label="@subPage.CategoryName Hero Banner">
        <div class="dk-women-sub-hero-glow"></div>
        <div class="dk-women-sub-hero-body">
            <div class="dk-women-sub-hero-content">
                <nav class="dk-women-sub-breadcrumb" aria-label="Women clothing breadcrumb">
                    <a href="/category/fashion">Fashion</a>
                    <span class="dk-women-sub-sep">/</span>
                    <a href="/category/fashion/women-clothing">Women Clothing</a>
                    <span class="dk-women-sub-sep">/</span>
                    <span class="dk-women-sub-crumb-active">@subPage.CategoryName</span>
                </nav>

                <div class="dk-women-sub-hero-badge">
                    <span class="dk-badge-dot">●</span>
                    <span>@(!string.IsNullOrWhiteSpace(hero.TitleHighlight) ? hero.TitleHighlight : "STUDENT ESSENTIALS • 100% GENUINE")</span>
                </div>

                <h1 class="dk-women-sub-hero-title">@subPage.CategoryName</h1>
                
                <p class="dk-women-sub-hero-desc">
                    @(string.IsNullOrWhiteSpace(hero.Subtitle)
                        ? $"Discover our premium curated collection of {subPage.CategoryName} tailored with breathable, lightweight fabrics for campus life and travel."
                        : hero.Subtitle)
                </p>

                <div class="dk-women-sub-hero-chips">
                    <span class="dk-hero-chip">✓ In Stock Guarantee</span>
                    <span class="dk-hero-chip">✓ Campus Delivery Ready</span>
                    <span class="dk-hero-chip">✓ 100% Genuine Fabrics</span>
                    @if (canManage)
                    {
                        <a href="/Admin/FashionHub#tab-women-clothing" class="dk-sub-admin-link">⚙ Edit in Admin Dashboard</a>
                    }
                </div>
            </div>

            <div class="dk-women-sub-hero-media">
                @if (!string.IsNullOrWhiteSpace(hero.ImageUrl) && !hero.ImageUrl.Contains("placeholder") && !hero.IsUploadingSoon)
                {
                    <div class="dk-women-sub-banner-img-wrap">
                        <img src="@hero.ImageUrl" alt="@subPage.CategoryName" class="dk-women-sub-banner-img" />
                    </div>
                }
                else
                {
                    <div class="dk-women-sub-hero-uploading">
                        <div class="dk-women-sub-uploading-radar">
                            <span class="dk-women-sub-radar-ring"></span>
                            <span class="dk-women-sub-emoji">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                        </div>
                        <div class="dk-women-sub-uploading-pill">
                            <span class="dk-mini-dot">●</span> Uploading Soon
                        </div>
                        <p class="dk-women-sub-uploading-text">Admin will upload banner image</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         2. MAIN TWO-COLUMN LAYOUT (LEFT FILTERS, RIGHT PRODUCTS)
    ========================================================= -->
    <div class="dk-women-sub-layout">
        
        <!-- LEFT FILTER SIDEBAR -->
        <aside class="dk-women-sub-sidebar" id="dkWomenSubSidebar" aria-label="Filters">
            <div class="dk-filter-card">
                <div class="dk-filter-header">
                    <h3 class="dk-filter-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filters
                    </h3>
                    <button type="button" class="dk-btn-clear-filters" id="btnClearAllFilters" onclick="resetWomenFilters()">
                        Reset All
                    </button>
                </div>

                <!-- 1. Categories Quick Switcher (All 14 Women Subcategories) -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Women Categories (14)</h4>
                    <div class="dk-cat-quick-list">
                        @foreach (var cat in allCategories)
                        {
                            var isCurrent = string.Equals(cat.Slug, subPage.CategorySlug, StringComparison.OrdinalIgnoreCase);
                            <a href="/category/fashion/women-clothing/@cat.Slug" 
                               class="dk-cat-quick-item @(isCurrent ? "active" : "")" 
                               title="@cat.Name">
                                <span class="dk-cat-quick-emoji">@GetSubcategoryIcon(cat.Slug)</span>
                                <span class="dk-cat-quick-name">@cat.Name</span>
                                @if (isCurrent)
                                {
                                    <span class="dk-cat-current-dot">●</span>
                                }
                            </a>
                        }
                    </div>
                </div>

                <!-- 2. Size Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Size</h4>
                    <div class="dk-sizes-chips-grid">
                        @foreach (var size in new[] { "XS", "S", "M", "L", "XL", "XXL", "Free Size" })
                        {
                            <label class="dk-size-chip-label">
                                <input type="checkbox" class="dk-size-checkbox" value="@size" onchange="filterWomenProducts()" />
                                <span class="dk-size-chip-box">@size</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 3. Color Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Color</h4>
                    <div class="dk-colors-grid">
                        @foreach (var (cName, cHex) in new[] { 
                            ("Black", "#0f172a"), ("White", "#ffffff"), ("Navy", "#1e3a8a"), 
                            ("Pink", "#f43f5e"), ("Beige", "#d4b896"), ("Olive", "#4d7c0f"), 
                            ("Maroon", "#881337"), ("Grey", "#64748b") })
                        {
                            <label class="dk-color-swatch-item" title="@cName">
                                <input type="checkbox" class="dk-color-checkbox" value="@cName" onchange="filterWomenProducts()" />
                                <span class="dk-color-circle" style="background-color: @cHex; @(cName == "White" ? "border: 1.5px solid #cbd5e1;" : "")"></span>
                                <span class="dk-color-name">@cName</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 4. Price Range Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Price Range</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="womenPriceRange" value="all" checked onchange="filterWomenProducts()" />
                            <span>All Prices</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenPriceRange" value="0-499" onchange="filterWomenProducts()" />
                            <span>Under ₹499</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenPriceRange" value="500-999" onchange="filterWomenProducts()" />
                            <span>₹500 - ₹999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenPriceRange" value="1000-1999" onchange="filterWomenProducts()" />
                            <span>₹1,000 - ₹1,999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenPriceRange" value="2000-3499" onchange="filterWomenProducts()" />
                            <span>₹2,000 - ₹3,499</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenPriceRange" value="3500-99999" onchange="filterWomenProducts()" />
                            <span>₹3,500 &amp; Above</span>
                        </label>
                    </div>
                    <div class="dk-price-custom-row">
                        <input type="number" id="womenMinPrice" placeholder="Min ₹" class="dk-price-input" onchange="filterWomenProducts()" />
                        <span class="dk-price-sep">-</span>
                        <input type="number" id="womenMaxPrice" placeholder="Max ₹" class="dk-price-input" onchange="filterWomenProducts()" />
                        <button type="button" class="dk-btn-price-go" onclick="filterWomenProducts()">Go</button>
                    </div>
                </div>

                <!-- 5. Discount Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Discount</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="womenDiscount" value="0" checked onchange="filterWomenProducts()" />
                            <span>All Discounts</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenDiscount" value="10" onchange="filterWomenProducts()" />
                            <span>10% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenDiscount" value="20" onchange="filterWomenProducts()" />
                            <span>20% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenDiscount" value="30" onchange="filterWomenProducts()" />
                            <span>30% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenDiscount" value="50" onchange="filterWomenProducts()" />
                            <span>50% and above</span>
                        </label>
                    </div>
                </div>

                <!-- 6. Customer Rating -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Customer Rating</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="womenRating" value="0" checked onchange="filterWomenProducts()" />
                            <span>All Ratings</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenRating" value="4.5" onchange="filterWomenProducts()" />
                            <span>★ 4.5 &amp; above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="womenRating" value="4.0" onchange="filterWomenProducts()" />
                            <span>★ 4.0 &amp; above</span>
                        </label>
                    </div>
                </div>

                <!-- 7. Availability -->
                <div class="dk-filter-section" style="border-bottom: none;">
                    <label class="dk-switch-row">
                        <span class="dk-switch-text">In Stock Only</span>
                        <input type="checkbox" id="womenInStockOnly" checked onchange="filterWomenProducts()" />
                        <span class="dk-slider-toggle"></span>
                    </label>
                </div>

            </div>
        </aside>

        <!-- RIGHT PRODUCTS CATALOG GRID -->
        <main class="dk-women-sub-main" id="dkWomenSubMain">
            
            <!-- Products Header Bar -->
            <div class="dk-women-sub-topbar">
                <div class="dk-topbar-info">
                    <h2 class="dk-topbar-title">@subPage.CategoryName</h2>
                    <span class="dk-topbar-count">
                        Showing <strong id="womenProductCount">@products.Count</strong> products
                    </span>
                </div>

                <!-- Active Filter Tags Row -->
                <div class="dk-active-filters-row" id="womenActiveFiltersRow" style="display: none;"></div>

                <!-- Sort Control -->
                <div class="dk-topbar-sort">
                    <label for="womenSortSelect" class="dk-sort-label">Sort by:</label>
                    <select id="womenSortSelect" class="dk-sort-select" onchange="sortWomenProducts(this.value)">
                        <option value="relevance">Relevance</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="rating">Customer Rating</option>
                        <option value="discount">Highest Discount</option>
                    </select>
                </div>
            </div>

            <!-- Products Grid with BIG IMAGE FRAMES -->
            <div class="dk-women-products-grid" id="womenProductsGrid">
                @foreach (var prod in products)
                {
                    var discountPct = 0;
                    if (prod.OriginalPrice.HasValue && prod.OriginalPrice.Value > prod.Price)
                    {
                        discountPct = (int)Math.Round((1m - (prod.Price / prod.OriginalPrice.Value)) * 100m);
                    }
                    var sizesStr = prod.Sizes != null && prod.Sizes.Count > 0 ? string.Join(",", prod.Sizes) : "S,M,L";
                    var colorsStr = prod.Colors != null && prod.Colors.Count > 0 ? string.Join(",", prod.Colors) : "Black,White";

                    <div class="dk-women-card" 
                         data-id="@prod.Id"
                         data-price="@((int)prod.Price)"
                         data-sizes="@sizesStr"
                         data-colors="@colorsStr"
                         data-rating="@prod.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                         data-discount="@discountPct"
                         data-instock="@(prod.InStock ? "true" : "false")">

                        <!-- Wishlist button -->
                        <button type="button" class="dk-women-wishlist-btn" title="Save to wishlist" onclick="toggleWomenWishlist(this, event)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </button>

                        <!-- BIG IMAGE FRAME (HIGH DEFINITION PORTRAIT) -->
                        <div class="dk-women-img-frame">
                            <!-- Badge -->
                            @if (!string.IsNullOrWhiteSpace(prod.Badge))
                            {
                                <span class="dk-women-card-badge">@prod.Badge</span>
                            }

                            @if (!prod.IsUploadingSoon && !string.IsNullOrWhiteSpace(prod.ImageUrl) && !prod.ImageUrl.Contains("uploading-soon"))
                            {
                                <img src="@prod.ImageUrl" alt="@prod.Name" class="dk-women-card-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="dk-women-card-soon-box" style="display: none;">
                                    <div class="dk-women-soon-radar-sm">
                                        <span class="dk-women-soon-radar-ring"></span>
                                        <span class="dk-women-soon-icon">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                                    </div>
                                    <span class="dk-women-card-soon-pill">⏳ UPLOADING SOON</span>
                                    <span class="dk-women-card-soon-hint">Curated Student Fashion</span>
                                </div>
                            }
                            else
                            {
                                <div class="dk-women-card-soon-box">
                                    <div class="dk-women-soon-radar-sm">
                                        <span class="dk-women-soon-radar-ring"></span>
                                        <span class="dk-women-soon-icon">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                                    </div>
                                    <span class="dk-women-card-soon-pill">⏳ UPLOADING SOON</span>
                                    <span class="dk-women-card-soon-hint">Curated Student Fashion</span>
                                </div>
                            }
                        </div>

                        <!-- Card Body Details -->
                        <div class="dk-women-card-body">
                            <div class="dk-women-card-cat">WOMEN &bull; @subPage.CategoryName.ToUpper()</div>
                            
                            <h3 class="dk-women-card-title" title="@prod.Name">
                                @prod.Name
                            </h3>

                            <!-- Price row -->
                            <div class="dk-women-price-row">
                                <span class="dk-women-selling-price">₹@prod.Price.ToString("N0")</span>
                                @if (prod.OriginalPrice.HasValue && prod.OriginalPrice.Value > prod.Price)
                                {
                                    <span class="dk-women-mrp-price">₹@prod.OriginalPrice.Value.ToString("N0")</span>
                                    @if (discountPct > 0)
                                    {
                                        <span class="dk-women-discount-pill">@discountPct% OFF</span>
                                    }
                                }
                            </div>

                            <!-- Rating & Reviews -->
                            <div class="dk-women-rating-row">
                                <span class="dk-women-star-badge">
                                    <span class="dk-star-glyph">★</span> @prod.Rating.ToString("0.0")
                                </span>
                                <span class="dk-women-reviews-count">(@prod.ReviewsCount verified)</span>
                            </div>

                            <!-- Sizes row -->
                            @if (prod.Sizes != null && prod.Sizes.Count > 0)
                            {
                                <div class="dk-women-sizes-row">
                                    <span class="dk-sizes-label">Sizes:</span>
                                    @foreach (var sz in prod.Sizes)
                                    {
                                        <span class="dk-size-tag">@sz</span>
                                    }
                                </div>
                            }

                            <!-- Add to Cart CTA -->
                            <button type="button" class="dk-women-btn-add-cart" onclick="addWomenProductToCart('@prod.Id', '@prod.Name.Replace("'", "\\'")', @((int)prod.Price), this)">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span>Add to Cart</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Empty State Fallback -->
            <div class="dk-women-empty-state" id="womenEmptyState" style="display: none;">
                <div class="dk-empty-icon-circle">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="1.8">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                </div>
                <h3 class="dk-empty-title">No products found matching your filters</h3>
                <p class="dk-empty-desc">Try clearing some filters or exploring other Women Clothing subcategories.</p>
                <button type="button" class="dk-btn-primary" onclick="resetWomenFilters()">Clear All Filters</button>
            </div>

        </main>
    </div>

</div>

<!-- Floating Toast Container -->
<div id="womenToast" class="dk-women-toast" style="display: none;">
    <div class="dk-toast-content">
        <span class="dk-toast-icon">✓</span>
        <span class="dk-toast-message" id="womenToastMessage">Item added to cart</span>
    </div>
</div>

@functions {
    private static string GetSubcategoryIcon(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug)) return "👗";
        var s = slug.ToLowerInvariant();
        if (s.Contains("t-shirt") || s.Contains("tops") || s.Contains("top")) return "👚";
        if (s.Contains("shirt") || s.Contains("blouse")) return "👔";
        if (s.Contains("jean")) return "👖";
        if (s.Contains("dress")) return "👗";
        if (s.Contains("legging")) return "🩱";
        if (s.Contains("trouser") || s.Contains("pant")) return "👖";
        if (s.Contains("thermal")) return "❄️";
        if (s.Contains("hoodie") || s.Contains("sweat")) return "🧥";
        if (s.Contains("jacket") || s.Contains("coat")) return "🧥";
        if (s.Contains("night") || s.Contains("sleep")) return "🥻";
        if (s.Contains("inner")) return "👙";
        if (s.Contains("active")) return "🎽";
        if (s.Contains("formal")) return "👠";
        if (s.Contains("gym") || s.Contains("sport")) return "🏋️‍♀️";
        return "👗";
    }
}

<style>
/* ============================================================
   WOMEN CLOTHING SUBCATEGORY LANDING PAGE STYLING
   BIG IMAGE FRAMES, REACTIVE FILTERS, MODERN CAMPUS LUXE
============================================================ */

.dk-women-subpage-container {
    padding-top: 18px;
    padding-bottom: 60px;
}

/* Festival Ribbon */
.dk-sub-fest-ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 10px 20px;
    border-radius: 12px;
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 700;
    margin-bottom: 18px;
    box-shadow: 0 4px 14px rgba(225, 29, 72, 0.2);
}
.dk-sub-fest-badge {
    background: rgba(255, 255, 255, 0.25);
    padding: 3px 10px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}
.dk-sub-fest-highlight {
    background: #ffffff;
    color: #e11d48;
    padding: 3px 10px;
    border-radius: 100px;
    font-size: 11.5px;
    font-weight: 800;
}

/* 1. HERO BANNER */
.dk-women-sub-hero-card {
    position: relative;
    border-radius: 20px;
    background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 50%, #fed7aa 100%);
    border: 1.5px solid #fecdd3;
    overflow: hidden;
    margin-bottom: 28px;
    box-shadow: 0 8px 30px rgba(225, 29, 72, 0.08);
}
.dk-women-sub-hero-glow {
    position: absolute;
    top: -40%;
    right: -10%;
