    .dk-beauty-sub-admin-btn:hover {
        background: #be123c;
        color: #ffffff;
    }

    /* FULL WIDTH HERO BANNER (TEXT REMOVED AS REQUESTED) */
    .dk-beauty-sub-hero-section.full-width-hero {
        position: relative;
        width: 100%;
        min-height: 240px;
        height: 240px;
        background: var(--beauty-theme, linear-gradient(135deg, #700b1a 0%, #a8122a 50%, #c2193b 100%));
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    .dk-beauty-sub-hero-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
    }
    .dk-beauty-sub-hero-soon {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        z-index: 1;
        background: radial-gradient(circle at center, rgba(255, 255, 255, 0.16) 0%, rgba(0, 0, 0, 0.25) 100%);
    }
    .dk-beauty-hero-radar-box {
        position: relative;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 2px solid rgba(255, 255, 255, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 20px rgba(0,0,0,0.18);
    }
    .dk-beauty-hero-radar-emoji {
        font-size: 40px;
        z-index: 3;
        filter: drop-shadow(0 2px 6px rgba(0,0,0,0.3));
    }
    .dk-beauty-radar-ring {
        position: absolute;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.5);
        animation: beautyRadarPulse 2.4s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    .dk-beauty-radar-ring.ring-1 {
        width: 70px;
        height: 70px;
        animation-delay: 0s;
    }
    .dk-beauty-radar-ring.ring-2 {
        width: 90px;
        height: 90px;
        animation-delay: 0.8s;
    }
    @@keyframes beautyRadarPulse {
        0% { transform: scale(0.6); opacity: 0.9; }
        100% { transform: scale(1.6); opacity: 0; }
    }
    .dk-beauty-sub-soon-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 18px;
        background: rgba(255, 255, 255, 0.95);
        color: #0f172a;
        font-size: 11.5px;
        font-weight: 850;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        border-radius: 9999px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        gap: 6px;
    }
    .dk-beauty-pulse-dot {
        color: #e11d48;
        font-size: 9px;
        animation: beautyBlink 1.4s infinite;
    }
    @@keyframes beautyBlink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    /* SHOP BY BRANDS SECTION */
    .dk-beauty-brands-section {
        background: #ffffff;
