<!-- SCRIPT FOR UPLOADING, PREVIEW & SAVE -->
<script>
    let currentUploadTargetInputId = null;
    let currentUploadPreviewImgId = null;

    function switchAdminTab(tabId) {
        document.querySelectorAll(".dk-sh-tab-btn").forEach(b => b.classList.remove("active"));
        document.querySelectorAll(".dk-sh-tab-pane").forEach(p => p.classList.remove("active"));

        event.currentTarget.classList.add("active");
        const target = document.getElementById(tabId);
        if (target) target.classList.add("active");
    }

    function updateImgPreview(inputId, imgId) {
        const input = document.getElementById(inputId);
        const img = document.getElementById(imgId);
        if (input && img) {
            img.src = input.value || "/images/study-hub/test-pic-placeholder.svg";
        }
    }

    function setTestPic(inputId, imgId) {
        const input = document.getElementById(inputId);
        const img = document.getElementById(imgId);
        const testPath = "/images/study-hub/test-pic-placeholder.svg";
        if (input) input.value = testPath;
        if (img) img.src = testPath;
    }

    function setModelPic(inputId, imgId, url) {
        const input = document.getElementById(inputId);
        const img = document.getElementById(imgId);
        if (input) input.value = url;
        if (img) img.src = url;
    }

    function triggerUploadFor(inputId, imgId) {
        currentUploadTargetInputId = inputId;
        currentUploadPreviewImgId = imgId;
        const uploader = document.getElementById("globalImageUploader");
        if (uploader) {
            uploader.value = "";
            uploader.click();
        }
    }

    document.getElementById("globalImageUploader")?.addEventListener("change", async function () {
        if (!this.files || this.files.length === 0) return;
        const file = this.files[0];

        const formData = new FormData();
        formData.append("file", file);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append("__RequestVerificationToken", token);

        try {
            const res = await fetch("/Admin/StudyHub/UploadImage", {
                method: "POST",
                body: formData,
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            const data = await res.json();
            if (data.success && data.url) {
                if (currentUploadTargetInputId) {
                    const input = document.getElementById(currentUploadTargetInputId);
                    if (input) input.value = data.url;
                }
                if (currentUploadPreviewImgId) {
                    const img = document.getElementById(currentUploadPreviewImgId);
                    if (img) img.src = data.url;
                }
                showAdminToast("✓ Image uploaded and preview updated!");
            } else {
                alert("Upload failed: " + (data.message || "Unknown error"));
            }
        } catch (err) {
            alert("Upload failed: " + err.message);
        }
    });

    function updateHeroSlideNumbers() {
        const rows = document.querySelectorAll("#hero_slides_container .dk-sh-hero-slide-row");
        const countSpan = document.getElementById("hero_slides_count");
        if (countSpan) countSpan.textContent = rows.length;
        rows.forEach((row, i) => {
            const label = row.querySelector(".hero-slide-label");
            if (label) label.textContent = `Slide #${i + 1}`;
        });
    }

    function removeHeroSlide(btn) {
        const rows = document.querySelectorAll("#hero_slides_container .dk-sh-hero-slide-row");
        if (rows.length <= 1) {
            alert("At least one slide must remain configured.");
            return;
        }
        const row = btn.closest(".dk-sh-hero-slide-row");
        if (row) {
            row.remove();
            updateHeroSlideNumbers();
        }
    }

    let slideCounter = 100;
    function addNewHeroSlide() {
        slideCounter++;
        const sIdx = slideCounter;
        const container = document.getElementById("hero_slides_container");
        if (!container) return;
        const newRow = document.createElement("div");
        newRow.className = "dk-sh-edit-card dk-sh-hero-slide-row";
        newRow.dataset.slideId = "hero-slide-" + sIdx;
        newRow.id = "hero_slide_row_" + sIdx;
        newRow.style.cssText = "position: relative; border-left: 4px solid #0284c7; background: #ffffff; margin-bottom: 16px;";
        newRow.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span class="hero-slide-label" style="font-weight: 800; color: #0284c7; font-size: 0.95rem;">New Slide</span>
                <button type="button" class="dk-btn" style="background: #fee2e2; color: #b91c1c; font-size: 12px; padding: 4px 10px;" onclick="removeHeroSlide(this)">
                    🗑️ Remove Slide
                </button>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label class="dk-sh-form-label">Slide Badge Text (Floating badge on image)</label>
                    <input type="text" class="dk-admin-form-input hero-slide-badge-input" value="Curated Study Gear &amp; Discounts 🎓" placeholder="e.g. New Country New Opportunities Same You! ✈️" />
                </div>
                <div>
                    <label class="dk-sh-form-label">Slide Target Link URL</label>
                    <input type="text" class="dk-admin-form-input hero-slide-link-input" value="/category/study-essentials" placeholder="/category/study-essentials" />
                </div>
            </div>
            <div style="margin-bottom: 12px;">
                <label class="dk-sh-form-label">Slide Title / Alt Caption</label>
                <input type="text" class="dk-admin-form-input hero-slide-title-input" value="Student Essentials Slide" placeholder="Slide caption or description" />
            </div>
            <label class="dk-sh-form-label">Slide Image (Super Admin Replaceable)</label>
            <div class="dk-sh-img-ctrl-row">
                <div class="dk-sh-img-preview-box" style="width: 140px; height: 90px;">
                    <img id="preview_hero_slide_${sIdx}" src="/images/study-hub/test-pic-placeholder.svg" onerror="this.src='/images/study-hub/test-pic-placeholder.svg';" />
                </div>
                <div style="flex: 1;">
                    <input type="text" id="hero_slide_img_${sIdx}" class="dk-admin-form-input hero-slide-img-input" value="/images/study-hub/test-pic-placeholder.svg" oninput="updateImgPreview('hero_slide_img_${sIdx}', 'preview_hero_slide_${sIdx}')" style="margin-bottom: 8px;" />
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="dk-btn dk-btn-primary" style="font-size: 12px; padding: 5px 12px;" onclick="triggerUploadFor('hero_slide_img_${sIdx}', 'preview_hero_slide_${sIdx}')">
                            📷 Upload Slide Image
                        </button>
                        <button type="button" class="dk-btn" style="background: #f1f5f9; font-size: 12px; padding: 5px 12px;" onclick="setTestPic('hero_slide_img_${sIdx}', 'preview_hero_slide_${sIdx}')">
                            Set as Test Pic
                        </button>
                    </div>
                </div>
            </div>
        `;
        container.appendChild(newRow);
        updateHeroSlideNumbers();
    }

    async function saveAllChanges() {
        const btn = document.getElementById("btnSaveTop");
        if (btn) {
            btn.disabled = true;
            btn.textContent = "Saving...";
        }

        // Build Hero Slides
        const heroSlides = [];
        document.querySelectorAll("#hero_slides_container .dk-sh-hero-slide-row").forEach((row, idx) => {
            const imgInput = row.querySelector(".hero-slide-img-input");
            const badgeInput = row.querySelector(".hero-slide-badge-input");
            const linkInput = row.querySelector(".hero-slide-link-input");
            const titleInput = row.querySelector(".hero-slide-title-input");
            heroSlides.push({
                Id: row.dataset.slideId || ("slide-" + (idx + 1)),
                ImageUrl: imgInput ? imgInput.value : "/images/study-hub/test-pic-placeholder.svg",
                SecondaryBadge: badgeInput ? badgeInput.value : "",
                LinkUrl: linkInput ? linkInput.value : "/category/study-essentials",
                Title: titleInput ? titleInput.value : ""
            });
        });

        const slideInterval = parseInt(document.getElementById("hero_slide_interval")?.value || "4", 10);

        // Build StudyHubDto JSON payload
        const payload = {
            HeroBanner: {
                PillText: document.getElementById("hero_pill")?.value || "STUDY ESSENTIALS",
                Title: document.getElementById("hero_title")?.value || "Everything You Need for Your Global Journey",
                Subtitle: document.getElementById("hero_sub")?.value || "",
                ButtonText: document.getElementById("hero_btn_text")?.value || "Explore Study Essentials →",
                ButtonUrl: document.getElementById("hero_btn_url")?.value || "/category/study-essentials",
                ImageUrl: heroSlides.length > 0 ? heroSlides[0].ImageUrl : "/images/study-hub/test-pic-placeholder.svg",
                SecondaryBadge: heroSlides.length > 0 ? heroSlides[0].SecondaryBadge : (document.getElementById("hero_sec_badge")?.value || ""),
                AutoSlideIntervalSeconds: isNaN(slideInterval) || slideInterval < 2 ? 4 : slideInterval,
                Slides: heroSlides
            },
            Section1: {
                Title: document.getElementById("s1_title")?.value || "Shop by Category",
                Subtitle: document.getElementById("s1_subtitle")?.value || "",
                ViewAllLinkText: document.getElementById("s1_view_all_text")?.value || "View All Categories →",
                ViewAllLinkUrl: document.getElementById("s1_view_all_url")?.value || "/category/study-essentials",
                Cards: []
            },
            Section2: {
                Title: document.getElementById("s2_title")?.value || "Our Study Essentials Kits",
                Subtitle: document.getElementById("s2_subtitle")?.value || "",
                Kits: []
            },
            Section3Detail: {
                Title: document.getElementById("s3_title")?.value || "What Every Student Needs Before Going Abroad",
                Subtitle: document.getElementById("s3_subtitle")?.value || "",
                BadgeText: document.getElementById("s3_badge")?.value || "Be Ready for New Adventures ✈",
                Cards: []
            },
            Section4: {
                Title: document.getElementById("s4_title")?.value || "Abroad Packing Checklist",
                BadgeText: document.getElementById("s4_badge")?.value || "Highly Recommended",
                Subtitle: document.getElementById("s4_sub")?.value || "",
                ButtonText: document.getElementById("s4_btn_text")?.value || "View Missing Essentials →",
                ButtonUrl: "/category/study-essentials",
                ImageUrl: document.getElementById("s4_img_url")?.value || "/images/study-hub/test-pic-placeholder.svg",
                Items: []
            },
            Section5: {
                Title: document.getElementById("s5_title")?.value || "Shop by Destination",
                Subtitle: document.getElementById("s5_subtitle")?.value || "",
                ButtonText: "Explore Essentials by Country →",
                ButtonUrl: "/category/study-essentials",
                Countries: []
            },
            Section6: {
                StepNumber: document.getElementById("s6_step")?.value || "",
                Title: document.getElementById("s6_title")?.value || "Build Your Own Study Kit",
                BadgeText: "Customize Your Perfect Kit",
                Subtitle: document.getElementById("s6_sub")?.value || "",
                ButtonText: document.getElementById("s6_btn_text")?.value || "Build My Study Kit →",
                TargetUrl: "/cart",
                Items: []
            },
            Section7: {
                Title: document.getElementById("s7_title")?.value || "Best Sellers & Student Favorites",
                Subtitle: document.getElementById("s7_sub")?.value || "",
                Products: []
            },
            Section8: {
                Title: document.getElementById("s8_title")?.value || "Smart Study Setup",
                Subtitle: document.getElementById("s8_sub")?.value || "",
                ImageUrl: document.getElementById("s8_img_url")?.value || "/images/study-hub/test-pic-placeholder.svg",
                ButtonText: "Shop Study Setup →",
                ButtonUrl: "/category/study-essentials",
                Items: []
            },
            Section9: {
                Title: document.getElementById("s9_title")?.value || "Why Choose DreamFlyKit?",
                Subtitle: document.getElementById("s9_sub")?.value || "",
                Pillars: []
            },
            Section10: {
                Title: document.getElementById("s10_title")?.value || "Frequently Asked Questions",
                Subtitle: document.getElementById("s10_sub")?.value || "",
                Faqs: []
            },
            BottomBanner: {
                Title: document.getElementById("b_title")?.value || "Your Global Journey Starts Here.",
                Subtitle: document.getElementById("b_sub")?.value || "",
                ButtonText: document.getElementById("b_btn_text")?.value || "Shop Study Essentials →",
                ButtonUrl: "/category/study-essentials",
                ImageUrl: document.getElementById("b_img_url")?.value || "/images/study-hub/test-pic-placeholder.svg"
            },
            CategoriesPage: {
                HeroTitle: document.getElementById("cat_hero_title")?.value || "Study Essentials",
                HeroSubtitle: document.getElementById("cat_hero_sub")?.value || "",
                HeroImageUrl: document.getElementById("cat_hero_img_url")?.value || "/images/study-hub/test-pic-placeholder.svg",
                Categories: []
            }
        };

        // Section 1 Cards
        for (let i = 0; i < 10; i++) {
            const t = document.getElementById("s1_card_title_" + i);
            if (!t) break;
            payload.Section1.Cards.push({
                Title: t.value,
                Description: document.getElementById("s1_card_desc_" + i)?.value || "",
                LinkUrl: document.getElementById("s1_card_link_" + i)?.value || "/category/study-essentials",
                ImageUrl: document.getElementById("s1_card_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg",
                IconType: "academic"
            });
        }

        // Section 2 Kits
        for (let i = 0; i < 6; i++) {
            const t = document.getElementById("s2_kit_title_" + i);
            if (!t) break;
            const featText = document.getElementById("s2_kit_features_" + i)?.value || "";
            const feats = featText.split("\n").map(f => f.trim()).filter(f => f.length > 0);
            payload.Section2.Kits.push({
                Title: t.value,
                BadgeText: document.getElementById("s2_kit_badge_" + i)?.value || "",
                PriceDisplay: document.getElementById("s2_kit_price_disp_" + i)?.value || "₹499",
                Price: parseFloat(document.getElementById("s2_kit_price_num_" + i)?.value || "499"),
                ImageUrl: document.getElementById("s2_kit_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg",
                Features: feats,
                ButtonText: "View Kit →",
                TargetUrl: "/category/study-essentials"
            });
        }

        // Section 3 Detail Cards (Abroad Essentials)
        for (let i = 0; i < 16; i++) {
            const t = document.getElementById("s3_card_title_" + i);
            if (!t) break;
            payload.Section3Detail.Cards.push({
                Id: document.getElementById("s3_card_id_" + i)?.value || ("abroad-card-" + (i + 1)),
                Title: t.value,
                Description: document.getElementById("s3_card_desc_" + i)?.value || "",
                LinkUrl: document.getElementById("s3_card_link_" + i)?.value || "/category/study-essentials",
                ButtonText: document.getElementById("s3_card_btn_" + i)?.value || "Explore Essentials →",
                IconType: document.getElementById("s3_card_icon_" + i)?.value || "study",
                ImageUrl: document.getElementById("s3_card_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg"
            });
        }

        // Section 5 Countries
        for (let i = 0; i < 10; i++) {
            const t = document.getElementById("s5_c_name_" + i);
            if (!t) break;
            payload.Section5.Countries.push({
                Name: t.value,
                Code: t.value.substring(0, 2).toUpperCase(),
                FlagUrl: document.getElementById("s5_c_flag_" + i)?.value || "",
                LinkUrl: "/category/study-essentials?country=" + encodeURIComponent(t.value.toLowerCase())
            });
        }

        // Section 6 Builder items
        for (let i = 0; i < 20; i++) {
            const t = document.getElementById("s6_item_name_" + i);
            if (!t) break;
            payload.Section6.Items.push({
                Name: t.value,
                Price: parseFloat(document.getElementById("s6_item_price_" + i)?.value || "0"),
                ImageUrl: document.getElementById("s6_item_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg"
            });
        }

        // Section 7 Best Sellers
        for (let i = 0; i < 10; i++) {
            const t = document.getElementById("s7_p_name_" + i);
            if (!t) break;
            payload.Section7.Products.push({
                Name: t.value,
                Price: parseFloat(document.getElementById("s7_p_price_" + i)?.value || "0"),
                OriginalPrice: parseFloat(document.getElementById("s7_p_orig_" + i)?.value || "0"),
                ImageUrl: document.getElementById("s7_p_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg",
                LinkUrl: "/category/study-essentials",
                ButtonText: "Add to Cart"
            });
        }

        // Section 10 FAQs
        for (let i = 0; i < 15; i++) {
            const q = document.getElementById("s10_q_" + i);
            if (!q) break;
            payload.Section10.Faqs.push({
                Question: q.value,
                Answer: document.getElementById("s10_a_" + i)?.value || ""
            });
        }

        // Categories Page 8 Categories
        for (let i = 0; i < 12; i++) {
            const n = document.getElementById("cat_item_name_" + i);
            if (!n) break;
            payload.CategoriesPage.Categories.push({
                Name: n.value,
                Slug: document.getElementById("cat_item_slug_" + i)?.value || "",
                Description: document.getElementById("cat_item_desc_" + i)?.value || "",
                ImageUrl: document.getElementById("cat_item_img_" + i)?.value || "/images/study-hub/test-pic-placeholder.svg"
            });
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const res = await fetch("/Admin/StudyHub/Save", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                    "RequestVerificationToken": token || ""
                },
                body: JSON.stringify(payload)
            });

            const result = await res.json();
            if (result.success) {
                showAdminToast("✓ All 10 sections & categories saved successfully!");
            } else {
                alert("Failed to save: " + (result.message || "Unknown error"));
            }
        } catch (err) {
            alert("Save failed: " + err.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = "💾 Save All Changes";
            }
        }
    }

    function showAdminToast(msg) {
        let toast = document.getElementById("dk-admin-save-toast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "dk-admin-save-toast";
            toast.style.cssText = "position: fixed; top: 30px; right: 30px; background: #059669; color: #ffffff; padding: 14px 24px; border-radius: 10px; font-weight: 700; font-size: 14px; z-index: 99999; box-shadow: 0 10px 30px rgba(0,0,0,0.2); transition: opacity 0.3s;";
            document.body.appendChild(toast);
        }
        toast.textContent = msg;
        toast.style.display = "block";
        toast.style.opacity = "1";
        setTimeout(() => {
            toast.style.opacity = "0";
            setTimeout(() => { toast.style.display = "none"; }, 300);
        }, 3000);
    }
</script>
