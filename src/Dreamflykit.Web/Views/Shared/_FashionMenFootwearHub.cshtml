<script>
function slideFootwear(direction) {
    var container = document.getElementById('footwearPicksRow');
    if (container) {
        container.scrollBy({ left: direction * 280, behavior: 'smooth' });
    }
}

function toggleFootwearWishlist(btn, ev) {
    ev.stopPropagation();
    btn.classList.toggle('active');
    var svg = btn.querySelector('svg');
    if (btn.classList.contains('active')) {
        svg.setAttribute('fill', '#e11d48');
        svg.setAttribute('stroke', '#e11d48');
        showFootwearToast('Saved to your Wishlist! ❤️');
    } else {
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', 'currentColor');
        showFootwearToast('Removed from Wishlist');
    }
}

function addToFootwearCart(id, name, price, ev) {
    ev.stopPropagation();
    var btn = ev.currentTarget;
    var originalText = btn.innerHTML;
    btn.innerHTML = '✓ Added to Cart';
    btn.style.background = '#16a34a';
    btn.disabled = true;

    // Increment header cart counter if present
    var cartBadge = document.querySelector('.dk-header-cart-count, .dk-cart-count, [data-cart-count]');
    if (cartBadge) {
        var count = parseInt(cartBadge.textContent || '0', 10);
        cartBadge.textContent = count + 1;
    }

    showFootwearToast('Added "' + name + '" to your cart!');

    setTimeout(function() {
        btn.innerHTML = originalText;
        btn.style.background = '';
        btn.disabled = false;
    }, 1800);
}

function showFootwearToast(msg) {
    var toast = document.createElement('div');
    toast.className = 'dk-footwear-toast';
    toast.textContent = msg;
    toast.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#0f172a;color:#fff;padding:12px 20px;border-radius:10px;font-size:14px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.25);z-index:99999;opacity:0;transform:translateY(10px);transition:all 0.3s ease;display:flex;align-items:center;gap:8px;';
    document.body.appendChild(toast);
    setTimeout(function() {
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
    }, 50);
    setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        setTimeout(function() { toast.remove(); }, 300);
    }, 3000);
}
</script>
