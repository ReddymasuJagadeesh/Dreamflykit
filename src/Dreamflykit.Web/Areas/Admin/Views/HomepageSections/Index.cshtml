@model Dreamflykit.Web.Areas.Admin.Models.HomepageSectionListViewModel
@{
    ViewData["Title"] = "Manage Homepage Sections";
}

<div class="dk-admin-content-card">
    <div class="dk-admin-card-header" style="margin-bottom: 1.5rem;">
        <h1 class="dk-admin-card-title" style="font-size: 1.5rem; margin: 0;">Homepage Sections (CMS)</h1>
        <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0.25rem 0 0;">
            Customize imagery and headlines for all homepage sections without modifying code.
        </p>
    </div>

    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="dk-alert dk-alert-success" style="margin-bottom: 1.5rem; padding: 0.75rem 1rem; background: #ecfdf5; border-left: 4px solid #10b981; color: #065f46; border-radius: 4px;">
            @msg
        </div>
    }

    <div class="dk-table-responsive" style="overflow-x: auto;">
        <table class="dk-admin-table" style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
            <thead>
                <tr style="border-bottom: 2px solid #e5e7eb; text-align: left; background: var(--bg-alt, #f9fafb);">
                    <th style="padding: 0.75rem 1rem; width: 100px;">Media</th>
                    <th style="padding: 0.75rem 1rem;">Section Key</th>
                    <th style="padding: 0.75rem 1rem;">Title & Subtitle</th>
                    <th style="padding: 0.75rem 1rem; width: 80px; text-align: center;">Order</th>
                    <th style="padding: 0.75rem 1rem; width: 100px;">Status</th>
                    <th style="padding: 0.75rem 1rem; width: 100px; text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sections)
                {
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 0.75rem 1rem;">
                            @if (!string.IsNullOrWhiteSpace(s.ImageUrl))
                            {
                                <img src="@s.ImageUrl" alt="@s.Title" style="width: 80px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid #e5e7eb;" />
                            }
                            else
                            {
                                <div style="width: 80px; height: 50px; background: #e5e7eb; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; color: #6b7280;">No Image</div>
                            }
                        </td>
                        <td style="padding: 0.75rem 1rem;">
                            <code>@s.SectionKey</code>
                        </td>
                        <td style="padding: 0.75rem 1rem;">
                            <div style="font-weight: 600;">@s.Title</div>
                            @if (!string.IsNullOrWhiteSpace(s.Subtitle))
                            {
                                <div style="font-size: 0.8rem; color: var(--text-muted);">@s.Subtitle</div>
                            }
                        </td>
                        <td style="padding: 0.75rem 1rem; text-align: center; font-weight: 600;">
                            @s.DisplayOrder
                        </td>
                        <td style="padding: 0.75rem 1rem;">
                            @if (s.IsPublished && s.IsActive)
                            {
                                <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; background: #ecfdf5; color: #065f46; font-weight: 600;">Live</span>
                            }
                            else if (!s.IsActive)
                            {
                                <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; background: #fef2f2; color: #991b1b; font-weight: 600;">Inactive</span>
                            }
                            else
                            {
                                <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; background: #f3f4f6; color: #374151; font-weight: 600;">Draft</span>
                            }
                        </td>
                        <td style="padding: 0.75rem 1rem; text-align: right;">
                            <a href="/Admin/HomepageSections/Edit/@s.Id" class="dk-btn dk-btn-secondary dk-btn-sm">Edit Section</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
