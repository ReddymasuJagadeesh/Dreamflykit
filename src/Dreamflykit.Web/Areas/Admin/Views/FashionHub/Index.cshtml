    const newId = "mp_" + Date.now();
    const row = document.createElement("div");
    row.className = "dk-item-row";
    row.setAttribute("data-id", newId);
    row.innerHTML = `
        <span class="dk-row-handle">☰</span>
        <div class="dk-thumb-box">
            <img src="/images/fashion-hub/uploading-soon-placeholder.svg" alt="New Product" class="prod-thumb-preview" />
            <button type="button" class="dk-btn-thumb-upload" onclick="this.nextElementSibling.click()" title="Upload Image">📷</button>
            <input type="file" accept="image/*" style="display: none;" onchange="uploadRowImage(this, 'product')" />
        </div>
        <div class="dk-row-inputs" style="grid-template-columns: 2fr 100px 100px 75px 80px 2fr;">
            <div>
                <label class="dk-mini-label">Product Name</label>
                <input type="text" class="dk-input prod-name" value="Men's New Style" placeholder="Product Name" />
            </div>
            <div>
                <label class="dk-mini-label">Price (₹)</label>
                <input type="number" class="dk-input prod-price" value="799" />
            </div>
            <div>
                <label class="dk-mini-label">Orig. Price (₹)</label>
                <input type="number" class="dk-input prod-orig-price" value="1599" />
            </div>
            <div>
                <label class="dk-mini-label">Rating</label>
                <input type="number" step="0.1" class="dk-input prod-rating" value="4.8" />
            </div>
            <div>
                <label class="dk-mini-label">Reviews</label>
                <input type="number" class="dk-input prod-reviews" value="50" />
            </div>
            <div>
