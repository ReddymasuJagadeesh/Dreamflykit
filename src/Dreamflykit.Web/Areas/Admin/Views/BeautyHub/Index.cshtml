            sectionTitle: document.getElementById('herTitle').value,
            cards: []
        },
        grandGiftsForHim: {
            isEnabled: document.getElementById('himIsEnabled').checked,
            sectionTitle: document.getElementById('himTitle').value,
            cards: []
        },
        dualBanners: {
            isEnabled: true,
            leftBanner: {
                title: document.getElementById('dualLeftTitle').value,
                priceHighlight: document.getElementById('dualLeftPrice').value,
                imageUrl: document.getElementById('dualLeftImg').value,
                targetUrl: '#beauty-products-catalog'
            },
            rightBanner: {
                title: document.getElementById('dualRightTitle').value,
                priceHighlight: document.getElementById('dualRightPrice').value,
                imageUrl: document.getElementById('dualRightImg').value,
                targetUrl: '#beauty-products-catalog'
            }
        },
        premiumGifts: {
            isEnabled: true,
            brands: []
        },
        festiveLooks: {
            isEnabled: document.getElementById('festiveLooksIsEnabled').checked,
            cards: []
        },
        limitedDealsRibbon: {
            isEnabled: true,
            title: 'Limited Stock, Big Deals',
            discountHighlight: 'Up to 75% Off',
            targetUrl: '#beauty-products-catalog'
        },
        flashDealsTimer: {
            isEnabled: document.getElementById('flashDealsIsEnabled').checked,
            timerTitle: document.getElementById('flashTitle').value,
            timerHours: parseInt(document.getElementById('flashHours').value || '12', 10),
            cards: []
        },
        beautyPicksUnder99: {
            isEnabled: true,
            title: document.getElementById('under99Title').value,
            priceHighlight: document.getElementById('under99Price').value,
            targetUrl: '#beauty-products-catalog'
        },
        biggestBrands: {
            isEnabled: true,
            brands: []
        },
        beautyPartners: {
            isEnabled: true,
            items: []
        },
        brandNewInBeauty: {
            isEnabled: true,
            cards: []
        }
    };

    // Collect Hero Slides
    document.querySelectorAll('#heroSlidesList .hero-slide-row').forEach(row => {
        payload.heroBanner.slides.push({
            id: row.getAttribute('data-id'),
            tagBadge: row.querySelector('.slide-tag')?.value || 'BIG BANG DIWALI',
            title: row.querySelector('.slide-title')?.value || '',
            priceHighlight: row.querySelector('.slide-price')?.value || '',
            buttonText: row.querySelector('.slide-button')?.value || 'Explore Deals →',
            subtitle: row.querySelector('.slide-sub')?.value || '',
            targetUrl: row.querySelector('.slide-url')?.value || '#beauty-products-catalog',
            imageUrl: row.querySelector('.slide-img')?.value || '',
            isUploadingSoon: row.querySelector('.slide-uploading-soon')?.checked || false
        });
    });

    // Collect Promo Cards
    document.querySelectorAll('#promoCardsList .promo-card-item').forEach(card => {
        payload.promoBanners.cards.push({
            id: card.getAttribute('data-id'),
