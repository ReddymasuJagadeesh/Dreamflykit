        box-shadow: 0 16px 36px rgba(0,0,0,0.12);
    }

    /* Destination Showcase (Image 5) */
    .dk-upg-dest-section {
        background: #fafaf9;
        padding: 64px 24px 72px 24px;
        border-top: 1px solid #f1f5f9;
    }
    .dk-upg-dest-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .dk-upg-dest-title {
        font-size: 1.95rem;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.02em;
    }
    .dk-upg-dest-explore-link {
        font-size: 14px;
        font-weight: 800;
        color: #e52d27;
        text-decoration: none;
        transition: transform 0.15s;
    }
    .dk-upg-dest-explore-link:hover {
        text-decoration: underline;
        transform: translateX(3px);
    }
    .dk-upg-dest-layout {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        border-radius: 16px;
        overflow: hidden;
    }
    .dk-upg-country-rail {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 140px;
        flex-shrink: 0;
    }
    .dk-upg-country-tab {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.5px;
        padding: 14px 12px;
        border-radius: 10px;
        cursor: pointer;
        text-align: left;
        transition: all 0.2s;
    }
    .dk-upg-country-tab:hover, .dk-upg-country-tab.active {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
        transform: translateX(3px);
    }
    .dk-upg-dest-stage {
        flex: 1;
        position: relative;
        min-height: 420px;
        background-size: cover;
        background-position: center;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        padding: 24px;
        box-sizing: border-box;
    }
    .dk-upg-dest-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.45) 100%);
    }
    .dk-upg-dest-nav-bar {
        position: relative;
        z-index: 2;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .dk-upg-dest-slide-counter {
        font-size: 2.4rem;
        font-weight: 900;
        color: #ffffff;
        letter-spacing: -0.03em;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .dk-upg-dest-arrow-group {
        display: flex;
        gap: 8px;
    }
    .dk-upg-circle-nav {
        width: 38px;
        height: 38px;
        background: rgba(255, 255, 255, 0.9);
        color: #0f172a;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }
    .dk-upg-circle-nav:hover {
        background: #ffffff;
        transform: scale(1.1);
    }
    .dk-upg-dest-cards-col {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 16px;
        max-width: 65%;
    }
    .dk-upg-dest-program-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 16px;
        flex: 1;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        display: flex;
        flex-direction: column;
    }
    .dk-upg-dest-card-header {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
    }
    .dk-upg-dest-flag-icon {
        font-size: 14px;
    }
    .dk-upg-dest-inst {
        font-size: 11px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
    }
    .dk-upg-dest-card-title {
        font-size: 13.5px;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 8px 0;
        line-height: 1.35;
    }
    .dk-upg-dest-accred-badge {
        background: #f0fdf4;
        color: #166534;
        font-size: 10px;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 4px;
        width: fit-content;
        margin-bottom: 10px;
    }
    .dk-upg-dest-meta-row {
        display: flex;
        justify-content: space-between;
        font-size: 11.5px;
        color: #475569;
        font-weight: 600;
        margin-bottom: 12px;
        margin-top: auto;
    }
    .dk-upg-dest-btn-red {
        background: #e52d27;
        color: #ffffff;
        font-size: 12px;
        font-weight: 800;
        padding: 8px 12px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        width: 100%;
        transition: background 0.2s;
    }
    .dk-upg-dest-btn-red:hover {
        background: #c61f1a;
    }

    /* Key Stats Bar (Image 5) */
    .dk-upg-stats-bar {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        padding: 20px 24px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        text-align: center;
    }
    .dk-upg-stat-val {
        font-size: 1.9rem;
        font-weight: 900;
        color: #e52d27;
        letter-spacing: -0.02em;
        line-height: 1.1;
    }
    .dk-upg-stat-label {
        font-size: 12.5px;
        font-weight: 700;
        color: #64748b;
        margin-top: 4px;
    }

    /* Floating Buttons */
    .dk-upg-scroll-top-btn {
        position: fixed;
        bottom: 24px;
        left: 24px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #ffffff;
        color: #e52d27;
        border: 1.5px solid #fecaca;
        box-shadow: 0 4px 14px rgba(0,0,0,0.12);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
        transition: all 0.2s;
    }
    .dk-upg-scroll-top-btn:hover {
        background: #e52d27;
        color: #ffffff;
        transform: translateY(-3px);
    }
    .dk-upg-floating-call-btn {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #e52d27;
        color: #ffffff;
        border: none;
        box-shadow: 0 6px 20px rgba(229, 45, 39, 0.45);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
        transition: all 0.25s;
    }
    .dk-upg-floating-call-btn:hover {
        transform: scale(1.08);
        background: #c61f1a;
    }
    .dk-upg-call-tooltip {
        position: absolute;
        right: 68px;
        background: #0f172a;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 6px;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s;
    }
    .dk-upg-floating-call-btn:hover .dk-upg-call-tooltip {
        opacity: 1;
    }

    /* Modal Backdrop */
    .dk-upg-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(4px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        box-sizing: border-box;
    }
    .dk-upg-modal-card {
        background: #ffffff;
        border-radius: 20px;
        max-width: 500px;
        width: 100%;
        padding: 30px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.3);
        position: relative;
        animation: upgModalIn 0.25s ease-out;
    }
    @@keyframes upgModalIn {
        from { transform: scale(0.92); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    .dk-upg-modal-close {
        position: absolute;
        top: 18px;
        right: 18px;
        background: #f1f5f9;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 15px;
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }
    .dk-upg-modal-close:hover {
        background: #fee2e2;
        color: #b91c1c;
    }
    .dk-upg-modal-pill {
        background: #fef2f2;
        color: #e52d27;
        font-size: 11px;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 999px;
        display: inline-block;
        margin-bottom: 8px;
    }
    .dk-upg-modal-title {
        font-size: 20px;
        font-weight: 900;
        color: #0f172a;
        margin: 0 0 4px 0;
        line-height: 1.25;
    }
    .dk-upg-modal-sub {
        font-size: 13px;
        color: #64748b;
        margin: 0 0 20px 0;
    }
    .dk-upg-form-group {
        margin-bottom: 14px;
    }
    .dk-upg-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    .dk-upg-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 5px;
    }
    .dk-upg-input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 13.5px;
        box-sizing: border-box;
        outline: none;
        font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .dk-upg-input:focus {
        border-color: #e52d27;
        box-shadow: 0 0 0 3px rgba(229, 45, 39, 0.15);
    }
    .dk-upg-submit-btn {
        width: 100%;
        background: #e52d27;
        color: #ffffff;
        font-weight: 800;
        font-size: 14px;
        padding: 12px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        margin-top: 6px;
    }
    .dk-upg-submit-btn:hover {
        background: #c61f1a;
        transform: translateY(-1px);
    }
    .dk-upg-form-footnote {
        font-size: 11px;
        color: #94a3b8;
        text-align: center;
        margin-top: 10px;
    }

    /* ========================================================
       3D REALISTIC HERO TILT & VIDEO CONTROLS
    ======================================================== */
    .dk-upg-hero-section.has-3d-tilt {
        perspective: 1200px;
        transform-style: preserve-3d;
        position: relative;
        overflow: hidden;
    }

    .dk-hero-3d-sheen {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 3;
        transition: background 0.15s ease-out;
    }

    .dk-upg-hero-content {
        transition: transform 0.15s ease-out;
        transform-style: preserve-3d;
        will-change: transform;
    }

    .dk-hero-3d-floating-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 2;
        overflow: hidden;
    }

    .dk-float-chip {
        position: absolute;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 999px;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        animation: floatY 5s ease-in-out infinite alternate;
    }

    .dk-float-chip.chip-1 {
        top: 22%;
        left: 4%;
        animation-delay: 0s;
    }

    .dk-float-chip.chip-2 {
        top: 38%;
        right: 5%;
        animation-delay: 1.5s;
    }

    .dk-float-chip.chip-3 {
        bottom: 24%;
        left: 8%;
        animation-delay: 3s;
    }

    .chip-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 10px #38bdf8;
    }
    .chip-dot.green { background: #10b981; box-shadow: 0 0 10px #10b981; }
    .chip-dot.gold { background: #fbbf24; box-shadow: 0 0 10px #fbbf24; }

    @@keyframes floatY {
        0% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-12px) rotate(1deg); }
        100% { transform: translateY(6px) rotate(-1deg); }
    }

    .dk-hero-video-controls {
        position: absolute;
        top: 18px;
        right: 24px;
        z-index: 4;
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(15, 23, 42, 0.7);
        backdrop-filter: blur(8px);
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .dk-video-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ef4444;
        box-shadow: 0 0 8px #ef4444;
        animation: pulseRed 2s infinite;
    }

    @@keyframes pulseRed {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    .dk-video-label {
        font-size: 11px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.4px;
        margin-right: 4px;
    }

    .dk-video-ctrl-btn {
        background: rgba(255, 255, 255, 0.12);
        border: none;
        color: #ffffff;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
    }
    .dk-video-ctrl-btn:hover { background: rgba(255, 255, 255, 0.25); }

    /* ========================================================
       2.5 REDBUS-STYLE HORIZONTAL SEARCH BAR WIDGET
       Unified 4-segment bar: Destination | Nearest Centre | Preferred Intake | Counselling
    ======================================================== */
    .dk-redbus-search-section {
        padding: 0 20px;
        margin-top: -36px;
        position: relative;
        z-index: 50;
        margin-bottom: 45px;
        overflow: visible !important;
    }

    .dk-redbus-search-container {
        max-width: 1240px;
        margin: 0 auto;
        position: relative;
        overflow: visible !important;
    }

    .dk-redbus-outer-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 14px 35px -8px rgba(15, 23, 42, 0.12), 0 2px 8px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(226, 232, 240, 0.95);
        padding: 10px 14px 25px 14px;
        position: relative;
        overflow: visible !important;
    }

    /* Single continuous segmented box holding all 4 sections */
    .dk-redbus-segmented-box {
        display: flex;
        align-items: stretch;
        width: 100%;
        background: #ffffff;
        border: 1px solid #d5d7db;
        border-radius: 14px;
        position: relative;
        min-height: 68px;
        overflow: visible !important;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .dk-redbus-segmented-box:focus-within {
        border-color: #94a3b8;
    }

    .dk-redbus-seg {
        flex: 1;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        position: relative;
        user-select: none;
        border-radius: 12px;
        transition: background-color 0.15s;
    }

    .dk-redbus-seg:hover,
    .dk-redbus-seg.is-active {
        background-color: #f8fafc;
    }

    .dk-redbus-seg-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #475569;
    }

    .dk-redbus-seg-text-group {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .dk-redbus-seg-label {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 2px;
        display: block;
        line-height: 1.2;
    }

    .dk-redbus-seg-value {
        display: flex;
        align-items: baseline;
        gap: 6px;
        white-space: nowrap;
        overflow: hidden;
    }

    .dk-seg-flag {
        font-size: 16px;
        line-height: 1;
    }

    .dk-seg-title {
        font-size: 14.5px;
        font-weight: 800;
        color: #0f172a;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dk-seg-badge {
        font-size: 11px;
        font-weight: 700;
        color: #059669;
        background: #ecfdf5;
        padding: 1px 7px;
        border-radius: 4px;
        white-space: nowrap;
    }

    .dk-seg-subnote {
        font-size: 11px;
        font-weight: 500;
        color: #94a3b8;
        white-space: nowrap;
    }

    .dk-redbus-seg-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        transition: transform 0.2s, color 0.2s;
    }

    .dk-redbus-seg.is-active .dk-redbus-seg-arrow {
        transform: rotate(180deg);
        color: #d84e55;
    }

    .dk-redbus-divider {
        width: 1px;
        background: #e2e8f0;
        margin: 10px 0;
        flex-shrink: 0;
    }

    /* Segment 4: Booking for Counselling INSIDE THE BAR */
    .dk-redbus-seg-counselling {
        flex: 1.15;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        cursor: default;
        position: relative;
        border-radius: 12px;
        background: #ffffff;
    }

    .dk-counsellor-avatar-wrap {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dk-counsellor-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .dk-counsellor-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.25;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dk-counsellor-link {
        font-size: 11.5px;
        font-weight: 700;
        color: #2563eb;
        text-decoration: none;
        transition: color 0.15s;
    }

    .dk-counsellor-link:hover {
        color: #1d4ed8;
        text-decoration: underline;
    }

    /* Toggle Switch matching screenshot */
    .dk-redbus-toggle {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 26px;
        flex-shrink: 0;
        cursor: pointer;
    }

    .dk-redbus-toggle input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .dk-toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #cbd5e1;
        transition: 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        border-radius: 999px;
    }

    .dk-toggle-slider:before {
        position: absolute;
        content: "";
        height: 20px;
        width: 20px;
        left: 3px;
        bottom: 3px;
        background-color: #ffffff;
        transition: 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        border-radius: 50%;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);
    }

    .dk-redbus-toggle input:checked + .dk-toggle-slider {
        background-color: #334155;
    }

    .dk-redbus-toggle input:checked + .dk-toggle-slider:before {
        transform: translateX(20px);
    }

    /* Centered Hanging Red Pill Search Button */
    .dk-redbus-btn-center-wrap {
        position: absolute;
        bottom: -22px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 60;
    }

    .dk-redbus-hanging-btn {
        background: #d84e55;
        color: #ffffff;
        border: none;
        border-radius: 999px;
        padding: 13px 40px;
        font-size: 15.5px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(216, 78, 85, 0.45);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        white-space: nowrap;
        outline: none;
        letter-spacing: 0.3px;
    }

    .dk-redbus-hanging-btn:hover {
        background: #c53c43;
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(216, 78, 85, 0.55);
    }

    .dk-redbus-hanging-btn:active {
        transform: translateY(0);
        box-shadow: 0 4px 12px rgba(216, 78, 85, 0.35);
    }

    /* Dropdown Menus */
    .dk-redbus-dropdown-panel {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        min-width: 330px;
        max-width: 440px;
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 24px 50px -10px rgba(15, 23, 42, 0.22), 0 0 0 1px rgba(226, 232, 240, 0.95);
        padding: 10px;
        z-index: 99999;
        display: none;
        animation: dkDropFadeIn 0.16s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .dk-redbus-dropdown-panel.dk-panel-right {
        left: auto;
        right: 0;
    }

    .dk-redbus-dropdown-panel.is-open {
        display: block;
    }

    @@keyframes dkDropFadeIn {
        from { opacity: 0; transform: translateY(-6px); }
