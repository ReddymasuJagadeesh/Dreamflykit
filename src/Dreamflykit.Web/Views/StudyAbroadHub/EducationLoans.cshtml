<!-- ========================================================
     CLIENT-SIDE JAVASCRIPT: SCROLLSPY, EMI CALCULATOR & CONTROLS
========================================================= -->
<script>
    // 1. Tata Capital Navigation Controls
    function toggleTataNotif() {
        var pop = document.getElementById("tataNotifPop");
        if (pop) {
            pop.style.display = pop.style.display === "none" ? "block" : "none";
        }
    }

    function toggleTataMobileMenu() {
        var menu = document.getElementById("tataNavMenu");
        if (menu) {
            menu.classList.toggle("mobile-open");
        }
    }

    function handleTataSearch(e) {
        if (e.key === "Enter") {
            var q = e.target.value.trim();
            if (q) {
                window.location.href = "/search?q=" + encodeURIComponent(q);
            }
        }
    }

    // 2. Smooth Scrolling & Tab Click Handler
    function smoothScrollTo(sectionId) {
        var el = document.getElementById(sectionId);
        if (el) {
            var offset = 115; // Header + Sticky Subnav height
            var bodyRect = document.body.getBoundingClientRect().top;
            var elementRect = el.getBoundingClientRect().top;
            var elementPosition = elementRect - bodyRect;
            var offsetPosition = elementPosition - offset;

            window.scrollTo({
                top: offsetPosition,
                behavior: "smooth"
            });
        }
    }

    function handleTabClick(e, sectionId) {
        e.preventDefault();
        smoothScrollTo(sectionId);
    }

    // 3. ScrollSpy Implementation for the 4 Sections
    (function initScrollSpy() {
        var sections = ["overview", "document-required", "rates-and-charges", "emi-calculator"];
        var tabs = document.querySelectorAll(".dk-subnav-tab");

        function onScroll() {
            var scrollPos = window.scrollY + 130;
            var currentSection = "";

            for (var i = 0; i < sections.length; i++) {
                var el = document.getElementById(sections[i]);
                if (el) {
                    var top = el.offsetTop;
                    var height = el.offsetHeight;
                    if (scrollPos >= top && scrollPos < top + height) {
                        currentSection = sections[i];
                        break;
                    }
                }
            }

            if (currentSection) {
                tabs.forEach(function (tab) {
                    if (tab.getAttribute("data-section") === currentSection) {
                        tab.classList.add("active");
                    } else {
                        tab.classList.remove("active");
                    }
                });
            }
        }

        window.addEventListener("scroll", onScroll, { passive: true });
    })();

    // 4. Interactive EMI Calculator
    function formatINR(val) {
        return Math.round(val).toLocaleString("en-IN");
    }

    function calculateEMI() {
        var amountSlider = document.getElementById("emiAmountRange");
        var rateSlider = document.getElementById("emiRateRange");
        var tenureSlider = document.getElementById("emiTenureRange");

        if (!amountSlider || !rateSlider || !tenureSlider) return;

        var P = parseFloat(amountSlider.value) || 3000000;
        var annualRate = parseFloat(rateSlider.value) || 9.5;
        var years = parseInt(tenureSlider.value, 10) || 10;

        var r = annualRate / 12 / 100; // monthly rate
        var n = years * 12; // number of installments

        var emi = 0;
        if (r === 0) {
            emi = P / n;
        } else {
            emi = P * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
        }

        var totalPayable = emi * n;
        var totalInterest = totalPayable - P;

        // Update displays
        var lblMonthlyEmi = document.getElementById("lblMonthlyEmi");
        var lblPrincipal = document.getElementById("lblPrincipalAmount");
        var lblInterest = document.getElementById("lblTotalInterest");
        var lblTotal = document.getElementById("lblTotalPayable");
        var btnApply = document.getElementById("btnApplyCalculatedEmi");

        if (lblMonthlyEmi) lblMonthlyEmi.textContent = formatINR(emi);
        if (lblPrincipal) lblPrincipal.textContent = "₹ " + formatINR(P);
        if (lblInterest) lblInterest.textContent = "₹ " + formatINR(totalInterest);
        if (lblTotal) lblTotal.textContent = "₹ " + formatINR(totalPayable);

        if (btnApply) {
            btnApply.innerHTML = "<span>Apply for ₹ " + formatINR(P) + " Loan Now →</span>";
        }

        // Update proportion bars
        var pctPrincipal = ((P / totalPayable) * 100).toFixed(1);
        var pctInterest = (100 - pctPrincipal).toFixed(1);

        var barPrincipal = document.getElementById("barPrincipal");
        var barInterest = document.getElementById("barInterest");
        var txtPctPrincipal = document.getElementById("pctPrincipal");
        var txtPctInterest = document.getElementById("pctInterest");

        if (barPrincipal) barPrincipal.style.width = pctPrincipal + "%";
        if (barInterest) barInterest.style.width = pctInterest + "%";
        if (txtPctPrincipal) txtPctPrincipal.textContent = pctPrincipal + "%";
        if (txtPctInterest) txtPctInterest.textContent = pctInterest + "%";
    }

    function updateEmiFromSlider() {
        var amountSlider = document.getElementById("emiAmountRange");
        var rateSlider = document.getElementById("emiRateRange");
        var tenureSlider = document.getElementById("emiTenureRange");

        var amountDisplay = document.getElementById("emiAmountDisplay");
        var rateDisplay = document.getElementById("emiRateDisplay");
        var tenureDisplay = document.getElementById("emiTenureDisplay");

        if (amountSlider && amountDisplay) {
            amountDisplay.value = formatINR(amountSlider.value);
        }
        if (rateSlider && rateDisplay) {
            rateDisplay.value = rateSlider.value;
        }
        if (tenureSlider && tenureDisplay) {
            tenureDisplay.value = tenureSlider.value;
        }

        calculateEMI();
    }

    function setEmiAmount(val) {
        var slider = document.getElementById("emiAmountRange");
        if (slider) {
            slider.value = val;
            updateEmiFromSlider();
        }
        // Update active class on preset buttons
        document.querySelectorAll(".dk-emi-control-group:nth-child(1) .dk-preset-btn").forEach(function (btn) {
            btn.classList.toggle("active", btn.textContent.includes(val >= 10000000 ? (val/10000000) + " Cr" : (val/100000) + " L"));
        });
    }

    function setEmiRate(val) {
        var slider = document.getElementById("emiRateRange");
        if (slider) {
            slider.value = val;
            updateEmiFromSlider();
        }
        document.querySelectorAll(".dk-emi-control-group:nth-child(2) .dk-preset-btn").forEach(function (btn) {
            btn.classList.toggle("active", btn.textContent.includes(val.toString()));
        });
    }

    function setEmiTenure(val) {
        var slider = document.getElementById("emiTenureRange");
        if (slider) {
            slider.value = val;
            updateEmiFromSlider();
        }
        document.querySelectorAll(".dk-emi-control-group:nth-child(3) .dk-preset-btn").forEach(function (btn) {
            btn.classList.toggle("active", btn.textContent.includes(val.toString()));
        });
    }

    function handleEmiAmountInput(text) {
        var clean = text.replace(/[^0-9]/g, "");
        var num = parseInt(clean, 10);
        if (!isNaN(num)) {
            var slider = document.getElementById("emiAmountRange");
            if (slider) {
                slider.value = num;
                updateEmiFromSlider();
            }
        }
    }

    function handleEmiRateInput(text) {
        var num = parseFloat(text);
        if (!isNaN(num)) {
            var slider = document.getElementById("emiRateRange");
            if (slider) {
                slider.value = num;
                updateEmiFromSlider();
            }
        }
    }

    function handleEmiTenureInput(text) {
        var num = parseInt(text, 10);
        if (!isNaN(num)) {
            var slider = document.getElementById("emiTenureRange");
            if (slider) {
                slider.value = num;
                updateEmiFromSlider();
            }
        }
    }

    function applyWithCalculatedLoan() {
        var slider = document.getElementById("emiAmountRange");
        var amountText = slider ? "₹ " + formatINR(slider.value) : "Education Loan";
        openEduModal("EMI Calculator Selection: " + amountText);
        
        var select = document.getElementById("leadLoanAmount");
        if (select && slider) {
            var val = parseInt(slider.value, 10);
            if (val <= 2500000) select.value = "₹10L - ₹25L";
            else if (val <= 5000000) select.value = "₹25L - ₹50L";
            else if (val <= 10000000) select.value = "₹50L - ₹1 Crore";
            else select.value = "Above ₹1 Crore";
        }
    }

    // 5. Partner Cards Toggle & Tech Conveyor Carousel
    (function initLegacyFeatures() {
        var btnToggle = document.getElementById("btnTogglePartners");
        if (btnToggle) {
            btnToggle.addEventListener("click", function () {
                var extraCards = document.querySelectorAll(".dk-edu-partner-card.partner-extra");
                var isExpanded = btnToggle.getAttribute("data-expanded") === "true";
                extraCards.forEach(function (card) {
                    card.classList.toggle("shown", !isExpanded);
                });
                btnToggle.setAttribute("data-expanded", !isExpanded ? "true" : "false");
                btnToggle.querySelector("span").textContent = !isExpanded ? "View Less ⌃" : "View More ⌵";
            });
        }

        var viewport = document.getElementById("coursesViewport");
        var track = document.getElementById("coursesTrack");

        if (viewport && track) {
            var cards = track.querySelectorAll(".dk-tech-course-card");
            if (cards.length > 0) {
                var intervalSec = parseInt(viewport.getAttribute("data-interval-sec") || "3", 10);
                if (isNaN(intervalSec) || intervalSec < 1) intervalSec = 3;

                var isPaused = false;
                var isSliding = false;

                viewport.addEventListener("mouseenter", function () { isPaused = true; });
                viewport.addEventListener("mouseleave", function () { isPaused = false; });
                viewport.addEventListener("touchstart", function () { isPaused = true; }, { passive: true });
                viewport.addEventListener("touchend", function () { isPaused = false; });

                function slideNextRightToLeft() {
                    if (isPaused || isSliding) return;
                    var firstCard = track.firstElementChild;
                    if (!firstCard) return;

                    isSliding = true;
                    var cardWidth = firstCard.offsetWidth || 280;
                    var gap = 20;
                    var stepDistance = cardWidth + gap;

                    track.style.transition = "transform 0.65s cubic-bezier(0.25, 1, 0.5, 1)";
                    track.style.transform = "translateX(-" + stepDistance + "px)";

                    setTimeout(function () {
                        track.style.transition = "none";
                        track.style.transform = "translateX(0)";
                        track.appendChild(firstCard);
                        void track.offsetWidth;
                        isSliding = false;
                    }, 660);
                }

                setInterval(slideNextRightToLeft, intervalSec * 1000);
            }
        }

        // Initialize EMI calculator on load
        calculateEMI();
    })();

    // 6. Modal Functions
    function openEduModal(sourceTitle) {
        var modal = document.getElementById("eduLoanModal");
        var subText = document.getElementById("eduModalSubText");
        var leadSource = document.getElementById("leadSource");
        var form = document.getElementById("frmEduLoanApplication");
        var success = document.getElementById("eduModalSuccess");

        if (subText && sourceTitle) {
            subText.textContent = "Application focus: " + sourceTitle + ". Sanctions in 48 hours with lowest interest rates.";
        }
        if (leadSource && sourceTitle) {
            leadSource.value = sourceTitle;
        }
        if (form) form.style.display = "block";
        if (success) success.style.display = "none";
        if (modal) modal.style.display = "flex";
    }

    function closeEduModal() {
        var modal = document.getElementById("eduLoanModal");
        if (modal) modal.style.display = "none";
    }

    function closeEduModalOnBackdrop(e) {
        if (e.target.id === "eduLoanModal") {
            closeEduModal();
        }
    }

    async function handleEduLoanSubmit(e) {
        e.preventDefault();
        var btn = document.getElementById("btnSubmitLoan");
        if (btn) {
            btn.disabled = true;
            btn.textContent = "Submitting application...";
        }

        var payload = {
            FullName: document.getElementById("leadFullName")?.value || "",
            PhoneNumber: document.getElementById("leadPhone")?.value || "",
            Email: document.getElementById("leadEmail")?.value || "",
            TargetCountry: document.getElementById("leadCountry")?.value || "",
            DesiredLoanAmount: document.getElementById("leadLoanAmount")?.value || "",
            CollateralType: document.getElementById("leadCollateral")?.value || "",
            CourseOrProgram: document.getElementById("leadProgram")?.value || "",
            Notes: "Source: " + (document.getElementById("leadSource")?.value || "Education Loans Page")
        };

        try {
            var response = await fetch("/study-abroad-hub/apply-loan", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(payload)
            });

            var result = await response.json();

            if (result.success) {
                var form = document.getElementById("frmEduLoanApplication");
                var success = document.getElementById("eduModalSuccess");
                var msg = document.getElementById("eduSuccessMsg");
                if (form) form.style.display = "none";
                if (success) success.style.display = "block";
                if (msg && result.message) msg.textContent = result.message;
            } else {
                alert(result.message || "Unable to submit application. Please try again.");
            }
        } catch (err) {
            alert("Application submitted! Our team will contact you shortly.");
            closeEduModal();
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = "Check Eligibility & Apply Now →";
            }
        }
    }
</script>
