                <h3 class="dk-upg-modal-title" id="modalDynamicTitle">@cPage.LeadModalTitle</h3>
                <p class="dk-upg-modal-sub" id="modalDynamicSub">@cPage.LeadModalSubtitle</p>
            </div>

            <form id="consultancyLeadForm" onsubmit="handleLeadSubmit(event)">
                <input type="hidden" id="leadTargetProgram" value="General Study Abroad Enquiry" />

                <div class="dk-upg-form-group">
                    <label class="dk-upg-label">Full Name *</label>
                    <input type="text" id="leadFullName" class="dk-upg-input" placeholder="e.g. Rahul Sharma" required />
                </div>

                <div class="dk-upg-form-row">
                    <div class="dk-upg-form-group">
                        <label class="dk-upg-label">Mobile Number *</label>
                        <input type="tel" id="leadPhone" class="dk-upg-input" placeholder="e.g. +91 98765 43210" required />
                    </div>
                    <div class="dk-upg-form-group">
                        <label class="dk-upg-label">Email Address *</label>
                        <input type="email" id="leadEmail" class="dk-upg-input" placeholder="e.g. rahul@example.com" required />
                    </div>
                </div>

                <div class="dk-upg-form-row">
                    <div class="dk-upg-form-group">
                        <label class="dk-upg-label">Target Level</label>
                        <select id="leadTargetDegree" class="dk-upg-input">
                            <option value="Master's Degree">Master's Degree (MS / MSc)</option>
                            <option value="MBA / Executive">MBA / Executive Leadership</option>
                            <option value="Executive Diploma">Executive Diploma / Upskilling</option>
                            <option value="Bachelor's Degree">Bachelor's Degree</option>
                            <option value="Doctorate">Doctorate / PhD</option>
                        </select>
                    </div>
                    <div class="dk-upg-form-group">
                        <label class="dk-upg-label">Preferred Country</label>
                        <select id="leadDestination" class="dk-upg-input">
                            <option value="France">France 🇫🇷</option>
                            <option value="United Kingdom">United Kingdom 🇬🇧</option>
                            <option value="Canada">Canada 🇨🇦</option>
                            <option value="Finland">Finland 🇫🇮</option>
                            <option value="Germany">Germany 🇩🇪</option>
                            <option value="USA">United States 🇺🇸</option>
                            <option value="Other">Other Global Destinations</option>
                        </select>
                    </div>
                </div>

                <div class="dk-upg-form-group">
                    <label class="dk-upg-label">Your Questions / Notes (Optional)</label>
                    <textarea id="leadNotes" class="dk-upg-input" rows="2" placeholder="Tell us your background, budget, or preferred universities..."></textarea>
                </div>

                <button type="submit" class="dk-upg-submit-btn" id="btnSubmitLead">
                    <span>Book My Free Counselling Session →</span>
                </button>
                <div class="dk-upg-form-footnote">
                    🔒 Certified privacy. We will never share your contact details. 10,000+ students counselled.
                </div>
            </form>

            <div id="leadSuccessFeedback" style="display: none; text-align: center; padding: 24px 10px;">
                <div style="width: 58px; height: 58px; background: #dcfce7; color: #16a34a; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; font-size: 28px;">✓</div>
                <h4 style="font-size: 20px; font-weight: 900; color: #0f172a; margin: 0 0 8px 0;">Consultation Reserved!</h4>
                <p id="leadSuccessMessage" style="font-size: 14px; color: #475569; margin: 0 0 20px 0; line-height: 1.6;"></p>
                <button type="button" class="dk-upg-btn-red" onclick="closeConsultancyModal()" style="margin: 0 auto;">Done</button>
            </div>
        </div>
    </div>

</div>

