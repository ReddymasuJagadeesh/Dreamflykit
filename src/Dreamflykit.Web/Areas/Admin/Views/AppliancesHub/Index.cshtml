                                                <input type="checkbox" id="brand_soon_@(p.CategorySlug)_@b" @(brand.IsUploadingSoon ? "checked" : "") />
                                                <span>Show "UPLOADING SOON" Badge</span>
                                            </label>
                                        </div>

                                        <div style="display: flex; gap: 8px; align-items: center;">
                                            <div style="width: 36px; height: 36px; border-radius: 6px; background: #fff; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
                                                <img id="brand_preview_@(p.CategorySlug)_@b" src="@brand.LogoUrl" style="max-width: 100%; max-height: 100%; object-fit: contain;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg';" />
                                            </div>
                                            <input type="text" id="brand_logo_@(p.CategorySlug)_@b" class="dk-admin-input" value="@brand.LogoUrl" style="font-size: 11px; flex: 1;" oninput="document.getElementById('brand_preview_@(p.CategorySlug)_@b').src=this.value;" />
                                            <input type="file" id="brand_file_@(p.CategorySlug)_@b" accept="image/*" style="display: none;" onchange="uploadBrandLogoImg('@p.CategorySlug', @b, this)" />
                                            <button type="button" onclick="document.getElementById('brand_file_@(p.CategorySlug)_@b').click()" class="dk-btn" style="background: #334155; color: #fff; border: none; font-size: 11px; padding: 6px 10px; border-radius: 4px; cursor: pointer;">
