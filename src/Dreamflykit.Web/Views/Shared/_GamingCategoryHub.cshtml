<!-- Slider JavaScript -->
<script>
    (function () {
        var slider = document.getElementById('gmHeroSlider');
        if (!slider) return;

        var slides = slider.querySelectorAll('.gm-hero-slide');
        var dots = slider.querySelectorAll('.gm-slider-dot');
        var autoplay = slider.getAttribute('data-autoplay') === 'true';
        var intervalMs = parseInt(slider.getAttribute('data-interval') || '4000', 10);
        var currentIndex = 0;
        var timer = null;

        function showSlide(index) {
            if (slides.length <= 1) return;
            if (index < 0) index = slides.length - 1;
            if (index >= slides.length) index = 0;

            slides.forEach(function (s, i) {
                if (i === index) {
                    s.classList.add('active');
                } else {
                    s.classList.remove('active');
                }
            });

            dots.forEach(function (d, i) {
                if (i === index) {
                    d.classList.add('active');
                } else {
                    d.classList.remove('active');
                }
            });

            currentIndex = index;
        }

        window.gmNextSlide = function () {
            showSlide(currentIndex + 1);
            resetTimer();
        };

        window.gmPrevSlide = function () {
            showSlide(currentIndex - 1);
            resetTimer();
        };

        window.gmGoToSlide = function (idx) {
            showSlide(idx);
            resetTimer();
        };

        function resetTimer() {
            if (timer) clearInterval(timer);
            if (autoplay && slides.length > 1) {
                timer = setInterval(function () {
                    showSlide(currentIndex + 1);
                }, intervalMs);
            }
        }

        if (autoplay && slides.length > 1) {
            resetTimer();
            slider.addEventListener('mouseenter', function () {
                if (timer) clearInterval(timer);
            });
            slider.addEventListener('mouseleave', function () {
                resetTimer();
            });
        }
    })();
</script>
