@model Dreamflykit.Web.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password — Dreamflykit";
    Layout = "_Layout";
}

<div class="dk-auth-page-wrapper">
    <div class="dk-auth-card-container">
        <!-- Brand Panel (Left) -->
        <div class="dk-auth-brand-panel">
            <div class="dk-auth-brand-badge">
                <img src="~/images/branding/dreamflykit-logo.webp"
                     alt="Dreamflykit"
                     class="dk-auth-logo-img" />
            </div>
            <h2 class="dk-auth-tagline">
                New<br />Password
            </h2>
            <p class="dk-auth-subtitle">
                Create a strong, secure password for your Dreamflykit account.
            </p>
        </div>

        <!-- Form Panel (Right) -->
        <div class="dk-auth-form-panel">
            <div class="dk-auth-form-inner">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Reset Password</h1>
                <p class="text-sm text-gray-500 mb-6">
                    Enter your email and choose a new password (min. 12 characters).
                </p>

                <form asp-action="ResetPassword" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Code" />

                    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                        <input asp-for="Email"
                               type="email"
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 text-sm bg-gray-50"
                               readonly />
                        <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
                        <input asp-for="Password"
                               type="password"
                               placeholder="Minimum 12 characters"
                               autofocus
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 text-sm" />
                        <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password</label>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               placeholder="Re-enter password"
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 text-sm" />
                        <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <button type="submit"
                            class="w-full py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-orange-600 hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 transition-colors">
                        Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

