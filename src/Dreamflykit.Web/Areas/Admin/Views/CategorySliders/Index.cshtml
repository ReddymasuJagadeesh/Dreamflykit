@model Dreamflykit.Application.CategoryShowcase.Models.CategoryThreeSectionConfigDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "3-Section Category Sliders Management";
    var activeSlug = ViewBag.ActiveSlug as string ?? "electronics";
    var allSliders = ViewBag.AllSliders as Dreamflykit.Application.CategoryShowcase.Models.CategoryThreeSectionHubDto;
    var slides = Model?.Slides?.OrderBy(s => s.DisplayOrder).ToList() ?? new List<Dreamflykit.Application.CategoryShowcase.Models.CategorySliderSlideDto>();

    var availableCategories = new List<(string Slug, string Name, string Emoji)>
    {
        ("electronics", "Electronics", "💻"),
        ("appliances", "Appliances", "📺"),
        ("fashion", "Fashion", "👗"),
        ("study-essentials", "Study Essentials", "🎓"),
        ("travel-gear", "Travel Gear", "✈️"),
        ("mobiles", "Mobiles", "📱"),
        ("beauty", "Beauty & Personal", "💄"),
        ("health-care", "Health Care", "💊"),
        ("food", "Food & Gourmet", "🍫"),
        ("story-books", "Story Books", "📚"),
        ("kitchen-appliances", "Kitchen Appliances", "🍳"),
        ("room-living", "Room & Living", "🛋️")
    };
}

@Html.AntiForgeryToken()

<div class="dk-admin-content-container" style="max-width: 1400px; margin: 0 auto; padding: 24px 20px;">

    <!-- TOP HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <span style="background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); color: #ffffff; font-size: 11px; font-weight: 900; padding: 4px 10px; border-radius: 4px; letter-spacing: 1px;">⚡ SHOWCASE SLIDERS</span>
                <span style="background: #1e293b; color: #94a3b8; font-size: 11px; font-weight: 700; padding: 4px 8px; border-radius: 4px;">SYNCHRONIZED RIGHT-TO-LEFT 3-SECTION</span>
            </div>
            <h1 style="font-size: 26px; font-weight: 900; color: #0f172a; margin: 0;">
                Category 3-Section Sliders: @Model?.CategoryName
            </h1>
            <p style="font-size: 13.5px; color: #64748b; margin: 4px 0 0 0;">
                Manage the 3 side-by-side synchronized slides shown directly below "Shop by Category" across all store categories.
            </p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a href="/category/@activeSlug" target="_blank" class="dk-btn" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 10px 18px; font-size: 13.5px; font-weight: 700; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <span>👁️</span> Preview Live Category Store
            </a>
            <form asp-action="ResetDefaults" method="post" style="display: inline;" onsubmit="return confirm('Reset this category slider to default 6 curated slides?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="categorySlug" value="@activeSlug" />
                <button type="submit" class="dk-btn" style="background: #fff; color: #dc2626; border: 1px solid #fca5a5; padding: 10px 16px; font-size: 13px; font-weight: 700; border-radius: 8px; cursor: pointer;">
                    ↺ Reset Category Defaults
                </button>
            </form>
            <button type="button" class="dk-btn" id="btnSaveSliderTop" onclick="saveCategorySliderConfig()" style="background: #ea580c; color: #ffffff; border: none; padding: 11px 26px; font-size: 14px; font-weight: 800; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Save Slider Changes
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #ecfdf5; border-left: 4px solid #10b981; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; color: #065f46; font-weight: 600;">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    <!-- CATEGORY SELECTION PILLS -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <label style="display: block; font-size: 12px; font-weight: 800; text-transform: uppercase; color: #64748b; margin-bottom: 10px; letter-spacing: 0.5px;">
            Select Category to Configure:
        </label>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            @foreach (var cat in availableCategories)
            {
                var isSelected = string.Equals(cat.Slug, activeSlug, StringComparison.OrdinalIgnoreCase);
                <a href="/Admin/CategorySliders?categorySlug=@cat.Slug" 
                   style="padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s; @(isSelected ? "background: #ea580c; color: #ffffff; box-shadow: 0 4px 10px rgba(234, 88, 12, 0.3);" : "background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;")">
                    <span>@cat.Emoji</span>
                    <span>@cat.Name</span>
                </a>
            }
        </div>
    </div>

    <!-- GENERAL CONFIG CARD -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px 24px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <h3 style="font-size: 16px; font-weight: 800; color: #0f172a; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
            <span>⚙️</span> General Slider Settings for "@Model?.CategoryName"
        </h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; align-items: center;">
            <label style="display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; color: #334155; cursor: pointer; background: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
                <input type="checkbox" id="cfg_IsEnabled" @(Model?.IsEnabled == true ? "checked" : "") style="width: 18px; height: 18px; accent-color: #ea580c;" />
                <span>Showcase Enabled</span>
            </label>

            <label style="display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; color: #334155; cursor: pointer; background: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
                <input type="checkbox" id="cfg_AutoPlay" @(Model?.AutoPlay == true ? "checked" : "") style="width: 18px; height: 18px; accent-color: #ea580c;" />
                <span>Auto-Play Rotation</span>
            </label>

            <div style="background: #f8fafc; padding: 10px 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
                <label style="display: block; font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 4px;">Slide Interval (Seconds)</label>
                <input type="number" id="cfg_SlideInterval" min="2" max="15" value="@(Model?.SlideIntervalSeconds ?? 4)" style="width: 100%; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13.5px; font-weight: 700;" />
            </div>

            <div style="background: #f8fafc; padding: 10px 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
                <label style="display: block; font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 4px;">Slide Speed (ms)</label>
                <input type="number" id="cfg_Duration" min="300" max="1500" step="50" value="@(Model?.TransitionDurationMs ?? 650)" style="width: 100%; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13.5px; font-weight: 700;" />
            </div>
        </div>
    </div>

    <!-- SLIDES LIST -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 14px;">
            <div>
                <h3 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">
                    3-Section Synchronized Slides (<span id="slideCountBadge">@slides.Count</span> Slides)
                </h3>
                <p style="font-size: 13px; color: #64748b; margin: 4px 0 0 0;">
                    All 3 visible slots rotate simultaneously from Right to Left (Right card moves to left, center moves to left, left exits left).
                </p>
            </div>
            <button type="button" onclick="addNewSlide()" style="background: #0284c7; color: #ffffff; border: none; padding: 10px 18px; font-size: 13px; font-weight: 800; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                <span>+</span> Add New Slide
            </button>
        </div>

        <div id="slidesListContainer" style="display: flex; flex-direction: column; gap: 20px;">
            @for (int i = 0; i < slides.Count; i++)
            {
                var s = slides[i];
                <div class="slide-card-item" data-index="@i" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 18px; position: relative;">
                    <!-- Card Top Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="background: #0f172a; color: #ffffff; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 4px;">
                                SLIDE #@(i + 1)
                            </span>
                            <span class="slide-title-preview" style="font-size: 14px; font-weight: 800; color: #0f172a;">@s.Title</span>
                            <span style="background: @s.ThemeGlowColor; width: 12px; height: 12px; border-radius: 50%; display: inline-block;" title="Glow: @s.ThemeGlowColor"></span>
                        </div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">
                                <input type="checkbox" class="slide-is-active" @(s.IsActive ? "checked" : "") style="accent-color: #ea580c;" /> Active
                            </label>
                            <button type="button" onclick="deleteSlide(this)" style="background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; padding: 4px 10px; font-size: 12px; font-weight: 700; border-radius: 6px; cursor: pointer;">
                                Delete
                            </button>
                        </div>
                    </div>

                    <input type="hidden" class="slide-id" value="@s.Id" />
                    <input type="hidden" class="slide-cat" value="@s.CategorySlug" />

                    <!-- Form Grid -->
                    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 14px; margin-bottom: 12px;">
                        <div>
                            <label class="sbf-label">Product Name / Title *</label>
                            <input type="text" class="sbf-input slide-title" value="@s.Title" oninput="updateSlideTitlePreview(this)" placeholder="e.g. MacBook Air M3 15\"" />
                        </div>
                        <div>
                            <label class="sbf-label">Badge Text</label>
                            <input type="text" class="sbf-input slide-badge" value="@s.BadgeText" placeholder="e.g. FLAGSHIP SPECIAL" />
                        </div>
                        <div>
                            <label class="sbf-label">Star Rating (1-5)</label>
                            <input type="text" class="sbf-input slide-rating" value="@s.Rating" placeholder="4.8" />
                        </div>
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label class="sbf-label">Tagline Highlight</label>
                        <input type="text" class="sbf-input slide-tagline" value="@s.Tagline" placeholder="e.g. Apple M3 Chip & Liquid Retina Display" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 14px; margin-bottom: 12px;">
                        <div>
                            <label class="sbf-label">Selling Price</label>
                            <input type="text" class="sbf-input slide-price" value="@s.PriceText" placeholder="From ₹44,999*" />
                        </div>
                        <div>
                            <label class="sbf-label">Original MRP</label>
                            <input type="text" class="sbf-input slide-orig-price" value="@s.OriginalPriceText" placeholder="₹89,999" />
                        </div>
                        <div>
                            <label class="sbf-label">0% EMI Text</label>
                            <input type="text" class="sbf-input slide-emi" value="@s.EmiBadgeText" placeholder="0% EMI ₹3,750/m" />
                        </div>
                        <div>
                            <label class="sbf-label">Disclaimer</label>
                            <input type="text" class="sbf-input slide-disclaimer" value="@s.OfferDisclaimer" placeholder="*Incl. All Offers" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 14px; margin-bottom: 12px;">
                        <div>
                            <label class="sbf-label">Target Link URL</label>
                            <input type="text" class="sbf-input slide-target-url" value="@s.TargetUrl" placeholder="/category/electronics" />
                        </div>
                        <div>
                            <label class="sbf-label">Glow Ribbon Color</label>
                            <div style="display: flex; gap: 6px; align-items: center;">
                                <input type="color" class="slide-glow-color" value="@s.ThemeGlowColor" style="width: 44px; height: 36px; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; padding: 2px;" />
                                <div style="display: flex; gap: 4px;">
                                    <button type="button" onclick="setGlowColor(this, '#f97316')" style="background: #f97316; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;"></button>
                                    <button type="button" onclick="setGlowColor(this, '#3b82f6')" style="background: #3b82f6; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;"></button>
                                    <button type="button" onclick="setGlowColor(this, '#10b981')" style="background: #10b981; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;"></button>
                                    <button type="button" onclick="setGlowColor(this, '#8b5cf6')" style="background: #8b5cf6; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;"></button>
                                    <button type="button" onclick="setGlowColor(this, '#eab308')" style="background: #eab308; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;"></button>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label class="sbf-label">Display Order</label>
                            <input type="number" class="sbf-input slide-order" value="@s.DisplayOrder" style="width: 100%;" />
                        </div>
                    </div>

                    <!-- Image Upload & Preview -->
                    <div style="display: grid; grid-template-columns: 3fr 1fr; gap: 14px; align-items: center; background: #ffffff; padding: 12px 14px; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <div>
                            <label class="sbf-label" style="display: flex; justify-content: space-between;">
                                <span>3D Cutout Product Image</span>
                                <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11.5px; font-weight: 700; color: #ea580c;">
                                    <input type="checkbox" class="slide-uploading-soon" @(s.IsUploadingSoon ? "checked" : "") style="accent-color: #ea580c;" />
                                    Show "Uploading Soon" Tag
                                </label>
                            </label>
                            <div style="display: flex; gap: 8px;">
                                <input type="text" class="sbf-input slide-img-url" value="@s.ImageUrl" oninput="updateSlideImgPreview(this)" placeholder="/images/fashion-hub/uploading-soon-placeholder.svg" style="flex: 1;" />
                                <button type="button" onclick="triggerSlideUpload(this)" style="background: #2563eb; color: #ffffff; border: none; padding: 8px 14px; font-size: 12.5px; font-weight: 700; border-radius: 6px; cursor: pointer; white-space: nowrap;">
                                    📁 Upload Image
                                </button>
                            </div>
                        </div>
                        <div style="text-align: center;">
                            <img src="@s.ImageUrl" class="slide-img-preview" alt="Preview" style="height: 60px; max-width: 100%; object-fit: contain; border-radius: 6px; background: #0f172a; padding: 4px;" onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg';" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Hidden global file input -->
    <input type="file" id="globalSlideFileInput" accept="image/*" style="display: none;" />

    <!-- BOTTOM ACTION BAR -->
    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e2e8f0;">
        <button type="button" class="dk-btn" onclick="saveCategorySliderConfig()" style="background: #ea580c; color: #ffffff; border: none; padding: 12px 32px; font-size: 15px; font-weight: 800; border-radius: 8px; cursor: pointer; box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35);">
            💾 Save All Changes
        </button>
    </div>
</div>

<style>
.sbf-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #475569;
    margin-bottom: 4px;
}
.sbf-input {
    width: 100%;
    padding: 7px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #0f172a;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s;
}
.sbf-input:focus {
    border-color: #ea580c;
    box-shadow: 0 0 0 2px rgba(234, 88, 12, 0.15);
}
</style>

<script>
let currentUploadInputTarget = null;
let currentUploadPreviewTarget = null;

function setGlowColor(btn, color) {
    const parent = btn.closest('.slide-card-item');
    if (!parent) return;
    const colorInput = parent.querySelector('.slide-glow-color');
    if (colorInput) colorInput.value = color;
}

function updateSlideTitlePreview(input) {
    const parent = input.closest('.slide-card-item');
    if (!parent) return;
    const preview = parent.querySelector('.slide-title-preview');
    if (preview) preview.innerText = input.value || 'Untitled Slide';
}

function updateSlideImgPreview(input) {
    const parent = input.closest('.slide-card-item');
    if (!parent) return;
    const preview = parent.querySelector('.slide-img-preview');
    if (preview) preview.src = input.value || '/images/fashion-hub/uploading-soon-placeholder.svg';
}

function triggerSlideUpload(btn) {
    const parent = btn.closest('.slide-card-item');
    if (!parent) return;
    currentUploadInputTarget = parent.querySelector('.slide-img-url');
    currentUploadPreviewTarget = parent.querySelector('.slide-img-preview');

    const fileInput = document.getElementById('globalSlideFileInput');
    if (fileInput) fileInput.click();
}

document.getElementById('globalSlideFileInput')?.addEventListener('change', async function() {
    if (!this.files || this.files.length === 0) return;
    const file = this.files[0];

    const formData = new FormData();
    formData.append('file', file);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    try {
        const response = await fetch('/Admin/CategorySliders/UploadImage', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });

        const data = await response.json();
        if (data.success && data.url) {
            if (currentUploadInputTarget) {
                currentUploadInputTarget.value = data.url;
            }
            if (currentUploadPreviewTarget) {
                currentUploadPreviewTarget.src = data.url;
            }
            alert('Image uploaded successfully!');
        } else {
            alert('Upload failed: ' + (data.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Upload error: ' + err.message);
    } finally {
        this.value = '';
    }
});

function deleteSlide(btn) {
    if (!confirm('Are you sure you want to delete this slide?')) return;
    const card = btn.closest('.slide-card-item');
    if (card) {
        card.remove();
        updateSlideNumbers();
    }
}

function updateSlideNumbers() {
    const items = document.querySelectorAll('.slide-card-item');
    document.getElementById('slideCountBadge').innerText = items.length;
    items.forEach((item, idx) => {
        const badge = item.querySelector('span[style*="background: #0f172a"]');
        if (badge) badge.innerText = `SLIDE #${idx + 1}`;
    });
}

function addNewSlide() {
    const container = document.getElementById('slidesListContainer');
    const items = document.querySelectorAll('.slide-card-item');
    const newIdx = items.length;
    const newOrder = newIdx + 1;

    const div = document.createElement('div');
    div.className = 'slide-card-item';
    div.setAttribute('data-index', newIdx);
    div.style = 'background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 18px; position: relative;';

    div.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="background: #0f172a; color: #ffffff; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 4px;">
                    SLIDE #${newOrder}
                </span>
                <span class="slide-title-preview" style="font-size: 14px; font-weight: 800; color: #0f172a;">New Product Slide</span>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">
                    <input type="checkbox" class="slide-is-active" checked style="accent-color: #ea580c;" /> Active
                </label>
                <button type="button" onclick="deleteSlide(this)" style="background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; padding: 4px 10px; font-size: 12px; font-weight: 700; border-radius: 6px; cursor: pointer;">
                    Delete
                </button>
            </div>
        </div>

        <input type="hidden" class="slide-id" value="gen_${Date.now()}" />
        <input type="hidden" class="slide-cat" value="@activeSlug" />

        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 14px; margin-bottom: 12px;">
            <div>
                <label class="sbf-label">Product Name / Title *</label>
                <input type="text" class="sbf-input slide-title" value="New Featured Product" oninput="updateSlideTitlePreview(this)" placeholder="e.g. MacBook Air M3" />
            </div>
            <div>
                <label class="sbf-label">Badge Text</label>
                <input type="text" class="sbf-input slide-badge" value="SPECIAL OFFER" placeholder="e.g. FLAGSHIP SPECIAL" />
            </div>
            <div>
                <label class="sbf-label">Star Rating (1-5)</label>
                <input type="text" class="sbf-input slide-rating" value="4.8" placeholder="4.8" />
            </div>
        </div>

        <div style="margin-bottom: 12px;">
            <label class="sbf-label">Tagline Highlight</label>
            <input type="text" class="sbf-input slide-tagline" value="High performance and genuine student warranty" placeholder="Tagline description" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 14px; margin-bottom: 12px;">
            <div>
                <label class="sbf-label">Selling Price</label>
                <input type="text" class="sbf-input slide-price" value="From ₹2,999*" placeholder="From ₹2,999*" />
            </div>
            <div>
                <label class="sbf-label">Original MRP</label>
                <input type="text" class="sbf-input slide-orig-price" value="₹4,999" placeholder="₹4,999" />
            </div>
            <div>
                <label class="sbf-label">0% EMI Text</label>
                <input type="text" class="sbf-input slide-emi" value="0% EMI ₹250/m" placeholder="0% EMI ₹250/m" />
            </div>
            <div>
                <label class="sbf-label">Disclaimer</label>
                <input type="text" class="sbf-input slide-disclaimer" value="*Incl. Bank Offer" placeholder="*Incl. Bank Offer" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 14px; margin-bottom: 12px;">
            <div>
                <label class="sbf-label">Target Link URL</label>
                <input type="text" class="sbf-input slide-target-url" value="/category/@activeSlug" placeholder="/category/@activeSlug" />
            </div>
            <div>
                <label class="sbf-label">Glow Ribbon Color</label>
                <div style="display: flex; gap: 6px; align-items: center;">
                    <input type="color" class="slide-glow-color" value="#f97316" style="width: 44px; height: 36px; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; padding: 2px;" />
                    <div style="display: flex; gap: 4px;">
                        <button type="button" onclick="setGlowColor(this, '#f97316')" style="background: #f97316; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;"></button>
                        <button type="button" onclick="setGlowColor(this, '#3b82f6')" style="background: #3b82f6; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;"></button>
                        <button type="button" onclick="setGlowColor(this, '#10b981')" style="background: #10b981; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;"></button>
                    </div>
                </div>
            </div>
            <div>
                <label class="sbf-label">Display Order</label>
                <input type="number" class="sbf-input slide-order" value="${newOrder}" style="width: 100%;" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 3fr 1fr; gap: 14px; align-items: center; background: #ffffff; padding: 12px 14px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <div>
                <label class="sbf-label" style="display: flex; justify-content: space-between;">
                    <span>3D Cutout Product Image</span>
                    <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11.5px; font-weight: 700; color: #ea580c;">
                        <input type="checkbox" class="slide-uploading-soon" checked style="accent-color: #ea580c;" />
                        Show "Uploading Soon" Tag
                    </label>
                </label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" class="sbf-input slide-img-url" value="/images/fashion-hub/uploading-soon-placeholder.svg" oninput="updateSlideImgPreview(this)" style="flex: 1;" />
                    <button type="button" onclick="triggerSlideUpload(this)" style="background: #2563eb; color: #ffffff; border: none; padding: 8px 14px; font-size: 12.5px; font-weight: 700; border-radius: 6px; cursor: pointer; white-space: nowrap;">
                        📁 Upload Image
                    </button>
                </div>
            </div>
            <div style="text-align: center;">
                <img src="/images/fashion-hub/uploading-soon-placeholder.svg" class="slide-img-preview" alt="Preview" style="height: 60px; max-width: 100%; object-fit: contain; border-radius: 6px; background: #0f172a; padding: 4px;" />
            </div>
        </div>
    `;

    container.appendChild(div);
    updateSlideNumbers();
}

async function saveCategorySliderConfig() {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    const payload = {
        CategorySlug: "@activeSlug",
        CategoryName: "@Model?.CategoryName",
        IsEnabled: document.getElementById('cfg_IsEnabled')?.checked ?? true,
        AutoPlay: document.getElementById('cfg_AutoPlay')?.checked ?? true,
        SlideIntervalSeconds: parseInt(document.getElementById('cfg_SlideInterval')?.value || '4', 10),
        TransitionDurationMs: parseInt(document.getElementById('cfg_Duration')?.value || '650', 10),
        Slides: []
    };

    const cardElements = document.querySelectorAll('.slide-card-item');
    cardElements.forEach((card, idx) => {
        const slideObj = {
            Id: card.querySelector('.slide-id')?.value || `s_${idx}`,
            CategorySlug: "@activeSlug",
            Title: card.querySelector('.slide-title')?.value || '',
            BadgeText: card.querySelector('.slide-badge')?.value || '',
            Rating: card.querySelector('.slide-rating')?.value || '4.8',
            Tagline: card.querySelector('.slide-tagline')?.value || '',
            PriceText: card.querySelector('.slide-price')?.value || '',
            OriginalPriceText: card.querySelector('.slide-orig-price')?.value || '',
            EmiBadgeText: card.querySelector('.slide-emi')?.value || '',
            OfferDisclaimer: card.querySelector('.slide-disclaimer')?.value || '',
            ThemeGlowColor: card.querySelector('.slide-glow-color')?.value || '#f97316',
            TargetUrl: card.querySelector('.slide-target-url')?.value || '/category/@activeSlug',
            ImageUrl: card.querySelector('.slide-img-url')?.value || '/images/fashion-hub/uploading-soon-placeholder.svg',
            IsUploadingSoon: card.querySelector('.slide-uploading-soon')?.checked ?? true,
            DisplayOrder: parseInt(card.querySelector('.slide-order')?.value || `${idx + 1}`, 10),
            IsActive: card.querySelector('.slide-is-active')?.checked ?? true
        };
        payload.Slides.push(slideObj);
    });

    try {
        const res = await fetch('/Admin/CategorySliders/Save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.success) {
            alert('✓ ' + data.message);
            window.location.reload();
        } else {
            alert('Save failed: ' + (data.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error saving slider: ' + err.message);
    }
}
</script>

