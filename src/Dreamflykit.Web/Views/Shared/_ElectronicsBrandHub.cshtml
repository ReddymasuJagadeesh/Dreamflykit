<!-- ============================================================
     JAVASCRIPT FOR DYNAMIC REACTIVE FILTERING & CART
============================================================ -->
<script>
    function toggleFilterGroup(el) {
        el.classList.toggle("collapsed");
        var list = el.nextElementSibling;
        if (list) {
            list.style.display = el.classList.contains("collapsed") ? "none" : "flex";
        }
    }

    function applyBrandFilters() {
        var checkedBoxes = document.querySelectorAll(".brand-filter-cb:checked");
        var activeFilters = {};

        checkedBoxes.forEach(function (cb) {
            var grp = cb.getAttribute("data-group");
            var val = cb.getAttribute("data-val");
            if (!activeFilters[grp]) {
                activeFilters[grp] = [];
            }
            activeFilters[grp].push(val);
        });

        renderActiveFilterTags(activeFilters);

        var cards = document.querySelectorAll(".dk-brand-prod-card");
        var visibleCount = 0;

        cards.forEach(function (card) {
            var match = true;

            for (var grp in activeFilters) {
                var selectedVals = activeFilters[grp];
                if (selectedVals.length === 0) continue;

                var cardVal = (card.getAttribute("data-" + grp) || "").toLowerCase();
                var cardPrice = parseFloat(card.getAttribute("data-price")) || 0;
                var cardDiscount = parseFloat(card.getAttribute("data-discount")) || 0;

                var grpMatched = false;

                if (grp === "price") {
                    for (var i = 0; i < selectedVals.length; i++) {
                        var pVal = selectedVals[i];
                        if (pVal === "under60k" && cardPrice < 60000) grpMatched = true;
                        else if (pVal === "60k-90k" && cardPrice >= 60000 && cardPrice <= 90000) grpMatched = true;
                        else if (pVal === "90k-140k" && cardPrice > 90000 && cardPrice <= 140000) grpMatched = true;
                        else if (pVal === "above140k" && cardPrice > 140000) grpMatched = true;
                        else if (pVal === "under6k" && cardPrice < 6000) grpMatched = true;
                        else if (pVal === "6k-16k" && cardPrice >= 6000 && cardPrice <= 16000) grpMatched = true;
                        else if (pVal === "above16k" && cardPrice > 16000) grpMatched = true;
                        else if (pVal === "under1500" && cardPrice < 1500) grpMatched = true;
                        else if (pVal === "1500-2500" && cardPrice >= 1500 && cardPrice <= 2500) grpMatched = true;
                        else if (pVal === "above2500" && cardPrice > 2500) grpMatched = true;
                    }
                } else if (grp === "discount") {
                    for (var i = 0; i < selectedVals.length; i++) {
                        var reqDiscount = parseFloat(selectedVals[i]) || 0;
                        if (cardDiscount >= reqDiscount) {
                            grpMatched = true;
                            break;
                        }
                    }
                } else {
                    for (var i = 0; i < selectedVals.length; i++) {
                        var sv = selectedVals[i];
                        if (cardVal.indexOf(sv) !== -1 || sv.indexOf(cardVal) !== -1) {
                            grpMatched = true;
                            break;
                        }
                    }
                }

                if (!grpMatched) {
                    match = false;
                    break;
                }
            }

            if (match) {
                card.style.display = "flex";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });

        // Update counts & empty state
        var lblCount = document.getElementById("lblVisibleCount");
        if (lblCount) lblCount.textContent = visibleCount;

        var emptyBox = document.getElementById("emptyBrandState");
        var gridBox = document.getElementById("brandProductsGrid");
        if (emptyBox && gridBox) {
            if (visibleCount === 0) {
                emptyBox.style.display = "block";
            } else {
                emptyBox.style.display = "none";
            }
        }
    }

    function renderActiveFilterTags(activeFilters) {
        var container = document.getElementById("activeFilterTags");
        if (!container) return;
        container.innerHTML = "";

        var hasAny = false;
        for (var grp in activeFilters) {
            var vals = activeFilters[grp];
            for (var i = 0; i < vals.length; i++) {
                hasAny = true;
                var val = vals[i];
                var pill = document.createElement("span");
                pill.className = "dk-active-pill";
                pill.innerHTML = '<span>' + val.toUpperCase() + '</span><button type="button" class="dk-active-remove" onclick="removeBrandFilter(\'' + grp + '\', \'' + val + '\')">✕</button>';
                container.appendChild(pill);
            }
        }
    }

    function removeBrandFilter(grp, val) {
        var cb = document.querySelector('.brand-filter-cb[data-group="' + grp + '"][data-val="' + val + '"]');
        if (cb) {
            cb.checked = false;
            applyBrandFilters();
        }
    }

    function clearAllBrandFilters() {
        var cbs = document.querySelectorAll(".brand-filter-cb");
        cbs.forEach(function (cb) { cb.checked = false; });
        applyBrandFilters();
    }

    function sortBrandProducts(opt) {
        var grid = document.getElementById("brandProductsGrid");
        if (!grid) return;
        var cards = Array.from(grid.querySelectorAll(".dk-brand-prod-card"));

        cards.sort(function (a, b) {
            var priceA = parseFloat(a.getAttribute("data-price")) || 0;
            var priceB = parseFloat(b.getAttribute("data-price")) || 0;
            var ratingA = parseFloat(a.getAttribute("data-rating")) || 0;
            var ratingB = parseFloat(b.getAttribute("data-rating")) || 0;
            var discountA = parseFloat(a.getAttribute("data-discount")) || 0;
            var discountB = parseFloat(b.getAttribute("data-discount")) || 0;

            if (opt === "price-asc") return priceA - priceB;
            if (opt === "price-desc") return priceB - priceA;
            if (opt === "rating-desc") return ratingB - ratingA;
            if (opt === "discount-desc") return discountB - discountA;
            return 0; // relevance
        });

        cards.forEach(function (card) { grid.appendChild(card); });
    }

    function handleBrandAddToCart(prodId, prodName, price, btn) {
        var originalHtml = btn.innerHTML;
        btn.innerHTML = '<span>Adding...</span>';
        btn.disabled = true;

        setTimeout(function () {
            btn.innerHTML = '<span>✓ Added!</span>';
            btn.style.background = "#10b981";

            showBrandToast(prodName);

            // Update global cart badge if present
            var badge = document.querySelector(".dk-cart-badge, .dk-header-action-badge");
            if (badge) {
                var current = parseInt(badge.textContent, 10) || 0;
                badge.textContent = current + 1;
                badge.style.display = "inline-flex";
            }

            setTimeout(function () {
                btn.innerHTML = originalHtml;
                btn.style.background = "";
                btn.disabled = false;
            }, 1800);
        }, 400);
    }

    function showBrandToast(name) {
        var toast = document.getElementById("brandCartToast");
        var title = document.getElementById("toastTitle");
        if (title) title.textContent = name;
        if (toast) {
            toast.style.display = "flex";
            setTimeout(function () {
                toast.style.display = "none";
            }, 4000);
        }
    }
</script>

