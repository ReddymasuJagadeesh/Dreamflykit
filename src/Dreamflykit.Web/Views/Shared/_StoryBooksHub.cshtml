<script>
(function() {
    // ----------------------------------------------------
    // Tab Navigation (No Page Reload)
    // ----------------------------------------------------
    window.switchNavTab = function(targetId) {
        if (!targetId) return;

        const tabButtons = document.querySelectorAll('.sbf-tab-btn');
        const tabPanes = document.querySelectorAll('.sbf-tab-pane');
        const activePill = document.getElementById('sbf-active-pill');

        tabButtons.forEach(b => {
            if (b.getAttribute('data-tab') === targetId) {
                b.classList.add('active');
                b.setAttribute('aria-selected', 'true');
            } else {
                b.classList.remove('active');
                b.setAttribute('aria-selected', 'false');
            }
        });

        tabPanes.forEach(p => {
            if (p.id === targetId) {
                p.classList.add('active');
            } else {
                p.classList.remove('active');
            }
        });

        // Update active indicator
        if (activePill) {
            if (targetId === 'sbf-home') activePill.innerText = 'Viewing: Home Spotlight';
            else if (targetId === 'sbf-storybooks') activePill.innerText = 'Viewing: Story Books & Journals';
            else if (targetId === 'sbf-newpopular') activePill.innerText = 'Viewing: New & Popular';
            else if (targetId === 'sbf-languages') activePill.innerText = 'Viewing: Browse by Language';
        }

        // Scroll smoothly to top of hub
        const hub = document.getElementById('booksflix-hub');
        if (hub) {
            hub.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    };

    // ----------------------------------------------------
    // Global Journal Selector (Under Navbar Left Side)
    // ----------------------------------------------------
    window.onGlobalJournalSelect = function(selectedGenre) {
        // Automatically switch to Story Books tab to show the journal content
        switchNavTab('sbf-storybooks');

        const grid = document.getElementById('sbf-genre-grid');
        const emptyState = document.getElementById('sbf-genre-empty');
        const statusBadge = document.getElementById('sbf-genre-status-badge');
        const heading = document.getElementById('sbf-pane-genre-heading');
        const activePill = document.getElementById('sbf-active-pill');

        // Update Story Books Hero Banner dynamically for selected journal
        const sbTitle = document.getElementById('sbf-sb-title');
        const sbSynopsis = document.getElementById('sbf-sb-synopsis');
        const sbSub = document.getElementById('sbf-sb-badge-sub');

        const selectEl = document.getElementById('sbf-global-journal-select');
        const selectedText = selectEl.options[selectEl.selectedIndex]?.text || 'All Journals & Books';

        if (selectedGenre !== 'all') {
            if (sbTitle) sbTitle.innerText = selectedText.replace(/^[^\w\s]+/, '').trim() + ' Archive';
            if (sbSynopsis) sbSynopsis.innerText = `Curated student edition literature, research volumes, and verified university publications for ${selectedText}.`;
            if (sbSub) sbSub.innerText = 'FEATURED JOURNAL COLLECTION';
            if (heading) heading.innerText = selectedText;
            if (activePill) activePill.innerText = 'Journal: ' + selectedText.replace(/^[^\w\s]+/, '').trim();
        } else {
            if (sbTitle) sbTitle.innerText = '@sbBanner.Title';
            if (sbSynopsis) sbSynopsis.innerText = '@sbBanner.Subtitle';
            if (sbSub) sbSub.innerText = '@sbBanner.TagBadge';
            if (heading) heading.innerText = 'Story Books & Academic Journals';
            if (activePill) activePill.innerText = 'Viewing: Story Books & Journals';
        }

        if (!grid) return;
        const items = grid.querySelectorAll('.sbf-grid-item');
        let visibleCount = 0;

        items.forEach(item => {
            const genre = item.getAttribute('data-genre') || '';
            if (selectedGenre === 'all' || genre.toLowerCase() === selectedGenre.toLowerCase()) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        if (statusBadge) {
            statusBadge.innerText = `Showing ${visibleCount} books`;
        }

        if (emptyState) {
            emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        showToast(`Showing collection for: ${selectedText.replace(/^[^\w\s]+/, '').trim()}`);
    };

    window.resetJournalFilter = function() {
        const select = document.getElementById('sbf-global-journal-select');
        if (select) {
            select.value = 'all';
            window.onGlobalJournalSelect('all');
        }
    };

    // ----------------------------------------------------
    // Shelf Horizontal Scroll
    // ----------------------------------------------------
    window.scrollShelf = function(btn, direction) {
        const wrapper = btn.closest('.sbf-carousel-wrapper');
        if (!wrapper) return;
        const track = wrapper.querySelector('.sbf-carousel-track');
        if (!track) return;
        const scrollAmount = track.clientWidth * 0.75 * direction;
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    };

    window.scrollShelfIntoView = function(targetId) {
        const target = document.getElementById(targetId);
        if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    };

    // ----------------------------------------------------
    // Language & Preference Filter (Browse by Language Tab)
    // ----------------------------------------------------
    window.filterLanguageGrid = function() {
        const prefSelect = document.getElementById('sbf-pref-select');
        const langSelect = document.getElementById('sbf-lang-select');
        const grid = document.getElementById('sbf-language-grid');
        const emptyState = document.getElementById('sbf-lang-empty');

        if (!grid) return;

        const selectedPref = prefSelect ? prefSelect.value.toLowerCase() : 'all';
        const selectedLang = langSelect ? langSelect.value.toLowerCase() : 'all';

        const items = grid.querySelectorAll('.sbf-lang-card-item');
        let visibleCount = 0;

        items.forEach(item => {
            const itemLang = (item.getAttribute('data-lang') || '').toLowerCase();
            const itemPref = (item.getAttribute('data-pref') || '').toLowerCase();

            const matchLang = (selectedLang === 'all' || itemLang === selectedLang);
            const matchPref = (selectedPref === 'all' || itemPref === selectedPref);

            if (matchLang && matchPref) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        if (emptyState) {
            emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
    };

    window.resetLanguageFilters = function() {
        const prefSelect = document.getElementById('sbf-pref-select');
        const langSelect = document.getElementById('sbf-lang-select');
        if (prefSelect) prefSelect.value = 'all';
        if (langSelect) langSelect.value = 'all';
        window.filterLanguageGrid();
    };

    // ----------------------------------------------------
    // Live Search in Story Books Hub
    // ----------------------------------------------------
    const searchInput = document.getElementById('sbf-search-input');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const term = this.value.trim().toLowerCase();
            const allCards = document.querySelectorAll('.sbf-book-card');

            if (!term) {
                allCards.forEach(card => card.parentElement.style.display = '');
                return;
            }

            allCards.forEach(card => {
                const title = (card.getAttribute('data-title') || card.querySelector('.sbf-card-title')?.innerText || '').toLowerCase();
                const author = (card.getAttribute('data-author') || card.querySelector('.sbf-card-author')?.innerText || '').toLowerCase();
                const parent = card.parentElement;

                if (title.includes(term) || author.includes(term)) {
                    parent.style.display = '';
                } else {
                    parent.style.display = 'none';
                }
            });
        });
    }

    // ----------------------------------------------------
    // Modal Popup Handler
    // ----------------------------------------------------
    window.openBookModal = function(title, author, synopsis, imgUrl, price, origPrice, rating, genre, lang, pages) {
        const modal = document.getElementById('sbf-modal');
        if (!modal) return;

        document.getElementById('modal-title').innerText = title || 'Book Details';
        document.getElementById('modal-author').innerText = 'By ' + (author || 'Author');
        document.getElementById('modal-synopsis').innerText = synopsis || 'Exclusive literature and scholarly insights published for global students.';
        document.getElementById('modal-rating').innerText = '★ ' + (rating || '4.8');
        document.getElementById('modal-pages').innerText = pages || '280 Pages';
        document.getElementById('modal-lang').innerText = lang || 'English';
        document.getElementById('modal-genre').innerText = genre || 'Academic Fiction';
        document.getElementById('modal-price').innerText = price || '499';

        const heroBg = document.getElementById('modal-hero-bg');
        if (heroBg) {
            heroBg.style.backgroundImage = `linear-gradient(180deg, rgba(20,20,20,.4) 0%, #181818 100%), url('${imgUrl || '/images/fashion-hub/uploading-soon-placeholder.svg'}')`;
        }

        const cartBtn = document.getElementById('modal-cart-btn');
        if (cartBtn) {
            cartBtn.onclick = function() {
                addHubBookToCart(title, price);
                closeBookModal();
            };
        }

        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
    };

    window.closeBookModal = function(e) {
        const modal = document.getElementById('sbf-modal');
        if (modal) {
            modal.classList.remove('open');
            document.body.style.overflow = '';
        }
    };

    // Close modal on Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeBookModal();
        }
    });

    // ----------------------------------------------------
    // Wishlist Toggle
    // ----------------------------------------------------
    window.toggleWishlist = function(btn, title) {
        if (btn.classList.contains('active')) {
            btn.classList.remove('active');
            btn.innerText = '♡';
            showToast(`Removed "${title}" from Wishlist`);
        } else {
            btn.classList.add('active');
            btn.innerText = '♥';
            btn.style.color = '#E50914';
            showToast(`Added "${title}" to Wishlist`);
        }
    };

    // ----------------------------------------------------
    // Add to Cart
    // ----------------------------------------------------
    window.addHubBookToCart = function(title, price) {
        showToast(`✓ Added "${title}" (₹${price}) to your Cart!`);
    };

    // ----------------------------------------------------
    // Toast Notification Utility
    // ----------------------------------------------------
    function showToast(msg) {
        const toast = document.getElementById('sbf-toast');
        if (!toast) return;
        toast.innerText = msg;
        toast.classList.add('show');
        setTimeout(() => {
            toast.classList.remove('show');
        }, 3200);
    }
})();
</script>
