# ==============================================================================
# DREAMFLYKIT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' on your Hostinger VPS and replace all placeholders
# with your actual production credentials. NEVER commit '.env' to git!
# ==============================================================================

# Application & Hosting
ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# PostgreSQL Production Database
POSTGRES_DB=dreamflykit
POSTGRES_USER=dreamfly_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_PASSWORD
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=dreamflykit;Username=dreamfly_user;Password=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_PASSWORD

# Redis Distributed Caching (L2 Cache)
ConnectionStrings__Redis=redis:6379,abortConnect=false

# Cashfree Payment Gateway (Production Mode)
Cashfree__AppId=YOUR_CASHFREE_PROD_APP_ID
Cashfree__SecretKey=YOUR_CASHFREE_PROD_SECRET_KEY
Cashfree__Environment=PRODUCTION

# SMTP Email Dispatching (SendGrid / Hostinger Titan / Amazon SES)
EmailSettings__SmtpHost=smtp.hostinger.com
EmailSettings__SmtpPort=587
EmailSettings__Username=noreply@dreamflykit.com
EmailSettings__Password=YOUR_SMTP_PASSWORD
EmailSettings__EnableSsl=true
EmailSettings__FromEmail=noreply@dreamflykit.com
EmailSettings__FromName=Dreamflykit

# Media Storage & AWS S3 / Cloudflare R2
Media__CdnBaseUrl=https://cdn.dreamflykit.com
Media__BucketName=dreamflykit-production-media
Media__AwsRegion=ap-south-1
AwsS3__BucketName=dreamflykit-production-media
AwsS3__Region=ap-south-1
AwsS3__AccessKeyId=YOUR_AWS_ACCESS_KEY_ID
AwsS3__SecretAccessKey=YOUR_AWS_SECRET_ACCESS_KEY
AwsS3__SessionToken=
