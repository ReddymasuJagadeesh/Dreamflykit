<!-- ============================================================
     ADMIN SCRIPTS & AJAX
============================================================ -->
<script>
    function switchElecTab(tabName, btn) {
        document.querySelectorAll('.dk-hub-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.dk-hub-tab-pane').forEach(p => p.style.display = 'none');
        btn.classList.add('active');
        const target = document.getElementById('tab_' + tabName);
        if (target) target.style.display = 'block';
    }

    function updateCatSoonBadge(index) {
        const checked = document.getElementById('cat_soon_' + index).checked;
        const badge = document.getElementById('cat_preview_badge_' + index);
        const emoji = document.getElementById('cat_preview_emoji_' + index);
        const img = document.getElementById('cat_preview_img_' + index);
        if (badge) {
            badge.style.display = checked ? 'block' : 'none';
        }
    }

    function updateCatImgPreview(index, url) {
        const img = document.getElementById('cat_preview_img_' + index);
        const emoji = document.getElementById('cat_preview_emoji_' + index);
        const badge = document.getElementById('cat_preview_badge_' + index);

        if (url && !url.includes('uploading-soon')) {
            if (img) {
                img.src = url;
                img.style.display = 'block';
            }
            if (emoji) emoji.style.display = 'none';
            if (badge) badge.style.display = 'none';
        } else {
            if (img) img.style.display = 'none';
            if (emoji) emoji.style.display = 'block';
            if (badge) badge.style.display = 'block';
        }
    }

    async function uploadCategoryImg(index, fileInput) {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];
        const status = document.getElementById('cat_upload_status_' + index);
        if (status) status.innerText = '⏳ Uploading...';

        const formData = new FormData();
        formData.append('file', file);
        formData.append('targetField', 'cat_' + index);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const resp = await fetch('/Admin/ElectronicsHub/UploadImage', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token || ''
                },
                body: formData
            });

            const res = await resp.json();
            if (res.success && res.url) {
                document.getElementById('cat_img_' + index).value = res.url;
                updateCatImgPreview(index, res.url);
                if (status) status.innerText = '✓ Uploaded!';
                const soonChk = document.getElementById('cat_soon_' + index);
                if (soonChk) soonChk.checked = false;
            } else {
                alert('Upload failed: ' + (res.message || 'Unknown error'));
                if (status) status.innerText = 'Upload failed';
            }
        } catch (err) {
            console.error(err);
            alert('Upload error: ' + err.message);
            if (status) status.innerText = 'Error';
        }
    }

    async function uploadHeroImg(fileInput) {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];
        const status = document.getElementById('hero_upload_status');
        if (status) status.innerText = '⏳ Uploading...';

        const formData = new FormData();
        formData.append('file', file);
        formData.append('targetField', 'hero');

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const resp = await fetch('/Admin/ElectronicsHub/UploadImage', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token || ''
                },
                body: formData
            });

            const res = await resp.json();
            if (res.success && res.url) {
                document.getElementById('hero_image_url').value = res.url;
                document.getElementById('hero_preview_img').src = res.url;
                const heroSoon = document.getElementById('hero_soon');
                if (heroSoon) heroSoon.checked = false;
                if (status) status.innerText = '✓ Hero Image Uploaded!';
            } else {
                alert('Hero upload failed: ' + (res.message || 'Unknown error'));
                if (status) status.innerText = 'Upload failed';
            }
        } catch (err) {
            console.error(err);
            alert('Hero upload error: ' + err.message);
            if (status) status.innerText = 'Error';
        }
    }

    function removeCategoryCard(index) {
        if (confirm('Are you sure you want to delete this category card?')) {
            const row = document.getElementById('cat_card_row_' + index);
            if (row) row.remove();
        }
    }

    function removeProductCard(index) {
        if (confirm('Delete this curated product?')) {
            const card = document.getElementById('prod_card_' + index);
            if (card) card.remove();
        }
    }

    function addNewCategoryCard() {
        const container = document.getElementById('elecCategoryCardsList');
        const count = container.querySelectorAll('.elec-cat-admin-card').length;
        const newIndex = count;

        const cardHtml = `
        <div class="elec-cat-admin-card" id="cat_card_row_${newIndex}" data-index="${newIndex}" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; box-shadow: 0 2px 6px rgba(0,0,0,0.03); display: flex; flex-direction: column; gap: 14px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-weight: 800; font-size: 14px; color: #0f172a;">#${newIndex + 1}</span>
                    <input type="text" id="cat_emoji_${newIndex}" value="⚡" style="width: 38px; text-align: center; font-size: 18px; border: 1px solid #cbd5e1; border-radius: 6px; padding: 2px;" />
                    <span style="font-weight: 700; font-size: 13.5px; color: #0284c7;" id="cat_preview_title_${newIndex}">New Tech Category</span>
                </div>
                <button type="button" onclick="removeCategoryCard(${newIndex})" style="background: none; border: none; color: #ef4444; font-size: 18px; cursor: pointer;">🗑️</button>
            </div>
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 10px;">
                <div>
                    <label class="dk-admin-label">Name</label>
                    <input type="text" id="cat_name_${newIndex}" class="dk-admin-input" value="New Category" oninput="document.getElementById('cat_preview_title_${newIndex}').innerText = this.value;" />
                </div>
                <div>
                    <label class="dk-admin-label">Slug</label>
                    <input type="text" id="cat_slug_${newIndex}" class="dk-admin-input" value="new-category" />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div>
                    <label class="dk-admin-label">Display Order</label>
                    <input type="number" id="cat_order_${newIndex}" class="dk-admin-input" value="${newIndex + 1}" />
                </div>
                <div style="display: flex; flex-direction: column; justify-content: center; padding-top: 18px;">
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #0f172a; cursor: pointer;">
                        <input type="checkbox" id="cat_soon_${newIndex}" checked onchange="updateCatSoonBadge(${newIndex})" />
                        <span>Uploading Soon Badge</span>
                    </label>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 100px 1fr; gap: 14px; align-items: center; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid #f1f5f9;">
                <div id="cat_box_preview_${newIndex}" style="width: 100px; height: 100px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden;">
                    <span id="cat_preview_emoji_${newIndex}" style="font-size: 30px; margin-bottom: 4px;">⚡</span>
                    <span id="cat_preview_badge_${newIndex}" style="font-size: 8px; font-weight: 800; background: #e0f2fe; color: #0369a1; padding: 2px 4px; border-radius: 4px; text-transform: uppercase;">Uploading Soon</span>
                    <img id="cat_preview_img_${newIndex}" src="" style="display: none; width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <div>
                    <label class="dk-admin-label">Image URL / Admin Upload</label>
                    <div style="display: flex; gap: 6px; margin-bottom: 8px;">
                        <input type="text" id="cat_img_${newIndex}" class="dk-admin-input" value="/images/fashion-hub/uploading-soon-placeholder.svg" style="font-size: 12px;" oninput="updateCatImgPreview(${newIndex}, this.value)" />
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="file" id="cat_file_${newIndex}" accept="image/*" style="display: none;" onchange="uploadCategoryImg(${newIndex}, this)" />
                        <button type="button" onclick="document.getElementById('cat_file_${newIndex}').click()" class="dk-btn" style="background: #0284c7; color: #fff; border: none; font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: 6px; cursor: pointer;">
                            📁 Upload Image
                        </button>
                        <span id="cat_upload_status_${newIndex}" style="font-size: 11px; color: #64748b;">JPG, PNG, WEBP</span>
                    </div>
                </div>
            </div>
            <input type="hidden" id="cat_id_${newIndex}" value="" />
            <input type="hidden" id="cat_active_${newIndex}" value="true" />
        </div>`;

        container.insertAdjacentHTML('beforeend', cardHtml);
    }

    function selectSubPageAdmin(slug, btn) {
        document.querySelectorAll('.dk-subpage-btn').forEach(b => {
            b.style.background = '#ffffff';
            b.style.color = '#334155';
            b.style.borderColor = '#cbd5e1';
            b.classList.remove('active');
        });
        document.querySelectorAll('.sub-page-editor').forEach(e => e.style.display = 'none');
        btn.style.background = '#0284c7';
        btn.style.color = '#ffffff';
        btn.style.borderColor = '#0284c7';
        btn.classList.add('active');

        const editor = document.getElementById('sub_editor_' + slug);
        if (editor) editor.style.display = 'block';
    }

    async function uploadSubHeroImage(slug, fileInput) {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];
        const status = document.getElementById('sub_hero_status_' + slug);
        if (status) status.innerText = '⏳ Uploading...';

        const formData = new FormData();
        formData.append('file', file);
        formData.append('targetField', 'sub_hero_' + slug);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const resp = await fetch('/Admin/ElectronicsHub/UploadImage', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token || '' },
                body: formData
            });

            const res = await resp.json();
            if (res.success && res.url) {
                document.getElementById('sub_hero_img_' + slug).value = res.url;
                document.getElementById('sub_hero_preview_' + slug).src = res.url;
                const soonChk = document.getElementById('sub_hero_soon_' + slug);
                if (soonChk) soonChk.checked = false;
                if (status) status.innerText = '✓ Uploaded!';
            } else {
                alert('Upload failed: ' + (res.message || 'Unknown error'));
                if (status) status.innerText = 'Failed';
            }
        } catch (err) {
            console.error(err);
            alert('Upload error: ' + err.message);
            if (status) status.innerText = 'Error';
        }
    }

    async function uploadBrandLogoImg(slug, index, fileInput) {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];

        const formData = new FormData();
        formData.append('file', file);
        formData.append('targetField', 'brand_' + slug + '_' + index);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const resp = await fetch('/Admin/ElectronicsHub/UploadImage', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token || '' },
                body: formData
            });

            const res = await resp.json();
            if (res.success && res.url) {
                document.getElementById('brand_logo_' + slug + '_' + index).value = res.url;
                const soonChk = document.getElementById('brand_soon_' + slug + '_' + index);
                if (soonChk) soonChk.checked = false;
                alert('✓ Brand logo uploaded!');
            } else {
                alert('Upload failed: ' + (res.message || 'Unknown error'));
            }
        } catch (err) {
            console.error(err);
            alert('Upload error: ' + err.message);
        }
    }

    function removeBrandCard(slug, index) {
        if (confirm('Delete this brand card?')) {
            const row = document.getElementById('brand_row_' + slug + '_' + index);
            if (row) row.remove();
        }
    }

    function addNewBrandCard(slug) {
        const container = document.getElementById('brands_list_' + slug);
        const count = container.querySelectorAll('.brand-card-' + slug).length;
        const newIndex = count;

        const cardHtml = `
        <div class="brand-item-card brand-card-${slug}" id="brand_row_${slug}_${newIndex}" data-index="${newIndex}" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 800; font-size: 13px; color: #0284c7;" id="brand_title_lbl_${slug}_${newIndex}">#${newIndex + 1} New Brand</span>
                <button type="button" onclick="removeBrandCard('${slug}', ${newIndex})" style="background: none; border: none; color: #ef4444; font-size: 16px; cursor: pointer;">🗑️</button>
            </div>
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px;">
                <div>
                    <label class="dk-admin-label">Brand Name</label>
                    <input type="text" id="brand_name_${slug}_${newIndex}" class="dk-admin-input" value="Brand Name" oninput="document.getElementById('brand_title_lbl_${slug}_${newIndex}').innerText = '#' + (${newIndex + 1}) + ' ' + this.value;" />
                </div>
                <div>
                    <label class="dk-admin-label">Slug</label>
                    <input type="text" id="brand_slug_${slug}_${newIndex}" class="dk-admin-input" value="brand" />
                </div>
            </div>
            <div>
                <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #0f172a; cursor: pointer;">
                    <input type="checkbox" id="brand_soon_${slug}_${newIndex}" checked />
                    <span>Show "UPLOADING SOON" Badge</span>
                </label>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <input type="text" id="brand_logo_${slug}_${newIndex}" class="dk-admin-input" value="/images/fashion-hub/uploading-soon-placeholder.svg" style="font-size: 11px;" />
                <input type="file" id="brand_file_${slug}_${newIndex}" accept="image/*" style="display: none;" onchange="uploadBrandLogoImg('${slug}', ${newIndex}, this)" />
                <button type="button" onclick="document.getElementById('brand_file_${slug}_${newIndex}').click()" class="dk-btn" style="background: #0284c7; color: #fff; border: none; font-size: 11px; font-weight: 700; padding: 5px 10px; border-radius: 4px; cursor: pointer; white-space: nowrap;">
                    📁 Logo
                </button>
            </div>
            <input type="hidden" id="brand_id_${slug}_${newIndex}" value="" />
            <input type="hidden" id="brand_order_${slug}_${newIndex}" value="${newIndex + 1}" />
        </div>`;

        container.insertAdjacentHTML('beforeend', cardHtml);
    }

    async function saveElectronicsHubConfig() {
        const btn = document.getElementById('btnSaveElectronicsTop');
        if (btn) btn.innerText = '⏳ Saving...';

        // Build Payload
        const payload = {
            ThemeSettings: {
                StoreTitle: document.getElementById('theme_store_title')?.value || 'Dreamflykit Tech • Electronics Store',
                AccentColor: document.getElementById('theme_accent_color')?.value || '#0284c7',
                PrimaryColor: '#0f172a',
                FestivalThemeEnabled: document.getElementById('theme_festival_enabled')?.checked || false,
                FestivalThemeName: document.getElementById('theme_festival_name')?.value || 'Student Tech Fest 2026',
                FestivalBannerUrl: ''
            },
            HeroBanner: {
                IsEnabled: document.getElementById('hero_enabled')?.checked ?? true,
                Title: document.getElementById('hero_title')?.value || 'Student Electronics for',
                TitleHighlight: document.getElementById('hero_title_highlight')?.value || 'Every Global Campus',
                Subtitle: document.getElementById('hero_subtitle')?.value || '',
                ImageUrl: document.getElementById('hero_image_url')?.value || '/images/hero/hero-electronics.webp',
                IsUploadingSoon: document.getElementById('hero_soon')?.checked ?? true,
                BannerHeight: parseInt(document.getElementById('hero_height')?.value || '440', 10),
                TitleColor: document.getElementById('hero_color_title')?.value || '#063f91',
                TitleHighlightColor: document.getElementById('hero_color_highlight')?.value || '#0284c7',
                SubtitleColor: document.getElementById('hero_color_subtitle')?.value || '#334155',
                BadgeBgColor: 'rgba(255, 255, 255, 0.94)',
                BadgeTextColor: '#0f172a',
                OverlayGradient: 'linear-gradient(90deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.45) 45%, rgba(255, 255, 255, 0.15) 70%, rgba(255, 255, 255, 0.65) 100%)',
                SlideIntervalSeconds: 5,
                Slides: [],
                Badges: [
                    { Id: 'b1', Label: '110V–240V Universal Power', Icon: 'zap', IsActive: true },
                    { Id: 'b2', Label: '100% Genuine Certified Tech', Icon: 'shield', IsActive: true },
                    { Id: 'b3', Label: 'International Student Warranty', Icon: 'award', IsActive: true },
                    { Id: 'b4', Label: 'Loved by 10K+ Students', Icon: 'users', IsActive: true }
                ],
                RightCard: {
                    Title: 'Smart Tech.',
                    TitleHighlight: 'Campuses Abroad.',
                    Features: [
                        { Id: 'f1', Title: 'Worldwide Voltage Tested', Icon: 'zap', IsActive: true },
                        { Id: 'f2', Title: 'Lightweight & Carry-On Ready', Icon: 'feather', IsActive: true },
                        { Id: 'f3', Title: 'Pre-Activated Student SIMs', Icon: 'sim', IsActive: true }
                    ]
                }
            },
            CategoriesSection: {
                IsEnabled: true,
                Title: document.getElementById('cat_section_title')?.value || 'Shop by Category',
                ViewAllText: document.getElementById('cat_section_view_all_text')?.value || 'View All Categories →',
                ViewAllUrl: document.getElementById('cat_section_view_all_url')?.value || '/products?category=electronics',
                Categories: []
            },
            CuratedProductsSection: {
                IsEnabled: true,
                Title: document.getElementById('picks_section_title')?.value || 'Top Tech Picks for Students',
                ViewAllText: 'View All Tech Essentials →',
                ViewAllUrl: '/products?category=electronics',
                Products: []
            },
            TrustBadgesSection: {
                IsEnabled: true,
                Badges: []
            },
            BottomBanner: {
                IsEnabled: true,
                Title: document.getElementById('bottom_title')?.value || 'Need Complete Tech Packing for Your Destination?',
                Subtitle: document.getElementById('bottom_sub')?.value || 'Explore curated tech bundles tested and approved by students in 50+ universities worldwide.',
                ButtonText: document.getElementById('bottom_btn_text')?.value || 'Browse Tech Catalog',
                ButtonUrl: document.getElementById('bottom_btn_url')?.value || '/products?category=electronics',
                ImageUrl: '/images/hero/hero-electronics.webp',
                IsUploadingSoon: true
            },
            SubcategoryPages: []
        };

        // Collect Categories
        document.querySelectorAll('.elec-cat-admin-card').forEach((card, idx) => {
            const i = card.getAttribute('data-index');
            payload.CategoriesSection.Categories.push({
                Id: document.getElementById('cat_id_' + i)?.value || 'c' + (idx + 1),
                Name: document.getElementById('cat_name_' + i)?.value || 'Category ' + (idx + 1),
                Slug: document.getElementById('cat_slug_' + i)?.value || 'cat-' + (idx + 1),
                Emoji: document.getElementById('cat_emoji_' + i)?.value || '⚡',
                ImageUrl: document.getElementById('cat_img_' + i)?.value || '/images/fashion-hub/uploading-soon-placeholder.svg',
                DisplayOrder: parseInt(document.getElementById('cat_order_' + i)?.value || (idx + 1), 10),
                IsActive: true,
                IsUploadingSoon: document.getElementById('cat_soon_' + i)?.checked ?? true
            });
        });

        // Collect Products
        document.querySelectorAll('.elec-prod-admin-card').forEach((card, idx) => {
            const p = card.getAttribute('data-index');
            payload.CuratedProductsSection.Products.push({
                Id: document.getElementById('prod_id_' + p)?.value || 'p' + (idx + 1),
                Name: document.getElementById('prod_name_' + p)?.value || 'Product ' + (idx + 1),
                Slug: 'product-' + (idx + 1),
                CategoryName: document.getElementById('prod_cat_' + p)?.value || 'Tech Category',
                ProductUrl: document.getElementById('prod_url_' + p)?.value || '/category/electronics',
                ImageUrl: document.getElementById('prod_img_' + p)?.value || '/images/fashion-hub/uploading-soon-placeholder.svg',
                Price: parseFloat(document.getElementById('prod_price_' + p)?.value || '0'),
                OriginalPrice: parseFloat(document.getElementById('prod_orig_' + p)?.value || '0'),
                DiscountPercent: parseInt(document.getElementById('prod_disc_' + p)?.value || '0', 10),
                Rating: 4.8,
                ReviewCount: 120,
                IsActive: true,
                InStock: true,
                Badge: document.getElementById('prod_badge_' + p)?.value || 'TOP DEAL'
            });
        });

        // Collect Subcategory Pages & Brands
        document.querySelectorAll('.sub-page-editor').forEach(editor => {
            const slug = editor.id.replace('sub_editor_', '');
            const pageId = document.getElementById('sub_page_id_' + slug)?.value || slug;
            const pageName = document.getElementById('sub_page_name_' + slug)?.value || slug;
            const pageEmoji = document.getElementById('sub_page_emoji_' + slug)?.value || '⚡';

            const heroTitle = document.getElementById('sub_hero_title_' + slug)?.value || '';
            const heroHighlight = document.getElementById('sub_hero_highlight_' + slug)?.value || '';
            const heroSub = document.getElementById('sub_hero_sub_' + slug)?.value || '';
            const heroImg = document.getElementById('sub_hero_img_' + slug)?.value || '/images/hero/hero-electronics.webp';
            const heroSoon = document.getElementById('sub_hero_soon_' + slug)?.checked ?? true;

            const brandsTitle = document.getElementById('sub_brands_title_' + slug)?.value || 'Shop by Brands';
            const brandsSub = document.getElementById('sub_brands_sub_' + slug)?.value || '';

            const brandsList = [];
            editor.querySelectorAll('.brand-card-' + slug).forEach((bCard, bIdx) => {
                const b = bCard.getAttribute('data-index');
                brandsList.push({
                    Id: document.getElementById('brand_id_' + slug + '_' + b)?.value || 'b_' + slug + '_' + (bIdx + 1),
                    Name: document.getElementById('brand_name_' + slug + '_' + b)?.value || 'Brand ' + (bIdx + 1),
                    Slug: document.getElementById('brand_slug_' + slug + '_' + b)?.value || 'brand-' + (bIdx + 1),
                    LogoUrl: document.getElementById('brand_logo_' + slug + '_' + b)?.value || '/images/fashion-hub/uploading-soon-placeholder.svg',
                    IsUploadingSoon: document.getElementById('brand_soon_' + slug + '_' + b)?.checked ?? true,
                    TargetUrl: '',
                    DisplayOrder: parseInt(document.getElementById('brand_order_' + slug + '_' + b)?.value || (bIdx + 1), 10),
                    IsActive: true
                });
            });

            payload.SubcategoryPages.push({
                Id: pageId,
                CategorySlug: slug,
                CategoryName: pageName,
                Emoji: pageEmoji,
                HeroBanner: {
                    IsEnabled: true,
                    Title: heroTitle,
                    TitleHighlight: heroHighlight,
                    Subtitle: heroSub,
                    ImageUrl: heroImg,
                    IsUploadingSoon: heroSoon,
                    BannerHeight: 380,
                    TitleColor: '#063f91',
                    TitleHighlightColor: '#0284c7',
                    SubtitleColor: '#334155'
                },
                ShopByBrands: {
                    IsEnabled: true,
                    Title: brandsTitle,
                    Subtitle: brandsSub,
                    Brands: brandsList
                },
                CuratedProducts: []
            });
        });

        // Collect Trust Badges
        for (let t = 0; t < 4; t++) {
            const title = document.getElementById('trust_title_' + t)?.value;
            if (title) {
                payload.TrustBadgesSection.Badges.push({
                    Id: 'tb' + (t + 1),
                    Title: title,
                    Subtitle: document.getElementById('trust_sub_' + t)?.value || '',
                    Icon: document.getElementById('trust_icon_' + t)?.value || 'shield'
                });
            }
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const resp = await fetch('/Admin/ElectronicsHub/Save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || '',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            });

            const res = await resp.json();
            if (res.success) {
                alert('✓ ' + (res.message || 'Electronics Hub settings saved successfully!'));
            } else {
                alert('Error saving settings: ' + (res.message || 'Unknown error'));
            }
        } catch (e) {
            console.error(e);
            alert('Failed to save Electronics Hub settings: ' + e.message);
        } finally {
            if (btn) btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Save All Changes`;
        }
    }
</script>

