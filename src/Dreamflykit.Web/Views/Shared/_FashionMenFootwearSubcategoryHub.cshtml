@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.FashionHub ?? Dreamflykit.Application.FashionHub.Models.FashionHubDto.CreateDefault();
    var footwear = hub.MenFootwear ?? Dreamflykit.Application.FashionHub.Models.FashionMenFootwearDto.CreateDefault();
    var subPage = Model.MenFootwearSubcategoryPage;
    var currentSlug = (Model.CurrentSubcategorySlug ?? "").Trim().ToLowerInvariant();

    if (subPage == null && footwear.SubcategoryPages != null && footwear.SubcategoryPages.Count > 0)
    {
        subPage = footwear.SubcategoryPages.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSlug, StringComparison.OrdinalIgnoreCase));
    }

    if (subPage == null)
    {
        var matchedCat = footwear.CategoriesSection?.Categories?.FirstOrDefault(c =>
            string.Equals(c.Slug, currentSlug, StringComparison.OrdinalIgnoreCase));

        var catName = matchedCat?.Name ?? (!string.IsNullOrWhiteSpace(Model.CurrentSubcategoryName)
            ? Model.CurrentSubcategoryName
            : (string.IsNullOrWhiteSpace(currentSlug) ? "Men Footwear" : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(currentSlug.Replace("-", " "))));

        var defaultPages = Dreamflykit.Application.FashionHub.Models.FashionMenFootwearDto.CreateDefaultSubcategoryPages();
        subPage = defaultPages.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSlug, StringComparison.OrdinalIgnoreCase))
            ?? new Dreamflykit.Application.FashionHub.Models.FashionMenFootwearSubcategoryPageDto
            {
                CategorySlug = currentSlug,
                CategoryName = catName,
                HeroBanner = new Dreamflykit.Application.FashionHub.Models.FashionMenFootwearSubcategoryHeroDto
                {
                    Title = catName,
                    TitleHighlight = "STUDENT ESSENTIALS • 100% GENUINE",
                    Subtitle = $"Discover our premium curated collection of {catName} engineered with shock-absorbing memory foam and high-traction soles for campus life.",
                    IsUploadingSoon = true
                },
                Products = defaultPages.FirstOrDefault()?.Products ?? new List<Dreamflykit.Application.FashionHub.Models.FashionProductItemDto>()
            };
    }

    var hero = subPage.HeroBanner ?? new Dreamflykit.Application.FashionHub.Models.FashionMenFootwearSubcategoryHeroDto();
    var products = (subPage.Products != null && subPage.Products.Count > 0)
        ? subPage.Products.Where(p => p.IsActive).ToList()
        : new List<Dreamflykit.Application.FashionHub.Models.FashionProductItemDto>();

    var allCategories = footwear.CategoriesSection?.Categories?.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToList()
        ?? new List<Dreamflykit.Application.FashionHub.Models.FashionCategoryItemDto>();

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="dk-footwear-subpage-container dk-shell" id="footwearSubpageRoot">

    <!-- Festival Announcement Ribbon (if enabled by admin) -->
    @if (footwear.FestivalTheme != null && footwear.FestivalTheme.IsEnabled && !string.IsNullOrWhiteSpace(footwear.FestivalTheme.AnnouncementText))
    {
        <div class="dk-sub-fest-ribbon" style="background: @(!string.IsNullOrWhiteSpace(footwear.FestivalTheme.BgGradient) ? footwear.FestivalTheme.BgGradient : "linear-gradient(135deg, #0284c7 0%, #0369a1 100%)");">
            <span class="dk-sub-fest-badge">@(!string.IsNullOrWhiteSpace(footwear.FestivalTheme.BadgeText) ? footwear.FestivalTheme.BadgeText : "FOOTWEAR SPECIAL")</span>
            <span class="dk-sub-fest-text">@footwear.FestivalTheme.AnnouncementText</span>
            @if (!string.IsNullOrWhiteSpace(footwear.FestivalTheme.BannerHighlight))
            {
                <span class="dk-sub-fest-highlight">@footwear.FestivalTheme.BannerHighlight</span>
            }
        </div>
    }

    <!-- ========================================================
         1. HERO BANNER (FULL WIDTH AS REQUESTED)
    ========================================================= -->
    <section class="dk-footwear-sub-hero-card" aria-label="@subPage.CategoryName Hero Banner">
        <div class="dk-footwear-sub-hero-glow"></div>
        <div class="dk-footwear-sub-hero-body">
            <div class="dk-footwear-sub-hero-content">
                <nav class="dk-footwear-sub-breadcrumb" aria-label="Men footwear breadcrumb">
                    <a href="/category/fashion">Fashion</a>
                    <span class="dk-footwear-sub-sep">/</span>
                    <a href="/category/fashion/men-footwear">Men Footwear</a>
                    <span class="dk-footwear-sub-sep">/</span>
                    <span class="dk-footwear-sub-crumb-active">@subPage.CategoryName</span>
                </nav>

                <div class="dk-footwear-sub-hero-badge">
                    <span class="dk-badge-dot">●</span>
                    <span>@(!string.IsNullOrWhiteSpace(hero.TitleHighlight) ? hero.TitleHighlight : "STUDENT ESSENTIALS • 100% GENUINE")</span>
                </div>

                <h1 class="dk-footwear-sub-hero-title">@subPage.CategoryName</h1>
                
                <p class="dk-footwear-sub-hero-desc">
                    @(string.IsNullOrWhiteSpace(hero.Subtitle)
                        ? $"Discover our premium curated collection of {subPage.CategoryName} engineered with shock-absorbing memory foam, high-traction soles, and breathable weather-ready designs."
                        : hero.Subtitle)
                </p>

                <div class="dk-footwear-sub-hero-chips">
                    <span class="dk-hero-chip">✓ Shock Absorption Tested</span>
                    <span class="dk-hero-chip">✓ Campus Delivery Ready</span>
                    <span class="dk-hero-chip">✓ 100% Genuine Materials</span>
                    @if (canManage)
                    {
                        <a href="/Admin/FashionHub#tab-men-footwear" class="dk-sub-admin-link">⚙ Edit in Admin Dashboard</a>
                    }
                </div>
            </div>

            <div class="dk-footwear-sub-hero-media">
                @if (!string.IsNullOrWhiteSpace(hero.ImageUrl) && !hero.ImageUrl.Contains("placeholder") && !hero.IsUploadingSoon)
                {
                    <div class="dk-footwear-sub-banner-img-wrap">
                        <img src="@hero.ImageUrl" alt="@subPage.CategoryName" class="dk-footwear-sub-banner-img" />
                    </div>
                }
                else
                {
                    <div class="dk-footwear-sub-hero-uploading">
                        <div class="dk-footwear-sub-uploading-radar">
                            <span class="dk-footwear-sub-radar-ring"></span>
                            <span class="dk-footwear-sub-emoji">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                        </div>
                        <div class="dk-footwear-sub-uploading-pill">
                            <span class="dk-mini-dot">●</span> Uploading Soon
                        </div>
                        <p class="dk-footwear-sub-uploading-text">Admin will upload banner image</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         2. MAIN TWO-COLUMN LAYOUT (LEFT FILTERS, RIGHT PRODUCTS)
    ========================================================= -->
    <div class="dk-footwear-sub-layout">
        
        <!-- LEFT FILTER SIDEBAR -->
        <aside class="dk-footwear-sub-sidebar" id="dkFootwearSubSidebar" aria-label="Filters">
            <div class="dk-filter-card">
                <div class="dk-filter-header">
                    <h3 class="dk-filter-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filters
                    </h3>
                    <button type="button" class="dk-btn-clear-filters" id="btnFootwearClearAllFilters" onclick="resetFootwearFilters()">
                        Reset All
                    </button>
                </div>

                <!-- 1. Categories Quick Switcher (All 7 Men Footwear Subcategories) -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Footwear Categories (7)</h4>
                    <div class="dk-cat-quick-list">
                        @foreach (var cat in allCategories)
                        {
                            var isCurrent = string.Equals(cat.Slug, subPage.CategorySlug, StringComparison.OrdinalIgnoreCase);
                            <a href="/category/fashion/men-footwear/@cat.Slug" 
                               class="dk-cat-quick-item @(isCurrent ? "active" : "")" 
                               title="@cat.Name">
                                <span class="dk-cat-quick-emoji">@GetSubcategoryIcon(cat.Slug)</span>
                                <span class="dk-cat-quick-name">@cat.Name</span>
                                @if (isCurrent)
                                {
                                    <span class="dk-cat-current-dot">●</span>
                                }
                            </a>
                        }
                    </div>
                </div>

                <!-- 2. Shoe Size Filter (UK Sizes) -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Shoe Size</h4>
                    <div class="dk-sizes-chips-grid">
                        @foreach (var size in new[] { "UK 6", "UK 7", "UK 8", "UK 9", "UK 10", "UK 11", "UK 12", "Free Size" })
                        {
                            <label class="dk-size-chip-label">
                                <input type="checkbox" class="dk-size-checkbox" value="@size" onchange="filterFootwearProducts()" />
                                <span class="dk-size-chip-box">@size</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 3. Color Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Color</h4>
                    <div class="dk-colors-grid">
                        @foreach (var (cName, cHex) in new[] { 
                            ("Black", "#0f172a"), ("Brown", "#78350f"), ("Navy", "#1e3a8a"), 
                            ("White", "#ffffff"), ("Grey", "#64748b"), ("Olive", "#4d7c0f"), 
                            ("Tan", "#d97706"), ("Red", "#dc2626"), ("Blue", "#2563eb") })
                        {
                            <label class="dk-color-swatch-item" title="@cName">
                                <input type="checkbox" class="dk-color-checkbox" value="@cName" onchange="filterFootwearProducts()" />
                                <span class="dk-color-circle" style="background-color: @cHex; @(cName == "White" ? "border: 1.5px solid #cbd5e1;" : "")"></span>
                                <span class="dk-color-name">@cName</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 4. Price Range Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Price Range</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearPriceRange" value="all" checked onchange="filterFootwearProducts()" />
                            <span>All Prices</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearPriceRange" value="0-499" onchange="filterFootwearProducts()" />
                            <span>Under ₹499</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearPriceRange" value="500-999" onchange="filterFootwearProducts()" />
                            <span>₹500 - ₹999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearPriceRange" value="1000-1999" onchange="filterFootwearProducts()" />
                            <span>₹1,000 - ₹1,999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearPriceRange" value="2000-3499" onchange="filterFootwearProducts()" />
                            <span>₹2,000 - ₹3,499</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearPriceRange" value="3500-99999" onchange="filterFootwearProducts()" />
                            <span>₹3,500 &amp; Above</span>
                        </label>
                    </div>
                    <div class="dk-price-custom-row">
                        <input type="number" id="footwearMinPrice" placeholder="Min ₹" class="dk-price-input" onchange="filterFootwearProducts()" />
                        <span class="dk-price-sep">-</span>
                        <input type="number" id="footwearMaxPrice" placeholder="Max ₹" class="dk-price-input" onchange="filterFootwearProducts()" />
                        <button type="button" class="dk-btn-price-go" onclick="filterFootwearProducts()">Go</button>
                    </div>
                </div>

                <!-- 5. Discount Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Discount</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearDiscount" value="0" checked onchange="filterFootwearProducts()" />
                            <span>All Discounts</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearDiscount" value="10" onchange="filterFootwearProducts()" />
                            <span>10% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearDiscount" value="20" onchange="filterFootwearProducts()" />
                            <span>20% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearDiscount" value="30" onchange="filterFootwearProducts()" />
                            <span>30% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearDiscount" value="50" onchange="filterFootwearProducts()" />
                            <span>50% and above</span>
                        </label>
                    </div>
                </div>

                <!-- 6. Customer Rating -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Customer Rating</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearRating" value="0" checked onchange="filterFootwearProducts()" />
                            <span>All Ratings</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearRating" value="4.5" onchange="filterFootwearProducts()" />
                            <span>★ 4.5 &amp; above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="footwearRating" value="4.0" onchange="filterFootwearProducts()" />
                            <span>★ 4.0 &amp; above</span>
                        </label>
                    </div>
                </div>

                <!-- 7. Availability -->
                <div class="dk-filter-section" style="border-bottom: none;">
                    <label class="dk-switch-row">
                        <span class="dk-switch-text">In Stock Only</span>
                        <input type="checkbox" id="footwearInStockOnly" checked onchange="filterFootwearProducts()" />
                        <span class="dk-slider-toggle"></span>
                    </label>
                </div>

            </div>
        </aside>

        <!-- RIGHT PRODUCTS CATALOG GRID -->
        <main class="dk-footwear-sub-main" id="dkFootwearSubMain">
            
            <!-- Products Header Bar -->
            <div class="dk-footwear-sub-topbar">
                <div class="dk-topbar-info">
                    <h2 class="dk-topbar-title">@subPage.CategoryName</h2>
                    <span class="dk-topbar-count">
                        Showing <strong id="footwearProductCount">@products.Count</strong> products
                    </span>
                </div>

                <!-- Active Filter Tags Row -->
                <div class="dk-active-filters-row" id="footwearActiveFiltersRow" style="display: none;"></div>

                <!-- Sort Control -->
                <div class="dk-topbar-sort">
                    <label for="footwearSortSelect" class="dk-sort-label">Sort by:</label>
                    <select id="footwearSortSelect" class="dk-sort-select" onchange="sortFootwearProducts(this.value)">
                        <option value="relevance">Relevance</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="rating">Customer Rating</option>
                        <option value="discount">Highest Discount</option>
                    </select>
                </div>
            </div>

            <!-- Products Grid with BIG IMAGE FRAMES -->
            <div class="dk-footwear-products-grid" id="footwearProductsGrid">
                @foreach (var prod in products)
                {
                    var discountPct = 0;
                    if (prod.OriginalPrice.HasValue && prod.OriginalPrice.Value > prod.Price)
                    {
                        discountPct = (int)Math.Round((1m - (prod.Price / prod.OriginalPrice.Value)) * 100m);
                    }
                    var sizesStr = prod.Sizes != null && prod.Sizes.Count > 0 ? string.Join(",", prod.Sizes) : "UK 7,UK 8,UK 9,UK 10";
                    var colorsStr = prod.Colors != null && prod.Colors.Count > 0 ? string.Join(",", prod.Colors) : "Black,Brown,White";

                    <div class="dk-footwear-card" 
                         data-id="@prod.Id"
                         data-price="@((int)prod.Price)"
                         data-sizes="@sizesStr"
                         data-colors="@colorsStr"
                         data-rating="@prod.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                         data-discount="@discountPct"
                         data-instock="@(prod.InStock ? "true" : "false")">

                        <!-- Wishlist button -->
                        <button type="button" class="dk-footwear-wishlist-btn" title="Save to wishlist" onclick="toggleSubFootwearWishlist(this, event)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </button>

                        <!-- BIG IMAGE FRAME (HIGH DEFINITION PORTRAIT) -->
                        <div class="dk-footwear-img-frame">
                            <!-- Badge -->
                            @if (!string.IsNullOrWhiteSpace(prod.Badge))
                            {
                                <span class="dk-footwear-card-badge">@prod.Badge</span>
                            }

                            @if (!prod.IsUploadingSoon && !string.IsNullOrWhiteSpace(prod.ImageUrl) && !prod.ImageUrl.Contains("uploading-soon"))
                            {
                                <img src="@prod.ImageUrl" alt="@prod.Name" class="dk-footwear-card-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="dk-footwear-card-soon-box" style="display: none;">
                                    <div class="dk-footwear-soon-radar-sm">
                                        <span class="dk-footwear-soon-radar-ring"></span>
                                        <span class="dk-footwear-soon-icon">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                                    </div>
                                    <span class="dk-footwear-card-soon-pill">⏳ UPLOADING SOON</span>
                                    <span class="dk-footwear-card-soon-hint">Curated Student Footwear</span>
                                </div>
                            }
                            else
                            {
                                <div class="dk-footwear-card-soon-box">
                                    <div class="dk-footwear-soon-radar-sm">
                                        <span class="dk-footwear-soon-radar-ring"></span>
                                        <span class="dk-footwear-soon-icon">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                                    </div>
                                    <span class="dk-footwear-card-soon-pill">⏳ UPLOADING SOON</span>
                                    <span class="dk-footwear-card-soon-hint">Curated Student Footwear</span>
                                </div>
                            }
                        </div>

                        <!-- Card Body Details -->
                        <div class="dk-footwear-card-body">
                            <div class="dk-footwear-card-cat">MEN FOOTWEAR &bull; @subPage.CategoryName.ToUpper()</div>
                            
                            <h3 class="dk-footwear-card-title" title="@prod.Name">
                                @prod.Name
                            </h3>

                            <!-- Price row -->
                            <div class="dk-footwear-price-row">
                                <span class="dk-footwear-selling-price">₹@prod.Price.ToString("N0")</span>
                                @if (prod.OriginalPrice.HasValue && prod.OriginalPrice.Value > prod.Price)
                                {
                                    <span class="dk-footwear-mrp-price">₹@prod.OriginalPrice.Value.ToString("N0")</span>
                                    @if (discountPct > 0)
                                    {
                                        <span class="dk-footwear-discount-pill">@discountPct% OFF</span>
                                    }
                                }
                            </div>

                            <!-- Rating & Reviews -->
                            <div class="dk-footwear-rating-row">
                                <span class="dk-star-icon">★</span>
                                <span class="dk-rating-val">@prod.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                                <span class="dk-reviews-val">(@prod.ReviewsCount)</span>
                                <span class="dk-verified-pill">Verified</span>
                            </div>

                            <!-- Sizes row -->
                            @if (prod.Sizes != null && prod.Sizes.Count > 0)
                            {
                                <div class="dk-footwear-sizes-row">
                                    <span class="dk-sizes-lbl">Sizes:</span>
                                    <div class="dk-sizes-list">
                                        @foreach (var sz in prod.Sizes)
                                        {
                                            <span class="dk-size-badge">@sz</span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Add to cart CTA -->
                            <button type="button" 
                                    class="dk-btn-add-cart" 
                                    onclick="addSubFootwearCart('@prod.Id', '@prod.Name', @prod.Price, event)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span>Add to Cart</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Empty State when filters yield no items -->
            <div class="dk-footwear-empty-state" id="footwearEmptyState" style="display: none;">
                <div class="dk-empty-icon">👟</div>
                <h3 class="dk-empty-title">No matching footwear found</h3>
                <p class="dk-empty-desc">Try clearing filters or adjusting your size/price preferences.</p>
                <button type="button" class="dk-btn-empty-reset" onclick="resetFootwearFilters()">Reset Filters</button>
            </div>

        </main>
    </div>

</div>

@functions {
    public static string GetSubcategoryIcon(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug)) return "👟";
        var s = slug.ToLowerInvariant();
        if (s.Contains("casual")) return "👞";
        if (s.Contains("sport") || s.Contains("running")) return "🏃";
        if (s.Contains("formal") || s.Contains("oxford")) return "👞";
        if (s.Contains("sneaker")) return "👟";
        if (s.Contains("sandal") || s.Contains("floater")) return "👡";
        if (s.Contains("flip") || s.Contains("flop") || s.Contains("slide")) return "🩴";
        if (s.Contains("sock")) return "🧦";
        return "👟";
    }
}

<style>
/* ========================================================
   MEN FOOTWEAR SUBCATEGORY LANDING PAGE STYLES
   Big Image Frames, Full-Width Hero, Interactive Filters
======================================================== */
.dk-footwear-subpage-container {
    width: 100%;
    margin: 0 auto;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #1e293b;
    padding-bottom: 48px;
}

/* Festival Ribbon */
.dk-sub-fest-ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 10px 20px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    border-radius: 12px;
    margin-bottom: 20px;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25);
}
.dk-sub-fest-badge {
    background: rgba(255, 255, 255, 0.25);
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
}
.dk-sub-fest-highlight {
    background: #f59e0b;
    color: #0f172a;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 800;
}

/* 1. HERO BANNER */
.dk-footwear-sub-hero-card {
    position: relative;
    width: 100%;
    margin-bottom: 32px;
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #ffffff 100%);
    border: 1px solid #bae6fd;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(2, 132, 199, 0.15);
}
.dk-footwear-sub-hero-glow {
    position: absolute;
    width: 450px;
    height: 450px;
    top: -200px;
    right: -100px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
}
.dk-footwear-sub-hero-body {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
