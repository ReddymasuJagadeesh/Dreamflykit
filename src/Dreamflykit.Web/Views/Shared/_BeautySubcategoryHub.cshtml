        transition: .3s;
    }
    .dk-beauty-slider:before {
        position: absolute;
        content: "";
        height: 16px;
        width: 16px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .3s;
    }
    .dk-beauty-toggle-switch input:checked + .dk-beauty-slider {
        background-color: #e11d48;
    }
    .dk-beauty-toggle-switch input:checked + .dk-beauty-slider:before {
        transform: translateX(16px);
