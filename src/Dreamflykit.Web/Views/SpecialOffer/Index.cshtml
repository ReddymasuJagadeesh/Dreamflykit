    <div id="studentDealModal" class="dk-modal-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="dk-modal-card">
            <div class="dk-modal-header">
                <div>
                    <span class="dk-modal-tag">SPECIAL STUDENT FARE</span>
                    <h3 id="modalTitle" class="dk-modal-title">Student Flight &amp; Baggage Deal Quote</h3>
                </div>
                <button type="button" class="dk-btn-modal-close" onclick="window.closeStudentDealModal();" aria-label="Close modal">✕</button>
