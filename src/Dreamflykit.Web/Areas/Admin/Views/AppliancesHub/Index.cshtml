                                        </div>

                                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px;">
                                            <div>
                                                <label class="dk-admin-label">Brand Name</label>
                                                <input type="text" id="brand_name_@(p.CategorySlug)_@b" class="dk-admin-input" value="@brand.Name" oninput="document.getElementById('brand_title_lbl_@(p.CategorySlug)_@b').innerText = '#' + (@(b + 1)) + ' ' + this.value;" />
