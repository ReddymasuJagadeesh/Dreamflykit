<header class="dk-header">

    <!-- =====================================================
         TOP UTILITY BAR
    ====================================================== -->

    <div class="dk-utility">

        <div class="dk-shell dk-utility-inner">

            <div class="dk-utility-item">
                <span class="dk-icon">✈</span>
                Delivering Across USA, UK, Canada, Australia & More
            </div>

            <div class="dk-utility-divider"></div>

            <div class="dk-utility-item">
                <span class="dk-icon">✓</span>
                100% Genuine Products
            </div>

            <div class="dk-utility-divider"></div>

            <div class="dk-utility-item">
                <span class="dk-icon">★</span>
                Student Trusted
            </div>

            <div class="dk-utility-spacer"></div>

            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <a href="/Admin" class="dk-utility-link" style="color: #fffa65; font-weight: 800; background: rgba(0,0,0,0.3); padding: 3px 12px; border-radius: 9999px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255, 250, 101, 0.4);">
                    <span style="display:inline-block; width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 6px #22c55e;"></span>
                    @(User.IsInRole("SuperAdmin") ? "⚡ Super Admin Console" : "⚡ Admin Console")
                </a>
                <div class="dk-utility-divider"></div>
            }

            <a href="/Help"
               class="dk-utility-link">
                Help & FAQs
            </a>

            <div class="dk-utility-divider"></div>

            <a href="tel:+919123456789"
               class="dk-utility-link">
                +91 91234 56789
            </a>

            <div class="dk-utility-divider"></div>

            <a href="/Orders"
               class="dk-utility-link">
                Track Order
            </a>

        </div>

    </div>


    <!-- =====================================================
         MAIN HEADER
    ====================================================== -->

    <div class="dk-main-header">

        <div class="dk-shell dk-main-header-inner">


            <!-- LOGO -->

            <a href="/"
               class="dk-brand"
               aria-label="Dreamflykit Home">

                <img src="~/images/branding/dreamflykit-logo.webp"
                     alt="Dreamflykit"
                     class="dk-brand-image" />

            </a>


            <!-- SEARCH -->

            <div class="dk-search-box-wrapper">
                <form action="/Products/Search"
                      method="get"
                      id="dk-search-form"
                      class="dk-search">

                    <span class="dk-search-icon">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="11"
                                    cy="11"
                                    r="7"></circle>
                            <path d="m20 20-4-4"></path>
                        </svg>
                    </span>

                    <input type="search"
                           id="dk-search-input"
                           name="q"
                           placeholder="Search for products, brands and more"
                           autocomplete="off" />

                    <button type="submit"
                            aria-label="Search">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="11"
                                    cy="11"
                                    r="7"></circle>
                            <path d="m20 20-4-4"></path>
                        </svg>
                    </button>
                </form>

                <div id="dk-search-autocomplete" class="dk-autocomplete-dropdown" style="display: none;" role="listbox" aria-label="Search suggestions"></div>
            </div>


            <!-- ADMIN DIRECT SHORTCUT BUTTON -->
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <a href="/Admin" class="dk-admin-header-btn" title="Open Admin Control Center" style="display: inline-flex; align-items: center; gap: 7px; background: linear-gradient(135deg, #075bc8, #054190); color: #ffffff; padding: 9px 15px; border-radius: 9px; font-weight: 700; font-size: 13px; text-decoration: none; box-shadow: 0 3px 10px rgba(7,91,200,0.3); border: 1px solid rgba(255,255,255,0.25); white-space: nowrap;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span>@(User.IsInRole("SuperAdmin") ? "Super Admin" : "Admin Panel")</span>
                </a>
            }

            <!-- ACCOUNT -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dk-account-dropdown-wrapper">
                    <a href="/Orders" class="dk-account">
                        <span class="dk-account-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="8" r="3.5"></circle>
                                <path d="M5 21c.8-4 3.2-6 7-6s6.2 2 7 6"></path>
                            </svg>
                        </span>
                        <span class="dk-account-text">
                            <small>Hello, @(User.Identity.Name?.Split('@')[0])</small>
                            <strong>My Account ▾</strong>
                        </span>
                    </a>
                    <div class="dk-account-menu">
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                        {
                            <div style="padding: 6px 12px 2px; font-size: 11px; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Store Management</div>
                            <a href="/Admin" class="dk-account-menu-item" style="color: #075bc8; font-weight: 700; background: #eef5ff;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                                @(User.IsInRole("SuperAdmin") ? "Super Admin Dashboard" : "Admin Dashboard")
                            </a>
                            <a href="/Admin/Products/Create" class="dk-account-menu-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                + Add Product
                            </a>
                            <a href="/Admin/Categories" class="dk-account-menu-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                Categories & Subcategories
                            </a>
                            <a href="/Admin/Media" class="dk-account-menu-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                Media & Banners
                            </a>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <a href="/Admin/MediaPermissions" class="dk-account-menu-item" style="color: #6d28d9;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                    Admin Permissions
                                </a>
                            }
                            <div style="border-top: 1px solid #f1f5f9; margin: 4px 0;"></div>
                        }
                        <a href="/Orders" class="dk-account-menu-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                            My Orders
                        </a>
                        <a href="/Address" class="dk-account-menu-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                            Saved Addresses
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="dk-account-menu-form">
                            <button type="submit" class="dk-account-menu-item dk-logout-btn">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                Log Out
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a href="/Account/Login" class="dk-account">
                    <span class="dk-account-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="3.5"></circle>
                            <path d="M5 21c.8-4 3.2-6 7-6s6.2 2 7 6"></path>
                        </svg>
                    </span>
                    <span class="dk-account-text">
                        <small>Login / Sign Up</small>
                        <strong>My Account</strong>
                    </span>
                </a>
            }


            <!-- MENU -->

            <button type="button"
                    class="dk-menu-button"
                    id="mobileMenuButton"
                    aria-label="Open menu"
                    aria-expanded="false">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M4 6h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 18h16"></path>

                </svg>

                <span>
                    More<br />Menu
                </span>

            </button>


            <!-- WISHLIST -->
            <a href="/Wishlist" class="dk-wishlist" title="My Wishlist">
                <span class="dk-wishlist-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                    </svg>
                    <span class="dk-wishlist-count" id="headerWishlistCount">0</span>
                </span>
                <strong>Wishlist</strong>
            </a>

            <!-- CART -->
            <a href="/Cart"
               class="dk-cart">

                <span class="dk-cart-icon">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M3 4h2l2 12h11l2-8H6"></path>

                        <circle cx="9"
                                cy="20"
                                r="1.5"></circle>

                        <circle cx="18"
                                cy="20"
                                r="1.5"></circle>

                    </svg>

                    <span class="dk-cart-count">
                        0
                    </span>

                </span>

                <strong>
                    Cart
                </strong>

            </a>

        </div>

    </div>


    <!-- =====================================================
         CATEGORY NAVIGATION
    ====================================================== -->

    <nav class="dk-category-nav">

        <div class="dk-shell dk-category-nav-inner">

            <a href="#"
               class="dk-category-link dk-category-active">

                <span>♧</span>
                For You

            </a>

            <a href="#"
               class="dk-category-link">

                <span>🎓</span>
                Study Essentials

            </a>

            <a href="#"
               class="dk-category-link">

                <span>▣</span>
                Electronics

            </a>

            <a href="#"
               class="dk-category-link">

                <span>✈</span>
                Travel Gear

            </a>

            <a href="#"
               class="dk-category-link">

                <span>♧</span>
                Adapters & SIM

            </a>

            <a href="#"
               class="dk-category-link">

                <span>◇</span>
                Lifestyle

            </a>

            <a href="#"
               class="dk-category-link">

                <span>♡</span>
                Health & Care

            </a>

            <a href="#"
               class="dk-category-link">

                <span>✎</span>
                Stationery

            </a>

            <a href="#"
               class="dk-category-link">

                <span>▣</span>
                Luggage & Bags

            </a>

            <a href="#"
               class="dk-category-link">

                <span>★</span>
                Offers Zone

            </a>

            <a href="/Kits/FindMyKit"
               class="dk-find-kit">

                <span>♧</span>
                Find My Kit

            </a>

        </div>

    </nav>


    <!-- MOBILE MENU -->

    <div id="mobileNavigation"
         class="dk-mobile-navigation">

        <a href="/">Home</a>

        <a href="/About">About Us</a>

        <a href="/Contact">Contact Us</a>

        <a href="/Consultancy">Consultancy</a>

        <a href="/EducationLoans">Education Loans</a>

        <a href="/Kits/FindMyKit"
           class="dk-mobile-find-kit">
            Find My Kit
        </a>

    </div>

</header>