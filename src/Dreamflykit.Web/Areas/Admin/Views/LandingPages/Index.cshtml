@model Dreamflykit.Web.Areas.Admin.Models.LandingPageListViewModel
@{
    ViewData["Title"] = "Manage Landing Pages";
}

<div class="dk-admin-content-card">
    <div class="dk-admin-card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
        <div>
            <h1 class="dk-admin-card-title" style="font-size: 1.5rem; margin: 0;">Landing Pages</h1>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0.25rem 0 0;">
                Build dedicated marketing campaign landing pages with custom hero images.
            </p>
        </div>
        <div>
            <a href="/Admin/LandingPages/Create" class="dk-btn dk-btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>New Landing Page</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="dk-alert dk-alert-success" style="margin-bottom: 1.5rem; padding: 0.75rem 1rem; background: #ecfdf5; border-left: 4px solid #10b981; color: #065f46; border-radius: 4px;">
            @msg
        </div>
    }

    @if (!Model.LandingPages.Any())
    {
        <div style="text-align: center; padding: 4rem 1rem;">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-muted); margin-bottom: 1rem;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">No landing pages created yet</h3>
            <p style="color: var(--text-muted); max-width: 400px; margin: 0 auto 1.5rem;">
                Create campaign landing pages for targeted ad promotions and seasonal product showcases.
            </p>
            <a href="/Admin/LandingPages/Create" class="dk-btn dk-btn-primary">Create First Page</a>
        </div>
    }
    else
    {
        <div class="dk-table-responsive" style="overflow-x: auto;">
            <table class="dk-admin-table" style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                <thead>
                    <tr style="border-bottom: 2px solid #e5e7eb; text-align: left; background: var(--bg-alt, #f9fafb);">
                        <th style="padding: 0.75rem 1rem; width: 100px;">Hero Graphic</th>
                        <th style="padding: 0.75rem 1rem;">Title</th>
                        <th style="padding: 0.75rem 1rem;">Slug / URL</th>
                        <th style="padding: 0.75rem 1rem; width: 100px;">Status</th>
                        <th style="padding: 0.75rem 1rem; width: 120px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.LandingPages)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 0.75rem 1rem;">
                                @if (!string.IsNullOrWhiteSpace(p.HeroImageUrl))
                                {
                                    <img src="@p.HeroImageUrl" alt="@p.Title" style="width: 80px; height: 45px; object-fit: cover; border-radius: 4px; border: 1px solid #e5e7eb;" />
                                }
                                else
                                {
                                    <div style="width: 80px; height: 45px; background: #e5e7eb; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; color: #6b7280;">No Hero</div>
                                }
                            </td>
                            <td style="padding: 0.75rem 1rem; font-weight: 600;">
                                @p.Title
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                <code>/pages/@p.Slug</code>
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; background: @(p.Status == "Published" ? "#ecfdf5" : "#f3f4f6"); color: @(p.Status == "Published" ? "#065f46" : "#374151"); font-weight: 600;">
                                    @p.Status
                                </span>
                            </td>
                            <td style="padding: 0.75rem 1rem; text-align: right;">
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <a href="/Admin/LandingPages/Edit/@p.Id" class="dk-btn dk-btn-secondary dk-btn-sm">Edit</a>
                                    <form method="post" action="/Admin/LandingPages/Delete/@p.Id" style="display: inline;" onsubmit="return confirm('Delete this landing page?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dk-btn dk-btn-danger dk-btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
