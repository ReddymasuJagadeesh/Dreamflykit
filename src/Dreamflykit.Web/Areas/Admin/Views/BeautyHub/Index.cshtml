    // Collect Flash Deals
    document.querySelectorAll('#flashCardsList .flash-card-item').forEach(card => {
        payload.flashDealsTimer.cards.push({
            id: card.getAttribute('data-id'),
            offerTag: card.querySelector('.flash-tag')?.value || '',
            title: card.querySelector('.flash-title')?.value || '',
            imageUrl: card.querySelector('.flash-img')?.value || '',
            targetUrl: '#beauty-products-catalog'
        });
