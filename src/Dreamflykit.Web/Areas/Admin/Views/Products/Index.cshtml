@model Dreamflykit.Web.Areas.Admin.Models.AdminProductListViewModel

@{
    ViewData["Title"] = "Products & Catalog Management";
}

<div class="dk-admin-card">
    <div class="dk-admin-card-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
        <div>
            <h3 class="dk-admin-card-title" style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a;">
                Catalog Inventory (@Model.TotalCount products)
            </h3>
            <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">
                Manage catalog items, review &amp; price seller submissions, manage variants, and publish products live.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            @if (Model.PendingApprovalCount > 0)
            {
                <a href="/Admin/Products?status=PendingApproval" style="padding: 8px 16px; font-size: 13px; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background: #fffbeb; color: #b45309; border: 1px solid #fcd34d; border-radius: 6px; box-shadow: 0 2px 6px rgba(245, 158, 11, 0.2);">
                    <span style="font-size: 14px;">⏳</span>
                    <span>Review Pending Sellers (@Model.PendingApprovalCount)</span>
                </a>
            }

            <a href="/Admin/Products/Create" class="dk-btn dk-btn-primary" style="padding: 8px 18px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(7,91,200,0.25);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                + Add Product
            </a>

            <form method="get" action="/Admin/Products" style="display: flex; gap: 6px;">
                @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                }
                <input type="text"
                       name="search"
                       value="@Model.SearchTerm"
                       placeholder="Search products..."
                       class="dk-input"
                       style="width: 200px; padding: 7px 12px; font-size: 13px;" />
                <button type="submit" class="dk-btn dk-btn-secondary" style="padding: 7px 14px; font-size: 13px;">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <a href="/Admin/Products" class="dk-btn dk-btn-outline" style="padding: 7px 12px; font-size: 13px;">Reset</a>
                }
            </form>
        </div>
    </div>

    <!-- FILTER TABS -->
    <div style="display:flex; gap:8px; padding: 12px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; flex-wrap:wrap; align-items:center;">
        <span style="font-size: 12px; font-weight: 700; color: #64748b; text-transform:uppercase; margin-right: 4px;">Filter:</span>
        <a href="/Admin/Products" class="dk-btn @(string.IsNullOrEmpty(Model.StatusFilter) ? "dk-btn-primary" : "dk-btn-outline")" style="padding: 5px 12px; font-size: 12px; text-decoration:none;">
            All Products
        </a>
        <a href="/Admin/Products?status=PendingApproval" class="dk-btn @(Model.StatusFilter == "PendingApproval" ? "dk-btn-primary" : "dk-btn-outline")" style="padding: 5px 12px; font-size: 12px; text-decoration:none; @(Model.PendingApprovalCount > 0 ? "border-color:#f59e0b; color:#b45309; font-weight:700;" : "")">
            ⏳ Needs Price Approval (@Model.PendingApprovalCount)
        </a>
        <a href="/Admin/Products?status=Approved" class="dk-btn @(Model.StatusFilter == "Approved" ? "dk-btn-primary" : "dk-btn-outline")" style="padding: 5px 12px; font-size: 12px; text-decoration:none;">
            ✓ Live &amp; Approved
        </a>
        <a href="/Admin/Products?status=Rejected" class="dk-btn @(Model.StatusFilter == "Rejected" ? "dk-btn-primary" : "dk-btn-outline")" style="padding: 5px 12px; font-size: 12px; text-decoration:none;">
            ✕ Rejected
        </a>
        <a href="/Admin/Products?status=SellerOnly" class="dk-btn @(Model.StatusFilter == "SellerOnly" ? "dk-btn-primary" : "dk-btn-outline")" style="padding: 5px 12px; font-size: 12px; text-decoration:none;">
            🏪 Seller Submissions
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="margin: 16px 20px 0; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 13px; font-weight: 600;">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div style="margin: 16px 20px 0; padding: 12px 16px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; color: #92400e; font-size: 13px; font-weight: 600;">
            ⚠️ @TempData["WarningMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="margin: 16px 20px 0; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b; font-size: 13px; font-weight: 600;">
            ✕ @TempData["ErrorMessage"]
        </div>
    }

    <div class="dk-admin-table-wrap" style="margin-top: 16px;">
        <table class="dk-admin-table">
            <thead>
                <tr>
                    <th style="width: 50px;">Image</th>
                    <th>Product Name &amp; Slug</th>
                    <th>Origin / Seller</th>
                    <th>Category</th>
                    <th>Selling Price</th>
                    <th>MRP</th>
                    <th>Approval Status</th>
                    <th style="text-align: right; width: 230px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 40px; color: #64748b;">
                            No products found matching the criteria. Click "+ Add Product" to create one.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model.Products)
                    {
                        <tr style="@(p.ApprovalStatus == Dreamflykit.Domain.Catalog.ProductApprovalStatus.PendingApproval ? "background: #fffdf5;" : "")">
                            <td>
                                <img src="@(string.IsNullOrWhiteSpace(p.ImageUrl) ? "/images/products/product-placeholder.webp" : p.ImageUrl)"
                                     alt="@p.Name"
                                     style="width: 44px; height: 44px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc;" />
                            </td>
                            <td>
                                <div>
                                    <strong style="color: #0f172a; font-size: 14px;">@p.Name</strong>
                                    @if (p.IsPromoted)
                                    {
                                        <span style="font-size: 10px; background: #fef3c7; color: #b45309; padding: 1px 6px; border-radius: 4px; font-weight: 800; margin-left: 6px;">⚡ PROMOTED</span>
                                    }
                                    @if (p.IsFeatured)
                                    {
                                        <span style="font-size: 10px; background: #ecfdf5; color: #047857; padding: 1px 6px; border-radius: 4px; font-weight: 800; margin-left: 6px;">FEATURED</span>
                                    }
                                </div>
                                <div style="font-size: 11px; color: #64748b; margin-top: 2px;">
                                    <code>/Products/@p.Slug</code>
                                    @if (p.IsActive && p.ApprovalStatus == Dreamflykit.Domain.Catalog.ProductApprovalStatus.Approved)
                                    {
                                        <a href="/Products/@p.Slug" target="_blank" rel="noopener" style="color: #075bc8; text-decoration: none; margin-left: 6px;">view ↗</a>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (p.SellerId.HasValue)
                                {
                                    <span style="display:inline-flex; align-items:center; gap:4px; font-size:12px; font-weight:600; color:#0369a1; background:#e0f2fe; padding:2px 8px; border-radius:9999px;">
                                        🏪 @(p.SellerName ?? "Seller")
                                    </span>
                                }
                                else
                                {
                                    <span style="font-size:12px; color:#64748b; font-weight:500;">
                                        🛡️ Super Admin
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="dk-status-badge dk-status-confirmed">@p.CategoryName</span>
                            </td>
                            <td>
                                @if (p.SellingPrice > 0)
                                {
                                    <strong style="color: #059669; font-size: 14px;">₹@p.SellingPrice.ToString("N0")</strong>
                                }
                                else
                                {
                                    <span style="color: #b45309; font-size: 12px; font-weight: 700; background: #fef3c7; padding: 2px 6px; border-radius: 4px;">Needs Price</span>
                                }
                            </td>
                            <td>
                                @if (p.Mrp > 0)
                                {
                                    <span style="color: #94a3b8; text-decoration: line-through; font-size: 13px;">₹@p.Mrp.ToString("N0")</span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8; font-size: 12px;">--</span>
                                }
                            </td>
                            <td>
                                @if (p.ApprovalStatus == Dreamflykit.Domain.Catalog.ProductApprovalStatus.PendingApproval)
                                {
                                    <span style="background: #fef3c7; color: #b45309; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 9999px; border: 1px solid #fde68a; display:inline-block;">
                                        ⏳ Pending Price Review
                                    </span>
                                }
                                else if (p.ApprovalStatus == Dreamflykit.Domain.Catalog.ProductApprovalStatus.Approved)
                                {
                                    if (p.IsActive)
                                    {
                                        <span class="dk-status-badge dk-status-delivered">✓ Live &amp; Active</span>
                                    }
                                    else
                                    {
                                        <span class="dk-status-badge dk-status-cancelled">Inactive</span>
                                    }
                                }
                                else
                                {
                                    <span style="background: #fef2f2; color: #dc2626; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 9999px; border: 1px solid #fecaca;" title="@p.RejectionReason">
                                        ✕ Rejected
                                    </span>
                                }
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                @if (p.ApprovalStatus == Dreamflykit.Domain.Catalog.ProductApprovalStatus.PendingApproval)
                                {
                                    <a href="/Admin/Products/Review/@p.ProductId" class="dk-btn" style="padding: 5px 12px; font-size: 12px; font-weight: 800; background: #059669; color: #fff; border-radius: 6px; text-decoration: none; box-shadow: 0 2px 6px rgba(5, 150, 105, 0.3);">
                                        Review &amp; Set Price →
                                    </a>
                                }
                                else
                                {
                                    <a href="/Admin/Products/Review/@p.ProductId" class="dk-btn dk-btn-secondary" style="padding: 4px 8px; font-size: 11px; margin-right: 4px; text-decoration: none;" title="Edit Prices / Review Details">
                                        Price &amp; Details
                                    </a>
                                    <a href="/Admin/Products/Edit/@p.ProductId" class="dk-btn dk-btn-secondary" style="padding: 4px 8px; font-size: 11px; margin-right: 4px; text-decoration: none;">
                                        Edit
                                    </a>
                                    <a href="/Admin/Products/Media/@p.ProductId" class="dk-btn dk-btn-secondary" style="padding: 4px 8px; font-size: 11px; margin-right: 4px; text-decoration: none;" title="Manage S3 Gallery Images">
                                        Gallery
                                    </a>
                                    <form method="post" action="/Admin/Products/ToggleStatus/@p.ProductId" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dk-btn @(p.IsActive ? "dk-btn-outline" : "dk-btn-primary")" style="padding: 4px 8px; font-size: 11px;">
                                            @(p.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
