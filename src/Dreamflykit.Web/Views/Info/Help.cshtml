@{
    ViewData["Title"] = "Help Center & FAQs — Dreamflykit";
    Layout = "_Layout";
}

<div class="dk-page-container dk-info-page">
    <div class="dk-info-hero">
        <div class="dk-info-hero-badge">❓ FREQUENTLY ASKED QUESTIONS</div>
        <h1 class="dk-info-hero-title">How Can We Help You Today?</h1>
        <p class="dk-info-hero-subtitle">
            Find immediate answers regarding orders, sizing, international airline baggage rules, return policies, and secure payments.
        </p>
    </div>

    <!-- Category Tabs / Navigation -->
    <div class="dk-faq-grid">
        <!-- 1. Orders & Sizing -->
        <div class="dk-faq-section">
            <h2 class="dk-faq-section-title">📦 Ordering, Sizing & Kits</h2>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">How do I choose between Small, Medium, and Large kits?</summary>
                <div class="dk-faq-answer">
                    <p>
                        Our kits are designed around your course duration and baggage allowance:
                    </p>
                    <ul>
                        <li><strong>Small Kit (Essentials):</strong> Ideal for 6-12 month exchange students or light travelers with 1 check-in bag.</li>
                        <li><strong>Medium Kit (Standard):</strong> Our most popular kit for 1-2 year Master's students, fitting neatly into standard 2x 23kg baggage allocations.</li>
                        <li><strong>Large Kit (Comprehensive):</strong> Complete all-weather suite with heavy winter bedding, extra cookware, and multi-device charging hubs.</li>
                    </ul>
                </div>
            </details>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">Can I customize items in the kit?</summary>
                <div class="dk-faq-answer">
                    <p>
                        Yes! While our pre-bundled kits are scientifically proportioned for airline weight, you can freely add individual items or variants from our Catalog into your cart before checkout.
                    </p>
                </div>
            </details>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">How far in advance before my flight should I order?</summary>
                <div class="dk-faq-answer">
                    <p>
                        We recommend ordering <strong>7 to 10 days</strong> prior to your flight departure date to allow comfortable packing and weighing. For urgent cases, our Shamshabad Express Dispatch can deliver within 24-48 hours across metro cities.
                    </p>
                </div>
            </details>
        </div>

        <!-- 2. Shipping & Tracking -->
        <div class="dk-faq-section">
            <h2 class="dk-faq-section-title">🚚 Shipping, Tracking & Delivery</h2>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">How much does shipping cost?</summary>
                <div class="dk-faq-answer">
                    <p>
                        Delivery is <strong>100% FREE</strong> for all kit orders across India.
                    </p>
                </div>
            </details>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">How can I track my order status?</summary>
                <div class="dk-faq-answer">
                    <p>
                        Go to <a href="/Orders">My Orders</a> in your account to see our live 5-step tracking timeline (Placed &rarr; Confirmed &rarr; Packed &rarr; Shipped &rarr; Out for Delivery &rarr; Delivered).
                    </p>
                </div>
            </details>
        </div>

        <!-- 3. Returns & Cancellations -->
        <div class="dk-faq-section">
            <h2 class="dk-faq-section-title">🔄 Cancellations, Returns & Refunds</h2>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">Can I cancel my order?</summary>
                <div class="dk-faq-answer">
                    <p>
                        You can cancel your order directly from your <a href="/Orders">Order Details</a> page at any time before the order enters the <strong>Packed</strong> state. Once cancelled, reserved inventory is released immediately, and payments are refunded to your original payment method.
                    </p>
                </div>
            </details>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">What is your return policy?</summary>
                <div class="dk-faq-answer">
                    <p>
                        Dreamflykit offers a <strong>3-day hassle-free return window</strong> from the moment of confirmed delivery. You can click <em>"Request Return"</em> on your order details page, select a reason, and our logistics team will coordinate pickup.
                    </p>
                </div>
            </details>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">When will I receive my refund?</summary>
                <div class="dk-faq-answer">
                    <p>
                        Refunds are initiated instantly upon return verification or cancellation. For UPI and debit cards, credits typically reflect within 2 to 4 business days.
                    </p>
                </div>
            </details>
        </div>

        <!-- 4. Security & Payments -->
        <div class="dk-faq-section">
            <h2 class="dk-faq-section-title">💳 Payments & Security</h2>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">What payment methods are supported?</summary>
                <div class="dk-faq-answer">
                    <p>
                        We support UPI (Google Pay, PhonePe, Paytm, BHIM), Credit/Debit Cards (Visa, MasterCard, RuPay), Net Banking with all major Indian banks, and Cash on Delivery (COD).
                    </p>
                </div>
            </details>

            <details class="dk-faq-item">
                <summary class="dk-faq-question">Is my payment information safe?</summary>
                <div class="dk-faq-answer">
                    <p>
                        All transactions are processed through 256-bit bank-grade encryption with PCI-DSS Level 1 compliance. Dreamflykit never stores your CVV or raw card credentials.
                    </p>
                </div>
            </details>
        </div>
    </div>

    <!-- Quick Help Card -->
    <div class="dk-card" style="margin-top: 32px; text-align: center; padding: 36px 20px;">
        <h3>Still have questions?</h3>
        <p style="color: #64748b; max-width: 500px; margin: 8px auto 20px auto;">
            Our dedicated student travel team is ready to help you prepare the perfect kit.
        </p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/Contact" class="dk-btn dk-btn-primary">Contact Support</a>
            <a href="/Consultancy" class="dk-btn dk-btn-outline">Book Free 1-on-1 Consultation</a>
        </div>
    </div>
</div>
