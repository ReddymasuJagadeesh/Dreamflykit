@model Dreamflykit.Web.Areas.Admin.Models.AdminOrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.OrderNumber}";
    var statusClass = Model.Status.ToString().ToLowerInvariant();
}

<div style="margin-bottom: 16px;">
    <a href="/Admin/Orders" class="dk-btn dk-btn-secondary" style="padding: 6px 14px; font-size: 12px;">← Back to Orders</a>
</div>

<div class="dk-checkout-layout" style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">

    <!-- Left Column: Items & Details -->
    <div>
        <!-- Order Header Card -->
        <div class="dk-admin-card">
            <div class="dk-admin-card-header">
                <div>
                    <h3 class="dk-admin-card-title">Order #@Model.OrderNumber</h3>
                    <small style="color: #64748b;">Placed on @Model.CreatedAtUtc.ToString("dd MMMM yyyy, HH:mm UTC")</small>
                </div>
                <div>
                    <span class="dk-status-badge dk-status-@statusClass" style="font-size: 13px; padding: 6px 12px;">
                        Status: @Model.Status
                    </span>
                </div>
            </div>

            <!-- Ordered Items Table -->
            <div class="dk-admin-table-wrap">
                <table class="dk-admin-table">
                    <thead>
                        <tr>
                            <th>Item Details</th>
                            <th>SKU</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th>Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.ProductName</strong>
                                    <div style="font-size: 12px; color: #64748b;">@item.VariantName</div>
                                </td>
                                <td><code>@item.Sku</code></td>
                                <td>₹@item.UnitPrice.ToString("N0")</td>
                                <td>@item.Quantity</td>
                                <td><strong>₹@item.TotalPrice.ToString("N0")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="padding: 16px 24px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end;">
                <div style="width: 260px; display: flex; flex-direction: column; gap: 6px; font-size: 13px;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #64748b;">Subtotal:</span>
                        <span>₹@Model.Subtotal.ToString("N0")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #64748b;">Shipping Fee:</span>
                        <span style="color: #16a34a; font-weight: 700;">FREE</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 16px; font-weight: 800; border-top: 1px solid #cbd5e1; padding-top: 6px; margin-top: 4px;">
                        <span>Grand Total:</span>
                        <span style="color: #075bc8;">₹@Model.TotalAmount.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Status Update & Customer Info -->
    <div>
        <!-- Status Transition Card -->
        <div class="dk-admin-card">
            <div class="dk-admin-card-header">
                <h4 class="dk-admin-card-title">Update Order Status</h4>
            </div>
            <div style="padding: 20px;">
                @if (Model.AvailableNextStatuses.Count == 0)
                {
                    <p style="color: #64748b; font-size: 13px; margin: 0;">
                        This order is currently <strong>@Model.Status</strong>. No further status changes are available.
                    </p>
                }
                else
                {
                    <form method="post" action="/Admin/Orders/UpdateStatus">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />

                        <div class="dk-form-group" style="margin-bottom: 14px;">
                            <label class="dk-label" for="newStatusSelect">Next Status Transition</label>
                            <select id="newStatusSelect" name="newStatus" class="dk-input" style="width: 100%; padding: 10px; font-size: 14px;">
                                @foreach (var status in Model.AvailableNextStatuses)
                                {
                                    <option value="@status">Transition to @status</option>
                                }
                            </select>
                        </div>

                        <div class="dk-form-group" style="margin-bottom: 16px;">
                            <label class="dk-label" for="cancellationReason">Reason / Note (if cancelling)</label>
                            <input type="text"
                                   id="cancellationReason"
                                   name="cancellationReason"
                                   placeholder="Reason for change or cancellation"
                                   class="dk-input"
                                   style="width: 100%;" />
                        </div>

                        <button type="submit" class="dk-btn dk-btn-primary dk-btn-full" style="padding: 10px;">
                            Confirm Status Update
                        </button>
                    </form>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                {
                    <div style="margin-top: 16px; padding: 12px; border-radius: 8px; background: #fef2f2; border: 1px solid #fecaca; font-size: 13px;">
                        <strong style="color: #991b1b;">Customer Reason / Note:</strong>
                        <p style="margin: 4px 0 0 0; color: #374151;">@Model.CancellationReason</p>
                    </div>
                }
            </div>
        </div>

        <!-- Customer & Delivery Address Card -->
        <div class="dk-admin-card">
            <div class="dk-admin-card-header">
                <h4 class="dk-admin-card-title">Customer & Delivery Details</h4>
            </div>
            <div style="padding: 20px; font-size: 13px; display: flex; flex-direction: column; gap: 12px;">
                <div>
                    <span style="color: #64748b; font-size: 11px; text-transform: uppercase; font-weight: 700;">Customer Contact</span>
                    <div style="font-weight: 700; margin-top: 2px;">@Model.CustomerName</div>
                    <div>@Model.CustomerEmail</div>
                    <div>@Model.CustomerPhone</div>
                </div>

                <div style="border-top: 1px solid #f1f5f9; padding-top: 10px;">
                    <span style="color: #64748b; font-size: 11px; text-transform: uppercase; font-weight: 700;">Shipping Address</span>
                    <div style="font-weight: 600; margin-top: 2px;">@Model.ShippingFullName</div>
                    <div>@Model.ShippingAddressLine</div>
                    <div>@Model.ShippingCity, @Model.ShippingState @Model.ShippingPostalCode</div>
                    <div>@Model.ShippingCountry</div>
                    <div style="color: #64748b; margin-top: 2px;">Phone: @Model.ShippingPhone</div>
                </div>
            </div>
        </div>
    </div>

</div>
