@model Dreamflykit.Web.Areas.Admin.Models.AdminCategoryListViewModel

@{
    ViewData["Title"] = "Categories & Store Taxonomy";
}

<div class="dk-admin-card" style="margin-bottom: 24px;">
    <div class="dk-admin-card-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
        <div>
            <h3 class="dk-admin-card-title" style="margin: 0; font-size: 18px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                <span>Store Categories</span>
                <span id="catTotalBadge" style="font-size: 12px; background: #eff6ff; color: #1d4ed8; padding: 2px 10px; border-radius: 9999px; font-weight: 700; border: 1px solid #bfdbfe;">
                    @Model.Categories.Count Categories
                </span>
            </h3>
            <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">
                Full admin control: create, edit, delete, reorder, manage subcategories, and toggle storefront visibility.
            </p>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="/Admin/Categories/Create" class="dk-btn dk-btn-primary" style="padding: 8px 16px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                + Add Category
            </a>
            <a href="/Admin/Categories/CreateSubcategory" class="dk-btn dk-btn-secondary" style="padding: 8px 16px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                + Add Subcategory
            </a>
            <a href="/Admin/FashionHub" class="dk-btn" style="padding: 8px 16px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background: #ec4899; color: #ffffff;">
                👗 Fashion Hub
            </a>
            <a href="/categories" target="_blank" class="dk-btn dk-btn-outline" style="padding: 8px 14px; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;" title="View all categories on public website">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                Storefront View
            </a>
        </div>
    </div>

    <!-- Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div style="margin: 16px 20px 0; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="margin: 16px 20px 0; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #b91c1c; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Search & Filter Controls -->
    <div style="padding: 14px 20px; background: #f8fafc; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; margin-top: 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 260px; max-width: 450px;">
            <div style="position: relative; width: 100%;">
                <input type="text"
                       id="categorySearchInput"
                       class="dk-input"
                       placeholder="Filter by category name, slug..."
                       style="width: 100%; padding-left: 32px; font-size: 13px; height: 36px;" />
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5" style="position: absolute; left: 10px; top: 11px;">
                    <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 10px;">
            <select id="statusFilter" class="dk-input" style="height: 36px; font-size: 13px; padding: 4px 10px; min-width: 140px;">
                <option value="all">All Statuses</option>
                <option value="active">Active Only</option>
                <option value="inactive">Inactive Only</option>
            </select>

            <span id="categoryCountLabel" style="font-size: 12px; color: #64748b; font-weight: 600;">
                Showing @Model.Categories.Count of @Model.Categories.Count
            </span>
        </div>
    </div>

    <div class="dk-admin-table-wrap">
        <table class="dk-admin-table" id="categoriesTable">
            <thead>
                <tr>
                    <th style="width: 50px;">Img</th>
                    <th>Category Name</th>
                    <th>Slug</th>
                    <th style="width: 70px;">Order</th>
                    <th>Subcategories</th>
                    <th style="width: 90px;">Products</th>
                    <th style="width: 85px;">Status</th>
                    <th style="text-align: right; width: 280px;">Admin Controls</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categories.Count == 0)
                {
                    <tr id="emptyRow">
                        <td colspan="8" style="text-align: center; padding: 40px; color: #64748b;">
                            No categories found in store database. Click "+ Add Category" to create one.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Categories)
                    {
                        <tr class="category-row"
                            data-name="@c.Name.ToLowerInvariant()"
                            data-slug="@c.Slug.ToLowerInvariant()"
                            data-status="@(c.IsActive ? "active" : "inactive")">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                {
                                    <img src="@c.ImageUrl"
                                         alt="@c.Name"
                                         style="width: 40px; height: 40px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc;" />
                                }
                                else
                                {
                                    <div style="width: 40px; height: 40px; border-radius: 8px; border: 1px solid #e2e8f0; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                        🏷️
                                    </div>
                                }
                            </td>
                            <td>
                                <strong style="font-size: 14px; color: #0f172a; display: block;">@c.Name</strong>
                                <a href="/category/@c.Slug" target="_blank" style="font-size: 11px; color: #075bc8; text-decoration: none; display: inline-flex; align-items: center; gap: 3px; margin-top: 2px;">
                                    <span>Preview on Store</span>
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                </a>
                            </td>
                            <td>
                                <code style="font-size: 12px; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; color: #475569; font-weight: 600;">@c.Slug</code>
                            </td>
                            <td>
                                <span style="font-size: 13px; font-weight: 700; color: #334155;">@c.DisplayOrder</span>
                            </td>
                            <td>
                                @if (c.Subcategories.Count == 0)
                                {
                                    <span style="color: #94a3b8; font-size: 12px;">No subcategories</span>
                                }
                                else
                                {
                                    <div style="display: flex; flex-wrap: wrap; gap: 4px; max-width: 300px;">
                                        @foreach (var sub in c.Subcategories)
                                        {
                                            <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 11px; background: #eff6ff; color: #1d4ed8; padding: 2px 8px; border-radius: 9999px; border: 1px solid #bfdbfe;">
                                                <a href="/Admin/Categories/EditSubcategory/@sub.Id" style="color: #1d4ed8; text-decoration: none; font-weight: 600;" title="Edit Subcategory">
                                                    @sub.Name
                                                </a>
                                                <small style="color: #64748b;">(@sub.ProductCount)</small>
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span style="font-weight: 800; font-size: 13px; color: @(c.ProductCount > 0 ? "#0f172a" : "#94a3b8");">
                                    @c.ProductCount
                                </span>
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="dk-status-badge dk-status-delivered" style="font-size: 11px; padding: 3px 8px;">Active</span>
                                }
                                else
                                {
                                    <span class="dk-status-badge dk-status-cancelled" style="font-size: 11px; padding: 3px 8px;">Inactive</span>
                                }
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <div style="display: inline-flex; align-items: center; gap: 4px;">
                                    <a href="/Admin/Categories/CreateSubcategory?categoryId=@c.Id"
                                       class="dk-btn dk-btn-secondary"
                                       style="padding: 4px 8px; font-size: 11px; text-decoration: none; font-weight: 700;"
                                       title="Add Subcategory under @c.Name">
                                        + Sub
                                    </a>

                                    <a href="/Admin/Categories/Edit/@c.Id"
                                       class="dk-btn dk-btn-secondary"
                                       style="padding: 4px 8px; font-size: 11px; text-decoration: none; font-weight: 700;">
                                        Edit
                                    </a>

                                    <form method="post" action="/Admin/Categories/Toggle/@c.Id" style="display: inline; margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="dk-btn @(c.IsActive ? "dk-btn-outline" : "dk-btn-primary")"
                                                style="padding: 4px 8px; font-size: 11px; font-weight: 700;"
                                                title="@(c.IsActive ? "Hide from storefront" : "Show on storefront")">
                                            @(c.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>

                                    <!-- Delete Category Button -->
                                    <button type="button"
                                            class="dk-btn"
                                            style="padding: 4px 8px; font-size: 11px; background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; font-weight: 700;"
                                            onclick="openDeleteCategoryModal('@c.Id', '@Html.Raw(c.Name.Replace("'", "\\'"))', @c.ProductCount)"
                                            title="Delete category">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteCategoryModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 10000; align-items: center; justify-content: center;">
    <div style="background: #ffffff; width: 90%; max-width: 480px; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2); overflow: hidden; border: 1px solid #e2e8f0;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; background: #fef2f2;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: #fee2e2; display: flex; align-items: center; justify-content: center; color: #dc2626;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                </div>
                <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: #991b1b;">Delete Category</h3>
            </div>
            <button type="button" onclick="closeDeleteCategoryModal()" style="border: none; background: transparent; font-size: 18px; color: #64748b; cursor: pointer;">✕</button>
        </div>

        <div style="padding: 24px;">
            <p style="margin: 0 0 12px; font-size: 14px; color: #334155; line-height: 1.5;">
                Are you sure you want to delete category <strong id="deleteCategoryName" style="color: #0f172a;"></strong>?
            </p>

            <div id="deleteWarningWithProducts" style="display: none; padding: 12px 14px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; color: #92400e; font-size: 13px; margin-bottom: 16px; line-height: 1.4;">
                <strong>⚠️ Deletion Blocked:</strong> This category currently contains <strong id="deleteProductCount"></strong> live product(s). To protect your catalog integrity, please reassign or delete the products before deleting this category.
            </div>

            <div id="deleteSafeMessage" style="display: none; padding: 12px 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; color: #64748b; font-size: 12px; margin-bottom: 16px;">
                This category has 0 products assigned. Any empty subcategories under it will also be removed. This action cannot be undone.
            </div>

            <form id="deleteCategoryForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 12px;">
                    <button type="button" class="dk-btn dk-btn-secondary" onclick="closeDeleteCategoryModal()">Cancel</button>
                    <button type="submit" id="confirmDeleteButton" class="dk-btn" style="background: #dc2626; color: #ffffff; border: none; font-weight: 700; padding: 8px 20px;">
                        Yes, Delete Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Live Search and Status Filter
    const searchInput = document.getElementById('categorySearchInput');
    const statusFilter = document.getElementById('statusFilter');
    const rows = document.querySelectorAll('.category-row');
    const countLabel = document.getElementById('categoryCountLabel');

    function filterTable() {
        const query = searchInput.value.toLowerCase().trim();
        const status = statusFilter.value;
        let visibleCount = 0;

        rows.forEach(row => {
            const name = row.getAttribute('data-name') || '';
            const slug = row.getAttribute('data-slug') || '';
            const rowStatus = row.getAttribute('data-status') || '';

            const matchesQuery = query === '' || name.includes(query) || slug.includes(query);
            const matchesStatus = status === 'all' || rowStatus === status;

            if (matchesQuery && matchesStatus) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        if (countLabel) {
            countLabel.textContent = `Showing ${visibleCount} of ${rows.length}`;
        }
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (statusFilter) statusFilter.addEventListener('change', filterTable);

    // Delete Modal Logic
    function openDeleteCategoryModal(id, name, productCount) {
        document.getElementById('deleteCategoryName').textContent = name;
        const form = document.getElementById('deleteCategoryForm');
        form.action = `/Admin/Categories/Delete/${id}`;

        const warningBox = document.getElementById('deleteWarningWithProducts');
        const safeBox = document.getElementById('deleteSafeMessage');
        const confirmBtn = document.getElementById('confirmDeleteButton');

        if (productCount > 0) {
            document.getElementById('deleteProductCount').textContent = productCount;
            warningBox.style.display = 'block';
            safeBox.style.display = 'none';
            confirmBtn.disabled = true;
            confirmBtn.style.opacity = '0.5';
            confirmBtn.style.cursor = 'not-allowed';
            confirmBtn.textContent = 'Cannot Delete (Has Products)';
        } else {
            warningBox.style.display = 'none';
            safeBox.style.display = 'block';
            confirmBtn.disabled = false;
            confirmBtn.style.opacity = '1';
            confirmBtn.style.cursor = 'pointer';
            confirmBtn.textContent = 'Yes, Delete Category';
        }

        document.getElementById('deleteCategoryModal').style.display = 'flex';
    }

    function closeDeleteCategoryModal() {
        document.getElementById('deleteCategoryModal').style.display = 'none';
    }

    window.addEventListener('click', function(e) {
        const modal = document.getElementById('deleteCategoryModal');
        if (e.target === modal) {
            closeDeleteCategoryModal();
        }
    });
</script>
