@model Dreamflykit.Application.BeautyHub.Models.BeautyHubDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Flipkart Beauty & Personal Care Hub Management";
    var hub = Model ?? Dreamflykit.Application.BeautyHub.Models.BeautyHubDto.CreateDefault();
    var theme = hub.ThemeSettings ?? new Dreamflykit.Application.BeautyHub.Models.BeautyThemeSettingsDto();
    var hero = hub.HeroBanner ?? new Dreamflykit.Application.BeautyHub.Models.BeautyHeroBannerDto();
    var slides = hero.Slides ?? new List<Dreamflykit.Application.BeautyHub.Models.BeautyHeroSlideDto>();
    var promo = hub.PromoBanners ?? new Dreamflykit.Application.BeautyHub.Models.BeautyPromoBannersDto();
    var promoCards = promo.Cards ?? new List<Dreamflykit.Application.BeautyHub.Models.BeautyPromoCardDto>();
    var subCats = hub.SubCategories?.Items ?? new List<Dreamflykit.Application.BeautyHub.Models.BeautySubCategoryItemDto>();
    var spotlight = hub.SpotlightBanner ?? new Dreamflykit.Application.BeautyHub.Models.BeautySpotlightBannerDto();
    var giftsHer = hub.SpecialGiftsForHer ?? new Dreamflykit.Application.BeautyHub.Models.BeautyArchedSectionDto();
    var giftsHim = hub.GrandGiftsForHim ?? new Dreamflykit.Application.BeautyHub.Models.BeautyArchedSectionDto();
    var dualBanners = hub.DualBanners ?? new Dreamflykit.Application.BeautyHub.Models.BeautyDualBannersDto();
    var premiumGifts = hub.PremiumGifts ?? new Dreamflykit.Application.BeautyHub.Models.BeautyPremiumGiftsDto();
    var festiveLooks = hub.FestiveLooks ?? new Dreamflykit.Application.BeautyHub.Models.BeautyFestiveLooksDto();
    var limitedDeals = hub.LimitedDealsRibbon ?? new Dreamflykit.Application.BeautyHub.Models.BeautyLimitedDealsRibbonDto();
    var flashDeals = hub.FlashDealsTimer ?? new Dreamflykit.Application.BeautyHub.Models.BeautyFlashDealsTimerDto();
    var under99 = hub.BeautyPicksUnder99 ?? new Dreamflykit.Application.BeautyHub.Models.BeautyPicksUnder99Dto();
    var bigBrands = hub.BiggestBrands ?? new Dreamflykit.Application.BeautyHub.Models.BeautyBiggestBrandsDto();
    var partners = hub.BeautyPartners ?? new Dreamflykit.Application.BeautyHub.Models.BeautyPartnersDto();
    var brandNew = hub.BrandNewInBeauty ?? new Dreamflykit.Application.BeautyHub.Models.BeautyBrandNewDto();
}

@Html.AntiForgeryToken()

<div class="dk-admin-content-container" style="max-width: 1400px; margin: 0 auto; padding: 24px 20px;">

    <!-- TOP HEADER & CONTROLS -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <span style="background: linear-gradient(135deg, #e11d48, #be123c); color: #ffffff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 6px; letter-spacing: 0.5px;">💄 FLIPKART BEAUTY HUB</span>
                <span style="background: #fef08a; color: #854d0e; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 6px;">DIWALI &amp; FESTIVE GLOW THEME</span>
            </div>
            <h1 style="font-size: 26px; font-weight: 900; color: #0f172a; margin: 0;">Beauty &amp; Personal Care Store Management</h1>
            <p style="font-size: 13.5px; color: #64748b; margin: 4px 0 0 0;">
                Full control over Diwali festive frames, edge-to-edge banners, 17 category shortcuts, arched carousels, flash deals, and image uploads with "Uploading Soon" placeholders.
            </p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a href="/category/beauty" target="_blank" class="dk-btn" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 10px 18px; font-size: 13.5px; font-weight: 700; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <span>👁️</span> Preview Live Store
            </a>
            <form asp-action="ResetToDefault" method="post" style="display: inline;" onsubmit="return confirm('Reset all Beauty Hub settings to official Flipkart defaults?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="dk-btn" style="background: #fff; color: #dc2626; border: 1px solid #fca5a5; padding: 10px 16px; font-size: 13px; font-weight: 700; border-radius: 8px; cursor: pointer;">
                    ↺ Reset Defaults
                </button>
            </form>
            <button type="button" class="dk-btn" id="btnSaveBeautyTop" style="background: #e11d48; color: #ffffff; border: none; padding: 11px 26px; font-size: 14px; font-weight: 800; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; box-shadow: 0 4px 14px rgba(225, 29, 72, 0.35);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Save All Changes
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; font-weight: 600;">
            ✅ @TempData["SuccessMessage"]
        </div>
    }

    <!-- 0. FESTIVAL THEME SETTINGS -->
    <div class="dk-admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 22px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px; flex-wrap: wrap; gap: 10px;">
            <div>
                <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">0. Festival Theme, Frame Design &amp; Notice Bar</h2>
                <p style="font-size: 13px; color: #64748b; margin: 3px 0 0 0;">Control Diwali/Festive mode, custom Indian decorative arch frames, and gold glitter trim.</p>
            </div>
            <div style="display: flex; gap: 16px; align-items: center;">
                <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 800; color: #e11d48; cursor: pointer;">
                    <input type="checkbox" id="themeIsFestiveEnabled" @(theme.IsFestiveEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #e11d48;" />
                    🎉 Enable Festival / Diwali Mode
                </label>
                <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 800; color: #d97706; cursor: pointer;">
                    <input type="checkbox" id="themeDiyaDecoration" @(theme.DiyaDecorationEnabled ? "checked" : "") style="width: 18px; height: 18px; accent-color: #d97706;" />
                    🪔 Show Hanging Diyas &amp; Sparkles
                </label>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 16px;">
            <div>
                <label style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">Theme Title</label>
                <input type="text" id="themeName" value="@theme.ThemeName" placeholder="e.g. BIG BANG DIWALI" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
            </div>
            <div>
                <label style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">Tagline / Subheading</label>
                <input type="text" id="themeTagline" value="@theme.ThemeTagline" placeholder="e.g. LOWEST PRICE OF 2026 • Beauty, food & more" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
            </div>
            <div>
                <label style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">Festival Frame Design Style</label>
                <select id="themeFrameDesignStyle" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; font-weight: 600;">
                    <option value="FestiveArchedGolden" selected="@(theme.FrameDesignStyle == "FestiveArchedGolden")">🪔 Golden Jharokha Festive Arch (Flipkart Style)</option>
                    <option value="RoyalMughalArch" selected="@(theme.FrameDesignStyle == "RoyalMughalArch")">👑 Royal Scalloped Arch with Floral Trim</option>
                    <option value="ModernGlamGlow" selected="@(theme.FrameDesignStyle == "ModernGlamGlow")">✨ Modern Glamour Gold Glow Frame</option>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">Gold Accent Color</label>
                <input type="color" id="themeAccentGold" value="@theme.AccentGold" style="width: 100%; height: 42px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 4px; cursor: pointer;" />
            </div>
        </div>

        <div>
            <label style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">Top Announcement Bar Text</label>
            <input type="text" id="themeNoticeBarText" value="@theme.NoticeBarText" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
        </div>
    </div>

    <!-- 1. FULL WIDTH HERO BANNER CAROUSEL -->
    <div class="dk-admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 22px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px; flex-wrap: wrap; gap: 10px;">
            <div>
                <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">1. Full-Width Hero Banner (Carousel)</h2>
                <p style="font-size: 13px; color: #64748b; margin: 3px 0 0 0;">Large edge-to-edge Diwali banner with auto-play, timer, and image upload with "Uploading Soon" toggle.</p>
            </div>
            <div style="display: flex; gap: 16px; align-items: center;">
                <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: #334155; cursor: pointer;">
                    <input type="checkbox" id="heroIsEnabled" @(hero.IsEnabled ? "checked" : "") style="width: 16px; height: 16px; accent-color: #e11d48;" />
                    Enabled
                </label>
                <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: #334155; cursor: pointer;">
                    <input type="checkbox" id="heroAutoPlay" @(hero.AutoPlay ? "checked" : "") style="width: 16px; height: 16px; accent-color: #e11d48;" />
                    Auto-Rotate
                </label>
                <button type="button" class="dk-btn" onclick="addHeroSlide()" style="background: #f1f5f9; color: #0f172a; border: 1px solid #cbd5e1; padding: 6px 14px; font-size: 12.5px; font-weight: 800; border-radius: 6px; cursor: pointer;">
                    + Add New Slide
                </button>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 200px 1fr; gap: 16px; margin-bottom: 20px; align-items: center;">
            <div>
                <label style="display: block; font-size: 13px; font-weight: 800; color: #1e293b; margin-bottom: 6px;">⏱️ Slide Duration (Seconds)</label>
                <input type="number" id="heroIntervalSeconds" value="@hero.IntervalSeconds" min="1" max="60" style="width: 100%; padding: 8px 12px; border: 2px solid #e11d48; border-radius: 8px; font-size: 14px; font-weight: 800;" />
            </div>
            <div style="font-size: 13px; color: #64748b;">
                Slides will automatically advance according to this timer. Each slide has its own image, link, title, and "Uploading Soon" status.
            </div>
        </div>

        <!-- Hero Slides List -->
        <div id="heroSlidesList" style="display: flex; flex-direction: column; gap: 16px;">
            @for (int i = 0; i < slides.Count; i++)
            {
                var s = slides[i];
                <div class="hero-slide-row" data-id="@s.Id" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="font-weight: 800; font-size: 13.5px; color: #0f172a;">Slide #@(i + 1) — @s.Title</span>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <label style="font-size: 12.5px; font-weight: 700; color: #d97706; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
                                <input type="checkbox" class="slide-uploading-soon" @(s.IsUploadingSoon ? "checked" : "") style="accent-color: #d97706;" />
                                ⏳ Mark "Uploading Soon"
                            </label>
                            <button type="button" onclick="this.closest('.hero-slide-row').remove()" style="background: none; border: none; color: #ef4444; font-size: 12px; font-weight: 700; cursor: pointer;">✕ Remove</button>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 12px;">
                        <div>
                            <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 4px;">Tag Badge</label>
                            <input type="text" class="slide-tag" value="@s.TagBadge" style="width: 100%; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 4px;">Main Title</label>
                            <input type="text" class="slide-title" value="@s.Title" style="width: 100%; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 4px;">Price Highlight / Offer</label>
                            <input type="text" class="slide-price" value="@s.PriceHighlight" style="width: 100%; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 4px;">Button Text</label>
                            <input type="text" class="slide-button" value="@s.ButtonText" style="width: 100%; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                        </div>
                        <div style="grid-column: 1 / -1;">
                            <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 4px;">Subtitle / Tagline</label>
                            <input type="text" class="slide-sub" value="@s.Subtitle" style="width: 100%; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: center;">
                        <div>
                            <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 4px;">Target URL</label>
                            <input type="text" class="slide-url" value="@s.TargetUrl" style="width: 100%; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 4px;">Banner Image URL or Upload</label>
                            <div style="display: flex; gap: 6px;">
                                <input type="text" class="slide-img" value="@s.ImageUrl" style="flex: 1; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                                <button type="button" onclick="triggerUpload(this)" style="background: #e11d48; color: #fff; border: none; padding: 7px 14px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap;">
                                    Upload
                                </button>
                                <input type="file" style="display: none;" accept="image/*" onchange="uploadFile(this)" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 2. PROMO BANNERS (3 Across / Bank Offer Row) -->
    <div class="dk-admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 22px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
            <div>
                <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">2. Promo Banners (3-Card Carousel with Bank Offer)</h2>
                <p style="font-size: 13px; color: #64748b; margin: 3px 0 0 0;">Features Gen-Z Faves, Luscious locks, Super savings, and SBI daily refreshed bank discount.</p>
            </div>
            <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: #334155; cursor: pointer;">
                <input type="checkbox" id="promoIsEnabled" @(promo.IsEnabled ? "checked" : "") style="width: 16px; height: 16px; accent-color: #e11d48;" />
                Enabled
            </label>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label style="font-size: 13px; font-weight: 700; color: #1e293b; display: block; margin-bottom: 4px;">Bank Offer Tagline</label>
                <input type="text" id="promoBankHeader" value="@promo.BankOfferHeader" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px;" />
            </div>
            <div>
                <label style="font-size: 13px; font-weight: 700; color: #1e293b; display: block; margin-bottom: 4px;">Bank Offer Detail Text</label>
                <input type="text" id="promoBankSub" value="@promo.BankOfferSubtext" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px;" />
            </div>
        </div>

        <div id="promoCardsList" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
            @for (int i = 0; i < promoCards.Count; i++)
            {
                var pc = promoCards[i];
                <div class="promo-card-item" data-id="@pc.Id" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-weight: 800; font-size: 13px; color: #0f172a;">Card #@(i + 1)</span>
                        <label style="font-size: 11.5px; font-weight: 700; color: #d97706; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
                            <input type="checkbox" class="promo-uploading-soon" @(pc.IsUploadingSoon ? "checked" : "") style="accent-color: #d97706;" />
                            ⏳ Uploading Soon
                        </label>
                    </div>

                    <div style="margin-bottom: 8px;">
                        <label style="font-size: 11.5px; font-weight: 700; color: #475569; display: block;">Title</label>
                        <input type="text" class="promo-title" value="@pc.Title" style="width: 100%; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                        <div>
                            <label style="font-size: 11.5px; font-weight: 700; color: #475569; display: block;">Discount Text</label>
                            <input type="text" class="promo-discount" value="@pc.DiscountHighlight" style="width: 100%; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                        </div>
                        <div>
                            <label style="font-size: 11.5px; font-weight: 700; color: #475569; display: block;">Target URL</label>
                            <input type="text" class="promo-target" value="@pc.TargetUrl" style="width: 100%; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                        </div>
                    </div>

                    <div style="margin-bottom: 8px;">
                        <label style="font-size: 11.5px; font-weight: 700; color: #475569; display: block;">Subtitle / Brands</label>
                        <input type="text" class="promo-sub" value="@pc.Subtitle" style="width: 100%; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;" />
                    </div>

                    <div>
                        <label style="font-size: 11.5px; font-weight: 700; color: #475569; display: block;">Image URL or Upload</label>
                        <div style="display: flex; gap: 6px;">
                            <input type="text" class="promo-img" value="@pc.ImageUrl" style="flex: 1; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12.5px;" />
                            <button type="button" onclick="triggerUpload(this)" style="background: #e11d48; color: #fff; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">
                                Upload
                            </button>
                            <input type="file" style="display: none;" accept="image/*" onchange="uploadFile(this)" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 3. QUICK CATEGORY & SHORTCUT CHIPS (17 Icons) -->
    <div class="dk-admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 22px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
            <div>
                <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">3. Quick Category &amp; Deal Shortcuts (17 Icons Grid)</h2>
                <p style="font-size: 13px; color: #64748b; margin: 3px 0 0 0;">Flipkart-style round/square shortcuts: Skincare, Top 50 Deals, Men's grooming, Global Luxe, Derma store, etc.</p>
            </div>
            <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: #334155; cursor: pointer;">
                <input type="checkbox" id="subCatsIsEnabled" @(hub.SubCategories?.IsEnabled == true ? "checked" : "") style="width: 16px; height: 16px; accent-color: #e11d48;" />
                Enabled
            </label>
        </div>

        <div id="subCatsList" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
            @for (int i = 0; i < subCats.Count; i++)
            {
                var sc = subCats[i];
                <div class="subcat-item-row" data-id="@sc.Id" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px;">
                    <div style="display: flex; gap: 8px; margin-bottom: 6px; align-items: center;">
                        <input type="text" class="subcat-icon" value="@sc.Icon" style="width: 44px; text-align: center; font-size: 18px; padding: 4px; border: 1px solid #cbd5e1; border-radius: 6px;" title="Emoji icon or symbol" />
