function syncColorInput(pickerId, textId) {
    const picker = document.getElementById(pickerId);
    const text = document.getElementById(textId);
    if (picker && text) {
        text.value = picker.value.toUpperCase();
        updateLivePreview();
    }
}

function syncColorPicker(textId, pickerId) {
    const text = document.getElementById(textId);
    const picker = document.getElementById(pickerId);
    if (text && picker && /^#[0-9A-Fa-f]{6}$/.test(text.value.trim())) {
        picker.value = text.value.trim();
        updateLivePreview();
    }
}

function onDarkModeToggle(isDark) {
    if (isDark) {
        const currentBg = document.getElementById('theme_BackgroundColor').value;
        if (getLuminance(currentBg) > 0.45) {
            document.getElementById('theme_BackgroundColor').value = '#0f172a';
            document.getElementById('theme_BackgroundColorPicker').value = '#0f172a';
            document.getElementById('theme_CardBackgroundColor').value = '#1e293b';
            document.getElementById('theme_CardBackgroundColorPicker').value = '#1e293b';
        }
    } else {
        const currentBg = document.getElementById('theme_BackgroundColor').value;
        if (getLuminance(currentBg) <= 0.45) {
            document.getElementById('theme_BackgroundColor').value = '#f8fafc';
            document.getElementById('theme_BackgroundColorPicker').value = '#f8fafc';
            document.getElementById('theme_CardBackgroundColor').value = '#ffffff';
            document.getElementById('theme_CardBackgroundColorPicker').value = '#ffffff';
        }
    }
    updateLivePreview();
}

function getLuminance(hex) {
    if (!hex) return 1.0;
    hex = hex.replace('#', '').trim();
    if (hex.length === 3) hex = hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];
    if (hex.length !== 6) return 1.0;
    try {
        const r = parseInt(hex.substring(0, 2), 16) / 255.0;
        const g = parseInt(hex.substring(2, 4), 16) / 255.0;
        const b = parseInt(hex.substring(4, 6), 16) / 255.0;
        const a = [r, g, b].map(v => v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4));
        return 0.2126 * a[0] + 0.7152 * a[1] + 0.0722 * a[2];
    } catch(e) {
        return 1.0;
    }
}

function getContrastRatio(hex1, hex2) {
    const l1 = getLuminance(hex1);
    const l2 = getLuminance(hex2);
    const lighter = Math.max(l1, l2);
    const darker = Math.min(l1, l2);
    return ((lighter + 0.05) / (darker + 0.05));
}

function updateLivePreview() {
    const primary = document.getElementById('theme_PrimaryColor')?.value.trim() || '#ea580c';
    const secondary = document.getElementById('theme_SecondaryColor')?.value.trim() || '#034694';
    const bg = document.getElementById('theme_BackgroundColor')?.value.trim() || '#f8fafc';
    const cardBg = document.getElementById('theme_CardBackgroundColor')?.value.trim() || '#ffffff';
    const brandName = document.getElementById('theme_BrandName')?.value.trim() || 'BOOKSFLIX';
    const isDark = document.getElementById('theme_IsDarkThemeEnabled')?.checked || false;

    const bgLum = getLuminance(bg);
    const isBgLight = !isDark && (bgLum > 0.45);
    const textColor = isBgLight ? '#0f172a' : '#ffffff';
    const textMuted = isBgLight ? '#64748b' : '#94a3b8';
    const borderColor = isBgLight ? '#e2e8f0' : 'rgba(255, 255, 255, 0.15)';

    const primaryLum = getLuminance(primary);
    const btnTextColor = primaryLum > 0.45 ? '#0f172a' : '#ffffff';

    const textRatio = getContrastRatio(bg, textColor).toFixed(1);
    const btnRatio = getContrastRatio(primary, btnTextColor).toFixed(1);

    const ratioVal = document.getElementById('contrastRatioValue');
    const ratioStatus = document.getElementById('contrastStatus');
    const badge = document.getElementById('contrastBadge');
    const textLabel = document.getElementById('contrastTextColorLabel');

    if (ratioVal) ratioVal.innerText = `${textRatio} : 1`;
    if (textLabel) {
        textLabel.innerText = `Text: ${textColor} (${isBgLight ? 'High-Contrast Dark Slate' : 'Crisp White'})`;
        textLabel.setAttribute('data-hex', textColor);
    }

    if (ratioStatus && badge) {
        if (textRatio >= 7.0) {
            ratioStatus.innerText = 'Excellent (AAA)';
            ratioStatus.style.color = '#16a34a';
            badge.innerText = '✓ AAA Compliant';
            badge.style.background = '#dcfce7';
            badge.style.color = '#166534';
            badge.style.borderColor = '#bbf7d0';
        } else if (textRatio >= 4.5) {
            ratioStatus.innerText = 'Good (AA)';
            ratioStatus.style.color = '#2563eb';
            badge.innerText = '✓ AA Passed';
            badge.style.background = '#dbeafe';
            badge.style.color = '#1e40af';
            badge.style.borderColor = '#bfdbfe';
        } else {
            ratioStatus.innerText = 'Low Contrast';
            ratioStatus.style.color = '#ea580c';
            badge.innerText = '⚠ Review Contrast';
            badge.style.background = '#fff7ed';
            badge.style.color = '#c2410c';
            badge.style.borderColor = '#fed7aa';
        }
    }

    const btnRatioVal = document.getElementById('btnContrastRatioValue');
    const btnRatioStatus = document.getElementById('btnContrastStatus');
    const btnTextLabel = document.getElementById('btnContrastTextColorLabel');
    if (btnRatioVal) btnRatioVal.innerText = `${btnRatio} : 1`;
    if (btnTextLabel) {
        btnTextLabel.innerText = `Button Text: ${btnTextColor} (${btnTextColor === '#ffffff' ? 'White' : 'Dark'})`;
        btnTextLabel.setAttribute('data-hex', btnTextColor);
    }
    if (btnRatioStatus) {
        btnRatioStatus.innerText = btnRatio >= 4.5 ? 'AA Passed' : (btnRatio >= 3.0 ? 'Large Text AA' : 'Noticeable');
        btnRatioStatus.style.color = btnRatio >= 4.5 ? '#16a34a' : '#d97706';
    }

    const container = document.getElementById('livePreviewContainer');
    if (container) {
        container.style.background = bg;
        container.style.borderColor = borderColor;
    }

    const miniSubnav = document.getElementById('miniSubnav');
    if (miniSubnav) {
        miniSubnav.style.background = isBgLight ? 'rgba(255, 255, 255, 0.95)' : 'rgba(15, 23, 42, 0.96)';
        miniSubnav.style.borderBottomColor = borderColor;
    }

    const miniEmblem = document.getElementById('miniEmblem');
    if (miniEmblem) {
        miniEmblem.style.background = `linear-gradient(135deg, ${secondary}, ${primary})`;
    }

    const miniBrandP1 = document.getElementById('miniBrandP1');
    const miniBrandP2 = document.getElementById('miniBrandP2');
    if (miniBrandP1 && miniBrandP2) {
        if (brandName.toUpperCase() === 'BOOKSFLIX') {
            miniBrandP1.innerText = 'BOOKS';
            miniBrandP1.style.color = isBgLight ? secondary : '#38bdf8';
            miniBrandP2.innerText = 'FLIX';
            miniBrandP2.style.color = primary;
        } else {
            miniBrandP1.innerText = brandName;
            miniBrandP1.style.color = isBgLight ? secondary : '#38bdf8';
            miniBrandP2.innerText = '';
        }
    }

    const miniTabActive = document.getElementById('miniTabActive');
    if (miniTabActive) {
        miniTabActive.style.color = primary;
        miniTabActive.style.borderBottomColor = primary;
    }

    const miniBillboardBadge = document.getElementById('miniBillboardBadge');
    if (miniBillboardBadge) {
        miniBillboardBadge.style.background = primary;
        miniBillboardBadge.style.color = btnTextColor;
    }

    const miniBillboard = document.getElementById('miniBillboard');
    if (miniBillboard) {
        miniBillboard.style.background = isDark 
            ? 'linear-gradient(77deg, rgba(15, 23, 42, 0.98) 0%, rgba(15, 23, 42, 0.88) 50%, rgba(234, 88, 12, 0.3) 100%)'
            : `linear-gradient(77deg, ${secondary} 0%, rgba(15, 23, 42, 0.88) 50%, rgba(234, 88, 12, 0.35) 100%)`;
    }

    const miniBtnCart = document.getElementById('miniBtnCart');
    if (miniBtnCart) {
        miniBtnCart.style.background = primary;
        miniBtnCart.style.color = btnTextColor;
    }

    const miniBtnReading = document.getElementById('miniBtnReading');
    if (miniBtnReading) {
        miniBtnReading.style.color = secondary;
    }

    const miniShelfTitle = document.getElementById('miniShelfTitle');
    if (miniShelfTitle) {
        miniShelfTitle.style.color = textColor;
    }

    const miniShelfMark = document.getElementById('miniShelfMark');
    if (miniShelfMark) {
        miniShelfMark.style.color = primary;
    }

    const miniCard = document.getElementById('miniCard');
    if (miniCard) {
        miniCard.style.background = cardBg;
        miniCard.style.borderColor = borderColor;
    }

    const miniCardTitle = document.getElementById('miniCardTitle');
    if (miniCardTitle) {
        miniCardTitle.style.color = isBgLight ? '#0f172a' : '#ffffff';
    }

    const miniCardAuthor = document.getElementById('miniCardAuthor');
    if (miniCardAuthor) {
        miniCardAuthor.style.color = textMuted;
    }

    const miniCardPrice = document.getElementById('miniCardPrice');
    if (miniCardPrice) {
        miniCardPrice.style.color = isBgLight ? '#0f172a' : '#ffffff';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    updateLivePreview();
});

// ----------------------------------------------------
// Save Complete Configuration
// ----------------------------------------------------
async function saveStoryBooksHubConfig() {
    const btn = document.getElementById('btnSaveStoryBooksTop');
    if (btn) btn.disabled = true;

    try {
        const payload = {
            ThemeSettings: {
                BrandName: document.getElementById('theme_BrandName').value.trim(),
                Tagline: document.getElementById('theme_Tagline').value.trim(),
                PrimaryColor: document.getElementById('theme_PrimaryColor').value.trim(),
                SecondaryColor: document.getElementById('theme_SecondaryColor').value.trim(),
                BackgroundColor: document.getElementById('theme_BackgroundColor').value.trim(),
                CardBackgroundColor: document.getElementById('theme_CardBackgroundColor').value.trim(),
                TextColor: document.getElementById('contrastTextColorLabel')?.getAttribute('data-hex') || '#0f172a',
                SubtitleColor: '#475569',
                IsDarkThemeEnabled: document.getElementById('theme_IsDarkThemeEnabled').checked,
                ThemePreset: document.getElementById('theme_ThemePreset')?.value || 'Dreamflykit',
                // Backward compatibility:
                PrimaryRed: document.getElementById('theme_PrimaryColor').value.trim(),
                DarkBackground: document.getElementById('theme_BackgroundColor').value.trim(),
                CardBackground: document.getElementById('theme_CardBackgroundColor').value.trim()
            },
            HeroBillboard: {
                IsEnabled: document.getElementById('billboard_IsEnabled').checked,
                Title: document.getElementById('billboard_Title').value.trim(),
                Author: document.getElementById('billboard_Author').value.trim(),
                TagBadge: document.getElementById('billboard_TagBadge').value.trim(),
                GenreTags: document.getElementById('billboard_GenreTags').value.trim(),
                Synopsis: document.getElementById('billboard_Synopsis').value.trim(),
                ImageUrl: document.getElementById('billboard_ImageUrl').value.trim(),
                IsUploadingSoon: document.getElementById('billboard_IsUploadingSoon').checked,
                PrimaryButtonText: document.getElementById('billboard_PrimaryButtonText').value.trim(),
                SecondaryButtonText: document.getElementById('billboard_SecondaryButtonText').value.trim(),
                ReadTime: "340 Pages • ~6h Read",
                Language: "English",
                Price: parseFloat(document.getElementById('billboard_Price').value) || 0,
                OriginalPrice: parseFloat(document.getElementById('billboard_OriginalPrice').value) || 0,
                DiscountPercent: parseInt(document.getElementById('billboard_DiscountPercent').value) || 0,
                Rating: parseFloat(document.getElementById('billboard_Rating').value) || 4.9,
                ReviewCount: 1240
            },
            StoryBooksBanner: {
                IsEnabled: document.getElementById('sbBanner_IsEnabled').checked,
                Title: document.getElementById('sbBanner_Title').value.trim(),
                Subtitle: document.getElementById('sbBanner_Subtitle').value.trim(),
                TagBadge: document.getElementById('sbBanner_TagBadge').value.trim(),
                MetaTags: document.getElementById('sbBanner_MetaTags').value.trim(),
                ImageUrl: document.getElementById('sbBanner_ImageUrl').value.trim(),
                IsUploadingSoon: document.getElementById('sbBanner_IsUploadingSoon').checked,
                PrimaryButtonText: document.getElementById('sbBanner_PrimaryButtonText').value.trim(),
                SecondaryButtonText: document.getElementById('sbBanner_SecondaryButtonText').value.trim(),
                PrimaryButtonUrl: "#explore",
                SecondaryButtonUrl: "#info"
            },
            NewPopularBanner: {
                IsEnabled: document.getElementById('npBanner_IsEnabled').checked,
                Title: document.getElementById('npBanner_Title').value.trim(),
                Subtitle: document.getElementById('npBanner_Subtitle').value.trim(),
                TagBadge: document.getElementById('npBanner_TagBadge').value.trim(),
                MetaTags: document.getElementById('npBanner_MetaTags').value.trim(),
                ImageUrl: document.getElementById('npBanner_ImageUrl').value.trim(),
                IsUploadingSoon: document.getElementById('npBanner_IsUploadingSoon').checked,
                PrimaryButtonText: document.getElementById('npBanner_PrimaryButtonText').value.trim(),
                SecondaryButtonText: document.getElementById('npBanner_SecondaryButtonText').value.trim(),
                PrimaryButtonUrl: "#explore",
                SecondaryButtonUrl: "#info"
            },
            LanguagesBanner: {
                IsEnabled: document.getElementById('langBanner_IsEnabled').checked,
                Title: document.getElementById('langBanner_Title').value.trim(),
                Subtitle: document.getElementById('langBanner_Subtitle').value.trim(),
                TagBadge: document.getElementById('langBanner_TagBadge').value.trim(),
                MetaTags: document.getElementById('langBanner_MetaTags').value.trim(),
                ImageUrl: document.getElementById('langBanner_ImageUrl').value.trim(),
                IsUploadingSoon: document.getElementById('langBanner_IsUploadingSoon').checked,
                PrimaryButtonText: document.getElementById('langBanner_PrimaryButtonText').value.trim(),
                SecondaryButtonText: document.getElementById('langBanner_SecondaryButtonText').value.trim(),
                PrimaryButtonUrl: "#explore",
                SecondaryButtonUrl: "#info"
            },
            Sections: [],
            Genres: [],
            Languages: [],
            Preferences: []
        };

        // Collect Sections
        document.querySelectorAll('.sbf-section-card').forEach((secEl, sIdx) => {
            const sec = {
                Id: 'section-' + (sIdx + 1),
                Title: secEl.querySelector('.sec-title').value.trim(),
                Subtitle: secEl.querySelector('.sec-sub').value.trim(),
                DisplayType: secEl.querySelector('.sec-type').value,
                DisplayOrder: sIdx + 1,
                IsActive: secEl.querySelector('.sec-active').checked,
                Books: []
            };

            secEl.querySelectorAll('.sbf-book-editor-card').forEach((bEl, bIdx) => {
                sec.Books.push({
                    Id: bEl.querySelector('.book-id').value || ('book-' + (sIdx + 1) + '-' + (bIdx + 1)),
                    Title: bEl.querySelector('.book-title').value.trim(),
                    Author: bEl.querySelector('.book-author').value.trim(),
                    CoverImageUrl: bEl.querySelector('.book-cover-url').value.trim(),
                    IsUploadingSoon: bEl.querySelector('.book-uploading-soon').checked,
                    Price: parseFloat(bEl.querySelector('.book-price').value) || 0,
                    OriginalPrice: parseFloat(bEl.querySelector('.book-orig-price').value) || 0,
                    DiscountPercent: 0,
                    Rating: 4.8,
                    GenreSlug: bEl.querySelector('.book-genre-slug').value.trim(),
                    GenreName: bEl.querySelector('.book-genre-slug').value.trim(),
                    Language: bEl.querySelector('.book-lang').value.trim(),
                    EditionPreference: 'original',
                    Synopsis: 'University curated literary work.',
                    IsTop10: sec.DisplayType === 'top10',
                    Top10Rank: sec.DisplayType === 'top10' ? (bIdx + 1) : 0,
                    ReadingProgress: '',
                    ProgressPercent: 0,
                    BadgeText: ''
                });
            });

            payload.Sections.push(sec);
        });

        // Collect Genres
        document.querySelectorAll('.genre-row').forEach(row => {
            payload.Genres.push({
                Emoji: row.querySelector('.genre-emoji').value.trim(),
                Name: row.querySelector('.genre-name').value.trim(),
                Slug: row.querySelector('.genre-slug').value.trim(),
                BookCount: 0
            });
        });

        // Collect Languages
        document.querySelectorAll('.lang-row').forEach(row => {
            payload.Languages.push({
                Code: row.querySelector('.lang-code').value.trim(),
                Name: row.querySelector('.lang-name').value.trim(),
                NativeLabel: row.querySelector('.lang-native').value.trim(),
                BookCount: 0
            });
        });

        // Collect Preferences
        document.querySelectorAll('.pref-row').forEach(row => {
            payload.Preferences.push({
                Key: row.querySelector('.pref-key').value.trim(),
                Label: row.querySelector('.pref-label').value.trim()
            });
        });

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const resp = await fetch('/Admin/StoryBooksHub/Save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(payload)
        });

        const result = await resp.json();
        if (result.success) {
            alert('✓ Story Books Hub settings saved successfully!');
            window.location.reload();
        } else {
            alert('Save failed: ' + (result.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Save error: ' + err.message);
    } finally {
        if (btn) btn.disabled = false;
    }
}
</script>
