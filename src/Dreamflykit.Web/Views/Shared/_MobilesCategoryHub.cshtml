/* ========================================================
   3. FLAGSHIP SPECIALS: 3-SECTION 3D SLIDE CAROUSEL
========================================================= */
.dk-flagship-three-section {
    margin-bottom: 24px;
    width: 100%;
}
.dk-flagship-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    width: 100%;
}
@@media (max-width: 992px) {
    .dk-flagship-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
@@media (max-width: 640px) {
    .dk-flagship-grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 12px;
        padding-bottom: 8px;
    }
    .dk-flagship-col-carousel {
        min-width: 290px;
        scroll-snap-align: start;
        flex-shrink: 0;
    }
}

/* Column Carousel Container */
.dk-flagship-col-carousel {
    position: relative;
    border-radius: 18px;
    overflow: visible;
}
.dk-flagship-slides-track {
    position: relative;
    width: 100%;
    min-height: 220px;
}

/* Individual 3D Card (Matching Flipkart reference image) */
.dk-flagship-card {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: radial-gradient(circle at 75% 30%, #1e293b 0%, #090d16 100%);
    border-radius: 18px;
    padding: 16px 18px 20px 18px;
    text-decoration: none;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
    border: 2px solid transparent;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    overflow: hidden;
    perspective: 1000px;
}
.dk-flagship-card.active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

/* 3D Fiery Metallic Ribbon Border (Flipkart Screenshot Accent) */
.dk-flagship-ribbon-border {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    padding: 2.5px;
    background: linear-gradient(135deg, var(--glow-color, #f97316) 0%, #fbbf24 35%, #ea580c 70%, #dc2626 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    box-shadow: inset 0 0 14px var(--glow-color, rgba(249, 115, 22, 0.5));
}
.dk-flagship-card:hover {
    transform: translateY(-6px) perspective(900px) rotateX(1deg);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.4), 0 0 20px var(--glow-color, rgba(249, 115, 22, 0.35));
}

/* Card Header (Badge & Rating) */
.dk-flagship-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 3;
    margin-bottom: 8px;
}
.dk-flagship-badge {
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 3px 8px;
    border-radius: 4px;
    color: #f1f5f9;
    text-transform: uppercase;
}

/* Golden Star Rating Pill (Exact Flipkart Style: bright gold with black star) */
.dk-flagship-rating-badge {
    background: #eab308;
    color: #000000;
    font-size: 11.5px;
    font-weight: 900;
    padding: 2px 7px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    box-shadow: 0 2px 8px rgba(234, 179, 8, 0.4);
}
.dk-flagship-star {
    font-size: 11px;
}

/* Body: Text on Left + 3D Popout Visual on Right */
.dk-flagship-card-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 3;
    gap: 12px;
}
.dk-flagship-text-wrap {
    flex: 1;
    min-width: 0;
}
.dk-flagship-phone-title {
    font-size: 18px;
    font-weight: 900;
    margin: 0 0 4px 0;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.dk-flagship-phone-tagline {
    font-size: 11.5px;
    color: #cbd5e1;
    margin: 0 0 10px 0;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.dk-flagship-prices {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
}
.dk-flagship-selling-price {
    font-size: 19px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.3px;
}
.dk-flagship-mrp-price {
    font-size: 12px;
    color: #94a3b8;
    text-decoration: line-through;
    font-weight: 600;
}

/* 0% EMI Gold Medallion Badge (Matching Flipkart Screenshot) */
.dk-flagship-emi-medallion {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #78350f 0%, #451a03 100%);
    border: 1px solid #f59e0b;
    padding: 3px 8px 3px 4px;
    border-radius: 20px;
    margin-bottom: 6px;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.2);
}
.dk-flagship-emi-coin {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle, #fde047 0%, #ca8a04 100%);
    border: 1.5px solid #fef08a;
    color: #000000;
    font-size: 8px;
    font-weight: 900;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 0.9;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
}
.dk-flagship-emi-coin small {
    font-size: 6px;
    font-weight: 900;
}
.dk-flagship-emi-amount {
    font-size: 12px;
    font-weight: 800;
    color: #fef08a;
    letter-spacing: -0.2px;
}
.dk-flagship-disclaimer-text {
    font-size: 10px;
    color: #94a3b8;
    display: block;
    margin-top: 2px;
}

/* 3D Popout Phone Visual (Popping out over edge like Flipkart) */
.dk-flagship-visual-wrap {
    width: 120px;
    height: 140px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.dk-flagship-phone-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.5));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s;
    transform: perspective(600px) rotateY(-8deg) rotateX(4deg);
    position: relative;
    z-index: 2;
}
.dk-flagship-card:hover .dk-flagship-phone-img {
    transform: perspective(600px) rotateY(-2deg) rotateX(0deg) scale(1.1) translateY(-4px);
    filter: drop-shadow(0 18px 26px rgba(0, 0, 0, 0.65)) drop-shadow(0 0 14px var(--glow-color, rgba(249, 115, 22, 0.4)));
}
.dk-flagship-popout-glow {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow-color, #f97316) 0%, transparent 70%);
    opacity: 0.25;
    z-index: 1;
    pointer-events: none;
}

/* Section Pagination Dots (Flipkart Dots) */
.dk-flagship-dots-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding-top: 8px;
}
.dk-flagship-dot {
    width: 8px;
