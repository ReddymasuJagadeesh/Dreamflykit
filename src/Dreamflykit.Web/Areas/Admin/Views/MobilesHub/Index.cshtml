                        </div>
                        <input type="text" class="deal-model-3d-url" placeholder="Optional .glb URL" style="width: 100%; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 11.5px;" />
                    </div>
                </div>
                <div>
                    <label style="display: block; font-size: 11.5px; font-weight: 700; color: #334155; margin-bottom: 3px;">Product Photo</label>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <input type="text" class="deal-image-url" value="/images/mobiles-hub/phones/nova2.svg" style="flex: 1; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px;" />
                        <button type="button" onclick="triggerFileUpload(this, 'image')" style="background: #2874f0; color: #ffffff; border: none; padding: 7px 12px; font-size: 12px; font-weight: 700; border-radius: 6px; cursor: pointer;">Upload</button>
                    </div>
                </div>
                <div>
                    <label style="display: block; font-size: 11.5px; font-weight: 700; color: #334155; margin-bottom: 3px;">Specifications Snippet</label>
                    <input type="text" class="deal-specs" value="6.7 AMOLED 120Hz | 50MP OIS | 5000mAh" style="width: 100%; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px;" />
                </div>
                <div>
                    <label style="display: block; font-size: 11.5px; font-weight: 700; color: #334155; margin-bottom: 3px;">Target URL</label>
                    <input type="text" class="deal-url" value="/products?category=mobiles" style="width: 100%; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px;" />
                </div>
            </div>
        </div>`;
    function addNewFlagshipSlide(colIndex) {
        const colContainer = document.querySelector(`.flagship-slides-container[data-col='${colIndex}']`);
        if (!colContainer) return;
        const currentCount = colContainer.querySelectorAll(".flagship-slide-card").length;
        const html = `
        <div class="flagship-slide-card" data-slide-index="${currentCount}" style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 12px; font-weight: 800; color: #0f172a;">Slide #${currentCount + 1}: New Phone</span>
                <button type="button" onclick="removeFlagshipSlide(this)" style="background: #fee2e2; color: #dc2626; border: none; padding: 2px 8px; font-size: 11px; font-weight: 700; border-radius: 4px; cursor: pointer;">Delete</button>
            </div>
            <input type="hidden" class="flagship-slide-id" value="sec${colIndex+1}-slide-${Date.now()}" />
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px; margin-bottom: 6px;">
                <div>
                    <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">Phone Name</label>
                    <input type="text" class="flagship-phone-name" value="Flagship Smartphone 5G" style="width: 100%; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 12.5px; font-weight: 700;" />
                </div>
                <div>
                    <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">Star Rating (★)</label>
                    <input type="text" class="flagship-rating" value="4.6" style="width: 100%; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 12px; font-weight: 800; color: #b45309;" />
                </div>
            </div>
            <div style="margin-bottom: 6px;">
                <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">Tagline Highlight</label>
                <input type="text" class="flagship-tagline" value="Next-Gen AI &amp; Studio Camera" style="width: 100%; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 12px;" />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 6px;">
                <div>
                    <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">Selling Price</label>
                    <input type="text" class="flagship-price" value="From ₹39,999*" style="width: 100%; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 12px; font-weight: 800; color: #16a34a;" />
                </div>
                <div>
                    <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">Original MRP</label>
                    <input type="text" class="flagship-orig-price" value="₹59,999" style="width: 100%; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 12px;" />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 8px; margin-bottom: 6px;">
                <div>
                    <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">0% EMI Text</label>
                    <input type="text" class="flagship-emi" value="0% EMI ₹3,333/m" style="width: 100%; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 12px; font-weight: 700; color: #b45309;" />
                </div>
                <div>
                    <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">Glow Ribbon Color</label>
                    <input type="color" class="flagship-color" value="#f97316" style="width: 100%; height: 32px; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer;" />
                </div>
            </div>
            <div style="margin-bottom: 6px;">
                <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">3D Phone Cutout Image</label>
                <div style="display: flex; gap: 6px;">
                    <input type="text" class="flagship-img-url" value="/images/mobiles-hub/phones/nova2.svg" style="flex: 1; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 11.5px;" />
                    <button type="button" onclick="triggerFileUpload(this, 'image')" style="background: #2874f0; color: #ffffff; border: none; padding: 6px 10px; font-size: 11px; font-weight: 700; border-radius: 4px; cursor: pointer;">Upload</button>
                </div>
            </div>
            <div>
                <label style="display: block; font-size: 11px; font-weight: 700; color: #475569;">Target Link</label>
                <input type="text" class="flagship-target-url" value="/products?category=mobiles" style="width: 100%; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 11.5px;" />
            </div>
        </div>`;
        colContainer.insertAdjacentHTML("beforeend", html);
    }

    function removeFlagshipSlide(btn) {
        if (confirm("Remove this flagship slide?")) {
            btn.closest(".flagship-slide-card").remove();
        }
    }

    async function saveMobilesHub() {
        const payload = {
            DefaultViewMode: document.getElementById("hubDefaultViewMode").value,
            HeroBanner: {
                IsEnabled: document.getElementById("heroIsEnabled").checked,
                EnableSlideshow: true,
                AutoPlay: document.getElementById("heroAutoPlay").checked,
                SlideIntervalSeconds: parseInt(document.getElementById("heroSlideIntervalSeconds").value, 10) || 4,
                TransitionEffect: "slide",
                BannerHeight: parseInt(document.getElementById("heroBannerHeight").value, 10) || 440,
                ThemeColor: document.getElementById("heroThemeColor").value,
                ThemeAccentColor: "#fb641b",
                Slides: []
            },
            BrandsSection: {
                IsEnabled: true,
                Title: "Explore Top Smartphone Brands",
                ViewAllUrl: "/products?category=mobiles",
                Brands: []
            },
            HighlightBanner: {
                IsEnabled: document.getElementById("flagshipIsEnabled")?.checked ?? true,
                AutoPlay: document.getElementById("flagshipAutoPlay")?.checked ?? true,
                SlideIntervalSeconds: parseInt(document.getElementById("flagshipSlideInterval")?.value, 10) || 4,
                SectionHeading: "FLAGSHIP SPECIALS",
                Sections: []
            },
            TopDealsSection: {
                IsEnabled: true,
                Title: "TOP DEALS",
                Subtitle: "Curated Smartphone Steals of the Week",
                Tagline: "Lightning Fast 5G • Mega Batteries • 100% Student Verified",
                ViewAllUrl: "/products?category=mobiles",
                Deals: []
            },
            ConfusedSection: {
                IsEnabled: true,
                Title: "CONFUSED?",
                Subtitle: "Let us pick your perfect phone in 30 seconds",
                ButtonText: "EXPLORE NOW ➔",
                TargetUrl: "/products?category=mobiles"
            },
            PromoBanner: {
                IsEnabled: true,
                Title: "Buy any Smartphone and Get a Chance to Win",
                Highlight: "GOOGLE PIXEL WATCH 5",
                ButtonText: "Shop Now ➔",
                ImageUrl: "/images/mobiles-hub/pixel-watch-promo.svg",
                TargetUrl: "/products?category=mobiles"
            },
            UnmissableDealsSection: {
                IsEnabled: true,
                Title: "UNMISSABLE DEALS",
                ViewAllUrl: "/products?category=mobiles",
                Deals: []
            }
        };

        // Collect Slides
        document.querySelectorAll("#slidesListContainer .slide-item-card").forEach((card, idx) => {
            payload.HeroBanner.Slides.push({
                Id: card.querySelector(".slide-id")?.value || ("slide-" + (idx+1)),
                DiscountBadge: card.querySelector(".slide-badge")?.value || "",
                Title: card.querySelector(".slide-title")?.value || "",
                TitleHighlight: card.querySelector(".slide-highlight")?.value || "",
                Subtitle: card.querySelector(".slide-subtitle")?.value || "",
                ImageUrl: card.querySelector(".slide-image-url")?.value || "",
                ButtonText: card.querySelector(".slide-btn-text")?.value || "Shop Now",
                TargetUrl: card.querySelector(".slide-target-url")?.value || "/products?category=mobiles",
                DisplayOrder: idx + 1,
                IsActive: card.querySelector(".slide-active")?.checked ?? true,
                IsUploadingSoon: card.querySelector(".slide-uploading-soon")?.checked ?? false
            });
        });

        // Collect Brands
        document.querySelectorAll("#brandsListContainer .brand-item-card").forEach((card, idx) => {
            payload.BrandsSection.Brands.push({
                Id: card.querySelector(".brand-id")?.value || ("brand-" + (idx+1)),
                Name: card.querySelector(".brand-name")?.value || "",
                Slug: card.querySelector(".brand-slug")?.value || "brand",
                IconUrl: card.querySelector(".brand-icon-url")?.value || "",
                ProductUrl: card.querySelector(".brand-product-url")?.value || "/products?category=mobiles",
                DisplayOrder: idx + 1
            });
        });

        // Collect Flagship Specials 3-Sections & Slides
        document.querySelectorAll("#flagshipSectionsContainer .flagship-col-card").forEach((colEl, cIdx) => {
            const colObj = {
                Id: colEl.querySelector(".flagship-col-id")?.value || ("col-" + (cIdx+1)),
                Title: colEl.querySelector(".flagship-col-title")?.value || ("Section " + (cIdx+1)),
                DisplayOrder: cIdx + 1,
                Slides: []
            };
            colEl.querySelectorAll(".flagship-slide-card").forEach((slideEl, sIdx) => {
                colObj.Slides.push({
                    Id: slideEl.querySelector(".flagship-slide-id")?.value || ("sec" + (cIdx+1) + "-slide-" + (sIdx+1)),
                    PhoneName: slideEl.querySelector(".flagship-phone-name")?.value || "",
                    Tagline: slideEl.querySelector(".flagship-tagline")?.value || "",
                    Rating: slideEl.querySelector(".flagship-rating")?.value || "4.5",
                    PriceText: slideEl.querySelector(".flagship-price")?.value || "",
                    OriginalPriceText: slideEl.querySelector(".flagship-orig-price")?.value || "",
                    EmiBadgeText: slideEl.querySelector(".flagship-emi")?.value || "",
                    OfferDisclaimer: "*Incl. All Offers",
                    ThemeGlowColor: slideEl.querySelector(".flagship-color")?.value || "#f97316",
                    ImageUrl: slideEl.querySelector(".flagship-img-url")?.value || "",
                    TargetUrl: slideEl.querySelector(".flagship-target-url")?.value || "/products?category=mobiles",
                    BadgeText: "FLAGSHIP SPECIAL",
                    DisplayOrder: sIdx + 1,
                    IsActive: true
                });
            });
            payload.HighlightBanner.Sections.push(colObj);
        });

        // Collect Deals
        document.querySelectorAll("#dealsListContainer .deal-item-card").forEach((card, idx) => {
            payload.TopDealsSection.Deals.push({
                Id: card.querySelector(".deal-id")?.value || ("deal-" + (idx+1)),
                Name: card.querySelector(".deal-name")?.value || "",
                PriceText: card.querySelector(".deal-price")?.value || "",
                OriginalPriceText: card.querySelector(".deal-orig-price")?.value || "",
                OfferTag: "Incl. All Offers",
                ImageUrl: card.querySelector(".deal-image-url")?.value || "",
                ProductUrl: card.querySelector(".deal-url")?.value || "/products?category=mobiles",
                DisplayOrder: idx + 1,
                ViewMode: card.querySelector(".deal-view-mode")?.value || "3D",
                Model3dUrl: card.querySelector(".deal-model-3d-url")?.value || null,
                ColorHex: card.querySelector(".deal-color-hex")?.value || "#2563eb",
                Specifications: card.querySelector(".deal-specs")?.value || "",
                IsUploadingSoon: card.querySelector(".deal-uploading-soon")?.checked ?? false
            });
        });

        // Collect EMI Deals
        document.querySelectorAll("#emiDealsListContainer .emi-item-card").forEach((card, idx) => {
            payload.UnmissableDealsSection.Deals.push({
                Id: card.querySelector(".emi-id")?.value || ("emi-" + (idx+1)),
                Name: card.querySelector(".emi-name")?.value || "",
                PriceText: card.querySelector(".emi-price")?.value || "",
                EmiText: card.querySelector(".emi-tag")?.value || "",
                ImageUrl: card.querySelector(".emi-img-url")?.value || "",
                ProductUrl: card.querySelector(".emi-product-url")?.value || "/products?category=mobiles",
                DisplayOrder: idx + 1,
                ViewMode: "3D"
            });
        });

        const token = document.querySelector("input[name='__RequestVerificationToken']").value;

        try {
            const res = await fetch("/Admin/MobilesHub/Save", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                alert("Mobiles Hub settings & 3D configurations saved successfully!");
                location.reload();
            } else {
                alert("Save failed: " + (data.message || "Unknown error"));
            }
        } catch (err) {
            alert("Save failed: " + err.message);
        }
    }

    document.getElementById("btnSaveMobilesTop")?.addEventListener("click", saveMobilesHub);
    document.getElementById("btnSaveMobilesBottom")?.addEventListener("click", saveMobilesHub);
</script>
