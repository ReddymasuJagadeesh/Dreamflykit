<!-- ========================================================
     JAVASCRIPT LOGIC FOR EDUCATION LOANS PAGE
========================================================= -->
<script>
    (function () {
        // 1. Partners "View More" toggle
        var btnToggle = document.getElementById("btnTogglePartners");
        if (btnToggle) {
            btnToggle.addEventListener("click", function () {
                var extraCards = document.querySelectorAll(".dk-edu-partner-card.partner-extra");
                var isExpanded = false;
                extraCards.forEach(function (c) {
                    if (c.classList.contains("is-visible")) {
                        c.classList.remove("is-visible");
                    } else {
                        c.classList.add("is-visible");
                        isExpanded = true;
                    }
                });
                btnToggle.querySelector("span").textContent = isExpanded ? "View Less ⌃" : "@eduPage.PartnersViewMoreText";
            });
        }

        // 2. Tech Courses Interactive Carousel: Move from one section to another
        var viewport = document.getElementById("coursesViewport");
        var track = document.getElementById("coursesTrack");

        if (viewport && track) {
            var cards = track.querySelectorAll(".dk-tech-course-card");
            if (cards.length > 0) {
                var intervalSec = parseInt(viewport.getAttribute("data-interval-sec") || "3", 10);
                if (isNaN(intervalSec) || intervalSec < 1) intervalSec = 3;

                var isPaused = false;
                var isSliding = false;

                // Pause movement when user hovers over courses or touches on mobile
                viewport.addEventListener("mouseenter", function () { isPaused = true; });
                viewport.addEventListener("mouseleave", function () { isPaused = false; });
                viewport.addEventListener("touchstart", function () { isPaused = true; }, { passive: true });
                viewport.addEventListener("touchend", function () { isPaused = false; });

                // Slides smoothly from right to left based on timeframe
                function slideNextRightToLeft() {
                    if (isPaused || isSliding) return;
                    var firstCard = track.firstElementChild;
                    if (!firstCard) return;

                    isSliding = true;
                    var cardWidth = firstCard.offsetWidth || 270;
                    var gap = 20;
                    var stepDistance = cardWidth + gap;

                    track.style.transition = "transform 0.65s cubic-bezier(0.25, 1, 0.5, 1)";
                    track.style.transform = "translateX(-" + stepDistance + "px)";

                    setTimeout(function () {
                        track.style.transition = "none";
                        track.style.transform = "translateX(0)";
                        track.appendChild(firstCard); // Infinite continuous loop from right to left
                        void track.offsetWidth; // flush reflow
                        isSliding = false;
                    }, 660);
                }

                setInterval(slideNextRightToLeft, intervalSec * 1000);
            }
        }
    })();

    // 3. Modal Handlers
    function openEduModal(sourceTitle) {
        var modal = document.getElementById("eduLoanModal");
        var subText = document.getElementById("eduModalSubText");
        var leadSource = document.getElementById("leadSource");
        var form = document.getElementById("frmEduLoanApplication");
        var success = document.getElementById("eduModalSuccess");

        if (subText && sourceTitle) {
            subText.textContent = "Application focus: " + sourceTitle + ". Sanctions in 48 hours with lowest interest rates.";
        }
        if (leadSource && sourceTitle) {
            leadSource.value = sourceTitle;
        }
        if (form) form.style.display = "block";
        if (success) success.style.display = "none";
        if (modal) modal.style.display = "flex";
    }

    function closeEduModal() {
        var modal = document.getElementById("eduLoanModal");
        if (modal) modal.style.display = "none";
    }

    function closeEduModalOnBackdrop(e) {
        if (e.target.id === "eduLoanModal") {
            closeEduModal();
        }
    }

    // 4. Submit Lead Application
    async function handleEduLoanSubmit(e) {
        e.preventDefault();
        var btn = document.getElementById("btnSubmitLoan");
        if (btn) {
            btn.disabled = true;
            btn.textContent = "Submitting application...";
        }

        var payload = {
            FullName: document.getElementById("leadFullName")?.value || "",
            PhoneNumber: document.getElementById("leadPhone")?.value || "",
            Email: document.getElementById("leadEmail")?.value || "",
            TargetCountry: document.getElementById("leadCountry")?.value || "",
            DesiredLoanAmount: document.getElementById("leadLoanAmount")?.value || "",
            CollateralType: document.getElementById("leadCollateral")?.value || "",
            CourseOrProgram: document.getElementById("leadProgram")?.value || "",
            Notes: "Source: " + (document.getElementById("leadSource")?.value || "Education Loans Page")
        };

        try {
            var response = await fetch("/study-abroad-hub/apply-loan", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(payload)
            });

            var result = await response.json();

            if (result.success) {
                var form = document.getElementById("frmEduLoanApplication");
                var success = document.getElementById("eduModalSuccess");
                var msg = document.getElementById("eduSuccessMsg");
                if (form) form.style.display = "none";
                if (success) success.style.display = "block";
                if (msg && result.message) msg.textContent = result.message;
            } else {
                alert(result.message || "Unable to submit application. Please try again.");
            }
        } catch (err) {
            alert("Application submitted! Our team will contact you shortly.");
            closeEduModal();
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = "Check Eligibility & Apply Now →";
            }
        }
    }
</script>
