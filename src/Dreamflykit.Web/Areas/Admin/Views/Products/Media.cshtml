@model Dreamflykit.Web.Areas.Admin.Models.ProductMediaManagementViewModel
@{
    ViewData["Title"] = $"Manage Images — {Model.ProductName}";
}

<div class="dk-admin-content-card">
    <div class="dk-admin-card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
        <div>
            <h1 class="dk-admin-card-title" style="font-size: 1.5rem; margin: 0;">Product Gallery: @Model.ProductName</h1>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0.25rem 0 0;">
                Slug: <code>@Model.ProductSlug</code> • Manage high-resolution photos and primary catalog thumbnail.
            </p>
        </div>

        <div style="display: flex; gap: 0.75rem;">
            <button type="button" class="dk-btn dk-btn-primary" onclick="openMediaPicker()">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Add from Media Library
            </button>
            <a href="/Admin/Media/Upload?mediaType=Product&ownerId=@Model.ProductId" target="_blank" class="dk-btn dk-btn-secondary">
                Upload New Photo ↗
            </a>
            <a href="/Admin/Products" class="dk-btn dk-btn-ghost">Back to Products</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="dk-alert dk-alert-success" style="margin-bottom: 1.5rem; padding: 0.75rem 1rem; background: #ecfdf5; border-left: 4px solid #10b981; color: #065f46; border-radius: 4px;">
            @msg
        </div>
    }

    @if (TempData["ErrorMessage"] is string errMsg)
    {
        <div class="dk-alert dk-alert-danger" style="margin-bottom: 1.5rem; padding: 0.75rem 1rem; background: #fef2f2; border-left: 4px solid #ef4444; color: #991b1b; border-radius: 4px;">
            @errMsg
        </div>
    }

    <!-- Quick Direct Upload Card -->
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
        <h4 style="margin: 0 0 0.75rem; font-size: 0.95rem; font-weight: 700; color: #1e293b;">⚡ Quick Direct Photo Upload</h4>
        <form method="post" action="/Admin/Products/UploadDirectMedia" enctype="multipart/form-data" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <input type="file" name="file" accept="image/*" class="dk-input" style="flex: 1; min-width: 250px;" required />
            <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #475569; cursor: pointer; white-space: nowrap;">
                <input type="checkbox" name="isPrimary" value="true" @(!Model.MediaItems.Any() ? "checked" : "") />
                Set as Primary Image
            </label>
            <button type="submit" class="dk-btn dk-btn-primary" style="white-space: nowrap;">
                📤 Upload to S3 Gallery
            </button>
        </form>
    </div>

    @if (!Model.MediaItems.Any())
    {
        <div style="text-align: center; padding: 4rem 1rem; border: 2px dashed #e5e7eb; border-radius: 12px;">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-muted); margin-bottom: 1rem;">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">No images assigned to this product</h3>
            <p style="color: var(--text-muted); max-width: 400px; margin: 0 auto 1.5rem;">
                Assign photos from the centralized Media Library or upload new product shots.
            </p>
            <button type="button" class="dk-btn dk-btn-primary" onclick="openMediaPicker()">
                Choose Photo from Library
            </button>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.25rem;">
            @foreach (var item in Model.MediaItems)
            {
                <div style="border: 2px solid @(item.IsPrimary ? "#4f46e5" : "#e5e7eb"); border-radius: 8px; overflow: hidden; background: #fff; display: flex; flex-direction: column;">
                    <div style="position: relative; padding-top: 75%; background: #f9fafb; overflow: hidden;">
                        <img src="@item.Url" alt="@item.AltText" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; padding: 0.5rem;" />
                        @if (item.IsPrimary)
                        {
                            <span style="position: absolute; top: 8px; left: 8px; font-size: 0.75rem; padding: 3px 8px; border-radius: 4px; background: #4f46e5; color: #fff; font-weight: 700;">
                                PRIMARY
                            </span>
                        }
                    </div>

                    <div style="padding: 0.75rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <p style="font-size: 0.85rem; font-weight: 600; margin: 0 0 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.AltText">
                                @item.AltText
                            </p>
                            <span style="font-size: 0.75rem; color: var(--text-muted);">Order: @item.DisplayOrder</span>
                        </div>

                        <div style="margin-top: 0.75rem; display: flex; gap: 0.5rem; justify-content: space-between;">
                            @if (!item.IsPrimary)
                            {
                                <form method="post" action="/Admin/Products/SetPrimaryMedia" style="flex: 1;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@Model.ProductId" />
                                    <input type="hidden" name="productMediaId" value="@item.ProductMediaId" />
                                    <button type="submit" class="dk-btn dk-btn-secondary dk-btn-sm" style="width: 100%; font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                                        Make Primary
                                    </button>
                                </form>
                            }

                            <form method="post" action="/Admin/Products/RemoveMedia" onsubmit="return confirm('Remove this image from the product?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <input type="hidden" name="productMediaId" value="@item.ProductMediaId" />
                                <button type="submit" class="dk-btn dk-btn-danger dk-btn-sm" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                                    Remove
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal Picker Dialog -->
<div id="mediaPickerModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center;">
    <div style="width: 90%; max-width: 1000px; height: 85%; background: #fff; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column;">
        <div style="padding: 1rem 1.5rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.125rem;">Select Product Image from Library</h3>
            <button type="button" class="dk-btn dk-btn-ghost dk-btn-sm" onclick="closeMediaPicker()">✕</button>
        </div>
        <iframe id="pickerIframe" src="" style="flex: 1; border: none; width: 100%; height: 100%;"></iframe>
    </div>
</div>

<!-- Hidden assignment form triggered upon selecting an image from picker -->
<form id="assignForm" method="post" action="/Admin/Products/AssignMedia" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="productId" value="@Model.ProductId" />
    <input type="hidden" name="mediaAssetId" id="selectedMediaAssetId" />
    <input type="hidden" name="isPrimary" id="selectedIsPrimary" value="@(Model.MediaItems.Any() ? "false" : "true")" />
    <input type="hidden" name="displayOrder" value="@(Model.MediaItems.Count + 1)" />
</form>

<script>
    function openMediaPicker() {
        document.getElementById('pickerIframe').src = '/Admin/Media?picker=true&mediaType=Product';
        document.getElementById('mediaPickerModal').style.display = 'flex';
    }

    function closeMediaPicker() {
        document.getElementById('mediaPickerModal').style.display = 'none';
    }

    window.addEventListener('message', function (e) {
        if (e.data && e.data.type === 'MEDIA_SELECTED') {
            document.getElementById('selectedMediaAssetId').value = e.data.id;
            closeMediaPicker();
            document.getElementById('assignForm').submit();
        }
    });
</script>
