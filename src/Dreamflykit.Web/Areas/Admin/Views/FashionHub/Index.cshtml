@model Dreamflykit.Application.FashionHub.Models.FashionHubDto

@{

    Layout = "_AdminLayout";

    ViewData["Title"] = "Fashion Category Hub Management";

    var hub = Model ?? Dreamflykit.Application.FashionHub.Models.FashionHubDto.CreateDefault();

    var hero = hub.HeroBanner ?? new();

    var catSection = hub.CategoriesSection ?? new();

    var picksSection = hub.TopPicksSection ?? new();

    var trustSection = hub.TrustBadgesSection ?? new();

    var bottomBanner = hub.BottomBanner ?? new();

    var categories = catSection.Categories ?? new();

    var products = picksSection.Products ?? new();



    var men = hub.MenClothing ?? Dreamflykit.Application.FashionHub.Models.FashionMenClothingDto.CreateDefault();

    var menHero = men.HeroBanner ?? new();

    var menCat = men.CategoriesSection ?? new();

    var menPicks = men.TopPicksSection ?? new();



    var menFootwear = hub.MenFootwear ?? Dreamflykit.Application.FashionHub.Models.FashionMenFootwearDto.CreateDefault();
    var footwearHero = menFootwear.HeroBanner ?? new();
    var footwearCat = menFootwear.CategoriesSection ?? new();
    var footwearPicks = menFootwear.TopPicksSection ?? new();
    var footwearFest = menFootwear.FestivalTheme ?? new();
    var women = hub.WomenClothing ?? Dreamflykit.Application.FashionHub.Models.FashionWomenClothingDto.CreateDefault();

    var womenHero = women.HeroBanner ?? new();

    var womenCat = women.CategoriesSection ?? new();

    var womenPicks = women.TopPicksSection ?? new();



    var hoodies = hub.Hoodies ?? Dreamflykit.Application.FashionHub.Models.FashionHoodiesHubDto.CreateDefault();

    var hoodiesFits = hoodies.FitSection?.Items ?? new();



    var sweatshirts = hub.Sweatshirts ?? Dreamflykit.Application.FashionHub.Models.FashionSweatshirtsHubDto.CreateDefault();

    var sweatStyles = sweatshirts.StyleSection?.Items ?? new();



    var ethnic = hub.EthnicWear ?? Dreamflykit.Application.FashionHub.Models.FashionEthnicWearDto.CreateDefault();

    var thermals = hub.Thermals ?? Dreamflykit.Application.FashionHub.Models.FashionThermalsDto.CreateDefault();

}



<div class="dk-admin-hub-wrapper">



    <!-- Top Toolbar -->

    <div class="dk-admin-hub-header">

        <div class="dk-admin-hub-title-box">

            <span class="dk-admin-hub-tag">Category Experience</span>

            <h1 class="dk-admin-hub-title">👗 Fashion Category Landing Page &amp; Templates</h1>

            <p class="dk-admin-hub-subtitle">

                Manage full-width hero slides with timeframe, Women Clothing, Men Clothing, Hoodies, Sweatshirts, and upload all images.

            </p>

        </div>

        <div class="dk-admin-hub-actions">

            <a href="/category/fashion/women-clothing" target="_blank" class="dk-btn-view-live" style="background: #fff1f2; color: #e11d48; border: 1.5px solid #fecdd3; font-weight: 700;" title="Preview Women Clothing template in new tab">

                👗 Women Clothing

            </a>

            <a href="/category/fashion/hoodies" target="_blank" class="dk-btn-view-live" style="background: #f8fafc; color: #0f172a; border: 1.5px solid #cbd5e1; font-weight: 700;" title="Preview Hoodies template in new tab">

                🧥 Hoodies

            </a>

            <a href="/category/fashion/sweatshirts" target="_blank" class="dk-btn-view-live" style="background: #fff7ed; color: #ea580c; border: 1.5px solid #fed7aa; font-weight: 700;" title="Preview Sweatshirts template in new tab">

                👕 Sweatshirts

            </a>

            <a href="/category/fashion/men-clothing" target="_blank" class="dk-btn-view-live" style="background: #eff6ff; color: #1d4ed8; border: 1.5px solid #bfdbfe; font-weight: 700;" title="Preview Men Clothing template in new tab">

                👔 Men Clothing

            </a>

            <a href="/category/fashion/ethnic-wear" target="_blank" class="dk-btn-view-live" style="background: #fdf4ff; color: #a21caf; border: 1.5px solid #f0abfc; font-weight: 700;" title="Preview Ethnic Wear template in new tab">

                👑 Ethnic Wear

            </a>

            <a href="/category/fashion/thermals" target="_blank" class="dk-btn-view-live" style="background: #f0fdf4; color: #15803d; border: 1.5px solid #86efac; font-weight: 700;" title="Preview Thermals template in new tab">

                ❄️ Thermals

            </a>

            <a href="/category/fashion" target="_blank" class="dk-btn-view-live" title="Preview live page in new tab">

                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>

                View Live Hub

            </a>

            <button type="button" class="dk-btn-save-hub" id="btnSaveHubHeader">

                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>

                Save All Changes

            </button>

        </div>

    </div>



    <!-- Alert Banners -->

    @if (TempData["SuccessMessage"] != null)

    {

        <div class="dk-alert dk-alert-success">

            <span>✓</span> @TempData["SuccessMessage"]

        </div>

    }

    @if (TempData["ErrorMessage"] != null)

    {

        <div class="dk-alert dk-alert-error">

            <span>⚠</span> @TempData["ErrorMessage"]

        </div>

    }

    <div id="ajaxAlertBox" style="display: none;" class="dk-alert"></div>



    <!-- Main Form Tabs -->

    <div class="dk-hub-tabs-bar">

        <button type="button" class="dk-tab-btn active" data-tab="tab-hero">

            🖼️ Hero Banner &amp; Slides (@(hub.HeroBanner?.Slides?.Count ?? 0))

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-categories">

            🏷️ Shop by Category (@(hub.CategoriesSection?.Categories?.Count ?? 0))

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-toppicks">

            ⭐ Top Picks Products (@(hub.TopPicksSection?.Products?.Count ?? 0))

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-trust">

            🛡️ Trust Propositions

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-bottom">

            🌐 Bottom Destination Bar

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-men-footwear" style="background: #f0f9ff; color: #0284c7; border: 1.5px solid #bae6fd; font-weight: 800;">
                    👟 Men Footwear (7 Categories)
                </button>
                <button type="button" class="dk-tab-btn" data-tab="tab-women-clothing" style="background: #fff1f2; color: #e11d48; border: 1.5px solid #fecdd3; font-weight: 800;">

            👗 Women Clothing Template

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-hoodies" style="background: #f8fafc; color: #0f172a; border: 1.5px solid #cbd5e1; font-weight: 800;">

            🧥 Hoodies Template

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-sweatshirts" style="background: #fff7ed; color: #ea580c; border: 1.5px solid #fed7aa; font-weight: 800;">

            👕 Sweatshirts Template

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-men-clothing" style="background: #eff6ff; color: #1d4ed8; border: 1.5px solid #93c5fd; font-weight: 800;">

            👔 Men Clothing Template

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-ethnic-wear" style="background: #fdf4ff; color: #a21caf; border: 1.5px solid #f0abfc; font-weight: 800;">

            👑 Ethnic Wear Template

        </button>

        <button type="button" class="dk-tab-btn" data-tab="tab-thermals" style="background: #f0fdf4; color: #15803d; border: 1.5px solid #86efac; font-weight: 800;">

            ❄️ Thermals Template

        </button>

    </div>



    <form id="fashionHubForm" method="post" action="/Admin/FashionHub/Save">

        @Html.AntiForgeryToken()



        <!-- ========================================================

             TAB 1: HERO BANNER

        ========================================================= -->

        <div class="dk-tab-pane active" id="tab-hero">

            <div class="dk-card">

                <div class="dk-card-header">

                    <div>

                        <h2 class="dk-card-title">Hero Banner Configuration</h2>

                        <p class="dk-card-desc">Customize the full-width high brightness hero section, headlines, badges, and background visual.</p>

                    </div>

                    <label class="dk-switch">

                        <input type="checkbox" id="heroIsEnabled" @(hub.HeroBanner?.IsEnabled == true ? "checked" : "") />

                        <span class="dk-slider"></span>

                        <span class="dk-switch-label">Section Enabled</span>

                    </label>

                </div>



                <div class="dk-card-body">

                    <div class="dk-form-grid-2">

                        <div class="dk-form-group">

                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">

                                <label class="dk-label" for="heroTitle" style="margin: 0;">Headline First Part</label>

                                <div style="display: flex; align-items: center; gap: 6px;">

                                    <span style="font-size: 11.5px; color: #64748b; font-weight: 600;">Color:</span>

                                    <input type="color" id="heroTitleColor" value="@(!string.IsNullOrWhiteSpace(hero.TitleColor) ? hero.TitleColor : "#063f91")" style="width: 32px; height: 26px; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; padding: 0;" />

                                </div>

                            </div>

                            <input type="text" id="heroTitle" class="dk-input" value="@hero.Title" placeholder="e.g. Fashion for" />

                            <small class="dk-hint">First portion of the large headline</small>

                        </div>

                        <div class="dk-form-group">

                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">

                                <label class="dk-label" for="heroTitleHighlight" style="margin: 0;">Headline Highlighted Part</label>

                                <div style="display: flex; align-items: center; gap: 6px;">

                                    <span style="font-size: 11.5px; color: #64748b; font-weight: 600;">Color:</span>

                                    <input type="color" id="heroTitleHighlightColor" value="@(!string.IsNullOrWhiteSpace(hero.TitleHighlightColor) ? hero.TitleHighlightColor : "#ea580c")" style="width: 32px; height: 26px; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; padding: 0;" />

                                </div>

                            </div>

                            <input type="text" id="heroTitleHighlight" class="dk-input" value="@hero.TitleHighlight" placeholder="e.g. Every Journey" />

                            <small class="dk-hint">Highlighted sunset orange or custom brand color</small>

                        </div>

                    </div>



                    <div class="dk-form-grid-2">

                        <div class="dk-form-group">

                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">

                                <label class="dk-label" for="heroSubtitle" style="margin: 0;">Subtitle &amp; Description</label>

                                <div style="display: flex; align-items: center; gap: 6px;">

                                    <span style="font-size: 11.5px; color: #64748b; font-weight: 600;">Text Color:</span>

                                    <input type="color" id="heroSubtitleColor" value="@(!string.IsNullOrWhiteSpace(hero.SubtitleColor) ? hero.SubtitleColor : "#334155")" style="width: 32px; height: 26px; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; padding: 0;" />

                                </div>

                            </div>

                            <textarea id="heroSubtitle" class="dk-textarea" rows="2">@hero.Subtitle</textarea>

                        </div>



                        <div class="dk-form-group">

                            <label class="dk-label">Banner Dimensions &amp; Badge Colors</label>

                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">

                                <div>

                                    <span style="font-size: 11.5px; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">Min Height (px):</span>

                                    <input type="number" id="heroBannerHeight" class="dk-input" value="@(hero.BannerHeight > 0 ? hero.BannerHeight : 440)" placeholder="440" />

                                </div>

                                <div>

                                    <span style="font-size: 11.5px; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">Badge Bg:</span>

                                    <input type="text" id="heroBadgeBgColor" class="dk-input" value="@(!string.IsNullOrWhiteSpace(hero.BadgeBgColor) ? hero.BadgeBgColor : "rgba(255, 255, 255, 0.94)")" placeholder="rgba(255,255,255,0.94)" />

                                </div>

                                <div>

                                    <span style="font-size: 11.5px; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">Badge Text:</span>

                                    <div style="display: flex; align-items: center; gap: 6px;">

                                        <input type="color" id="heroBadgeTextColor" value="@(!string.IsNullOrWhiteSpace(hero.BadgeTextColor) ? hero.BadgeTextColor : "#0f172a")" style="width: 34px; height: 38px; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; padding: 0;" />

                                    </div>

                                </div>

                            </div>

                            <small class="dk-hint">Text &amp; badge pills float seamlessly on top of full-width banner image</small>

                        </div>

                    </div>



                    <!-- Banner Image & Uploading Soon Status -->

                    <div class="dk-media-uploader-box">

                        <h3 class="dk-subhead">Hero Visual &amp; Media</h3>

                        <div class="dk-uploader-row">

                            <div class="dk-preview-box">

                                <img id="heroImagePreview" 

                                     src="@(!string.IsNullOrWhiteSpace(hub.HeroBanner.ImageUrl) ? hub.HeroBanner.ImageUrl : "/images/fashion-hub/uploading-soon-placeholder.svg")" 

                                     alt="Hero Preview" 

                                     class="dk-preview-hero-img" 

                                     onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg';" />

                            </div>



                            <div class="dk-uploader-controls">

                                <div class="dk-form-group">

                                    <label class="dk-label">Image Source URL</label>

                                    <input type="text" id="heroImageUrl" class="dk-input" value="@hub.HeroBanner.ImageUrl" placeholder="/images/fashion-hub/fashion_hero_banner.jpg" />

                                </div>



                                <div class="dk-upload-btn-group">

                                    <input type="file" id="heroFileInput" class="dk-file-hidden" accept="image/*" />

                                    <button type="button" class="dk-btn-upload" onclick="document.getElementById('heroFileInput').click();">

                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>

                                        Upload New Banner Image

                                    </button>

                                    <button type="button" class="dk-btn-clear" onclick="setHeroDefaultImage();">

                                        Use Default Template Image

                                    </button>

                                </div>



                                <div class="dk-toggle-uploading-soon">

                                    <label class="dk-checkbox-label">

                                        <input type="checkbox" id="heroIsUploadingSoon" @(hub.HeroBanner.IsUploadingSoon ? "checked" : "") />

                                        <span>Show <strong>"Uploading Soon"</strong> placeholder on banner instead of image</span>

                                    </label>

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- Full-Width Hero Slides Manager with Time Frame -->

                    <div class="dk-section-subpart" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 20px; margin: 20px 0;">

                        <div class="dk-subpart-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">

                            <div>

                                <h3 class="dk-subhead" style="margin: 0; color: #0f172a;">🎞️ Full-Width Hero Slides (Auto-Play Time Frame)</h3>

                                <p style="font-size: 12px; color: #64748b; margin: 4px 0 0;">Upload slides, set transition time frame in seconds, replace text &amp; configure buttons.</p>

                            </div>

                            <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">

                                <div style="display: flex; align-items: center; gap: 8px;">

                                    <label style="font-size: 12.5px; font-weight: 700; color: #0f172a;">Time Frame (Seconds):</label>

                                    <input type="number" id="heroSlideIntervalSeconds" class="dk-input" style="width: 70px;" value="@(hub.HeroBanner?.SlideIntervalSeconds > 0 ? hub.HeroBanner.SlideIntervalSeconds : 5)" min="1" max="60" />

                                </div>

                                <button type="button" class="dk-btn-add-item" onclick="addHeroSlide();">

                                    + Add New Slide

                                </button>

                            </div>

                        </div>



                        <div id="heroSlidesContainer" style="display: flex; flex-direction: column; gap: 14px;">

                            @if (hub.HeroBanner?.Slides != null && hub.HeroBanner.Slides.Count > 0)

                            {

                                @for (int s = 0; s < hub.HeroBanner.Slides.Count; s++)

                                {

                                    var slide = hub.HeroBanner.Slides[s];

                                    <div class="dk-hero-slide-card" data-slide-id="@slide.Id" style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 12px; padding: 16px;">

                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px;">

                                            <span style="font-weight: 800; font-size: 13px; color: #063f91;">Slide #<span class="slide-num">@(s + 1)</span></span>

                                            <div style="display: flex; align-items: center; gap: 12px;">

                                                <label class="dk-sm-switch">

                                                    <input type="checkbox" class="slide-active" @(slide.IsActive ? "checked" : "") />

                                                    <span>Active</span>

                                                </label>

                                                <button type="button" class="dk-btn-delete-row" onclick="this.closest('.dk-hero-slide-card').remove(); renumberSlides();" title="Delete slide">✕</button>

                                            </div>

                                        </div>

                                        

                                        <div class="dk-form-grid-2">

                                            <div class="dk-form-group">

                                                <label class="dk-xs-label">Title</label>

                                                <input type="text" class="dk-input slide-title" value="@slide.Title" placeholder="e.g. Fashion for" />

                                            </div>

                                            <div class="dk-form-group">

                                                <label class="dk-xs-label">Title Highlight</label>

                                                <input type="text" class="dk-input slide-highlight" value="@slide.TitleHighlight" placeholder="e.g. Every Journey" />

                                            </div>

                                        </div>



                                        <div class="dk-form-group" style="margin-top: 8px;">

                                            <label class="dk-xs-label">Subtitle / Description</label>

                                            <input type="text" class="dk-input slide-sub" value="@slide.Subtitle" placeholder="e.g. Stylish, comfortable & travel-ready fashion" />

                                        </div>



                                        <div class="dk-form-grid-2" style="margin-top: 8px;">

                                            <div class="dk-form-group">

                                                <label class="dk-xs-label">Button Text</label>

                                                <input type="text" class="dk-input slide-btn-text" value="@slide.ButtonText" placeholder="e.g. Shop Women Clothing" />

                                            </div>

                                            <div class="dk-form-group">

                                                <label class="dk-xs-label">Button URL</label>

                                                <input type="text" class="dk-input slide-btn-url" value="@slide.ButtonUrl" placeholder="e.g. /category/fashion/women-clothing" />

                                            </div>

                                        </div>



                                        <!-- Slide Media Row -->

                                        <div style="display: flex; align-items: center; gap: 16px; margin-top: 12px; background: #f8fafc; padding: 10px; border-radius: 8px; flex-wrap: wrap;">

                                            <img src="@(!string.IsNullOrWhiteSpace(slide.ImageUrl) ? slide.ImageUrl : "/images/fashion-hub/uploading-soon-placeholder.svg")" 

                                                 alt="Slide Preview" 

                                                 class="slide-thumb-preview" 

                                                 style="width: 100px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #cbd5e1;" 

                                                 onerror="this.src='/images/fashion-hub/uploading-soon-placeholder.svg';" />

                                            

                                            <div style="flex-grow: 1; min-width: 180px;">

                                                <input type="text" class="dk-input slide-image-url" value="@slide.ImageUrl" placeholder="/images/fashion-hub/slide.jpg" />

                                            </div>



                                            <div>

                                                <input type="file" class="dk-file-hidden slide-file-input" accept="image/*" onchange="uploadSlideImage(this);" />

                                                <button type="button" class="dk-btn-upload-sm" onclick="this.previousElementSibling.click();">

                                                    📷 Upload Image

                                                </button>

                                            </div>



                                            <label class="dk-checkbox-label" style="margin: 0; white-space: nowrap;">

                                                <input type="checkbox" class="slide-soon" @(slide.IsUploadingSoon ? "checked" : "") />

                                                <span>⏳ Uploading Soon</span>

                                            </label>



                                            <input type="hidden" class="slide-order" value="@slide.DisplayOrder" />

                                        </div>

                                    </div>

                                }

                            }

                        </div>

                    </div>



                    <!-- Hero Badges -->

                    <div class="dk-section-subpart">

                        <div class="dk-subpart-header">

                            <h3 class="dk-subhead">Hero Pill Badges (4 Displayed)</h3>

                        </div>

                        <div class="dk-badges-editor-grid" id="heroBadgesContainer">

                            @for (int b = 0; b < hub.HeroBanner.Badges.Count; b++)

                            {

                                var badge = hub.HeroBanner.Badges[b];

                                <div class="dk-badge-edit-card" data-badge-id="@badge.Id">

                                    <div class="dk-badge-edit-header">

                                        <span class="dk-badge-num">Badge #@(b + 1)</span>

                                        <label class="dk-sm-switch">

                                            <input type="checkbox" class="badge-active" @(badge.IsActive ? "checked" : "") />

                                            <span>Active</span>

                                        </label>

                                    </div>

                                    <div class="dk-form-group">

                                        <label class="dk-xs-label">Label</label>

                                        <input type="text" class="dk-input badge-label" value="@badge.Label" />

                                    </div>

                                    <div class="dk-form-group">

                                        <label class="dk-xs-label">Icon</label>

                                        <select class="dk-select badge-icon">

                                            <option value="shirt" selected="@(badge.Icon == "shirt")">Shirt / Clothing</option>

                                            <option value="shield" selected="@(badge.Icon == "shield")">Shield / Quality</option>

                                            <option value="tag" selected="@(badge.Icon == "tag")">Price Tag</option>

                                            <option value="users" selected="@(badge.Icon == "users")">Users / Loved</option>

                                        </select>

                                    </div>

                                </div>

                            }

                        </div>

                    </div>



                    <!-- Right Card ("Look Good. Travel Smart.") -->

                    <div class="dk-section-subpart">

                        <div class="dk-subpart-header">

                            <h3 class="dk-subhead">Right Callout Box ("Look Good. Travel Smart.")</h3>

                        </div>

                        <div class="dk-form-grid-2">

                            <div class="dk-form-group">

                                <label class="dk-label" for="rightCardTitle">Box Title</label>

                                <input type="text" id="rightCardTitle" class="dk-input" value="@hub.HeroBanner.RightCard.Title" placeholder="Look Good." />

                            </div>

                            <div class="dk-form-group">

                                <label class="dk-label" for="rightCardTitleHighlight">Box Title Highlight</label>

                                <input type="text" id="rightCardTitleHighlight" class="dk-input" value="@hub.HeroBanner.RightCard.TitleHighlight" placeholder="Travel Smart." />

                            </div>

                        </div>



                        <div class="dk-features-editor-grid" id="rightFeaturesContainer">

                            @for (int f = 0; f < hub.HeroBanner.RightCard.Features.Count; f++)

                            {

                                var feat = hub.HeroBanner.RightCard.Features[f];

                                <div class="dk-feat-edit-card" data-feat-id="@feat.Id">

                                    <div class="dk-badge-edit-header">

                                        <span class="dk-badge-num">Feature #@(f + 1)</span>

                                        <label class="dk-sm-switch">

                                            <input type="checkbox" class="feat-active" @(feat.IsActive ? "checked" : "") />

                                            <span>Active</span>

                                        </label>

                                    </div>

                                    <div class="dk-form-group">

                                        <label class="dk-xs-label">Title</label>

                                        <input type="text" class="dk-input feat-title" value="@feat.Title" />

                                    </div>

