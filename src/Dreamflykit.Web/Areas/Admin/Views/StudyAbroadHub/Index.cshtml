        div.className = "edu-partner-admin-card";
        div.dataset.partnerId = "partner-" + Math.random().toString(36).substr(2, 6);
        div.style.cssText = "background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; position: relative;";
        div.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 11px; font-weight: 800; color: #16a34a; text-transform: uppercase;">Bank Partner #\${count}</span>
                <button type="button" class="dk-btn" style="background: #fee2e2; color: #b91c1c; font-size: 10px; padding: 2px 6px;" onclick="this.closest('.edu-partner-admin-card').remove()">✕ Remove</button>
            </div>
            <div style="margin-bottom: 6px;">
                <label class="dk-sh-form-label" style="font-size: 10px;">Bank Name</label>
                <input type="text" class="dk-admin-form-input edu-partner-name" value="New Bank Partner" placeholder="e.g. HDFC Bank" style="font-size: 12px; padding: 4px 8px;" />
            </div>
            <div style="margin-bottom: 6px;">
                <label class="dk-sh-form-label" style="font-size: 10px;">Interest Rate Tag Text</label>
                <input type="text" class="dk-admin-form-input edu-partner-rate" value="Interest rate 9.75% p.a* >" placeholder="Interest rate..." style="font-size: 12px; padding: 4px 8px;" />
            </div>
            <div>
                <label class="dk-sh-form-label" style="font-size: 10px;">Bank Logo Image URL (Optional)</label>
                <input type="text" class="dk-admin-form-input edu-partner-logo" value="" placeholder="Leave blank to show text" style="font-size: 11px; padding: 4px 8px;" />
            </div>
        `;
        wrap.appendChild(div);
    }

    function gatherEduSteps() {
        const list = [];
        document.querySelectorAll("#edu_steps_container .edu-step-admin-card").forEach((c, idx) => {
            list.push({
                StepNumber: idx + 1,
                Title: c.querySelector(".edu-step-title")?.value || "Step " + (idx + 1),
                Subtitle: c.querySelector(".edu-step-sub")?.value || "",
                Icon: c.querySelector(".edu-step-icon")?.value || "check-circle"
            });
        });
        return list;
    }

    function gatherEduCourses() {
        const list = [];
        document.querySelectorAll("#edu_courses_container .edu-course-admin-card").forEach(c => {
            list.push({
                Id: c.dataset.courseId || ("course-" + Math.random().toString(36).substr(2, 6)),
                Institution: c.querySelector(".edu-course-inst")?.value || "",
                Title: c.querySelector(".edu-course-title")?.value || "",
                ImageUrl: c.querySelector(".edu-course-img")?.value || "/images/study-hub/checklist-study.jpg",
                LogoUrl: c.querySelector(".edu-course-logo")?.value || "",
                Badge1: c.querySelector(".edu-course-b1")?.value || "Certification",
                Badge2: c.querySelector(".edu-course-b2")?.value || "6 Months",
                InfoButtonText: c.querySelector(".edu-course-info-btn")?.value || "More Information",
                InfoButtonUrl: "#apply-loan-modal",
                ApplyButtonText: c.querySelector(".edu-course-apply-btn")?.value || "Apply Now",
                ApplyButtonUrl: "#apply-loan-modal"
            });
        });
        return list;
    }

    let dynamicCourseIndex = 100;
    function updateEduCoursesBadge() {
        const wrap = document.getElementById("edu_courses_container");
        const badge = document.getElementById("eduCoursesCountBadge");
        if (wrap && badge) {
            const count = wrap.querySelectorAll(".edu-course-admin-card").length;
            badge.textContent = count + " / 12 Courses";
            badge.style.background = count >= 12 ? "#ea580c" : "#0ea5e9";
        }
    }

    function removeEduCourseCard(btn) {
        if (!btn) return;
        const card = btn.closest(".edu-course-admin-card");
        if (card) {
            card.remove();
            updateEduCoursesBadge();
        }
    }

    function addEduCourse() {
        const wrap = document.getElementById("edu_courses_container");
        if (!wrap) return;
        const currentCount = wrap.querySelectorAll(".edu-course-admin-card").length;
        if (currentCount >= 12) {
            alert("Maximum of 12 course photos / programs reached. You can upload up to 12 items for this section.");
            return;
        }
        dynamicCourseIndex++;
        const count = currentCount + 1;
        const div = document.createElement("div");
        div.className = "edu-course-admin-card";
        div.dataset.courseId = "course-" + Math.random().toString(36).substr(2, 6);
        div.style.cssText = "background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 14px;";
        div.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 11px; font-weight: 800; color: #38bdf8; text-transform: uppercase;">Course Program #\${count}</span>
                <button type="button" class="dk-btn" style="background: #fee2e2; color: #b91c1c; font-size: 10px; padding: 2px 6px;" onclick="removeEduCourseCard(this)">✕ Remove</button>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 6px;">
                <div>
                    <label class="dk-sh-form-label" style="font-size: 10px; color: #94a3b8;">Institution Name</label>
                    <input type="text" class="dk-admin-form-input edu-course-inst" value="Premier AI Institute" placeholder="e.g. Stanford University" style="font-size: 11.5px; padding: 4px 6px; background: #0f172a; color: #fff; border-color: #475569;" />
                </div>
                <div>
                    <label class="dk-sh-form-label" style="font-size: 10px; color: #94a3b8;">Degree / Badge 1</label>
                    <input type="text" class="dk-admin-form-input edu-course-b1" value="Certification" placeholder="Degree" style="font-size: 11.5px; padding: 4px 6px; background: #0f172a; color: #fff; border-color: #475569;" />
                </div>
            </div>
            <div style="margin-bottom: 6px;">
                <label class="dk-sh-form-label" style="font-size: 10px; color: #94a3b8;">Program / Course Title</label>
                <input type="text" class="dk-admin-form-input edu-course-title" value="Advanced Applied AI and Machine Learning" placeholder="Course Title" style="font-size: 12px; padding: 4px 6px; background: #0f172a; color: #fff; border-color: #475569;" />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                <div>
                    <label class="dk-sh-form-label" style="font-size: 10px; color: #94a3b8;">Duration / Badge 2</label>
                    <input type="text" class="dk-admin-form-input edu-course-b2" value="6 Months" placeholder="Duration" style="font-size: 11.5px; padding: 4px 6px; background: #0f172a; color: #fff; border-color: #475569;" />
                </div>
                <div>
                    <label class="dk-sh-form-label" style="font-size: 10px; color: #94a3b8;">Institution Logo (Circular)</label>
                    <input type="text" class="dk-admin-form-input edu-course-logo" value="" placeholder="Optional Logo URL" style="font-size: 11.5px; padding: 4px 6px; background: #0f172a; color: #fff; border-color: #475569;" />
                </div>
            </div>
            <div style="margin-bottom: 8px;">
                <label class="dk-sh-form-label" style="font-size: 10px; color: #94a3b8;">Campus Photo (Admin can upload up to 12)</label>
                <div style="display: flex; gap: 6px; align-items: center;">
                    <div style="width: 44px; height: 32px; border-radius: 4px; overflow: hidden; border: 1px solid #475569; background: #0b1528; flex-shrink: 0;">
                        <img id="prev_cimg_\${dynamicCourseIndex}" src="/images/study-hub/edu-campus-iiit.jpg" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/study-hub/test-pic-placeholder.svg';" />
                    </div>
                    <input type="text" id="inp_cimg_\${dynamicCourseIndex}" class="dk-admin-form-input edu-course-img" value="/images/study-hub/edu-campus-iiit.jpg" placeholder="Campus Image URL" style="font-size: 11px; padding: 3px 6px; background: #0f172a; color: #fff; border-color: #475569; flex: 1;" oninput="updateLivePreview('inp_cimg_\${dynamicCourseIndex}', 'prev_cimg_\${dynamicCourseIndex}')" />
                    <button type="button" class="dk-btn dk-btn-primary" style="font-size: 10px; padding: 4px 8px;" onclick="triggerHubUpload('inp_cimg_\${dynamicCourseIndex}', 'prev_cimg_\${dynamicCourseIndex}')">📷 Upload</button>
                    <button type="button" class="dk-btn" style="font-size: 10px; padding: 4px 6px; background: #fee2e2; color: #b91c1c; font-weight: 700;" onclick="setUploadingSoon('inp_cimg_\${dynamicCourseIndex}', 'prev_cimg_\${dynamicCourseIndex}')">⏳ Upload Soon</button>
