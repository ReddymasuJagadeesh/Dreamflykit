<script>
function slideItemProducts(direction) {
    var container = document.getElementById('itemPicksRow');
    if (!container) return;
    var scrollAmount = 300 * direction;
    container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
}

function toggleItemWishlist(btn, ev) {
    ev.preventDefault();
    ev.stopPropagation();
    btn.classList.toggle('active');
    var isActive = btn.classList.contains('active');
    btn.style.color = isActive ? '#ef4444' : '#64748b';
}

function quickAddItemToCart(prodId, prodName, price, btn) {
    var origText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '✓ Added!';
    btn.style.background = '#16a34a';

    setTimeout(function() {
        btn.disabled = false;
        btn.innerHTML = origText;
        btn.style.background = '';
    }, 1500);
}
</script>

@functions {
    public static string GetCategoryIcon(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug)) return "✨";
        var s = slug.ToLowerInvariant();
        if (s.Contains("women-footwear")) return "👠";
        if (s.Contains("watch")) return "⌚";
        if (s.Contains("sunglass")) return "🕶️";
        if (s.Contains("cap") || s.Contains("hat")) return "🧢";
        if (s.Contains("belt") || s.Contains("wallet")) return "👛";
        if (s.Contains("sock")) return "🧦";
        if (s.Contains("accessor")) return "🎒";
        return "✨";
    }

    public static string GetSubcategoryIcon(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug)) return "✨";
        var s = slug.ToLowerInvariant();
        if (s.Contains("flat") || s.Contains("belli")) return "🥿";
        if (s.Contains("heel") || s.Contains("pump")) return "👠";
        if (s.Contains("sneaker") || s.Contains("trainer")) return "👟";
        if (s.Contains("loafer") || s.Contains("slip")) return "👞";
        if (s.Contains("wedge") || s.Contains("sandal")) return "👡";
        if (s.Contains("boot")) return "👢";
        if (s.Contains("flip") || s.Contains("slide")) return "🩴";
        if (s.Contains("analog") || s.Contains("classic")) return "⌚";
        if (s.Contains("chrono") || s.Contains("sport")) return "⏱️";
        if (s.Contains("smart")) return "📱";
        if (s.Contains("leather")) return "👔";
        if (s.Contains("steel") || s.Contains("metal")) return "⛓️";
        if (s.Contains("digital") || s.Contains("retro")) return "📟";
        if (s.Contains("aviator")) return "🕶️";
        if (s.Contains("wayfarer")) return "🕶️";
        if (s.Contains("round")) return "👓";
        if (s.Contains("clubmaster") || s.Contains("browline")) return "👓";
        if (s.Contains("cat-eye") || s.Contains("cateye")) return "🕶️";
        if (s.Contains("wrap") || s.Contains("sport")) return "🥽";
        if (s.Contains("baseball") || s.Contains("dad")) return "🧢";
        if (s.Contains("snapback")) return "🧢";
        if (s.Contains("beanie") || s.Contains("knit")) return "🧶";
        if (s.Contains("bucket")) return "🪣";
        if (s.Contains("visor")) return "🧢";
        if (s.Contains("fedora") || s.Contains("sun-hat") || s.Contains("sun-hats")) return "👒";
        if (s.Contains("belt")) return "🪢";
        if (s.Contains("wallet") || s.Contains("rfid") || s.Contains("bifold")) return "👛";
        if (s.Contains("card")) return "💳";
        if (s.Contains("passport") || s.Contains("travel")) return "🛂";
        if (s.Contains("ankle")) return "🧦";
        if (s.Contains("crew")) return "🧦";
        if (s.Contains("no-show") || s.Contains("liner")) return "🧦";
        if (s.Contains("thermal") || s.Contains("winter")) return "❄️";
        if (s.Contains("compression")) return "🏃";
        if (s.Contains("bag") || s.Contains("backpack")) return "🎒";
        if (s.Contains("tie") || s.Contains("bowtie")) return "👔";
        if (s.Contains("cufflink") || s.Contains("brooch")) return "✨";
        if (s.Contains("scarf") || s.Contains("muffler")) return "🧣";
        if (s.Contains("keychain") || s.Contains("airtag")) return "🔑";
        if (s.Contains("umbrella")) return "☂️";
        return "✨";
    }

    public static string GetBadgeIcon(string? icon)
    {
        if (string.IsNullOrWhiteSpace(icon)) return "✓";
        return icon.ToLowerInvariant() switch
        {
            "shield" => "🛡️",
            "compass" => "🧭",
            "feather" => "🪶",
            "wind" => "💨",
            "users" => "👥",
            "box" => "📦",
            "tag" => "🏷️",
            "truck" => "🚚",
            "return" => "🔄",
            "headset" => "🎧",
            _ => "✓"
        };
    }

    public static string GetFeatureIcon(string? icon)
    {
        return GetBadgeIcon(icon);
    }

    public static string GetTrustIcon(string? icon)
    {
        return icon?.ToLowerInvariant() switch
        {
            "box" => "📦",
            "shield" => "🛡️",
            "tag" => "🏷️",
            "truck" => "🚚",
            "return" => "🔄",
            "headset" => "🎧",
            _ => "✨"
        };
    }
}

