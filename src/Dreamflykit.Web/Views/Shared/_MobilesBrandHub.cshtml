<!-- ============================================================
     CLIENT-SIDE INTERACTIVE FILTERING & SORTING
============================================================ -->
<script>
    function toggleMobileFilterGroup(headerEl) {
        const card = headerEl.closest('.dk-filter-group-card');
        if (card) {
            card.classList.toggle('is-collapsed');
        }
    }

    function applyMobileFilters() {
        const checkboxes = document.querySelectorAll('.mobile-filter-cb:checked');
        const selectedFilters = {};

        checkboxes.forEach(cb => {
            const grp = cb.dataset.group;
            const val = cb.dataset.val;
            if (!selectedFilters[grp]) selectedFilters[grp] = [];
            selectedFilters[grp].push(val);
        });

        // Update active filter tags display
        const activeContainer = document.getElementById('activeFilterTags');
        if (activeContainer) {
            activeContainer.innerHTML = '';
            checkboxes.forEach(cb => {
                const label = cb.closest('.dk-fg-opt-label').querySelector('.dk-fg-opt-text').textContent;
                const chip = document.createElement('span');
                chip.className = 'dk-active-tag-chip';
                chip.innerHTML = label + ' <button type="button" class="dk-active-tag-del" onclick="removeFilterCb(\'' + cb.dataset.group + '\', \'' + cb.dataset.val + '\')">✕</button>';
                activeContainer.appendChild(chip);
            });
        }

        const cards = document.querySelectorAll('.dk-mb-prod-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const tags = (card.dataset.tags || '').toLowerCase();
            let matchesAllGroups = true;

            for (const grp in selectedFilters) {
                const vals = selectedFilters[grp];
                // Item must match at least one value within the group
                const matchesGroup = vals.some(v => tags.includes(v));
                if (!matchesGroup) {
                    matchesAllGroups = false;
                    break;
                }
            }

            if (matchesAllGroups) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        const countEl = document.getElementById('lblVisibleCount');
        if (countEl) countEl.textContent = visibleCount;

        const emptyBox = document.getElementById('mobilesEmptyState');
        const grid = document.getElementById('mobileProductsGrid');
        if (emptyBox && grid) {
            if (visibleCount === 0) {
                emptyBox.style.display = 'block';
                grid.style.display = 'none';
            } else {
                emptyBox.style.display = 'none';
                grid.style.display = 'grid';
            }
        }
    }

    function removeFilterCb(group, val) {
        const cb = document.querySelector('.mobile-filter-cb[data-group="' + group + '"][data-val="' + val + '"]');
        if (cb) {
            cb.checked = false;
            applyMobileFilters();
        }
    }

    function clearAllMobileFilters() {
        document.querySelectorAll('.mobile-filter-cb').forEach(cb => cb.checked = false);
        applyMobileFilters();
    }

    function sortMobileProducts(sortVal) {
        const grid = document.getElementById('mobileProductsGrid');
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll('.dk-mb-prod-card'));

        cards.sort((a, b) => {
            const priceA = parseFloat(a.dataset.price) || 0;
            const priceB = parseFloat(b.dataset.price) || 0;
            const ratingA = parseFloat(a.dataset.rating) || 0;
            const ratingB = parseFloat(b.dataset.rating) || 0;
            const discA = parseFloat(a.dataset.discount) || 0;
            const discB = parseFloat(b.dataset.discount) || 0;

            switch (sortVal) {
                case 'price-asc': return priceA - priceB;
                case 'price-desc': return priceB - priceA;
                case 'rating-desc': return ratingB - ratingA;
                case 'discount-desc': return discB - discA;
                default: return 0;
            }
        });

        cards.forEach(c => grid.appendChild(c));
    }

    function handleMobileAddToCart(productId, productName) {
        if (window.DreamflykitCart && typeof window.DreamflykitCart.addItem === 'function') {
            window.DreamflykitCart.addItem(productId, 1);
        } else {
            const toast = document.createElement('div');
            toast.style.position = 'fixed';
            toast.style.bottom = '24px';
            toast.style.right = '24px';
            toast.style.background = '#0f172a';
            toast.style.color = '#ffffff';
            toast.style.padding = '12px 20px';
            toast.style.borderRadius = '8px';
            toast.style.boxShadow = '0 10px 25px rgba(0,0,0,0.2)';
            toast.style.fontSize = '13px';
            toast.style.fontWeight = '700';
            toast.style.zIndex = '99999';
            toast.style.display = 'flex';
            toast.style.alignItems = 'center';
            toast.style.gap = '8px';
            toast.innerHTML = '<span>🛒</span><span>' + (productName || 'Smartphone') + ' added to Cart!</span>';
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    }
</script>

