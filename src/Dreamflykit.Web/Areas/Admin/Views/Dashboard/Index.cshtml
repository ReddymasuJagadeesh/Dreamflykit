@model Dreamflykit.Web.Areas.Admin.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Overview Dashboard";
}

@if (Model.PendingSellerApprovals > 0)
{
    <div style="background: linear-gradient(135deg, #fffbeb, #fef3c7); border: 2px solid #f59e0b; border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; box-shadow: 0 4px 15px rgba(245, 158, 11, 0.2);">
        <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: #fef3c7; border: 2px solid #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                ⏳
            </div>
            <div>
                <h4 style="margin: 0; font-size: 16px; font-weight: 800; color: #92400e;">
                    @Model.PendingSellerApprovals Product@(Model.PendingSellerApprovals == 1 ? "" : "s") Awaiting Super Admin Pricing &amp; Approval
                </h4>
                <p style="margin: 3px 0 0; font-size: 13px; color: #78350f;">
                    Seller partners have submitted product photos and details without price. Review them now to set official MRP &amp; Selling Price and publish live.
                </p>
            </div>
        </div>
        <div>
            <a href="/Admin/Products?status=PendingApproval" class="dk-btn" style="background: #059669; color: #fff; padding: 8px 18px; font-weight: 800; font-size: 13px; border-radius: 8px; text-decoration: none; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.35);">
                Review &amp; Set Price Now →
            </a>
        </div>
    </div>
}

<!-- KPI Metric Cards -->
<div class="dk-kpi-grid">
    <div class="dk-kpi-card">
        <div class="dk-kpi-info">
            <span class="dk-kpi-label">Total Revenue</span>
            <span class="dk-kpi-value">₹@Model.TotalRevenue.ToString("N0")</span>
            <span class="dk-kpi-sub">Across all confirmed orders</span>
        </div>
        <div class="dk-kpi-icon dk-kpi-icon-green">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
        </div>
    </div>

    <div class="dk-kpi-card">
        <div class="dk-kpi-info">
            <span class="dk-kpi-label">Total Orders</span>
            <span class="dk-kpi-value">@Model.TotalOrders</span>
            <span class="dk-kpi-sub">@Model.PendingOrders pending fulfillment</span>
        </div>
        <div class="dk-kpi-icon dk-kpi-icon-blue">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="8" cy="21" r="1"></circle>
                <circle cx="19" cy="21" r="1"></circle>
                <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
            </svg>
        </div>
    </div>

    <div class="dk-kpi-card">
        <div class="dk-kpi-info">
            <span class="dk-kpi-label">Active Catalog</span>
            <span class="dk-kpi-value">@Model.TotalProducts</span>
            <span class="dk-kpi-sub">Products & kits online</span>
        </div>
        <div class="dk-kpi-icon dk-kpi-icon-orange">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
        </div>
    </div>

    <div class="dk-kpi-card">
        <div class="dk-kpi-info">
            <span class="dk-kpi-label">Registered Customers</span>
            <span class="dk-kpi-value">@Model.TotalCustomers</span>
            <span class="dk-kpi-sub">Active platform users</span>
        </div>
        <div class="dk-kpi-icon dk-kpi-icon-purple">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
        </div>
</div>

<!-- Quick Action Command Center (Flipkart / Industry Standard) -->
<div class="dk-admin-card" style="margin-bottom: 24px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
        <div>
            <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                <span>⚡ Store Management & Quick Actions</span>
                <span style="font-size: 11px; background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 9999px; font-weight: 700;">Seller Hub</span>
            </h3>
            <p style="margin: 4px 0 0; font-size: 12px; color: #64748b;">Direct control over products, media, categories, banners, and team permissions</p>
        </div>
        <div style="display: flex; gap: 8px;">
            <a href="/Admin/Products/Create" class="dk-btn dk-btn-primary" style="padding: 6px 14px; font-size: 12px; font-weight: 700; text-decoration: none;">
                + Add Product
            </a>
            <a href="/Admin/Categories/Create" class="dk-btn dk-btn-secondary" style="padding: 6px 14px; font-size: 12px; font-weight: 700; text-decoration: none;">
                + Add Category
            </a>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
        <!-- Card 1: Add Product -->
        <a href="/Admin/Products/Create" style="display: flex; gap: 14px; padding: 16px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fafafa; text-decoration: none; color: inherit; transition: all 0.2s;" onmouseover="this.style.borderColor='#075bc8'; this.style.background='#f0f7ff';" onmouseout="this.style.borderColor='#e2e8f0'; this.style.background='#fafafa';">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: #eff6ff; color: #1d4ed8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><circle cx="12" cy="12" r="4"></circle></svg>
            </div>
            <div>
                <div style="font-weight: 700; font-size: 14px; color: #0f172a;">Add New Product</div>
                <div style="font-size: 12px; color: #64748b; margin-top: 2px;">Create product with categories, variants, pricing & S3 gallery</div>
            </div>
        </a>

        <!-- Card 2: Categories & Subcategories -->
        <a href="/Admin/Categories" style="display: flex; gap: 14px; padding: 16px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fafafa; text-decoration: none; color: inherit; transition: all 0.2s;" onmouseover="this.style.borderColor='#075bc8'; this.style.background='#f0f7ff';" onmouseout="this.style.borderColor='#e2e8f0'; this.style.background='#fafafa';">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: #ecfdf5; color: #059669; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            </div>
            <div>
                <div style="font-weight: 700; font-size: 14px; color: #0f172a;">Categories & Subcategories</div>
                <div style="font-size: 12px; color: #64748b; margin-top: 2px;">Manage store categories, subcategories & icon/banner media</div>
            </div>
        </a>

        <!-- Card 3: Media Library -->
        <a href="/Admin/Media" style="display: flex; gap: 14px; padding: 16px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fafafa; text-decoration: none; color: inherit; transition: all 0.2s;" onmouseover="this.style.borderColor='#075bc8'; this.style.background='#f0f7ff';" onmouseout="this.style.borderColor='#e2e8f0'; this.style.background='#fafafa';">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: #fdf2f8; color: #db2777; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </div>
            <div>
                <div style="font-weight: 700; font-size: 14px; color: #0f172a;">Central Media Library</div>
                <div style="font-size: 12px; color: #64748b; margin-top: 2px;">Upload & optimize images across S3 bucket & CloudFront CDN</div>
            </div>
        </a>

        <!-- Card 4: Banners & Sliders -->
        <a href="/Admin/Banners" style="display: flex; gap: 14px; padding: 16px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fafafa; text-decoration: none; color: inherit; transition: all 0.2s;" onmouseover="this.style.borderColor='#075bc8'; this.style.background='#f0f7ff';" onmouseout="this.style.borderColor='#e2e8f0'; this.style.background='#fafafa';">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: #fffbeb; color: #d97706; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            </div>
            <div>
                <div style="font-weight: 700; font-size: 14px; color: #0f172a;">Banners & Promos</div>
                <div style="font-size: 12px; color: #64748b; margin-top: 2px;">Hero carousel slides, campaign strip banners & sale graphics</div>
            </div>
        </a>

        <!-- Card 5: Landing Pages -->
        <a href="/Admin/LandingPages" style="display: flex; gap: 14px; padding: 16px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fafafa; text-decoration: none; color: inherit; transition: all 0.2s;" onmouseover="this.style.borderColor='#075bc8'; this.style.background='#f0f7ff';" onmouseout="this.style.borderColor='#e2e8f0'; this.style.background='#fafafa';">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: #f5f3ff; color: #7c3aed; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            </div>
            <div>
                <div style="font-weight: 700; font-size: 14px; color: #0f172a;">Custom Landing Pages</div>
                <div style="font-size: 12px; color: #64748b; margin-top: 2px;">Build dedicated landing pages with hero banners & content</div>
            </div>
        </a>

        @if (User.IsInRole("SuperAdmin"))
        {
            <!-- Card 6: Super Admin Permissions -->
            <a href="/Admin/MediaPermissions" style="display: flex; gap: 14px; padding: 16px; border: 1px solid #c7d2fe; border-radius: 10px; background: #eef2ff; text-decoration: none; color: inherit; transition: all 0.2s;" onmouseover="this.style.borderColor='#4f46e5'; this.style.background='#e0e7ff';" onmouseout="this.style.borderColor='#c7d2fe'; this.style.background='#eef2ff';">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: #6366f1; color: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
                <div>
                    <div style="font-weight: 700; font-size: 14px; color: #312e81; display: flex; align-items: center; gap: 6px;">
                        <span>Admin Permissions</span>
                        <span style="font-size: 10px; background: #4338ca; color: white; padding: 1px 6px; border-radius: 4px;">SUPER ADMIN</span>
                    </div>
                    <div style="font-size: 12px; color: #4338ca; margin-top: 2px;">Grant or revoke admin access for products, categories, banners & media</div>
                </div>
            </a>
        }
    </div>
</div>

<!-- Recent Orders Section -->
<div class="dk-admin-card">
    <div class="dk-admin-card-header">
        <h3 class="dk-admin-card-title">Recent Customer Orders</h3>
        <a href="/Admin/Orders" class="dk-btn dk-btn-secondary" style="padding: 6px 14px; font-size: 12px;">View All Orders →</a>
    </div>

    <div class="dk-admin-table-wrap">
        <table class="dk-admin-table">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentOrders.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 32px; color: #64748b;">
                            No customer orders recorded yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model.RecentOrders)
                    {
                        var statusClass = order.Status.ToString().ToLowerInvariant();
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>
                                <div>@order.CustomerName</div>
                                <small style="color: #64748b;">@order.CustomerEmail</small>
                            </td>
                            <td>@order.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>@order.ItemCount @(order.ItemCount == 1 ? "item" : "items")</td>
                            <td><strong>₹@order.TotalAmount.ToString("N0")</strong></td>
                            <td>
                                <span class="dk-status-badge dk-status-@statusClass">@order.StatusLabel</span>
                            </td>
                            <td>
                                <a href="/Admin/Orders/Details/@order.OrderId" class="dk-btn dk-btn-outline" style="padding: 4px 10px; font-size: 11px;">
                                    Manage →
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
