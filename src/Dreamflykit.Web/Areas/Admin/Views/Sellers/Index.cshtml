@model Dreamflykit.Web.Areas.Admin.Models.AdminSellerListViewModel
@{
    ViewData["Title"] = "Seller Accounts";
    Layout = "_AdminLayout";
}

<div class="dk-admin-header-row" style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1.5rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: #f8fafc; margin: 0; display:flex; align-items:center; gap:0.6rem;">
            <span>🏪</span> Seller Partners &amp; Stores
        </h1>
        <p style="color: #94a3b8; font-size: 0.875rem; margin: 0.35rem 0 0;">
            Super Admin authority: Only Super Admins can create and authorize seller accounts to submit products.
        </p>
    </div>
    <div>
        <a asp-action="Create" class="dk-btn-primary" style="display:inline-flex; align-items:center; gap:0.5rem; background:linear-gradient(135deg, #10b981, #059669); color:#fff; padding:0.6rem 1.25rem; border-radius:8px; font-weight:700; text-decoration:none; box-shadow:0 4px 14px rgba(16, 185, 129, 0.35);">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <span>+ Create New Seller</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #6ee7b7; padding: 0.85rem 1.25rem; border-radius: 8px; margin-bottom: 1.25rem; display:flex; align-items:center; gap:0.75rem;">
        <span>✓</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; padding: 0.85rem 1.25rem; border-radius: 8px; margin-bottom: 1.25rem; display:flex; align-items:center; gap:0.75rem;">
        <span>⚠️</span>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Search bar -->
<div style="background: #1e293b; padding: 1rem 1.25rem; border-radius: 10px; border: 1px solid #334155; margin-bottom: 1.5rem;">
    <form method="get" style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px; position:relative;">
            <input type="text"
                   name="search"
                   value="@Model.SearchTerm"
                   placeholder="Search seller by name, email, or phone number..."
                   style="width: 100%; padding: 0.65rem 1rem; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #f8fafc; font-size: 0.9rem;" />
        </div>
        <button type="submit" style="padding: 0.65rem 1.25rem; background: #3b82f6; color: #fff; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
            Search
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <a asp-action="Index" style="padding: 0.65rem 1rem; background: #475569; color: #f1f5f9; text-decoration: none; border-radius: 6px; font-size: 0.9rem;">
                Clear
            </a>
        }
    </form>
</div>

<!-- Sellers Table -->
<div style="background: #1e293b; border-radius: 12px; border: 1px solid #334155; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.25);">
    <div style="padding: 1rem 1.25rem; border-bottom: 1px solid #334155; display:flex; justify-content:space-between; align-items:center;">
        <span style="font-weight: 700; color: #f8fafc; font-size: 0.95rem;">
            Registered Sellers (@Model.TotalCount)
        </span>
        <span style="font-size: 0.8rem; color: #94a3b8;">
            Sellers can add products without prices • Prices are set by Super Admin
        </span>
    </div>

    @if (Model.Sellers.Count == 0)
    {
        <div style="padding: 3rem; text-align: center; color: #94a3b8;">
            <div style="font-size: 3rem; margin-bottom: 0.75rem;">👥</div>
            <h3 style="color: #f1f5f9; font-size: 1.15rem; margin-bottom: 0.5rem;">No seller accounts found</h3>
            <p style="font-size: 0.9rem; margin-bottom: 1.25rem;">Create the first authorized seller account so they can log in to Seller Central and submit products.</p>
            <a asp-action="Create" class="dk-btn-primary" style="display:inline-block; padding: 0.6rem 1.25rem; background: #10b981; color:#fff; border-radius: 6px; text-decoration: none; font-weight: 600;">
                + Create Seller Account
            </a>
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;">
                <thead>
                    <tr style="background: #0f172a; border-bottom: 1px solid #334155; color: #94a3b8; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">
                        <th style="padding: 0.9rem 1.25rem;">Seller Details</th>
                        <th style="padding: 0.9rem 1rem;">Phone</th>
                        <th style="padding: 0.9rem 1rem;">Allowed Categories</th>
                        <th style="padding: 0.9rem 1rem; text-align: center;">Total Products</th>
                        <th style="padding: 0.9rem 1rem; text-align: center;">Pending Price Review</th>
                        <th style="padding: 0.9rem 1rem; text-align: center;">Live &amp; Approved</th>
                        <th style="padding: 0.9rem 1rem; text-align: center;">Account Status</th>
                        <th style="padding: 0.9rem 1.25rem; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seller in Model.Sellers)
                    {
                        <tr style="border-bottom: 1px solid #334155; transition: background 0.15s ease;">
                            <td style="padding: 1rem 1.25rem;">
                                <div style="font-weight: 700; color: #f8fafc; font-size: 0.95rem;">
                                    @seller.FullName
                                </div>
                                <div style="color: #38bdf8; font-size: 0.8rem; margin-top: 0.15rem;">
                                    @seller.Email
                                </div>
                            </td>
                            <td style="padding: 1rem 1rem; color: #cbd5e1;">
                                @seller.PhoneNumber
                            </td>
                            <td style="padding: 1rem 1rem;">
                                @if (seller.AssignedCategoryNames.Count > 0)
                                {
                                    <div style="display:flex; flex-wrap:wrap; gap:0.35rem; max-width:280px;">
                                        @foreach (var cname in seller.AssignedCategoryNames)
                                        {
                                            <span style="display:inline-block; font-size:0.75rem; font-weight:600; padding:2px 8px; border-radius:9999px; background:rgba(59,130,246,0.15); color:#60a5fa; border:1px solid rgba(59,130,246,0.3);">
                                                @cname
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="color:#94a3b8; font-size:0.8rem; font-style:italic;">All Categories Allowed</span>
                                }
                            </td>
                            <td style="padding: 1rem 1rem; text-align: center;">
                                <span style="font-weight: 700; color: #f8fafc; background: #334155; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.8rem;">
                                    @seller.TotalProducts
                                </span>
                            </td>
                            <td style="padding: 1rem 1rem; text-align: center;">
                                @if (seller.PendingProducts > 0)
                                {
                                    <a asp-controller="Products" asp-action="Index" asp-route-status="PendingApproval" asp-route-sellerId="@seller.SellerId" style="display:inline-block; font-weight: 800; color: #fbbf24; background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.4); padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.8rem; text-decoration:none;">
                                        ⏳ @seller.PendingProducts Review
                                    </a>
                                }
                                else
                                {
                                    <span style="color: #64748b; font-size: 0.85rem;">0</span>
                                }
                            </td>
                            <td style="padding: 1rem 1rem; text-align: center;">
                                <span style="font-weight: 700; color: #34d399; background: rgba(16, 185, 129, 0.15); padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.8rem;">
                                    @seller.ApprovedProducts Live
                                </span>
                            </td>
                            <td style="padding: 1rem 1rem; text-align: center;">
                                @if (seller.IsLockedOut)
                                {
                                    <span style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                        🔒 Locked
                                    </span>
                                }
                                else if (!seller.IsActive)
                                {
                                    <span style="background: rgba(100, 116, 139, 0.2); color: #94a3b8; padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                        Inactive
                                    </span>
                                }
                                else
                                {
                                    <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                        Active
                                    </span>
                                }
                            </td>
                            <td style="padding: 1rem 1.25rem; text-align: right;">
                                <div style="display: inline-flex; gap: 0.45rem; align-items: center;">
                                    <a asp-action="Edit" asp-route-id="@seller.SellerId" style="padding: 0.35rem 0.75rem; background: #2563eb; color: #fff; border-radius: 6px; text-decoration: none; font-size: 0.8rem; font-weight: 700;">
                                        Edit / Categories
                                    </a>
                                    <a asp-controller="Products" asp-action="Index" asp-route-sellerId="@seller.SellerId" style="padding: 0.35rem 0.75rem; background: #334155; color: #38bdf8; border-radius: 6px; text-decoration: none; font-size: 0.8rem; font-weight: 600;">
                                        Products
                                    </a>
                                    <form asp-action="ToggleLock" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to @(seller.IsLockedOut ? "unlock" : "lock") this seller account?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sellerId" value="@seller.SellerId" />
                                        <button type="submit" style="padding: 0.35rem 0.75rem; background: @(seller.IsLockedOut ? "#10b981" : "#ef4444"); color: #fff; border:none; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor:pointer;">
                                            @(seller.IsLockedOut ? "Unlock" : "Lock")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
