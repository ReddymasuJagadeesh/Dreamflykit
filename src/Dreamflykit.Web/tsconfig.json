{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "outDir": "./wwwroot/js"
  },
  "include": [
    "src/scripts/**/*.ts"
  ]
}