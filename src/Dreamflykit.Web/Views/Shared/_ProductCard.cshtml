@using Dreamflykit.Application.Catalog.Models
@model ProductListItem

@{
    var imageUrl = string.IsNullOrWhiteSpace(Model.PrimaryImageUrl)
        ? Url.Content("~/images/products/product-placeholder.webp")
        : Model.PrimaryImageUrl;

    var discount = Model.DiscountPercentage;
}

<article class="dk-product-card" data-variant-id="@Model.DefaultVariantId">
    <!-- Card Header / Badges -->
    <div class="dk-card-top">
        @if (Model.IsFeatured)
        {
            <span class="dk-tag dk-tag-featured">TRENDING</span>
        }
        else if (discount >= 30)
        {
            <span class="dk-tag dk-tag-bestseller">BESTSELLER</span>
        }
        else
        {
            <span></span>
        }

        <!-- Wishlist Heart Button -->
        <button type="button" 
                class="dk-wishlist-toggle-btn" 
                data-variant-id="@Model.DefaultVariantId"
                title="Save to Wishlist" 
                aria-label="Wishlist">
            <svg class="dk-heart-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
            </svg>
        </button>
    </div>

    <!-- Clickable Product Area -->
    <a asp-controller="Products"
       asp-action="Details"
       asp-route-slug="@Model.Slug"
       class="dk-card-content-link">

        <div class="dk-card-img-wrap">
            <img src="@imageUrl"
                 alt="@Model.Name"
                 loading="lazy"
                 decoding="async"
                 class="dk-card-img" />
        </div>

        <div class="dk-card-info">
            <h3 class="dk-card-name" title="@Model.Name">
                @Model.Name
            </h3>

            <div class="dk-card-pricing">
                <span class="dk-card-price">₹@Model.SellingPrice.ToString("N0")</span>
                @if (Model.Mrp > Model.SellingPrice)
                {
                    <span class="dk-card-mrp">₹@Model.Mrp.ToString("N0")</span>
                    @if (discount > 0)
                    {
                        <span class="dk-card-discount">(@discount% OFF)</span>
                    }
                }
            </div>

            <!-- Star Rating row -->
            <div class="dk-card-rating">
                <span class="dk-stars">★★★★☆</span>
                <span class="dk-reviews-count">(96)</span>
            </div>
        </div>
    </a>

    <!-- Quick Add-to-Cart Button -->
    <div class="dk-card-bottom-bar">
        <form asp-controller="Cart" asp-action="Add" method="post" class="dk-quick-add-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProductVariantId" value="@Model.DefaultVariantId" />
            <input type="hidden" name="Quantity" value="1" />
            <button type="submit" class="dk-quick-cart-btn" title="Add to Cart" aria-label="Add to Cart">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="8" cy="21" r="1"></circle>
                    <circle cx="19" cy="21" r="1"></circle>
                    <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                </svg>
            </button>
        </form>
    </div>
</article>