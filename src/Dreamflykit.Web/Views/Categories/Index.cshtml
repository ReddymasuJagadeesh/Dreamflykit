@model Dreamflykit.Web.Models.Categories.CategoryListViewModel

@{
    ViewData["Title"] = "All Categories - Dreamflykit Store";
}

<div class="dk-catalog-page">

    <!-- Top Breadcrumb -->
    <div class="dk-shell dk-catalog-top-bar">
        <nav class="dk-catalog-breadcrumb" aria-label="Breadcrumb">
            <a href="/" class="dk-breadcrumb-item">Home</a>
            <span class="dk-breadcrumb-separator">›</span>
            <span class="dk-breadcrumb-current">All Categories</span>
        </nav>
    </div>

    <div class="dk-shell" style="padding-top: 10px; padding-bottom: 40px;">

        <!-- Header Banner Card -->
        <div class="dk-category-hero-card" style="margin-bottom: 24px;">
            <div class="dk-category-hero-text">
                <div class="dk-category-hero-badge">
                    <span class="dk-badge-dot"></span>
                    <span>STUDENT ESSENTIALS DIRECTORY</span>
                </div>
                <h1 class="dk-category-hero-title">Shop by Category</h1>
                <p class="dk-category-hero-subtitle">
                    Find everything you need for overseas studies, tech setups, travel gear, lifestyle and university essentials.
                </p>
                <div class="dk-category-hero-meta">
                    <span class="dk-hero-meta-item"><strong>@Model.Categories.Count</strong> Categories</span>
                    <span class="dk-hero-meta-dot">•</span>
                    <span class="dk-hero-meta-item">⚡ 100% Genuine Supplies</span>
                    <span class="dk-hero-meta-dot">•</span>
                    <span class="dk-hero-meta-item">✈ Worldwide Student Express</span>
                </div>
            </div>
        </div>

        @if (Model.Categories.Count == 0)
        {
            <div class="dk-catalog-empty-card">
                <h2 class="dk-empty-title">Categories are currently being updated.</h2>
                <p class="dk-empty-desc">Please check back shortly or explore all available products.</p>
                <div class="dk-empty-actions">
                    <a href="/products" class="dk-btn-primary">Browse All Products</a>
                </div>
            </div>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px;">
                @foreach (var category in Model.Categories)
                {
                    <a href="/category/@category.Slug"
                       style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; box-shadow: 0 1px 4px rgba(0,0,0,0.04);"
                       onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 20px rgba(7,91,200,0.12)'; this.style.borderColor='#93c5fd';"
                       onmouseout="this.style.transform='none'; this.style.boxShadow='0 1px 4px rgba(0,0,0,0.04)'; this.style.borderColor='#e2e8f0';">

                        <div style="width: 90px; height: 90px; border-radius: 12px; background: #f0f7ff; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; overflow: hidden; border: 1px solid #dbeafe;">
                            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                            {
                                <img src="@category.ImageUrl"
                                     alt="@category.Name"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.onerror=null;this.src='/images/categories/category-placeholder.webp';" />
                            }
                            else
                            {
                                <span style="font-size: 36px;">🏷️</span>
                            }
                        </div>

                        <h2 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 6px 0;">
                            @category.Name
                        </h2>

                        <span style="font-size: 13px; font-weight: 600; color: #075bc8; margin-bottom: 10px;">
                            @category.ProductCount @(category.ProductCount == 1 ? "Product" : "Products")
                        </span>

                        <span style="margin-top: auto; font-size: 13px; font-weight: 600; color: #475569; display: inline-flex; align-items: center; gap: 4px;">
                            Explore Collection →
                        </span>
                    </a>
                }
            </div>
        }

    </div>

</div>