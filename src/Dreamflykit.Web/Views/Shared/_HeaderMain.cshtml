    ====================================================== -->
    @if (!isAbroadHub)
    {
    <nav class="dk-category-nav">

        <div class="dk-shell dk-category-nav-inner">

            <a href="/"
               class="dk-category-link @(currentReqPath == "/" ? "dk-category-active" : "")">
                <span>🏠</span>
                Home
            </a>

            @if (navCategories != null && navCategories.Count > 0)
            {
                @foreach (var cat in navCategories.OrderBy(c => c.DisplayOrder))
                {
                    var isCatActive = !string.IsNullOrEmpty(activeCatSlug) &&
                                      string.Equals(activeCatSlug, cat.Slug, StringComparison.OrdinalIgnoreCase);
                    <a href="/category/@cat.Slug"
                       class="dk-category-link @(isCatActive ? "dk-category-active" : "")"
                       title="@cat.Name">
                        <span>@getCatEmoji(cat.Slug)</span>
                        @cat.Name
                    </a>
                }
            }
            else
            {
                <a href="/category/study-essentials" class="dk-category-link @(activeCatSlug == "study-essentials" ? "dk-category-active" : "")">
                    <span>🎓</span> Study Essentials
                </a>
                <a href="/category/fashion" class="dk-category-link @(activeCatSlug == "fashion" ? "dk-category-active" : "")">
                    <span>👗</span> Fashion
                </a>
                <a href="/category/travel-gear" class="dk-category-link @(activeCatSlug == "travel-gear" ? "dk-category-active" : "")">
                    <span>✈</span> Travel Gear
                </a>
                <a href="/category/mobiles" class="dk-category-link @(activeCatSlug == "mobiles" ? "dk-category-active" : "")">
                    <span>📱</span> Mobiles
                </a>
                <a href="/category/electronics" class="dk-category-link @(activeCatSlug == "electronics" ? "dk-category-active" : "")">
                    <span>💻</span> Electronics
                </a>
                <a href="/category/appliances" class="dk-category-link @(activeCatSlug == "appliances" ? "dk-category-active" : "")">
                    <span>🔌</span> Appliances
                </a>
                <a href="/category/beauty" class="dk-category-link @(activeCatSlug == "beauty" ? "dk-category-active" : "")">
                    <span>💄</span> Beauty
                </a>
                <a href="/category/health-care" class="dk-category-link @(activeCatSlug == "health-care" ? "dk-category-active" : "")">
                    <span>💊</span> Health Care
                </a>
                <a href="/category/food" class="dk-category-link @(activeCatSlug == "food" ? "dk-category-active" : "")">
                    <span>🍫</span> Food
                </a>
                <a href="/category/room-living" class="dk-category-link @(activeCatSlug == "room-living" ? "dk-category-active" : "")">
