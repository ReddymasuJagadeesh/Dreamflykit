<!-- SCRIPTS (Hero AutoPlay, Countdown, Smooth Scroll) -->
<script>
(function() {
    // 1. Hero Carousel Controller
    const heroWrapper = document.getElementById('beautyHeroCarousel');
    if (heroWrapper) {
        const slides = heroWrapper.querySelectorAll('.dk-bpc-hero-slide');
        const dots = heroWrapper.querySelectorAll('.dk-bpc-hero-dot');
        const prevBtn = document.getElementById('bpcHeroPrev');
        const nextBtn = document.getElementById('bpcHeroNext');
        let currentIdx = 0;
        const total = slides.length;
        const autoPlay = heroWrapper.getAttribute('data-autoplay') === 'true';
        const intervalMs = parseInt(heroWrapper.getAttribute('data-interval') || '4000', 10);
        let timer = null;

        function goToSlide(idx) {
            slides[currentIdx].classList.remove('active');
            if (dots[currentIdx]) dots[currentIdx].classList.remove('active');
            currentIdx = (idx + total) % total;
            slides[currentIdx].classList.add('active');
            if (dots[currentIdx]) dots[currentIdx].classList.add('active');
        }

        function startTimer() {
            if (autoPlay && total > 1) {
                stopTimer();
                timer = setInterval(() => goToSlide(currentIdx + 1), intervalMs);
            }
        }

        function stopTimer() {
            if (timer) {
                clearInterval(timer);
                timer = null;
            }
        }

        if (nextBtn) nextBtn.addEventListener('click', () => { goToSlide(currentIdx + 1); startTimer(); });
        if (prevBtn) prevBtn.addEventListener('click', () => { goToSlide(currentIdx - 1); startTimer(); });

        dots.forEach(dot => {
            dot.addEventListener('click', () => {
                const target = parseInt(dot.getAttribute('data-target') || '0', 10);
                goToSlide(target);
                startTimer();
            });
        });

        heroWrapper.addEventListener('mouseenter', stopTimer);
        heroWrapper.addEventListener('mouseleave', startTimer);
        startTimer();
    }

    // 2. Countdown Timer for Flash Deals
    function updateCountdown() {
        const hoursBox = document.getElementById('cdHours');
        const minsBox = document.getElementById('cdMinutes');
        const secsBox = document.getElementById('cdSeconds');
        if (!hoursBox || !minsBox || !secsBox) return;

        // 12-hour cycle based on wall clock
        const now = new Date();
        const secondsRemaining = (12 * 3600) - ((now.getHours() % 12) * 3600 + now.getMinutes() * 60 + now.getSeconds());
        const h = Math.floor(secondsRemaining / 3600);
        const m = Math.floor((secondsRemaining % 3600) / 60);
        const s = secondsRemaining % 60;

        hoursBox.textContent = (h < 10 ? '0' : '') + h + 'h';
        minsBox.textContent = (m < 10 ? '0' : '') + m + 'm';
        secsBox.textContent = (s < 10 ? '0' : '') + s + 's';
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
})();

function scrollArchTrack(trackId, amount) {
    const track = document.getElementById(trackId);
    if (track) {
        track.scrollBy({ left: amount, behavior: 'smooth' });
    }
}
</script>

