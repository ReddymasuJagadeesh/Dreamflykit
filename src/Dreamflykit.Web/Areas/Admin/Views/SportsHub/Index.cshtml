                    CategorySlug: slug,
                    SubcategoryTag: pCard.querySelector('.prod-subcat-tag')?.value || '',
                    Description: pCard.querySelector('.prod-desc')?.value || '',
                    Price: parseFloat(pCard.querySelector('.prod-price').value || '0'),
                    OriginalPrice: parseFloat(pCard.querySelector('.prod-orig-price').value || '0'),
                    Badge: pCard.querySelector('.prod-badge').value,
                    Rating: parseFloat(pCard.querySelector('.prod-rating').value || '4.8'),
                    ReviewsCount: parseInt(pCard.querySelector('.prod-reviews').value || '100', 10),
                    Sizes: sizesList,
                    ImageUrl: pCard.querySelector('.prod-img').value,
                    IsUploadingSoon: pCard.querySelector('.prod-uploading').checked,
                    InStock: pCard.querySelector('.prod-instock').checked,
                    IsActive: true
                });
            });

            subcategoryPages.push({
                CategorySlug: slug,
                CategoryName: name,
                Subcategories: pageSubcatsList,
                ImportantNote: pageNote,
                HeroBanner: pHero,
                Products: pageProducts
            });
        });

        // 5. Top Picks & Bottom Banner
        var topPicks = {
            IsEnabled: document.getElementById('topPicksEnabled').checked,
            Title: document.getElementById('topPicksTitle').value,
            Subtitle: document.getElementById('topPicksSub').value
        };

        var bottomBanner = {
            IsEnabled: document.getElementById('bottomBannerEnabled').checked,
            Title: document.getElementById('bottomTitle').value,
            Subtitle: document.getElementById('bottomSub').value,
            ButtonText: document.getElementById('bottomBtnText').value,
            TargetUrl: document.getElementById('bottomTargetUrl').value
        };

        var payload = {
            FestivalTheme: festival,
            HeroBanner: hero,
            ShopByCategory: shopByCategory,
            SubcategoryPages: subcategoryPages,
            TopPicks: topPicks,
            BottomBanner: bottomBanner,
            ThreeSectionSliderSlug: "sports-hub"
        };

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('/Admin/SportsHub/Save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(payload)
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (data.success) {
                alert('Sports Hub configuration saved successfully!');
            } else {
                alert('Save failed: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(function (err) {
            alert('Save error: ' + err.message);
        })
        .finally(function () {
            btn.disabled = false;
            btn.innerHTML = '<svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> <span>Save All Changes</span>';
        });
    }
</script>
