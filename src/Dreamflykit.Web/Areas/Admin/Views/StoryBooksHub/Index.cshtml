// ----------------------------------------------------
// Save Complete Configuration
// ----------------------------------------------------
async function saveStoryBooksHubConfig() {
    const btn = document.getElementById('btnSaveStoryBooksTop');
    if (btn) btn.disabled = true;

    try {
        const payload = {
            ThemeSettings: {
                BrandName: document.getElementById('theme_BrandName').value.trim(),
                Tagline: document.getElementById('theme_Tagline').value.trim(),
                PrimaryRed: document.getElementById('theme_PrimaryRed').value.trim(),
                DarkBackground: document.getElementById('theme_DarkBackground').value.trim(),
                CardBackground: document.getElementById('theme_CardBackground').value.trim(),
                IsDarkThemeEnabled: document.getElementById('theme_IsDarkThemeEnabled').checked
            },
            HeroBillboard: {
                IsEnabled: document.getElementById('billboard_IsEnabled').checked,
                Title: document.getElementById('billboard_Title').value.trim(),
                Author: document.getElementById('billboard_Author').value.trim(),
                TagBadge: document.getElementById('billboard_TagBadge').value.trim(),
                GenreTags: document.getElementById('billboard_GenreTags').value.trim(),
                Synopsis: document.getElementById('billboard_Synopsis').value.trim(),
                ImageUrl: document.getElementById('billboard_ImageUrl').value.trim(),
                IsUploadingSoon: document.getElementById('billboard_IsUploadingSoon').checked,
                PrimaryButtonText: document.getElementById('billboard_PrimaryButtonText').value.trim(),
                SecondaryButtonText: document.getElementById('billboard_SecondaryButtonText').value.trim(),
                ReadTime: "340 Pages • ~6h Read",
                Language: "English",
                Price: parseFloat(document.getElementById('billboard_Price').value) || 0,
                OriginalPrice: parseFloat(document.getElementById('billboard_OriginalPrice').value) || 0,
                DiscountPercent: parseInt(document.getElementById('billboard_DiscountPercent').value) || 0,
                Rating: parseFloat(document.getElementById('billboard_Rating').value) || 4.9,
                ReviewCount: 1240
            },
            StoryBooksBanner: {
                IsEnabled: document.getElementById('sbBanner_IsEnabled').checked,
                Title: document.getElementById('sbBanner_Title').value.trim(),
                Subtitle: document.getElementById('sbBanner_Subtitle').value.trim(),
                TagBadge: document.getElementById('sbBanner_TagBadge').value.trim(),
                MetaTags: document.getElementById('sbBanner_MetaTags').value.trim(),
                ImageUrl: document.getElementById('sbBanner_ImageUrl').value.trim(),
                IsUploadingSoon: document.getElementById('sbBanner_IsUploadingSoon').checked,
                PrimaryButtonText: document.getElementById('sbBanner_PrimaryButtonText').value.trim(),
                SecondaryButtonText: document.getElementById('sbBanner_SecondaryButtonText').value.trim(),
                PrimaryButtonUrl: "#explore",
                SecondaryButtonUrl: "#info"
            },
            NewPopularBanner: {
                IsEnabled: document.getElementById('npBanner_IsEnabled').checked,
                Title: document.getElementById('npBanner_Title').value.trim(),
                Subtitle: document.getElementById('npBanner_Subtitle').value.trim(),
                TagBadge: document.getElementById('npBanner_TagBadge').value.trim(),
                MetaTags: document.getElementById('npBanner_MetaTags').value.trim(),
                ImageUrl: document.getElementById('npBanner_ImageUrl').value.trim(),
                IsUploadingSoon: document.getElementById('npBanner_IsUploadingSoon').checked,
                PrimaryButtonText: document.getElementById('npBanner_PrimaryButtonText').value.trim(),
                SecondaryButtonText: document.getElementById('npBanner_SecondaryButtonText').value.trim(),
                PrimaryButtonUrl: "#explore",
                SecondaryButtonUrl: "#info"
            },
            LanguagesBanner: {
                IsEnabled: document.getElementById('langBanner_IsEnabled').checked,
                Title: document.getElementById('langBanner_Title').value.trim(),
                Subtitle: document.getElementById('langBanner_Subtitle').value.trim(),
                TagBadge: document.getElementById('langBanner_TagBadge').value.trim(),
                MetaTags: document.getElementById('langBanner_MetaTags').value.trim(),
                ImageUrl: document.getElementById('langBanner_ImageUrl').value.trim(),
                IsUploadingSoon: document.getElementById('langBanner_IsUploadingSoon').checked,
                PrimaryButtonText: document.getElementById('langBanner_PrimaryButtonText').value.trim(),
                SecondaryButtonText: document.getElementById('langBanner_SecondaryButtonText').value.trim(),
                PrimaryButtonUrl: "#explore",
                SecondaryButtonUrl: "#info"
            },
            Sections: [],
            Genres: [],
            Languages: [],
            Preferences: []
        };

        // Collect Sections
        document.querySelectorAll('.sbf-section-card').forEach((secEl, sIdx) => {
            const sec = {
                Id: 'section-' + (sIdx + 1),
                Title: secEl.querySelector('.sec-title').value.trim(),
                Subtitle: secEl.querySelector('.sec-sub').value.trim(),
                DisplayType: secEl.querySelector('.sec-type').value,
                DisplayOrder: sIdx + 1,
                IsActive: secEl.querySelector('.sec-active').checked,
                Books: []
            };

            secEl.querySelectorAll('.sbf-book-editor-card').forEach((bEl, bIdx) => {
                sec.Books.push({
                    Id: bEl.querySelector('.book-id').value || ('book-' + (sIdx + 1) + '-' + (bIdx + 1)),
                    Title: bEl.querySelector('.book-title').value.trim(),
                    Author: bEl.querySelector('.book-author').value.trim(),
                    CoverImageUrl: bEl.querySelector('.book-cover-url').value.trim(),
                    IsUploadingSoon: bEl.querySelector('.book-uploading-soon').checked,
                    Price: parseFloat(bEl.querySelector('.book-price').value) || 0,
                    OriginalPrice: parseFloat(bEl.querySelector('.book-orig-price').value) || 0,
                    DiscountPercent: 0,
                    Rating: 4.8,
                    GenreSlug: bEl.querySelector('.book-genre-slug').value.trim(),
                    GenreName: bEl.querySelector('.book-genre-slug').value.trim(),
                    Language: bEl.querySelector('.book-lang').value.trim(),
                    EditionPreference: 'original',
                    Synopsis: 'University curated literary work.',
                    IsTop10: sec.DisplayType === 'top10',
                    Top10Rank: sec.DisplayType === 'top10' ? (bIdx + 1) : 0,
                    ReadingProgress: '',
                    ProgressPercent: 0,
                    BadgeText: ''
                });
            });

            payload.Sections.push(sec);
        });

        // Collect Genres
        document.querySelectorAll('.genre-row').forEach(row => {
            payload.Genres.push({
                Emoji: row.querySelector('.genre-emoji').value.trim(),
                Name: row.querySelector('.genre-name').value.trim(),
                Slug: row.querySelector('.genre-slug').value.trim(),
                BookCount: 0
            });
        });

        // Collect Languages
        document.querySelectorAll('.lang-row').forEach(row => {
            payload.Languages.push({
                Code: row.querySelector('.lang-code').value.trim(),
                Name: row.querySelector('.lang-name').value.trim(),
                NativeLabel: row.querySelector('.lang-native').value.trim(),
                BookCount: 0
            });
        });

        // Collect Preferences
        document.querySelectorAll('.pref-row').forEach(row => {
            payload.Preferences.push({
                Key: row.querySelector('.pref-key').value.trim(),
                Label: row.querySelector('.pref-label').value.trim()
            });
        });

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const resp = await fetch('/Admin/StoryBooksHub/Save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(payload)
        });

        const result = await resp.json();
        if (result.success) {
            alert('✓ Story Books Hub settings saved successfully!');
            window.location.reload();
        } else {
            alert('Save failed: ' + (result.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Save error: ' + err.message);
    } finally {
        if (btn) btn.disabled = false;
    }
}
</script>
