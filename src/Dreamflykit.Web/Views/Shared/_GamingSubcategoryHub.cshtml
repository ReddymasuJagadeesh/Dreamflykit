@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.GamingHub ?? Dreamflykit.Application.GamingHub.Models.GamingHubDto.CreateDefault();
    var allCategories = hub.ShopByCategory?.Items?.Where(i => i.IsActive).OrderBy(i => i.DisplayOrder).ToList() ?? new();
    if (allCategories.Count == 0)
    {
        allCategories = Dreamflykit.Application.GamingHub.Models.GamingHubDto.CreateDefaultCategoryItems();
    }

    var currentSlug = (Model.CurrentSubcategorySlug ?? "").Trim().ToLowerInvariant();
    var activeCategory = allCategories.FirstOrDefault(c => string.Equals(c.Slug, currentSlug, StringComparison.OrdinalIgnoreCase))
                         ?? allCategories.FirstOrDefault(c => string.Equals(c.Slug, "playstation", StringComparison.OrdinalIgnoreCase))
                         ?? allCategories.FirstOrDefault();

    var activeCategorySlug = activeCategory?.Slug ?? "playstation";
    var activeCategoryName = activeCategory?.Name ?? (!string.IsNullOrWhiteSpace(Model.CategoryName) && !string.Equals(Model.CategoryName, "Gaming Hub", StringComparison.OrdinalIgnoreCase) ? Model.CategoryName : "PlayStation");
    var activeCategoryEmoji = activeCategory?.IconEmoji ?? "🎮";
    var activeCategorySubcategories = activeCategory?.Subcategories ?? new List<string>();

    var subPage = Model.GamingSubcategoryPage
                  ?? hub.SubcategoryPages?.FirstOrDefault(p => string.Equals(p.CategorySlug, activeCategorySlug, StringComparison.OrdinalIgnoreCase))
                  ?? Dreamflykit.Application.GamingHub.Models.GamingHubDto.CreateDefaultSubcategoryPages().FirstOrDefault(p => string.Equals(p.CategorySlug, activeCategorySlug, StringComparison.OrdinalIgnoreCase))
                  ?? Dreamflykit.Application.GamingHub.Models.GamingHubDto.CreateDefaultSubcategoryPages().FirstOrDefault();

    if (activeCategorySubcategories.Count == 0 && subPage?.Subcategories != null && subPage.Subcategories.Count > 0)
    {
        activeCategorySubcategories = subPage.Subcategories;
    }

    var activeCategoryNote = !string.IsNullOrWhiteSpace(activeCategory?.ImportantNote)
        ? activeCategory.ImportantNote
        : subPage?.ImportantNote;

    var hero = subPage?.HeroBanner ?? new Dreamflykit.Application.GamingHub.Models.GamingSubcategoryHeroDto();
    var products = subPage?.Products ?? new List<Dreamflykit.Application.GamingHub.Models.GamingProductItemDto>();
    var activeSubItem = Model.CurrentSubcatItem ?? "";

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="dk-study-cat-page-wrapper dk-gaming-explorer-wrapper">

    @if (canManage)
    {
        <div class="dk-study-hub-admin-bar">
            <span class="dk-sh-admin-badge">Admin Controls</span>
            <span class="dk-sh-admin-hint">Managing Gaming Hub Category: <strong>@activeCategoryName</strong>. Super Admin can replace hero image, products, text &amp; subcategories.</span>
            <a href="/Admin/GamingHub" class="dk-sh-admin-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Manage Gaming Hub &amp; Categories
            </a>
        </div>
    }

    <!-- ========================================================
         COMMON HERO BANNER (TOP FULL WIDTH)
         Admin Replaceable Image + Gaming Dark Neon Theme
    ========================================================= -->
    <header class="dk-study-common-hero dk-gaming-hero frame-arch-gold">
        <div class="dk-hero-inner-grid">
            <div class="dk-hero-text-col">
                <div class="dk-hero-pill-badge dk-gaming-pill-badge">
                    <span class="dk-hero-dot"></span>
                    @(!string.IsNullOrWhiteSpace(hero.TitleHighlight) ? hero.TitleHighlight : "VERIFIED GAMING GEAR • 100% GENUINE")
                </div>

                <h1 class="dk-hero-main-title">
                    @(!string.IsNullOrWhiteSpace(hero.Title) ? hero.Title : activeCategoryName) Consoles &amp; Battlestation Gear
                </h1>
                <p class="dk-hero-main-sub">
                    @(string.IsNullOrWhiteSpace(hero.Subtitle)
                        ? $"Discover verified genuine {activeCategoryName} systems, pro controllers, low-latency gear and dorm battlestation setups."
                        : hero.Subtitle)
                </p>

                <div class="dk-hero-trust-badges">
                    <div class="dk-hero-trust-item">
                        <span class="dk-hero-trust-icon">🎮</span>
                        <span>100% Genuine Gear &bull; <strong>Verified Systems</strong></span>
                    </div>
                    <div class="dk-hero-trust-item">
                        <span class="dk-hero-trust-icon">🚚</span>
                        <span>Campus Fast Delivery &bull; <strong>Direct to Dorm</strong></span>
                    </div>
                    <div class="dk-hero-trust-item">
                        <span class="dk-hero-trust-icon">🛡️</span>
                        <span>1-Year Warranty &bull; <strong>7-Day Easy Replacement</strong></span>
                    </div>
                </div>
            </div>

            <div class="dk-hero-img-col">
                @{
                    var heroImg = !string.IsNullOrWhiteSpace(hero.ImageUrl) ? hero.ImageUrl : "";
                    var isTestPic = string.IsNullOrWhiteSpace(heroImg) || heroImg.Contains("placeholder") || hero.IsUploadingSoon;
                }

                @if (isTestPic)
                {
                    <div class="dk-hero-test-pic-box dk-gaming-test-pic-box">
                        <div class="dk-gaming-radar-pulse">
                            <span class="dk-radar-ring ring-1"></span>
                            <span class="dk-radar-ring ring-2"></span>
                            <span class="dk-hero-cam-icon">@activeCategoryEmoji</span>
                        </div>
                        <div class="dk-hero-test-btn">UPLOADING SOON</div>
                        <div class="dk-hero-test-title">Admin will implement images</div>
                        <div class="dk-hero-test-sub">Admin panel can upload/replace image anytime</div>
                    </div>
                }
                else
                {
                    <div class="dk-hero-custom-img-wrap">
                        <img src="@heroImg" alt="@activeCategoryName Hero" loading="eager" onerror="this.onerror=null;this.src='/images/gaming-hub/cats/playstation.webp';" />
                    </div>
                }
            </div>
        </div>

        <!-- 4 Bottom Trust Highlights Bar inside Hero -->
        <div class="dk-hero-trust-bar">
            <div class="dk-htb-item">
                <span class="dk-htb-icon">⭐</span>
                <div>
                    <strong>Pro Performance Tested</strong>
                    <span>Handpicked for Gamers</span>
                </div>
            </div>
            <div class="dk-htb-item">
                <span class="dk-htb-icon">📦</span>
                <div>
                    <strong>Affordable Campus Bundles</strong>
                    <span>Save More, Play More</span>
                </div>
            </div>
            <div class="dk-htb-item">
                <span class="dk-htb-icon">🔒</span>
                <div>
                    <strong>Secure Checkout</strong>
                    <span>Multiple Payment Options</span>
                </div>
            </div>
            <div class="dk-htb-item">
                <span class="dk-htb-icon">🚚</span>
                <div>
                    <strong>Campus Fast Delivery</strong>
                    <span>To Your Doorstep</span>
                </div>
            </div>
        </div>
    </header>

    <!-- ========================================================
         22 GAMING CATEGORIES QUICK NAV PILLS STRIP
         Exactly like Study Essentials: EXPLORE 22 CATEGORIES
    ========================================================= -->
    <div class="dk-study-cat-nav-strip">
        <div class="dk-study-cat-nav-title">
            <span>Explore @allCategories.Count Categories:</span>
        </div>
        <div class="dk-study-cat-nav-items">
            @foreach (var c in allCategories)
            {
                var isSelected = string.Equals(c.Slug, activeCategorySlug, StringComparison.OrdinalIgnoreCase);
                <a href="/category/gaming-hub/@c.Slug"
                   class="dk-cat-nav-pill @(isSelected ? "is-selected" : "")"
                   title="Browse @c.Name">
                    <span class="dk-cat-pill-icon">@c.IconEmoji</span>
                    <span class="dk-cat-pill-name">@c.Name</span>
                </a>
            }
        </div>
    </div>

    <!-- ========================================================
         MAIN 2-COLUMN LAYOUT:
         LEFT: SUBCATEGORIES FILTER LIST FOR THIS CATEGORY
         RIGHT: MATCHING PRODUCTS LIST
    ========================================================= -->
    <div class="dk-cat-main-layout">

        <!-- LEFT SIDEBAR: SUBCATEGORIES FILTER -->
        <aside class="dk-cat-sidebar" id="dkGamingSidebar">
            <div class="dk-cat-sidebar-card">
                <div class="dk-cat-sidebar-header">
                    <h2 class="dk-cat-sidebar-title">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Subcategories
                    </h2>
                    @if (!string.IsNullOrWhiteSpace(activeSubItem))
                    {
                        <button type="button" class="dk-cat-clear-btn" onclick="filterBySubItem('')" title="Clear subcategory filter">
                            Clear
                        </button>
                    }
                </div>

                <div class="dk-cat-sidebar-subhead">
                    <span>@activeCategoryName.ToUpper()</span>
                </div>

                <nav class="dk-cat-sub-list" aria-label="@activeCategoryName Subcategories">
                    <!-- Option to view all products of this category -->
                    <a href="/category/gaming-hub/@activeCategorySlug"
                       class="dk-cat-sub-link @(string.IsNullOrWhiteSpace(activeSubItem) ? "is-active" : "")"
                       data-subitem=""
                       onclick="event.preventDefault(); filterBySubItem('');">
                        <span class="dk-sub-radio"></span>
                        <span class="dk-sub-text">All @activeCategoryName</span>
                        <span class="dk-sub-badge">All</span>
                    </a>

                    <!-- Subcategories list for this gaming category -->
                    @foreach (var sub in activeCategorySubcategories)
                    {
                        var isCurrentSub = string.Equals(activeSubItem, sub, StringComparison.OrdinalIgnoreCase);
                        <a href="/category/gaming-hub/@activeCategorySlug?subcatItem=@Uri.EscapeDataString(sub)"
                           class="dk-cat-sub-link @(isCurrentSub ? "is-active" : "")"
                           data-subitem="@sub"
                           onclick="event.preventDefault(); filterBySubItem(this.dataset.subitem);">
                            <span class="dk-sub-radio"></span>
                            <span class="dk-sub-text">@sub</span>
                        </a>
                    }
                </nav>
            </div>

            <!-- IMPORTANT NOTE CARD FOR GAMERS -->
            @if (!string.IsNullOrWhiteSpace(activeCategoryNote))
            {
                <div class="dk-cat-note-card">
                    <div class="dk-cat-note-head">
                        <span class="dk-cat-note-icon">💡</span>
                        <strong>Important Gamer Note:</strong>
                    </div>
                    <p class="dk-cat-note-text">
                        @activeCategoryNote
                    </p>
                </div>
            }

            <!-- Price Filters Strip in Sidebar -->
            <div class="dk-cat-sidebar-card" style="margin-top: 14px;">
                <h3 class="dk-cat-sidebar-title" style="font-size: 13.5px; margin-bottom: 10px;">Price Range</h3>
                <div class="dk-cat-price-facets">
                    <a href="javascript:void(0)" onclick="filterByPriceRange(0, 2000)" class="dk-price-facet-chip">Under ₹2,000</a>
                    <a href="javascript:void(0)" onclick="filterByPriceRange(2000, 10000)" class="dk-price-facet-chip">₹2,000 - ₹10,000</a>
                    <a href="javascript:void(0)" onclick="filterByPriceRange(10000, 30000)" class="dk-price-facet-chip">₹10,000 - ₹30,000</a>
                    <a href="javascript:void(0)" onclick="filterByPriceRange(30000, 999999)" class="dk-price-facet-chip">₹30,000 &amp; Above</a>
                </div>
            </div>

            <!-- Need Complete Kit Promo -->
            <div class="dk-cat-sidebar-promo dk-gaming-sidebar-promo">
                <div class="dk-sp-tag">Dorm Battlestation</div>
                <h4 class="dk-sp-title">Student Battlestation Kits</h4>
                <p class="dk-sp-sub">Curated setups with consoles, low-latency monitors, headsets &amp; student warranty.</p>
                <a href="/category/gaming-hub" class="dk-sp-btn">Explore Gaming Hub →</a>
            </div>
        </aside>

        <!-- RIGHT CONTENT AREA: PRODUCTS LIST -->
        <main class="dk-cat-content" id="dkCatContentArea">
            <div id="dkCatProductsInner">

                <!-- Top Action Bar (Title, Breadcrumb & Sorting) -->
                <div class="dk-cat-products-header-card">
                    <div class="dk-cat-crumb-row">
                        <a href="/" class="dk-c-crumb">Home</a>
                        <span class="dk-c-sep">›</span>
                        <a href="/category/gaming-hub" class="dk-c-crumb">Gaming Hub</a>
                        <span class="dk-c-sep">›</span>
                        <span class="dk-c-current">@activeCategoryName</span>
                    </div>

                    <div class="dk-cat-title-row">
                        <div>
                            <h1 class="dk-cat-heading">@activeCategoryName</h1>
                            <p class="dk-cat-subtext">Verified gaming consoles, pro accessories, low-latency gear and dorm battlestation setups.</p>
                        </div>

                        <div class="dk-cat-sort-box">
                            <label for="dkGamingSortSelect" class="dk-sort-label">Sort By:</label>
                            <select id="dkGamingSortSelect" class="dk-sort-dropdown" onchange="handleGamingSortChange(this.value)">
                                <option value="featured">Featured / Relevance</option>
                                <option value="price-asc">Price: Low to High</option>
                                <option value="price-desc">Price: High to Low</option>
                                <option value="rating">Customer Rating</option>
                                <option value="discount">Discount</option>
                            </select>
                        </div>
                    </div>

                    <div class="dk-cat-meta-bar">
                        <span class="dk-cat-prod-count" id="dkCatProdCount">@products.Count Products</span>

                        <!-- Active filter chip for selected subcategory -->
                        <div id="dkCatActiveChipWrap" class="dk-active-filter-chip" style="@(string.IsNullOrWhiteSpace(activeSubItem) ? "display: none;" : "display: inline-flex;")">
                            <span>Subcategory: <strong id="dkCatActiveChipText">@activeSubItem</strong></span>
                            <button type="button" class="dk-chip-remove-btn" onclick="filterBySubItem('')" title="Remove filter">✕</button>
                        </div>
                    </div>
                </div>

                <!-- PRODUCTS GRID -->
                @if (products.Count > 0)
                {
                    <div class="dk-cat-products-grid">
                        @foreach (var prod in products)
                        {
                            var hasRealImg = !string.IsNullOrWhiteSpace(prod.ImageUrl) && !prod.ImageUrl.Contains("placeholder") && !prod.IsUploadingSoon;
                            var originalPrice = prod.NumericOriginalPrice > 0 ? prod.NumericOriginalPrice : prod.NumericPrice;
                            var discountPercent = prod.NumericDiscount > 0 ? prod.NumericDiscount : (originalPrice > prod.NumericPrice && originalPrice > 0 ? Math.Round(((originalPrice - prod.NumericPrice) / originalPrice) * 100, 0) : 0);
                            var prodUrl = $"/category/gaming-hub/{activeCategorySlug}";

                            <div class="dk-cat-prod-card"
                                 data-product-id="@prod.Id"
                                 data-subcat-tags="@(prod.SubcategoryTag ?? "") @prod.Title @(prod.Description ?? "") @prod.Brand"
                                 data-title="@prod.Title"
                                 data-desc="@(prod.Description ?? "")"
                                 data-price="@prod.NumericPrice"
                                 data-rating="@prod.Rating"
                                 data-discount="@discountPercent">

                                <div class="dk-cat-prod-img-box">
                                    @if (hasRealImg)
                                    {
                                        <img src="@prod.ImageUrl" alt="@prod.Title" loading="lazy" onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'dk-sports-card-uploading dk-gaming-card-uploading\'><span class=\'dk-sc-emoji\'>@activeCategoryEmoji</span><span class=\'dk-sc-badge\'>● Uploading Soon</span><p class=\'dk-sc-hint\'>Admin will implement images</p></div>';" />
                                    }
                                    else
                                    {
                                        <div class="dk-sports-card-uploading dk-gaming-card-uploading">
                                            <div class="dk-sc-radar-wrap">
                                                <span class="dk-sc-ring ring-1"></span>
                                                <span class="dk-sc-ring ring-2"></span>
                                                <span class="dk-sc-emoji">@activeCategoryEmoji</span>
                                            </div>
                                            <span class="dk-sc-badge">● Uploading Soon</span>
                                            <p class="dk-sc-hint">Admin will implement images</p>
                                        </div>
                                    }

                                    @if (discountPercent > 0)
                                    {
                                        <span class="dk-cat-prod-badge">@discountPercent.ToString("0")% OFF</span>
                                    }
                                </div>

                                <div class="dk-cat-prod-details">
                                    <span class="dk-cat-prod-badge-verified dk-gaming-badge-verified">Verified Gaming Gear</span>
                                    <h3 class="dk-cat-prod-title">
                                        <a href="@prodUrl" title="@prod.Title">@prod.Title</a>
                                    </h3>
                                    <p class="dk-cat-prod-desc">
                                        @if (!string.IsNullOrWhiteSpace(prod.SubcategoryTag))
                                        {
                                            <strong style="color: #2563eb; display: inline;">@prod.SubcategoryTag.</strong>
                                        }
                                        @(string.IsNullOrWhiteSpace(prod.Description) ? "Verified authentic hardware engineered for low-latency performance with full student warranty." : prod.Description)
                                    </p>

                                    <div class="dk-cat-prod-rating-row">
                                        <span class="dk-cat-stars">★★★★★</span>
                                        <span class="dk-cat-rating-num">@(!string.IsNullOrWhiteSpace(prod.Rating) ? prod.Rating : "4.9")</span>
                                        <span class="dk-cat-reviews-count">(Student Gamer Favorite)</span>
                                    </div>

                                    <div class="dk-cat-prod-price-area">
                                        <span class="dk-cat-prod-price">@(!string.IsNullOrWhiteSpace(prod.PriceText) ? prod.PriceText : ("₹" + prod.NumericPrice.ToString("N0")))</span>
                                        @if (originalPrice > prod.NumericPrice && originalPrice > 0)
                                        {
                                            <span class="dk-cat-prod-mrp">@(!string.IsNullOrWhiteSpace(prod.OriginalPriceText) ? prod.OriginalPriceText : ("₹" + originalPrice.ToString("N0")))</span>
                                            <span class="dk-cat-prod-save">Save ₹@((originalPrice - prod.NumericPrice).ToString("N0"))</span>
                                        }
                                    </div>

                                    <div class="dk-cat-prod-actions">
                                        <button type="button" class="dk-cat-btn-buy dk-gaming-btn-buy" onclick="handleGamingAddToCart('@prod.Id', '@prod.Title.Replace("'", "\\'")')">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                                                <circle cx="9" cy="21" r="1"></circle>
                                                <circle cx="20" cy="21" r="1"></circle>
                                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                            </svg>
                                            Add to Cart
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Dynamic Empty State when client-side filter yields 0 cards -->
                    <div id="dkCatSubEmptyState" class="dk-cat-empty-box" style="display: none;">
                        <div class="dk-cat-empty-icon">🔍</div>
                        <h3>No products found for this subcategory</h3>
                        <p>Admin will upload more products for this subcategory soon. Try another subcategory or browse all @activeCategoryName products.</p>
                        <button type="button" class="dk-cat-btn-reset" onclick="filterBySubItem('')">
                            Browse All @activeCategoryName
                        </button>
                    </div>
                }
                else
                {
                    <div class="dk-cat-empty-box">
                        <div class="dk-cat-empty-icon">📦</div>
                        <h3>Products uploading soon by Admin</h3>
                        <p>Admin is currently configuring products for @activeCategoryName. Check back shortly!</p>
                        <a href="/category/gaming-hub" class="dk-cat-btn-reset">Back to Gaming Hub</a>
                    </div>
                }
            </div>
        </main>
    </div>

</div>

<!-- ========================================================
     INLINE STYLING FOR GAMING CATEGORIES EXPLORER
     (Matching Study Essentials & Sports Hub Design System)
========================================================= -->
<style>
    .dk-gaming-explorer-wrapper {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        padding: 4px 0 32px 0;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Admin bar */
    .dk-study-hub-admin-bar {
        background: #0f172a;
        color: #f8fafc;
        padding: 10px 18px;
        border-radius: 10px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }
    .dk-sh-admin-badge {
        background: #ef4444;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 3px 8px;
        border-radius: 4px;
    }
    .dk-sh-admin-hint {
        font-size: 13px;
        color: #cbd5e1;
        flex: 1;
    }
    .dk-sh-admin-hint strong {
        color: #67e8f9;
    }
    .dk-sh-admin-btn {
        background: #2563eb;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.2s;
    }
    .dk-sh-admin-btn:hover {
        background: #1d4ed8;
        color: #ffffff;
    }

    /* Common Hero Banner */
    .dk-study-common-hero {
        position: relative;
        background: linear-gradient(135deg, #0b1120 0%, #0f172a 60%, #1e1b4b 100%);
        color: #ffffff;
        border-radius: 16px;
        padding: 32px 36px 20px 36px;
        margin-bottom: 18px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.25);
    }
    .dk-hero-inner-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 32px;
        align-items: center;
    }
    .dk-hero-pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(37, 99, 235, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.4);
        color: #93c5fd;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 20px;
        margin-bottom: 12px;
    }
    .dk-gaming-pill-badge {
        background: rgba(147, 51, 234, 0.2);
        border-color: rgba(168, 85, 247, 0.4);
        color: #d8b4fe;
    }
    .dk-hero-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 8px #38bdf8;
    }
    .dk-hero-main-title {
        font-size: 28px;
        font-weight: 800;
        line-height: 1.25;
        margin: 0 0 10px 0;
        letter-spacing: -0.5px;
        color: #ffffff;
    }
    .dk-hero-main-sub {
        font-size: 14.5px;
        color: #cbd5e1;
        line-height: 1.5;
        margin: 0 0 18px 0;
        max-width: 680px;
    }
    .dk-hero-trust-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }
    .dk-hero-trust-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        color: #e2e8f0;
    }
    .dk-hero-trust-icon {
        font-size: 16px;
    }
    .dk-hero-trust-item strong {
        color: #38bdf8;
    }

    /* Test pic / Radar glow */
    .dk-hero-img-col {
        display: flex;
        justify-content: center;
    }
    .dk-hero-test-pic-box {
        width: 100%;
        max-width: 320px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px dashed rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        padding: 24px 16px;
        text-align: center;
        backdrop-filter: blur(8px);
    }
    .dk-gaming-radar-pulse {
        position: relative;
        width: 70px;
