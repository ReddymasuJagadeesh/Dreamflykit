@model Dreamflykit.Application.StudyHub.Models.StudyHubDto
@{
    Layout = "_Layout";
    var profile = Model.AbroadProfile ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefaultAbroadProfile();
    ViewData["Title"] = (!string.IsNullOrWhiteSpace(profile.HeroTitle) ? profile.HeroTitle + " " + profile.HeroTitleHighlight : "Study Abroad Hub") + " — Dreamflykit";
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    var sLoans = profile.Services.FirstOrDefault(s => s.Id == "srv-loans") ?? profile.Services.ElementAtOrDefault(0);
    var sConsultancy = profile.Services.FirstOrDefault(s => s.Id == "srv-consultancy") ?? profile.Services.ElementAtOrDefault(1);
    var sInsurance = profile.Services.FirstOrDefault(s => s.Id == "srv-insurance") ?? profile.Services.ElementAtOrDefault(2);
    var sBooking = profile.Services.FirstOrDefault(s => s.Id == "srv-booking") ?? profile.Services.ElementAtOrDefault(3);
    var sTests = profile.Services.FirstOrDefault(s => s.Id == "srv-tests") ?? profile.Services.ElementAtOrDefault(4);
    var sScholarships = profile.Services.FirstOrDefault(s => s.Id == "srv-scholarships") ?? profile.Services.ElementAtOrDefault(5);
}

<div class="dk-abroad-hub-root">

    <!-- ========================================================
         HERO BANNER: FULL-WIDTH IMAGE / VIDEO BANNER (Image 2 Style)
         Super Admin can upload high-res Image OR Video with reality view animations.
         Directly touches the profile switch bar above with 0 gap.
    ========================================================= -->
    <section class="dk-abroad-hero-section @((profile.HeroEnableVideo && !string.IsNullOrWhiteSpace(profile.HeroVideoUrl)) || !string.IsNullOrWhiteSpace(profile.HeroImageUrl) ? "has-hero-bg" : "is-uploading-soon") @(profile.HeroShowText ? "show-text-overlay" : "hide-text-overlay")"
             aria-label="Study Abroad Hub Hero">

        <!-- Background Video if enabled by Admin -->
        @if (profile.HeroEnableVideo && !string.IsNullOrWhiteSpace(profile.HeroVideoUrl))
        {
            <video class="dk-abroad-hero-video-bg" autoplay muted loop playsinline src="@profile.HeroVideoUrl"></video>
        }
        else if (!string.IsNullOrWhiteSpace(profile.HeroImageUrl))
        {
            <div class="dk-abroad-hero-bg-cover" style="background-image: url('@profile.HeroImageUrl');"></div>
        }

        <!-- Translucent Backdrop Overlay to guarantee crisp text contrast (Only when text is shown) -->
        @if (profile.HeroShowText)
        {
            <div class="dk-abroad-hero-overlay" aria-hidden="true"></div>
        }

        @if (string.IsNullOrWhiteSpace(profile.HeroImageUrl) && (!profile.HeroEnableVideo || string.IsNullOrWhiteSpace(profile.HeroVideoUrl)))
        {
            <div class="dk-abroad-hero-deco-bg" aria-hidden="true">
                <div class="dk-reality-light-beam"></div>
                <div class="dk-reality-orb-1"></div>
                <div class="dk-reality-orb-2"></div>
                <span class="dk-deco-plane-sky">✈</span>
                <span class="dk-deco-cloud cloud-1">☁</span>
                <span class="dk-deco-cloud cloud-2">☁</span>
                <svg class="dk-skyline-silhouette" viewBox="0 0 1000 240" fill="none" opacity="0.22" preserveAspectRatio="xMaxYMid meet">
                    <path d="M40 240V140h20v-40h12v40h20v100H40z M72 70l-6 30h12z" fill="#0284c7"/>
                    <path d="M140 240V110h24v130h-24z M152 70l-8 40h16z" fill="#0284c7"/>
                    <path d="M260 240l30-180h12l30 180h-18l-10-60h-16l-10 60h-18z M294 130h18l-9-60z" fill="#0284c7"/>
                    <path d="M420 240c0-70 50-110 110-110v110h-110z M540 240c0-85 60-125 130-125v125h-130z" fill="#0284c7"/>
                    <path d="M720 240l40-150h15l40 150h-20l-12-50h-31l-12 50h-20z" fill="#0284c7"/>
                </svg>
            </div>

            <!-- Uploading Soon notice badge -->
            <div class="dk-abroad-hero-status-pill">
                <span class="dk-status-pulse-dot"></span>
                <span>📷 Full Hero Visual (Image/Video): Uploading Soon &bull; Super Admin can upload panoramic banner or video anytime</span>
                @if (canManage)
                {
                    <a href="/Admin/StudyHub#tab-abroad-profile" class="dk-status-admin-link">Upload in Admin Panel →</a>
                }
            </div>
        }

        @if (profile.HeroShowText)
        {
            <div class="dk-abroad-hero-inner">
                
                <div class="dk-abroad-hero-content">
                    <div class="dk-abroad-hero-badge">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
                        </svg>
                        <span>@profile.HeroBadge</span>
                    </div>

                    <h1 class="dk-abroad-hero-heading">
                        @profile.HeroTitle
                        <span class="dk-abroad-highlight">@profile.HeroTitleHighlight</span>
                    </h1>

                    <p class="dk-abroad-hero-sub">
                        @profile.HeroSubtitle
                    </p>

                    <!-- DIRECT HERO SERVICE PILLS (Admin can choose what to display) -->
                    @{
                        var displayPills = (profile.HeroServices ?? new List<Dreamflykit.Application.StudyHub.Models.AbroadHeroServiceItemDto>())
                            .Where(hs => hs.IsEnabled)
                            .ToList();
                    }
                    @if (displayPills.Count > 0)
                    {
                        <div class="dk-abroad-hero-quick-services" role="navigation" aria-label="Quick Hub Services">
                            @foreach (var hs in displayPills)
                            {
                                <a href="@hs.TargetUrl" class="dk-abroad-h-badge">
                                    <span class="dk-abroad-h-icon" aria-hidden="true">
                                        @if (hs.IconType == "loan")
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                                        }
                                        else if (hs.IconType == "gr_loan")
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="21" x2="21" y2="21"></line><line x1="3" y1="10" x2="21" y2="10"></line><polyline points="5 6 12 3 19 6"></polyline><line x1="4" y1="10" x2="4" y2="21"></line><line x1="20" y1="10" x2="20" y2="21"></line></svg>
                                        }
                                        else if (hs.IconType == "consultancy")
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                        }
                                        else if (hs.IconType == "near_me")
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                        }
                                        else if (hs.IconType == "insurance")
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                        }
                                        else if (hs.IconType == "booking")
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="12" cy="15" r="2"/></svg>
                                        }
                                        else if (hs.IconType == "test")
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="12" y2="11"/></svg>
                                        }
                                        else if (hs.IconType == "scholarship")
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="m10 15 5-3-5-3v6z"/></svg>
                                        }
                                    </span>
                                    <span>@hs.Title</span>
                                </a>
                            }
                        </div>
                    }

                    <div class="dk-abroad-hero-cta-line">
                        <a href="@profile.HeroCtaUrl" class="dk-abroad-cta-btn">
                            <span>@profile.HeroCtaText</span>
                        </a>

                        <div class="dk-abroad-slider-dots" aria-hidden="true">
                            <span class="dk-dot active"></span>
                            <span class="dk-dot"></span>
                            <span class="dk-dot"></span>
                        </div>
                    </div>
                </div>

            </div>
        }
    </section>

    <!-- ========================================================
         2. SYNCHRONIZED 5-SECTION CAROUSEL (Image 3 Bank of Baroda Style)
         All 5 sections transition at one time, with Play/Pause button and Admin timing
    ========================================================= -->
    @if (profile.FiveSectionCarousel != null && profile.FiveSectionCarousel.IsEnabled)
    {
        <partial name="_AbroadFiveSectionCarousel" model="profile.FiveSectionCarousel" />
    }

    <!-- ========================================================
         TRUST & IMPACT BAR
    ========================================================= -->
    <section class="dk-abroad-trust-section" aria-label="Trust &amp; Verification">
        <div class="dk-abroad-trust-inner">
            <div class="dk-abroad-trust-items">
                @foreach (var p in profile.TrustPillars)
                {
                    <div class="dk-abroad-trust-col">
                        <div class="dk-abroad-trust-icon">
                            @if (p.Icon == "shield")
                            {
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            }
                            else if (p.Icon == "plane")
                            {
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/></svg>
                            }
                            else if (p.Icon == "users")
                            {
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            }
                            else
                            {
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                            }
                        </div>
                        <div>
                            <div class="dk-abroad-trust-title">@p.Title</div>
                            <div class="dk-abroad-trust-desc">@p.Description</div>
                        </div>
                    </div>
                }
            </div>

            <div class="dk-abroad-trust-slogan">
                <span>@Html.Raw(profile.FooterSlogan?.Replace("&#x2661;", "♡") ?? "Your Global Education Partner ♡")</span>
            </div>
        </div>
    </section>

    @if (canManage)
    {
        <div style="position: fixed; bottom: 20px; right: 20px; z-index: 99999;">
            <a href="/Admin/StudyHub#tab-abroad-profile" class="dk-abroad-admin-link" style="background: #0f172a; color: #38bdf8; padding: 10px 18px; border-radius: 999px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 13px; text-decoration: none;">
                <span>⚙️ Edit Study Abroad Hub Profile</span>
            </a>
        </div>
    }

</div>

<!-- ========================================================
     CSS STYLES FOR STUDY ABROAD HUB PROFILE
========================================================= -->
<style>
    .dk-abroad-hub-root {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #0f172a;
        background: #f8fafc;
        padding-bottom: 60px;
        margin-top: 0;
        padding-top: 0;
    }

    /* Hero Section: True Full-Width Panoramic Image / Video Banner (Image 2 Style) */
    .dk-abroad-hero-section {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        min-height: 500px;
        border-bottom: 1px solid #e2e8f0;
        margin-top: 0;
        padding: 64px 24px 72px 24px;
        overflow: hidden;
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 45%, #dbeafe 100%);
    }
    .dk-abroad-hero-section.hide-text-overlay {
        min-height: 480px;
        padding: 0;
    }
    .dk-abroad-hero-section.has-hero-bg {
        filter: brightness(1.02);
    }
    .dk-abroad-hero-video-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        filter: brightness(1.02);
    }
    .dk-abroad-hero-bg-cover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center right;
        background-repeat: no-repeat;
        z-index: 0;
        filter: brightness(1.02);
    }

    /* Reality View Ambient Animations */
    .dk-reality-light-beam {
        position: absolute;
        top: -40px;
        right: 18%;
        width: 300px;
        height: 520px;
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.32) 0%, rgba(2, 132, 199, 0) 70%);
        transform: rotate(22deg);
        filter: blur(40px);
        animation: realityBeam 6s ease-in-out infinite alternate;
        pointer-events: none;
    }
    @@keyframes realityBeam {
        0% { opacity: 0.5; transform: rotate(20deg) scale(0.95); }
        100% { opacity: 0.9; transform: rotate(25deg) scale(1.05); }
    }
    .dk-reality-orb-1 {
        position: absolute;
        top: 15%;
        right: 25%;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(14, 165, 233, 0.28) 0%, rgba(14, 165, 233, 0) 70%);
        filter: blur(28px);
        animation: realityFloat 8s ease-in-out infinite alternate;
        pointer-events: none;
    }
    .dk-reality-orb-2 {
        position: absolute;
        bottom: 10%;
        right: 10%;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(249, 115, 22, 0.22) 0%, rgba(249, 115, 22, 0) 70%);
        filter: blur(34px);
        animation: realityFloat 10s ease-in-out infinite alternate-reverse;
        pointer-events: none;
    }
    @@keyframes realityFloat {
        0% { transform: translateY(0px) scale(1); }
        100% { transform: translateY(-20px) scale(1.08); }
    }

    /* Soft directional fade ONLY behind text on the left, leaving center & right 100% full brightness */
    .dk-abroad-hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.42) 28%, rgba(255, 255, 255, 0.0) 50%);
        z-index: 1;
        pointer-events: none;
    }
    .is-uploading-soon .dk-abroad-hero-overlay {
        background: linear-gradient(90deg, rgba(240, 248, 255, 0.92) 0%, rgba(240, 248, 255, 0.65) 36%, rgba(255, 255, 255, 0.12) 100%);
    }
    @@media (max-width: 768px) {
        .dk-abroad-hero-overlay {
            background: rgba(255, 255, 255, 0.92) !important;
        }
    }

    /* Decorative silhouette when no image is uploaded */
    .dk-abroad-hero-deco-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }
    .dk-skyline-silhouette {
        position: absolute;
        right: 0;
        bottom: 0;
        height: 200px;
        width: 65%;
        max-width: 800px;
        pointer-events: none;
    }
    .dk-deco-plane-sky {
        position: absolute;
        right: 12%;
        top: 15%;
        font-size: 32px;
        color: #0284c7;
        transform: rotate(-18deg);
        filter: drop-shadow(0 4px 6px rgba(2, 132, 199, 0.25));
    }
    .dk-deco-cloud {
        position: absolute;
        font-size: 36px;
        color: #93c5fd;
        opacity: 0.55;
    }
    .dk-deco-cloud.cloud-1 { right: 28%; top: 12%; }
    .dk-deco-cloud.cloud-2 { right: 6%; top: 38%; font-size: 44px; }

    /* Uploading Soon pill at top right */
    .dk-abroad-hero-status-pill {
        position: absolute;
        top: 16px;
        right: 24px;
        z-index: 4;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(8px);
        border: 1px solid #bae6fd;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        color: #0369a1;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
    }
    .dk-status-pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #0284c7;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.25);
    }
    .dk-status-admin-link {
        color: #0284c7;
        text-decoration: underline;
        font-weight: 800;
        margin-left: 4px;
    }
    .dk-status-admin-link:hover {
        color: #0369a1;
    }

    .dk-abroad-hero-inner {
        width: 96%;
        max-width: 1780px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .dk-abroad-hero-content {
        max-width: 680px;
    }

    .dk-abroad-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #0284c7;
        font-weight: 800;
        font-size: 13.5px;
        margin-bottom: 14px;
        letter-spacing: 0.2px;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(6px);
        padding: 5px 14px;
        border-radius: 999px;
        border: 1.5px solid rgba(2, 132, 199, 0.3);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .dk-abroad-hero-heading {
        font-size: 3rem;
        font-weight: 900;
        line-height: 1.15;
        color: #0b192c;
        margin: 0 0 14px 0;
        letter-spacing: -0.8px;
        text-shadow: 0 1px 3px rgba(255, 255, 255, 0.95), 0 2px 8px rgba(255, 255, 255, 0.7);
    }
    .dk-abroad-highlight {
        display: block;
        color: #0284c7;
        background: linear-gradient(90deg, #0284c7 0%, #0369a1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 1px 2px rgba(255, 255, 255, 0.85));
    }
    @@media (max-width: 768px) {
        .dk-abroad-hero-heading { font-size: 2.2rem; }
    }

    .dk-abroad-hero-sub {
        font-size: 1.08rem;
        color: #1e293b;
        font-weight: 600;
        margin: 0 0 24px 0;
        line-height: 1.5;
        max-width: 560px;
        text-shadow: 0 1px 3px rgba(255, 255, 255, 0.95);
    }

    /* Hero Quick Service Badges (Over Image with crisp contrast) */
    .dk-abroad-hero-quick-services {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 28px;
    }
    .dk-abroad-h-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
        padding: 9px 18px;
        border-radius: 999px;
        text-decoration: none;
        border: 1.5px solid #0284c7;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        transition: all 0.2s ease;
    }
    .dk-abroad-h-badge:hover {
        transform: translateY(-2px);
        background: #0284c7;
        color: #ffffff;
        border-color: #0284c7;
        box-shadow: 0 6px 18px rgba(2, 132, 199, 0.3);
    }
    .dk-abroad-h-badge:hover .dk-abroad-h-icon {
        color: #ffffff;
    }
    .dk-abroad-h-icon {
        color: #0284c7;
        display: flex;
        align-items: center;
        transition: color 0.2s ease;
    }

    .dk-abroad-hero-cta-line {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .dk-abroad-cta-btn {
        background: #0284c7;
        color: #ffffff;
        font-size: 14.5px;
        font-weight: 800;
        padding: 13px 28px;
        border-radius: 999px;
        text-decoration: none;
        display: inline-flex;
