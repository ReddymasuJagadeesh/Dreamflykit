                <label class="dk-sh-form-label" style="margin-bottom: 2px;">Icon Type</label>
                <select class="dk-admin-form-input abroad-hs-icon-select">
                    <option value="loan">🎓 Education Loan</option>
                    <option value="gr_loan">🏦 GR Loans</option>
                    <option value="consultancy">👥 Consultancy Details</option>
                    <option value="near_me">📍 Find Near Me</option>
                    <option value="insurance">🛡️ Health Insurance</option>
                    <option value="booking">📅 Booking Slots</option>
                    <option value="test">📖 Language Tests</option>
                    <option value="scholarship">🎓 Scholarships</option>
                </select>
            </div>
            <button type="button" class="dk-btn" style="background: #fee2e2; color: #b91c1c; font-size: 11px; padding: 6px 10px; margin-top: 14px;" onclick="this.closest('.abroad-hero-pill-row').remove()" title="Remove pill">
                🗑️
            </button>
        `;
        container.appendChild(newRow);
    }

    function triggerUploadFor(inputId, imgId) {
        currentUploadTargetInputId = inputId;
        currentUploadPreviewImgId = imgId;
        const uploader = document.getElementById("globalImageUploader");
        if (uploader) {
            uploader.value = "";
            uploader.click();
        }
    }

    document.getElementById("globalImageUploader")?.addEventListener("change", async function () {
        if (!this.files || this.files.length === 0) return;
        const file = this.files[0];

        const formData = new FormData();
        formData.append("file", file);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append("__RequestVerificationToken", token);

        try {
            const res = await fetch("/Admin/StudyHub/UploadImage", {
                method: "POST",
                body: formData,
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            const data = await res.json();
            if (data.success && data.url) {
                if (currentUploadTargetInputId) {
                    const input = document.getElementById(currentUploadTargetInputId);
                    if (input) input.value = data.url;
                }
                if (currentUploadPreviewImgId) {
                    const img = document.getElementById(currentUploadPreviewImgId);
                    if (img) img.src = data.url;
                }
                showAdminToast("✓ Image uploaded and preview updated!");
            } else {
                alert("Upload failed: " + (data.message || "Unknown error"));
            }
        } catch (err) {
            alert("Upload failed: " + err.message);
        }
    });

    function updateHeroSlideNumbers() {
        const rows = document.querySelectorAll("#hero_slides_container .dk-sh-hero-slide-row");
        const countSpan = document.getElementById("hero_slides_count");
        if (countSpan) countSpan.textContent = rows.length;
        rows.forEach((row, i) => {
            const label = row.querySelector(".hero-slide-label");
            if (label) label.textContent = `Slide #${i + 1}`;
        });
    }

    function removeHeroSlide(btn) {
        const rows = document.querySelectorAll("#hero_slides_container .dk-sh-hero-slide-row");
        if (rows.length <= 1) {
            alert("At least one slide must remain configured.");
            return;
        }
        const row = btn.closest(".dk-sh-hero-slide-row");
        if (row) {
            row.remove();
            updateHeroSlideNumbers();
        }
    }

