<!-- ========================================================
     CLIENT-SIDE LOGIC FOR INTERACTIVITY
========================================================= -->
<script>
    // Checklist toggle
    function toggleChecklistItem(id) {
        const input = document.getElementById("chk_input_" + id);
        const label = document.getElementById("chk_label_" + id);
        if (input && label) {
            if (input.checked) {
                label.style.opacity = "1";
            } else {
                label.style.opacity = "0.7";
            }
        }
    }

    // Builder carousel scroll
    function scrollBuilderRow(dir) {
        const track = document.getElementById("dkBuilderScrollTrack");
        if (track) {
            track.scrollBy({ left: dir * 240, behavior: "smooth" });
        }
    }

    // Builder selection & reactive sum
    function toggleBuilderItem(id, price) {
        const chk = document.getElementById("chk-" + id);
        const card = document.getElementById("builder-card-" + id);
        if (!chk) return;

        chk.checked = !chk.checked;
        if (card) {
            if (chk.checked) {
                card.classList.add("is-selected");
            } else {
                card.classList.remove("is-selected");
            }
        }
        recalculateBuilderTotal();
    }

    function recalculateBuilderTotal() {
        const chks = document.querySelectorAll(".dk-sh-item-chk:checked");
        let total = 0;
        chks.forEach(c => {
            const p = parseFloat(c.getAttribute("data-price") || "0");
            total += isNaN(p) ? 0 : p;
        });

        const totalEl = document.getElementById("dkBuilderTotalPrice");
        const countEl = document.getElementById("dkBuilderItemCount");
        if (totalEl) totalEl.textContent = "₹" + total.toLocaleString("en-IN");
        if (countEl) countEl.textContent = chks.length + (chks.length === 1 ? " item selected" : " items selected");
    }

    // Build kit cart action
    function handleBuildMyKitSubmit(targetUrl) {
        const chks = document.querySelectorAll(".dk-sh-item-chk:checked");
        if (chks.length === 0) {
            alert("Please choose at least 1 item to build your customized kit.");
            return;
        }
        let total = 0;
        let names = [];
        chks.forEach(c => {
            total += parseFloat(c.getAttribute("data-price") || "0");
            names.push(c.getAttribute("data-name"));
        });

        // Interactive feedback
        showNotificationToast("Success: Customized Study Kit added with " + chks.length + " items (Total: ₹" + total.toLocaleString("en-IN") + ")");
        setTimeout(() => {
            window.location.href = targetUrl || "/cart";
        }, 800);
    }

    function handleKitAddToCart(title, price, img) {
        showNotificationToast("Added " + title + " to your cart! (₹" + price.toLocaleString("en-IN") + ")");
    }

    function handleProductAddToCart(name, price, img) {
        showNotificationToast("Added " + name + " (₹" + price.toLocaleString("en-IN") + ") to cart!");
    }

    // FAQ Accordion
    function toggleFaqAccordion(idx) {
        const item = document.getElementById("faq-item-" + idx);
        const content = document.getElementById("faq-ans-" + idx);
        const btn = item ? item.querySelector(".dk-sh-faq-trigger") : null;
        if (!item || !content) return;

        const isOpen = item.classList.contains("is-open");
        if (isOpen) {
            item.classList.remove("is-open");
            content.style.display = "none";
            if (btn) btn.setAttribute("aria-expanded", "false");
        } else {
            item.classList.add("is-open");
            content.style.display = "block";
            if (btn) btn.setAttribute("aria-expanded", "true");
        }
    }

    function showNotificationToast(msg) {
        let toast = document.getElementById("dk-sh-toast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "dk-sh-toast";
            toast.style.cssText = "position: fixed; bottom: 28px; right: 28px; background: #0f172a; color: #ffffff; padding: 12px 22px; border-radius: 10px; font-weight: 700; font-size: 13px; z-index: 9999; box-shadow: 0 8px 24px rgba(0,0,0,0.25); border-left: 4px solid #38bdf8; transition: opacity 0.3s ease;";
            document.body.appendChild(toast);
        }
        toast.textContent = msg;
        toast.style.display = "block";
        toast.style.opacity = "1";
        setTimeout(() => {
            toast.style.opacity = "0";
            setTimeout(() => { toast.style.display = "none"; }, 300);
        }, 3000);
    }

    // Hero Banner Slider Logic
    function initHeroSlider() {
        const slider = document.getElementById("dkHeroSlider");
        if (!slider) return;

        const slides = slider.querySelectorAll(".dk-sh-hero-slide");
        const dots = slider.querySelectorAll(".dk-sh-slider-dot");
        const prevBtn = document.getElementById("dkHeroSliderPrev");
        const nextBtn = document.getElementById("dkHeroSliderNext");

        if (slides.length <= 1) return;

        let currentIndex = 0;
        const intervalMs = parseInt(slider.getAttribute("data-interval") || "4000", 10);
        let timer = null;

        function goToSlide(index) {
            slides[currentIndex].classList.remove("active");
            if (dots[currentIndex]) dots[currentIndex].classList.remove("active");

            currentIndex = (index + slides.length) % slides.length;

            slides[currentIndex].classList.add("active");
            if (dots[currentIndex]) dots[currentIndex].classList.add("active");
        }

        function nextSlide() {
            goToSlide(currentIndex + 1);
        }

        function prevSlide() {
            goToSlide(currentIndex - 1);
        }

        function startAutoPlay() {
            if (timer) clearInterval(timer);
            timer = setInterval(nextSlide, intervalMs);
        }

        function stopAutoPlay() {
            if (timer) {
                clearInterval(timer);
                timer = null;
            }
        }

        if (nextBtn) nextBtn.addEventListener("click", () => { nextSlide(); startAutoPlay(); });
        if (prevBtn) prevBtn.addEventListener("click", () => { prevSlide(); startAutoPlay(); });

        dots.forEach((dot, i) => {
            dot.addEventListener("click", () => {
                goToSlide(i);
                startAutoPlay();
            });
        });

        // Pause on hover
        slider.addEventListener("mouseenter", stopAutoPlay);
        slider.addEventListener("mouseleave", startAutoPlay);

        // Touch swipe support for mobile
        let startX = 0;
        slider.addEventListener("touchstart", (e) => {
            startX = e.touches[0].clientX;
            stopAutoPlay();
        }, { passive: true });
        slider.addEventListener("touchend", (e) => {
            const diffX = e.changedTouches[0].clientX - startX;
            if (Math.abs(diffX) > 40) {
                if (diffX < 0) nextSlide();
                else prevSlide();
            }
            startAutoPlay();
        }, { passive: true });

        startAutoPlay();
    }

    document.addEventListener("DOMContentLoaded", function () {
        recalculateBuilderTotal();
        initHeroSlider();
    });
</script>
