                             data-discount="@prod.DiscountPercent"
                             data-rating="@prod.Rating"
                             data-instock="@(prod.InStock ? "true" : "false")">

                            @if (!string.IsNullOrWhiteSpace(prod.Badge))
                            {
                                <span class="dk-elec-badge-corner @(prod.Badge.Contains("SALE") || prod.Badge.Contains("OFF") ? "red" : "")">@prod.Badge</span>
                            }

                            <!-- BIG IMAGE FRAME (min-height: 320px) -->
                            <a href="/category/electronics" class="dk-elec-img-frame" title="@prod.Name">
                                @if (isUploadSoon)
                                {
                                    <div class="dk-elec-radar-placeholder">
                                        <div class="dk-elec-radar-animation">
                                            <span class="dk-elec-pulse-ring r1"></span>
                                            <span class="dk-elec-pulse-ring r2"></span>
                                            <span class="dk-elec-prod-emoji">@activePage.Emoji</span>
