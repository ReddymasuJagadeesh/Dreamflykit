                            <label for="quoteStudentName">Student Full Name *</label>
                            <input type="text" id="quoteStudentName" required placeholder="e.g. Rahul Sharma" class="dk-input" />
                        </div>
                        <div class="dk-form-group">
                            <label for="quoteStudentPhone">WhatsApp / Mobile Number *</label>
                            <input type="tel" id="quoteStudentPhone" required placeholder="+91 98765 43210" class="dk-input" />
                        </div>
                        <div class="dk-form-group dk-span-full">
                            <label for="quoteStudentEmail">Email Address (For Fare &amp; Coupon) *</label>
                            <input type="email" id="quoteStudentEmail" required placeholder="student@example.com" class="dk-input" />
                        </div>
                        <div class="dk-form-group dk-span-full">
                            <label for="quoteTargetUniv">Destination University / College (Optional)</label>
                            <input type="text" id="quoteTargetUniv" placeholder="e.g. Northeastern University, Boston / University of Toronto" class="dk-input" />
