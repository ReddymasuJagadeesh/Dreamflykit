        height: 22px;
    }
    .dk-beauty-toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }
    .dk-beauty-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
