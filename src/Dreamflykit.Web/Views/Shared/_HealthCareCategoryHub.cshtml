<script>
(function() {
    const hero = document.getElementById("healthHeroCarousel");
    if (!hero) return;

    const slides = Array.from(hero.querySelectorAll(".dk-health-slide"));
    const dots = Array.from(hero.querySelectorAll(".dk-health-dot"));
    const btnPrev = document.getElementById("btnHealthHeroPrev");
    const btnNext = document.getElementById("btnHealthHeroNext");

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer = null;
    const isAutoPlay = hero.getAttribute("data-autoplay") === "true";
    const intervalMs = parseInt(hero.getAttribute("data-interval") || "5000", 10);

    function showSlide(index) {
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;

        slides.forEach((s, idx) => {
            const isActive = idx === index;
            s.classList.toggle("active", isActive);
            s.setAttribute("aria-hidden", isActive ? "false" : "true");
        });

        dots.forEach((d, idx) => {
            d.classList.toggle("active", idx === index);
        });

        currentIndex = index;
    }

    function startAutoPlay() {
        if (!isAutoPlay || slides.length <= 1) return;
        stopAutoPlay();
        timer = setInterval(() => {
            showSlide(currentIndex + 1);
        }, intervalMs);
    }

    function stopAutoPlay() {
        if (timer) {
            clearInterval(timer);
            timer = null;
        }
    }

    if (btnPrev) {
        btnPrev.addEventListener("click", () => {
            showSlide(currentIndex - 1);
            startAutoPlay();
        });
    }

    if (btnNext) {
        btnNext.addEventListener("click", () => {
            showSlide(currentIndex + 1);
            startAutoPlay();
        });
    }

    dots.forEach((d) => {
        d.addEventListener("click", (e) => {
            const idx = parseInt(d.getAttribute("data-index") || "0", 10);
            showSlide(idx);
            startAutoPlay();
        });
    });

    hero.addEventListener("mouseenter", stopAutoPlay);
    hero.addEventListener("mouseleave", startAutoPlay);

    // Touch Swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    hero.addEventListener("touchstart", (e) => {
        touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    hero.addEventListener("touchend", (e) => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 45) {
            showSlide(currentIndex + 1);
            startAutoPlay();
        } else if (touchEndX - touchStartX > 45) {
            showSlide(currentIndex - 1);
            startAutoPlay();
        }
    }, { passive: true });

    startAutoPlay();
})();
</script>
