}

/* 1. Hero Banner */
.dk-mob-hero-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #0f172a;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
    margin-bottom: 20px;
}
.dk-mob-slides-container {
    position: relative;
    width: 100%;
    min-height: 440px;
}
.dk-mob-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.6s;
    display: flex;
    align-items: center;
}
.dk-mob-slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
}
.dk-mob-slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}
.dk-mob-slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
}
.dk-mob-slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 23, 42, 0.92) 0%, rgba(15, 23, 42, 0.75) 45%, rgba(15, 23, 42, 0.1) 100%);
}
.dk-mob-slide-content {
    position: relative;
    z-index: 3;
    padding: 40px 50px;
    max-width: 680px;
}
.dk-mob-slide-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(251, 100, 27, 0.95);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 16px;
    box-shadow: 0 4px 12px rgba(251, 100, 27, 0.4);
}
.dk-mob-slide-title {
    font-size: 38px;
    line-height: 1.18;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 14px 0;
    letter-spacing: -0.5px;
}
.dk-mob-slide-highlight {
    background: linear-gradient(90deg, #38bdf8 0%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.dk-mob-slide-subtitle {
    font-size: 15px;
    line-height: 1.55;
    color: #e2e8f0;
    margin: 0 0 24px 0;
    font-weight: 400;
}
.dk-mob-slide-ctas {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
}
.dk-mob-btn-primary {
    background: linear-gradient(135deg, #2874f0 0%, #1d4ed8 100%);
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(40, 116, 240, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
}
.dk-mob-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(40, 116, 240, 0.6);
    color: #ffffff;
}
.dk-mob-btn-secondary {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    padding: 11px 20px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
}
.dk-mob-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.24);
    border-color: #ffffff;
    color: #ffffff;
}
.dk-mob-carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 64px;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    color: #1e293b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 4;
    transition: background 0.2s, transform 0.2s;
}
.dk-mob-carousel-arrow:hover {
    background: #ffffff;
}
.dk-mob-prev { left: 0; border-radius: 0 6px 6px 0; }
.dk-mob-next { right: 0; border-radius: 6px 0 0 6px; }

.dk-mob-carousel-indicators {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 4;
}
.dk-mob-dot {
    width: 28px;
    height: 6px;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    border-radius: 3px;
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    transition: width 0.3s, background 0.3s;
}
.dk-mob-dot.active {
    width: 44px;
    background: #38bdf8;
}

/* 2. Brand Pedestals Strip (Flipkart Dual Row 3D Stage Style) */
.dk-mob-brands-section {
    background: #ffffff;
