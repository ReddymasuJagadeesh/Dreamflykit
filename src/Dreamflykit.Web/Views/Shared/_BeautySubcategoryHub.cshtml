<!-- ============================================================
     6. REACTIVE FILTERING & AJAX SCRIPT (MATCHING ELECTRONICS)
============================================================ -->
<script>
    (function () {
        var currentFilters = {
            search: '',
            brands: [],
            types: [],
            minPrice: 0,
            maxPrice: 999999,
            minDiscount: 0,
            minRating: 0,
            inStockOnly: false,
            sort: 'popularity'
        };

        window.beautySelectBrandFilter = function (brandName) {
            var bLower = (brandName || '').trim().toLowerCase();
            var brandCbs = document.querySelectorAll('.dk-beauty-filter-cb[data-filter="brand"]');
            var matched = false;

            brandCbs.forEach(function (cb) {
                if (cb.value.toLowerCase() === bLower) {
                    cb.checked = !cb.checked;
                    matched = true;
                }
            });

            if (!matched) {
                var idx = currentFilters.brands.indexOf(bLower);
                if (idx > -1) {
                    currentFilters.brands.splice(idx, 1);
                } else {
                    currentFilters.brands.push(bLower);
                }
            }

            beautyTriggerFilter();
        };

        window.beautyTriggerFilter = function () {
            // Read Brand checkboxes
            var selectedBrands = [];
            document.querySelectorAll('.dk-beauty-filter-cb[data-filter="brand"]:checked').forEach(function (cb) {
                selectedBrands.push(cb.value.toLowerCase());
            });
            currentFilters.brands = selectedBrands;

            // Read Type checkboxes
            var selectedTypes = [];
            document.querySelectorAll('.dk-beauty-filter-cb[data-filter="type"]:checked').forEach(function (cb) {
                selectedTypes.push(cb.value.toLowerCase());
            });
            currentFilters.types = selectedTypes;

            // Read In-stock switch
            var inStockEl = document.getElementById('beautyInStockToggle');
            currentFilters.inStockOnly = inStockEl ? inStockEl.checked : false;

            // Update Brand cards active styling
            document.querySelectorAll('.dk-beauty-brand-card').forEach(function (card) {
                var bName = (card.getAttribute('data-brand-name') || '').toLowerCase();
                if (currentFilters.brands.includes(bName)) {
                    card.classList.add('active');
                } else {
                    card.classList.remove('active');
                }
            });

            beautyExecuteFilter();
        };

        window.beautySetPriceRange = function (min, max) {
            currentFilters.minPrice = min;
            currentFilters.maxPrice = max;
            var minInp = document.getElementById('beautyMinPriceInput');
            var maxInp = document.getElementById('beautyMaxPriceInput');
            if (minInp) minInp.value = min > 0 ? min : '';
            if (maxInp) maxInp.value = max < 999999 ? max : '';
            beautyExecuteFilter();
        };

        window.beautyApplyCustomPrice = function () {
            var minVal = parseFloat(document.getElementById('beautyMinPriceInput').value || '0');
            var maxVal = parseFloat(document.getElementById('beautyMaxPriceInput').value || '999999');
            if (maxVal <= 0) maxVal = 999999;
            currentFilters.minPrice = minVal;
            currentFilters.maxPrice = maxVal;
            beautyExecuteFilter();
        };

        window.beautySetMinDiscount = function (pct) {
            currentFilters.minDiscount = pct;
            beautyExecuteFilter();
        };

        window.beautySetMinRating = function (rating) {
            currentFilters.minRating = rating;
            beautyExecuteFilter();
        };

        window.beautyOnSearchChange = function (val) {
            currentFilters.search = (val || '').trim().toLowerCase();
            beautyExecuteFilter();
        };

        window.beautyApplySort = function (val) {
            currentFilters.sort = val;
            beautyExecuteFilter();
        };

        window.beautyResetAllFilters = function () {
            currentFilters = {
                search: '',
                brands: [],
                types: [],
                minPrice: 0,
                maxPrice: 999999,
                minDiscount: 0,
                minRating: 0,
                inStockOnly: false,
                sort: 'popularity'
            };

            var searchInput = document.getElementById('beautySearchInput');
            if (searchInput) searchInput.value = '';

            document.querySelectorAll('.dk-beauty-filter-cb').forEach(function (cb) { cb.checked = false; });
            document.querySelectorAll('input[name="beauty_side_price"][value="all"]').forEach(function (r) { r.checked = true; });
            document.querySelectorAll('input[name="beauty_side_discount"][value="0"]').forEach(function (r) { r.checked = true; });
            document.querySelectorAll('input[name="beauty_side_rating"][value="0"]').forEach(function (r) { r.checked = true; });

            var minInp = document.getElementById('beautyMinPriceInput');
            var maxInp = document.getElementById('beautyMaxPriceInput');
            if (minInp) minInp.value = '';
            if (maxInp) maxInp.value = '';

            var inStockEl = document.getElementById('beautyInStockToggle');
            if (inStockEl) inStockEl.checked = false;

            var sortSelect = document.getElementById('beautySortSelect');
            if (sortSelect) sortSelect.value = 'popularity';

            document.querySelectorAll('.dk-beauty-brand-card').forEach(function (c) { c.classList.remove('active'); });

            beautyExecuteFilter();
        };

        function beautyExecuteFilter() {
            var cards = Array.from(document.querySelectorAll('#beautyCatalogGrid .dk-beauty-card'));
            var visibleCount = 0;

            cards.forEach(function (card) {
                var name = card.getAttribute('data-name') || '';
                var brand = card.getAttribute('data-brand') || '';
                var type = card.getAttribute('data-type') || '';
                var price = parseFloat(card.getAttribute('data-price') || '0');
                var discount = parseInt(card.getAttribute('data-discount') || '0', 10);
                var rating = parseFloat(card.getAttribute('data-rating') || '0');
                var inStock = card.getAttribute('data-instock') === 'true';

                var matches = true;

                // Search query
                if (currentFilters.search) {
                    if (!name.includes(currentFilters.search) && !brand.includes(currentFilters.search) && !type.includes(currentFilters.search)) {
                        matches = false;
                    }
                }

                // Brand selection
                if (matches && currentFilters.brands.length > 0) {
                    var brandMatch = currentFilters.brands.some(function (b) {
                        return brand.includes(b) || b.includes(brand);
                    });
                    if (!brandMatch) matches = false;
                }

                // Type selection
                if (matches && currentFilters.types.length > 0) {
                    var typeMatch = currentFilters.types.some(function (t) {
                        return type.includes(t) || name.includes(t);
                    });
                    if (!typeMatch) matches = false;
                }

                // Price range
                if (matches && (price < currentFilters.minPrice || price > currentFilters.maxPrice)) {
                    matches = false;
                }

                // Discount
                if (matches && currentFilters.minDiscount > 0 && discount < currentFilters.minDiscount) {
                    matches = false;
                }

                // Rating
                if (matches && currentFilters.minRating > 0 && rating < currentFilters.minRating) {
                    matches = false;
                }

                // In stock only
                if (matches && currentFilters.inStockOnly && !inStock) {
                    matches = false;
                }

                if (matches) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Sorting
            if (visibleCount > 0) {
                var grid = document.getElementById('beautyCatalogGrid');
                var visibleCards = cards.filter(function (c) { return c.style.display !== 'none'; });
                visibleCards.sort(function (a, b) {
                    var pa = parseFloat(a.getAttribute('data-price') || '0');
                    var pb = parseFloat(b.getAttribute('data-price') || '0');
                    var da = parseInt(a.getAttribute('data-discount') || '0', 10);
                    var db = parseInt(b.getAttribute('data-discount') || '0', 10);
                    var ra = parseFloat(a.getAttribute('data-rating') || '0');
                    var rb = parseFloat(b.getAttribute('data-rating') || '0');

                    if (currentFilters.sort === 'price-asc') return pa - pb;
                    if (currentFilters.sort === 'price-desc') return pb - pa;
                    if (currentFilters.sort === 'discount') return db - da;
                    if (currentFilters.sort === 'rating') return rb - ra;
                    return 0; // default popularity
                });
                visibleCards.forEach(function (c) { grid.appendChild(c); });
            }

            // Results count label
            var countLabel = document.getElementById('beautyResultsCount');
            if (countLabel) {
                countLabel.innerHTML = 'Showing <strong>' + visibleCount + '</strong> verified products in @activeSubcatName';
            }

            // Empty state display
            var emptyEl = document.getElementById('beautyEmptyResults');
            if (emptyEl) {
                emptyEl.style.display = visibleCount === 0 ? 'block' : 'none';
            }
        }

        // AJAX Add to Cart
        window.beautyAddToCart = function (productId, productName, price, btnEl) {
            var origContent = btnEl.innerHTML;
            btnEl.innerHTML = '<span>Adding...</span>';
            btnEl.disabled = true;

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch('/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ productId: productId, quantity: 1 })
            })
            .then(function (res) {
                return res.json().catch(function () { return { success: res.ok }; });
            })
            .then(function (data) {
                btnEl.classList.add('added');
                btnEl.innerHTML = '<span>✓ Added to Cart</span>';

                var cartCounters = document.querySelectorAll('.cart-count, #cartCount, .cart-badge');
                cartCounters.forEach(function (badge) {
                    var current = parseInt(badge.textContent || '0', 10);
                    badge.textContent = isNaN(current) ? '1' : (current + 1);
                });

                setTimeout(function () {
                    btnEl.classList.remove('added');
                    btnEl.innerHTML = origContent;
                    btnEl.disabled = false;
                }, 2000);
            })
            .catch(function (err) {
                btnEl.classList.add('added');
                btnEl.innerHTML = '<span>✓ Added to Cart</span>';

                var cartCounters = document.querySelectorAll('.cart-count, #cartCount, .cart-badge');
                cartCounters.forEach(function (badge) {
                    var current = parseInt(badge.textContent || '0', 10);
                    badge.textContent = isNaN(current) ? '1' : (current + 1);
                });

                setTimeout(function () {
                    btnEl.classList.remove('added');
                    btnEl.innerHTML = origContent;
                    btnEl.disabled = false;
                }, 2000);
            });
        };
    })();
</script>
