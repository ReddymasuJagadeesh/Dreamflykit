<input type="file" id="hubSharedFileInput" accept="image/*" style="display: none;" />

<style>
.dk-admin-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #334155;
    margin-bottom: 4px;
}
.dk-admin-input {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
    outline: none;
    transition: border-color 0.15s ease;
    box-sizing: border-box;
}
.dk-admin-input:focus {
    border-color: #ea580c;
}
.dk-app-tab-btn {
    background: none;
    border: none;
    font-size: 14px;
    font-weight: 800;
    color: #64748b;
    padding: 10px 18px;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
}
.dk-app-tab-btn:hover {
    color: #0f172a;
    background: #f8fafc;
}
.dk-app-tab-btn.active {
    color: #ea580c;
    border-bottom: 3px solid #ea580c;
    background: #fff7ed;
}
.dk-app-tab-pane {
    display: none;
}
.dk-app-tab-pane.active {
    display: block;
}
.subpage-pill-btn.active {
    background: #ea580c !important;
    color: #ffffff !important;
    border-color: #ea580c !important;
    box-shadow: 0 4px 10px rgba(234, 88, 12, 0.28);
}
</style>

<script>
let currentUploadTargetInput = null;

function switchAppTab(tabId, btn) {
    document.querySelectorAll('.dk-app-tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.dk-app-tab-pane').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    const pane = document.getElementById('tab_' + tabId);
    if (pane) pane.classList.add('active');
}

function selectSubPageAdmin(slug) {
    document.querySelectorAll('.subpage-pill-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.subpage-panel-pane').forEach(p => {
        p.classList.remove('active');
        p.style.display = 'none';
    });

    const activeBtn = document.getElementById('pill_btn_' + slug);
    if (activeBtn) activeBtn.classList.add('active');

    const activePanel = document.getElementById('sub_panel_' + slug);
    if (activePanel) {
        activePanel.classList.add('active');
        activePanel.style.display = 'block';
    }
}

function triggerHubUpload(btn) {
    currentUploadTargetInput = btn.previousElementSibling;
    const fi = document.getElementById('hubSharedFileInput');
    fi.value = '';
    fi.click();
}

document.getElementById('hubSharedFileInput').addEventListener('change', async function () {
    if (!this.files || this.files.length === 0 || !currentUploadTargetInput) return;
    const file = this.files[0];
    const formData = new FormData();
    formData.append('file', file);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    try {
        const resp = await fetch('/Admin/AppliancesHub/UploadImage', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        const res = await resp.json();
        if (res.success && res.url) {
            currentUploadTargetInput.value = res.url;
            currentUploadTargetInput.dispatchEvent(new Event('input', { bubbles: true }));
        } else {
            alert('Upload failed: ' + (res.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Upload error: ' + err.message);
    }
});

async function uploadSubHeroImage(subSlug, input) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];
    const statusSpan = document.getElementById('sub_hero_status_' + subSlug);
    if (statusSpan) statusSpan.innerText = 'Uploading...';

    const formData = new FormData();
    formData.append('file', file);
    formData.append('targetField', 'sub_hero_' + subSlug);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    try {
        const resp = await fetch('/Admin/AppliancesHub/UploadImage', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        });
        const res = await resp.json();
        if (res.success && res.url) {
            const imgInput = document.getElementById('sub_hero_img_' + subSlug);
            const preview = document.getElementById('sub_hero_preview_' + subSlug);
            if (imgInput) imgInput.value = res.url;
            if (preview) preview.src = res.url;
            if (statusSpan) statusSpan.innerText = '✅ Uploaded!';
        } else {
            alert('Upload failed: ' + (res.message || 'Unknown error'));
            if (statusSpan) statusSpan.innerText = 'Failed';
        }
    } catch (err) {
        alert('Upload error: ' + err.message);
        if (statusSpan) statusSpan.innerText = 'Error';
    }
}

async function uploadBrandLogoImg(subSlug, bIndex, input) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];
    const formData = new FormData();
    formData.append('file', file);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    try {
        const resp = await fetch('/Admin/AppliancesHub/UploadImage', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        });
        const res = await resp.json();
        if (res.success && res.url) {
            const logoInput = document.getElementById('brand_logo_' + subSlug + '_' + bIndex);
            const preview = document.getElementById('brand_preview_' + subSlug + '_' + bIndex);
            if (logoInput) logoInput.value = res.url;
            if (preview) preview.src = res.url;
        } else {
            alert('Upload failed: ' + (res.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Upload error: ' + err.message);
    }
}

function removeBrandCard(subSlug, bIndex) {
    const card = document.getElementById('brand_row_' + subSlug + '_' + bIndex);
    if (card) {
        card.remove();
    }
}

function addNewBrandCard(subSlug) {
    const container = document.getElementById('brands_list_' + subSlug);
    if (!container) return;
    const newIdx = container.querySelectorAll('.brand-item-card').length;

    const div = document.createElement('div');
    div.className = 'brand-item-card brand-card-' + subSlug;
    div.id = 'brand_row_' + subSlug + '_' + newIdx;
    div.setAttribute('data-index', newIdx);
    div.style.cssText = 'background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px;';

    div.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 800; font-size: 13px; color: #c2410c;" id="brand_title_lbl_${subSlug}_${newIdx}">#${newIdx + 1} New Brand</span>
            <button type="button" onclick="removeBrandCard('${subSlug}', ${newIdx})" style="background: none; border: none; color: #ef4444; font-size: 16px; cursor: pointer;">🗑️</button>
        </div>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px;">
            <div>
                <label class="dk-admin-label">Brand Name</label>
                <input type="text" id="brand_name_${subSlug}_${newIdx}" class="dk-admin-input" value="New Brand" oninput="document.getElementById('brand_title_lbl_${subSlug}_${newIdx}').innerText = '#' + (${newIdx + 1}) + ' ' + this.value;" />
            </div>
            <div>
                <label class="dk-admin-label">Slug</label>
                <input type="text" id="brand_slug_${subSlug}_${newIdx}" class="dk-admin-input" value="new-brand" />
            </div>
        </div>
        <div>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #0f172a; cursor: pointer;">
                <input type="checkbox" id="brand_soon_${subSlug}_${newIdx}" checked />
                <span>Show "UPLOADING SOON" Badge</span>
            </label>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
            <div style="width: 36px; height: 36px; border-radius: 6px; background: #fff; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
                <img id="brand_preview_${subSlug}_${newIdx}" src="/images/fashion-hub/uploading-soon-placeholder.svg" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
            </div>
            <input type="text" id="brand_logo_${subSlug}_${newIdx}" class="dk-admin-input" value="/images/fashion-hub/uploading-soon-placeholder.svg" style="font-size: 11px; flex: 1;" oninput="document.getElementById('brand_preview_${subSlug}_${newIdx}').src=this.value;" />
            <input type="file" id="brand_file_${subSlug}_${newIdx}" accept="image/*" style="display: none;" onchange="uploadBrandLogoImg('${subSlug}', ${newIdx}, this)" />
            <button type="button" onclick="document.getElementById('brand_file_${subSlug}_${newIdx}').click()" class="dk-btn" style="background: #334155; color: #fff; border: none; font-size: 11px; padding: 6px 10px; border-radius: 4px; cursor: pointer;">
                Upload
            </button>
        </div>
    `;

    container.appendChild(div);
}

async function saveAllAppliancesConfig() {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    // Collect hero slides
    const slides = [];
    document.querySelectorAll('.hero-slide-row').forEach((row, idx) => {
        slides.push({
            id: 'app-slide-' + (idx + 1),
            title: row.querySelector('.slide-title')?.value || '',
            subtitle: row.querySelector('.slide-subtitle')?.value || '',
            priceHighlight: row.querySelector('.slide-price')?.value || '',
            imageUrl: row.querySelector('.slide-image-url')?.value || '',
            targetUrl: row.querySelector('.slide-target-url')?.value || '',
            isUploadingSoon: row.querySelector('.slide-uploading-soon')?.checked || false
        });
    });

    // Collect subcategories
    const subCats = [];
    document.querySelectorAll('.subcat-item-row').forEach(row => {
        subCats.push({
            title: row.querySelector('.subcat-title')?.value || '',
            icon: row.querySelector('.subcat-icon')?.value || '🔌',
            badge: row.querySelector('.subcat-badge')?.value || '',
            imageUrl: row.querySelector('.subcat-image-url')?.value || '',
            targetUrl: row.querySelector('.subcat-target-url')?.value || '',
            slug: row.querySelector('.subcat-slug')?.value || '',
            isUploadingSoon: row.querySelector('.subcat-uploading-soon')?.checked || false
        });
    });

    // Collect golden cards
    const goldenItems = [];
    document.querySelectorAll('.golden-item-row').forEach(row => {
        goldenItems.push({
            title: row.querySelector('.golden-name')?.value || '',
            priceText: row.querySelector('.golden-price')?.value || '',
            originalPrice: '',
            discountBadge: '',
            subtitle: '',
            imageUrl: row.querySelector('.golden-image-url')?.value || '',
            targetUrl: row.querySelector('.golden-target-url')?.value || '/category/appliances',
            isUploadingSoon: row.querySelector('.golden-uploading-soon')?.checked || false
        });
    });

    // Collect Subcategory Pages (All 16 Categories)
    const subPages = [];
    document.querySelectorAll('.subpage-panel-pane').forEach(panel => {
        const slug = panel.getAttribute('data-subslug');
        const name = panel.getAttribute('data-subname');
        const emoji = panel.getAttribute('data-emoji') || '🔌';

        const heroTitle = document.getElementById('sub_hero_title_' + slug)?.value || '';
        const heroHighlight = document.getElementById('sub_hero_highlight_' + slug)?.value || '';
        const heroSub = document.getElementById('sub_hero_sub_' + slug)?.value || '';
        const heroImg = document.getElementById('sub_hero_img_' + slug)?.value || '';
        const heroSoon = document.getElementById('sub_hero_soon_' + slug)?.checked || false;

        const brandsTitle = document.getElementById('sub_brands_title_' + slug)?.value || 'Shop by Brands';
        const brandsSub = document.getElementById('sub_brands_sub_' + slug)?.value || '';

        const brandsList = [];
        panel.querySelectorAll('.brand-item-card').forEach((card, bIdx) => {
            const idxAttr = card.getAttribute('data-index');
            const bName = document.getElementById('brand_name_' + slug + '_' + idxAttr)?.value || '';
            const bSlug = document.getElementById('brand_slug_' + slug + '_' + idxAttr)?.value || '';
            const bLogo = document.getElementById('brand_logo_' + slug + '_' + idxAttr)?.value || '';
            const bSoon = document.getElementById('brand_soon_' + slug + '_' + idxAttr)?.checked || false;

            if (bName) {
                brandsList.push({
                    id: 'b_' + slug + '_' + bIdx,
                    name: bName,
                    slug: bSlug,
                    logoUrl: bLogo,
                    isUploadingSoon: bSoon,
                    targetUrl: '/category/appliances/' + slug + '?q=' + encodeURIComponent(bName),
                    displayOrder: bIdx + 1,
                    isActive: true
                });
            }
        });

        subPages.push({
            id: 'app_sub_' + slug,
            categorySlug: slug,
            categoryName: name,
            emoji: emoji,
            heroBanner: {
                isEnabled: true,
                title: heroTitle,
                titleHighlight: heroHighlight,
                subtitle: heroSub,
                tagBadge: '⚡ STUDENT CERTIFIED • 100% GENUINE APPLIANCES',
                imageUrl: heroImg,
                isUploadingSoon: heroSoon,
                targetUrl: '/category/appliances/' + slug,
                buttonText: 'Shop Now →',
                featurePills: ['110V–240V Dual Voltage', 'Brand Warranty Included', 'Free In-Home Installation']
            },
            shopByBrands: {
                isEnabled: true,
                title: brandsTitle,
                subtitle: brandsSub,
                brands: brandsList
            }
        });
    });

    const payload = {
        themeSettings: {
            isFestiveEnabled: document.getElementById('themeIsFestiveEnabled')?.checked || false,
            themeName: document.getElementById('themeName')?.value || 'Big Bang Diwali',
            badgeText: document.getElementById('themeBadgeText')?.value || '⚡ FESTIVE DHAMAKA DEALS',
            themeTagline: document.getElementById('themeTagline')?.value || 'SALE IS LIVE',
            primaryBgGradient: 'linear-gradient(135deg, #7c1212 0%, #b91c1c 45%, #ea580c 100%)',
            accentGold: document.getElementById('themeAccentGold')?.value || '#fbbf24',
            noticeBarText: ''
        },
        heroBanner: {
            isEnabled: document.getElementById('heroIsEnabled')?.checked || false,
            autoPlay: document.getElementById('heroAutoPlay')?.checked || false,
            intervalSeconds: parseInt(document.getElementById('heroIntervalSeconds')?.value || '4', 10),
            slides: slides
        },
        bankOffer: {
            isEnabled: document.getElementById('bankIsEnabled')?.checked || false,
            bankName: 'SBI Card & SBI Debit Card',
            bankLogoUrl: document.getElementById('bankLogoUrl')?.value || '',
            offerText: document.getElementById('bankOfferText')?.value || '',
            offerSubtext: document.getElementById('bankOfferSubtext')?.value || '',
            termsText: '*T&C Apply'
        },
        subCategories: {
            isEnabled: true,
            title: 'Shop by Category',
            items: subCats
        },
        brandSpotlight: {
            isEnabled: document.getElementById('spotlightIsEnabled')?.checked || false,
            productTitle: document.getElementById('spotlightTitle')?.value || '',
            priceHighlight: document.getElementById('spotlightPrice')?.value || '',
            brandName: document.getElementById('spotlightBrand')?.value || '',
            brandTagline: 'Master the Moment',
            imageUrl: document.getElementById('spotlightImageUrl')?.value || '',
            targetUrl: '/category/appliances',
            isUploadingSoon: document.getElementById('spotlightIsUploadingSoon')?.checked || false
        },
        goldenHighlights: {
            isEnabled: document.getElementById('goldenIsEnabled')?.checked || false,
            title: 'Blockbuster Deals',
            subtitle: '',
            items: goldenItems
        },
        subcategoryPages: subPages
    };

    try {
        const resp = await fetch('/Admin/AppliancesHub/Save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(payload)
        });

        const data = await resp.json();
        if (data.success) {
            alert('✅ Appliances Hub & all 16 Subcategory Pages saved successfully!');
            window.location.reload();
        } else {
            alert('Failed to save: ' + (data.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Error saving configuration: ' + err.message);
    }
}
</script>
