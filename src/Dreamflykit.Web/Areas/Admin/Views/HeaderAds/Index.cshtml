@model Dreamflykit.Web.Areas.Admin.Models.HeaderAdsManagementViewModel
@{
    ViewData["Title"] = "Manage Header Ads (Beside Logo)";
}

<div class="dk-admin-content-card" style="max-width: 1100px; margin: 0 auto;">
    <div class="dk-admin-card-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
        <div>
            <h1 class="dk-admin-card-title" style="font-size: 1.6rem; font-weight: 800; margin: 0; color: #0f172a; display: flex; align-items: center; gap: 10px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#075bc8" stroke-width="2.2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                Header Advertisements Management
            </h1>
            <p style="color: #64748b; font-size: 0.9rem; margin: 0.35rem 0 0;">
                Configure the two promotional advertisement slots displayed directly beside the Dreamflykit logo in the top header. When users click an ad, they are redirected to the specified destination website URL.
            </p>
        </div>
        <div>
            <a href="/" target="_blank" class="dk-btn dk-btn-secondary" style="display: inline-flex; align-items: center; gap: 6px; font-size: 13px;">
                <span>View Live Storefront ↗</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="dk-alert dk-alert-success" style="margin-bottom: 1.5rem; padding: 0.85rem 1.25rem; background: #ecfdf5; border-left: 4px solid #10b981; color: #065f46; border-radius: 8px; font-weight: 600;">
            ✓ @msg
        </div>
    }

    <!-- Live Header Preview Simulation -->
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; margin-bottom: 2rem;">
        <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.75rem;">
            Live Header Preview
        </div>
        <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 14px 20px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
            <div style="width: 180px; flex-shrink: 0;">
                <img src="/images/branding/dreamflykit-logo.webp" alt="Logo" style="width: 160px; height: auto; display: block;" />
            </div>

            <div style="flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; min-width: 320px;">
                <!-- Slot 1 Preview Card -->
                <div style="border: 1.5px dashed @(Model.Slot1.IsActive ? "#3b82f6" : "#94a3b8"); border-radius: 8px; padding: 10px 14px; background: @(Model.Slot1.IsActive ? "#eff6ff" : "#f1f5f9"); display: flex; align-items: center; gap: 12px; position: relative; overflow: hidden;">
                    <span style="position: absolute; top: 4px; right: 6px; font-size: 9px; font-weight: 800; background: #2563eb; color: #fff; padding: 1px 5px; border-radius: 3px;">AD 1</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Slot1.CurrentImageUrl))
                    {
                        <img src="@Model.Slot1.CurrentImageUrl" alt="@Model.Slot1.Title" style="width: 50px; height: 38px; object-fit: cover; border-radius: 6px;" />
                    }
                    else
                    {
                        <div style="width: 44px; height: 38px; background: #dbeafe; border-radius: 6px; display: grid; place-items: center; font-size: 20px;">✈️</div>
                    }
                    <div style="overflow: hidden;">
                        <strong style="display: block; font-size: 12px; color: #1e3a8a; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">@Model.Slot1.Title</strong>
                        <span style="font-size: 11px; color: #475569; display: block; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">Target: <code>@Model.Slot1.RedirectUrl</code></span>
                    </div>
                </div>

                <!-- Slot 2 Preview Card -->
                <div style="border: 1.5px dashed @(Model.Slot2.IsActive ? "#3b82f6" : "#94a3b8"); border-radius: 8px; padding: 10px 14px; background: @(Model.Slot2.IsActive ? "#eff6ff" : "#f1f5f9"); display: flex; align-items: center; gap: 12px; position: relative; overflow: hidden;">
                    <span style="position: absolute; top: 4px; right: 6px; font-size: 9px; font-weight: 800; background: #2563eb; color: #fff; padding: 1px 5px; border-radius: 3px;">AD 2</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Slot2.CurrentImageUrl))
                    {
                        <img src="@Model.Slot2.CurrentImageUrl" alt="@Model.Slot2.Title" style="width: 50px; height: 38px; object-fit: cover; border-radius: 6px;" />
                    }
                    else
                    {
                        <div style="width: 44px; height: 38px; background: #dbeafe; border-radius: 6px; display: grid; place-items: center; font-size: 20px;">⚡</div>
                    }
                    <div style="overflow: hidden;">
                        <strong style="display: block; font-size: 12px; color: #1e3a8a; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">@Model.Slot2.Title</strong>
                        <span style="font-size: 11px; color: #475569; display: block; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">Target: <code>@Model.Slot2.RedirectUrl</code></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ad Forms Grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.75rem;">

        <!-- SLOT 1 FORM -->
        <div style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; background: #ffffff; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid #f1f5f9;">
                <div>
                    <span style="display: inline-block; background: #075bc8; color: #fff; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 4px; margin-bottom: 4px;">SECTION 1</span>
                    <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: #0f172a;">Header Ad Slot 1</h2>
                </div>
                <div>
                    @if (Model.Slot1.IsActive)
                    {
                        <span style="background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 20px;">Active</span>
                    }
                    else
                    {
                        <span style="background: #fee2e2; color: #b91c1c; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 20px;">Disabled</span>
                    }
                </div>
            </div>

            <form method="post" action="/Admin/HeaderAds/SaveSlot" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SlotNumber" value="1" />
                <input type="hidden" name="Id" value="@Model.Slot1.Id" />
                <input type="hidden" name="MediaAssetId" value="@Model.Slot1.MediaAssetId" />

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #334155;">
                        Ad Graphic / Banner Image
                    </label>
                    <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 8px;">
                        <div style="width: 100px; height: 50px; border: 1px dashed #cbd5e1; border-radius: 6px; background: #f8fafc; display: grid; place-items: center; overflow: hidden;">
                            @if (!string.IsNullOrWhiteSpace(Model.Slot1.CurrentImageUrl))
                            {
                                <img src="@Model.Slot1.CurrentImageUrl" alt="Current Ad" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span style="font-size: 10px; color: #94a3b8; text-align: center;">Default Banner</span>
                            }
                        </div>
                        <div style="flex: 1;">
                            <input type="file" name="ImageFile" accept="image/png,image/jpeg,image/webp,image/gif" class="dk-input" style="font-size: 12px; padding: 6px;" />
                            <span style="font-size: 11px; color: #64748b; display: block; margin-top: 3px;">Format: PNG, JPG, or WEBP (rec. 360x60px)</span>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #334155;">
                        Headline / Title <span style="color: #ef4444;">*</span>
                    </label>
                    <input type="text" name="Title" value="@Model.Slot1.Title" class="dk-input" style="width: 100%; font-size: 13px;" placeholder="e.g. Flight & Travel Kits - 25% Off" required />
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #334155;">
                        Subtitle / Tagline (Optional)
                    </label>
                    <input type="text" name="Subtitle" value="@Model.Slot1.Subtitle" class="dk-input" style="width: 100%; font-size: 13px;" placeholder="e.g. Complete Student Abroad Essentials" />
                </div>

                <div style="margin-bottom: 1.25rem;">
                    <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #334155;">
                        Redirect Website URL <span style="color: #ef4444;">*</span>
                    </label>
                    <input type="text" name="RedirectUrl" value="@Model.Slot1.RedirectUrl" class="dk-input" style="width: 100%; font-size: 13px;" placeholder="e.g. https://partner-site.com or /Kits/FindMyKit" required />
                    <span style="font-size: 11px; color: #64748b; display: block; margin-top: 3px;">
                        When anyone clicks this ad, they will be redirected to this website.
                    </span>
                </div>

                <div style="margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="slot1Active" name="IsActive" value="true" @(Model.Slot1.IsActive ? "checked" : "") style="width: 16px; height: 16px; cursor: pointer;" />
                    <input type="hidden" name="IsActive" value="false" />
                    <label for="slot1Active" style="font-size: 13px; font-weight: 600; color: #334155; cursor: pointer;">
                        Display Ad Slot 1 in Header
                    </label>
                </div>

                <button type="submit" class="dk-btn dk-btn-primary" style="width: 100%; padding: 10px; font-size: 13px; font-weight: 700;">
                    Save Header Ad Slot 1
                </button>
            </form>
        </div>

        <!-- SLOT 2 FORM -->
        <div style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; background: #ffffff; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid #f1f5f9;">
                <div>
                    <span style="display: inline-block; background: #075bc8; color: #fff; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 4px; margin-bottom: 4px;">SECTION 2</span>
                    <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: #0f172a;">Header Ad Slot 2</h2>
                </div>
                <div>
                    @if (Model.Slot2.IsActive)
                    {
                        <span style="background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 20px;">Active</span>
                    }
                    else
                    {
                        <span style="background: #fee2e2; color: #b91c1c; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 20px;">Disabled</span>
                    }
                </div>
            </div>

            <form method="post" action="/Admin/HeaderAds/SaveSlot" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SlotNumber" value="2" />
                <input type="hidden" name="Id" value="@Model.Slot2.Id" />
                <input type="hidden" name="MediaAssetId" value="@Model.Slot2.MediaAssetId" />

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #334155;">
                        Ad Graphic / Banner Image
                    </label>
                    <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 8px;">
                        <div style="width: 100px; height: 50px; border: 1px dashed #cbd5e1; border-radius: 6px; background: #f8fafc; display: grid; place-items: center; overflow: hidden;">
                            @if (!string.IsNullOrWhiteSpace(Model.Slot2.CurrentImageUrl))
                            {
                                <img src="@Model.Slot2.CurrentImageUrl" alt="Current Ad" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span style="font-size: 10px; color: #94a3b8; text-align: center;">Default Banner</span>
                            }
                        </div>
                        <div style="flex: 1;">
                            <input type="file" name="ImageFile" accept="image/png,image/jpeg,image/webp,image/gif" class="dk-input" style="font-size: 12px; padding: 6px;" />
                            <span style="font-size: 11px; color: #64748b; display: block; margin-top: 3px;">Format: PNG, JPG, or WEBP (rec. 360x60px)</span>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #334155;">
                        Headline / Title <span style="color: #ef4444;">*</span>
                    </label>
                    <input type="text" name="Title" value="@Model.Slot2.Title" class="dk-input" style="width: 100%; font-size: 13px;" placeholder="e.g. Global SIM & Universal Plugs" required />
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #334155;">
                        Subtitle / Tagline (Optional)
                    </label>
                    <input type="text" name="Subtitle" value="@Model.Slot2.Subtitle" class="dk-input" style="width: 100%; font-size: 13px;" placeholder="e.g. 150+ Country Coverage with 5G Data" />
                </div>

                <div style="margin-bottom: 1.25rem;">
                    <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #334155;">
                        Redirect Website URL <span style="color: #ef4444;">*</span>
                    </label>
                    <input type="text" name="RedirectUrl" value="@Model.Slot2.RedirectUrl" class="dk-input" style="width: 100%; font-size: 13px;" placeholder="e.g. https://telecom-partner.com or /category/adapters-sim" required />
                    <span style="font-size: 11px; color: #64748b; display: block; margin-top: 3px;">
                        When anyone clicks this ad, they will be redirected to this website.
                    </span>
                </div>

                <div style="margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="slot2Active" name="IsActive" value="true" @(Model.Slot2.IsActive ? "checked" : "") style="width: 16px; height: 16px; cursor: pointer;" />
                    <input type="hidden" name="IsActive" value="false" />
                    <label for="slot2Active" style="font-size: 13px; font-weight: 600; color: #334155; cursor: pointer;">
                        Display Ad Slot 2 in Header
                    </label>
                </div>

                <button type="submit" class="dk-btn dk-btn-primary" style="width: 100%; padding: 10px; font-size: 13px; font-weight: 700;">
                    Save Header Ad Slot 2
                </button>
            </form>
        </div>

    </div>
</div>
