@model Dreamflykit.Web.Areas.Admin.Models.MfaSetupViewModel
@{
    ViewData["Title"] = "Mandatory 2FA Setup";
}

<div class="max-w-2xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="bg-white shadow rounded-xl p-8 border border-gray-100">
        <div class="flex items-center space-x-3 mb-6">
            <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center text-red-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Administrator Two-Factor Authentication</h1>
                <p class="text-sm text-gray-500">Security Policy Requirement (OWASP ASVS Level 2)</p>
            </div>
        </div>

        <div class="bg-amber-50 border-l-4 border-amber-400 p-4 mb-6 rounded-r">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-amber-800">
                        Multi-Factor Authentication is <strong>mandatory</strong> for all administrator accounts before accessing catalog controls, order management, or sensitive customer records.
                    </p>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div>
                <h2 class="text-lg font-semibold text-gray-900 mb-2">Step 1: Scan QR Code or Enter Key</h2>
                <p class="text-sm text-gray-600 mb-4">
                    Open your TOTP authenticator app (e.g. <strong>Google Authenticator</strong>, <strong>Microsoft Authenticator</strong>, or <strong>1Password</strong>) and scan the QR code below:
                </p>

                <div class="flex flex-col sm:flex-row items-center gap-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                    <div class="p-2 bg-white rounded-lg shadow-sm border border-gray-200">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@Uri.EscapeDataString(Model.AuthenticatorUri)" 
                             alt="Authenticator QR Code" 
                             class="w-44 h-44" />
                    </div>
                    <div class="text-left space-y-2">
                        <span class="text-xs uppercase tracking-wider text-gray-500 font-semibold">Or enter manually:</span>
                        <div class="font-mono text-sm font-bold bg-white px-3 py-2 rounded border border-gray-300 text-gray-800 select-all">
                            @Model.SharedKey
                        </div>
                        <p class="text-xs text-gray-500">Spaces are ignored by authenticator applications.</p>
                    </div>
                </div>
            </div>

            <form asp-action="Setup" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SharedKey" />
                <input type="hidden" asp-for="AuthenticatorUri" />

                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-2">Step 2: Verify 6-Digit Code</h2>
                    <label asp-for="VerificationCode" class="block text-sm font-medium text-gray-700 mb-1">
                        Enter the code generated by your app:
                    </label>
                    <div class="relative rounded-md shadow-sm max-w-xs">
                        <input asp-for="VerificationCode" 
                               autocomplete="one-time-code"
                               maxlength="7"
                               placeholder="123456"
                               class="focus:ring-red-500 focus:border-red-500 block w-full text-center tracking-widest text-xl font-mono border-gray-300 rounded-md py-2 px-3 border" />
                    </div>
                    <span asp-validation-for="VerificationCode" class="text-sm text-red-600 block mt-1"></span>
                </div>

                <div class="pt-4">
                    <button type="submit" 
                            class="inline-flex justify-center py-2.5 px-6 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                        Verify and Enable 2FA
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

