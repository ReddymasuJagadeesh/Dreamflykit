.dk-sub-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    text-transform: uppercase;
}
.dk-sub-discount-tag {
    position: absolute;
    bottom: 8px;
    left: 8px;
