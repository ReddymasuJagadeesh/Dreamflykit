<!-- ========================================================
     JAVASCRIPT: HERO CAROUSEL & THREE.JS 3D ENGINE
========================================================= -->
<script>
(function() {
    // ----------------------------------------------------
    // 1. HERO BANNER MULTI-SLIDE CAROUSEL
    // ----------------------------------------------------
    const carousel = document.getElementById("mobilesHeroCarousel");
    if (carousel) {
        const slides = carousel.querySelectorAll(".dk-mob-slide");
        const indicators = carousel.querySelectorAll(".dk-mob-dot");
        const prevBtn = document.getElementById("mobHeroPrev");
        const nextBtn = document.getElementById("mobHeroNext");
        const autoPlay = carousel.getAttribute("data-autoplay") === "true";
        const intervalMs = parseInt(carousel.getAttribute("data-interval"), 10) || 4000;
        let currentIndex = 0;
        let timer = null;

        function showSlide(index) {
            if (slides.length <= 1) return;
            if (index < 0) index = slides.length - 1;
            if (index >= slides.length) index = 0;

            slides.forEach((s, i) => {
                const isActive = (i === index);
                s.classList.toggle("active", isActive);
                s.setAttribute("aria-hidden", isActive ? "false" : "true");
            });

            indicators.forEach((ind, i) => {
                ind.classList.toggle("active", i === index);
            });

            currentIndex = index;
        }

        function startTimer() {
            if (!autoPlay || slides.length <= 1) return;
            stopTimer();
            timer = setInterval(() => showSlide(currentIndex + 1), intervalMs);
        }

        function stopTimer() {
            if (timer) clearInterval(timer);
        }

        prevBtn?.addEventListener("click", () => {
            showSlide(currentIndex - 1);
            startTimer();
        });

        nextBtn?.addEventListener("click", () => {
            showSlide(currentIndex + 1);
            startTimer();
        });

        indicators.forEach(ind => {
            ind.addEventListener("click", () => {
                const target = parseInt(ind.getAttribute("data-slide-target"), 10);
                if (!isNaN(target)) {
                    showSlide(target);
                    startTimer();
                }
            });
        });

        carousel.addEventListener("mouseenter", stopTimer);
        carousel.addEventListener("mouseleave", startTimer);

        startTimer();
    }

    // ----------------------------------------------------
    // 2. BRAND STAGE SHOWCASE NAVIGATION & FILTERING
    // ----------------------------------------------------
    const brandsScroller = document.getElementById("mobBrandsScroller");
    document.getElementById("btnBrandsPrev")?.addEventListener("click", () => {
        brandsScroller?.scrollBy({ left: -340, behavior: "smooth" });
    });
    document.getElementById("btnBrandsNext")?.addEventListener("click", () => {
        brandsScroller?.scrollBy({ left: 340, behavior: "smooth" });
    });

    window.filterBrandStages = function(category, btn) {
        const allChips = document.querySelectorAll(".dk-brand-chip");
        allChips.forEach(c => c.classList.remove("active"));
        if (btn) btn.classList.add("active");

        const cards = document.querySelectorAll(".dk-mob-stage-card");
        cards.forEach(card => {
            const cardCat = card.getAttribute("data-brand-category") || "all";
            if (category === "all" || cardCat === category) {
                card.classList.remove("is-filtered-out");
                card.style.opacity = "0";
                setTimeout(() => { card.style.opacity = "1"; }, 30);
            } else {
                card.classList.add("is-filtered-out");
            }
        });
    };

    // ----------------------------------------------------
    // 3. FLAGSHIP SPECIALS 3-SECTION SYNCHRONIZED SLIDE CAROUSEL
    // All 3 sections rotate together simultaneously at the exact same time
    // ----------------------------------------------------
    const flagshipRoot = document.getElementById("flagshipThreeSection");
    if (flagshipRoot) {
        const autoPlay = flagshipRoot.getAttribute("data-autoplay") === "true";
        const syncAll = flagshipRoot.getAttribute("data-sync") !== "false";
        const intervalMs = parseInt(flagshipRoot.getAttribute("data-interval"), 10) || 4000;
        const columns = Array.from(flagshipRoot.querySelectorAll(".dk-flagship-col-carousel"));

        if (syncAll) {
            // Find max slides across all columns
            let maxSlides = 1;
            columns.forEach(col => {
                const count = col.querySelectorAll(".dk-flagship-card").length;
                if (count > maxSlides) maxSlides = count;
            });

            let currentGlobalSlide = 0;
            let masterSyncTimer = null;

            function showSyncSlide(targetIdx) {
                currentGlobalSlide = ((targetIdx % maxSlides) + maxSlides) % maxSlides;

                columns.forEach(col => {
                    const slides = col.querySelectorAll(".dk-flagship-card");
                    const dots = col.querySelectorAll(".dk-flagship-dot");
                    if (slides.length === 0) return;

                    const colTarget = currentGlobalSlide % slides.length;
                    slides.forEach((s, i) => {
                        s.classList.toggle("active", i === colTarget);
                    });
                    dots.forEach((d, i) => {
                        d.classList.toggle("active", i === colTarget);
                    });
                });
            }

            function startMasterTimer() {
                if (!autoPlay || maxSlides <= 1) return;
                stopMasterTimer();
                masterSyncTimer = setInterval(() => {
                    showSyncSlide(currentGlobalSlide + 1);
                }, intervalMs);
            }

            function stopMasterTimer() {
                if (masterSyncTimer) {
                    clearInterval(masterSyncTimer);
                    masterSyncTimer = null;
                }
            }

            // Pause rotation when user hovers over the flagship section
            flagshipRoot.addEventListener("mouseenter", stopMasterTimer);
            flagshipRoot.addEventListener("mouseleave", startMasterTimer);

            window.switchFlagshipSyncSlide = function(slideIndex) {
                showSyncSlide(slideIndex);
                startMasterTimer();
            };

            window.switchFlagshipColSlide = function(colIndex, slideIndex, ev) {
                if (ev) {
                    ev.preventDefault();
                    ev.stopPropagation();
                }
                showSyncSlide(slideIndex);
                startMasterTimer();
            };

            // Start synchronized carousel
            showSyncSlide(0);
            startMasterTimer();
        } else {
            // Independent rotation fallback if sync is explicitly disabled
            columns.forEach(col => {
                const slides = col.querySelectorAll(".dk-flagship-card");
                const dots = col.querySelectorAll(".dk-flagship-dot");
                if (slides.length <= 1) return;

                let currentSlide = 0;
                let colTimer = null;

                function showColSlide(idx) {
                    if (idx < 0) idx = slides.length - 1;
                    if (idx >= slides.length) idx = 0;
                    slides.forEach((s, i) => s.classList.toggle("active", i === idx));
                    dots.forEach((d, i) => d.classList.toggle("active", i === idx));
                    currentSlide = idx;
                }

                function startColTimer() {
                    if (!autoPlay || slides.length <= 1) return;
                    if (colTimer) clearInterval(colTimer);
                    colTimer = setInterval(() => showColSlide(currentSlide + 1), intervalMs);
                }

                col.addEventListener("mouseenter", () => { if (colTimer) clearInterval(colTimer); });
                col.addEventListener("mouseleave", startColTimer);
                startColTimer();
            });
        }
    }

    // ----------------------------------------------------
    // 4. UNMISSABLE DEALS SCROLL BUTTONS
    // ----------------------------------------------------
    const unmissableTrack = document.getElementById("unmissableTrack");
    document.getElementById("unmissablePrev")?.addEventListener("click", () => {
        unmissableTrack?.scrollBy({ left: -260, behavior: "smooth" });
    });
    document.getElementById("unmissableNext")?.addEventListener("click", () => {
        unmissableTrack?.scrollBy({ left: 260, behavior: "smooth" });
    });

})();

// ----------------------------------------------------
// 3. THREE.JS 3D INTERACTIVE SMARTPHONE VISUALIZER
// ----------------------------------------------------
let threeScene, threeCamera, threeRenderer, phoneGroup, chassisMesh;
let isRotating = true;
let isDragging = false;
let prevMousePos = { x: 0, y: 0 };

function initThreeJsPhone() {
    const container = document.getElementById("threeJsContainer");
    if (!container || threeScene) return;

    const width = container.clientWidth || 920;
    const height = container.clientHeight || 480;

    // Scene & Camera
    threeScene = new THREE.Scene();
    threeCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    threeCamera.position.set(0, 0, 8);

    // Renderer
    threeRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    threeRenderer.setSize(width, height);
    threeRenderer.setPixelRatio(window.devicePixelRatio || 1);
    threeRenderer.shadowMap.enabled = true;
    container.appendChild(threeRenderer.domElement);

    // Lighting (Studio Key + Fill + Rim Lights for realistic reflections)
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    threeScene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0xffffff, 1.2);
    dirLight1.position.set(5, 10, 7);
    dirLight1.castShadow = true;
    threeScene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0x38bdf8, 0.6);
    dirLight2.position.set(-5, -5, -4);
    threeScene.add(dirLight2);

    // Build Realistic 3D Smartphone Mesh Hierarchy
    phoneGroup = new THREE.Group();

    // 1. Chassis Body (Smooth rounded phone frame)
    const chassisGeo = new THREE.BoxGeometry(2.3, 4.8, 0.22);
    const chassisMat = new THREE.MeshStandardMaterial({
        color: 0x2563eb,
        metalness: 0.85,
        roughness: 0.22,
        clearcoat: 0.4,
        clearcoatRoughness: 0.1
    });
    chassisMesh = new THREE.Mesh(chassisGeo, chassisMat);
    chassisMesh.castShadow = true;
    phoneGroup.add(chassisMesh);

    // 2. Front Screen Face
    const screenGeo = new THREE.PlaneGeometry(2.15, 4.62);
    // Canvas texture for live screen wallpaper
    const screenCanvas = document.createElement("canvas");
    screenCanvas.width = 512;
    screenCanvas.height = 1024;
    const sCtx = screenCanvas.getContext("2d");
    // Dynamic wallpaper gradient
    const sGrad = sCtx.createLinearGradient(0, 0, 512, 1024);
    sGrad.addColorStop(0, "#0f172a");
    sGrad.addColorStop(0.4, "#2563eb");
    sGrad.addColorStop(0.7, "#06b6d4");
    sGrad.addColorStop(1, "#020617");
    sCtx.fillStyle = sGrad;
    sCtx.fillRect(0, 0, 512, 1024);
    // Clock text
    sCtx.fillStyle = "#ffffff";
    sCtx.font = "bold 72px sans-serif";
    sCtx.textAlign = "center";
    sCtx.fillText("10:45", 256, 260);
    sCtx.font = "500 28px sans-serif";
    sCtx.fillStyle = "#94a3b8";
    sCtx.fillText("Dreamfly 5G • 100% Battery", 256, 310);
    // 3D badge pill
    sCtx.fillStyle = "#fb641b";
    sCtx.beginPath();
    sCtx.roundRect(156, 780, 200, 60, 30);
    sCtx.fill();
    sCtx.fillStyle = "#ffffff";
    sCtx.font = "bold 30px sans-serif";
    sCtx.fillText("3D LIVE", 256, 822);

    const screenTexture = new THREE.CanvasTexture(screenCanvas);
    const screenMat = new THREE.MeshBasicMaterial({ map: screenTexture });
    const screenMesh = new THREE.Mesh(screenGeo, screenMat);
    screenMesh.position.z = 0.115;
    phoneGroup.add(screenMesh);

    // 3. Back Camera Island
    const bumpGeo = new THREE.BoxGeometry(0.9, 1.4, 0.08);
    const bumpMat = new THREE.MeshStandardMaterial({
        color: 0x0f172a,
        metalness: 0.9,
        roughness: 0.1
    });
    const bumpMesh = new THREE.Mesh(bumpGeo, bumpMat);
    bumpMesh.position.set(-0.55, 1.45, -0.14);
    phoneGroup.add(bumpMesh);

    // Camera Lenses
    for (let c = 0; c < 3; c++) {
        const lensGeo = new THREE.CylinderGeometry(0.16, 0.16, 0.06, 32);
        lensGeo.rotateX(Math.PI / 2);
        const lensMat = new THREE.MeshStandardMaterial({
            color: 0x020617,
            metalness: 0.95,
            roughness: 0.05
        });
        const lensMesh = new THREE.Mesh(lensGeo, lensMat);
        lensMesh.position.set(-0.55, 1.85 - (c * 0.42), -0.17);
        phoneGroup.add(lensMesh);

        // Glass reflection inside lens
        const irisGeo = new THREE.CircleGeometry(0.08, 16);
        irisGeo.rotateY(Math.PI);
        const irisMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
        const irisMesh = new THREE.Mesh(irisGeo, irisMat);
        irisMesh.position.set(-0.55, 1.85 - (c * 0.42), -0.201);
        phoneGroup.add(irisMesh);
    }

    threeScene.add(phoneGroup);

    // Mouse & Touch Drag Interaction
    const dom = threeRenderer.domElement;
    dom.addEventListener("mousedown", (e) => {
        isDragging = true;
        isRotating = false;
        prevMousePos = { x: e.clientX, y: e.clientY };
    });
    window.addEventListener("mouseup", () => { isDragging = false; });
    dom.addEventListener("mousemove", (e) => {
        if (!isDragging) return;
        const dx = e.clientX - prevMousePos.x;
        const dy = e.clientY - prevMousePos.y;
        phoneGroup.rotation.y += dx * 0.01;
        phoneGroup.rotation.x += dy * 0.01;
        prevMousePos = { x: e.clientX, y: e.clientY };
    });

    // Touch support for mobile devices
    dom.addEventListener("touchstart", (e) => {
        if (e.touches.length === 1) {
            isDragging = true;
            isRotating = false;
            prevMousePos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
        }
    }, { passive: true });
    dom.addEventListener("touchend", () => { isDragging = false; });
    dom.addEventListener("touchmove", (e) => {
        if (!isDragging || e.touches.length !== 1) return;
        const dx = e.touches[0].clientX - prevMousePos.x;
        const dy = e.touches[0].clientY - prevMousePos.y;
        phoneGroup.rotation.y += dx * 0.015;
        phoneGroup.rotation.x += dy * 0.015;
        prevMousePos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }, { passive: true });

    // Scroll to Zoom
    dom.addEventListener("wheel", (e) => {
        e.preventDefault();
        threeCamera.position.z += e.deltaY * 0.005;
        threeCamera.position.z = Math.max(4.5, Math.min(14, threeCamera.position.z));
    }, { passive: false });

    // Animation Loop
    function animate() {
        requestAnimationFrame(animate);
        if (isRotating && phoneGroup) {
            phoneGroup.rotation.y += 0.012;
        }
        threeRenderer.render(threeScene, threeCamera);
    }
    animate();
}

function open3dModal(phoneName, colorHex, specs, price, model3dUrl) {
    const modal = document.getElementById("dk3dModalBackdrop");
    if (!modal) return;
    modal.style.display = "flex";
    document.body.style.overflow = "hidden";

    document.getElementById("modalPhoneTitle").innerText = phoneName || "Interactive 3D Smartphone";
    if (specs) document.getElementById("modalPhoneSub").innerText = specs;
    if (price) document.getElementById("modalPhonePrice").innerText = price;

    const threeContainer = document.getElementById("threeJsContainer");
    const googleViewer = document.getElementById("googleModelViewer");

    if (model3dUrl && (model3dUrl.endsWith(".glb") || model3dUrl.endsWith(".gltf"))) {
        // Use Google model-viewer for uploaded GLB/GLTF 3D models
        threeContainer.style.display = "none";
        googleViewer.style.display = "block";
        googleViewer.setAttribute("src", model3dUrl);
    } else {
        // Use Three.js 3D Procedural Smartphone Engine
        googleViewer.style.display = "none";
        threeContainer.style.display = "block";
        if (!threeScene) {
            initThreeJsPhone();
        }
        if (colorHex) {
            change3dColor(colorHex);
        }
        reset3dCamera();
        isRotating = true;
    }
}

function close3dModal() {
    const modal = document.getElementById("dk3dModalBackdrop");
    if (modal) modal.style.display = "none";
    document.body.style.overflow = "";
    isRotating = false;
}

function toggle3dRotation() {
    isRotating = !isRotating;
    const btn = document.getElementById("btn3dAutoRotate");
    if (btn) btn.style.background = isRotating ? "#2874f0" : "rgba(255,255,255,0.12)";
}

function set3dView(angle) {
    if (!phoneGroup) return;
    isRotating = false;
    if (angle === 'front') {
        phoneGroup.rotation.set(0, 0, 0);
    } else if (angle === 'back') {
        phoneGroup.rotation.set(0, Math.PI, 0);
    } else if (angle === 'side') {
        phoneGroup.rotation.set(0, Math.PI / 2, 0);
    } else if (angle === 'iso') {
        phoneGroup.rotation.set(0.35, 0.65, 0);
    }
}

function zoom3d(factor) {
    if (!threeCamera) return;
    threeCamera.position.z *= factor;
    threeCamera.position.z = Math.max(4.5, Math.min(14, threeCamera.position.z));
}

function reset3dCamera() {
    if (!threeCamera || !phoneGroup) return;
    threeCamera.position.set(0, 0, 8);
    phoneGroup.rotation.set(0.2, 0.4, 0);
}

function change3dColor(hexColor, buttonEl) {
    if (chassisMesh && chassisMesh.material) {
        const color = new THREE.Color(hexColor);
        chassisMesh.material.color = color;
    }
    if (buttonEl) {
        document.querySelectorAll(".dk-3d-swatch").forEach(s => s.classList.remove("active"));
        buttonEl.classList.add("active");
    }
}

// Close modal on Escape key
window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close3dModal();
});
</script>
