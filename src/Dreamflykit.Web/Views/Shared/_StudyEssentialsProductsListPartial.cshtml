@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var currentSubSlug = Model.CurrentSubcategorySlug;
    var categoryName = !string.IsNullOrWhiteSpace(Model.CategoryName) ? Model.CategoryName : "Study Essentials";
    var activeSubItem = Model.CurrentSubcatItem ?? "";
}

<div id="dkCatProductsInner">

    <!-- Top Action Bar (Title, Breadcrumb & Sorting) -->
    <div class="dk-cat-products-header-card">
        <div class="dk-cat-crumb-row">
            <a href="/" class="dk-c-crumb">Home</a>
            <span class="dk-c-sep">›</span>
            <a href="/category/study-essentials" class="dk-c-crumb">Study Essentials</a>
            <span class="dk-c-sep">›</span>
            <span class="dk-c-current">@categoryName</span>
        </div>

        <div class="dk-cat-title-row">
            <div>
                <h1 class="dk-cat-heading">@categoryName</h1>
                <p class="dk-cat-subtext">Verified university student supplies, study tools &amp; campus gear.</p>
            </div>

            <div class="dk-cat-sort-box">
                <label for="dkCatSortSelect" class="dk-sort-label">Sort By:</label>
                <select id="dkCatSortSelect" class="dk-sort-dropdown" onchange="handleStudySortChange(this.value)">
                    <option value="Relevance" selected="@(Model.Sort == Dreamflykit.Application.Catalog.Models.ProductSortOption.Relevance)">Featured / Relevance</option>
                    <option value="PriceLowToHigh" selected="@(Model.Sort == Dreamflykit.Application.Catalog.Models.ProductSortOption.PriceLowToHigh)">Price: Low to High</option>
                    <option value="PriceHighToLow" selected="@(Model.Sort == Dreamflykit.Application.Catalog.Models.ProductSortOption.PriceHighToLow)">Price: High to Low</option>
                    <option value="Newest" selected="@(Model.Sort == Dreamflykit.Application.Catalog.Models.ProductSortOption.Newest)">Newest First</option>
                    <option value="DiscountHighToLow" selected="@(Model.Sort == Dreamflykit.Application.Catalog.Models.ProductSortOption.DiscountHighToLow)">Discount</option>
                </select>
            </div>
        </div>

        <div class="dk-cat-meta-bar">
            <span class="dk-cat-prod-count" id="dkCatProdCount">@(Model.Products?.Count ?? 0) Products</span>

            <!-- Active filter chip for selected subcategory -->
            <div id="dkCatActiveChipWrap" class="dk-active-filter-chip" style="@(string.IsNullOrWhiteSpace(activeSubItem) ? "display: none;" : "display: inline-flex;")">
                <span>Subcategory: <strong id="dkCatActiveChipText">@activeSubItem</strong></span>
                <button type="button" class="dk-chip-remove-btn" onclick="filterBySubItem('')" title="Remove filter">✕</button>
            </div>
        </div>
    </div>

    <!-- PRODUCTS GRID -->
    @if (Model.Products != null && Model.Products.Count > 0)
    {
        <div class="dk-cat-products-grid">
            @foreach (var product in Model.Products)
            {
                var prodImg = !string.IsNullOrWhiteSpace(product.ImageUrl)
                    ? product.ImageUrl
                    : (product.PrimaryImageUrl ?? "/images/study-hub/test-pic-placeholder.svg");

                <div class="dk-cat-prod-card"
                     data-product-id="@product.ProductId"
                     data-subcat-tags="@product.Name @product.Description"
                     data-title="@product.Name"
                     data-desc="@product.Description">

                    <a href="/product/@product.Slug" class="dk-cat-prod-img-box">
                        <img src="@prodImg" alt="@product.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                        @if (product.DiscountPercentage > 0)
                        {
                            <span class="dk-cat-prod-badge">@product.DiscountPercentage.ToString("0")% OFF</span>
                        }
                    </a>

                    <div class="dk-cat-prod-details">
                        <span class="dk-cat-prod-badge-verified">Verified Study Essential</span>
                        <h3 class="dk-cat-prod-title">
                            <a href="/product/@product.Slug" title="@product.Name">@product.Name</a>
                        </h3>
                        <p class="dk-cat-prod-desc">@product.Description</p>

                        <div class="dk-cat-prod-rating-row">
                            <span class="dk-cat-stars">★★★★★</span>
                            <span class="dk-cat-rating-num">4.8</span>
                            <span class="dk-cat-reviews-count">(Student Favorite)</span>
                        </div>

                        <div class="dk-cat-prod-price-area">
                            <span class="dk-cat-prod-price">₹@product.SellingPrice.ToString("N0")</span>
                            @if (product.Mrp > product.SellingPrice)
                            {
                                <span class="dk-cat-prod-mrp">₹@product.Mrp.ToString("N0")</span>
                                <span class="dk-cat-prod-save">Save ₹@((product.Mrp - product.SellingPrice).ToString("N0"))</span>
                            }
                        </div>

                        <div class="dk-cat-prod-actions">
                            <button type="button" class="dk-cat-btn-buy" onclick="handleStudyAddToCart('@product.ProductId')">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Dynamic Empty State when client-side filter yields 0 cards -->
        <div id="dkCatSubEmptyState" class="dk-cat-empty-box" style="display: none;">
            <div class="dk-cat-empty-icon">🔍</div>
            <h3>No products found for this subcategory</h3>
            <p>Admin will upload more products for this subcategory soon. Try another subcategory or browse all @categoryName products.</p>
            <button type="button" class="dk-cat-btn-reset" onclick="filterBySubItem('')">
                Browse All @categoryName
            </button>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="dk-study-pagination" aria-label="Products pagination">
                @if (Model.HasPreviousPage)
                {
                    var prevUrl = !string.IsNullOrWhiteSpace(currentSubSlug)
                        ? $"/category/study-essentials/{currentSubSlug}?page={Model.Page - 1}&sort={Model.Sort}"
                        : $"/category/study-essentials?page={Model.Page - 1}&sort={Model.Sort}";
                    <a href="@prevUrl" class="dk-page-link">‹ Previous</a>
                }
                <span class="dk-page-info">Page @Model.Page of @Model.TotalPages</span>
                @if (Model.HasNextPage)
                {
                    var nextUrl = !string.IsNullOrWhiteSpace(currentSubSlug)
                        ? $"/category/study-essentials/{currentSubSlug}?page={Model.Page + 1}&sort={Model.Sort}"
                        : $"/category/study-essentials?page={Model.Page + 1}&sort={Model.Sort}";
                    <a href="@nextUrl" class="dk-page-link">Next ›</a>
                }
            </nav>
        }
    }
    else
    {
        <div class="dk-cat-empty-box">
            <div class="dk-cat-empty-icon">📦</div>
            <h3>Products uploading soon by Admin</h3>
            <p>Admin is currently configuring products for @categoryName. Check back shortly!</p>
            <a href="/category/study-essentials" class="dk-cat-btn-reset">Back to Study Essentials Hub</a>
        </div>
    }

</div>

<style>
    /* Products Header Card */
    .dk-cat-products-header-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 16px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
    }
    .dk-cat-crumb-row {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #64748b;
        margin-bottom: 8px;
    }
    .dk-c-crumb {
        color: #0284c7;
        text-decoration: none;
    }
    .dk-c-crumb:hover {
        text-decoration: underline;
    }
    .dk-c-sep {
        color: #94a3b8;
    }
    .dk-c-current {
        color: #334155;
        font-weight: 700;
    }

    .dk-cat-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f5f9;
    }
    .dk-cat-heading {
        font-size: 1.55rem;
        font-weight: 900;
        color: #0f172a;
        margin: 0 0 4px 0;
        letter-spacing: -0.015em;
    }
    .dk-cat-subtext {
        font-size: 12.5px;
        color: #64748b;
        margin: 0;
    }

    .dk-cat-sort-box {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .dk-sort-label {
        font-size: 12.5px;
        font-weight: 700;
        color: #475569;
    }
    .dk-sort-dropdown {
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 12.5px;
        font-weight: 700;
        color: #0f172a;
        cursor: pointer;
        outline: none;
    }
    .dk-sort-dropdown:focus {
        border-color: #0284c7;
    }

    .dk-cat-meta-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
        flex-wrap: wrap;
    }
    .dk-cat-prod-count {
        font-size: 12.5px;
        font-weight: 800;
        color: #063f91;
    }
    .dk-active-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f0f7ff;
        border: 1px solid #bae6fd;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11.5px;
        color: #0369a1;
    }
    .dk-chip-remove-btn {
        background: #0284c7;
        color: #ffffff;
        border: none;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        font-size: 9px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    /* Products Grid */
    .dk-cat-products-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }
    @@media (max-width: 1200px) {
        .dk-cat-products-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width: 820px) {
        .dk-cat-products-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    }
    @@media (max-width: 480px) {
        .dk-cat-products-grid { grid-template-columns: 1fr; }
    }

    .dk-cat-prod-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    }
    .dk-cat-prod-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(6, 63, 145, 0.1);
        border-color: #93c5fd;
    }

    .dk-cat-prod-img-box {
        position: relative;
        background: #f8fafc;
        padding: 16px;
        height: 170px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        overflow: hidden;
    }
    .dk-cat-prod-img-box img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.3s;
    }
    .dk-cat-prod-card:hover .dk-cat-prod-img-box img {
        transform: scale(1.04);
    }
    .dk-cat-prod-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #ff7900;
        color: #ffffff;
        font-size: 10.5px;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 4px;
        letter-spacing: 0.3px;
    }

    .dk-cat-prod-details {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .dk-cat-prod-badge-verified {
        font-size: 9.5px;
        font-weight: 800;
        text-transform: uppercase;
        color: #0284c7;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }
    .dk-cat-prod-title {
        font-size: 13.5px;
        font-weight: 700;
        line-height: 1.35;
        margin: 0 0 6px 0;
        height: 38px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
    .dk-cat-prod-title a {
        color: #0f172a;
        text-decoration: none;
    }
    .dk-cat-prod-title a:hover {
        color: #0284c7;
    }

    .dk-cat-prod-desc {
        font-size: 11.5px;
        color: #64748b;
        margin: 0 0 8px 0;
        line-height: 1.35;
        height: 32px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .dk-cat-prod-rating-row {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        margin-bottom: 10px;
    }
    .dk-cat-stars {
        color: #f59e0b;
        font-size: 12px;
        letter-spacing: 1px;
    }
    .dk-cat-rating-num {
        font-weight: 800;
        color: #0f172a;
    }
    .dk-cat-reviews-count {
        color: #64748b;
    }

    .dk-cat-prod-price-area {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-top: auto;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }
    .dk-cat-prod-price {
        font-size: 1.15rem;
        font-weight: 900;
        color: #0f172a;
    }
    .dk-cat-prod-mrp {
        font-size: 12px;
        color: #94a3b8;
        text-decoration: line-through;
    }
    .dk-cat-prod-save {
        font-size: 11px;
        font-weight: 700;
        color: #16a34a;
    }

    .dk-cat-prod-actions {
        display: flex;
        gap: 8px;
    }
    .dk-cat-btn-buy {
        width: 100%;
        background: linear-gradient(135deg, #ff7900 0%, #e06500 100%);
        color: #ffffff;
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s;
        box-shadow: 0 2px 6px rgba(255, 121, 0, 0.25);
    }
    .dk-cat-btn-buy:hover {
        background: linear-gradient(135deg, #e06500 0%, #c45500 100%);
        transform: translateY(-1px);
    }

    /* Empty Box */
    .dk-cat-empty-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 48px 24px;
        text-align: center;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
    }
    .dk-cat-empty-icon {
        font-size: 40px;
        margin-bottom: 12px;
    }
    .dk-cat-empty-box h3 {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 6px 0;
    }
    .dk-cat-empty-box p {
        font-size: 13px;
        color: #64748b;
        max-width: 480px;
        margin: 0 auto 18px auto;
        line-height: 1.45;
    }
    .dk-cat-btn-reset {
        background: #0284c7;
        color: #ffffff;
        border: none;
        padding: 9px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s;
    }
    .dk-cat-btn-reset:hover {
        background: #0369a1;
    }

    /* Pagination */
    .dk-study-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-top: 24px;
    }
    .dk-page-link {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        padding: 7px 16px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 700;
        color: #0f172a;
        text-decoration: none;
    }
    .dk-page-link:hover {
        background: #f8fafc;
        border-color: #94a3b8;
    }
    .dk-page-info {
        font-size: 12.5px;
        font-weight: 700;
        color: #64748b;
    }
</style>

<script>
    function handleStudySortChange(sortVal) {
        const url = new URL(window.location.href);
        url.searchParams.set("sort", sortVal);
        window.location.href = url.toString();
    }

    function handleStudyAddToCart(productId) {
        fetch('/cart/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ productId: productId, quantity: 1 })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("Product added to cart!");
            } else {
                window.location.href = '/cart';
            }
        })
        .catch(() => {
            window.location.href = '/cart';
        });
    }
</script>