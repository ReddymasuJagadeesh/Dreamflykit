</div>

@section Scripts {
<script>
    // Tab switching for Student Finder card
    document.querySelectorAll('.dk-finder-tab').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var targetId = this.getAttribute('data-tab-target');
            document.querySelectorAll('.dk-finder-tab').forEach(function(b) {
                b.classList.remove('is-active');
                b.setAttribute('aria-selected', 'false');
            });
            document.querySelectorAll('.dk-finder-tab-content').forEach(function(content) {
                content.classList.remove('is-active');
            });
            this.classList.add('is-active');
            this.setAttribute('aria-selected', 'true');
            var targetEl = document.querySelector(targetId);
            if (targetEl) targetEl.classList.add('is-active');
        });
    });

    // Swap airports button
    var swapBtn = document.getElementById('swapAirportsBtn');
    if (swapBtn) {
        swapBtn.addEventListener('click', function() {
            var origin = document.getElementById('flightOriginCity');
            var dest = document.getElementById('flightDestCity');
            if (origin && dest) {
                // visual pulse animation
                swapBtn.style.transform = 'rotate(180deg)';
                setTimeout(function() { swapBtn.style.transform = 'none'; }, 250);
            }
        });
    }

    // Copy promo code helper
    window.copyPromoCode = function(code, btn) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(code).then(function() {
                var origText = btn.innerHTML;
                btn.innerHTML = '<span>Copied! ✓</span>';
                btn.style.background = '#22c55e';
                btn.style.color = '#ffffff';
                setTimeout(function() {
                    btn.innerHTML = origText;
                    btn.style.background = '';
                    btn.style.color = '';
                }, 2000);
            }).catch(function() {
                prompt('Copy this student discount code:', code);
            });
        } else {
            prompt('Copy this student discount code:', code);
        }
    };

    // Open flight quote modal
    window.handleStudentFlightSearch = function() {
        var originSelect = document.getElementById('flightOriginCity');
        var destSelect = document.getElementById('flightDestCity');
        var departDate = document.getElementById('flightDepartDate').value;
        var originName = originSelect.options[originSelect.selectedIndex].text;
        var destName = destSelect.options[destSelect.selectedIndex].text;

        var summaryHtml = 
            '<div class="dk-route-badge-row">' +
            '   <span class="dk-route-tag">✈️ ' + originName + ' → ' + destName + '</span>' +
            '   <span class="dk-date-tag">📅 Departure: ' + (departDate || 'Upcoming Intake') + '</span>' +
            '</div>';

        document.getElementById('modalFlightSummary').innerHTML = summaryHtml;
        document.getElementById('modalTitle').innerText = 'Student Special Airfare: ' + originSelect.value + ' to ' + destSelect.value;
        document.getElementById('quoteSuccessAlert').style.display = 'none';
        document.getElementById('studentQuoteInquiryForm').style.display = 'block';
        document.getElementById('studentDealModal').style.display = 'flex';
    };

    window.openFlightQuoteModal = function(airlineName) {
        var summaryHtml = 
            '<div class="dk-route-badge-row">' +
            '   <span class="dk-route-tag">✈️ Partner Airline: <strong>' + airlineName + '</strong></span>' +
            '   <span class="dk-date-tag">🎒 2x 23kg Student Baggage Guaranteed</span>' +
            '</div>';
        document.getElementById('modalFlightSummary').innerHTML = summaryHtml;
        document.getElementById('modalTitle').innerText = airlineName + ' Student Airfare & Extra Baggage';
        document.getElementById('quoteSuccessAlert').style.display = 'none';
        document.getElementById('studentQuoteInquiryForm').style.display = 'block';
        document.getElementById('studentDealModal').style.display = 'flex';
    };

    window.openPerkInquiryModal = function(perkTitle) {
        var summaryHtml = 
            '<div class="dk-route-badge-row">' +
            '   <span class="dk-route-tag">⭐ Perk: <strong>' + perkTitle + '</strong></span>' +
            '   <span class="dk-date-tag">🎓 100% Student Verified Deal</span>' +
            '</div>';
        document.getElementById('modalFlightSummary').innerHTML = summaryHtml;
        document.getElementById('modalTitle').innerText = 'Claim Offer: ' + perkTitle;
        document.getElementById('quoteSuccessAlert').style.display = 'none';
        document.getElementById('studentQuoteInquiryForm').style.display = 'block';
        document.getElementById('studentDealModal').style.display = 'flex';
    };

    window.closeStudentDealModal = function() {
        document.getElementById('studentDealModal').style.display = 'none';
    };

    window.submitStudentQuote = function() {
        var btn = document.getElementById('btnSubmitQuote');
        btn.disabled = true;
        btn.innerText = 'Locking In Student Fare...';

        setTimeout(function() {
            document.getElementById('studentQuoteInquiryForm').style.display = 'none';
            document.getElementById('quoteSuccessAlert').style.display = 'block';
            btn.disabled = false;
            btn.innerText = 'Get Instant WhatsApp Fare & Baggage Voucher →';
        }, 600);
    };

    // Close modal on Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.closeStudentDealModal();
        }
    });
</script>
}
