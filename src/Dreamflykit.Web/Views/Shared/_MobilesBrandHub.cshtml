@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var showcase = Model.MobilesBrandShowcase;
    var brandPage = showcase?.Page ?? new Dreamflykit.Application.MobilesHub.Models.MobileBrandPageDto();
    var brandSlug = brandPage.BrandSlug;
    var brandName = brandPage.BrandName;
    var allBrands = showcase?.AllBrands ?? new List<Dreamflykit.Application.MobilesHub.Models.MobileBrandItemDto>();

    var hero = brandPage.HeroBanner ?? new Dreamflykit.Application.MobilesHub.Models.MobileBrandHeroBannerDto();
    var filterGroups = brandPage.FilterGroups ?? new List<Dreamflykit.Application.MobilesHub.Models.MobileBrandFilterGroupDto>();
    var products = brandPage.Products ?? new List<Dreamflykit.Application.MobilesHub.Models.MobileBrandProductDto>();
    var totalProducts = products.Count;

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");

    var primaryColor = !string.IsNullOrWhiteSpace(brandPage.ThemePrimaryColor) ? brandPage.ThemePrimaryColor : "#2563eb";
    var accentColor = !string.IsNullOrWhiteSpace(brandPage.ThemeAccentColor) ? brandPage.ThemeAccentColor : "#7c3aed";
    var bgGradient = !string.IsNullOrWhiteSpace(hero.ThemeBgGradient)
        ? hero.ThemeBgGradient
        : $"linear-gradient(135deg, #0b1120 0%, {primaryColor}40 55%, #0f172a 100%)";
}

<div class="dk-mob-brand-root" id="mobilesBrandRoot" style="--brand-primary: @primaryColor; --brand-accent: @accentColor;">

    <!-- ============================================================
         0. ADMIN QUICK BAR (Only for SuperAdmin / Admin)
    ============================================================ -->
    @if (canManage)
    {
        <div class="dk-mb-admin-bar">
            <div class="dk-mb-admin-left">
                <span class="dk-mb-admin-badge">⚡ Admin Mode</span>
                <span class="dk-mb-admin-hint">
                    Managing <strong>@brandName</strong> under Mobiles Hub. Hero banner, texts, color theme &amp; filters can be fully controlled in Admin Dashboard.
                </span>
            </div>
            <a href="/Admin/MobilesHub#brand-@brandSlug" class="dk-mb-admin-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Manage @brandName in Admin
            </a>
        </div>
    }

    <!-- ============================================================
         1. TOP BRAND NAVIGATION & ALL BRANDS SWITCHER STRIP
    ============================================================ -->
    <div class="dk-mb-nav-strip">
        <div class="dk-mb-nav-title">
            <span>Explore @(allBrands.Count > 0 ? $"{allBrands.Count} " : "")Popular Brands:</span>
        </div>
        <div class="dk-mb-nav-items">
            @foreach (var b in allBrands)
            {
                var isSelected = string.Equals(b.Slug, brandSlug, StringComparison.OrdinalIgnoreCase) ||
                                 string.Equals(b.Name, brandName, StringComparison.OrdinalIgnoreCase);
                var bUrl = $"/category/mobiles/{b.Slug.Trim().ToLowerInvariant()}";
                <a href="@bUrl"
                   class="dk-mb-nav-pill @(isSelected ? "is-selected" : "")"
                   title="View @b.Name Smartphones">
                    <span class="dk-mb-pill-name">@b.Name</span>
                </a>
            }
        </div>
    </div>

    <!-- ============================================================
         2. PANORAMIC BRAND HERO BANNER
    ============================================================ -->
    @if (hero.IsEnabled)
    {
        var minHeight = hero.BannerHeight > 0 ? hero.BannerHeight : 320;
        var isHeroSoon = hero.IsUploadingSoon || string.IsNullOrWhiteSpace(hero.ImageUrl) || hero.ImageUrl.Contains("placeholder") || hero.ImageUrl.Contains("uploading-soon");

        <section class="dk-mb-hero-section" style="min-height: @(minHeight)px; background: @bgGradient;" aria-label="@brandName Flagship Store">
            <div class="dk-mb-hero-glow"></div>
            
            <div class="dk-mb-hero-inner">
                <div class="dk-mb-hero-text-col">
                    <div class="dk-mb-hero-tag">
                        <span class="dk-mb-sparkle">✨</span>
                        <span>@(!string.IsNullOrWhiteSpace(hero.BadgeText) ? hero.BadgeText : "OFFICIAL BRAND STORE • VERIFIED SMARTPHONES")</span>
                    </div>

                    <h1 class="dk-mb-hero-title" style="color: @hero.TitleColor;">
                        @hero.Title
                        <span class="dk-mb-hero-highlight" style="color: @hero.TitleHighlightColor;">@hero.TitleHighlight</span>
                    </h1>

                    <p class="dk-mb-hero-desc" style="color: @hero.SubtitleColor;">
                        @hero.Subtitle
                    </p>

                    <div class="dk-mb-badges-row">
                        <div class="dk-mb-badge-item">
                            <span class="dk-mb-b-icon">🛡️</span>
                            <span>100% Genuine Indian/Global Units</span>
                        </div>
                        <div class="dk-mb-badge-item">
                            <span class="dk-mb-b-icon">🚚</span>
                            <span>Campus Fast Delivery &bull; Direct to Dorm</span>
                        </div>
                        <div class="dk-mb-badge-item">
                            <span class="dk-mb-b-icon">💳</span>
                            <span>0% No-Cost Student EMI &bull; Instant Approval</span>
                        </div>
                    </div>
                </div>

                <div class="dk-mb-hero-img-col">
                    @if (isHeroSoon)
                    {
                        <div class="dk-mb-hero-soon-box">
                            <div class="dk-mb-radar-wrap">
                                <span class="dk-mb-ring ring-1"></span>
                                <span class="dk-mb-ring ring-2"></span>
                                <span class="dk-mb-radar-icon">@brandPage.LogoEmoji</span>
                            </div>
                            <span class="dk-mb-soon-badge">● UPLOADING SOON</span>
                            <span class="dk-mb-soon-title">Admin will implement images</span>
                            <span class="dk-mb-soon-sub">Super Admin can upload/replace official @brandName banner anytime</span>
                        </div>
                    }
                    else
                    {
                        <div class="dk-mb-hero-img-wrap">
                            <img src="@hero.ImageUrl"
                                 alt="@brandName Hero"
                                 loading="eager"
                                 class="dk-mb-hero-img"
                                 onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'dk-mb-hero-soon-box\'><div class=\'dk-mb-radar-wrap\'><span class=\'dk-mb-radar-icon\'>@brandPage.LogoEmoji</span></div><span class=\'dk-mb-soon-badge\'>● Uploading Soon</span><span class=\'dk-mb-soon-title\'>Admin will implement images</span></div>';" />
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ============================================================
         3. MAIN 2-COLUMN CATALOG: FILTERS (LEFT) & PRODUCTS (RIGHT)
    ============================================================ -->
    <div class="dk-mb-layout-container">
        
        <!-- ========================================================
             LEFT COLUMN: FACETED FILTERS SIDEBAR
        ========================================================= -->
        <aside class="dk-mb-filters-sidebar" id="mobilesFilterSidebar">
            
            <div class="dk-mbfs-header">
                <div class="dk-mbfs-title-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    <span class="dk-mbfs-title">Filters for @brandName</span>
                </div>
                <button type="button" class="dk-mbfs-clear-btn" onclick="clearAllMobileFilters()" title="Reset all filters">
                    Clear All
                </button>
            </div>

            <!-- Brand Fast Switch Subhead -->
            <div class="dk-mbfs-brand-subhead">
                <span>@brandName.ToUpperInvariant() STORE FILTERS</span>
            </div>

            <div class="dk-mbfs-body">
                @for (int gIdx = 0; gIdx < filterGroups.Count; gIdx++)
                {
                    var grp = filterGroups[gIdx];
                    <div class="dk-filter-group-card @(grp.IsMoreFilter ? "is-more-group" : "")" data-group-key="@grp.Key">
                        <div class="dk-fg-header" onclick="toggleMobileFilterGroup(this)">
                            <div class="dk-fg-title-wrap">
                                @if (grp.IsMoreFilter)
                                {
                                    <span class="dk-fg-more-tag">MORE</span>
                                }
                                <h3 class="dk-fg-title">@grp.Title</h3>
                            </div>
                            <svg class="dk-fg-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                        </div>
                        <div class="dk-fg-options-list">
                            @foreach (var opt in grp.Options)
                            {
                                <label class="dk-fg-opt-label">
                                    <input type="checkbox" 
                                           class="dk-fg-checkbox mobile-filter-cb" 
                                           data-group="@grp.Key" 
                                           data-val="@opt.Value.ToLowerInvariant()" 
                                           onchange="applyMobileFilters()" />
                                    <span class="dk-fg-custom-cb"></span>
                                    <span class="dk-fg-opt-text">@opt.Label</span>
                                    @if (opt.Count > 0)
                                    {
                                        <span class="dk-fg-opt-count">(@opt.Count)</span>
                                    }
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Campus Advantage Promo Card -->
            <div class="dk-mb-sidebar-promo">
                <span class="dk-mb-sp-badge">CAMPUS ADVANTAGE</span>
                <h4 class="dk-mb-sp-title">Student 5G Upgrade Kit</h4>
                <p class="dk-mb-sp-sub">All @brandName smartphones come with complimentary pre-configured global eSIM, dual-voltage charging &amp; 0% EMI.</p>
                <a href="/category/mobiles" class="dk-mb-sp-btn">Explore All Mobiles &rarr;</a>
            </div>

        </aside>

        <!-- ========================================================
             RIGHT COLUMN: PRODUCTS SHOWCASE & TOOLBAR
        ========================================================= -->
        <main class="dk-mb-main-content">
            
            <!-- Breadcrumbs -->
            <div class="dk-mb-crumb-row">
                <a href="/" class="dk-mb-c">Home</a>
                <span class="dk-mb-sep">›</span>
                <a href="/category/mobiles" class="dk-mb-c">Mobiles</a>
                <span class="dk-mb-sep">›</span>
                <span class="dk-mb-current">@brandName</span>
            </div>

            <!-- Toolbar Header -->
            <div class="dk-mb-toolbar">
                <div class="dk-mb-toolbar-left">
                    <h2 class="dk-mb-catalog-heading">@brandName Smartphones</h2>
                    <span class="dk-mb-results-text">
                        Showing <strong id="lblVisibleCount">@totalProducts</strong> of <strong>@totalProducts</strong> models
                    </span>
                    <div class="dk-mb-active-tags" id="activeFilterTags"></div>
                </div>

                <div class="dk-mb-toolbar-right">
                    <label for="mobileProductSort" class="dk-mb-sort-label">Sort By:</label>
                    <select id="mobileProductSort" class="dk-mb-sort-select" onchange="sortMobileProducts(this.value)">
                        <option value="relevance" selected>Featured / Relevance</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="rating-desc">Customer Rating</option>
                        <option value="discount-desc">Highest Discount</option>
                    </select>
                </div>
            </div>

            <!-- Products Grid (3 columns) -->
            @if (products.Count > 0)
            {
                <div class="dk-mb-products-grid" id="mobileProductsGrid">
                    @for (int pIdx = 0; pIdx < products.Count; pIdx++)
                    {
                        var p = products[pIdx];
                        var hasImage = !string.IsNullOrWhiteSpace(p.ImageUrl) && !p.ImageUrl.Contains("placeholder") && !p.IsUploadingSoon;
                        var tagsString = string.Join(" ", p.FilterTags ?? new List<string>()) + " " +
                                         (p.Series ?? "") + " " + (p.Chipset ?? "") + " " + (p.Ram ?? "") + " " +
                                         (p.Storage ?? "") + " " + (p.Display ?? "") + " " + p.Name;

                        <div class="dk-mb-prod-card"
                             id="prod_card_@pIdx"
                             data-price="@p.Price"
                             data-rating="@p.Rating"
                             data-discount="@p.DiscountPercent"
                             data-tags="@tagsString.ToLowerInvariant()">

                            <!-- Top Discount Badge -->
                            @if (p.DiscountPercent > 0)
                            {
                                <span class="dk-mb-discount-badge">@p.DiscountPercent% OFF</span>
                            }

                            <!-- Image Area -->
                            <div class="dk-mb-prod-img-box">
                                @if (hasImage)
                                {
                                    <img src="@p.ImageUrl"
                                         alt="@p.Name"
                                         loading="lazy"
                                         class="dk-mb-prod-img"
                                         onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'dk-mb-card-uploading\'><div class=\'dk-mb-card-radar\'><span class=\'dk-mb-c-ring ring-1\'></span><span class=\'dk-mb-c-emoji\'>@brandPage.LogoEmoji</span></div><span class=\'dk-mb-c-badge\'>● Uploading Soon</span><p class=\'dk-mb-c-hint\'>Admin will implement images</p></div>';" />
                                }
                                else
                                {
                                    <div class="dk-mb-card-uploading">
                                        <div class="dk-mb-card-radar">
                                            <span class="dk-mb-c-ring ring-1"></span>
                                            <span class="dk-mb-c-ring ring-2"></span>
                                            <span class="dk-mb-c-emoji">@brandPage.LogoEmoji</span>
                                        </div>
                                        <span class="dk-mb-c-badge">● Uploading Soon</span>
                                        <p class="dk-mb-c-hint">Admin will implement images</p>
                                    </div>
                                }
                            </div>

                            <!-- Card Body -->
                            <div class="dk-mb-prod-body">
                                
                                <div class="dk-mb-meta-row">
                                    <span class="dk-mb-brand-chip">@brandName</span>
                                    <div class="dk-mb-stars">
                                        <span class="dk-star-icon">★★★★★</span>
                                        <span class="dk-rating-num">@p.Rating</span>
                                        <span class="dk-review-count">(@p.ReviewCount)</span>
                                    </div>
                                </div>

                                <h3 class="dk-mb-prod-title" title="@p.Name">
                                    <a href="/products?category=mobiles&q=@Uri.EscapeDataString(p.Name)">@p.Name</a>
                                </h3>

                                <!-- Key Specs Pills -->
                                @if (p.KeySpecs != null && p.KeySpecs.Count > 0)
                                {
                                    <div class="dk-mb-specs-pills">
                                        @foreach (var spec in p.KeySpecs.Take(4))
                                        {
                                            <span class="dk-mb-spec-pill">@spec</span>
                                        }
                                    </div>
                                }

                                <!-- Pricing Row -->
                                <div class="dk-mb-pricing-row">
                                    <div class="dk-mb-price-box">
                                        <span class="dk-mb-curr">₹</span>
                                        <span class="dk-mb-price-val">@p.Price.ToString("N0")</span>
                                    </div>
                                    @if (p.OriginalPrice > p.Price)
                                    {
                                        <span class="dk-mb-mrp">₹@p.OriginalPrice.ToString("N0")</span>
                                        <span class="dk-mb-save">Save ₹@((p.OriginalPrice - p.Price).ToString("N0"))</span>
                                    }
                                </div>

                                <!-- Campus Perk Note -->
                                <div class="dk-mb-perk-row">
                                    <span class="dk-mb-perk-icon">✓</span>
                                    <span>@p.CampusPerk</span>
                                </div>

                                <!-- Action Button -->
                                <div class="dk-mb-actions-row">
                                    <button type="button" 
                                            class="dk-mb-btn-cart" 
                                            onclick="handleMobileAddToCart('@p.Id', '@p.Name.Replace("'", "\\'")')">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                        <span>Add to Cart</span>
                                    </button>
                                </div>

                            </div>

                        </div>
                    }
                </div>

                <!-- Empty State -->
                <div id="mobilesEmptyState" class="dk-mb-empty-box" style="display: none;">
                    <div class="dk-mb-empty-icon">🔍</div>
                    <h3>No smartphones match your selected filters</h3>
                    <p>Try unchecking some filters or clear all filters to view all @brandName models.</p>
                    <button type="button" class="dk-mb-btn-reset" onclick="clearAllMobileFilters()">
                        Reset All Filters
                    </button>
                </div>
            }
            else
            {
                <div class="dk-mb-empty-box">
                    <div class="dk-mb-empty-icon">📱</div>
                    <h3>Models uploading soon by Admin</h3>
                    <p>Admin is currently configuring smartphone models for @brandName. Check back shortly!</p>
                    <a href="/category/mobiles" class="dk-mb-btn-reset">Back to Mobiles Hub</a>
                </div>
            }

        </main>
    </div>

</div>

<!-- ============================================================
     STYLING FOR MOBIS BRAND SHOWCASE & FILTER SYSTEM
============================================================ -->
<style>
    .dk-mob-brand-root {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        padding: 4px 0 40px 0;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Admin Bar */
    .dk-mb-admin-bar {
        background: #0f172a;
        color: #f8fafc;
        padding: 10px 18px;
        border-radius: 10px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }
    .dk-mb-admin-left {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
    }
    .dk-mb-admin-badge {
        background: #ef4444;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 4px;
        letter-spacing: 0.5px;
    }
    .dk-mb-admin-hint {
        font-size: 13px;
        color: #cbd5e1;
    }
    .dk-mb-admin-hint strong {
        color: #38bdf8;
    }
    .dk-mb-admin-btn {
        background: #2563eb;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .dk-mb-admin-btn:hover { background: #1d4ed8; color: #fff; }

    /* Nav Strip */
    .dk-mb-nav-strip {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 14px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        overflow-x: auto;
        white-space: nowrap;
    }
    .dk-mb-nav-title {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #0284c7;
        flex-shrink: 0;
    }
    .dk-mb-nav-items {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: nowrap;
    }
    .dk-mb-nav-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #334155;
        font-size: 12.5px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
        text-decoration: none;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .dk-mb-nav-pill:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #0f172a;
    }
    .dk-mb-nav-pill.is-selected {
        background: #0284c7;
        border-color: #0284c7;
        color: #ffffff;
        font-weight: 700;
        box-shadow: 0 2px 8px rgba(2, 132, 199, 0.35);
    }

    /* Hero Banner */
    .dk-mb-hero-section {
        position: relative;
        border-radius: 16px;
        padding: 30px 36px;
        margin-bottom: 22px;
        overflow: hidden;
        color: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.25);
    }
    .dk-mb-hero-glow {
        position: absolute;
        top: -50%;
        right: -20%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, transparent 70%);
        pointer-events: none;
    }
    .dk-mb-hero-inner {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 32px;
        align-items: center;
    }
    .dk-mb-hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #e0f2fe;
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        padding: 4px 12px;
        border-radius: 20px;
        margin-bottom: 12px;
    }
    .dk-mb-hero-title {
        font-size: 28px;
        font-weight: 900;
        line-height: 1.25;
        margin: 0 0 10px 0;
        letter-spacing: -0.5px;
    }
    .dk-mb-hero-highlight {
        display: block;
        font-size: 24px;
        font-weight: 800;
        margin-top: 4px;
    }
    .dk-mb-hero-desc {
        font-size: 14px;
        line-height: 1.5;
        margin: 0 0 18px 0;
        max-width: 650px;
    }
    .dk-mb-badges-row {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }
    .dk-mb-badge-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #e2e8f0;
    }
    .dk-mb-b-icon { font-size: 14px; }

    /* Hero Radar / Soon */
    .dk-mb-hero-img-col {
        display: flex;
        justify-content: center;
    }
    .dk-mb-hero-soon-box {
        width: 100%;
        max-width: 320px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px dashed rgba(255, 255, 255, 0.25);
        border-radius: 14px;
        padding: 24px 16px;
        text-align: center;
        backdrop-filter: blur(8px);
    }
    .dk-mb-radar-wrap {
        position: relative;
        width: 68px;
        height: 68px;
        margin: 0 auto 12px auto;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .dk-mb-ring {
        position: absolute;
        border-radius: 50%;
        border: 2px solid rgba(56, 189, 248, 0.4);
        animation: dkMbPulse 2.4s infinite ease-out;
    }
    .dk-mb-ring.ring-1 { width: 100%; height: 100%; }
    .dk-mb-ring.ring-2 { width: 140%; height: 140%; animation-delay: 0.8s; }
    @@keyframes dkMbPulse {
        0% { transform: scale(0.6); opacity: 1; }
        100% { transform: scale(1.4); opacity: 0; }
    }
    .dk-mb-radar-icon {
        font-size: 32px;
        z-index: 2;
    }
    .dk-mb-soon-badge {
        display: inline-block;
        background: rgba(34, 197, 94, 0.2);
        color: #4ade80;
        font-size: 10.5px;
        font-weight: 800;
