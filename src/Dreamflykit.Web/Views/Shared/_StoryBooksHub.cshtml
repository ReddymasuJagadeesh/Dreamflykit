    border: none;
    color: #FFFFFF;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 2px;
}

.sbf-search-input {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 13px;
    padding: 4px 8px;
    width: 180px;
    outline: none;
    transition: width 0.3s;
}

.sbf-search-input:focus {
    width: 240px;
}

.sbf-search-input::placeholder {
    color: #888888;
}

.sbf-notifications-dropdown {
    position: relative;
}

.sbf-icon-btn {
    background: none;
    border: none;
    color: #FFFFFF;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    position: relative;
}

.sbf-badge-dot {
    position: absolute;
    top: 2px;
    right: 2px;
    background-color: #E50914;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: 50%;
