<!-- ========================================================
     CLIENT INTERACTIVITY SCRIPT
========================================================= -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadGuideChecklistState();
    });

    function getStorageKey() {
        return "dk_guide_chk_" + "@Model.Slug";
    }

    function loadGuideChecklistState() {
        const key = getStorageKey();
        let state = {};
        try {
            state = JSON.parse(localStorage.getItem(key) || "{}");
        } catch (e) { }

        const inputs = document.querySelectorAll(".dk-guide-chk-input");
        let checkedCount = 0;

        inputs.forEach(input => {
            const idx = input.getAttribute("data-index");
            if (state[idx] === true) {
                input.checked = true;
                checkedCount++;
                const row = input.closest(".dk-guide-chk-row");
                if (row) row.classList.add("is-completed");
            }
        });

        updateProgressText(checkedCount, inputs.length);
    }

    function onGuideChecklistChange(input) {
        const key = getStorageKey();
        let state = {};
        try {
            state = JSON.parse(localStorage.getItem(key) || "{}");
        } catch (e) { }

        const idx = input.getAttribute("data-index");
        state[idx] = input.checked;
        localStorage.setItem(key, JSON.stringify(state));

        const row = input.closest(".dk-guide-chk-row");
        if (row) {
            if (input.checked) {
                row.classList.add("is-completed");
            } else {
                row.classList.remove("is-completed");
            }
        }

        const inputs = document.querySelectorAll(".dk-guide-chk-input");
        const checkedCount = Array.from(inputs).filter(i => i.checked).length;
        updateProgressText(checkedCount, inputs.length);
    }

    function updateProgressText(checked, total) {
        const el = document.getElementById("guideChkProgressText");
        if (el) {
            el.textContent = checked + " of " + total + " checked";
        }
    }

    function handleGuideAddToCart(title, price, img) {
        showGuideToast("✓ Added " + title + " (₹" + Number(price).toLocaleString("en-IN") + ") to cart!");
    }

    function showGuideToast(msg) {
        let toast = document.getElementById("dk-guide-toast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "dk-guide-toast";
            toast.style.cssText = "position: fixed; bottom: 30px; right: 30px; background: #0f172a; color: #ffffff; padding: 12px 22px; border-radius: 10px; font-weight: 700; font-size: 13.5px; z-index: 99999; box-shadow: 0 10px 30px rgba(0,0,0,0.25); border-left: 4px solid #38bdf8; transition: opacity 0.3s;";
            document.body.appendChild(toast);
        }
        toast.textContent = msg;
        toast.style.display = "block";
        toast.style.opacity = "1";
        setTimeout(() => {
            toast.style.opacity = "0";
            setTimeout(() => { toast.style.display = "none"; }, 300);
        }, 3000);
    }
</script>
