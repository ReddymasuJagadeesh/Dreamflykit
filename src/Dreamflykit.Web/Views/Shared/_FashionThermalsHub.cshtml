<script>
function toggleThermalsWishlist(btn, id) {
    btn.classList.toggle('active');
    var isFilled = btn.classList.contains('active');
    var path = btn.querySelector('svg path');
    if (path) {
        path.setAttribute('fill', isFilled ? '#ef4444' : 'none');
    }
}
function addThermalsToCart(btn, name) {
    btn.style.transform = 'scale(0.95)';
    btn.innerText = 'ADDED ✓';
    btn.style.background = '#0f172a';
    btn.style.color = '#ffffff';
    setTimeout(function() {
        btn.style.transform = '';
        if (typeof showToast === 'function') {
            showToast(name + ' added to kit!');
        }
    }, 200);
}
document.addEventListener('DOMContentLoaded', function() {
    var track = document.getElementById('dkThermalsTrackWrapper');
    var prev = document.getElementById('dkThermalsPrev');
    var next = document.getElementById('dkThermalsNext');
    if (track && prev && next) {
        prev.addEventListener('click', function() { track.scrollBy({ left: -280, behavior: 'smooth' }); });
        next.addEventListener('click', function() { track.scrollBy({ left: 280, behavior: 'smooth' }); });
    }
});
</script>

