        newRow.innerHTML = `
            <label style="display: flex; align-items: center; gap: 6px; font-weight: 700; font-size: 12px; color: #0284c7; cursor: pointer; white-space: nowrap; margin-top: 14px;">
                <input type="checkbox" class="abroad-hs-enabled-chk" checked style="width: 16px; height: 16px; accent-color: #0284c7;" />
                <span>Show</span>
            </label>
            <div>
