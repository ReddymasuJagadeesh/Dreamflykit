# ==============================================================================
# Dreamflykit Environment Variables Template
# Copy this file to .env and replace placeholder values with production secrets.
# NEVER commit the active .env file to source control.
# ==============================================================================

# Application Runtime Configuration
ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# PostgreSQL Database Configuration
POSTGRES_DB=dreamflykit
POSTGRES_USER=dreamfly_user
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_PORT=5432

# Database Connection String for Dreamflykit.Web (.NET configuration format)
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=dreamflykit;Username=dreamfly_user;Password=replace_with_strong_password_in_production

# AWS S3 & Media Configuration
AwsS3__BucketName=dreamflykit-production-bucket
AwsS3__Region=ap-south-1
AwsS3__AccessKeyId=your_aws_access_key_id
AwsS3__SecretAccessKey=your_aws_secret_access_key
AwsS3__SessionToken=

Media__BucketName=dreamflykit-production-bucket
Media__AwsRegion=ap-south-1
# Leave Media__CdnBaseUrl empty to serve directly through the application's secure media delivery endpoint (/media/...)
# Only set Media__CdnBaseUrl if you have an active CloudFront distribution configured in AWS.
Media__CdnBaseUrl=
