@model Dreamflykit.Application.SportsHub.Models.SportsHubDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sports Hub Management";
    var hub = Model ?? Dreamflykit.Application.SportsHub.Models.SportsHubDto.CreateDefault();
    var festival = hub.FestivalTheme ?? new();
    var hero = hub.HeroBanner ?? new();
    var shopCategory = hub.ShopByCategory ?? new();
    var subPages = hub.SubcategoryPages ?? new();
    var topPicks = hub.TopPicks ?? new();
    var bottomBanner = hub.BottomBanner ?? new();
}

@Html.AntiForgeryToken()

<div class="sp-admin-container">

    <!-- TOP HEADER & CONTROLS -->
    <div class="sp-admin-header">
        <div>
            <div class="sp-admin-title-row">
                <span class="sp-badge-tag">SPORTS HUB ADMIN</span>
                <span class="sp-badge-status">● Live</span>
            </div>
            <h1 class="sp-admin-heading">Sports Hub & Athletic Category Controls</h1>
            <p class="sp-admin-subheading">Manage campaign announcement, full-width hero slider, 12 sports categories, landing pages & product grids.</p>
        </div>
        <div class="sp-admin-actions">
            <a href="/category/sports-hub" target="_blank" class="sp-btn-secondary">
                <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
                <span>Preview Hub</span>
            </a>
            <button type="button" class="sp-btn-primary" id="btnSaveConfig" onclick="saveSportsConfig()">
                <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Save All Changes</span>
            </button>
            <form asp-area="Admin" asp-controller="SportsHub" asp-action="ResetDefaults" method="post" style="display:inline;" onsubmit="return confirm('Reset Sports Hub to default settings? Any unsaved edits will be lost.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="sp-btn-danger" title="Reset all to defaults">↻ Reset</button>
            </form>
        </div>
    </div>

    <!-- TABS NAVIGATION -->
    <div class="sp-tabs-nav">
        <button type="button" class="sp-tab-btn active" onclick="switchTab('tabCampaign', this)">
            <span>🏆 Campaign / Festival Banner</span>
        </button>
        <button type="button" class="sp-tab-btn" onclick="switchTab('tabHero', this)">
            <span>⚽ Full-Width Hero Slider</span>
        </button>
        <button type="button" class="sp-tab-btn" onclick="switchTab('tabCategories', this)">
            <span>🛍️ Shop by Category (12 Items)</span>
        </button>
        <button type="button" class="sp-tab-btn" onclick="switchTab('tabSubpages', this)">
            <span>📄 Subcategory Landing Pages</span>
        </button>
        <button type="button" class="sp-tab-btn" onclick="switchTab('tabTopPicks', this)">
            <span>⚡ Top Picks & Bottom Banner</span>
        </button>
    </div>

    <form id="sportsHubForm">
        <!-- ========================================================
             TAB 1: CAMPAIGN / FESTIVAL BANNER
        ========================================================= -->
        <div id="tabCampaign" class="sp-tab-panel active">
            <div class="sp-card">
                <div class="sp-card-header">
                    <h2 class="sp-card-title">Campaign & Festival Announcement Ribbon</h2>
                    <label class="sp-switch">
                        <input type="checkbox" id="festIsEnabled" @(festival.IsEnabled ? "checked" : "") />
                        <span class="sp-slider round"></span>
                        <span class="sp-switch-label">Enable Ribbon</span>
                    </label>
                </div>
                <div class="sp-grid-2">
                    <div class="sp-field">
                        <label>Festival / Campaign Title</label>
                        <input type="text" id="festName" class="sp-input" value="@festival.FestivalName" />
                    </div>
                    <div class="sp-field">
                        <label>Badge Text</label>
                        <input type="text" id="festBadge" class="sp-input" value="@festival.BadgeText" />
                    </div>
                </div>
                <div class="sp-grid-2">
                    <div class="sp-field">
                        <label>Announcement Text</label>
                        <input type="text" id="festAnnouncement" class="sp-input" value="@festival.AnnouncementText" />
                    </div>
                    <div class="sp-field">
                        <label>Highlight Tag</label>
                        <input type="text" id="festHighlight" class="sp-input" value="@festival.BannerHighlight" />
                    </div>
                </div>
                <div class="sp-field">
                    <label>Background Gradient CSS</label>
                    <input type="text" id="festGradient" class="sp-input" value="@festival.BgGradient" />
                </div>
            </div>
        </div>

        <!-- ========================================================
             TAB 2: HERO BANNER SLIDES
        ========================================================= -->
        <div id="tabHero" class="sp-tab-panel">
            <div class="sp-card">
                <div class="sp-card-header">
                    <h2 class="sp-card-title">Full-Width Hero Slider Settings</h2>
                    <label class="sp-switch">
                        <input type="checkbox" id="heroIsEnabled" @(hero.IsEnabled ? "checked" : "") />
                        <span class="sp-slider round"></span>
                        <span class="sp-switch-label">Enable Hero Banner</span>
                    </label>
                </div>
                <div class="sp-grid-3">
                    <div class="sp-field">
                        <label>Auto-Play Slides</label>
                        <select id="heroAutoPlay" class="sp-input">
                            <option value="true" selected="@(hero.AutoPlay ? "selected" : null)">Enabled (Automatic Rotation)</option>
                            <option value="false" selected="@(!hero.AutoPlay ? "selected" : null)">Disabled</option>
                        </select>
                    </div>
                    <div class="sp-field">
                        <label>Slide Interval (Seconds)</label>
                        <input type="number" id="heroInterval" class="sp-input" value="@hero.SlideIntervalSeconds" min="2" max="15" />
                    </div>
                    <div class="sp-field">
                        <label>Banner Min Height (px)</label>
                        <input type="number" id="heroHeight" class="sp-input" value="@hero.BannerHeight" min="300" max="700" />
                    </div>
                </div>

                <div class="sp-sub-header">
                    <h3>Hero Slides</h3>
                    <button type="button" class="sp-btn-sm" onclick="addHeroSlide()">+ Add New Slide</button>
                </div>

                <div id="heroSlidesList" class="sp-slides-list">
                    @for (int i = 0; i < hero.Slides.Count; i++)
                    {
                        var slide = hero.Slides[i];
                        <div class="sp-slide-card" data-slide-card>
                            <div class="sp-slide-top">
                                <span class="sp-slide-num">Slide #<span class="slide-order-num">@(i + 1)</span></span>
                                <div class="sp-slide-toggles">
                                    <label class="sp-switch sp-switch-sm">
                                        <input type="checkbox" class="slide-isactive" @(slide.IsActive ? "checked" : "") />
                                        <span class="sp-slider round"></span>
                                        <span class="sp-switch-label">Active</span>
                                    </label>
                                    <label class="sp-switch sp-switch-sm">
                                        <input type="checkbox" class="slide-uploading" @(slide.IsUploadingSoon ? "checked" : "") />
                                        <span class="sp-slider round"></span>
                                        <span class="sp-switch-label">Uploading Soon</span>
                                    </label>
                                    <button type="button" class="sp-btn-icon-danger" onclick="removeHeroSlide(this)" title="Delete Slide">✕</button>
                                </div>
                            </div>

                            <input type="hidden" class="slide-id" value="@slide.Id" />
                            <div class="sp-grid-2">
                                <div class="sp-field">
                                    <label>Badge Text</label>
                                    <input type="text" class="sp-input slide-badge" value="@slide.BadgeText" />
                                </div>
                                <div class="sp-field">
                                    <label>Title</label>
                                    <input type="text" class="sp-input slide-title" value="@slide.Title" />
                                </div>
                            </div>
                            <div class="sp-grid-2">
                                <div class="sp-field">
                                    <label>Title Highlight (Gradient)</label>
                                    <input type="text" class="sp-input slide-highlight" value="@slide.TitleHighlight" />
                                </div>
                                <div class="sp-field">
                                    <label>Subtitle / Description</label>
                                    <input type="text" class="sp-input slide-subtitle" value="@slide.Subtitle" />
                                </div>
                            </div>
                            <div class="sp-grid-3">
                                <div class="sp-field">
                                    <label>Target URL</label>
                                    <input type="text" class="sp-input slide-url" value="@slide.TargetUrl" />
                                </div>
                                <div class="sp-field">
                                    <label>Button Text</label>
                                    <input type="text" class="sp-input slide-btn-text" value="@slide.ButtonText" />
                                </div>
                                <div class="sp-field">
                                    <label>Display Order</label>
                                    <input type="number" class="sp-input slide-order" value="@slide.DisplayOrder" min="1" />
                                </div>
                            </div>

                            <div class="sp-image-uploader-field">
                                <label>Slide Image URL</label>
                                <div class="sp-upload-row">
                                    <input type="text" class="sp-input slide-img-url" value="@slide.ImageUrl" placeholder="/images/sports-hub/..." />
                                    <input type="file" class="sp-file-input" accept="image/*" onchange="uploadSlideImage(this)" style="display:none;" />
                                    <button type="button" class="sp-btn-upload" onclick="triggerFileInput(this)">
                                        <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                                        <span>Upload File</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ========================================================
             TAB 3: SHOP BY CATEGORY (12 ITEMS)
        ========================================================= -->
        <div id="tabCategories" class="sp-tab-panel">
            <div class="sp-card">
                <div class="sp-card-header">
                    <h2 class="sp-card-title">Shop by Category Section (12 Athletic Categories)</h2>
                    <label class="sp-switch">
                        <input type="checkbox" id="catSectionEnabled" @(shopCategory.IsEnabled ? "checked" : "") />
                        <span class="sp-slider round"></span>
                        <span class="sp-switch-label">Enable Section</span>
                    </label>
                </div>
                <div class="sp-grid-2">
                    <div class="sp-field">
                        <label>Section Title</label>
                        <input type="text" id="catSectionTitle" class="sp-input" value="@shopCategory.Title" />
                    </div>
                    <div class="sp-field">
                        <label>Section Subtitle</label>
                        <input type="text" id="catSectionSub" class="sp-input" value="@shopCategory.Subtitle" />
                    </div>
                </div>

                <div class="sp-sub-header">
                    <h3>Sports Categories</h3>
                </div>

                <div class="sp-categories-admin-grid">
                    @for (int i = 0; i < shopCategory.Items.Count; i++)
                    {
                        var item = shopCategory.Items[i];
                        <div class="sp-admin-cat-card" data-cat-card>
                            <input type="hidden" class="cat-slug" value="@item.Slug" />
                            <div class="sp-cat-top-bar">
                                <span class="sp-cat-badge">#@(i + 1) @item.Name</span>
                                <label class="sp-switch sp-switch-sm">
                                    <input type="checkbox" class="cat-isactive" @(item.IsActive ? "checked" : "") />
                                    <span class="sp-slider round"></span>
                                    <span class="sp-switch-label">Active</span>
                                </label>
                            </div>

                            <div class="sp-grid-2">
                                <div class="sp-field">
                                    <label>Display Name</label>
                                    <input type="text" class="sp-input cat-name" value="@item.Name" />
                                </div>
                                <div class="sp-field">
                                    <label>Icon Emoji</label>
                                    <input type="text" class="sp-input cat-emoji" value="@item.IconEmoji" />
                                </div>
                            </div>

                            <div class="sp-grid-2">
                                <div class="sp-field">
                                    <label>Subtitle / Tagline</label>
                                    <input type="text" class="sp-input cat-sub" value="@item.Subtitle" />
                                </div>
                                <div class="sp-field">
                                    <label>Display Order</label>
                                    <input type="number" class="sp-input cat-order" value="@item.DisplayOrder" min="1" />
                                </div>
                            </div>

                            <div class="sp-field">
                                <label>Subcategories (Comma-separated for Explorer Sidebar)</label>
                                <textarea class="sp-input cat-subcategories" rows="2" placeholder="e.g. Bats, Match Balls, Pads, Gloves">@string.Join(", ", item.Subcategories ?? new List<string>())</textarea>
                            </div>

                            <div class="sp-field">
                                <label>Important Note for Athletes (Optional)</label>
                                <input type="text" class="sp-input cat-note" value="@item.ImportantNote" placeholder="e.g. Tournament spec regulations note" />
                            </div>

                            <div class="sp-field">
                                <label>Image URL</label>
                                <div class="sp-upload-row">
                                    <input type="text" class="sp-input cat-img" value="@item.ImageUrl" />
                                    <input type="file" class="sp-file-input" accept="image/*" onchange="uploadCatImage(this)" style="display:none;" />
                                    <button type="button" class="sp-btn-upload-sm" onclick="triggerFileInput(this)">Upload</button>
                                </div>
                            </div>

                            <label class="sp-switch sp-switch-sm" style="margin-top: 6px;">
                                <input type="checkbox" class="cat-uploading" @(item.IsUploadingSoon ? "checked" : "") />
                                <span class="sp-slider round"></span>
                                <span class="sp-switch-label">Show "Uploading Soon" radar tag</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ========================================================
             TAB 4: SUBCATEGORY LANDING PAGES & PRODUCTS
        ========================================================= -->
        <div id="tabSubpages" class="sp-tab-panel">
            <div class="sp-card">
                <div class="sp-card-header">
                    <h2 class="sp-card-title">Subcategory Landing Pages & Big Image Frames</h2>
                    <div class="sp-subpage-selector-wrap">
                        <label>Select Category to Edit:</label>
                        <select id="subpageSelector" class="sp-input" onchange="onSelectSubpage(this.value)">
                            @foreach (var pgItem in subPages)
                            {
                                <option value="@pgItem.CategorySlug">@pgItem.CategoryName (@pgItem.CategorySlug)</option>
                            }
                        </select>
                    </div>
                </div>

                <div id="subpagesContainer">
                    @for (int p = 0; p < subPages.Count; p++)
                    {
                        var pgItem = subPages[p];
                        var pHero = pgItem.HeroBanner ?? new();
                        <div class="sp-subpage-editor @(p == 0 ? "active" : "")" id="subpage_@pgItem.CategorySlug" data-subpage-slug="@pgItem.CategorySlug">
                            <input type="hidden" class="page-slug" value="@pgItem.CategorySlug" />
                            <input type="hidden" class="page-name" value="@pgItem.CategoryName" />

                            <div class="sp-subpage-hero-box">
                                <h3 class="sp-sub-title">Hero Banner for @pgItem.CategoryName</h3>
                                <div class="sp-grid-2">
                                    <div class="sp-field">
                                        <label>Banner Highlight Badge</label>
                                        <input type="text" class="sp-input page-hero-badge" value="@pHero.TitleHighlight" />
                                    </div>
                                    <div class="sp-field">
                                        <label>Banner Title</label>
                                        <input type="text" class="sp-input page-hero-title" value="@pHero.Title" />
                                    </div>
                                </div>
                                <div class="sp-field">
                                    <label>Banner Subtitle / Description</label>
                                    <input type="text" class="sp-input page-hero-sub" value="@pHero.Subtitle" />
                                </div>
                                <div class="sp-field">
                                    <label>Banner Image URL</label>
                                    <div class="sp-upload-row">
                                        <input type="text" class="sp-input page-hero-img" value="@pHero.ImageUrl" />
                                        <input type="file" class="sp-file-input" accept="image/*" onchange="uploadPageHeroImage(this)" style="display:none;" />
                                        <button type="button" class="sp-btn-upload" onclick="triggerFileInput(this)">Upload Banner</button>
                                    </div>
                                </div>
                                <div class="sp-field">
                                    <label>Subcategories for Explorer (Comma-separated)</label>
                                    <textarea class="sp-input page-subcategories" rows="2" placeholder="e.g. Cricket Bats, Match Balls, Pads, Gloves">@string.Join(", ", pgItem.Subcategories ?? new List<string>())</textarea>
                                </div>
                                <div class="sp-field">
                                    <label>Important Athlete / Tournament Note</label>
                                    <input type="text" class="sp-input page-note" value="@pgItem.ImportantNote" placeholder="e.g. Tournament compliance note" />
                                </div>
                                <label class="sp-switch sp-switch-sm" style="margin-top: 8px;">
                                    <input type="checkbox" class="page-hero-uploading" @(pHero.IsUploadingSoon ? "checked" : "") />
                                    <span class="sp-slider round"></span>
                                    <span class="sp-switch-label">Show "Uploading Soon" radar animation</span>
                                </label>
                            </div>

                            <div class="sp-subpage-products-box">
                                <div class="sp-sub-header">
                                    <h3>Products in @pgItem.CategoryName (@pgItem.Products.Count Items)</h3>
                                    <button type="button" class="sp-btn-sm" onclick="addProductToSubpage('@pgItem.CategorySlug')">+ Add Product</button>
                                </div>

                                <div class="sp-products-admin-list" data-products-list>
                                    @for (int prodIdx = 0; prodIdx < pgItem.Products.Count; prodIdx++)
                                    {
                                        var prod = pgItem.Products[prodIdx];
                                        <div class="sp-admin-prod-card" data-prod-card>
                                            <input type="hidden" class="prod-id" value="@prod.Id" />
                                            <div class="sp-prod-card-top">
                                                <span class="sp-prod-num">Item #@(prodIdx + 1)</span>
                                                <div class="sp-slide-toggles">
                                                    <label class="sp-switch sp-switch-sm">
                                                        <input type="checkbox" class="prod-instock" @(prod.InStock ? "checked" : "") />
                                                        <span class="sp-slider round"></span>
                                                        <span class="sp-switch-label">In Stock</span>
                                                    </label>
                                                    <label class="sp-switch sp-switch-sm">
                                                        <input type="checkbox" class="prod-uploading" @(prod.IsUploadingSoon ? "checked" : "") />
                                                        <span class="sp-slider round"></span>
                                                        <span class="sp-switch-label">Uploading Soon</span>
                                                    </label>
                                                    <button type="button" class="sp-btn-icon-danger" onclick="removeProduct(this)" title="Delete Product">✕</button>
                                                </div>
                                            </div>

                                            <div class="sp-grid-2">
                                                <div class="sp-field">
                                                    <label>Product Name</label>
                                                    <input type="text" class="sp-input prod-name" value="@prod.Name" />
                                                </div>
                                                <div class="sp-field">
                                                    <label>Brand</label>
                                                    <input type="text" class="sp-input prod-brand" value="@prod.Brand" />
                                                </div>
                                            </div>

                                            <div class="sp-grid-3">
                                                <div class="sp-field">
                                                    <label>Price (₹)</label>
                                                    <input type="number" class="sp-input prod-price" value="@prod.Price" min="0" />
                                                </div>
                                                <div class="sp-field">
                                                    <label>Original Price (₹)</label>
                                                    <input type="number" class="sp-input prod-orig-price" value="@(prod.OriginalPrice ?? prod.Price)" min="0" />
                                                </div>
                                                <div class="sp-field">
                                                    <label>Badge</label>
                                                    <input type="text" class="sp-input prod-badge" value="@prod.Badge" placeholder="Best Seller / Pro Grade" />
                                                </div>
                                            </div>

                                            <div class="sp-grid-2">
                                                <div class="sp-field">
                                                    <label>Rating (e.g. 4.8)</label>
                                                    <input type="number" step="0.1" class="sp-input prod-rating" value="@prod.Rating" min="1" max="5" />
                                                </div>
                                                <div class="sp-field">
                                                    <label>Reviews Count</label>
                                                    <input type="number" class="sp-input prod-reviews" value="@prod.ReviewsCount" min="0" />
                                                </div>
                                            </div>

                                            <div class="sp-field">
                                                <label>Sizes (Comma separated)</label>
                                                <input type="text" class="sp-input prod-sizes" value="@(string.Join(", ", prod.Sizes ?? new List<string>()))" placeholder="Full Size SH, Size 6" />
                                            </div>

                                            <div class="sp-field">
                                                <label>Subcategory Tag (Matches Left Sidebar Filter)</label>
                                                <input type="text" class="sp-input prod-subcat-tag" value="@prod.SubcategoryTag" placeholder="e.g. Cricket Bats (English & Kashmir Willow)" />
                                            </div>

                                            <div class="sp-field">
                                                <label>Product Description &amp; Specifications</label>
                                                <textarea class="sp-input prod-desc" rows="2" placeholder="Detailed product specifications...">@prod.Description</textarea>
                                            </div>

                                            <div class="sp-field">
                                                <label>Product Image URL (Big Frame)</label>
                                                <div class="sp-upload-row">
                                                    <input type="text" class="sp-input prod-img" value="@prod.ImageUrl" />
                                                    <input type="file" class="sp-file-input" accept="image/*" onchange="uploadProdImage(this)" style="display:none;" />
                                                    <button type="button" class="sp-btn-upload-sm" onclick="triggerFileInput(this)">Upload Image</button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ========================================================
             TAB 5: TOP PICKS & BOTTOM BANNER
        ========================================================= -->
        <div id="tabTopPicks" class="sp-tab-panel">
            <div class="sp-card">
                <div class="sp-card-header">
                    <h2 class="sp-card-title">Top Picks Section (Home Showcase)</h2>
                    <label class="sp-switch">
                        <input type="checkbox" id="topPicksEnabled" @(topPicks.IsEnabled ? "checked" : "") />
                        <span class="sp-slider round"></span>
                        <span class="sp-switch-label">Enable Section</span>
                    </label>
                </div>
                <div class="sp-grid-2">
                    <div class="sp-field">
                        <label>Section Title</label>
                        <input type="text" id="topPicksTitle" class="sp-input" value="@topPicks.Title" />
                    </div>
                    <div class="sp-field">
                        <label>Section Subtitle</label>
                        <input type="text" id="topPicksSub" class="sp-input" value="@topPicks.Subtitle" />
                    </div>
                </div>
            </div>

            <div class="sp-card" style="margin-top: 20px;">
                <div class="sp-card-header">
                    <h2 class="sp-card-title">Bottom Campus Banner</h2>
                    <label class="sp-switch">
                        <input type="checkbox" id="bottomBannerEnabled" @(bottomBanner.IsEnabled ? "checked" : "") />
                        <span class="sp-slider round"></span>
                        <span class="sp-switch-label">Enable Banner</span>
                    </label>
                </div>
                <div class="sp-grid-2">
                    <div class="sp-field">
                        <label>Banner Title</label>
                        <input type="text" id="bottomTitle" class="sp-input" value="@bottomBanner.Title" />
                    </div>
                    <div class="sp-field">
                        <label>Banner Subtitle</label>
                        <input type="text" id="bottomSub" class="sp-input" value="@bottomBanner.Subtitle" />
                    </div>
                </div>
                <div class="sp-grid-2">
                    <div class="sp-field">
                        <label>Button Text</label>
                        <input type="text" id="bottomBtnText" class="sp-input" value="@bottomBanner.ButtonText" />
                    </div>
                    <div class="sp-field">
                        <label>Target URL</label>
                        <input type="text" id="bottomTargetUrl" class="sp-input" value="@bottomBanner.TargetUrl" />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- ========================================================
