@model Dreamflykit.Application.StudyHub.Models.StudyHubDto
@{
    var hub = Model ?? Dreamflykit.Application.StudyHub.Models.StudyHubDto.CreateDefault();
    var hero = hub.HeroBanner ?? new();
    var s1 = hub.Section1 ?? new();
    var s2 = hub.Section2 ?? new();
    var s3Detail = hub.Section3Detail ?? new();
    var s4 = hub.Section4 ?? new();
    var s5 = hub.Section5 ?? new();
    var s6 = hub.Section6 ?? new();
    var s7 = hub.Section7 ?? new();
    var s8 = hub.Section8 ?? new();
    var s9 = hub.Section9 ?? new();
    var s10 = hub.Section10 ?? new();
    var bottomBanner = hub.BottomBanner ?? new();

    var heroSlides = hero.Slides != null && hero.Slides.Count > 0
        ? hero.Slides.Take(12).ToList()
        : new List<Dreamflykit.Application.StudyHub.Models.StudyHubHeroSlideDto>
        {
            new() { Id = "hero-slide-1", ImageUrl = hero.ImageUrl, SecondaryBadge = hero.SecondaryBadge, LinkUrl = hero.ButtonUrl, Title = hero.Title }
        };
    var heroIntervalSec = hero.AutoSlideIntervalSeconds > 0 ? hero.AutoSlideIntervalSeconds : 4;

    string GetTitleClass(string? size) => size?.ToLowerInvariant() switch
    {
        "normal" => "dk-sh-title-normal",
        "xlarge" => "dk-sh-title-xlarge",
        _ => "dk-sh-title-large"
    };

    string CleanTitle(string? title) => string.IsNullOrWhiteSpace(title)
        ? ""
        : System.Text.RegularExpressions.Regex.Replace(title, @"^\d+\.\s*", "");

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="dk-study-hub-wrapper" id="study-essentials-hub-root">

    @if (canManage)
    {
        <div class="dk-study-hub-admin-bar">
            <span class="dk-sh-admin-badge">Admin Controls</span>
            <span class="dk-sh-admin-hint">Viewing Study Hub (All 10 Sections). Super Admin can edit all text &amp; replace test pics.</span>
            <a href="/Admin/StudyHub" class="dk-sh-admin-btn" id="btnManageStudyHub">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Manage All 10 Sections &amp; Images
            </a>
        </div>
    }

    <!-- ========================================================
         HERO BANNER & TRUST BAR (FULL WIDTH HERO WITH OVERLAY TEXT)
    ========================================================= -->
    <section class="dk-sh-hero-banner" aria-label="Study Essentials Hero">
        <div class="dk-sh-hero-slider-wrap">
            <div class="dk-sh-hero-slider" id="dkHeroSlider" data-interval="@(heroIntervalSec * 1000)">
                <div class="dk-sh-hero-slider-track" id="dkHeroSliderTrack">
                    @for (int idx = 0; idx < heroSlides.Count; idx++)
                    {
                        var slide = heroSlides[idx];
                        <div class="dk-sh-hero-slide @(idx == 0 ? "active" : "")" data-slide-index="@idx">
                            <a href="@(!string.IsNullOrWhiteSpace(slide.LinkUrl) ? slide.LinkUrl : hero.ButtonUrl)" class="dk-sh-hero-slide-link" aria-label="@(string.IsNullOrWhiteSpace(slide.Title) ? hero.Title : slide.Title)">
                                <img src="@slide.ImageUrl" alt="@(string.IsNullOrWhiteSpace(slide.Title) ? hero.Title : slide.Title)" loading="@(idx == 0 ? "eager" : "lazy")" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                            </a>
                            @if (!string.IsNullOrWhiteSpace(slide.SecondaryBadge))
                            {
                                <div class="dk-sh-hero-badge-float">
                                    <span>@slide.SecondaryBadge</span>
                                </div>
                            }
                        </div>
                    }
                </div>



                @if (heroSlides.Count > 1)
                {
                    <!-- Prev / Next Navigation Arrows -->
                    <button type="button" class="dk-sh-slider-nav dk-sh-slider-prev" id="dkHeroSliderPrev" aria-label="Previous Slide">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <button type="button" class="dk-sh-slider-nav dk-sh-slider-next" id="dkHeroSliderNext" aria-label="Next Slide">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>

                    <!-- Navigation Dots -->
                    <div class="dk-sh-slider-dots" id="dkHeroSliderDots">
                        @for (int d = 0; d < heroSlides.Count; d++)
                        {
                            <button type="button" class="dk-sh-slider-dot @(d == 0 ? "active" : "")" data-target-slide="@d" aria-label="Go to slide @(d + 1)"></button>
                        }
                    </div>
                }
            </div>
        </div>

        @if (hub.TrustItems != null && hub.TrustItems.Count > 0)
        {
            <div class="dk-sh-trust-bar">
                @foreach (var item in hub.TrustItems)
                {
                    <div class="dk-sh-trust-item">
                        <div class="dk-sh-trust-icon">
                            @if (item.Icon == "quality")
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                            }
                            else if (item.Icon == "bundle")
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                            }
                            else if (item.Icon == "lock")
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            }
                            else
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                            }
                        </div>
                        <div>
                            <div class="dk-sh-trust-title">@item.Title</div>
                            <div class="dk-sh-trust-sub">@item.Subtitle</div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ========================================================
         SECTION 1: 1. SHOP BY CATEGORY
    ========================================================= -->
    <section class="dk-sh-section-wrap" aria-labelledby="sh-s1-title">
        <div class="dk-sh-section-head">
            <div>
                <h2 id="sh-s1-title" class="dk-sh-title @GetTitleClass(s1.TitleFontSize)">@CleanTitle(s1.Title)</h2>
                <p class="dk-sh-subtitle">@s1.Subtitle</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(s1.ViewAllLinkText))
            {
                <a href="@s1.ViewAllLinkUrl" class="dk-sh-view-all-link">
                    @s1.ViewAllLinkText
                </a>
            }
        </div>

        <div class="dk-sh-cards-grid dk-sh-s1-grid">
            @foreach (var card in s1.Cards)
            {
                var targetLink = !string.IsNullOrWhiteSpace(card.LinkUrl)
                    ? card.LinkUrl.Replace("/category/study-essentials//category/study-essentials/", "/category/study-essentials/").Replace("//", "/")
                    : "/category/study-essentials";

                <div class="dk-sh-card-item">
                    <a href="@targetLink" class="dk-sh-card-img-wrap" style="display: block; text-decoration: none;">
                        <img src="@card.ImageUrl" alt="@card.Title" loading="lazy" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                    </a>
                    <div class="dk-sh-card-body">
                        <h3 class="dk-sh-card-title">
                            <a href="@targetLink" style="color: inherit; text-decoration: none;">@card.Title</a>
                        </h3>
                        <p class="dk-sh-card-desc">@card.Description</p>
                        <a href="@targetLink" class="dk-sh-card-link">
                            Shop Now
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ========================================================
         SECTION 2: OUR STUDY ESSENTIALS KITS & CUSTOM KIT BUILDER
    ========================================================= -->
    <section class="dk-sh-section-wrap" id="kits-section" aria-labelledby="sh-s2-title">
        <div class="dk-sh-section-head">
            <div>
                <h2 id="sh-s2-title" class="dk-sh-title @GetTitleClass(s2.TitleFontSize)">@CleanTitle(s2.Title)</h2>
                <p class="dk-sh-subtitle">@s2.Subtitle</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(s2.ViewAllLinkText))
            {
                <a href="@s2.ViewAllLinkUrl" class="dk-sh-view-all-link">
                    @s2.ViewAllLinkText
                </a>
            }
        </div>

        <div class="dk-sh-kits-grid">
            @foreach (var kit in s2.Kits)
            {
                var badgeClass = kit.BadgeVariant?.ToLowerInvariant() switch
                {
                    "blue" => "dk-sh-badge-blue",
                    "amber" => "dk-sh-badge-amber",
                    "purple" => "dk-sh-badge-purple",
                    _ => "dk-sh-badge-green"
                };

                <div class="dk-sh-kit-card">
                    <div class="dk-sh-kit-img-wrap">
                        <img src="@kit.ImageUrl" alt="@kit.Title" loading="lazy" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                    </div>
                    <div class="dk-sh-kit-body">
                        <div class="dk-sh-kit-top-line">
                            <h3 class="dk-sh-kit-title">@kit.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(kit.BadgeText))
                            {
                                <span class="dk-sh-pill-badge @badgeClass">@kit.BadgeText</span>
                            }
                        </div>
                        <p class="dk-sh-kit-desc">@kit.Description</p>

                        @if (kit.Features != null && kit.Features.Count > 0)
                        {
                            <ul class="dk-sh-features-list">
                                @foreach (var feat in kit.Features)
                                {
                                    <li>
                                        <span class="dk-sh-bullet" aria-hidden="true">•</span>
                                        <span>@feat</span>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="dk-sh-kit-footer">
                            <div class="dk-sh-kit-price">@kit.PriceDisplay</div>
                            <button type="button"
                                    class="dk-sh-btn-add-cart"
                                    onclick="handleKitAddToCart('@kit.Title', @kit.Price, '@kit.ImageUrl')">
                                @kit.ButtonText
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 4th Option in Kits: Build Your Own Kit -->
            <div class="dk-sh-kit-card dk-sh-kit-custom-card">
                <div class="dk-sh-kit-img-wrap" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); display: flex; align-items: center; justify-content: center;">
                    <div style="width: 72px; height: 72px; border-radius: 50%; background: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(6, 63, 145, 0.12);">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#063f91" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                    </div>
                </div>
                <div class="dk-sh-kit-body">
                    <div class="dk-sh-kit-top-line">
                        <h3 class="dk-sh-kit-title">Build Your Own Kit</h3>
                        <span class="dk-sh-pill-badge dk-sh-badge-amber">Customizable</span>
                    </div>
                    <p class="dk-sh-kit-desc">Pick individual essentials and build your custom bundle with live price calculation.</p>

                    <ul class="dk-sh-features-list">
                        <li>
                            <span class="dk-sh-bullet" aria-hidden="true">•</span>
                            <span>Choose notebooks, sleeves &amp; pens</span>
                        </li>
                        <li>
                            <span class="dk-sh-bullet" aria-hidden="true">•</span>
                            <span>Add country travel adapters</span>
                        </li>
                        <li>
                            <span class="dk-sh-bullet" aria-hidden="true">•</span>
                            <span>Live total price calculation</span>
                        </li>
                        <li>
                            <span class="dk-sh-bullet" aria-hidden="true">•</span>
                            <span>Bundle discount applied at checkout</span>
                        </li>
                    </ul>

                    <div class="dk-sh-kit-footer">
                        <div class="dk-sh-kit-price" style="font-size: 1rem; color: #ff7900;">Custom Bundle</div>
                        <a href="#custom-kit-section" class="dk-sh-btn-add-cart" style="text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                            Customize Below ↓
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Embedded Interactive Builder (Build Your Own Study Kit Option) -->
        <div class="dk-sh-s3-card" id="custom-kit-section" style="margin-top: 28px;">
            <div class="dk-sh-s3-header">
                <div class="dk-sh-s3-title-wrap">
                    <h3 id="sh-s6-title" class="dk-sh-title" style="margin: 0; font-size: 1.35rem; color: #063f91;">
                        @CleanTitle(s6.Title)
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(s6.BadgeText))
                    {
                        <span class="dk-sh-pill-badge dk-sh-badge-green">@s6.BadgeText</span>
                    }
                </div>
                <p class="dk-sh-subtitle" style="margin: 6px 0 0 0;">@s6.Subtitle</p>
            </div>

            <div class="dk-sh-builder-layout">
                <!-- Carousel / Selection Row -->
                <div class="dk-sh-builder-carousel-wrap">
                    <button type="button" class="dk-sh-arrow-btn dk-sh-arrow-left" onclick="scrollBuilderRow(-1)" aria-label="Previous items">
                        ‹
                    </button>

                    <div class="dk-sh-builder-scroll" id="dkBuilderScrollTrack">
                        @foreach (var item in s6.Items)
                        {
                            <div class="dk-sh-builder-item @(item.IsSelected ? "is-selected" : "")"
                                 id="builder-card-@item.Id"
                                 onclick="toggleBuilderItem('@item.Id', @item.Price)">
                                <div class="dk-sh-checkbox-top-right">
                                    <input type="checkbox"
                                           class="dk-sh-item-chk"
                                           id="chk-@item.Id"
                                           data-id="@item.Id"
                                           data-name="@item.Name"
                                           data-price="@item.Price"
                                           data-img="@item.ImageUrl"
                                           @(item.IsSelected ? "checked" : "")
                                           onclick="event.stopPropagation(); toggleBuilderItem('@item.Id', @item.Price);" />
                                </div>
                                <div class="dk-sh-b-img-wrap">
                                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                                </div>
                                <div class="dk-sh-b-name">@item.Name</div>
                                <div class="dk-sh-b-price">₹@item.Price.ToString("N0")</div>
                            </div>
                        }
                    </div>

                    <button type="button" class="dk-sh-arrow-btn dk-sh-arrow-right" onclick="scrollBuilderRow(1)" aria-label="Next items">
                        ›
                    </button>
                </div>

                <!-- Live Price / Action Card -->
                <div class="dk-sh-builder-summary-card">
                    <div class="dk-sh-sum-label">Total Price</div>
                    <div class="dk-sh-sum-price" id="dkBuilderTotalPrice">₹0</div>
                    <div class="dk-sh-sum-count" id="dkBuilderItemCount">0 items selected</div>
                    <button type="button"
                            class="dk-sh-btn-build-kit"
                            id="btnBuildStudyKit"
                            onclick="handleBuildMyKitSubmit('@s6.TargetUrl')">
                        @s6.ButtonText
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================
         SECTION 3: WHAT EVERY STUDENT NEEDS BEFORE GOING ABROAD
    ========================================================= -->
    <section class="dk-sh-section-wrap dk-sh-abroad-outer" aria-labelledby="sh-s3-abroad-title">
        <div class="dk-sh-abroad-container">
            <div class="dk-sh-abroad-header">
                <div class="dk-sh-abroad-header-left">
                    <div class="dk-sh-abroad-crest" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            <line x1="9" y1="7" x2="15" y2="7"></line>
                            <line x1="9" y1="11" x2="13" y2="11"></line>
                        </svg>
                    </div>
                    <div>
                        <h2 id="sh-s3-abroad-title" class="dk-sh-abroad-title">@CleanTitle(s3Detail.Title)</h2>
                        <p class="dk-sh-abroad-subtitle">@s3Detail.Subtitle</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(s3Detail.BadgeText))
                {
                    <div class="dk-sh-abroad-flight-badge" aria-label="@s3Detail.BadgeText">
                        <svg class="dk-sh-flight-path" width="70" height="36" viewBox="0 0 70 36" fill="none" aria-hidden="true">
                            <path d="M4 30 C 24 26, 44 14, 64 6" stroke="#0284c7" stroke-width="2" stroke-dasharray="3 3" stroke-linecap="round" fill="none" />
                        </svg>
                        <div class="dk-sh-flight-text-wrap">
                            <span class="dk-sh-flight-text">@s3Detail.BadgeText</span>
                        </div>
                    </div>
                }
            </div>

            <div class="dk-sh-abroad-grid">
                @foreach (var item in s3Detail.Cards)
                {
                    var guideLink = !string.IsNullOrWhiteSpace(item.LinkUrl) && item.LinkUrl.StartsWith("/study-guide")
                        ? item.LinkUrl
                        : (item.Id switch {
                            "abroad-study-ready" => "/study-guide/stay-study-ready",
                            "abroad-connected" => "/study-guide/stay-connected",
                            "abroad-documents" => "/study-guide/keep-documents-organized",
                            "abroad-student-life" => "/study-guide/set-up-your-student-life",
                            _ => item.Title?.ToLowerInvariant() switch {
                                var t when t != null && t.Contains("ready") => "/study-guide/stay-study-ready",
                                var t when t != null && t.Contains("connect") => "/study-guide/stay-connected",
                                var t when t != null && t.Contains("document") => "/study-guide/keep-documents-organized",
                                _ => "/study-guide/set-up-your-student-life"
                            }
                        });

                    var hasValidImg = !string.IsNullOrWhiteSpace(item.ImageUrl) && !item.ImageUrl.Contains("placeholder");
                    <div class="dk-sh-abroad-card" onclick="window.location.href='@guideLink'" style="cursor: pointer;">
                        <div class="dk-sh-abroad-img-wrap">
                            @if (hasValidImg)
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Title"
                                     loading="lazy"
                                     onerror="this.onerror=null; this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <div class="dk-sh-detail-upload-pic-fallback" style="display: none;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                        <circle cx="12" cy="13" r="4"></circle>
                                    </svg>
                                    <span>Upload Pic</span>
                                </div>
                            }
                            else
                            {
                                <div class="dk-sh-detail-upload-pic-box">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                        <circle cx="12" cy="13" r="4"></circle>
                                    </svg>
                                    <span>Upload Pic</span>
                                    @if (canManage)
                                    {
                                        <a href="/Admin/StudyHub#tab-s3" class="dk-sh-admin-quick-upload-link" onclick="event.stopPropagation();">Admin Upload</a>
                                    }
                                </div>
                            }
                        </div>

                        <div class="dk-sh-abroad-body">
                            <div class="dk-sh-abroad-headline">
                                <div class="dk-sh-abroad-icon-badge" aria-hidden="true">
                                    @if (item.IconType == "laptop" || item.IconType == "digital" || item.IconType == "tech")
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                                    }
                                    else if (item.IconType == "passport" || item.IconType == "file" || item.IconType == "documents")
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                                    }
                                    else if (item.IconType == "bag" || item.IconType == "life" || item.IconType == "campus")
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                                    }
                                    else
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                    }
                                </div>
                                <h3 class="dk-sh-abroad-card-title">@item.Title</h3>
                            </div>

                            <p class="dk-sh-abroad-card-desc">@item.Description</p>

                            <a href="@guideLink" class="dk-sh-abroad-card-link" onclick="event.stopPropagation();">
                                @(!string.IsNullOrWhiteSpace(item.ButtonText) ? item.ButtonText : "Explore Essentials →")
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         SECTIONS 4 & 5: SIDE-BY-SIDE (CHECKLIST & DESTINATIONS)
    ========================================================= -->
    <section class="dk-sh-section-wrap dk-sh-split-section" aria-label="Abroad Packing Checklist and Destinations">
        <div class="dk-sh-split-grid">
            <!-- Left Side: Abroad Packing Checklist -->
            <div class="dk-sh-split-card dk-sh-split-checklist" id="sh-split-checklist-card">
                <div class="dk-sh-split-header">
                    <div class="dk-sh-badge-line">
                        <h2 id="sh-s4-title" class="dk-sh-title @GetTitleClass(s4.TitleFontSize)">
                            <a href="/abroad-packing-checklist" style="color: inherit; text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='#0284c7'" onmouseout="this.style.color='inherit'">
                                @CleanTitle(s4.Title)
                            </a>
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(s4.BadgeText))
                        {
                            <span class="dk-sh-pill-badge dk-sh-badge-green">@s4.BadgeText</span>
                        }
                    </div>
                    <p class="dk-sh-subtitle" style="margin-top: 4px; margin-bottom: 16px;">@s4.Subtitle</p>
                </div>

                <div class="dk-sh-split-checklist-body">
                    <div class="dk-sh-checklist-list">
                        @foreach (var chk in s4.Items)
                        {
                            <label class="dk-sh-checklist-item" id="chk_label_@chk.Id">
                                <input type="checkbox"
                                       class="dk-sh-check-input"
                                       id="chk_input_@chk.Id"
                                       checked="@(chk.IsChecked ? "checked" : null)"
                                       onchange="toggleChecklistItem('@chk.Id')" />
                                <span class="dk-sh-check-custom"></span>
                                <span class="dk-sh-check-text">@chk.Text</span>
                            </label>
                        }
                    </div>

                    <div style="margin-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
                        <a href="/abroad-packing-checklist" class="dk-sh-btn-primary" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
                            <span>@(string.IsNullOrWhiteSpace(s4.ButtonText) ? "View Full Checklist →" : s4.ButtonText)</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                        <span style="font-size: 0.8rem; color: #16a34a; font-weight: 700; background: #dcfce7; padding: 4px 10px; border-radius: 999px;">
                            ✓ Interactive 64-Item Checklist
                        </span>
                    </div>
                </div>
            </div>

            <!-- Right Side: Shop by Destination -->
            <div class="dk-sh-split-card dk-sh-split-destinations" id="sh-split-destinations-card">
                <div class="dk-sh-split-header" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap;">
                    <div>
                        <h2 id="sh-s5-title" class="dk-sh-title @GetTitleClass(s5.TitleFontSize)">@CleanTitle(s5.Title)</h2>
                        <p class="dk-sh-subtitle" style="margin-top: 4px; margin-bottom: 16px;">@s5.Subtitle</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(s5.ButtonText))
                    {
                        <a href="@s5.ButtonUrl" class="dk-sh-view-all-link" style="font-size: 0.84rem; font-weight: 700;">
                            @s5.ButtonText
                        </a>
                    }
                </div>

                <div class="dk-sh-destinations-side-grid">
                    @foreach (var c in s5.Countries)
                    {
                        <a href="@c.LinkUrl" class="dk-sh-dest-side-card" title="Explore essentials for @c.Name">
                            <div class="dk-sh-dest-side-flag">
                                <img src="@c.FlagUrl" alt="@c.Name Flag" loading="lazy" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                            </div>
                            <div class="dk-sh-dest-side-info">
                                <span class="dk-sh-dest-side-name">@c.Name</span>
                                <span class="dk-sh-dest-side-hint">View Gear →</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================
         SECTION 7: BEST SELLERS & STUDENT FAVORITES
    ========================================================= -->
    <section class="dk-sh-section-wrap" aria-labelledby="sh-s7-title">
        <div class="dk-sh-section-head">
            <div>
                <h2 id="sh-s7-title" class="dk-sh-title @GetTitleClass(s7.TitleFontSize)">@CleanTitle(s7.Title)</h2>
                <p class="dk-sh-subtitle">@s7.Subtitle</p>
            </div>
        </div>

        <div class="dk-sh-bestsellers-grid">
            @foreach (var p in s7.Products)
            {
                <div class="dk-sh-bs-card">
                    <div class="dk-sh-bs-img-wrap">
                        <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                    </div>
                    <div class="dk-sh-bs-body">
                        <h3 class="dk-sh-bs-name">@p.Name</h3>
                        <div class="dk-sh-bs-rating">
                            <span class="dk-sh-stars">★★★★★</span>
                            <span class="dk-sh-rating-num">@p.Rating</span>
                            <span class="dk-sh-rating-count">(@p.ReviewsCount)</span>
                        </div>
                        <div class="dk-sh-bs-price-row">
                            <span class="dk-sh-bs-price">₹@p.Price.ToString("N0")</span>
                            @if (p.OriginalPrice > p.Price)
                            {
                                <span class="dk-sh-bs-orig-price">₹@p.OriginalPrice.ToString("N0")</span>
                            }
                        </div>
                        <button type="button"
                                class="dk-sh-btn-bs-cart"
                                onclick="handleProductAddToCart('@p.Name', @p.Price, '@p.ImageUrl')">
                            @p.ButtonText
                        </button>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ========================================================
         SECTION 8: 8. SMART STUDY SETUP
    ========================================================= -->
    <section class="dk-sh-section-wrap" aria-labelledby="sh-s8-title">
        <div class="dk-sh-setup-card">
            <div class="dk-sh-setup-left">
                <div class="dk-sh-setup-img-wrap">
                    <img src="@s8.ImageUrl" alt="@s8.Title" loading="lazy" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
                </div>
            </div>
            <div class="dk-sh-setup-right">
                <h2 id="sh-s8-title" class="dk-sh-title @GetTitleClass(s8.TitleFontSize)">@CleanTitle(s8.Title)</h2>
                <p class="dk-sh-subtitle" style="margin-bottom: 20px;">@s8.Subtitle</p>

                <div class="dk-sh-setup-items-list">
                    @foreach (var item in s8.Items)
                    {
                        <div class="dk-sh-setup-item-row">
                            <div class="dk-sh-setup-item-name">
                                <span class="dk-sh-setup-bullet">✓</span>
                                <span>@item.Name</span>
                            </div>
                            <div class="dk-sh-setup-item-price">₹@item.Price.ToString("N0")</div>
                        </div>
                    }
                </div>

                <div style="margin-top: 24px;">
                    <a href="@s8.ButtonUrl" class="dk-sh-btn-primary">
                        @s8.ButtonText
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================
         SECTION 9: 9. WHY CHOOSE DREAMFLYKIT?
    ========================================================= -->
    <section class="dk-sh-section-wrap" aria-labelledby="sh-s9-title">
        <div class="dk-sh-section-head">
            <div>
                <h2 id="sh-s9-title" class="dk-sh-title @GetTitleClass(s9.TitleFontSize)">@CleanTitle(s9.Title)</h2>
                <p class="dk-sh-subtitle">@s9.Subtitle</p>
            </div>
        </div>

        <div class="dk-sh-why-grid">
            @foreach (var p in s9.Pillars)
            {
                <div class="dk-sh-why-card">
                    <div class="dk-sh-why-icon-wrap" aria-hidden="true">
                        @if (p.IconType == "gift")
                        {
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                        }
                        else if (p.IconType == "globe")
                        {
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                        }
                        else if (p.IconType == "truck")
                        {
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                        }
                        else
                        {
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        }
                    </div>
                    <h3 class="dk-sh-why-title">@p.Title</h3>
                    <p class="dk-sh-why-desc">@p.Description</p>
                </div>
            }
        </div>
    </section>

    <!-- ========================================================
         SECTION 10: 10. FREQUENTLY ASKED QUESTIONS
    ========================================================= -->
    <section class="dk-sh-section-wrap" aria-labelledby="sh-s10-title">
        <div class="dk-sh-section-head">
            <div>
                <h2 id="sh-s10-title" class="dk-sh-title @GetTitleClass(s10.TitleFontSize)">@CleanTitle(s10.Title)</h2>
                <p class="dk-sh-subtitle">@s10.Subtitle</p>
            </div>
        </div>

        <div class="dk-sh-faq-accordion">
            @for (int i = 0; i < s10.Faqs.Count; i++)
            {
                var faq = s10.Faqs[i];
                <div class="dk-sh-faq-item" id="faq-item-@i">
                    <button type="button"
                            class="dk-sh-faq-trigger"
                            onclick="toggleFaqAccordion(@i)"
                            aria-expanded="false"
                            aria-controls="faq-ans-@i">
                        <span class="dk-sh-faq-question">@faq.Question</span>
                        <span class="dk-sh-faq-toggle-icon" id="faq-icon-@i">+</span>
                    </button>
                    <div class="dk-sh-faq-content" id="faq-ans-@i" style="display: none;">
                        <p>@faq.Answer</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ========================================================
         BOTTOM BANNER: YOUR GLOBAL JOURNEY STARTS HERE
    ========================================================= -->
    <section class="dk-sh-bottom-cta-banner">
        <div class="dk-sh-b-cta-left">
            <h2 class="dk-sh-b-cta-title">@bottomBanner.Title</h2>
            <p class="dk-sh-b-cta-sub">@bottomBanner.Subtitle</p>
            <a href="@bottomBanner.ButtonUrl" class="dk-sh-btn-b-cta">
                @bottomBanner.ButtonText
            </a>
        </div>
        <div class="dk-sh-b-cta-right">
            <img src="@bottomBanner.ImageUrl" alt="@bottomBanner.Title" loading="lazy" onerror="this.onerror=null;this.src='/images/study-hub/test-pic-placeholder.svg';" />
        </div>
    </section>

</div>

<!-- ========================================================
     INLINE STYLING FOR ALL 10 STUDY HUB SECTIONS
========================================================= -->
<style>
    .dk-study-hub-wrapper {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #1e293b;
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        padding-bottom: 24px;
        box-sizing: border-box;
    }

    /* Admin Bar */
    .dk-study-hub-admin-bar {
        background: #0f172a;
        color: #f8fafc;
        padding: 8px 16px;
        border-radius: 8px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }
    .dk-sh-admin-badge {
        background: #063f91;
        color: #fff;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 700;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .dk-sh-admin-hint {
        flex: 1;
        color: #94a3b8;
    }
    .dk-sh-admin-btn {
        background: #ff7900;
        color: #ffffff;
        padding: 5px 12px;
        border-radius: 6px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: transform 0.15s ease, background 0.15s;
    }
    .dk-sh-admin-btn:hover {
        background: #7dd3fc;
        transform: translateY(-1px);
    }

    /* Common Section Headings */
    .dk-sh-section-wrap {
        margin-bottom: 22px;
    }
    .dk-sh-section-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 12px;
        gap: 14px;
    }
    .dk-sh-title {
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        line-height: 1.25;
        letter-spacing: -0.02em;
    }
    .dk-sh-title-normal { font-size: 1.25rem; }
    .dk-sh-title-large { font-size: 1.45rem; }
    .dk-sh-title-xlarge { font-size: 1.75rem; }
    .dk-sh-subtitle {
        color: #64748b;
        font-size: 0.88rem;
        margin: 3px 0 0 0;
    }
    .dk-sh-view-all-link {
        color: #0284c7;
        font-weight: 700;
        font-size: 0.86rem;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.15s ease, transform 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .dk-sh-view-all-link:hover {
        color: #0369a1;
        transform: translateX(2px);
    }

    /* ============================================================
       Full Width Hero Banner Slider with Text Overlay
       Image is 100% Full Bright, Vivid & Attractive with Crisp Clarity
       ============================================================ */
    .dk-sh-hero-banner {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 8px 8px 14px 8px;
        margin-bottom: 24px;
        box-shadow: 0 8px 30px rgba(6, 63, 145, 0.08);
        overflow: hidden;
    }
    .dk-sh-hero-slider-wrap {
        position: relative;
        width: 100%;
        border-radius: 14px;
        overflow: hidden;
    }
    .dk-sh-hero-slider {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 5.2;
        min-height: 260px;
        max-height: 430px;
        background: #f8fafc;
        overflow: hidden;
    }
    @@media (max-width: 900px) {
        .dk-sh-hero-slider {
            aspect-ratio: 16 / 6.5;
            min-height: 200px;
            max-height: 320px;
        }
    }
    @@media (max-width: 600px) {
        .dk-sh-hero-slider {
            aspect-ratio: 16 / 8;
            min-height: 170px;
        }
    }
    .dk-sh-hero-slider-track {
        position: relative;
        width: 100%;
        height: 100%;
    }
    .dk-sh-hero-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.45s ease-in-out, visibility 0.45s ease-in-out;
    }
    .dk-sh-hero-slide.active {
        opacity: 1;
        visibility: visible;
        z-index: 2;
    }
    .dk-sh-hero-slide-link {
        display: block;
        width: 100%;
        height: 100%;
        text-decoration: none;
    }
    /* Full bright, sharp, attractive slide image */
    .dk-sh-hero-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        filter: brightness(1.04) contrast(1.02) saturate(1.05);
        transition: transform 6s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .dk-sh-hero-slide.active img {
        transform: scale(1.02);
    }
    .dk-sh-hero-badge-float {
        position: absolute;
        bottom: 24px;
        right: 28px;
        background: rgba(15, 23, 42, 0.88);
        backdrop-filter: blur(10px);
        color: #ffffff;
        padding: 7px 18px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 750;
        border: 1px solid rgba(255, 255, 255, 0.25);
        z-index: 5;
        pointer-events: none;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }
    @@media (max-width: 768px) {
        .dk-sh-hero-badge-float {
            top: 16px;
            bottom: auto;
            right: 16px;
            font-size: 11px;
            padding: 5px 12px;
        }
    }
    .dk-sh-slider-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        color: #0f172a;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 7;
        opacity: 0.85;
        transition: all 0.2s ease;
    }
    .dk-sh-hero-slider:hover .dk-sh-slider-nav {
        opacity: 1;
    }
    .dk-sh-slider-prev { left: 16px; }
    .dk-sh-slider-next { right: 16px; }
    .dk-sh-slider-nav:hover {
        background: #ff7900;
        border-color: #ff7900;
        color: #ffffff;
        transform: translateY(-50%) scale(1.1);
        box-shadow: 0 6px 18px rgba(255, 121, 0, 0.4);
    }
    .dk-sh-slider-dots {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 7px;
        z-index: 7;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(8px);
        padding: 5px 12px;
        border-radius: 20px;
    }
    .dk-sh-slider-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.6);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.25s ease;
    }
    .dk-sh-slider-dot.active {
        width: 22px;
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
    }

    /* Trust Bar */
    .dk-sh-trust-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid rgba(2, 132, 199, 0.16);
    }
    @@media (max-width: 768px) {
        .dk-sh-trust-bar { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    }
    .dk-sh-trust-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .dk-sh-trust-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(6, 63, 145, 0.08);
        color: #063f91;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(6, 63, 145, 0.1);
    }
    .dk-sh-trust-title {
        font-weight: 700;
        font-size: 0.86rem;
        color: #0f172a;
    }
    .dk-sh-trust-sub {
        font-size: 0.74rem;
        color: #64748b;
    }

    /* Section 1: Shop by Category - Compact 4-Column Grid, Reduced Image Size, Showing All in 2 Rows */
    .dk-sh-cards-grid.dk-sh-s1-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }
    @@media (max-width: 1080px) {
        .dk-sh-cards-grid.dk-sh-s1-grid { grid-template-columns: repeat(4, 1fr); gap: 10px; }
    }
    @@media (max-width: 820px) {
        .dk-sh-cards-grid.dk-sh-s1-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    }
    @@media (max-width: 480px) {
        .dk-sh-cards-grid.dk-sh-s1-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    }
    .dk-sh-s1-grid .dk-sh-card-item {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s;
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    }
    .dk-sh-s1-grid .dk-sh-card-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
        border-color: #38bdf8;
    }
    .dk-sh-s1-grid .dk-sh-card-img-wrap {
        aspect-ratio: 16/9;
        max-height: 105px;
        background: #f1f5f9;
