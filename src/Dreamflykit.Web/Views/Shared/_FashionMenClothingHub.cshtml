@functions {
    public static string GetMenCategoryEmoji(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug)) return "👕";
        var s = slug.ToLowerInvariant();
        if (s.Contains("polo") || s.Contains("t-shirt") || s.Contains("tee")) return "👕";
        if (s.Contains("shirt")) return "👔";
        if (s.Contains("hoodie") || s.Contains("sweat")) return "🧥";
        if (s.Contains("jacket") || s.Contains("coat")) return "🧥";
        if (s.Contains("jean")) return "👖";
        if (s.Contains("trouser") || s.Contains("chino") || s.Contains("pant")) return "👖";
        if (s.Contains("short")) return "🩳";
        if (s.Contains("inner") || s.Contains("sleep")) return "🩲";
        if (s.Contains("active") || s.Contains("gym") || s.Contains("dry")) return "🏃";
        if (s.Contains("access") || s.Contains("cap") || s.Contains("hat")) return "🧢";
        return "👕";
    }
}

