<script>
document.addEventListener("DOMContentLoaded", function () {
    // 1. Tab Switching
    const tabBtns = document.querySelectorAll(".dk-tab-btn");
    const tabPanes = document.querySelectorAll(".dk-tab-pane");

    tabBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            tabBtns.forEach(b => b.classList.remove("active"));
            tabPanes.forEach(p => p.classList.remove("active"));
            btn.classList.add("active");
            const targetId = btn.getAttribute("data-tab");
            const targetPane = document.getElementById(targetId);
            if (targetPane) targetPane.classList.add("active");
        });
    });

    // 2. Hero File Upload
    const heroFileInput = document.getElementById("heroFileInput");
    if (heroFileInput) {
        heroFileInput.addEventListener("change", async function () {
            if (!this.files || this.files.length === 0) return;
            const file = this.files[0];
            const formData = new FormData();
            formData.append("file", file);
            formData.append("targetField", "heroBanner");
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
            formData.append("__RequestVerificationToken", token);

            showAlert("Uploading hero banner image...", "info");

            try {
                const res = await fetch("/Admin/FashionHub/UploadImage", {
                    method: "POST",
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.url) {
                    document.getElementById("heroImageUrl").value = data.url;
                    document.getElementById("heroImagePreview").src = data.url;
                    showAlert("Hero banner image uploaded successfully! Don't forget to click Save All Changes.", "success");
                } else {
                    showAlert("Upload failed: " + (data.message || "Unknown error"), "error");
                }
            } catch (err) {
                showAlert("Network or upload error: " + err.message, "error");
            }
        });
    }

    // Live URL Preview on typing
    const heroImageUrlInput = document.getElementById("heroImageUrl");
    if (heroImageUrlInput) {
        heroImageUrlInput.addEventListener("input", function () {
            const val = this.value.trim();
            if (val) {
                document.getElementById("heroImagePreview").src = val;
            }
        });
    }

    // Save buttons
    document.getElementById("btnSaveHubHeader")?.addEventListener("click", saveFashionHub);
    document.getElementById("btnSaveHubFooter")?.addEventListener("click", saveFashionHub);
});

function setHeroDefaultImage() {
    const defaultUrl = "/images/fashion-hub/fashion_hero_banner.jpg";
    document.getElementById("heroImageUrl").value = defaultUrl;
    document.getElementById("heroImagePreview").src = defaultUrl;
    document.getElementById("heroIsUploadingSoon").checked = false;
}

async function uploadRowImage(input, type) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];
    const formData = new FormData();
    formData.append("file", file);
    formData.append("targetField", type);
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
    formData.append("__RequestVerificationToken", token);

    showAlert(`Uploading image for ${type}...`, "info");

    try {
        const res = await fetch("/Admin/FashionHub/UploadImage", {
            method: "POST",
            body: formData
        });
        const data = await res.json();
        if (data.success && data.url) {
            const row = input.closest(".dk-item-row");
            if (type === "category") {
                row.querySelector(".cat-thumb-preview").src = data.url;
                row.querySelector(".cat-image-url").value = data.url;
                // Uncheck uploading soon if actual image is uploaded
                row.querySelector(".cat-soon").checked = false;
            } else {
                row.querySelector(".prod-thumb-preview").src = data.url;
                row.querySelector(".prod-image-url").value = data.url;
                row.querySelector(".prod-soon").checked = false;
            }
            showAlert("Image uploaded! Remember to Save Changes.", "success");
        } else {
            showAlert("Upload failed: " + (data.message || "Unknown error"), "error");
        }
    } catch (err) {
        showAlert("Upload error: " + err.message, "error");
    }
}

function removeRow(btn) {
    if (confirm("Remove this item?")) {
        const row = btn.closest(".dk-item-row");
        if (row) row.remove();
    }
}

