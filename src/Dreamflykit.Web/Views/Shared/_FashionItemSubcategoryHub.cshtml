@model Dreamflykit.Web.Models.Products.ProductListViewModel
@{
    var hub = Model.FashionItemHub 
              ?? Model.FashionHub?.GetItemHubBySlug(Model.CurrentFashionCategorySlug ?? Model.CategorySlug)
              ?? Dreamflykit.Application.FashionHub.Models.FashionItemHubDto.CreateDefaultWomenFootwear();

    var currentSlug = (Model.CurrentSubcategorySlug ?? "").Trim().ToLowerInvariant().Replace('_', '-');
    var subPage = Model.FashionItemSubcategoryPage;

    if (subPage == null && hub.SubcategoryPages != null && hub.SubcategoryPages.Count > 0)
    {
        subPage = hub.SubcategoryPages.FirstOrDefault(p =>
            string.Equals(p.CategorySlug, currentSlug, StringComparison.OrdinalIgnoreCase));
    }

    if (subPage == null)
    {
        var matchedCat = hub.CategoriesSection?.Categories?.FirstOrDefault(c =>
            string.Equals(c.Slug, currentSlug, StringComparison.OrdinalIgnoreCase));

        var catName = matchedCat?.Name ?? (!string.IsNullOrWhiteSpace(Model.CurrentSubcategoryName)
            ? Model.CurrentSubcategoryName
            : (string.IsNullOrWhiteSpace(currentSlug) ? hub.CategoryName : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(currentSlug.Replace("-", " "))));

        subPage = new Dreamflykit.Application.FashionHub.Models.FashionSubcategoryPageDto
        {
            CategorySlug = currentSlug,
            CategoryName = catName,
            HeroBanner = new Dreamflykit.Application.FashionHub.Models.FashionSubcategoryHeroDto
            {
                Title = catName,
                TitleHighlight = "STUDENT ESSENTIALS • 100% GENUINE",
                Subtitle = $"Discover our premium curated collection of {catName} engineered for student campus life and international journeys.",
                ThemeColor = "#ea580c",
                IsUploadingSoon = true
            },
            Products = hub.TopPicksSection?.Products ?? new List<Dreamflykit.Application.FashionHub.Models.FashionProductItemDto>()
        };
    }

    var hero = subPage.HeroBanner ?? new Dreamflykit.Application.FashionHub.Models.FashionSubcategoryHeroDto();
    var products = (subPage.Products != null && subPage.Products.Count > 0)
        ? subPage.Products.Where(p => p.IsActive).ToList()
        : new List<Dreamflykit.Application.FashionHub.Models.FashionProductItemDto>();

    var allCategories = hub.CategoriesSection?.Categories?.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToList()
        ?? new List<Dreamflykit.Application.FashionHub.Models.FashionCategoryItemDto>();

    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
    var parentSlug = hub.CategorySlug.ToLowerInvariant();
}

<div class="dk-subpage-container dk-shell" id="itemSubpageRoot" data-parent-category="@parentSlug" data-subcategory="@subPage.CategorySlug">

    @* Festival Ribbon (if enabled by parent hub) *@
    @if (hub.FestivalTheme != null && hub.FestivalTheme.IsEnabled && !string.IsNullOrWhiteSpace(hub.FestivalTheme.AnnouncementText))
    {
        <div class="dk-sub-fest-ribbon" style="background: @(!string.IsNullOrWhiteSpace(hub.FestivalTheme.BgGradient) ? hub.FestivalTheme.BgGradient : "linear-gradient(135deg, #ea580c 0%, #c2410c 100%)");">
            <span class="dk-sub-fest-badge">@(!string.IsNullOrWhiteSpace(hub.FestivalTheme.BadgeText) ? hub.FestivalTheme.BadgeText : "SPECIAL OFFER")</span>
            <span class="dk-sub-fest-text">@hub.FestivalTheme.AnnouncementText</span>
            @if (!string.IsNullOrWhiteSpace(hub.FestivalTheme.BannerHighlight))
            {
                <span class="dk-sub-fest-highlight">@hub.FestivalTheme.BannerHighlight</span>
            }
        </div>
    }

    <!-- ========================================================
         1. HERO BANNER (FULL WIDTH)
    ========================================================= -->
    <section class="dk-sub-hero-card" aria-label="@subPage.CategoryName Hero Banner">
        <div class="dk-sub-hero-glow"></div>
        <div class="dk-sub-hero-body">
            <div class="dk-sub-hero-content">
                <nav class="dk-sub-breadcrumb" aria-label="Breadcrumb">
                    <a href="/category/fashion">Fashion</a>
                    <span class="dk-sub-sep">/</span>
                    <a href="/category/fashion/@parentSlug">@hub.CategoryName</a>
                    <span class="dk-sub-sep">/</span>
                    <span class="dk-sub-crumb-active">@subPage.CategoryName</span>
                </nav>

                <div class="dk-sub-hero-badge">
                    <span class="dk-badge-dot">●</span>
                    <span>@(!string.IsNullOrWhiteSpace(hero.TitleHighlight) ? hero.TitleHighlight : "STUDENT ESSENTIALS • 100% GENUINE")</span>
                </div>

                <h1 class="dk-sub-hero-title">@subPage.CategoryName</h1>
                
                <p class="dk-sub-hero-desc">
                    @(string.IsNullOrWhiteSpace(hero.Subtitle)
                        ? $"Discover our premium curated collection of {subPage.CategoryName} engineered with high quality materials, durability, and travel-ready features for students."
                        : hero.Subtitle)
                </p>

                <div class="dk-sub-hero-chips">
                    <span class="dk-hero-chip">✓ Materials Inspected</span>
                    <span class="dk-hero-chip">✓ Campus Delivery Ready</span>
                    <span class="dk-hero-chip">✓ 100% Genuine Guarantee</span>
                    @if (canManage)
                    {
                        <a href="/Admin/FashionHub#tab-@parentSlug" class="dk-sub-admin-link">⚙ Edit in Admin Dashboard</a>
                    }
                </div>
            </div>

            <div class="dk-sub-hero-media">
                @if (!string.IsNullOrWhiteSpace(hero.ImageUrl) && !hero.ImageUrl.Contains("placeholder") && !hero.ImageUrl.Contains("uploading-soon") && !hero.IsUploadingSoon)
                {
                    <div class="dk-sub-banner-img-wrap">
                        <img src="@hero.ImageUrl" alt="@subPage.CategoryName" class="dk-sub-banner-img" />
                    </div>
                }
                else
                {
                    <div class="dk-sub-hero-uploading">
                        <div class="dk-sub-uploading-radar">
                            <span class="dk-sub-radar-ring"></span>
                            <span class="dk-sub-emoji">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                        </div>
                        <div class="dk-sub-uploading-pill">
                            <span class="dk-mini-dot">●</span> Uploading Soon
                        </div>
                        <p class="dk-sub-uploading-text">Admin will upload banner image</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         2. MAIN TWO-COLUMN LAYOUT (LEFT FILTERS, RIGHT PRODUCTS)
    ========================================================= -->
    <div class="dk-sub-layout">
        
        <!-- LEFT FILTER SIDEBAR -->
        <aside class="dk-sub-sidebar" id="dkSubSidebar" aria-label="Filters">
            <div class="dk-filter-card">
                <div class="dk-filter-header">
                    <h3 class="dk-filter-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filters
                    </h3>
                    <button type="button" class="dk-btn-clear-filters" id="btnSubClearAllFilters" onclick="resetItemFilters()">
                        Reset All
                    </button>
                </div>

                <!-- 1. Categories Quick Switcher -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">@hub.CategoryName Categories (@allCategories.Count)</h4>
                    <div class="dk-cat-quick-list">
                        @foreach (var cat in allCategories)
                        {
                            var isCurrent = string.Equals(cat.Slug, subPage.CategorySlug, StringComparison.OrdinalIgnoreCase);
                            <a href="/category/fashion/@parentSlug/@cat.Slug" 
                               class="dk-cat-quick-item @(isCurrent ? "active" : "")" 
                               title="@cat.Name">
                                <span class="dk-cat-quick-emoji">@GetSubcategoryIcon(cat.Slug)</span>
                                <span class="dk-cat-quick-name">@cat.Name</span>
                                @if (isCurrent)
                                {
                                    <span class="dk-cat-current-dot">●</span>
                                }
                            </a>
                        }
                    </div>
                </div>

                <!-- 2. Specialized Category-Specific Filter -->
                @if (parentSlug.Contains("women-footwear"))
                {
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Shoe Size (UK)</h4>
                        <div class="dk-sizes-chips-grid">
                            @foreach (var size in new[] { "UK 3", "UK 4", "UK 5", "UK 6", "UK 7", "UK 8" })
                            {
                                <label class="dk-size-chip-label">
                                    <input type="checkbox" class="dk-size-checkbox" value="@size" onchange="filterItemProducts()" />
                                    <span class="dk-size-chip-box">@size</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Heel Type / Height</h4>
                        <div class="dk-radios-list">
                            @foreach (var heel in new[] { "Flat (Zero Heel)", "Kitten Heel (1-2\")", "Block Heel (2-3\")", "Stiletto (3\"+)", "Wedges & Platforms" })
                            {
                                <label class="dk-radio-item">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@heel" onchange="filterItemProducts()" />
                                    <span>@heel</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                else if (parentSlug.Contains("watch"))
                {
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Dial Shape</h4>
                        <div class="dk-sizes-chips-grid">
                            @foreach (var shape in new[] { "Round", "Square", "Rectangular", "Tonneau" })
                            {
                                <label class="dk-size-chip-label">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@shape" onchange="filterItemProducts()" />
                                    <span class="dk-size-chip-box">@shape</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Strap Material</h4>
                        <div class="dk-radios-list">
                            @foreach (var strap in new[] { "Genuine Leather", "Stainless Steel", "Mesh Bracelet", "Silicone Sport", "Ceramic" })
                            {
                                <label class="dk-radio-item">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@strap" onchange="filterItemProducts()" />
                                    <span>@strap</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Movement / Tech</h4>
                        <div class="dk-radios-list">
                            @foreach (var mov in new[] { "Analog Quartz", "Chronograph", "Automatic Mechanical", "Smartwatch / AMOLED" })
                            {
                                <label class="dk-radio-item">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@mov" onchange="filterItemProducts()" />
                                    <span>@mov</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                else if (parentSlug.Contains("sunglass"))
                {
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Frame Shape</h4>
                        <div class="dk-sizes-chips-grid">
                            @foreach (var frame in new[] { "Aviator", "Wayfarer", "Round", "Clubmaster", "Cat Eye", "Sports Wrap" })
                            {
                                <label class="dk-size-chip-label">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@frame" onchange="filterItemProducts()" />
                                    <span class="dk-size-chip-box">@frame</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Lens Feature</h4>
                        <div class="dk-radios-list">
                            @foreach (var lens in new[] { "Polarized Anti-Glare", "100% UV400 Protection", "Gradient Tint", "Mirrored Flash", "Blue Light Blocking" })
                            {
                                <label class="dk-radio-item">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@lens" onchange="filterItemProducts()" />
                                    <span>@lens</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                else if (parentSlug.Contains("cap") || parentSlug.Contains("hat"))
                {
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Headwear Style</h4>
                        <div class="dk-sizes-chips-grid">
                            @foreach (var cap in new[] { "Baseball", "Snapback", "Beanie", "Bucket", "Visor", "Sun Hat" })
                            {
                                <label class="dk-size-chip-label">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@cap" onchange="filterItemProducts()" />
                                    <span class="dk-size-chip-box">@cap</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Material / Closure</h4>
                        <div class="dk-radios-list">
                            @foreach (var mat in new[] { "100% Washed Cotton", "Thermal Ribbed Knit", "Breathable Mesh", "Adjustable Strapback", "Snapback Closure" })
                            {
                                <label class="dk-radio-item">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@mat" onchange="filterItemProducts()" />
                                    <span>@mat</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                else if (parentSlug.Contains("belt") || parentSlug.Contains("wallet"))
                {
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Accessory Type</h4>
                        <div class="dk-sizes-chips-grid">
                            @foreach (var acc in new[] { "Formal Belts", "Casual Belts", "RFID Wallets", "Bi-Fold", "Cardholders", "Passport Wallets" })
                            {
                                <label class="dk-size-chip-label">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@acc" onchange="filterItemProducts()" />
                                    <span class="dk-size-chip-box">@acc</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Leather & Hardware</h4>
                        <div class="dk-radios-list">
                            @foreach (var fea in new[] { "100% Full Grain Leather", "RFID-Blocking Shield", "Automatic Ratchet Click", "Reversible Dual-Tone", "Slim Front Pocket" })
                            {
                                <label class="dk-radio-item">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@fea" onchange="filterItemProducts()" />
                                    <span>@fea</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                else if (parentSlug.Contains("sock"))
                {
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Sock Length</h4>
                        <div class="dk-sizes-chips-grid">
                            @foreach (var len in new[] { "No-Show", "Ankle", "Crew", "Knee High" })
                            {
                                <label class="dk-size-chip-label">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@len" onchange="filterItemProducts()" />
                                    <span class="dk-size-chip-box">@len</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Fabric & Features</h4>
                        <div class="dk-radios-list">
                            @foreach (var fab in new[] { "Anti-Odor Bamboo", "Combed Cotton", "Thermal Merino Wool", "Graduated Compression", "Multi-Pack Value" })
                            {
                                <label class="dk-radio-item">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@fab" onchange="filterItemProducts()" />
                                    <span>@fab</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                else if (parentSlug.Contains("accessor"))
                {
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Accessory Category</h4>
                        <div class="dk-sizes-chips-grid">
                            @foreach (var itm in new[] { "Bags", "Ties", "Cufflinks", "Scarves", "Keychains", "Umbrellas" })
                            {
                                <label class="dk-size-chip-label">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@itm" onchange="filterItemProducts()" />
                                    <span class="dk-size-chip-box">@itm</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="dk-filter-section">
                        <h4 class="dk-filter-heading">Material & Use</h4>
                        <div class="dk-radios-list">
                            @foreach (var use in new[] { "Water-Resistant Fabric", "100% Silk / Jacquard", "Stainless Steel", "Cashmere Touch", "Windproof Storm Tech" })
                            {
                                <label class="dk-radio-item">
                                    <input type="checkbox" class="dk-attr-checkbox" value="@use" onchange="filterItemProducts()" />
                                    <span>@use</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <!-- 3. Color Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Color</h4>
                    <div class="dk-colors-grid">
                        @foreach (var (cName, cHex) in new[] { 
                            ("Black", "#0f172a"), ("White", "#ffffff"), ("Brown", "#78350f"), 
                            ("Navy", "#1e3a8a"), ("Grey", "#64748b"), ("Tan", "#d97706"), 
                            ("Beige", "#fef3c7"), ("Red", "#dc2626"), ("Blue", "#2563eb"), 
                            ("Gold", "#ca8a04"), ("Silver", "#94a3b8"), ("Olive", "#4d7c0f"), ("Pink", "#f472b6") })
                        {
                            <label class="dk-color-swatch-item" title="@cName">
                                <input type="checkbox" class="dk-color-checkbox" value="@cName" onchange="filterItemProducts()" />
                                <span class="dk-color-circle" style="background-color: @cHex; @(cName == "White" ? "border: 1.5px solid #cbd5e1;" : "")"></span>
                                <span class="dk-color-name">@cName</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- 4. Price Range Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Price Range</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="itemPriceRange" value="all" checked onchange="filterItemProducts()" />
                            <span>All Prices</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemPriceRange" value="0-499" onchange="filterItemProducts()" />
                            <span>Under ₹499</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemPriceRange" value="500-999" onchange="filterItemProducts()" />
                            <span>₹500 - ₹999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemPriceRange" value="1000-1999" onchange="filterItemProducts()" />
                            <span>₹1,000 - ₹1,999</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemPriceRange" value="2000-3499" onchange="filterItemProducts()" />
                            <span>₹2,000 - ₹3,499</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemPriceRange" value="3500-99999" onchange="filterItemProducts()" />
                            <span>₹3,500 &amp; Above</span>
                        </label>
                    </div>
                    <div class="dk-price-custom-row">
                        <input type="number" id="itemMinPrice" placeholder="Min ₹" class="dk-price-input" onchange="filterItemProducts()" />
                        <span class="dk-price-sep">-</span>
                        <input type="number" id="itemMaxPrice" placeholder="Max ₹" class="dk-price-input" onchange="filterItemProducts()" />
                        <button type="button" class="dk-btn-price-go" onclick="filterItemProducts()">Go</button>
                    </div>
                </div>

                <!-- 5. Discount Filter -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Discount</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="itemDiscount" value="0" checked onchange="filterItemProducts()" />
                            <span>All Discounts</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemDiscount" value="10" onchange="filterItemProducts()" />
                            <span>10% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemDiscount" value="20" onchange="filterItemProducts()" />
                            <span>20% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemDiscount" value="30" onchange="filterItemProducts()" />
                            <span>30% and above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemDiscount" value="50" onchange="filterItemProducts()" />
                            <span>50% and above</span>
                        </label>
                    </div>
                </div>

                <!-- 6. Customer Rating -->
                <div class="dk-filter-section">
                    <h4 class="dk-filter-heading">Customer Rating</h4>
                    <div class="dk-radios-list">
                        <label class="dk-radio-item">
                            <input type="radio" name="itemRating" value="0" checked onchange="filterItemProducts()" />
                            <span>All Ratings</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemRating" value="4.5" onchange="filterItemProducts()" />
                            <span>★ 4.5 &amp; above</span>
                        </label>
                        <label class="dk-radio-item">
                            <input type="radio" name="itemRating" value="4.0" onchange="filterItemProducts()" />
                            <span>★ 4.0 &amp; above</span>
                        </label>
                    </div>
                </div>

                <!-- 7. Availability -->
                <div class="dk-filter-section" style="border-bottom: none;">
                    <label class="dk-switch-row">
                        <span class="dk-switch-text">In Stock Only</span>
                        <input type="checkbox" id="itemInStockOnly" checked onchange="filterItemProducts()" />
                        <span class="dk-slider-toggle"></span>
                    </label>
                </div>

            </div>
        </aside>

        <!-- RIGHT PRODUCTS CATALOG GRID -->
        <main class="dk-sub-main" id="dkSubMain">
            <!-- Top Toolbar -->
            <div class="dk-sub-toolbar">
                <div class="dk-toolbar-left">
                    <span class="dk-results-count" id="itemResultsCount">
                        Showing @products.Count products in <strong>@subPage.CategoryName</strong>
                    </span>
                    <div class="dk-active-chips" id="itemActiveChips"></div>
                </div>

                <div class="dk-toolbar-right">
                    <div class="dk-sort-wrap">
                        <label for="itemSortSelect" class="dk-sort-label">Sort By:</label>
                        <select id="itemSortSelect" class="dk-sort-select" onchange="filterItemProducts()">
                            <option value="relevance">Relevance</option>
                            <option value="price-low">Price: Low to High</option>
                            <option value="price-high">Price: High to Low</option>
                            <option value="rating">Customer Rating</option>
                            <option value="discount">Highest Discount</option>
                            <option value="newest">Newest First</option>
                        </select>
                    </div>

                    <div class="dk-view-toggle">
                        <button type="button" class="dk-view-btn active" id="btnViewGrid" title="Grid View" onclick="setItemLayout('grid', this)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                            </svg>
                        </button>
                        <button type="button" class="dk-view-btn" id="btnViewList" title="List View" onclick="setItemLayout('list', this)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <rect x="3" y="4" width="18" height="3"></rect>
                                <rect x="3" y="10" width="18" height="3"></rect>
                                <rect x="3" y="16" width="18" height="3"></rect>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="dk-sub-products-grid" id="itemProductsGrid">
                @if (products.Count > 0)
                {
                    foreach (var prod in products)
                    {
                        var discountPct = 0;
                        if (prod.OriginalPrice.HasValue && prod.OriginalPrice.Value > prod.Price)
                        {
                            discountPct = (int)Math.Round((1m - (prod.Price / prod.OriginalPrice.Value)) * 100m);
                        }

                        var sizesCsv = prod.Sizes != null ? string.Join(",", prod.Sizes) : "";
                        var colorsCsv = prod.Colors != null ? string.Join(",", prod.Colors) : "";
                        var prodUrl = !string.IsNullOrWhiteSpace(prod.ProductUrl) ? prod.ProductUrl : $"/category/fashion/{parentSlug}/{subPage.CategorySlug}";

                        <div class="dk-sub-prod-card" 
                             data-id="@prod.Id"
                             data-name="@prod.Name"
                             data-price="@prod.Price"
                             data-original-price="@(prod.OriginalPrice ?? prod.Price)"
                             data-discount="@discountPct"
                             data-rating="@prod.Rating"
                             data-reviews="@prod.ReviewsCount"
                             data-sizes="@sizesCsv"
                             data-colors="@colorsCsv"
                             data-instock="@(prod.InStock ? "true" : "false")"
                             data-category="@prod.CategorySlug">

                            <!-- Image Container -->
                            <div class="dk-sub-prod-img-box">
                                <button type="button" class="dk-sub-wish-btn" title="Add to Wishlist" onclick="toggleSubWishlist(this, event)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                    </svg>
                                </button>

                                @if (!string.IsNullOrWhiteSpace(prod.Badge))
                                {
                                    <span class="dk-sub-badge">@prod.Badge</span>
                                }
                                @if (discountPct > 0)
                                {
                                    <span class="dk-sub-discount-tag">@discountPct% OFF</span>
                                }

                                @if (prod.IsUploadingSoon || string.IsNullOrWhiteSpace(prod.ImageUrl) || prod.ImageUrl.Contains("placeholder") || prod.ImageUrl.Contains("uploading-soon"))
                                {
                                    <div class="dk-sub-prod-placeholder">
                                        <span class="dk-sub-prod-radar"></span>
                                        <span class="dk-sub-prod-placeholder-emoji">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                                        <span class="dk-sub-prod-soon-tag">Uploading Soon</span>
                                    </div>
                                }
                                else
                                {
                                    <img src="@prod.ImageUrl" 
                                         alt="@prod.Name" 
                                         loading="lazy" 
                                         class="dk-sub-prod-img" 
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                    <div class="dk-sub-prod-placeholder" style="display: none;">
                                        <span class="dk-sub-prod-radar"></span>
                                        <span class="dk-sub-prod-placeholder-emoji">@GetSubcategoryIcon(subPage.CategorySlug)</span>
                                        <span class="dk-sub-prod-soon-tag">Uploading Soon</span>
                                    </div>
                                }
                            </div>

                            <!-- Card Body -->
                            <div class="dk-sub-prod-body">
                                <a href="@prodUrl" class="dk-sub-prod-title" title="@prod.Name">
                                    @prod.Name
                                </a>

                                <div class="dk-sub-prod-meta">
                                    <div class="dk-sub-prod-rating">
                                        <span class="dk-star">★</span>
                                        <span class="dk-rating-num">@prod.Rating.ToString("0.0")</span>
                                        <span class="dk-reviews-num">(@prod.ReviewsCount)</span>
                                    </div>
                                    <span class="dk-stock-indicator in-stock">● In Stock</span>
                                </div>

                                <div class="dk-sub-prod-pricing">
                                    <span class="dk-sub-current-price">₹@prod.Price.ToString("N0")</span>
                                    @if (prod.OriginalPrice.HasValue && prod.OriginalPrice.Value > prod.Price)
                                    {
                                        <span class="dk-sub-mrp">₹@prod.OriginalPrice.Value.ToString("N0")</span>
                                        <span class="dk-sub-save-tag">Save ₹@((prod.OriginalPrice.Value - prod.Price).ToString("N0"))</span>
                                    }
                                </div>

                                @if (prod.Sizes != null && prod.Sizes.Count > 0)
                                {
                                    <div class="dk-sub-prod-sizes">
                                        @foreach (var sz in prod.Sizes.Take(4))
                                        {
                                            <span class="dk-sub-size-chip">@sz</span>
                                        }
                                        @if (prod.Sizes.Count > 4)
                                        {
                                            <span class="dk-sub-size-chip">+@(prod.Sizes.Count - 4)</span>
                                        }
                                    </div>
                                }

                                @if (prod.Colors != null && prod.Colors.Count > 0)
                                {
                                    <div class="dk-sub-prod-colors">
                                        @foreach (var c in prod.Colors.Take(4))
                                        {
                                            <span class="dk-sub-color-pill" title="@c">@c</span>
                                        }
                                    </div>
                                }

                                <div class="dk-sub-prod-actions">
                                    <button type="button" class="dk-sub-add-cart-btn" onclick="quickAddItemToCart('@prod.Id', '@prod.Name', @prod.Price, this)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                        Add to Cart
                                    </button>
                                    <a href="@prodUrl" class="dk-sub-details-btn" title="View details">
                                        View
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Empty State (Shown via JS when filters match 0 products) -->
            <div class="dk-sub-empty-state" id="itemEmptyState" style="display: none;">
                <span class="dk-empty-icon">🔍</span>
                <h3 class="dk-empty-title">No products match your selected filters</h3>
                <p class="dk-empty-sub">Try expanding your price range, clearing size or color filters, or resetting all filters.</p>
                <button type="button" class="dk-btn-reset-filters-large" onclick="resetItemFilters()">
                    Reset All Filters
                </button>
            </div>
        </main>

    </div>
</div>

@* Subcategory Styling *@
<style>
.dk-subpage-container {
