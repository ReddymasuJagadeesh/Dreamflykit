@{
    ViewData["Title"] = "About Us — Your Journey. Our Kit.";
    Layout = "_Layout";
}

<div class="dk-page-container dk-info-page">
    <!-- Hero Banner -->
    <div class="dk-info-hero">
        <div class="dk-info-hero-badge">✈ DREAMFLYKIT STORY</div>
        <h1 class="dk-info-hero-title">Empowering International Students Across the Globe</h1>
        <p class="dk-info-hero-subtitle">
            Moving to a new country for higher education is a life-defining milestone. Dreamflykit eliminates the stress of packing, international airline weight restrictions, and foreign climate preparation.
        </p>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="dk-pillars-grid">
        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">🌐</div>
            <h3 class="dk-pillar-title">Country-Tailored Kits</h3>
            <p class="dk-pillar-desc">
                Curated specifically for USA, UK, Canada, Australia, and European climates. From thermal duvets to country-specific voltage converters, we include only what you need.
            </p>
        </div>

        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">⚖️</div>
            <h3 class="dk-pillar-title">Airline Baggage Compliant</h3>
            <p class="dk-pillar-desc">
                Every kit item is pre-weighed and vacuum-compressed to fit standard 23kg check-in luggage allotments, leaving ample room for personal belongings.
            </p>
        </div>

        <div class="dk-pillar-card">
            <div class="dk-pillar-icon">🛡️</div>
            <h3 class="dk-pillar-title">Premium & Lab-Tested</h3>
            <p class="dk-pillar-desc">
                Culinary-grade stainless steel utensils, BIS-certified adapters, allergen-free bedding fabrics, and TSA-approved locks designed for heavy multi-leg transit.
            </p>
        </div>
    </div>

    <!-- Company Stats Bar -->
    <div class="dk-stats-bar">
        <div class="dk-stat-item">
            <span class="dk-stat-number">15,000+</span>
            <span class="dk-stat-label">Students Traveled</span>
        </div>
        <div class="dk-stat-item">
            <span class="dk-stat-number">45+</span>
            <span class="dk-stat-label">Partner Universities</span>
        </div>
        <div class="dk-stat-item">
            <span class="dk-stat-number">99.8%</span>
            <span class="dk-stat-label">On-Time Delivery</span>
        </div>
        <div class="dk-stat-item">
            <span class="dk-stat-number">4.9 ★</span>
            <span class="dk-stat-label">Student Satisfaction</span>
        </div>
    </div>

    <!-- Mission & Vision Section -->
    <div class="dk-about-split">
        <div class="dk-about-split-content">
            <h2 class="dk-section-heading">Our Mission</h2>
            <p class="dk-text-lead">
                To be the most trusted pre-departure companion for international scholars and overseas travelers.
            </p>
            <p class="dk-text-body">
                Founded in Hyderabad by former international students who experienced the chaotic rush of buying cookware, bedsheets, adaptors, and winterwear from five different markets, Dreamflykit was born to provide an end-to-end all-in-one kit delivered directly to the student's doorstep before their flight.
            </p>
            <div class="dk-about-cta-row">
                <a href="/Kits/FindMyKit" class="dk-btn dk-btn-primary">Find Your Destination Kit</a>
                <a href="/Contact" class="dk-btn dk-btn-outline">Talk to Our Team</a>
            </div>
        </div>
        <div class="dk-about-split-feature">
            <div class="dk-feature-box">
                <h4>✨ Why 15,000+ Students Choose Us</h4>
                <ul class="dk-feature-list">
                    <li>✔ <strong>Single-Box Simplicity:</strong> No hopping between wholesale markets.</li>
                    <li>✔ <strong>Tested Against Airport Customs:</strong> Zero confiscation guarantee for cookware and spices.</li>
                    <li>✔ <strong>Doorstep Express Delivery:</strong> Dispatched in 24 hours across all Indian pin codes.</li>
                    <li>✔ <strong>Post-Arrival Peace of Mind:</strong> Land, unpack, and start university life immediately.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
