    let activeUploadTargetInputId = null;
    let activeUploadPreviewImgId = null;

    function triggerHubUpload(inputId, imgId) {
        activeUploadTargetInputId = inputId;
        activeUploadPreviewImgId = imgId;
        const uploader = document.getElementById("globalHubImageUploader");
        if (uploader) {
            uploader.value = "";
            uploader.click();
        }
    }

    function updateLivePreview(inputId, imgId) {
        const inp = document.getElementById(inputId);
        const img = document.getElementById(imgId);
        if (inp && img) {
            img.src = inp.value || "/images/study-hub/test-pic-placeholder.svg";
        }
    }

    function clearHubPhoto(inputId, imgId) {
        const inp = document.getElementById(inputId);
        const img = document.getElementById(imgId);
        if (inp) inp.value = "";
        if (img) img.src = "/images/study-hub/test-pic-placeholder.svg";
    }

    // Process and optimize image for instantaneous local display and upload
    function processImageFile(file, callback) {
        if (!file.type || !file.type.startsWith("image/")) {
            const reader = new FileReader();
            reader.onload = e => callback(e.target.result);
            reader.readAsDataURL(file);
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            const img = new Image();
            img.onload = function () {
                const maxDim = 1200;
                let width = img.width;
                let height = img.height;
                if (width > maxDim || height > maxDim) {
                    if (width > height) {
                        height = Math.round((height * maxDim) / width);
                        width = maxDim;
                    } else {
                        width = Math.round((width * maxDim) / height);
                        height = maxDim;
                    }
                }
                const canvas = document.createElement("canvas");
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0, width, height);
                const dataUrl = canvas.toDataURL("image/webp", 0.88);
                callback(dataUrl);
            };
            img.onerror = () => callback(e.target.result);
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    // High-Speed Direct Upload Handler with Zero-Loss Resilient Delivery
    document.getElementById("globalHubImageUploader")?.addEventListener("change", function () {
        if (!this.files || this.files.length === 0) return;
        const file = this.files[0];
        const targetInputId = activeUploadTargetInputId;
        const targetPreviewId = activeUploadPreviewImgId;

        showHubToast("⏳ Reading and optimizing photo...", false);

        processImageFile(file, async function (optimizedDataUrl) {
            // Step 1: Immediate instant live preview & assignment so admin sees photo immediately!
            if (targetPreviewId) {
                const img = document.getElementById(targetPreviewId);
                if (img) img.src = optimizedDataUrl;
            }
            if (targetInputId) {
                const input = document.getElementById(targetInputId);
                if (input) {
                    input.value = optimizedDataUrl;
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                    input.dispatchEvent(new Event("change", { bubbles: true }));
                }
            }

            // Step 2: Asynchronously upload to server for persistent storage URL
            const formData = new FormData();
            formData.append("file", file);

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) formData.append("__RequestVerificationToken", token);

            try {
                const res = await fetch("/Admin/StudyAbroadHub/UploadImage", {
                    method: "POST",
                    body: formData,
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                const data = await res.json();

                if (data.success && data.url) {
                    if (targetInputId) {
                        const input = document.getElementById(targetInputId);
                        if (input) {
                            input.value = data.url;
                            input.dispatchEvent(new Event("input", { bubbles: true }));
                        }
                    }
                    if (targetPreviewId) {
                        const img = document.getElementById(targetPreviewId);
                        if (img) img.src = data.url;
                    }
                    showHubToast("✓ Image uploaded and saved to storage!", true);
                } else {
                    showHubToast("✓ Photo attached & ready! (Click 'Save All Changes Now' to save)", true);
                }
            } catch (err) {
                // If server is on older DLL or S3 is disconnected, local Data URL is already assigned
                showHubToast("✓ Photo attached & ready! (Click 'Save All Changes Now' to save)", true);
            }
        });
    });

