<script>
document.addEventListener("DOMContentLoaded", function () {
    const track = document.getElementById("dkWomenProductsTrackWrapper");
    const prevBtn = document.getElementById("dkWomenPicksPrev");
    const nextBtn = document.getElementById("dkWomenPicksNext");

    if (track && prevBtn && nextBtn) {
        prevBtn.addEventListener("click", () => {
            track.scrollBy({ left: -300, behavior: "smooth" });
        });
        nextBtn.addEventListener("click", () => {
            track.scrollBy({ left: 300, behavior: "smooth" });
        });
    }
});
</script>
